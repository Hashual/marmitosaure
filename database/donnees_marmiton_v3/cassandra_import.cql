INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (84545, 'Smoothie bananapple', 'banane, pomme, yaourt', '5 min', ['Coupez en fines rondelles la banane puis épluchez, épépinez et coupez en petits morceaux votre pomme.', 'Mettez le tout dans votre mixeur, avec le yaourt.', 'Appuyez sur le bouton, puis patientez le temps que le mélange devienne bien homogène et lisse (il ne doit pas rester de morceaux de fruits !).', 'Enfin, versez le tout dans un grand verre et dégustez à l''aide d''une paille ou d''une cuillère ;)'], ['Spatule', 'Planche à découper', 'Rouleau à pâtisserie', 'Ouvre-boîte', 'Batteur électrique'], ['entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'cocktail', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'smoothies', 'Smoothie bananapple'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:28:30.298509', [{'ingredient_id': 'e8a39a6b-1dda-4f8a-beae-3b47044f3af0', 'quantite': '1'}, {'ingredient_id': '8cd261ac-9e51-42f9-b75e-c4d81adadaf0', 'quantite': '1'}, {'ingredient_id': '29b12d24-e6dc-4dd3-a280-e22a16b2de89', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (233179, 'Tarte banane très simple', 'pâte feuilletée, banane, yaourt nature, sucre roux, Bailey''s, oeuf, amandes effilées', '10 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Mélanger les œufs, le sucre, le baileys et le yaourt.', 'Dérouler la pâte feuilletée dans un moule à tarte, la piquer et y disposer les bananes en tranches fines.', 'Recouvrir la tarte de la préparation et enfourner dans un four chaud à 180°C (thermostat 6) pendant 15 à 20 min.'], ['Économe', 'Presse-agrumes', 'Poêle', 'Planche à découper', 'Passoire'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'yaourt nature', 'facile', 'bon marché', 'oeuf', 'plat', 'tarte à la banane', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Tarte banane très simple', 'pâte feuilletée', 'Bailey''s', 'amandes effilées', 'cocktail', 'sucre roux'], 'Dessert', 909f0098-8ba4-4de3-835f-8b496ad68f93, '2025-09-26T15:28:33.856459', [{'ingredient_id': '4c852dcd-60ad-4ece-95af-5840839e2bd7', 'quantite': '1'}, {'ingredient_id': '26f1613c-de4e-4200-b5ab-0fb0c4eba7cd', 'quantite': '2'}, {'ingredient_id': 'ad221729-dfcf-421c-8a12-b584b6157b1e', 'quantite': '1'}, {'ingredient_id': 'a32d4d43-f44a-4b37-9adc-d9230c5c9ed1', 'quantite': '30 g'}, {'ingredient_id': 'b9985a5d-c57a-4034-b5de-9c494779d067', 'quantite': '1 cuillères'}, {'ingredient_id': '2c294e00-1557-4840-b4f6-00b334d652cc', 'quantite': '2'}, {'ingredient_id': '06cacf28-b229-48ce-b310-04197d67956c', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (73070, 'Smoothie Banane Cassis', 'banane, yaourt, brugnon', '5 min', ['Eplucher les brugnons, les couper en dés.', 'Eplucher la banane et la couper en morceaux.', 'Mettre dans un mixer, accompagné du yaourt au cassis (ou autre goût que vous estimerez convenir).', 'Mixer jusqu''à obtention d''une pâte lisse, mousseuse, pas trop liquide.', 'Verser dans un verre, mettre au frais, et ne consommer que lorsque c''est bien bien froid.'], ['Verre doseur', 'Louche', 'Passoire', 'Mixeur', 'Spatule'], ['brugnon', 'entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Smoothie Banane Cassis', 'dessert', 'plat de résistance', 'smoothies', 'cocktail'], 'Boisson', 166e8b49-a48e-4a87-9bf6-5f78308dc386, '2025-09-26T15:28:37.955974', [{'ingredient_id': 'bb2c921e-2e25-4bb7-980f-13abf6079ba3', 'quantite': '1'}, {'ingredient_id': '06cae270-9849-4ea2-a711-b1e5b9707bd6', 'quantite': '1'}, {'ingredient_id': '61ccc218-f6f2-4e5c-9ff9-18a8be4c0919', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (166070, 'Smoothie rapide kiwi banane mangue', 'mangue, banane, kiwi, fruits exotiques, glaçons', '15 min', ['Epluchez les fruits et coupez les en morceaux.', 'Mettez le jus (et les glaçons si vous souhaitez en mettre) dans le blender (a defaut de blender, mixer le tout dans un grd saladier pour éviter que cela éclabousse partout), ajoutez les fruits et mixez une minute puis servez dans 2-3 verres'], ['Tire-bouchon', 'Poêle'], ['entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'mangue', 'fruits exotiques', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Smoothie rapide kiwi banane mangue', 'glaçons', 'smoothies', 'cocktail'], 'Boisson', 431cb0c5-ef6a-475f-b8c2-02be0513e4dc, '2025-09-26T15:28:41.450245', [{'ingredient_id': 'daa2c7a7-bfba-4d44-976e-773fa2b5f778', 'quantite': ''}, {'ingredient_id': 'acb4b65a-30ce-48c2-b8fa-3dbb3dbeedaa', 'quantite': '1'}, {'ingredient_id': '6bfbbe99-98ae-40fe-be99-dde1a435af0d', 'quantite': '2'}, {'ingredient_id': '00d005df-195d-44bd-82f3-a5bf8aece521', 'quantite': '15 cl'}, {'ingredient_id': 'b876c6fe-c325-42a5-b4eb-607e2b468c9d', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (18338, 'Jambon des îles à la banane', 'jambon, banane, paprika, gingembre, fromage râpé, moutarde', '10 min', ['Tartinez les tranches de jambon avec la moutarde. Saupoudrez avec les épices et salez légèrement. ', 'Disposez sur chaque tranche une 1/2 banane coupée dans le sens de la longueur et un peu de fromage râpé. ', 'Roulez l''ensemble comme un cigare, attachez avec de la ficelle de boucher ou un pic. ', 'Mettez le tout dans un plat à four, recouvrez de râpé et mettez au four 5 à 10 minutes selon la taille .'], ['Fouet', 'Râpe', 'Planche à découper', 'Verre doseur'], ['', 'gingembre', 'entrée', 'banane', 'recettes de cuisine', 'jambon', 'confiserie', 'testées', 'très facile', 'bon marché', 'paprika', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moutarde', 'Jambon des îles à la banane', 'cocktail', 'fromage râpé'], 'Entrée', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:28:44.992115', [{'ingredient_id': 'c7fa42d7-c609-448c-aac6-a9eb0197428d', 'quantite': '4'}, {'ingredient_id': '1d31f185-6d9e-47b3-9980-7a721ebdf02b', 'quantite': '2'}, {'ingredient_id': '29984fd0-40d7-4cf8-8e7f-2215cf914957', 'quantite': ''}, {'ingredient_id': 'a5554371-e2f2-4a13-8a4c-9d80fad5f74b', 'quantite': ''}, {'ingredient_id': 'd05acf33-5eb8-452f-a871-329e58fa0ba1', 'quantite': ''}, {'ingredient_id': '1d0c509a-d66f-4ad8-8470-09eb827f214e', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (69411, 'Tarte fraise banane sur lit de pomme-coco', 'pâte sablée, compote, sucre en poudre, crème, fromage blanc, oeuf, noix de coco, banane, fraises, cannelle', '15 min', ['Mettez votre pâte sablée dans un moule à tarte après l''avoir préalablement graissé (beuure ou huile), ou utilisez la feuille de cuisson si c''est une pâte achetée.', 'Faîtes des petits trous au fond à l''aide d''une fourchette.', 'Etalez la compote au fond de la tarte. Mélangez le fromage blanc avec 1 cuillère à soupe de sucre et étalez-le par-dessus la compote.', 'Fouettez la crème, l''oeuf, et la noix de coco avec une petite cuillère à café de sucre et ajouter ce mélange au-dessus des précédents.', 'Découper les fraises en deux ou en quatre et garnissez la tarte suivant vos désirs de décoration. Couper les bananes en rondelles et remplissez les trous laissés.', 'Saupoudrez de cannelle.', 'Mettez votre tarte au four préchauffé à 180°C (thermostat 6) et laissez cuire pendant 20-25 min.'], ['Batteur électrique', 'Spatule', 'Planche à découper', 'Pince de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'pâte sablée', 'oeuf', 'plat', 'fraises', 'sucre en poudre', 'crème', 'recette', 'compote', 'cuisine', 'tarte aux fraises', 'recettes', 'boisson', 'fromage blanc', 'dessert', 'plat de résistance', 'noix de coco', 'cannelle', 'cocktail', 'Tarte fraise banane sur lit de pomme-coco'], 'Dessert', 88e40517-f88f-415d-b15d-4c4df553e470, '2025-09-26T15:28:48.569946', [{'ingredient_id': '0b13ce1b-f367-487a-a527-d928263d226f', 'quantite': '1'}, {'ingredient_id': '783dcdff-59ad-4b91-9f26-671c3872540d', 'quantite': '4 cuillères'}, {'ingredient_id': '14a6689f-8ffb-44cf-80d7-dfc9b967b6ab', 'quantite': '1 cuillères'}, {'ingredient_id': '867247b2-be99-4b0c-8390-f1306dc5eeb6', 'quantite': '4 cuillères'}, {'ingredient_id': '505f021d-3df9-4a7c-98e3-561e16e6a21f', 'quantite': '4 cuillères'}, {'ingredient_id': '0a1d765e-c759-4f2e-9288-118fd49c4a21', 'quantite': '1'}, {'ingredient_id': 'a7797ee8-c46f-4403-ad62-3d0a6e94b300', 'quantite': '20 g'}, {'ingredient_id': '1015c1a9-987c-47d8-a6e2-0aaccfa6cd34', 'quantite': '2'}, {'ingredient_id': '100695ce-08f0-4c9a-a0b8-b45cf6064cd4', 'quantite': '8'}, {'ingredient_id': 'cd95ffe7-4314-411b-8e51-4e2971e3d1fe', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (62261, 'White smoothie rafraîchissant', 'banane, pêche, pomme, citron vert, glaçons', '2 min', ['Mettez quelques glaçons et un peu d''eau dans le fond de votre blender.', 'Epluchez et coupez-y en morceaux les fruits.', 'Ajoutez le jus du citron vert, mixez jusqu''à ce qu''il n''y ait plus de morceaux visibles.', 'Ajoutez des glacons et mixez jusqu''à obtenir un liquide pas trop épais (à votre convenance).', 'Buvez, ça rafraîchit !'], ['Poêle', 'Râpe'], ['entrée', 'banane', 'recettes de cuisine', 'White smoothie rafraîchissant', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'glaçons', 'citron vert', 'pêche', 'smoothies', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:28:52.068467', [{'ingredient_id': 'fba862c4-178b-400f-a335-f85291ca1af6', 'quantite': '1'}, {'ingredient_id': 'e3dceaaf-86fb-4f39-b480-f8f422a75794', 'quantite': '1'}, {'ingredient_id': '7aa339b2-363e-4d1f-a6d8-6737e43001cc', 'quantite': '1'}, {'ingredient_id': 'd5026557-ce7a-427b-94fc-5d7c6cdf32ef', 'quantite': '1'}, {'ingredient_id': 'fef34513-77db-4e34-915b-d5890749c96d', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (26610, 'Punch', 'rhum, jus d''orange, jus d''ananas, mangue, jus d''abricot, sucre de canne, banane', '10 min', ['Dans un grand saladier (pouvant contenir 5 litres ou à défaut une marmite), versez tous les ingrédients y compris les bananes coupées en fines lamelles. ', 'Réservez 2 heures au réfrigérateur.'], ['Balance de cuisine', 'Passoire', 'Fouet'], ['jus d''abricot', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'sucre de canne', 'punch', 'dessert', 'plat de résistance', 'jus d''ananas', 'jus d''orange', 'Punch', 'cocktail'], 'Boisson', 6954bfec-9549-4b91-9bdf-d54eea584672, '2025-09-26T15:28:58.715140', [{'ingredient_id': '73790fae-a6c1-4b37-903a-afd3458a0652', 'quantite': ''}, {'ingredient_id': 'cd08dd99-0f38-4958-b714-3b63d8a022b2', 'quantite': '1 l'}, {'ingredient_id': 'c7207d71-7292-41e6-8d26-419b05ca7e0b', 'quantite': '1 l'}, {'ingredient_id': '77336412-c824-473e-a36c-8daaa9015995', 'quantite': '1 l'}, {'ingredient_id': 'd879cfa0-6f47-465e-b9f4-0dc672109647', 'quantite': '1 l'}, {'ingredient_id': 'a171b297-a5d2-4b24-8078-67ed63be0b73', 'quantite': '2'}, {'ingredient_id': 'ee33bebe-0662-4a1f-968b-311927ad203e', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (335758, 'Compote pomme & banane', 'pomme, banane, eau, sucre, vanille', '15 min', ['Éplucher et épépiner les pommes. Les découper en cubes.', 'Éplucher les bananes et les découper en rondelles.', 'Dans une casserole, mettre les fruits, le sucre, la vanille en poudre et ajouter 1/2 verre d’eau.', 'Couvrir la casserole et laisser mijoter à feu doux pendant 20 min. Remuer régulièrement.', 'Mixer le tout et laisser refroidir à température ambiante.', 'Verser dans des coupelles et placer au réfrigérateur.'], ['Rouleau à pâtisserie', 'Râpe', 'Fouet', 'Spatule', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'facile', 'compote de pomme', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'vanille', 'dessert', 'plat de résistance', 'pomme', 'sucre', 'cocktail', 'Compote pomme & banane'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:29:02.321627', [{'ingredient_id': 'ff62f56d-69c7-4006-81ad-31f67f30291d', 'quantite': '4'}, {'ingredient_id': '365d64f9-9e77-463b-a788-fd69175d3cd1', 'quantite': '2'}, {'ingredient_id': '04ab5d8a-63c7-4160-bdb5-d9471f15f64e', 'quantite': '10 cl'}, {'ingredient_id': '24b61037-126a-4ac4-a2ac-75f0a6ef7588', 'quantite': '1 cuillères'}, {'ingredient_id': '0c4385bb-c769-423c-af0c-387bf99e43f3', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (27846, 'La terrible tarte banane-fromage blanc', 'pâte sablée, banane, fromage blanc, crème fraîche, sucre roux, vanille, oeuf', '20 min', ['1) Etaler la pâte dans un moule à tarte. ', '2) Mélanger le fromage blanc, la crème, le sucre, la vanille, et les oeufs jusqu''à obtenir une préparation lisse (utiliser un fouet électrique éventuellement). ', '3) Coupez les bananes en rondelles d''1/2 cm et disposez-les harmonieusement sur la pâte, en rangs serrés. ', '4) Verser la préparation au fromage blanc sur les bananes. ', '5) Faire cuire environ 45 mn à 180°C, jusqu''à ce que la garniture soit prise et la pâte bien dorée. ', '6) Laisser refroidir.', '7) Cette tarte se sert bien froide. Bon appétit!'], ['Couteau de chef', 'Pince de cuisine', 'Ouvre-boîte', 'Louche', 'Poêle'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'très facile', 'bon marché', 'La terrible tarte banane-fromage blanc', 'pâte sablée', 'oeuf', 'plat', 'tarte à la banane', 'recette', 'cuisine', 'recettes', 'boisson', 'fromage blanc', 'vanille', 'dessert', 'plat de résistance', 'cocktail', 'sucre roux'], 'Dessert', 45e798d4-d4e4-433a-9b13-87a793f474e7, '2025-09-26T15:29:05.853290', [{'ingredient_id': 'fc3ff98b-12cb-48ec-a996-ef0d4663a648', 'quantite': '1'}, {'ingredient_id': '3a574057-1bbc-46c1-b8eb-a7243512d81c', 'quantite': '4'}, {'ingredient_id': 'd4d984a6-d8fe-4527-b01a-5957bc2d8ee5', 'quantite': '500 g'}, {'ingredient_id': '6dbcaecc-751e-46c9-a450-b890b402af63', 'quantite': '250 g'}, {'ingredient_id': '8474b4cc-0a8c-4ba5-8940-dce4bd2a20b8', 'quantite': '125 g'}, {'ingredient_id': 'c1435696-c996-486d-8167-f437be05b49f', 'quantite': ''}, {'ingredient_id': '7d020f4f-6768-4443-8b78-a466e6f88213', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (18639, 'Délice satiné aux kiwis', 'kiwi, banane, jus d''orange, citron, sucre vanillé, glace vanille', '10 min', ['1 ) Pelez et mixez les kiwis et les bananes. Versez le jus d''orange et de citron, incorporez le sucre vanillé. ', '2 ) Laisser reposer environ 30 mn au réfrigérateur, ajouter la glace à la vanille et mixer à nouveau délicatement.', '3 ) Répartissez le smoothie (délice) dans 4 verres et servir aussitôt. ', 'Conseil : Un soupçon de lait de coco à la place de la glace à la vanille confère à votre smoothie une certaine onctuosité et une note typiquement tropicale.'], ['Rouleau à pâtisserie', 'Passoire'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'Délice satiné aux kiwis', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'glace vanille', 'dessert', 'plat de résistance', 'sucre vanillé', 'citron', 'jus d''orange', 'cocktail'], 'Boisson', 54a73e1b-0a2d-42ee-add6-29b9f215c03c, '2025-09-26T15:29:10.109815', [{'ingredient_id': '707d18d7-1360-433e-9bb0-aaf8b1bf9496', 'quantite': '8'}, {'ingredient_id': '7343d447-8d92-40d0-9c09-7a5a471dc832', 'quantite': '2'}, {'ingredient_id': '4c2b594a-0e03-413a-a3b7-6b6eaa526401', 'quantite': '200 ml'}, {'ingredient_id': 'e7fd2eba-9166-47c1-9d05-5bbefbec290c', 'quantite': '4'}, {'ingredient_id': 'b759491c-6cf4-4cd5-84bf-6ac86c877dc4', 'quantite': '9 cuillères'}, {'ingredient_id': '296e8d83-2822-4454-b043-617484a2f865', 'quantite': '1 l'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (33628, 'Gâteau au banania rapide', 'sucre en poudre, oeuf, Banania, farine, brique', '10 min', ['Mélanger le sucre plus les œufs pendant 5 min vigoureusement. ', 'Ajouter le banania et la farine. Bien mélanger. ', 'Ajouter la crème. Mélanger. ', 'Cuire à four moyen environ 45 min.'], ['Balance de cuisine', 'Louche'], ['', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'sucre en poudre', 'Banania', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'Gâteau au banania rapide', 'brique', 'cocktail'], 'Dessert', b601aea1-a8a8-4831-8f7c-e619e6e87a18, '2025-09-26T15:29:14.568324', [{'ingredient_id': '58237432-dacb-4c42-8f93-4abc86b206bf', 'quantite': '175 g'}, {'ingredient_id': '9b28f476-2e0a-410e-8a81-d014a27f9dbb', 'quantite': '4'}, {'ingredient_id': '30c31c6d-dd07-4af5-8ca5-aef024a8eb85', 'quantite': '125 g'}, {'ingredient_id': 'f03f4f07-1a4f-4c86-aedf-24209f3a47e2', 'quantite': '125 g'}, {'ingredient_id': '920f4004-1a7e-4474-a985-a8c506865cf8', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (73766, 'L''anneau d''Aladin', 'oeuf, amandes en poudre, sucre glace, farine, beurre, sucre semoule, cannelle, vanille, orange, sucre, eau, ananas, pamplemousse, orange, mangue, banane, carambole, grenade, pitaya', '45 min', ['Biscuit: Réchauffez le four à 210/220°, thermostat 7-8.', 'Dans une jatte, mélangez énergiquement, au fouet à main ou au batteur, 3 oeufs entiers et 3 jaunes, la poudre d''amandes et le sucre glace jusqu''à ce que le mélange blanchisse. ', 'Ensuite, ajoutez délicatement la farine tamisée et le beurre fondu. ', 'Incorporez les 3 blancs d''oeufs montés en neige avec le sucre semoule, la cannelle et la vanille.', 'Beurrez et farinez un moule à savarin de 24 cm de diamètre. Versez la pâte à biscuits dans le moule et faites cuire 35 à 40 min au four à 180/200°, thermostat 6-7. ', 'Après la cuisson, démoulez sur un torchon et laissez refroidir.', 'Salade de fruits: pelez l''orange et le pamplemousse à vif. ', 'Epluchez la mangue et coupez-la en lamelles. ', 'Egrenez la moitié de la grenade. ', 'Epluchez l''ananas et coupez-le en fines tranches. ', 'Pelez la banane et coupez-la en fines rondelles. ', 'Rincez le pitahaya et coupez-le en 2. Epluchez une moitié et coupez la chair en petits dés. Réservez l''autre moitié pour le décor. ', 'Rincez la carambole et coupez-la en tranches.', 'Sirop: portez l''eau et le sucre à ébullition. Arrêtez dès le premier bouillon.', 'Posez le gâteau sur un plat de service. Imbibez-le avec le jus d''orange. Répartissez les fruits au centre du gâteau. Arrosez de sirop.'], ['Batteur électrique', 'Économe', 'Couteau de chef', 'Spatule', 'Casserole'], ['', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'L''anneau d''Aladin', 'facile', 'amandes en poudre', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'sucre semoule', 'boisson', 'farine', 'vanille', 'dessert', 'plat de résistance', 'moyen', 'beurre', 'orange', 'sucre glace', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:29:18.743575', [{'ingredient_id': '484ab9c2-5602-489e-91bf-adbd7e50737e', 'quantite': '6'}, {'ingredient_id': '896903de-229f-4235-8a3c-95fb6d044c89', 'quantite': '150 g'}, {'ingredient_id': '7ff0ce4b-c681-4de7-a3da-6c4f8320c0bf', 'quantite': '150 g'}, {'ingredient_id': '25704382-4447-49a2-bc46-4527319434db', 'quantite': '80 g'}, {'ingredient_id': 'fe1e732d-7700-43df-9216-1258a9a1c12b', 'quantite': '40 g'}, {'ingredient_id': 'b2392157-2a7b-4a9a-9501-bd7647876c30', 'quantite': '40 g'}, {'ingredient_id': '10d6a11d-dfaf-44d1-927c-03492473dacb', 'quantite': ''}, {'ingredient_id': '94392e20-e4f7-46cb-8998-fa9675515e99', 'quantite': '3'}, {'ingredient_id': 'bf847753-3d51-4895-a1c1-3bf09bc66792', 'quantite': '2'}, {'ingredient_id': 'fb46e2e5-dc75-4d35-97e1-3db8f4f84cda', 'quantite': '200 g'}, {'ingredient_id': '583adf42-e8a9-421d-84fb-ecbe583a66df', 'quantite': '20 cl'}, {'ingredient_id': '214f5f3a-11a4-42c9-88ba-eebdbb526493', 'quantite': '1'}, {'ingredient_id': 'c44dffc8-58dd-4bc6-a4da-eff7db97b206', 'quantite': '1'}, {'ingredient_id': '18deaa29-9726-4681-8905-8925a1f5d294', 'quantite': '1'}, {'ingredient_id': '567e3ee1-02db-4ee6-afe2-78c98a64ae6e', 'quantite': '1'}, {'ingredient_id': 'c18b34b3-96ea-47a5-a239-6e961d41b4ab', 'quantite': '1'}, {'ingredient_id': 'e032c82c-bffa-46b6-a90a-7fa416ff5942', 'quantite': '1'}, {'ingredient_id': '75fdd1b8-6169-4653-a9be-4116d2f0b2b5', 'quantite': '1'}, {'ingredient_id': 'a569f235-78d2-411f-b8e0-c3dc0dcf0058', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (166053, 'Gâteau sans oeuf banane-amande', 'farine, sucre, amandes en poudre, margarine, lait de riz, crème végétale, levure, cognac, banane', '15 min', ['Mélanger le sucre, la poudre d''amande, la farine et la levure.', 'Ajouter la margarine, le lait de riz, la crème de soja et le cognac.', 'Couper les bananes en rondelles, les ajouter à la préparation.', 'Verser le tout dans un plat à gâteau et enfourner 20 à 30 min selon la puissance de votre four, à 180°C (thermostat 6).'], ['Louche', 'Pince de cuisine', 'Ouvre-boîte'], ['lait de riz', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'amandes en poudre', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'crème végétale', 'margarine', 'dessert', 'plat de résistance', 'gâteau à la banane', 'Gâteau sans oeuf banane-amande', 'sucre', 'cognac', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:29:22.899220', [{'ingredient_id': '95086a24-0c5c-4b81-8e34-080b3a35e129', 'quantite': '250 g'}, {'ingredient_id': 'c7664411-2815-4ecd-9438-b0b0144d26d5', 'quantite': '150 g'}, {'ingredient_id': '08c5f50b-62f2-417d-8267-983e28cc8790', 'quantite': '150 g'}, {'ingredient_id': '682b72f4-21be-44b8-b8f5-45294a0e8df9', 'quantite': '50 g'}, {'ingredient_id': '983b1dbf-3790-44ed-b320-5e06c465f9a3', 'quantite': '25 cl'}, {'ingredient_id': '47321817-a077-4b4f-a8e7-d5fa1e496e09', 'quantite': '20 cl'}, {'ingredient_id': '25a5cd01-ea04-4ec9-8984-c7f0addf0a09', 'quantite': '1'}, {'ingredient_id': '031bd9a8-dea6-40b9-8b71-a6d389882200', 'quantite': '2 cuillères'}, {'ingredient_id': 'd5c12ee6-c864-4040-b604-cad14c67ccc7', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (11095, 'Pain aux bananes', 'beurre, sucre, oeuf, farine, bicarbonate, levure chimique, sel, banane, noix', '20 min', ['Battre le beurre et le sucre jusqu''à obtention d''un mélange crémeux.', 'Ajouter les oeufs un par un et bien battre. ', 'Tamiser la farine avec la levure, le bicarbonate et le sel.', 'Ajouter au mélange crémeux alternativement avec la banane. Ajouter les noix.', 'Verser dans un moule rectangulaire graisse faire cuire au four à 170°C (thermostat 5-6) pendant 55 à 60 minutes.'], ['Verre doseur', 'Moule à tarte', 'Planche à découper', 'Couteau de chef', 'Rouleau à pâtisserie'], ['', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'levure chimique', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'noix', 'recettes', 'boisson', 'farine', 'Pain aux bananes', 'dessert', 'plat de résistance', 'beurre', 'sucre', 'cocktail', 'bicarbonate'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:29:28.479803', [{'ingredient_id': '25784c88-ae3c-4429-842d-490a7a9a950a', 'quantite': ''}, {'ingredient_id': '095d2661-9e22-47cf-adca-526d389ccff3', 'quantite': '1'}, {'ingredient_id': '5a218f69-3c56-48a4-b31f-9950b0fdb927', 'quantite': '2'}, {'ingredient_id': 'e716d89c-0924-4e1e-9848-e81391a1c7b6', 'quantite': '2'}, {'ingredient_id': 'dc706249-17a3-4968-8e57-227e7579e064', 'quantite': ''}, {'ingredient_id': '7af9000c-377b-411d-9f05-55729fde3d73', 'quantite': ''}, {'ingredient_id': '29ac3f19-8894-485d-b0d3-d73ad5987b87', 'quantite': ''}, {'ingredient_id': 'c40a6014-784d-41a7-ae43-453930b4d42b', 'quantite': '3'}, {'ingredient_id': '0dcd45c6-30a4-4700-9d46-f8bb6b9ca879', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (31719, 'gratin de bananes et de pommes', 'banane, pomme, farine, beurre, sucre, sel', '10 min', ['Dans un moule à gratin beurré, mettre les morceaux de pomme coupés en petits dés et les bananes en rondelles. ', 'Mélangez la farine avec le sucre et la pincée de sel. ', 'Ajoutez le beurre ramolli et travaillez la pâte jusqu''à ce qu''elle s''émiette. ', 'Recouvrir les fruits et faire cuire 40 mn environ à four chaud.'], ['Couteau de chef', 'Balance de cuisine', 'Passoire', 'Batteur électrique', 'Verre doseur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'pomme', 'gratin de bananes et de pommes', 'beurre', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:29:32.034593', [{'ingredient_id': 'acd32323-8f55-4574-907f-c2aa2126dc35', 'quantite': '6'}, {'ingredient_id': 'dfc7cbbe-dc55-4050-86ed-20ed271a306e', 'quantite': '5'}, {'ingredient_id': '096f7090-bec3-4ce8-9004-048280d81bd9', 'quantite': '250 g'}, {'ingredient_id': '1ec2f7c7-6abb-4572-a0e7-cbc6a1cf2ad1', 'quantite': '25 g'}, {'ingredient_id': '0507d26f-6306-469d-87cb-f0ad68f19d85', 'quantite': '75 g'}, {'ingredient_id': 'fd221dea-6d24-483f-a304-828c5a060ccc', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (16161, 'Cake aux bananes et rhum', 'farine, maïzena, levure chimique, sucre, rhum, banane, oeuf, beurre, sel', '20 min', ['Dans une terrine, battre le beurre ramolli au bain marie avec le sucre et le sel.', 'Incorporer les oeufs sans cesser de battre. Ajouter ensuite la farine, la maïzena, la levure les bananes écrasées et enfin le rhum.', 'Verser le mélange dans un moule à cake beurré. Faire cuire au four 13 mn à 200°C (thermostat 6) puis 43 mn à 160°C (thermostat 4).'], ['Casserole', 'Couteau de chef', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'sel', 'confiserie', 'testées', 'levure chimique', 'Cake aux bananes et rhum', 'facile', 'maïzena', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'autres cakes', 'dessert', 'plat de résistance', 'beurre', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:29:35.563641', [{'ingredient_id': '3eeee104-5904-47e1-bfc6-58324b90da5c', 'quantite': '200 g'}, {'ingredient_id': 'dde1ed35-4adb-4c91-ab81-b144c3541035', 'quantite': '100 g'}, {'ingredient_id': '19b7e686-1175-4b36-8e5f-42de5072248b', 'quantite': '1'}, {'ingredient_id': '5e0eb38d-3b96-4879-8c82-dc8f9e2479e8', 'quantite': '150 g'}, {'ingredient_id': '4a80fa18-f726-4dce-89a4-ad3c3af2787d', 'quantite': '4 cuillères'}, {'ingredient_id': '43e4c163-5d7e-4b2a-84d4-9f92d55f3abf', 'quantite': '3'}, {'ingredient_id': '0e663543-f754-4cf4-8644-2e79d2914f34', 'quantite': '4'}, {'ingredient_id': 'fb61ac98-8676-4063-b434-8dc32b4882d2', 'quantite': '150 g'}, {'ingredient_id': '9b8bac68-286c-4d9a-aa64-f20711aa7bf3', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (166729, 'Bananes malaxées (Cameroun)', 'banane, boeuf, oignon blanc, piment, bouquet garni, pâte d''arachide, sel, poivre, cube Maggi, huile', '15 min', ['Préparer la viande : bien laver la viande avec une eau vinaigrée et la coupée en morceaux. Ensuite la mettre dans une casserole avec de l’eau et la faire bouillir pendant 10 min environ. ', 'Pendant ce temps, éplucher les bananes. Attention, cette opération est fastidieuse car les bananes ne sont pas mûres. Faire une entaille dans la peau le long de la banane et la peler. Réserver les bananes. ', 'Diluer la pâte d’arachide avec de l’eau de façon à obtenir une sauce. La quantité d’eau est à vue de nez et selon l’appréciation de chacun : si vous voulez une sauce très liquide, vous mettrez pas mal d’eau, au contraire, si vous voulez une sauce assez épaisse, vous mettrez peu d’eau. ', 'Peler et émincer l’oignon. Laver et couper le piment en petits morceaux. ', 'Dans une cocotte sur feu doux, mettre la cuiller à soupe d’huile et y mettre l’oignon et le piment quelques minutes. Ca ne doit pas colorer. Ajouter ensuite les bananes entières, la viande égouttée et laisser à couvert 10 minutes environ sur feu doux en remuant de temps en temps pour ne pas que ça accroche. ', 'Enfin, ajouter la sauce d’arachides, un peu de sel, les 3 cubes et une pincée de poivre. La sauce doit bien recouvrir la garniture. Si tel n’est pas le cas, ajouter un peu d’eau. Laisser mijoter environ 30 minutes à couvert sur feu doux.'], ['Pince de cuisine', 'Couteau de chef', 'Fouet'], ['Bananes malaxées (Cameroun)', 'entrée', 'banane', 'recettes de cuisine', 'boeuf', 'sel', 'confiserie', 'testées', 'cube Maggi', 'facile', 'bouquet garni', 'plats africains', 'bon marché', 'plat', 'recette', 'pâte d''arachide', 'piment', 'cuisine', 'recettes', 'boisson', 'huile', 'dessert', 'oignon blanc', 'plat de résistance', 'poivre', 'cocktail'], 'Plat principal', a204acb7-358e-480f-9dd5-d042cc39590f, '2025-09-26T15:29:39.565551', [{'ingredient_id': '2a84ea0c-8df7-4d05-997f-954e46731053', 'quantite': '12'}, {'ingredient_id': '7b468acc-86f0-4b58-87f3-04cebc866a7f', 'quantite': '600 g'}, {'ingredient_id': 'caedcd95-bf15-44e9-9e50-8f5d77db90ac', 'quantite': '1'}, {'ingredient_id': '3538a4b6-d3bc-48b6-852b-181a92d6ad58', 'quantite': '1'}, {'ingredient_id': 'f897b9ca-ee82-4afa-ad38-418321bccf41', 'quantite': '1'}, {'ingredient_id': 'c2050e47-3692-4dfd-8cc3-11c087afea8f', 'quantite': '6 cuillères'}, {'ingredient_id': 'bd0fba77-8e5e-41da-9666-b27402c98fe2', 'quantite': ''}, {'ingredient_id': '7625891d-406d-4a38-aafe-8546e4f07b66', 'quantite': ''}, {'ingredient_id': '6e7e9c50-80b5-489c-bdf6-cf4da2184456', 'quantite': '3'}, {'ingredient_id': '3bcdf0cc-dad7-429a-aeff-bcd51fcb2672', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (28469, 'Bananes rôties au bacon et  riz aux raisins', 'banane, bacon, riz, raisins secs, poivron rouge, rhum, tomate, huile, poivre, sel', '25 min', ['Faites gonfler les raisins dans le rhum pendant 15 minutes.', 'Lavez le riz à grande eau, faites-le cuire à l''eau bouillante salée. Egouttez et incorporez-y les raisins égouttés et le poivron détaillé en petits dés.', 'Epluchez les bananes et enroulez chacune d''elle dans une tranche de bacon. Maintenez à l''aide de piques en bois et faites dorer dans l''huile chaude. ', 'Préchauffez le gril du four.', 'Déposez le riz dans un plat beurré et les bananes par dessus. Ajoutez les tomates pelées et coupées en dés.', 'Enfournez quelques minutes au four jusqu''à ce que le dessus soit bien doré.'], ['Ouvre-boîte', 'Mixeur', 'Planche à découper', 'Presse-agrumes'], ['bacon', 'banane', 'entrée', 'recettes de cuisine', 'rhum', 'sel', 'confiserie', 'testées', 'facile', 'tomate', 'plat', 'Bananes rôties au bacon et  riz aux raisins', 'recette', 'cuisine', 'poivron rouge', 'recettes', 'boisson', 'huile', 'plat de riz', 'dessert', 'plat de résistance', 'riz', 'moyen', 'raisins secs', 'poivre', 'cocktail'], 'Plat principal', bbdf1f5a-435b-48fa-ae97-4260fdd5cc34, '2025-09-26T15:29:43.105062', [{'ingredient_id': 'c1f01941-6c97-463a-8aec-6b6beccb9bcc', 'quantite': '4'}, {'ingredient_id': '3f7bc234-663b-49e6-989e-d6e6a3e88231', 'quantite': '4'}, {'ingredient_id': '67856538-8fed-49ad-8ac1-9bcbb982d3fe', 'quantite': '250 g'}, {'ingredient_id': '1fa02a39-a90f-46f6-a484-1208b5c81cbc', 'quantite': '100 g'}, {'ingredient_id': 'dadddc45-d7c5-43a5-b13d-cb1a9a8ce8c5', 'quantite': '1'}, {'ingredient_id': '5075cae7-e427-49d8-b384-7fcb75af2392', 'quantite': '10 cl'}, {'ingredient_id': '53c3a8e3-6455-4b79-b685-8b9168c5c52f', 'quantite': '6'}, {'ingredient_id': '05d08c87-1552-4432-b4e2-d9ee3a16b18f', 'quantite': '1 cuillères'}, {'ingredient_id': '3511188c-4039-4ef4-95bd-0fc4922c7f21', 'quantite': ''}, {'ingredient_id': '4769cb55-be16-479f-8b1f-53c0ade74209', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (39075, 'Soupe chinoise sucrée', 'eau, perles du Japon, banane, crème, lait de coco, sucre en poudre', '10 min', [' Dans une casserole, faire bouillir 1/2 litre d''eau avec 4 cuillères à soupe de perles du Japon pendant 9 mn. ', 'Ajouter 1/2 banane coupée en fines rondelles et continuer à faire bouillir pendant 3 mn. ', 'Dans un bol, délayer 2 cuillères à soupe de crème de riz dans un peu d''eau froide (pour éviter les grumeaux). ', 'Mettre cette préparation dans la casserole et continuer à faire cuire 3 mn. ', 'En fin de cuisson, ajouter du lait de coco et du sucre en poudre.'], ['Passoire', 'Ouvre-boîte', 'Batteur électrique'], ['', 'lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'perles du Japon', 'très facile', 'bon marché', 'plat', 'crème', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'Soupe chinoise sucrée', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:29:46.608924', [{'ingredient_id': 'ca762115-6444-4c84-b9d3-999607760a77', 'quantite': ''}, {'ingredient_id': '2f2bcd07-fe98-4cb0-9bda-bac74d846fbf', 'quantite': '4 cuillères'}, {'ingredient_id': '15a80bb9-1a05-4c41-bf2a-58686d5a96ec', 'quantite': ''}, {'ingredient_id': '02e7a408-d26d-409a-a4a6-6ffe862fc5be', 'quantite': '2 cuillères'}, {'ingredient_id': '7e320be4-a265-4261-b9b7-7e0f414d28cf', 'quantite': ''}, {'ingredient_id': 'a5aeb852-40a4-49a4-b804-7ac84d437a51', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (529822, 'Bananes suzette par Laurent Mariotte', 'banane, beurre, sucre blond, orange, grand-marnier', '15 min', ['Epluchez les bananes et coupez-les en trois tronçons.
Placez sur une assiette et mettez-les au congélateur pour 1 h.', 'Dans une grande poêle, faites fondre le beurre avec le sucre et le zeste d’une orange. Pressez le jus des oranges. Poêlez rapidement les tronçons de bananes dans ce mélange et débarrassez.', 'Colorez légèrement le beurre sucré puis déglacez avec le jus d’orange. Faites réduire de moitié cette sauce puis plongez à nouveau les tronçons de bananes.', 'Enrobez-les puis versez le Grand Marnier dans la poêle. Chauffez un peu puis flambez le tout avec une allumette. Dressez dans un plat creux et dégustez aussitôt.'], ['Rouleau à pâtisserie', 'Poêle', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'sucre blond', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'Bananes suzette par Laurent Mariotte', 'orange', 'grand-marnier', 'cocktail'], 'Dessert', 8e8b1cbe-79ac-44e1-9f8c-aa8b7b63a6da, '2025-09-26T15:29:50.104893', [{'ingredient_id': '69cfd6ab-63dc-472a-8f07-3f9c82df1f1c', 'quantite': '4'}, {'ingredient_id': '5d711cdb-156b-44df-a6ae-cd0d6e1a581a', 'quantite': '50 g'}, {'ingredient_id': 'b840b68e-e918-4eb1-8536-657fea75548e', 'quantite': '75 g'}, {'ingredient_id': '1e2ef533-52fb-463e-bbbb-f525e8db54f8', 'quantite': '3'}, {'ingredient_id': '30a16952-b139-471e-8cff-f1d619b73756', 'quantite': '5 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (61767, 'La banane glacée à la stracciatella', 'banane, cacao, lait, crème, vermicelles', '10 min', ['Tout d''abord commencez par le coulis de chocolat. Versez les 2 cuillères à soupe de cacao dans un verre quelconque avec vos 4 cl de lait et mélangez bien le tout.', 'Ensuite coupez chaque bananes en deux...Les quatre partie seront recoupées en fine tranches.', 'Le final : prenez 4 coupes à glaces et mettez 3 boules de glace dans chaque coupes.', 'Versez ensuite la moitié du coulis de chocolat que vous avez préparé avec une cuillère par dessus les boules de glaces.', 'Maintenant vous pouvez éparpiller vos tranches de bananes sur la glace et versez le reste du coulis de chocolat sur les morceaux de bananes. Les vermicelles seront posés sur le dernier coulis de chocolat...', 'Bon appétit!!'], ['Râpe', 'Poêle'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'vermicelles', 'bon marché', 'cacao', 'rapide', 'plat', 'crème', 'recette', 'cuisine', 'La banane glacée à la stracciatella', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:29:53.627723', [{'ingredient_id': '83a52ed7-a9b2-4f63-ba0d-3a1cee506a56', 'quantite': '2'}, {'ingredient_id': 'b4f82aad-effd-4053-864e-57ead2653d95', 'quantite': '2 cuillères'}, {'ingredient_id': 'e2f7df77-4aaf-4391-beab-5e81ad3ac033', 'quantite': '4 cl'}, {'ingredient_id': '345a1bcc-5f71-48c3-bf7c-0db21f01ec0b', 'quantite': ''}, {'ingredient_id': '8f9244a0-3f4f-4819-99a4-fc88d5f4d96b', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (72512, 'Fondant chocolat banane par Margot', 'oeuf, farine, beurre, chocolat, sucre, levure, banane, crème, rhum', '20 min', ['Eplucher les bananes et les poser dans un plat, les découper en rondelles et saupoudrer de sucre (très bon aussi avec cassonade et rhum). Faire cuire au four à 180°C (thermostat 6) pendant 15 min.', 'Mélanger les jaunes d''oeufs avec le sucre. Faire fondre le beurre et le chocolat. Ajouter la crème. Mélanger et incorporer au mélange oeufs-sucre.', 'Ajouter farine, levure et pincée de sel. Bien mélanger. ', 'Monter les blancs d''oeufs en neige. Les incorporer délicatement au mélange. ', 'Une fois les bananes bien dorées et caramélisées, les ajouter au mélange. Reverser dans le plat beurré et mettre le tout à cuire pendant environ 20 min, au four à 180°C (thermostat 6).'], ['Balance de cuisine', 'Ouvre-boîte', 'Verre doseur', 'Moule à tarte'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'chocolat', 'facile', 'bon marché', 'oeuf', 'plat', 'crème', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'fondant au chocolat', 'plat de résistance', 'beurre', 'Fondant chocolat banane par Margot', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:29:57.254857', [{'ingredient_id': '3c406eb7-7625-4496-aa68-d1c916fb7412', 'quantite': '4'}, {'ingredient_id': '427e6baf-f9cb-4b9f-acdc-606c4a6047ec', 'quantite': '60 g'}, {'ingredient_id': '040167db-e62c-4531-969b-338e5443ad33', 'quantite': '80 g'}, {'ingredient_id': '1938938f-4481-4e0c-8ec5-60b3c2d4d038', 'quantite': '200 g'}, {'ingredient_id': '511648e9-ce87-4244-9752-cc109be723ae', 'quantite': '80 g'}, {'ingredient_id': '20f04324-c85c-41ef-aaf7-3d05ba96b209', 'quantite': '1 cuillères'}, {'ingredient_id': '83248ec5-f250-471d-8ae9-6c277d7ff233', 'quantite': '4'}, {'ingredient_id': '43d69545-7ad1-4a25-b142-88a1f902188f', 'quantite': '10 cl'}, {'ingredient_id': '73277e8f-f626-481e-853d-c1b7e8665e7d', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (86581, 'Mille feuilles Bourbon de Tatoubatou', 'banane, sucre roux, eau, arôme vanille, galettes (bretonnes), glace vanille, rhum', '15 min', ['Préparer tout d''abord un caramel : dans une poêle anti-adhésive chaude, mélanger le sucre roux et l''eau afin d''obtenir un caramel sirupeux.', 'Y faire macérer quelques minutes la gousse de vanille fendue ou alors y verser quelques gouttes selon le goût d''arôme vanille.', 'Enlever la gousse après en avoir raclé les grains.', 'Dans ce caramel, faire fondre les bananes coupées dans la longueur, attendre qu''elles dorent des deux côtés avant de les flamber avec deux bonnes cuillères à soupe de rhum.', 'Sortir deux verres à whisky pour composer le mille-feuilles.', 'Dans un ramequin, préparer un mélange de rhum et d''eau en égale proportion.', 'Commencer le mille feuille par une couche de bananes chaude, recouvrir de glace à la vanille puis d''une galette bretonne rapidement trempée recto verso dans le contenu du ramequin.', 'Poursuivre par une couche de bananes suivie de glace et d''une autre galette.', 'Terminer par de la glace.', 'En guise de décoration, planter un morceau de gousse sur l''ensemble.', 'Se déguste en chaud froid dans les minutes qui suivent !'], ['Mixeur', 'Pince de cuisine', 'Râpe', 'Économe'], ['entrée', 'banane', 'mille-feuille', 'recettes de cuisine', 'rhum', 'confiserie', 'eau', 'testées', 'très facile', 'Mille feuilles Bourbon de Tatoubatou', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'glace vanille', 'galettes (bretonnes)', 'dessert', 'plat de résistance', 'arôme vanille', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:30:01.364226', [{'ingredient_id': 'f277ddea-1443-4a5e-a75c-d31fa2d0473e', 'quantite': '4'}, {'ingredient_id': '49e9b388-eae3-43da-8488-9c42bba1cbcd', 'quantite': '2 cuillères'}, {'ingredient_id': '75bbdebb-2061-4382-b52d-d45f2215f563', 'quantite': '2 cuillères'}, {'ingredient_id': '21182210-5a9b-4ea5-a878-5881179693be', 'quantite': ''}, {'ingredient_id': '0824a5be-2841-4aad-a35c-521f23480da6', 'quantite': '4'}, {'ingredient_id': 'b4b9f45f-1d10-4c68-90f7-d2f1983f378c', 'quantite': '4'}, {'ingredient_id': '74c66f13-5a6e-4d85-96b9-9f4bf0cde01d', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (82382, 'Nouilles chinoises au poulet et sauce aux cacahuètes', 'oignon, lait de coco, banane, poulet, poivron rouge, courgette, champignon, arachide, coriandre, gingembre, poivre, sel, huile d''olive, nouilles chinoises', '20 min', ['Faire mariner le poulet coupé en morceaux dans l''huile, la coriandre, le gingembre, le sel et le poivre au réfrigérateur durant quelques heures.', 'Faire bouillir une casserole d''eau afin d''y cuire les nouilles.', 'Faire revenir l''oignon coupé en morceaux dans un peu d''huile.', 'Y ajouter ensuite les autres légumes coupés en morceaux.', 'Y ajouter ensuite le poulet et faire revenir le tout de manière à ce que ce ne soit pas trop cuit.', 'Y ajouter le lait de coco et les 2 bananes coupées en petits morceaux.', 'Faire mijoter afin que les bananes aient complétement fondu.', 'Pendant ce temps, écraser les cacahuètes en petits morceaux.', 'Une fois les bananes fondues, servir les assiettes et les parsemer de morceaux de cacahuètes.', 'Bon appétit!'], ['Casserole', 'Tire-bouchon', 'Presse-agrumes', 'Râpe', 'Fouet'], ['champignon', 'lait de coco', 'gingembre', 'poulet', 'banane', 'entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'nouilles chinoises', 'plat', 'recette', 'cuisine', 'arachide', 'poivron rouge', 'recettes', 'oignon', 'boisson', 'Nouilles chinoises au poulet et sauce aux cacahuètes', 'huile d''olive', 'dessert', 'plat de résistance', 'coriandre', 'courgette', 'poivre', 'cocktail', 'pâtes en sauce'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:30:05.161980', [{'ingredient_id': '2f04eee8-20c1-46e5-9514-018d6c635dd9', 'quantite': '1'}, {'ingredient_id': 'c4982a5d-5561-47b3-8d6e-5ef2d9feebbd', 'quantite': '30 cl'}, {'ingredient_id': '3df2b85e-2198-481a-96f8-9534d3f3a0d2', 'quantite': '2'}, {'ingredient_id': '9dbb62af-c5f2-4db1-91e3-4f689f5c3433', 'quantite': '300 g'}, {'ingredient_id': 'd3e588bf-52ab-4afe-b907-e101964cd266', 'quantite': ''}, {'ingredient_id': '72d1ed48-782b-4261-842f-c71eba90b4ef', 'quantite': ''}, {'ingredient_id': 'f927b337-a839-4ef1-aaaa-195ebd8317ae', 'quantite': '6'}, {'ingredient_id': 'a0efe639-3d3e-45f6-8094-4ef0875ce4b1', 'quantite': '1'}, {'ingredient_id': '0976618b-f84c-4de9-aaa6-6e0c9568e0da', 'quantite': '1'}, {'ingredient_id': 'a2e2c28e-ff05-4f86-826f-2d8f296423c7', 'quantite': ''}, {'ingredient_id': 'b6062a3f-39a8-4897-9b70-781f0ae9333a', 'quantite': ''}, {'ingredient_id': '98a77c4c-3890-4b86-ab22-f6eb90102a01', 'quantite': ''}, {'ingredient_id': 'fc820268-9762-4651-a9b3-e22bc2c7c027', 'quantite': '2 cuillères'}, {'ingredient_id': 'c72772ed-ad98-4466-8c5c-43139aa750f5', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (212049, 'Compote exotique', 'fruit de la passion, grenade, citron vert, banane, mangue, eau', '30 min', ['Vider les fruits de la passion dans une passoire au-dessus d''une casserole, presser les grains pour faire sortir le jus (par exemple avec "l''écraseur" d''un mortier) pour que ce dernier se retrouve dans la casserole.', 'Faire de même avec la grenade. Je conseille de l''écraser les grains de grenade dans la main sinon vous risquez de faire des tâches un peu partout.', 'Presser le citron et ajouter le jus.', 'Couper la banane en morceaux fins et ajouter aux autres fruits (la banane donne de la consistance).', 'Peler les mangues (avec un économe de préférence) puis les couper en morceaux fins et ajouter au reste.', 'Cuire à feu doux pendant 15 à 20 min. S''il n''y a pas assez de jus, ajouter un peu d''eau. J''en ai mis 2,5 louches pour une casserole moyenne. En gros, les 2/3 de la hauteur des fruits sinon ça risque d''être trop liquide.', 'Mixer le tout quand la mangue est bien tendre, en laissant des morceaux plus ou moins gros selon votre goût. Remettre sur le feu 2-3 min.', 'Retirer du feu et laisser bien refroidir avant de mettre au réfrigérateur.', 'Personnellement, je préfère servir bien frais, mais vous pouvez servir chaud ou tiède !', 'Bon appétit !'], ['Mixeur', 'Louche', 'Économe', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'facile', 'plat', 'mangue', 'recette', 'compote', 'cuisine', 'recettes', 'boisson', 'fruit de la passion', 'dessert', 'plat de résistance', 'moyen', 'Compote exotique', 'citron vert', 'cocktail', 'grenade'], 'Dessert', 7a47ada7-ba2f-4b6d-a4f1-5288c450ea73, '2025-09-26T15:30:08.613664', [{'ingredient_id': '4fc8b12c-2c74-4c6c-b6fc-45a952306819', 'quantite': '3'}, {'ingredient_id': 'df9a6fac-5e7a-48c7-8e5e-140972fc309d', 'quantite': '1'}, {'ingredient_id': '0651c522-cee6-4e46-b22d-28a405f4b4a7', 'quantite': '1'}, {'ingredient_id': '04cdd1db-da67-4942-8d20-06f0d18c1b4d', 'quantite': '1'}, {'ingredient_id': '1be82268-8e39-4fab-8884-60a02ded5986', 'quantite': '2'}, {'ingredient_id': '6d7c4a59-da3a-4bd5-b918-423bab6ea947', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (29029, 'Tarte à la banane et à la compote de pommes', 'pâte brisée, compote, banane', '10 min', ['Etaler le pâte brisée dans un moule à tarte et faire des petits trous avec la fourchette. ', 'Verser les 400 g de compote de pommes sur la pâte et couper en fines rondelles les 2 bananes. ', 'Disposer en cercle les rondelles de bananes sur la compote et mettre au four thermostat 6/7 pendant 30 mn environ. ', 'Se déguste chaud.... .'], ['Presse-agrumes', 'Louche', 'Râpe', 'Moule à tarte'], ['entrée', 'banane', 'recettes de cuisine', 'Tarte à la banane et à la compote de pommes', 'confiserie', 'testées', 'très facile', 'compote de pomme', 'bon marché', 'plat', 'recette', 'compote', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:30:12.191141', [{'ingredient_id': '048627a9-f6da-41ab-9aca-fb0057d86422', 'quantite': '1'}, {'ingredient_id': '1dae2946-fe87-40ca-9f97-1bed997837ca', 'quantite': '400 g'}, {'ingredient_id': 'be1d199f-da06-4a9c-a86c-72c6026ea992', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (392616, 'Curry de porc aux bananes', 'rôti de porc, banane, oignon, crème fraîche épaisse, lait de coco, huile d''arachide, baies roses, sel, poivre', '15 min', ['Couper la viande en cubes. Émincer
l’oignon. Chauffer l’huile d’arachide dans une
sauteuse et faire revenir l’oignon 5 minutes
puis ajouter les cubes de porc et le curry.
Laisser cuire 5 minutes en remuant.', 'Éplucher les bananes et les couper
en rondelles. Les ajouter dans la sauteuse.
Verser le lait de coco et la crème. Saler,
poivrer, laisser mijoter 10 minutes sur feu
modéré. Parsemer de baies roses et servir'], ['Casserole', 'Louche', 'Économe', 'Pince de cuisine'], ['lait de coco', 'entrée', 'banane', 'huile d''arachide', 'recettes de cuisine', 'crème fraîche épaisse', 'sel', 'confiserie', 'testées', 'baies roses', 'facile', 'bon marché', 'plat', 'Curry de porc aux bananes', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'dessert', 'plat de résistance', 'poivre', 'cocktail', 'rôti de porc'], 'Plat principal', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T15:30:15.699750', [{'ingredient_id': '16d37792-3f5c-4e66-8bc7-d8612e86a372', 'quantite': '400 g'}, {'ingredient_id': 'a20f1a26-c7d9-461c-af39-ff374735d246', 'quantite': '2'}, {'ingredient_id': '9a73ebc8-a3fa-472e-b90b-722250d3880e', 'quantite': '1'}, {'ingredient_id': '9162bcf9-a621-40b6-a13e-e04d53c6f6dd', 'quantite': '10 cl'}, {'ingredient_id': '53b5b7e4-badf-41d6-aad3-78484c2c5471', 'quantite': '1 cuillères'}, {'ingredient_id': 'd62b3691-a3a3-41b3-9b96-ee42eeb77fb4', 'quantite': '1 cuillères'}, {'ingredient_id': '43ad984b-fa68-4e58-aa69-ee4b16e4ddd5', 'quantite': '1 cuillères'}, {'ingredient_id': '918fb909-3ae6-4f95-a4a3-8b90aa6d5daa', 'quantite': ''}, {'ingredient_id': 'd139cf4d-98a2-41bf-8338-01b136ba2dca', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (56096, 'Compote poire-banane au vin rouge', 'vin rouge, orange, citron, poire, banane, gingembre', '10 min', ['A feu doux, mélanger vin et jus de fruits, y incorporer les poires coupées en 4 et les bananes en rondelles.', 'Laisse réduire environ 20-25 minutes à feu moyen en remuant très régulièrement.', 'Ajouter l''épice choisie.', 'Une fois le mélange refroidi, mixer.'], ['Tire-bouchon', 'Poêle', 'Casserole', 'Planche à découper'], ['gingembre', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'Compote poire-banane au vin rouge', 'recettes', 'boisson', 'vin rouge', 'compote de poire', 'dessert', 'plat de résistance', 'citron', 'orange', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:30:19.247868', [{'ingredient_id': 'e834dbb3-8343-4d82-ba3a-2ba0bd86604a', 'quantite': ''}, {'ingredient_id': 'f08673c7-dc6f-4aa6-a51f-85a706c3755b', 'quantite': ''}, {'ingredient_id': '0b084b9d-8b8e-434e-97f4-fd99976ec7bf', 'quantite': ''}, {'ingredient_id': 'b6f94fe2-f023-4fd1-bf2e-e023c1062042', 'quantite': '4'}, {'ingredient_id': 'db3cdbbf-43ef-4706-a0d9-6bea6bac0629', 'quantite': '2'}, {'ingredient_id': '0d12675d-02f6-413d-a9b8-14aae865d0a1', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (18292, 'Muffins à la banane faciles', 'sucre, beurre, farine, banane, oeuf, levure, bicarbonate, sel', '15 min', ['Battez ensemble le beurre et le sucre, jusqu''à l’obtention d’une crème légère.   ', 'Ajoutez les œufs puis les bananes.  Ajoutez les ingrédients secs.', 'Versez dans des moules à muffins (caissettes alimentaires en papier).', 'Faites cuire au four, thermostat 5/6 pendant 30 minutes, ou jusqu’à cuisson complète.'], ['Pince de cuisine', 'Couteau de chef', 'Économe'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'levure', 'cuisine', 'Muffins à la banane faciles', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'muffin', 'beurre', 'sucre', 'cocktail', 'bicarbonate'], 'Dessert', ef667500-a11b-40e5-8458-6c5dc962546d, '2025-09-26T15:30:25.995505', [{'ingredient_id': '88b37afc-6fd9-4e7a-b61d-901f1cdab050', 'quantite': '360 g'}, {'ingredient_id': 'b456d4f0-0c29-485a-a89f-6385cbd0b71d', 'quantite': '220 g'}, {'ingredient_id': 'dadc0694-3736-4f36-aeb6-74af2f4bd374', 'quantite': '300 g'}, {'ingredient_id': '0e2592ef-58f1-4dce-a9ae-740dff93c308', 'quantite': '6'}, {'ingredient_id': '54a9fefe-7b8e-4192-a2f1-8e70b9ca7158', 'quantite': '4'}, {'ingredient_id': 'f7b011c1-8efa-4c37-970d-943a701a7956', 'quantite': '2 cuillères'}, {'ingredient_id': 'de729137-e4e4-4944-8c99-a52e5cbd89c3', 'quantite': '1 cuillères'}, {'ingredient_id': 'e855fee5-4010-4dde-b84f-965a07f24dd3', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (66946, 'Purée de bananes plantains', 'banane plantain, piment, sel, huile de palme', '10 min', ['Eplucher les bananes, les couper le plus finement possible et les mettre dans une casserole.', 'Ajouter de l''huile (un fond pour ne pas que cela attache).', 'Remuer, saler, pimenter avec des tronçons de piments, goûter.', 'Mettre à cuire doucement 20 min tout en remuant.'], ['Passoire', 'Rouleau à pâtisserie'], ['entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'piment', 'cuisine', 'recettes', 'Purée de bananes plantains', 'boisson', 'dessert', 'plat de résistance', 'banane plantain', 'purée', 'huile de palme', 'cocktail'], 'Accompagnement', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:30:29.479235', [{'ingredient_id': 'b0b056c6-9dfc-4526-b717-a323742fa290', 'quantite': '6'}, {'ingredient_id': 'd2cfb77f-4b6c-4467-9b61-59b107255bdc', 'quantite': '2'}, {'ingredient_id': 'c7174e56-5abc-4410-a430-03da377b5ecc', 'quantite': ''}, {'ingredient_id': 'bdba959d-1406-4f74-9c98-ff59d2b69bda', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (80056, 'Dessert de melon framboises bananes', 'melon, framboises, banane, yaourt aromatisé', '30 min', ['Couper les melons en 2, ôter les graines et les évider avec une cuillère parisienne. ', 'Mettre dans un saladier avec les framboises (en réserver quelques unes pour la décoration) et les bananes coupées en petits morceaux. ', 'Incorporer les yaourts et bien mélanger. ', 'Remplir les demi-melons avec la préparation et décorer éventuellement avec les framboises restantes. ', 'Mettre au réfrigérateur 1 h et servir bien frais.'], ['Mixeur', 'Poêle', 'Louche', 'Planche à découper'], ['', 'melon', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'framboises', 'bon marché', 'yaourt aromatisé', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Dessert de melon framboises bananes', 'cocktail'], 'Dessert', 01e811c3-aa1b-42e5-8653-a996a5da1c29, '2025-09-26T15:30:32.887534', [{'ingredient_id': '21f5d827-dae1-4494-90e1-8c41aa62a6c9', 'quantite': '2'}, {'ingredient_id': 'aba0786a-f580-4f28-b9e0-0d6bd5b3afdf', 'quantite': '1'}, {'ingredient_id': '90c510b0-492e-42f8-bf1f-aac169e53089', 'quantite': '2'}, {'ingredient_id': '5c9a735c-4984-4a89-a6ca-1f8da49687bb', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (17656, 'Brochettes de poulet curry et banane', 'blanc de poulet, banane, citron vert, curry, huile d''olive, sel', '10 min', ['Couper les blancs de poulet en morceaux et les déposer dans un plat. ', 'Saupoudrer généreusement de curry, mélanger. ', 'Verser le jus du citron vert et 5 cuillères à soupe d''huile d''olive. Bien mélanger, si cela ne vous gène pas allez-y avec les doigts. ', 'Laisser mariner 1/2 heure au frigo. ', 'Couper les bananes sans enlever la peau en tronçons de 2 cm. ', 'Préparer les brochettes en enfourchant les tronçons de banane (en traversant la peau cela tient mieux) en alternance avec plusieurs morceaux de poulet. ', 'Mettre à cuire sur le barbecue ou à la poêle.'], ['Verre doseur', 'Ouvre-boîte', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'poulet mariné', 'bon marché', 'plat', 'blanc de poulet', 'recette', 'cuisine', 'recettes', 'boisson', 'huile d''olive', 'dessert', 'plat de résistance', 'citron vert', 'curry', 'cocktail', 'Brochettes de poulet curry et banane'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:30:37.553885', [{'ingredient_id': 'a5985ea7-4c44-48e3-8f4a-aa419312ec01', 'quantite': '4'}, {'ingredient_id': '37487ba6-a89a-4776-b685-6193b8c7ce8b', 'quantite': '4'}, {'ingredient_id': '3b9f31d1-f268-482a-87fe-8b2f905bf90a', 'quantite': '1'}, {'ingredient_id': '5df393aa-6461-4dfd-b5d0-bb238f2bb934', 'quantite': ''}, {'ingredient_id': 'db8ee814-f671-4d81-b9b6-0a4c56134906', 'quantite': ''}, {'ingredient_id': 'c69a014e-f158-43ae-b861-fba0865c5534', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (66437, 'Crumble poire banane chocolat spéculoos', 'poire, banane, chocolat noir, sucre, spéculoos', '10 min', ['Couper les fruits en petits morceaux. Les disposer dans un moule à tarte.', 'Parsemer de sucre et de chocolat cassé en morceaux.', 'Ecraser les spéculoos et en parsemer le plat. Faire cuire au four à 200°C (thermostat 6-7) pendant 20 minutes.', 'Servir tiède'], ['Poêle', 'Spatule', 'Passoire', 'Rouleau à pâtisserie', 'Râpe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'crumble banane', 'testées', 'poire', 'très facile', 'bon marché', 'plat', 'recette', 'spéculoos', 'Crumble poire banane chocolat spéculoos', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat noir', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:30:41.122267', [{'ingredient_id': '36172522-a3d2-48e4-b823-154a749d8a62', 'quantite': '3'}, {'ingredient_id': '73cdf05b-29d8-41ce-9175-69e95952cac9', 'quantite': '3'}, {'ingredient_id': 'aa88c2fa-9341-4c02-9037-b60a08c4dcd4', 'quantite': '100 g'}, {'ingredient_id': '9510be9c-e5ff-495c-a03d-842baf2b8e0e', 'quantite': '3 cuillères'}, {'ingredient_id': 'eace8a57-b42e-4614-a970-8cfe12fbd8fa', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (164979, 'Délicieuse tarte pommes bananes et sa crème patissière', 'farine, beurre tendre, sucre, lait, sel, maïzena, oeuf, lait, sucre, arôme vanille, noix de coco, banane, pomme, sucre vanillé', '45 min', ['Pour la pâte, mélanger dans un saladier la farine, le sel et le sucre.', 'Ajouter le beurre pour obtenir une texture sablée. Incorporer ensuite le lait. ', 'Étaler votre pâte dans le moule.', 'Faite votre crème pâtissière dans une casserole. ', 'Sur feu doux, mélanger les 30cl de lait, la Maïzena, le sucre, le jaune d''œuf et la vanille. Fouetter énergiquement. Ajouter la noix de coco. Retirer du feu quand la texture devient assez épaisse.', 'A part, battre le blanc d''œuf en neige et incorporer le au mélange une fois qu''il a froidi.', 'Étaler la crème sur la pâte.', 'Éplucher vos pommes, coupez les en cubes, et faites des rondelles de vos bananes.', 'Dispersez vos cubes de pommes, puis vos rondelles de bananes, et saupoudrez le tout d''un sachet de sucre vanillé.'], ['Presse-agrumes', 'Planche à découper', 'Mixeur', 'Spatule'], ['entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'beurre tendre', 'très facile', 'bon marché', 'Délicieuse tarte pommes bananes et sa crème patissière', 'tarte aux pommes', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:30:45.036795', [{'ingredient_id': '15caf9a5-2ec5-4050-a633-0a4bad831115', 'quantite': '300 g'}, {'ingredient_id': 'e9034cb2-1c76-4ad1-805e-8e5cea1bdabb', 'quantite': '150 g'}, {'ingredient_id': 'b6c229f4-d217-4bda-a17a-4f4d77f3cb32', 'quantite': '3 cuillères'}, {'ingredient_id': '9484c46e-9431-4a8a-a8d0-45a76bcd9e1e', 'quantite': '8 cl'}, {'ingredient_id': '84708350-a932-43aa-81d9-74812562d5ff', 'quantite': '1'}, {'ingredient_id': '87abbe5c-b3cc-40a8-84f5-b60724fc7bc8', 'quantite': '1 cuillères'}, {'ingredient_id': 'd69799e2-81dc-49b0-9f3d-3b6b0419e8f6', 'quantite': '1'}, {'ingredient_id': 'eeffdd90-4eba-449c-a5a9-57ebb1b26635', 'quantite': '30 cl'}, {'ingredient_id': 'edc7afa1-17cb-4e75-adb3-29ee9876cc80', 'quantite': '25 g'}, {'ingredient_id': 'd19c70ff-7ebe-4606-b3a6-d3897b0ce934', 'quantite': '1 cuillères'}, {'ingredient_id': '2edd09ba-6f6a-4a84-b69a-a2e8e8481738', 'quantite': '30 g'}, {'ingredient_id': '70d689f9-d1b3-44d1-a3ba-5c9b7637f33f', 'quantite': '2'}, {'ingredient_id': 'e07add2b-f46c-4abe-ae76-9db19b974dc2', 'quantite': '2'}, {'ingredient_id': '20b013a2-b441-4a20-b543-35293bcc9ea6', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (531529, 'Glace au yaourt pour les enfants', 'yaourt, miel, fraises, banane, abricot', '240 min', ['Mettre les yaourts dans une jatte et mélanger avec le miel.', 'Répartir dans 3 bols.', 'Écraser les fraises et mélanger avec un premier bol.', 'Écraser la banane et mélanger avec le 2ème bol.', 'Écraser la chair des fruits jaunes et mélanger avec le contenu du 3ème bol.', 'Répartir dans des petits pots en alternant les couches fraise, banane et pêche sans qu’elles ne se mélangent.', 'Planter au centre des cuillères en bois. Mettre au congélateur au moins 4h.'], ['Poêle', 'Rouleau à pâtisserie', 'Pince de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'abricot', 'très facile', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Glace au yaourt pour les enfants', 'cocktail'], 'Dessert', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T15:30:49.169602', [{'ingredient_id': 'bcfc4221-894e-4eb0-b9af-9b5de9432a44', 'quantite': '3'}, {'ingredient_id': '79bcb1ee-c965-4ff2-96ed-29002fecd422', 'quantite': '1 cuillères'}, {'ingredient_id': '4af72b67-7736-45fc-a2b8-670694d3c3a3', 'quantite': '10'}, {'ingredient_id': 'b91df862-08ee-4713-bad2-d17d6f05f466', 'quantite': '1'}, {'ingredient_id': 'e76102a5-350b-4c8f-a46d-3d85df1d873b', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (11297, 'chips de banane', 'banane, huile d''arachide', '10 min', ['Pelez les bananes et coupez-les en rondelles de 1cm d''épaisseur.', 'Faites chauffer la moitié de l''huile dans une poêle antiadhésive. Plongez-y les bananes en plusieurs fois. Le fond de la poêle doit juste être recouvert de tranches. ', 'Ajoutez de l''huile après chaque cuisson.', 'Laissez cuire 1 min, puis égouttez les bananes sur un papier absorbant et rangez-les sur un plat tenu au chaud.'], ['Fouet', 'Râpe'], ['entrée', 'banane', 'huile d''arachide', 'chips', 'recettes de cuisine', 'chips de banane', 'confiserie', 'testées', 'rapide', 'plat', 'moyenne', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'cocktail'], 'Amuse-gueule', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:30:52.513268', [{'ingredient_id': '1400747a-85c4-462b-9653-749a869835eb', 'quantite': '2'}, {'ingredient_id': 'd05dcd62-1592-4314-9330-f38f2dd18dbd', 'quantite': '25 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (80885, 'Flognarde aux bananes et kiwis', 'farine, oeuf, lait, sucre, sucre vanillé, beurre, banane, kiwi', '10 min', ['Pelez les fruits, coupez-les en morceaux et étalez les régulièrement au fond d''un plat à tarte anti-adhésif (tefal ou silicone, sinon beurrez le moule).', 'Préparez la pâte : mettez la farine et tout le sucre dans un saladier, ajoutez les oeufs, melangez afin que le mélange soit bien lisse.', 'Ajoutez le lait et les 40 g de beurre fondu, mélangez.', 'Mettez ensuite le mélange dans le moule à tarte, sur les fruits. ', 'Enfournez 30 min à 180°C, thermostat 6.', 'Servez refroidie ou tiède.'], ['Moule à tarte', 'Casserole', 'Fouet'], ['flognarde', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'beurre', 'lait', 'Flognarde aux bananes et kiwis', 'sucre', 'cocktail'], 'Dessert', f4268fc5-02a3-4d85-a980-d51ba227445a, '2025-09-26T15:30:56.073732', [{'ingredient_id': '370bd8d7-313e-495b-a27a-412400d1bae5', 'quantite': '60 g'}, {'ingredient_id': 'e8e3fbb4-fee2-4b84-8f6d-746489e45ae0', 'quantite': '3'}, {'ingredient_id': 'ae390e2c-238d-4655-a64b-f76a4212f34d', 'quantite': '250 ml'}, {'ingredient_id': 'b834105e-c3c2-4c06-9597-cdc1bfcaa996', 'quantite': '100 g'}, {'ingredient_id': '3eb4c626-957f-4629-9de3-20646d5c0c95', 'quantite': '1'}, {'ingredient_id': '38694f4f-768f-41e9-96d4-22dccd2c7a7b', 'quantite': '40 g'}, {'ingredient_id': '2d0b69ad-f300-42c0-b331-4d34b485de1e', 'quantite': '2'}, {'ingredient_id': '6380a47b-4c9f-48f3-b7a4-22a9fcb5f4f0', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (66471, 'Farofa de Bananes (Brésil)', 'farine de manioc, bacon, oignon, ail, beurre, banane, poivre, sel', '30 min', ['Dans une poêle, laisser fondre le beurre et faire frire le bacon.', 'Ajouter l´ail et l´oignon Jusqu''à ce qu''il devienne transparent.', 'Baisser le feu et ajouter la farine de manioc (ici, au Brésil, nous avons beaucoup de types de farine de manioc et je crois que chez vous, vous achetez le croud, très claire).', 'Cuire en remuant de temps en temps pour dorer la farine (pas foncée).', 'Retirer du feu et ajouter les morceaux de bananes. Saler et poivrer.'], ['Poêle', 'Pince de cuisine', 'Balance de cuisine', 'Batteur électrique', 'Mixeur'], ['', 'bacon', 'banane', 'entrée', 'Farofa de Bananes (Brésil)', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'ail', 'plat', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'farine de manioc', 'dessert', 'plat de résistance', 'beurre', 'poivre', 'cocktail'], 'Accompagnement', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:31:00.181355', [{'ingredient_id': 'a5d00349-2a6f-4a40-ad96-77be915547d9', 'quantite': '250 g'}, {'ingredient_id': '37cfcc4d-0535-4864-8da0-f90c314cae89', 'quantite': '50 g'}, {'ingredient_id': 'b96e41a4-2096-4661-92a4-b7f6fd7c1467', 'quantite': '1'}, {'ingredient_id': '12aa7af2-1371-4318-9036-680e8a5cc55c', 'quantite': '1'}, {'ingredient_id': '1f760e54-fd9e-43de-8a20-4ee4992ded0f', 'quantite': '50 g'}, {'ingredient_id': '43be19a3-21bc-4e9d-bc57-b8cc886be6d5', 'quantite': '3'}, {'ingredient_id': 'dce70f0b-5fa5-47c8-9e41-0df4561070c9', 'quantite': ''}, {'ingredient_id': '991d7c1e-405d-4267-b644-76848fd31b28', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (13764, 'Punch aux fruits sans alcool', 'limonade, jus d''orange, jus d''ananas, sirop de sucre de canne, citron vert, pomme, poire, orange, banane, pêche, ananas, fruits', '15 min', ['Verser tous les produits dans une grande coupe.', 'Couper les fruits en morceaux et les ajouter au liquide.', 'Mélanger et laisser reposer au frais pendant 1 heure.', 'Avant de servir, ajouter de la glace pilée ou des glaçons.'], ['Passoire', 'Louche', 'Pince de cuisine'], ['sirop de sucre de canne', 'banane', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'très facile', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'jus d''ananas', 'pomme', 'moyen', 'cocktail sans alcool', 'orange', 'ananas', 'limonade', 'jus d''orange', 'citron vert', 'pêche', 'fruits', 'cocktail', 'Punch aux fruits sans alcool'], 'Boisson', d03dd0d0-ae7f-4371-b7d2-9edf17d71e68, '2025-09-26T15:31:03.770465', [{'ingredient_id': 'd7ff2177-72ed-4cd7-bce4-6098cd57d7fa', 'quantite': '50 cl'}, {'ingredient_id': 'b2da978b-16e4-4b5f-9fa6-cb212680f546', 'quantite': '1.5 l'}, {'ingredient_id': '2a9cb298-6b76-4798-bea2-2450a2395cd0', 'quantite': '1.5 l'}, {'ingredient_id': '7da3c5ce-20b0-4a0d-af9a-3555259018d2', 'quantite': '75 cl'}, {'ingredient_id': '9dddc9e1-ad9c-49c5-abb5-6f24a36831c6', 'quantite': '2'}, {'ingredient_id': 'ca00501f-00e6-4226-9e0b-b8ba787110b9', 'quantite': '1'}, {'ingredient_id': 'a356add0-9a0f-42e2-af55-89950e46592f', 'quantite': '1'}, {'ingredient_id': '7fb57526-9ca5-444c-805f-f93df1a3d61e', 'quantite': '1'}, {'ingredient_id': '487175c1-685d-44d5-8249-e1575c4b1c5e', 'quantite': '1'}, {'ingredient_id': '73673641-5185-4b15-87bc-9b451f5c0b09', 'quantite': '1'}, {'ingredient_id': '0f249e06-e006-4f9e-b01e-29e02f4a70e5', 'quantite': '1'}, {'ingredient_id': '62fd1124-96f0-4662-a5b6-ff0b43aa7ac8', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (37471, 'Clafoutis insolite', 'pomme, oeuf, sucre fin, lait écrémé, farine, beurre, banane, amandes effilées, cannelle, fleur d''oranger, lavande, citron', '15 min', ['Concassez grossièrement les bananes séchées et mettez-les dans un bol avec la 1/2 de la cannelle, le citron et la fleur d''oranger. Laissez 2 h au frais.', '2 heures plus tard... :-)', 'Préchauffez le four à 175°C (thermostat 5-6).', 'Beurrez et farinez le moule.', 'Faites fondre le beurre.', 'Battez les oeufs entiers avec le sucre et le reste de la cannelle. ', 'Quand le mélange est mousseux, incorporez le beurre fondu et le lait, puis la farine tamisée (par petits coups). Fouettez jusqu''à obtenir une pâte lisse et fluide.', 'Pelez 2 pommes et taillez-les en petits dés (1cm3). Mélangez-les à la pâte. ', 'Pelez et taillez en tranches fines la 3ème pomme. ', 'Incorporez à la pâte les bananes imbibées de marinade et la poignée d''amandes affilées.', 'Versez la pâte dans le moule et recouvrez des tranches de pommes.', 'Patientez 35 min... Et dégustez!'], ['Couteau de chef', 'Pince de cuisine', 'Passoire', 'Râpe'], ['lavande', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'lait écrémé', 'testées', 'sucre fin', 'facile', 'Clafoutis insolite', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'clafoutis', 'pomme', 'moyen', 'citron', 'beurre', 'fleur d''oranger', 'cannelle', 'amandes effilées', 'cocktail'], 'Dessert', b96002a9-5b84-4c8f-9351-5bd9ac791b78, '2025-09-26T15:31:07.385380', [{'ingredient_id': '8433977e-7bcf-48ea-bc75-5a2e42e4193f', 'quantite': '3'}, {'ingredient_id': 'e8b42514-146f-491d-ab46-d7b86863630b', 'quantite': '3'}, {'ingredient_id': 'e6ac6eb4-abd2-4299-8e61-f0bd61c8bd81', 'quantite': '100 g'}, {'ingredient_id': '6ffe7149-2ced-4660-955c-50cfad3616aa', 'quantite': '30 cl'}, {'ingredient_id': '834e69c0-aaa7-4593-876a-fc09554e7b13', 'quantite': '150 g'}, {'ingredient_id': '3d461fec-584c-47ac-9d41-f47adcc316ce', 'quantite': '50 g'}, {'ingredient_id': '9b44a151-e021-4091-89cc-e94a34084c0c', 'quantite': '20 g'}, {'ingredient_id': 'ebfa5fce-18de-4edc-884b-6f34fb8625ba', 'quantite': '15 g'}, {'ingredient_id': '5039c4fa-7d6d-4d70-bba0-b404ff3218a2', 'quantite': '1 cuillères'}, {'ingredient_id': '5da6ed0f-8d2d-4a13-b614-48e9feea2cfb', 'quantite': '1 cuillères'}, {'ingredient_id': '78da6fe7-e90b-4569-b0ec-a5bd4917c217', 'quantite': '3'}, {'ingredient_id': '72b11fb3-b5ba-4a73-a289-b3b31bdebaac', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (88513, 'Tarte légère bananes et fruits rouges', 'banane, fruits rouges, sucre, farine, oeuf, pâte brisée', '15 min', ['Battre les blancs en neige.', 'Détailler les bananes en grosses rondelles.', 'Mélanger les jaunes d''oeufs, le sucre et la farine ensemble.', 'Incorporer délicatement les blancs montés en neige.', 'Verser les fruits rouges et les rondelles de bananes.', 'Disposer la pâte feuilletée dans un moule à tarte et verser la préparation par-dessus.', 'Enfourner à 160°C (thermostat 5) pendant 45 minutes.'], ['Louche', 'Spatule', 'Presse-agrumes', 'Casserole', 'Pince de cuisine'], ['entrée', 'banane', 'Tarte légère bananes et fruits rouges', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'tarte à la banane', 'fruits rouges', 'recette', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:31:10.958010', [{'ingredient_id': '2f73722c-d7b1-4de7-887f-0f3e46ccb74c', 'quantite': '3'}, {'ingredient_id': '23de63ab-9ec9-48e8-8c04-ee6c92bfda13', 'quantite': '200 g'}, {'ingredient_id': '58c7a182-d63b-49db-8fe4-589fc445b785', 'quantite': '3 cuillères'}, {'ingredient_id': '2f80c526-11b3-4ba2-a624-a16e54d77566', 'quantite': '3 cuillères'}, {'ingredient_id': '6acdef2d-6399-4ac7-bf41-f4231929203a', 'quantite': '3'}, {'ingredient_id': '6b810053-46a2-412b-9239-14f593563f6e', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (61215, 'Milk Shake Banane-Pêche', 'banane, pêche, lait, sucre vanillé, glaçons', '5 min', ['Nettoyez soigneusement les pêches.', 'Epluchez les bananes et coupez-les en rondelles, mettez-les tout de suite dans un shaker.', 'Puis prenez la pêche et coupez-la de manière "circulaire", tout autour d''elle pour obtenir 4 quarts.', 'Retirez le noyau et mettez la chair dans le shaker sans l''éplucher.', 'Ajoutez ensuite le sachet de sucre vanillé et les 3 glaçons.', 'Terminez en versant le lait de manière à ce qu''il couvre totalement les fruits.', 'Mixez une petite minute et dégustez !'], ['Spatule', 'Louche', 'Moule à tarte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'Milk Shake Banane-Pêche', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'glaçons', 'pêche', 'lait', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:31:14.505225', [{'ingredient_id': 'b8d2746e-5c8e-4b63-92ed-9ca631131210', 'quantite': '2'}, {'ingredient_id': '3900507d-32f5-4564-ab84-8bce21938c60', 'quantite': '1'}, {'ingredient_id': '8fdab7a1-5b15-428b-8f55-d8297afcb42a', 'quantite': '50 cl'}, {'ingredient_id': '6ff61e39-dddc-47c1-8a0e-3a4357c97ca4', 'quantite': '1'}, {'ingredient_id': '98bb416f-de90-435a-872f-615b3afdc3c4', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (232567, 'Cake léger à la banane et aux dattes', 'oeuf, sucre en poudre, sirop d''agave, margarine, banane, datte, fromage blanc, farine de blé, farine de châtaigne, levure, extrait de vanille, cannelle', '15 min', ['Battre les jaunes d''oeuf avec le sucre en poudre et le sirop d''agave jusqu''à blanchiment. ', 'Ajouter la margarine en petit morceaux et continuer de battre pour obtenir une pâte homogène.', 'Mixer ensemble les bananes et les dattes. Mélanger avec le fromage blanc et la vanille. Ajouter à la préparation aux œufs.', 'Mélanger les farines, la levure et la cannelle. Les ajouter à la préparation.', 'Finir en incorporant petit à petit les blancs battus en neige ferme.', 'Verser dans un moule à cake beurré et fariné.', 'Cuire au four à 180°C (thermostat 6) pendant 60 min ou jusqu''à ce que la pointe d''un couteau que l''on plante dans le gâteau ressorte sèche.'], ['Mixeur', 'Moule à tarte', 'Passoire', 'Pince de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'extrait de vanille', 'oeuf', 'sirop d''agave', 'moyenne', 'plat', 'sucre en poudre', 'recette', 'datte', 'cuisine', 'levure', 'recettes', 'boisson', 'fromage blanc', 'autres cakes', 'margarine', 'dessert', 'plat de résistance', 'farine de blé', 'farine de châtaigne', 'moyen', 'cannelle', 'cocktail', 'Cake léger à la banane et aux dattes'], 'Dessert', 3c06f8a6-e59a-4255-bdbe-f7bfa8f0a473, '2025-09-26T15:31:18.545815', [{'ingredient_id': 'b8fbd0a6-469e-446e-96de-5623320440ff', 'quantite': '2'}, {'ingredient_id': 'ecf8a34b-9b99-42b0-bb79-19f15a7d2a6c', 'quantite': '50 g'}, {'ingredient_id': '56687602-e474-4393-9849-116ce641b967', 'quantite': '50 g'}, {'ingredient_id': '97261cf9-7b08-4c22-9a65-236eaa1d0f82', 'quantite': '100 g'}, {'ingredient_id': '047bd414-6567-4166-9171-dbb45faff6bf', 'quantite': '3'}, {'ingredient_id': '2412a4d8-db90-43a2-87a8-af22ba29cd40', 'quantite': '3'}, {'ingredient_id': '46c1018d-954c-46b3-85c6-6cc38f3906cf', 'quantite': '100 g'}, {'ingredient_id': '2fe134a3-45e8-42b1-a655-753db6531804', 'quantite': '70 g'}, {'ingredient_id': '6312f8cd-75c6-49ba-a780-07a00b61fda5', 'quantite': '70 g'}, {'ingredient_id': '3662d942-c872-4124-b358-afb1202f54bd', 'quantite': '1'}, {'ingredient_id': '20fbd131-0310-41f9-b13c-ca16fe7ebf7a', 'quantite': '1 cuillères'}, {'ingredient_id': '3c0c3203-bc28-437d-8071-325f22097192', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (44334, 'Petits flans de banane au lait de coco', 'banane, lait entier, lait de coco, oeuf, sucre en poudre, vanille, noix de coco rapée, beurre', '10 min', ['Préchauffez le four à 150°C (thermostat 5).', 'Dans une terrine, mélangez au fouet le sucre et les oeufs, ajoutez le lait entier et le lait de coco, grattez la gousse de vanille.', 'Versez la préparation sur les bananes grossièrement écrasées à la fourchette.', 'Passez le tout un mixeur. Le mélange doit être lisse et mousseux.', 'Répartissez dans des moules à muffins en silicone très légèrement beurrés au pinceau. A défaut, utilisez de petits ramequins traditionnels. ', 'Faites cuire 40 minutes au four. Laissez refroidir quelques minutes, puis démoulez les flans.', 'Servez bien frais, sur un lit de noix de coco râpée.'], ['Râpe', 'Couteau de chef'], ['', 'lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Petits flans de banane au lait de coco', 'facile', 'lait entier', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'vanille', 'noix de coco rapée', 'dessert', 'plat de résistance', 'moyen', 'beurre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:31:22.160924', [{'ingredient_id': 'da0f7979-e0a7-4e64-aff7-b8b46eac20ed', 'quantite': '2'}, {'ingredient_id': '6d1c6e57-3975-4513-b8cf-1489f0af6979', 'quantite': '10 cl'}, {'ingredient_id': 'ade9e43d-5bb3-4443-8c03-e34453d0d3bb', 'quantite': '5 cl'}, {'ingredient_id': '22474613-a5c4-4e13-88bc-109df36a8989', 'quantite': '2'}, {'ingredient_id': '775a6382-b832-4a8f-b247-c1b526edb36d', 'quantite': '60 g'}, {'ingredient_id': '55612900-a45f-4571-8157-5886c39e9546', 'quantite': '1'}, {'ingredient_id': '2e1967a2-0b40-4410-a46d-8fcd80836e1a', 'quantite': ''}, {'ingredient_id': '13ad051d-4702-4471-a7a5-921358b436f0', 'quantite': '10 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (85940, 'Smoothie Belle-Hélène', 'poire, banane, kiwi, yaourt nature, cacao amer, glaçons', '10 min', ['Éplucher les fruits et les couper en morceaux. ', 'Les mettre dans un mixer en rajoutant le yaourt, le cacao et les glaçons.', 'Mixer le tout, jusqu''à ce que les glaçons soient broyés et que le mélange soit liquide. ', 'Verser dans 2 grands verres (25 cl) et servir bien frais !'], ['Spatule', 'Verre doseur', 'Ouvre-boîte', 'Presse-agrumes', 'Pince de cuisine'], ['entrée', 'banane', 'kiwi', 'recettes de cuisine', 'cacao amer', 'confiserie', 'testées', 'yaourt nature', 'poire', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Smoothie Belle-Hélène', 'dessert', 'plat de résistance', 'glaçons', 'smoothies', 'cocktail'], 'Boisson', 4328463d-0bbe-4f2e-89d3-2c29ed7cddec, '2025-09-26T15:31:26.407030', [{'ingredient_id': 'baf93bc4-97d2-4c2c-b510-e5e0260cf5a8', 'quantite': '2'}, {'ingredient_id': '6d57ce29-fef8-44e8-90fa-ec9e439862c4', 'quantite': '1'}, {'ingredient_id': 'a03c3b5e-6699-4331-b2e0-e78a64a56429', 'quantite': '1'}, {'ingredient_id': 'cd6bfd8e-4480-4ada-be59-4f01d7130feb', 'quantite': '1'}, {'ingredient_id': 'eb42515c-6992-4191-9a1a-6a3a2c7d90ff', 'quantite': ''}, {'ingredient_id': 'cf853aa7-9fbd-4861-b786-43d6b2a1d654', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (56530, 'Mes muffins banane chocolat blanc', 'banane, oeuf, margarine, chocolat blanc, sucre, farine, levure, sel, noix de coco rapée', '10 min', ['Préchauffer le four à 200°C (thermostat 6-7).', 'Mélanger farine, sucre, levure et sel.', 'Dans un autre saladier, mélanger l''oeuf avec les bananes écrasées, ajouter le beurre fondu et les pépites de chocolat.', 'Y ajouter le mélange avec la farine.', 'Verser dans des moules à muffins beurrés (ou avec caissettes en papier), saupoudrer de noix de coco râpée.', 'Enfourner 20 à 25 minutes.', 'C''est prêt!'], ['Passoire', 'Pince de cuisine', 'Moule à tarte', 'Balance de cuisine', 'Verre doseur'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'noix de coco rapée', 'margarine', 'dessert', 'plat de résistance', 'muffin', 'chocolat blanc', 'Mes muffins banane chocolat blanc', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:31:32.161425', [{'ingredient_id': '2298fa9a-d655-4753-9c00-e5d7ce8e5aed', 'quantite': '3'}, {'ingredient_id': '9b495ce4-64e9-45ea-84a2-8655af7a2ca3', 'quantite': '1'}, {'ingredient_id': '0c500d1d-aa93-440a-9d40-2b00097fae03', 'quantite': '75 g'}, {'ingredient_id': '9eb7f8a3-2592-4cfd-acf2-8e417a2be292', 'quantite': '70 g'}, {'ingredient_id': '1accc298-195b-454c-82e0-004a55e0d219', 'quantite': '170 g'}, {'ingredient_id': 'dad012da-cf8e-4b3b-a3a7-83a031f6a431', 'quantite': '165 g'}, {'ingredient_id': '27277dde-7df8-4313-b25e-6d4e53fa1b9b', 'quantite': '1 cuillères'}, {'ingredient_id': '32bfe0da-6a1a-45a4-ac44-8c7504f84951', 'quantite': '1'}, {'ingredient_id': 'e8648fab-57e2-419d-9aad-6e0f152d7c36', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (68572, 'Tourte banane coco', 'farine, crème fraîche, citron vert, sucre vanillé, beurre, banane, jaune d''oeuf, sucre roux, noix de coco rapée', '15 min', ['La pâte :', 'Pétrir la farine, la crème fraîche, le jus de citron et la vanille. Faire une boule avec la pâte obtenue et réserver au frais pendant 30 minutes sous film alimentaire.', 'Préchauffer le four à thermostat 6 (180°C). Beurrer le moule à tarte.', 'Diviser la pâte en 2 et l''étaler au rouleau sur un plan de travail fariné en 2 disques identiques .', 'Garnir le fond du moule d’un disque de pâte. Découper les bananes en rondelles et les disposer dessus. Recouvrir avec le second disque et souder les bords.', 'Badigeonner la pâte d’un jaune d’oeuf. Saupoudrer ensuite avec le mélange sucre roux/coco râpée.', 'Enfourner 25 minutes à 180°C. A déguster tiède ou froid.'], ['Pince de cuisine', 'Balance de cuisine', 'Économe', 'Moule à tarte', 'Poêle'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'tarte à la banane', 'jaune d''oeuf', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'noix de coco rapée', 'dessert', 'plat de résistance', 'sucre vanillé', 'beurre', 'citron vert', 'Tourte banane coco', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:31:35.744769', [{'ingredient_id': '9d6afce5-e759-4313-a6e8-f84699f54cfa', 'quantite': '180 g'}, {'ingredient_id': '6107b331-2be6-437d-918c-b9c22a518b88', 'quantite': '90 g'}, {'ingredient_id': '1c48e8d9-27d3-4673-b172-aa35059c4e3b', 'quantite': ''}, {'ingredient_id': '12897933-c6fd-46e7-a1e1-299214dd0ed5', 'quantite': '1'}, {'ingredient_id': 'f84d1655-2aac-45a8-a12b-890b61a65858', 'quantite': '1'}, {'ingredient_id': 'dd978294-c34f-4ffd-a059-451f6e0b8c61', 'quantite': '4'}, {'ingredient_id': '04265218-9068-41e8-b112-f890c5c58604', 'quantite': '1'}, {'ingredient_id': '20326dda-3bce-44ba-bf6d-e6bdbf776113', 'quantite': '25 g'}, {'ingredient_id': '90e29100-e65d-4a44-8ce3-a5617cb2d8f8', 'quantite': '45 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (231291, 'Muffins banane coco, glaçage au chocolat', 'sucre semoule, lait, oeuf, farine, noix de coco rapée, banane, levure chimique, chocolat noir, crème fraîche épaisse, vermicelles', '30 min', ['Pour la base gâteau :', 'Préchauffez le four à 180°C.', 'Dans un saladier, écrasez les bananes à l''aide d''une fourchette. ', 'Ajoutez-y le sucre, l’œuf et le lait. ', 'Mélangez le tout au fouet électrique.', 'Incorporez ensuite la farine, la noix de coco en poudre, et la levure. ', 'Mélangez bien le tout de manière à obtenir une texture homogène.', 'Beurrez les moules à muffins et versez-en au 3/4, la préparation. ', 'Faites cuire au four préalablement chauffé 20 à 25 min.', 'Pour le glaçage :', 'Pendant la cuisson des muffins, préparez la ganache. ', 'Cassez le chocolat en morceaux et faites le fondre dans une casserole.', 'Ajoutez la crème fraîche et mélangez le tout sur feu doux. ', 'Une fois que la texture est lisse et homogène, ôtez la casserole du feu et laissez reposer.', 'A la sortie du four, laissez refroidir une dizaine de minutes les muffins, puis démoulez-les.', 'A l''aide d''un pinceau de cuisine ou d''une poche à douille, garnissez les muffins de la ganache préparée. ', 'Parsemez les de vermicelles colorées.'], ['Mixeur', 'Spatule', 'Tire-bouchon'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'facile', 'bon marché', 'oeuf', 'plat', 'glaçage au chocolat', 'recette', 'cuisine', 'recettes', 'sucre semoule', 'boisson', 'farine', 'noix de coco rapée', 'dessert', 'plat de résistance', 'Muffins banane coco', 'muffin', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:31:39.376779', [{'ingredient_id': '56ff2157-0520-43a6-a92e-71a19c41e87c', 'quantite': '50 g'}, {'ingredient_id': 'c2575114-4974-42b4-9815-c3d2b2fefcfd', 'quantite': '2 cuillères'}, {'ingredient_id': '3e797973-b609-4804-abe1-cb7921eac1de', 'quantite': '1'}, {'ingredient_id': '346bc4a4-c824-4e7b-bd81-49d2549b78a7', 'quantite': '75 g'}, {'ingredient_id': '54f55103-1af8-4816-9fcf-cbbdb24d637b', 'quantite': '75 g'}, {'ingredient_id': 'd2abb74a-d390-4462-ae57-c1e870169a3e', 'quantite': '2'}, {'ingredient_id': '179d810f-91e1-4684-80e2-e33ed64920f1', 'quantite': '2 cuillères'}, {'ingredient_id': 'e4a97c30-41f0-433f-988b-4e665067942d', 'quantite': '100 g'}, {'ingredient_id': 'f27b0b0a-3912-41f8-a288-7b163c8e777e', 'quantite': '3 cuillères'}, {'ingredient_id': '3d03f246-a39b-4b09-89b9-f29c7b5699f0', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (46760, 'Mini tartelettes aux chocolats et fruits', 'pâte sablée, crème fraîche liquide, chocolat noir, chocolat blanc, chocolat praliné, beurre, fruits rouges, banane, amandes', '40 min', ['Préchauffez votre four à 180°C (thermostat 6).', 'Découpez les 30 ronds des mini-tartelettes dans la pâte sablée, à l''aide d''un emporte-pièce.', 'Garnir le moule en silicone (en forme de tartelettes) des ronds de pâte.', 'Piquez la pâte à l''aide d''une fourchette.', 'Enfournez et faîtes cuire environ 9 min jusqu''à ce que la pâte soit dorée.', 'Laissez refroidir.', 'Portez à ébullition 5 cl de crème. Retirez du feu et faîtes-y fondre le chocolat noir en remuant à l''aide d''un fouet. Ajoutez enfin 10 g de beurre et mélangez jusqu''à ce que le mélange soit parfaitement homogène.', 'Laissez refroidir.', 'Faîtes de même pour le chocolat blanc et la pralinoise. ', 'Une fois la ganache refroidie, garnissez les tartelettes de la manière suivante:', '         - ganache chocolat blanc ou chocolat noir, purée de fruits rouges écrasés, ganache chocolat blanc surplombée d''une framboise (ou mûre).', '         - fine rondelle de banane, ganache pralinoise ou ganache chocolat noir.', 'Si vous le souhaitez, vous pouvez parsemer les mini tartelettes d''amandes effilées grillées.'], ['Passoire', 'Balance de cuisine'], ['', 'amandes', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'pâte sablée', 'rapide', 'plat', 'moyenne', 'fruits rouges', 'recette', 'crème fraîche liquide', 'cuisine', 'recettes', 'boisson', 'Mini tartelettes aux chocolats et fruits', 'dessert', 'plat de résistance', 'chocolat noir', 'moyen', 'beurre', 'chocolat blanc', 'chocolat praliné', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:31:43.389470', [{'ingredient_id': '2f420421-a8f2-424d-beb8-479d4b3a4749', 'quantite': '1'}, {'ingredient_id': '5dcb42f8-6267-4e99-b7ad-82384a211904', 'quantite': '15 cl'}, {'ingredient_id': '9cec2e21-6330-49d3-8991-d9a273c75f17', 'quantite': '50 g'}, {'ingredient_id': '6d7419da-89d4-4a30-b9ad-93d0ca20b380', 'quantite': '50 g'}, {'ingredient_id': 'bf5a3daf-92dd-4a3d-804a-6f9609cd041b', 'quantite': '50 g'}, {'ingredient_id': 'e6e3b5b6-32f8-4ffd-9fad-691545fc47b3', 'quantite': '30 g'}, {'ingredient_id': '84459bf4-ff75-4d41-a04a-7b5d7b91a904', 'quantite': '250 g'}, {'ingredient_id': 'f63e04e1-2a09-4158-a154-a8cf1f523752', 'quantite': '2'}, {'ingredient_id': '646e6f49-062b-4e20-8b05-3b8eb4b20589', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (57858, 'Tarte fraises, bananes, pommes', 'pâte brisée, compote, banane, pomme, beurre, sucre en poudre', '15 min', ['Etalez la pâte, mettez-la dans le moule et piquez le fond.', 'Badigeonnez le fond avec la compote de fraise.', 'Coupez vos bananes en rondelles puis les pommes.', 'Parsemez de noisettes de beurre et quelques cuillères à soupe de sucre en poudre.', 'Au four thermostat 6 pendant 15 à 20 minutes et hop c''est prêt !'], ['Verre doseur', 'Casserole', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'bananes', 'plat', 'tarte aux pommes', 'sucre en poudre', 'recette', 'compote', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'beurre', 'pommes', 'Tarte fraises', 'cocktail'], 'Dessert', ff4bb4ef-e98a-4e3b-a0d8-f4f946d74d06, '2025-09-26T15:31:47.537354', [{'ingredient_id': 'be6bd635-edc5-454c-91d1-1b66bd71029f', 'quantite': '1'}, {'ingredient_id': 'd68bbb9c-e24f-421a-8277-85d2ecae087b', 'quantite': '4 cuillères'}, {'ingredient_id': 'a237821f-647f-4a4a-b4a7-258477faa684', 'quantite': '2'}, {'ingredient_id': 'd024e955-93fe-4fb2-962c-d8e08fa730ee', 'quantite': '3'}, {'ingredient_id': '525dd142-4b33-405b-891b-76bdef9ebb64', 'quantite': '25 g'}, {'ingredient_id': '74903fc1-2ed6-41d0-ad9f-75c2b7d5e4ab', 'quantite': '25 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (60631, 'Croustillant de banane au caramel au beurre salé', 'banane, beurre salé, beurre doux, sucre, brick, glace vanille', '20 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Faire chauffer le sucre dans une casserole en remuant avec une spatule en bois jusqu''à obtenir un caramel doré.', 'Hors du feu, ajouter 100 g de beurre salé puis les bananes en rondelles.', 'Remettre sur le feu jusqu''à ce que les bananes deviennent translucides.', 'Avec une écumoir, retirer les bananes du caramel et chauffer celui-ci jusqu''à ébullition afin de faire épaissir pour obtenir un sirop épais.', 'Pendant ce temps, couper en 4 les feuilles de brick.', 'Disposer 2 morceaux en quinconce dans 12 moules à muffin et beurrer au pinceau avec les 20 g de beurre doux fondu.', 'Vous devez obtenir des corolles. Passer au four 4 minutes.', 'Sortir les corolles du four et y ajouter la préparation de banane au centre. Arroser du sirop au caramel.', 'Repasser au four 8 min afin que la feuille de brick soit légèrement dorée.', 'Servir chaud ou froid en ajoutant au centre de chaque corolle une grosse cuillère de glace à la vanille.'], ['Râpe', 'Moule à tarte', 'Presse-agrumes', 'Couteau de chef'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'caramel', 'beurre salé', 'bon marché', 'rapide', 'plat', 'Croustillant de banane au caramel au beurre salé', 'recette', 'cuisine', 'brick', 'recettes', 'boisson', 'glace vanille', 'dessert', 'plat de résistance', 'beurre doux', 'sucre', 'cocktail'], 'Dessert', e504e299-1554-4ba6-ae14-918d75039d2c, '2025-09-26T15:31:51.671230', [{'ingredient_id': '0fd8b31b-b8e7-4361-a0e2-3cfcd7d937e8', 'quantite': '4'}, {'ingredient_id': '261a8ca4-d475-410d-9158-fddcf4bb5aa0', 'quantite': '100 g'}, {'ingredient_id': '132de9cd-f69e-4bf7-b206-6194d33376ec', 'quantite': '20 g'}, {'ingredient_id': 'fe642c62-32bd-491d-9f7d-ef3d55d80eea', 'quantite': '200 g'}, {'ingredient_id': '57495b17-8b8b-4c54-96c8-29543d1f13bb', 'quantite': '6'}, {'ingredient_id': 'd7526b89-6cf7-4c2d-bb9a-1e4e1392a6f6', 'quantite': '12'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (73065, 'Confiture de banane pour un pot', 'banane, sucre vanillé, eau, sucre', '15 min', ['Épluchez la banane. Coupez-la en fines rondelles.', 'Dans un faitout, mettez les rondelles de bananes à chauffer avec un verre d''eau et le sachet de sucre vanillé.', 'Une fois, les rondelles cuites, écrasez-les avec un écrase-légumes ou une fourchette.', 'Rajoutez les 150 g de sucre spécial confiture et ammenez à ébulition pendant 15 min environ, le temps que le mélange s''épaississe et qu''il ne reste que des tout petits morceaux de bananes.', 'Retirez du feu et mettre de suite dans un pot à confiture. ', 'Laissez refroidir, bonne dégustation...'], ['Rouleau à pâtisserie', 'Casserole', 'Moule à tarte', 'Planche à découper'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Confiture de banane pour un pot', 'dessert', 'plat de résistance', 'sucre vanillé', 'sucre', 'cocktail'], 'Confiserie', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:31:55.202400', [{'ingredient_id': 'cf7cbb34-2d47-4987-85f2-c1d5337b0647', 'quantite': '1'}, {'ingredient_id': '073d32a8-72a9-47e4-b0dd-679501933088', 'quantite': '1'}, {'ingredient_id': '80324465-a70c-4e53-84bc-93699b66c551', 'quantite': '1'}, {'ingredient_id': '7e416905-c262-4b1b-a5d4-a4362bfbea57', 'quantite': '150 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (84567, 'Cake abricot-miel', 'farine, abricot, sucre, oeuf, beurre, banane, orange, huile d''olive, sucre vanillé, lait, miel', '40 min', ['Battre les blancs en neige.', 'Mélanger les jaunes, la farine, le sucre, le lait, le sucre vanillé, le jus d''orange, l''huile d''olive, les abricots secs et la banane découpés en petits morceaux.', 'Incorporer doucement les blancs en neige.', 'Laisser cuire 50 minutes à 180°C (thermostat 6).', 'A 10 minutes du terme, déposer une fine couche de miel.'], ['Passoire', 'Poêle'], ['', 'entrée', 'Cake abricot-miel', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'abricot', 'facile', 'oeuf', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'farine', 'huile d''olive', 'dessert', 'plat de résistance', 'sucre vanillé', 'moyen', 'beurre', 'orange', 'sucre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:31:58.743021', [{'ingredient_id': 'e22ed9de-3701-455c-8894-9bc418a395c5', 'quantite': '100 g'}, {'ingredient_id': '6fcec18b-c969-4263-8c02-ef4583a3c3d8', 'quantite': '200 g'}, {'ingredient_id': '0d458634-3874-42f5-9d2e-9236646e98c2', 'quantite': '80 g'}, {'ingredient_id': '265af08c-301d-4d50-86b9-2c2180c09101', 'quantite': '3'}, {'ingredient_id': 'abbacf82-cea1-4d0a-a8b1-fc76b99c5d3d', 'quantite': '100 g'}, {'ingredient_id': 'b15398e8-c4c4-49c4-a8a7-ddb3eb613c10', 'quantite': '1'}, {'ingredient_id': 'fa187a9a-3e97-41c2-9804-12ae0b89c328', 'quantite': '1'}, {'ingredient_id': '64fae4f4-0dab-4e9a-8b4b-8b6846cc627c', 'quantite': '1 cuillères'}, {'ingredient_id': '062578da-38e3-4a16-90ff-94b3a9698f60', 'quantite': ''}, {'ingredient_id': '46832f92-eb9a-4cce-9108-3277cdec52ce', 'quantite': '1 cuillères'}, {'ingredient_id': '95f7cf78-b702-493e-a989-095cd1ab535e', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (371887, 'Charlotte à la banane et aux éclats de chocolat', 'banane, citron vert, sucre vanillé, crème fraîche liquide, biscuits à la cuillère, chocolat noir, gélatine, gingembre, yaourt nature, sucre, menthe, jus de banane', '35 min', ['Placer la crème fraiche au congélateur.', 'Faire tremper la gélatine dans de l''eau froide.
Mixer 5 bananes avec le yaourt, 1 sachet de sucre vanillé, le sucre, le jus du citron vert, le gingembre en poudre.', 'Fouetter la crème fraiche et 1 sachet de sucre vanillé en chantilly jusqu''à ce qu''elle devienne bien ferme.', 'Prélever un peu de mélange banane & yaourt et le faire chauffer au micro-onde.', 'Essorer les feuilles de gélatine et les incorporer à cette préparation chaude, bien remuer.', 'Incorporer délicatement la chantilly.', 'Couper le chocolat en copeaux ou en éclats à l''aide d''un couteau.
Couper la dernière banane en petits morceaux.', 'Incorporer les éclats de chocolat et les morceaux de banane à la préparation (au dernier moment pour ne pas qu''ils tombent au fond).', 'Tapisser le moule à charlotte de film alimentaire (pour faciliter le démoulage).', 'Tremper rapidement les biscuits à la cuillère dans le jus de banane (ou un sirop de fruit mélangé à un peu d''eau) et tapisser le moule à charlotte des biscuits humidifiés.', 'Verser une première couche de la préparation dans le moule à charlotte.
Ajouter une couche de biscuits humidifiés.
Verser la deuxième couche de préparation dans le moule.
Terminer en recouvrant le moule de biscuits humidifiés puis de film alimentaire.', 'Laisser la charlotte au réfrigérateur pendant au moins 6 heures.', 'Passer le moule sous l''eau chaude pour le démouler.
Décorer avec des feuilles de menthe.'], ['Couteau de chef', 'Fouet'], ['gingembre', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'yaourt nature', 'biscuits à la cuillère', 'menthe', 'bon marché', 'rapide', 'plat', 'moyenne', 'charlotte', 'jus de banane', 'recette', 'crème fraîche liquide', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat noir', 'sucre vanillé', 'gélatine', 'citron vert', 'Charlotte à la banane et aux éclats de chocolat', 'sucre', 'cocktail'], 'Dessert', 25538231-f8e0-4c1e-9a1d-996926c1490f, '2025-09-26T15:32:03.004401', [{'ingredient_id': 'd0d5733b-7f37-4470-9f19-039e01e46774', 'quantite': '6'}, {'ingredient_id': '9c6eaf9b-4e28-4c82-bb4c-1a53f0e01307', 'quantite': '1'}, {'ingredient_id': '81c4ffbc-bc03-44c0-99c6-aa9958825545', 'quantite': '2'}, {'ingredient_id': '9ec8efcd-2675-4043-bbd1-90e4d4d6bfcc', 'quantite': '40 cl'}, {'ingredient_id': 'c6e0c4c3-648f-4f79-ba21-18ed63652a21', 'quantite': '30'}, {'ingredient_id': '8e4785fe-b8d0-4218-93c2-6b8227df72d0', 'quantite': '8'}, {'ingredient_id': '457df3a7-8d2e-4787-91df-2c48c25de235', 'quantite': '4'}, {'ingredient_id': '4197cce1-e31f-489a-8501-851007d9a337', 'quantite': '1'}, {'ingredient_id': 'c4c6e5ec-3c3a-4605-b276-8a12756c4d71', 'quantite': '1'}, {'ingredient_id': '75c34161-f71f-4f8e-b454-d875c1584b11', 'quantite': '30 g'}, {'ingredient_id': '1ab00bbc-5b7d-45bf-9c56-cb58f5c9f836', 'quantite': ''}, {'ingredient_id': 'c98a9cca-5187-42ac-a043-3d070badeef4', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (29882, 'Salade de fruits à la fleur d''oranger', 'fraises, kiwi, orange, pomme, banane, autres, eau de fleur d''oranger, sucre roux', '10 min', ['Peler les oranges à vif et les couper en quartiers.', 'Eplucher et couper les bananes et les kiwis en rondelles.', 'Laver et couper les fraises et les pommes en morceaux.', 'Mélanger tous les fruits et les arroser d''eau de fleur d''oranger.', 'Saupoudrer de sucre et réserver au frais 1h avant de servir.'], ['Pince de cuisine', 'Mixeur', 'Fouet', 'Verre doseur', 'Rouleau à pâtisserie'], ['', 'entrée', 'banane', 'Salade de fruits à la fleur d''oranger', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'orange', 'eau de fleur d''oranger', 'cocktail', 'sucre roux', 'autres'], 'Dessert', 34fd4997-5e37-4f34-80df-d4dfd8a8f16a, '2025-09-26T15:32:06.575966', [{'ingredient_id': '3dc868b7-a287-441f-9535-392636de20b3', 'quantite': '12'}, {'ingredient_id': '7220462d-86ed-4330-ae4b-38fd18742cde', 'quantite': '2'}, {'ingredient_id': 'bf947463-80e3-428c-aeba-da2316defcc8', 'quantite': '2'}, {'ingredient_id': 'e4973e0a-b624-4300-881d-af61ce31abaa', 'quantite': '2'}, {'ingredient_id': '30562d98-fca9-4cae-8fff-643cdacf3b3e', 'quantite': '2'}, {'ingredient_id': '591a8f1d-21e9-4e31-8afa-65737e5cbe8e', 'quantite': ''}, {'ingredient_id': 'b4c06b49-83a4-4ddb-925d-c47b311b1d18', 'quantite': ''}, {'ingredient_id': '5d68fbab-f5f8-4b59-8f26-40ef5c17781d', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (34207, 'tilapia et bananes plantins', 'tilapia, basilic, oignon, gingembre, ail, tomate, kub or, poivre blanc, thym, huile, banane', '30 min', ['Mixer le basilic avec les tomates les oignons, le gingembre, l''ail, les kubor, le poivre, le thym. ', 'Versez cette préparation sur votre poisson huilé avec les 2 cuillères à soupe d''huile, mettre à four moyen pendant 1/2 heures. ', '15 mn avant la fin de cuisson de votre poisson, pelez et coupez en lamelles pas trop grosses vos bananes plantins que vous ferez frire pendant 5 ou 6 mn, elles doivent prendre une belle couleur caramel. ', 'Servez votre poisson avec vos bananes frites, vous pouvez accompagner ce plat avec des bâtons de manioc et une purée de piment.'], ['Casserole', 'Poêle', 'Ouvre-boîte', 'Passoire', 'Planche à découper'], ['', 'gingembre', 'entrée', 'banane', 'recettes de cuisine', 'tilapia et bananes plantins', 'confiserie', 'testées', 'assez cher', 'très facile', 'ail', 'tomate', 'plat', 'basilic', 'recette', 'cuisine', 'kub or', 'recettes', 'oignon', 'boisson', 'huile', 'dessert', 'plat de résistance', 'poivre blanc', 'thym', 'tilapia', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:32:10.268753', [{'ingredient_id': '418b516c-a49a-4549-8a4a-2598aa1978a4', 'quantite': '2'}, {'ingredient_id': 'c12c36c5-2a17-4da9-bfeb-424edd5daff1', 'quantite': '1'}, {'ingredient_id': '8e5a5bf8-3632-4cc7-b89c-f545f3b74f77', 'quantite': '2'}, {'ingredient_id': '712e4eb0-2ab4-43e3-9760-c312b7446012', 'quantite': ''}, {'ingredient_id': 'fe5c452b-d100-4e3c-b4a3-6f6cdf4dec04', 'quantite': '7'}, {'ingredient_id': '9c7530bb-2a0d-4fb7-93cb-dd148f8271a2', 'quantite': '5'}, {'ingredient_id': '8bd55f78-710b-43ff-a6c7-f30d50902a26', 'quantite': '3'}, {'ingredient_id': 'ed0a9f2e-2bc6-42c3-8667-2e50a01d9340', 'quantite': '1'}, {'ingredient_id': 'fdf15472-1c8b-4503-9608-a02e9609e475', 'quantite': ''}, {'ingredient_id': '4f31acab-34c4-4c50-8e74-2e0e6b0f37c8', 'quantite': '2 cuillères'}, {'ingredient_id': '87696bcd-13d9-4468-becb-b70ce0f2cad2', 'quantite': '6'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (66472, 'Chutney de fruits frais et fruits secs au rhum', 'pomme, banane, poire, mangue, abricot, amandes, pignons, citron, cannelle, rhum, huile', '10 min', ['Laver et éplucher tous les fruits frais.', 'Couper les pommes, les poires et la mangue en dés et les bananes en rondelles.', 'Dans une casserole, mettre les fruits à cuire, à feu doux. Ajouter un fond d''eau si besoin.', 'Arroser les fruits du jus d''un citron. Ajouter une pincée de cannelle.', 'Faire cuire tout doucement, en remuant de temps en temps pour ne pas que cela attache, jusqu''à ce que les fruits se défassent en compote.', 'En fin de cuisson, arroser avec le rhum.', 'Pendant ce temps, faire griller les pignons de pins et les amandes émondées dans 1 cuillère à soupe d''huile puis réserver.', 'Couper les abricots secs en dés et réserver.', 'Une fois les fruits cuits, les dresser dans des coupes à dessert, sans attendre, en alternant fruits frais et fruits secs sur plusieurs étages.', 'Terminer par une couche de fruits secs, et parsemer de dés d''abricots secs.', 'Servir aussitôt.'], ['Économe', 'Ouvre-boîte', 'Louche', 'Moule à tarte', 'Spatule'], ['', 'amandes', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'abricot', 'poire', 'très facile', 'bon marché', 'pignons', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'dessert', 'plat de résistance', 'Chutney de fruits frais et fruits secs au rhum', 'pomme', 'citron', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:32:14.423921', [{'ingredient_id': '43755061-a193-49fc-8326-016d87d2d429', 'quantite': '4'}, {'ingredient_id': '94d9f9e2-8821-4782-8713-c24920dad64c', 'quantite': '3'}, {'ingredient_id': '73410f4e-132d-48ac-b943-4a678ace6198', 'quantite': '2'}, {'ingredient_id': '82dcef7b-4a1b-4bc6-8d85-142220d41f06', 'quantite': '1'}, {'ingredient_id': '13a59432-f807-4e29-8abd-6063bbd28e14', 'quantite': '5'}, {'ingredient_id': 'ef3f2346-5dd8-4130-a216-272f78bc43f9', 'quantite': '4 cuillères'}, {'ingredient_id': 'dcf00504-db1d-4670-a262-2f5f7f44aed4', 'quantite': '4 cuillères'}, {'ingredient_id': '831cc218-4534-4e12-b654-af1398ef2f59', 'quantite': ''}, {'ingredient_id': '2d7e3e59-3829-42c8-990f-f29cc81cafee', 'quantite': '1'}, {'ingredient_id': '57c5c24f-7656-48a0-8e36-f50b19775ac3', 'quantite': '1 cuillères'}, {'ingredient_id': '5a9cdaab-fae4-4c17-9742-9cc7884dbd8c', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (13279, 'Tarte aux amandes et aux bananes', 'pâte brisée, banane, sucre en poudre, oeuf, crème fraîche, amandes en poudre, amandes effilées, citron', '15 min', ['Abaissez votre pâte et disposez-la dans un moule à tarte que vous aurez préalablement beurré et fariné. Piquez le fond avec une fourchette.', 'Dans un récipient, cassez les oeufs et ajoutez-y le sucre en poudre. Battez énergiquement jusqu''à obtention d''un mélange blanchâtre et nappeux.', 'Dans un autre récipient, mixez les bananes, la crème fraîche, le jus du citron et la poudre d''amandes.', 'Mélangez les deux préparations.', 'Versez l''ensemble dans le fond de tarte cru.', 'Répartissez dessus les amandes effilées.', 'Faites cuire à four chaud (thermostat 6/7 - 180°/210°C) pendant 25 min.'], ['Mixeur', 'Fouet', 'Moule à tarte', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'très facile', 'bon marché', 'amandes en poudre', 'oeuf', 'plat', 'tarte à la banane', 'sucre en poudre', 'Tarte aux amandes et aux bananes', 'recette', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'citron', 'amandes effilées', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:32:17.970925', [{'ingredient_id': 'c9bf628e-ea66-4551-b2a9-de4b9be8e58f', 'quantite': '250 g'}, {'ingredient_id': '7b5d474d-7ba7-494d-87ac-6978a562ad33', 'quantite': '4'}, {'ingredient_id': 'b4f79cad-b16e-4594-8ea6-a01d5181fe6f', 'quantite': '200 g'}, {'ingredient_id': '89a6e17c-5674-4beb-b352-5c7839fd6334', 'quantite': '4'}, {'ingredient_id': 'c5839cf4-8658-453c-b002-22d877d0f13a', 'quantite': '20 cl'}, {'ingredient_id': '731bde35-f6e4-4743-9480-eb935690b55c', 'quantite': '2 cuillères'}, {'ingredient_id': 'b5ec9b4f-50cb-4cac-aabe-c49ccf01d994', 'quantite': '30 g'}, {'ingredient_id': '8925dd29-ad12-4a9b-a1de-2cc3b22cb01f', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (86039, 'Fafa Omelette', 'banane, oeuf, sucre en poudre', '15 min', ['Dans une petite poêle, faire revenir 1/2 banane coupée en rondelles fines.', 'Dans un petit bol, battre un œuf avec un peu de sucre en poudre.', 'Verser ce mélange sur la banane et cuire comme une omelette.', 'Disposer dans une assiette et saupoudrer de sucre. ', 'Faire de même pour la 2ème omelette.', 'Déguster tiède.'], ['Couteau de chef', 'Presse-agrumes', 'Ouvre-boîte', 'Moule à tarte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'Fafa Omelette', 'bon marché', 'rapide', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', af5f9b43-045f-4ee3-af00-353cc0fd7e05, '2025-09-26T15:32:22.031476', [{'ingredient_id': '0c6f75ce-2c13-4d9d-ac35-43aa4f6236ea', 'quantite': '1'}, {'ingredient_id': '86187e4a-b346-43c8-9cb2-a3bfcd5caa37', 'quantite': '2'}, {'ingredient_id': 'c8280801-5122-45a1-842f-172cb5c0a775', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (72501, 'Salade de fruits de l''été bananes, fraises, dattes', 'banane, fraises, datte, menthe, extrait de vanille, sucre vanillé', '15 min', ['1- Eplucher les bananes et les couper en rondelles.', '2- Laver les fraises, les équeuter et les couper en deux ou en trois selon la grosseur.', '3- Dénoyauter les dattes et les couper en lamelles.', '4- Ciseler la menthe.', '5- Mettre le tout dans un saladier.', '6- Ajouter l''extrait de vanille et le sachet de sucre vanillé.', '7- Mélanger le tout dans un saladier, c''est prêt!'], ['Tire-bouchon', 'Balance de cuisine', 'Planche à découper'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'extrait de vanille', 'très facile', 'menthe', 'bon marché', 'Salade de fruits de l''été bananes', 'rapide', 'plat', 'fraises', 'recette', 'datte', 'dattes', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:32:25.672434', [{'ingredient_id': 'c0d03cf3-f0c8-4d00-9255-e28e26865981', 'quantite': '4'}, {'ingredient_id': '6b0f83ba-95fc-48fd-9236-f104489f941b', 'quantite': '1'}, {'ingredient_id': '73736d8d-3ecd-4921-9402-ced007a8c0e5', 'quantite': '15'}, {'ingredient_id': '73b641eb-4384-4e7b-8f20-94c2ff80e3e5', 'quantite': '6'}, {'ingredient_id': '838159a0-c386-434f-9aa1-4ab46d5ff55f', 'quantite': '2 cuillères'}, {'ingredient_id': '6ec812eb-9454-4a7c-a186-85cd6bbdfa52', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (57369, 'Crumble pommes vertes, bananes et aux spéculoos', 'pomme, banane, beurre, sucre, farine, spéculoos', '30 min', ['Préchauffez le four à 180°C (thermostat 6).', 'Ecrasez les spéculoos avec un rouleau à pâtisserie.', 'Coupez le beurre en petits morceaux, placez-les dans un bol avec la farine, le sucre, les spéculoos et une pincée de sel.', 'Malaxez le tout avec les doigts, le résultat doit être granuleux.', 'Pelez les pommes, coupez-les en quartiers puis en petits dés.', 'Coupez les bananes en rondelles.', 'Disposez les fruits dans un plat ou dans des ramequins type "crème brûlée" puis recouvrez-les du mélange à crumble.', 'Enfournez pour environ 30 minutes de cuisson.'], ['Fouet', 'Économe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'crumble aux pommes', 'plat', 'recette', 'spéculoos', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'Crumble pommes vertes', 'pomme', 'beurre', 'sucre', 'cocktail', 'bananes et aux spéculoos'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:32:29.265937', [{'ingredient_id': '216b3429-1ca8-4ac7-8bee-f216d53c8908', 'quantite': '4'}, {'ingredient_id': '5890de95-eb8d-4afa-97f0-43822cc08439', 'quantite': '3'}, {'ingredient_id': '6b905d90-10ca-4b4a-a3d4-ecab278be5bb', 'quantite': '120 g'}, {'ingredient_id': 'b639419b-913f-44ca-9911-c258e4563fb2', 'quantite': '120 g'}, {'ingredient_id': '0beb4ee8-8d09-45e7-86d1-21288c800ada', 'quantite': '120 g'}, {'ingredient_id': '702dbe76-ae5e-46d8-bc94-466b42581c13', 'quantite': '10'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (15261, 'Cake à la banane et pépites de chocolat', 'sucre, oeuf, beurre, fromage blanc, farine, banane, chocolat, levure', '15 min', ['Mélanger le sucre, le beurre, les œufs, la farine et la levure dans un saladier.', 'Écraser les bananes dans une assiette creuse, y ajouter le fromage blanc et mélanger. ', 'Verser dans le saladier et ajouter les pépites de chocolat. Bien mélanger.', 'Verser dans un moule à cake beurré et faire cuire 30 à 40 min à 180°C.'], ['Batteur électrique', 'Balance de cuisine', 'Ouvre-boîte', 'Presse-agrumes', 'Moule à tarte'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'Cake à la banane et pépites de chocolat', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'fromage blanc', 'autres cakes', 'dessert', 'plat de résistance', 'beurre', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:32:36.121891', [{'ingredient_id': '55f6d36f-a024-4039-84a5-a4425970046d', 'quantite': '110 g'}, {'ingredient_id': 'e4b31e74-51fb-44db-a556-f1afd5864a59', 'quantite': '2'}, {'ingredient_id': '4b7cdaaf-76c4-4240-9bda-75474d593ce3', 'quantite': '120 g'}, {'ingredient_id': 'a6f311d5-86ed-4a9a-ae24-30f6d7bd49d7', 'quantite': '100 g'}, {'ingredient_id': '62ddb05b-e9c1-41bb-802a-eb78c144d130', 'quantite': '150 g'}, {'ingredient_id': 'c4c1ec77-ebe1-450a-950c-60fb4a0afd5e', 'quantite': '3'}, {'ingredient_id': '140eec41-a6f9-4316-945b-c5f7a43a188c', 'quantite': '1'}, {'ingredient_id': 'f5416819-b080-49d4-9c82-2f9a01cbcb53', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (73226, 'SANGRIA ROSE', 'vin rosé, cognac, sirop de sucre de canne, orange, citron, cannelle, vanille, clou de girofle, pêche, pomme, abricot, cerises, banane, fraises, menthe, eau', '15 min', ['A faire le matin pour le soir, ou la veille pour le midi.', 'Prélever les zestes des oranges et des citrons, puis recueillir leurs jus.', 'Dans un récipient, mélanger le vin, le sucre, les jus de fruits, les épices, les zestes et le Cognac.', 'Couvrir et laisser macérer au moins 10 h à température ambiante.', 'Avant de servir: ', 'Filtrer à travers une passoire fine.', 'Peler les fruits de saison et les couper en tranches très fines; ajouter le vin filtré.', 'Laisser au frais ainsi que l’eau pétillante.', 'Au dernier moment:', 'Mélanger le tout, ajouter les feuilles de menthe et servir.'], ['Ouvre-boîte', 'Couteau de chef', 'Louche', 'Moule à tarte', 'Batteur électrique'], ['sirop de sucre de canne', 'banane', 'entrée', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'assez cher', 'abricot', 'très facile', 'menthe', 'rapide', 'plat', 'fraises', 'recette', 'SANGRIA ROSE', 'cuisine', 'recettes', 'sangria', 'boisson', 'clou de girofle', 'vanille', 'dessert', 'plat de résistance', 'vin rosé', 'pomme', 'citron', 'orange', 'pêche', 'cannelle', 'cognac', 'cocktail', 'cerises'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:32:39.704415', [{'ingredient_id': '2e009c29-bb25-45a1-907e-f7464d3c0f3a', 'quantite': '5'}, {'ingredient_id': '1d9696dd-5955-42d1-a15e-1e5c44626c5a', 'quantite': '15 cl'}, {'ingredient_id': '3698d8da-f6e1-4957-bf43-8fb6b3e6fe0c', 'quantite': '15 cl'}, {'ingredient_id': 'c8260713-6c6c-4fc7-9f0a-e761a5cc9c09', 'quantite': '4'}, {'ingredient_id': '8350c455-23d6-4e80-a704-3636aedfccad', 'quantite': '4'}, {'ingredient_id': '001aa3bd-7390-4b0d-b657-6611bbe719ff', 'quantite': '3'}, {'ingredient_id': '959d4819-6d9a-45cc-89bc-d095942cd41b', 'quantite': '1'}, {'ingredient_id': 'c3abf065-195a-4090-9dbd-6b68a048f294', 'quantite': '6'}, {'ingredient_id': 'ba3ada7d-f27a-4f6c-898d-dfa0564ad218', 'quantite': '4'}, {'ingredient_id': '00718e2f-3be8-4982-8add-ead4213d9e6e', 'quantite': '4'}, {'ingredient_id': '1965e98b-37a3-49ce-89cd-8750e0504434', 'quantite': '12'}, {'ingredient_id': '394ceafd-e2d1-4ef0-80d5-29d323d0e06f', 'quantite': '500 g'}, {'ingredient_id': '96b48065-5e64-48ba-9e11-74e87e67285b', 'quantite': '1'}, {'ingredient_id': '24304259-7692-4b3e-8a45-fbc8fef05bc0', 'quantite': ''}, {'ingredient_id': 'e0cee244-cc14-4c99-a197-03c3b6b8a8d5', 'quantite': ''}, {'ingredient_id': '581dd988-7cb5-47e6-ba45-287ce0bdb171', 'quantite': '1 l'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (81171, 'Biscuit banane-chocolat', 'sucre, beurre, chocolat en poudre, farine, oeuf, sel, banane, confiture, caramel', '30 min', ['Pâte à biscuits:', 'Dans un saladier, mélanger l''oeuf entier avec le sucre et le sel jusqu''à obtenir un mélange clair et légèrement mousseux. Ajouter la farine tamisée d''un seul coup, puis pétrir la pâte à la main, jusqu''à obtenir du sable. ', 'Ajouter alors le beurre en petits morceaux ainsi que le chocolat en poudre', 'Pâte de fruits:', 'Dans une assiette, écraser la banane. Quand elle est bien écrasée, y ajouter le caramel et la confiture au choix.', 'Biscuit banane-chocolat:', 'Incorporez les fruits aux biscuits, et pétrir à la main pour former une boule de pâte. ', 'Etendez la pâte sur une surface plane légèrement farinée, puis découpez les biscuits à l''aide d''un verre par exemple. ', 'Déposez les biscuits sur une plaque beurrée, et enfournez à four chaud (160°C- thermostat 5) pendant 10 à 15 min. ', 'Les biscuits prendront une couleur claire, et doreront légèrement, en les laissant quelques minutes de plus. ', 'Faire refroidir les biscuits sur une feuille d''aluminium, afin de les laisser durcir. Déguster les biscuits tièdes ou froids. ', 'Bon appétit.'], ['Casserole', 'Mixeur', 'Verre doseur'], ['entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'bon marché', 'autres biscuits et petits gâteaux', 'rapide', 'oeuf', 'plat', 'moyenne', 'recette', 'cuisine', 'recettes', 'Biscuit banane-chocolat', 'boisson', 'farine', 'dessert', 'plat de résistance', 'beurre', 'chocolat en poudre', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:32:43.340220', [{'ingredient_id': 'adc426c6-e07d-4d27-80aa-d54a87e2d34a', 'quantite': '150 g'}, {'ingredient_id': 'b4125dd8-1cbd-40aa-b30c-baafe9e67145', 'quantite': '125 g'}, {'ingredient_id': 'c28b597f-c2e5-491f-94cc-d5b0b9ead50b', 'quantite': '150 g'}, {'ingredient_id': 'b60e945e-477b-444c-b4d5-900c4e6a70bb', 'quantite': '250 g'}, {'ingredient_id': 'b3e43866-9bfc-491d-b593-4acab2bf4b98', 'quantite': '1'}, {'ingredient_id': '024418c8-c73b-4229-9847-73c528e18489', 'quantite': '1'}, {'ingredient_id': '3655baf8-ea05-4749-b820-8e472741b5fd', 'quantite': ''}, {'ingredient_id': 'ff3abd44-ca61-452b-aad7-75faabeed9f7', 'quantite': '2 cuillères'}, {'ingredient_id': '71000df4-ece5-45e9-83b4-8c9aef7a268f', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (30759, 'Chocolatl - boisson tonique au chocolat', 'Banania, chocolat noir, farine de manioc, crème fraîche, muscade, poivre blanc, menthe, piment vert, miel', '5 min', ['Délayer (à feu très doux) dans un peu d''eau un volume de Banania, un volume de chocolat noir et un volume de farine de manioc, en ajoutant de la noix de muscade râpée en abondance, du poivre blanc moulu, et un peu de cannelle.', 'Une fois obtenue une crème de chocolat homogène, allonger avec de l''eau chaude (en fonction de la quantité désirée), tout en continuant à cuire à feu très doux et en remuant sans cesse avec une cuillère en bois, pendant environ une dizaine de minutes.', 'Rajouter un volume de crème entière, quelques feuilles de menthe fraiche hachées menu, et éventuellement (pour les puristes) un peu de piment vert frais haché. Laisser cuire encore le plus longtemps possible (attention, avec la crème il faut surveiller ''comme le lait sur le feu'').', 'Servir bien chaud et sucrer avec du miel.'], ['Ouvre-boîte', 'Casserole', 'Presse-agrumes', 'Planche à découper'], ['entrée', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'muscade', 'très facile', 'menthe', 'bon marché', 'plat', 'Banania', 'recette', 'cuisine', 'miel', 'recettes', 'Chocolatl - boisson tonique au chocolat', 'boisson', 'farine de manioc', 'dessert', 'plat de résistance', 'chocolat noir', 'chocolat chaud', 'piment vert', 'poivre blanc', 'cocktail'], 'Boisson', b77e8792-4d08-4f1f-83c5-69dadf91a54d, '2025-09-26T15:32:47.452263', [{'ingredient_id': 'f1273c86-cd31-458c-8b16-8dd2959551dc', 'quantite': '1'}, {'ingredient_id': '7c619f84-d1e9-4d54-83e4-ad61cb9138d3', 'quantite': '1'}, {'ingredient_id': 'de93a579-963c-458e-9633-67fd172ee8b9', 'quantite': '1'}, {'ingredient_id': '8253e2d0-fa63-4e10-89a3-ff04da38f34d', 'quantite': '1'}, {'ingredient_id': 'b3e14bcd-1726-4983-a4d9-5201ee801cca', 'quantite': ''}, {'ingredient_id': 'de5776f4-ea3b-4a7f-ad88-1eff61a2264b', 'quantite': ''}, {'ingredient_id': 'b4523cc1-e2aa-4623-862b-d67b0aebff72', 'quantite': ''}, {'ingredient_id': 'ac9fe59e-1cc3-4ebb-982e-f3f5f83be1ca', 'quantite': ''}, {'ingredient_id': '9b196a56-7523-4a0f-8b3b-57ae99e58105', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (19455, 'Gâteau des îles', 'yaourt nature, sucre en poudre, farine, huile, oeuf, levure chimique, sel, banane, mangue, noix de coco rapée, rhum, vanille', '15 min', ['Préchauffez le four à 150°C (thermostat 5). ', 'Le pot de yaourt sert de doseur. ', 'Mettez dans un mixeur les bananes avec le rhum, la vanille, le sucre et le yaourt. ', 'Mixer le tout. ', 'Ajouter la farine, la levure, le sel, les oeufs, l''huile et la noix de coco. ', 'Remixer le tout. ', 'Dans une casserole, faites un caramel avec du sucre et un peu d''eau. ', 'Versez-le dans un moule à gâteau assez profond. ', 'Epluchez la mangue et coupez-la en petits cubes que vous répartirez dans le moule caramélisé. ', 'Versez la pâte dessus et enfournez 30 min. ', 'Au bout de ce temps montez le four à 180°C (thermostat 6) et poursuivre la cuisson 30 min de plus. ', 'Vérifier la cuisson en plongeant une lame de couteau. ', 'Démoulez et laissez refroidir, puis mettez au réfrigérateur. Servir très frais.'], ['Casserole', 'Batteur électrique', 'Moule à tarte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'sel', 'confiserie', 'testées', 'levure chimique', 'yaourt nature', 'très facile', 'bon marché', 'oeuf', 'plat', 'mangue', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'farine', 'vanille', 'noix de coco rapée', 'dessert', 'plat de résistance', 'Gâteau des îles', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:32:51.159006', [{'ingredient_id': 'afa7a7e3-6383-4206-a346-a962f1ce91a4', 'quantite': '1'}, {'ingredient_id': 'a2791d4b-7722-48ce-a671-29391755e103', 'quantite': '1.5'}, {'ingredient_id': 'cc11f72f-6bb6-472a-ae10-b2d65d9397ba', 'quantite': '2.5'}, {'ingredient_id': '744d2244-2033-4f4d-8d21-d276e06479e1', 'quantite': '1'}, {'ingredient_id': '639980be-f5ce-43e0-8ed5-94e8f0ffad26', 'quantite': '3'}, {'ingredient_id': '360c5b54-5675-4c35-9407-1ae269ed5a2c', 'quantite': '1'}, {'ingredient_id': 'bb1ee7ba-cd24-4e3f-93fd-b8c4f5cbc6e7', 'quantite': '1'}, {'ingredient_id': 'ab79f754-e44a-45e4-9386-3b7df642444d', 'quantite': '3'}, {'ingredient_id': '31ab71a8-0223-42d9-bb29-f3bd7b7449cb', 'quantite': '1'}, {'ingredient_id': '675b2d08-d53e-4337-97c2-a62d4f783a18', 'quantite': '125 g'}, {'ingredient_id': '17f01103-59d0-4ceb-a499-00db9d4a0bcb', 'quantite': '2 cuillères'}, {'ingredient_id': '5c2e5e4b-895c-4b9d-a133-d8b934139e3c', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (82638, 'Agneau au coca cola', 'épaule d''agneau, cola, citron vert, oignon, ananas, banane, ail, feuille de laurier, beurre, farine, poivre, sel, crevettes, noix de coco rapée', '15 min', ['La veille, mettre la viande à mariner dans le coca cola additionné du jus du citron vert.', 'Le lendemain, égoutter, fariner et faire dorer les morceaux de viande dans le beurre.', 'Puis ajouter l''oignon émincé, la banane coupée en dés, la moitié de l''ananas débité en morceaux. ', 'Remuer et mouiller avec le jus de la marinade.', 'Ajouter l''ail, le laurier, le sel et le poivre.', 'Laisser cuire à feu doux pendant 1h30 environ.', 'Ajouter alors les crevettes et laisser mijoter encore dix minutes.', 'Rectifier l''assaissonement si besoin.', 'Servir avec du riz ou des petites pâtes avoine cuites au roux.', 'Mettre à disposition dans des coupelles le demi ananas restant, de la banane et de la noix de coco rapée .'], ['Économe', 'Mixeur', 'Râpe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'feuille de laurier', 'sel', 'confiserie', 'Agneau au coca cola', 'testées', 'facile', 'ail', 'plat', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'farine', 'cola', 'noix de coco rapée', 'dessert', 'crevettes', 'plat de résistance', 'moyen', 'beurre', 'ananas', 'épaule d''agneau', 'citron vert', 'poivre', 'cocktail'], 'Plat principal', 5772836c-ef43-42d4-b331-e27a76a369af, '2025-09-26T15:32:54.864904', [{'ingredient_id': '69758283-531f-4add-983a-6210acba084e', 'quantite': '1'}, {'ingredient_id': 'be16abad-5624-4887-8bb1-eb86ed9e974c', 'quantite': '1 l'}, {'ingredient_id': 'da7e3bd9-26f3-48f6-ae3f-387f14d688f1', 'quantite': '1'}, {'ingredient_id': '0a247b03-3c56-4230-a81c-ebae618bfe26', 'quantite': '1'}, {'ingredient_id': 'ca5ebf5b-3279-4688-89c2-f5cb10746691', 'quantite': '1'}, {'ingredient_id': '8e7de0bf-c5e4-48ad-9498-c2baa55aa984', 'quantite': '1'}, {'ingredient_id': '57eaf802-917e-44c4-98fa-8c281ea7a440', 'quantite': '2'}, {'ingredient_id': 'e5c148c5-988f-4571-a96e-82b50ca74393', 'quantite': '1'}, {'ingredient_id': '1f1d7b4c-f811-425c-bd8c-61915de13ab4', 'quantite': '50 g'}, {'ingredient_id': '94efe3c4-70e4-4f4b-9031-0a6ef277b8d0', 'quantite': '2 cuillères'}, {'ingredient_id': 'ce4a7e66-3086-4a54-bb62-037745614dc9', 'quantite': ''}, {'ingredient_id': '0380b09d-98c0-41a4-9a1b-81fd3f9f11d2', 'quantite': ''}, {'ingredient_id': 'b255a469-4a3a-4cb2-9552-8d6d6f39cb38', 'quantite': '150 g'}, {'ingredient_id': '3278e97c-c887-467c-87b4-bde89c53c33c', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (45534, 'Tarte crumble banane rhubarbe et spéculoos', 'spéculoos, beurre, sucre roux, banane, compote, pâte feuilletée', '20 min', ['Etaler la pâte dans le plat et y verser la compote de rhubarbe.', 'Couper les bananes en rondelles et les disposer sur la compote.', 'Dans une jatte, émietter les spéculoos (pas trop finement, il faut qu''il y ait quelques morceaux) ajouter le beurre ramolli et le sucre roux.', 'Malaxer à la main de manière à obtenir une pâte à crumble.', 'Verser la pate sur la préparation et enfourner 20 min à four moyen.', 'Les spéculoos doivent être dorés.', 'A manger tiède !'], ['Râpe', 'Couteau de chef'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'tarte à la rhubarbe', 'très facile', 'bon marché', 'plat', 'Tarte crumble banane rhubarbe et spéculoos', 'recette', 'spéculoos', 'compote', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pâte feuilletée', 'beurre', 'cocktail', 'sucre roux'], 'Dessert', f5600e6e-5e35-4ace-a945-f16bfa621e45, '2025-09-26T15:32:59.201766', [{'ingredient_id': '9161c8bc-73ab-4758-9f80-5cdd8b37e52d', 'quantite': '90 g'}, {'ingredient_id': 'bfc0ef03-b6d2-4969-8e70-771e9eec0e85', 'quantite': '90 g'}, {'ingredient_id': '6ba937c9-d13f-4e9d-8cb9-160bd6e15c16', 'quantite': '90 g'}, {'ingredient_id': '09e9ca6d-0f9b-430e-9fc5-a66e0169af27', 'quantite': '3'}, {'ingredient_id': '2041970e-3d3d-4cf8-a083-fd8b96e9b4ee', 'quantite': ''}, {'ingredient_id': '09f78b73-d63e-457c-979a-b12d8d2f2cd7', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (65377, 'Muffins moelleux aux chocolat, au coeur chocolat blanc/banane de Sandrine', 'banane, chocolat blanc, oeuf, chocolat noir, beurre tendre, farine, sucre', '20 min', ['Ecraser les bananes à la fourchette pour les réduire en purée.', 'Faire fondre le chocolat blanc au bain-marie. ', 'Mélanger les 2 ensemble, pour avoir une consistance bien homogène.', 'Verser ce mélange dans des petits moules individuels (assez petits de préférence, comme des moules pour glaçons). Mettre au congélateur au moins pendant 2 heures.', 'Préchauffer le four à 180°C (thermostat 6).', 'Faire fondre le chocolat noir au bain-marie', 'Une fois fondu ajouter le beurre, les jaunes d''oeufs, le sucre, la farine et enfin les blancs d''oeufs montés en neige.', 'Verser cette pâte dans des moules à muffins au 3/4 puis, enfoncer au centre la préparation chocolat blanc/banane.', 'Cuire à four chaud pendant 15 min pour un coeur mou ou 20 min pour une consistance plus ferme.', 'Démouler quand c''est complètement froid, puis mettre au frigo.'], ['Ouvre-boîte', 'Louche', 'Rouleau à pâtisserie', 'Couteau de chef', 'Passoire'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'beurre tendre', 'facile', 'bon marché', 'au coeur chocolat blanc/banane de Sandrine', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'chocolat noir', 'Muffins moelleux aux chocolat', 'chocolat blanc', 'gâteau au chocolat', 'sucre', 'cocktail'], 'Dessert', 7e2e78c3-feac-43eb-abc4-0b98b35e7be5, '2025-09-26T15:33:02.749553', [{'ingredient_id': '5bf2ee16-cd42-4709-8d4b-e022aea83bd3', 'quantite': '2'}, {'ingredient_id': 'b68dd86c-2162-408e-b052-598e46c2aaf3', 'quantite': '150 g'}, {'ingredient_id': 'd2b7232b-6c49-4ba8-9316-9378e06a8994', 'quantite': '3'}, {'ingredient_id': 'c78a9317-cf41-4efa-b76b-a8981cb865eb', 'quantite': '100 g'}, {'ingredient_id': '3631c00c-bbd5-4c70-9d44-940db05d1c12', 'quantite': '150 g'}, {'ingredient_id': '6c538b45-c4b7-4dc0-a137-39ff2e999daa', 'quantite': '50 g'}, {'ingredient_id': '49b4b6df-317c-4ddd-bd41-f4c5a407f9aa', 'quantite': '150 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (85718, 'Tarte à la banane et tourbillon de framboise', 'fond, banane, oeuf, lait, sucre roux, coulis de framboise', '15 min', ['Préchauffer le four à 180°C (thermostat 6). ', 'Pré cuire le fond de tarte au four pendant 10 min.', 'Pendant ce temps, écraser les bananes à la fourchette. Si elles sont un peu dures, on peut les tiédir au micro-ondes 1 ou 2 min.', 'Écraser les bananes très finement ou les mixer en ajoutant le lait, le sucre et l''œuf.', 'Répartir cette purée dans le fond de tarte. ', 'Avec le coulis de framboise, dessiner des cercles concentriques sur la tarte.', 'Mettre au four 30 min.'], ['Verre doseur', 'Planche à découper', 'Économe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'tarte à la banane', 'recette', 'cuisine', 'recettes', 'boisson', 'fond', 'dessert', 'plat de résistance', 'Tarte à la banane et tourbillon de framboise', 'lait', 'cocktail', 'sucre roux', 'coulis de framboise'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:33:06.326305', [{'ingredient_id': 'fa25eb73-3f76-4455-ad75-a1e66336f97b', 'quantite': '1'}, {'ingredient_id': 'a75632c0-c18b-4de3-91c5-40e8d5a762c6', 'quantite': '4'}, {'ingredient_id': '03294386-0214-41d0-b782-31c8acee5558', 'quantite': '1'}, {'ingredient_id': 'ef5d7a47-bce4-4747-9c1f-8987b33463ab', 'quantite': '1 cuillères'}, {'ingredient_id': '94ff1cb5-aa31-4ce7-86ae-cfa749d81d1f', 'quantite': '1 cuillères'}, {'ingredient_id': '8d6e5d16-bf37-4618-a290-b459b94f38a3', 'quantite': '20 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (24669, 'Gâteau de semoule caramélisé à la banane', 'lait, semoule, vanille, sucre, oeuf, beurre, rhum, banane, sucre', '45 min', ['Réaliser un caramel blond avec les 15 morceaux de sucre et en recouvrir le fond du moule. Laisser refroidir. Couper 3 bananes en rondelles et les poser par-dessus.', 'Préchauffer le four à 210°C (thermostat 7).', 'Fendre et gratter la gousse de vanille et la mettre dans une casserole avec le litre de lait. Verser la semoule en pluie et laisser épaissir 10 minutes sans cesser de remuer. Ajouter le sucre, le beurre et hors du feu, les oeufs battus en omelette. Couper les 3 autres bananes en dés et les incorporer au mélange avec le rhum.', 'Verser la préparation dans le moule et cuire au bain-marie 30 minutes. Laisser complètement refroidir avant de démouler.'], ['Batteur électrique', 'Mixeur', 'Tire-bouchon', 'Couteau de chef', 'Poêle'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'facile', 'bon marché', 'semoule', 'oeuf', 'plat', 'recette', 'Gâteau de semoule caramélisé à la banane', 'cuisine', 'recettes', 'boisson', 'vanille', 'dessert', 'plat de résistance', 'gâteau à la banane', 'beurre', 'lait', 'sucre', 'cocktail'], 'Dessert', a8be5247-b08d-4668-80f8-6a6b424b899e, '2025-09-26T15:33:09.997439', [{'ingredient_id': 'e8aa18e3-5f8c-4979-a1de-ee6deb28af74', 'quantite': '1 l'}, {'ingredient_id': '75743ea6-81f2-4ba0-ad53-8db411264985', 'quantite': '200 g'}, {'ingredient_id': '1ea96bdf-d5a8-4b50-8596-37e15ab60836', 'quantite': '1'}, {'ingredient_id': '992bacad-eb8d-4395-8e8c-c3467d4ec32b', 'quantite': '150 g'}, {'ingredient_id': '1a287b61-70de-43c9-b799-f4a830756395', 'quantite': '3'}, {'ingredient_id': 'eb53dfb2-db2d-4b62-84c6-2ce19f8ce10c', 'quantite': '1'}, {'ingredient_id': 'c796a371-5757-4481-8fa5-50bd03037b72', 'quantite': '1 cuillères'}, {'ingredient_id': '25e79c5b-a4c9-4b76-8abe-0576aa2c4e23', 'quantite': '6'}, {'ingredient_id': '7d329fb2-f0e3-418c-8e31-e424efd78c02', 'quantite': '15'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (48234, 'Riz colonial', 'escalope de poulet, porc, riz basmati, noix de saint-jacques, crevettes, bouillon de poule, échalote, ail, amandes effilées, sel, poivre, curry, laurier, clou de girofle, cognac, épices, cannelle, raisins secs, pâte à beignet, ananas, banane, pomme', '30 min', ['Faire revenir les viandes, à part, dans un mélange d''huile, d''ail et d''oignons.', 'Flamber au cognac.', 'Rajouter laurier, clou de girofle, curry, 4 épices, sel, poivre et un peu de farine. ', 'Mouiller avec le bouillon (recouvrir la viande), et faire cuire 30 min à petit feu.', 'Faire cuire le riz basmati ou riz sauvage (cuisson par absorption).', 'Rajouter les crevettes, 1 pincée de cannelle, les amandes effilées grillées, les raisins secs.', 'Faire revenir les noix de saint jacques dans un peu de beurre.', 'Préparer les beignets de fruits.', 'Servir ensemble, le riz, les st jacques, la viande et 1 beignet de chaque.'], ['Fouet', 'Casserole'], ['laurier', 'bouillon de poule', 'banane', 'entrée', 'recettes de cuisine', 'épices', 'sel', 'confiserie', 'testées', 'riz basmati', 'facile', 'Riz colonial', 'ail', 'plat', 'pâte à beignet', 'escalope de poulet', 'recette', 'cuisine', 'recettes', 'boisson', 'clou de girofle', 'plat de riz', 'dessert', 'crevettes', 'noix de saint-jacques', 'plat de résistance', 'pomme', 'moyen', 'ananas', 'raisins secs', 'cannelle', 'poivre', 'amandes effilées', 'curry', 'cognac', 'cocktail', 'échalote', 'porc'], 'Plat principal', c3c1fdf9-f7b7-4a1c-a0ae-824182157bd8, '2025-09-26T15:33:13.667446', [{'ingredient_id': '660a0433-32fa-475a-844c-03891f7be621', 'quantite': '500 g'}, {'ingredient_id': '9c96a159-761a-429d-bf61-5689d72fe707', 'quantite': '500 g'}, {'ingredient_id': '7b580a36-b951-4252-8911-913fd7640eb0', 'quantite': ''}, {'ingredient_id': '734febd6-479c-4bb4-a787-e345b3a8b9bf', 'quantite': ''}, {'ingredient_id': '1d0d32c7-c663-42ec-aaaa-0f299430a7d7', 'quantite': ''}, {'ingredient_id': '042b336b-844a-4220-a09d-6efc180eff3a', 'quantite': ''}, {'ingredient_id': 'eb4cb1e1-8f5d-43cc-9f45-bad7544a6405', 'quantite': ''}, {'ingredient_id': 'fe1f93a5-e5ba-4a58-b9b6-554324207801', 'quantite': ''}, {'ingredient_id': '235a2301-f5af-49b3-bbca-4070f813ce89', 'quantite': ''}, {'ingredient_id': '41f30db8-f9a1-4e21-968a-5791cba76ebd', 'quantite': ''}, {'ingredient_id': '01180031-d30d-49a0-bf10-8df58f6f33a1', 'quantite': ''}, {'ingredient_id': '1ce203f3-6111-49b8-8585-1eadbdb7fc00', 'quantite': ''}, {'ingredient_id': '43c1c3e7-bd18-40c9-98ad-ec57e96090cb', 'quantite': ''}, {'ingredient_id': 'db75969b-dd1b-4782-bfbb-458a1aec7d33', 'quantite': ''}, {'ingredient_id': '37e6ec44-5e87-45d7-b056-b258af9be5dd', 'quantite': ''}, {'ingredient_id': '9ae2c892-2167-4137-be06-6842195e4d85', 'quantite': '4'}, {'ingredient_id': 'ade16212-7075-485a-b4d6-40e98d425068', 'quantite': ''}, {'ingredient_id': '9ca62366-583f-44e9-b292-41a2824279ee', 'quantite': ''}, {'ingredient_id': '353fb7a0-c0b1-4af7-b604-13b9ec43dc9a', 'quantite': ''}, {'ingredient_id': 'cdbcc1f8-5aad-4113-b47a-a5c530cb39f2', 'quantite': '1'}, {'ingredient_id': 'b2f9b45e-2567-48a1-bf7c-94b0e1e936e5', 'quantite': '1'}, {'ingredient_id': '66a91091-a31f-4a74-ae61-2a1b5fcfa6f6', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (528502, 'Tarte aux pommes sans sucres ajoutés', 'pâte feuilletée, pomme, banane, beurre, cannelle', '15 min', ['Éplucher et découper 6 pommes en morceaux, et couper la banane en rondelles.', 'Faire cuire les fruits coupés à feu moyen avec les 50g de beurre. D’abord 15 min avec couvercle puis continuer la cuisson en remuant régulièrement jusqu’à évaporation de tout le liquide.', 'Placer la pâte dans un plat à tarte et piquer la à l''aide d''une fourchette.', 'Étaler la compote sur le fond de tarte.', 'Découper et disposer sur la tarte les 4 pommes restantes.', 'Ajouter quelques noix de beurre et de la cannelle.', 'Cuire à 180°C pendant environ 35 min'], ['Moule à tarte', 'Louche', 'Passoire', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'plat', 'tarte aux pommes', 'Tarte aux pommes sans sucres ajoutés', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pâte feuilletée', 'pomme', 'beurre', 'cannelle', 'cocktail'], 'Dessert', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T15:33:17.304515', [{'ingredient_id': 'c5214d61-7462-4203-ae90-242a2afb6c32', 'quantite': '1'}, {'ingredient_id': '9b342b0c-915f-4965-927a-3b13f88b087c', 'quantite': '10'}, {'ingredient_id': '9caba7fc-1b0c-4bc6-bceb-03dbd142ec4c', 'quantite': '1'}, {'ingredient_id': '716d0009-0fbe-409f-ba58-7e678e6ec154', 'quantite': '50 g'}, {'ingredient_id': '6015a320-7633-4163-aa7c-ea952f5d94b3', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (47617, 'Flapjack à la banane (barre d''avoine)', 'beurre, flocons d''avoine, sucre roux, miel, banane, cannelle', '10 min', ['Faire fondre le beurre, avec le miel et le sucre.', 'Pendant ce temps, écraser les bananes en purée; puis la mélanger avec les flocons d''avoine et le mélange beurre/sucre/miel.', 'Etaler la pâte dans un moule à tarte ou une plaque de 25 cm, et faire cuire au four à 180°C (thermostat 6).', 'Couper des tranches à la sortie du four, et déguster froid.'], ['Moule à tarte', 'Fouet'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'Flapjack à la banane (barre d''avoine)', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'cannelle', 'flocons d''avoine', 'cocktail', 'sucre roux'], 'Dessert', b272fa30-ac14-4e68-9759-888422e5d582, '2025-09-26T15:33:22.126495', [{'ingredient_id': '228e0bdd-bf11-47ff-9608-66ce5fb669e7', 'quantite': '150 g'}, {'ingredient_id': 'e80503b6-471f-4979-875c-7da1b2363ec7', 'quantite': '300 g'}, {'ingredient_id': '3c6fd3b1-5e28-49a5-bfb3-c0f2a2220496', 'quantite': '100 g'}, {'ingredient_id': '34286ae8-3211-4484-8b1a-c470ea44aa54', 'quantite': '3'}, {'ingredient_id': '50c3b1ce-28a0-4dc3-a059-fe6230a0a589', 'quantite': '3'}, {'ingredient_id': '75c92a70-e92b-489d-b7d6-9461ee780637', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (20113, 'Confiture mangue banane citron vert', 'mangue, banane, sucre, citron vert, cannelle', '15 min', ['Détailler les mangues en dés et les bananes en rondelles.', 'Les mettre dans une bassine à confiture avec la cannelle et le sucre.', 'Prélever le zeste des citrons verts et presser leur jus.', 'Ajouter le zeste et le jus dans la bassine puis mettre à cuire durant 1 heure en remuant régulièrement.', 'Verser la confiture dans les pots.'], ['Tire-bouchon', 'Presse-agrumes'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'Confiture mangue banane citron vert', 'testées', 'facile', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'citron vert', 'cannelle', 'sucre', 'cocktail'], 'Confiserie', 821aadda-3065-4766-8ad3-8821824998f3, '2025-09-26T15:33:26.450872', [{'ingredient_id': '32426424-7c42-4f5f-83c1-b26cd520b0e7', 'quantite': '1.7 kg'}, {'ingredient_id': '8a21fc7d-0e24-4cd3-b4dc-f57d684aa812', 'quantite': '1 kg'}, {'ingredient_id': 'cb69674c-2c98-4789-8952-f2cc514fda86', 'quantite': '1.4 kg'}, {'ingredient_id': '847b933d-77d9-4518-b405-f8d42791442c', 'quantite': '4'}, {'ingredient_id': 'e12c4189-1e1e-4d28-8fae-87f1f9e81c9d', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (392619, 'Mini muffins aux peaux de bananes', 'oeuf, sucre, farine, beurre, levure, eau, Peau de banane', '10 min', ['Préchauffer votre four à 220° thermostat 7.', 'Déposer les peaux de bananes dans le bol d''un mixeur puissant. Ajouter l''eau et enclencher la vitesse maximale jusqu''à obtenir une purée. Elle n''a pas besoin d''être lisse.', 'Mélanger vos oeufs avec le beurre et le sucre, jusqu''à obtenir un mélange clair et aérien.', 'Ajouter la farine, la levure et la purée de peaux de bananes et mélanger doucement.', 'Beurrer des moules à mini-muffins, et répartir la préparation dedans.', 'Laisser cuire 15 minutes, et le tour est joué!'], ['Spatule', 'Presse-agrumes', 'Tire-bouchon'], ['Peau de banane', 'entrée', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'muffin', 'beurre', 'sucre', 'Mini muffins aux peaux de bananes', 'cocktail'], 'Dessert', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T15:33:30.454635', [{'ingredient_id': 'd3c42587-bad2-46ed-af3c-9ce8228388fe', 'quantite': '2'}, {'ingredient_id': '269be5db-960b-4eaa-9f36-f5ba65d84bff', 'quantite': '150 g'}, {'ingredient_id': 'c9763079-6111-40d5-9068-b33e1724daad', 'quantite': '180 g'}, {'ingredient_id': 'da7458f3-c266-4a76-aefe-59dec8470e07', 'quantite': '50 g'}, {'ingredient_id': '791d9489-5172-49a4-a0a4-e80403d9132b', 'quantite': '1 cuillères'}, {'ingredient_id': 'f81bc7e9-54ef-44c6-a65b-21af16d8c76e', 'quantite': '100 g'}, {'ingredient_id': '1793c584-171d-4701-93f1-e625e827d08c', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (56870, 'Poulet créole au lait de coco accompagné de bananes dorées à la poêle', 'huile, poulet, oignon, ail, tomate, curry, safran, vin blanc sec, cube de bouillon, lait de coco, poivre, sel', '30 min', ['Faites chauffer l''huile dans une grande cocotte, faites-y dorer les morceaux de poulet.', 'Ajoutez les oignons et l''ail, faites dorer 5 minutes puis ajouter les tomates.', 'Remuez et faites cuire 10 minutes à feu moyen.', 'Ajoutez le curry et le safran puis le vin et le bouillon de volaille.', 'Portez à ébullition, baissez le feu, couvrez et faites cuire 30-40 minutes à feu doux.', 'Le poulet doit être tendre.', 'Ajoutez alors le lait de coco et faites cuire 5 minutes à feu doux.', 'Goûtez, salez, poivrez à votre convenance.', 'Servez avec du riz blanc et ajoutez quelques bananes jaunes dorées à la poêle dans un peu de beurre.', 'Régalez vous !!!!'], ['Planche à découper', 'Tire-bouchon', 'Fouet', 'Râpe'], ['poulet en sauce', 'lait de coco', 'poulet', 'entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'facile', 'ail', 'tomate', 'plat', 'recette', 'cube de bouillon', 'cuisine', 'recettes', 'oignon', 'boisson', 'huile', 'vin blanc sec', 'dessert', 'plat de résistance', 'moyen', 'Poulet créole au lait de coco accompagné de bananes dorées à la poêle', 'poivre', 'curry', 'cocktail', 'safran'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:33:34.707560', [{'ingredient_id': '86a6906f-a12c-4d61-ba9f-b6ced81a257f', 'quantite': '3 cuillères'}, {'ingredient_id': 'f2915597-5e2b-4dad-b3c0-40e690e1c845', 'quantite': '6'}, {'ingredient_id': 'f8e317e4-089c-45d9-9111-ad99e8a1937e', 'quantite': '2'}, {'ingredient_id': '666620d6-48a5-4ee2-97a0-ce8be9fcb15a', 'quantite': '2'}, {'ingredient_id': 'cc626f3c-a6a5-4581-8eab-49486a8d7ca4', 'quantite': '2'}, {'ingredient_id': '1376415f-cffe-4182-abe7-8c5a40c53a19', 'quantite': '1 cuillères'}, {'ingredient_id': '9fc3453e-9262-45f3-b840-91c589a7cf56', 'quantite': '1'}, {'ingredient_id': '9fba2a2f-4b94-447e-bd5f-4eefca535a83', 'quantite': '25 cl'}, {'ingredient_id': 'af29ad8a-24f1-4cff-941b-c332c8640aa7', 'quantite': '1'}, {'ingredient_id': '1ec87dee-7f30-43c3-abee-ff6358b7a8a8', 'quantite': '35 cl'}, {'ingredient_id': '73d5f990-fd2c-429b-b6a5-c6fa256391dd', 'quantite': ''}, {'ingredient_id': '1a83da0a-8f9b-40dd-bc39-c8151e57d89c', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (19755, 'Compote de bananes à la cannelle', 'banane, citron, cannelle, sucre', '5 min', ['Dans un plat adapté à la cuisson micro-onde : ', 'Coupez les bananes en fines lamelles, pressez le jus d''un demi citron, parsemez de 2 cuillères à soupe de sucre, et ajoutez la cannelle. ', 'Cuire environ 5 mn au micro-onde, puis servir encore tiède. ', 'PS : assaisonner selon votre goût. ', 'Bon appétit.'], ['Louche', 'Rouleau à pâtisserie', 'Tire-bouchon', 'Verre doseur'], ['Compote de bananes à la cannelle', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'citron', 'cannelle', 'sucre', 'compote de banane', 'cocktail'], 'Dessert', db090ccb-1858-46ae-917c-e2ceb48dfd9d, '2025-09-26T15:33:38.851380', [{'ingredient_id': 'a417d32a-5d9e-4af8-8b42-e22a6e62d4c7', 'quantite': '2'}, {'ingredient_id': '4d4085d1-adbf-4590-a881-6c88acfb668a', 'quantite': ''}, {'ingredient_id': '94617143-ba58-446d-9b41-7cd4288bd137', 'quantite': ''}, {'ingredient_id': '9125295e-1d56-4788-bc05-0d78da63f910', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (57242, 'Gratiné de bananes', 'vanille, beurre, banane, oeuf, crème liquide, sirop de sucre de canne, rhum, jus d''orange', '15 min', ['Préchauffez le four à 210°C (th7).', 'Récupérez les graines contenues à l''intérieur de la gousse de vanille à l''aide de la pointe d''un couteau, réservez.', 'Beurrez 4 plats à gratin.', 'Epluchez les bananes, taillez chacune d''elles en 4 tronçons, disposez les côte à côte dans les plats.', 'Battez les oeufs en omelette, incorporez la crème, les graines de vanilles, le sirop de sucre de canne, le rhum et le jus d''orange, versez cette préparation sur les bananes.', 'Enfournez et faites cuire 10 min.'], ['Économe', 'Fouet'], ['', 'sirop de sucre de canne', 'banane', 'entrée', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'vanille', 'dessert', 'plat de résistance', 'beurre', 'jus d''orange', 'cocktail', 'Gratiné de bananes'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:33:42.806938', [{'ingredient_id': '6eb4a716-7040-41da-b326-d8407df84d0b', 'quantite': ''}, {'ingredient_id': 'd3cda1e7-6bdb-4372-a77b-dc18a96b6cce', 'quantite': '10 g'}, {'ingredient_id': 'd4e221b3-1f44-4de4-ba49-302529f743bd', 'quantite': '4'}, {'ingredient_id': '3156dd8c-fc70-4ff1-940d-66b1ae4dd2cb', 'quantite': '3'}, {'ingredient_id': '885e5884-0cd6-42f4-99b1-48bf46b5194f', 'quantite': '4 cl'}, {'ingredient_id': '21455a3a-ec0f-4e64-8ef0-f41fb6fa7adc', 'quantite': '10 cl'}, {'ingredient_id': '2cb37942-204d-48aa-b118-520d6d1fe3f7', 'quantite': '18 cl'}, {'ingredient_id': '36fe31cd-ed37-48a2-a9ee-5d25fcac3fa9', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (194854, 'Délice aux fruits flambés en verrine', 'banane, pomme, fraises, cassonade, rhum, glace vanille, crème chantilly', '20 min', ['Couper la pomme et la banane petits morceaux et en rondelles.', 'Les faire revenir dans du beurre et de la cassonade.', 'Réserver.', 'A part, faire bouillir de l''eau avec de la cassonade et y plonger les fraises coupées en lamelles.', 'Faire flamber au rhum les pommes-bananes.', 'D', 'ans une grande verrine, mettre dans l''ordre :', 'la glace vanille, les pommes-bananes, les fraises avec un peu de leur jus et enfin la chantilly.'], ['Verre doseur', 'Balance de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'cassonade', 'Délice aux fruits flambés en verrine', 'rapide', 'plat', 'moyenne', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'crème chantilly', 'glace vanille', 'dessert', 'plat de résistance', 'pomme', 'moyen', 'cocktail'], 'Dessert', 2c0d5753-69ea-487a-ac8b-110006640a49, '2025-09-26T15:33:48.257549', [{'ingredient_id': '01f6254a-ae44-4330-a440-58e5b29b3596', 'quantite': '1'}, {'ingredient_id': 'c542e1a9-69bf-4001-a034-6976d08aa872', 'quantite': '1'}, {'ingredient_id': '2c935b07-9767-45f6-befe-e862742f0c57', 'quantite': '2'}, {'ingredient_id': 'eab9d916-2e7d-4e8a-9949-44c0777ddbc9', 'quantite': '50 g'}, {'ingredient_id': '0c23cc4d-3178-4868-8861-bffb8dce87a8', 'quantite': '10 cl'}, {'ingredient_id': 'a7affcd7-8e88-4332-8090-5969890c02c6', 'quantite': '1'}, {'ingredient_id': 'adc7d73e-152f-4201-b774-97e212ac049c', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (169507, 'Smoothie chocolat abricot banane', 'banane, abricot, chocolat, glaçons, sucre', '15 min', ['eplucher les bananes et les couper en rondelles,', 'enlever le noyau des abricots,', 'mettre les bananes, les abricots et le chocolat dans le mixeur puis rajouter les glaçons.mettez le sucre si le gout est trop amer.', 'dervir avec un glaçons en decoration dans un petit verre ou des verre a pied feront l''affaire.'], ['Mixeur', 'Tire-bouchon', 'Ouvre-boîte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'abricot', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Smoothie chocolat abricot banane', 'dessert', 'plat de résistance', 'glaçons', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:33:53.646588', [{'ingredient_id': '40a3d823-18bd-4e89-91c1-a2c8440ba1bc', 'quantite': '3'}, {'ingredient_id': '695f349d-55f3-4bfc-bc32-2c7a1fea1019', 'quantite': '4'}, {'ingredient_id': '494ca235-cae9-473e-92c2-177551935892', 'quantite': '8'}, {'ingredient_id': 'b432c843-c03a-4ace-a18f-e86acbf77b2b', 'quantite': '3'}, {'ingredient_id': 'f504501f-de0a-4c47-9b63-ad5b41af34ee', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (305223, 'Crumble pommes, bananes, raisins et chocolat', 'pomme, banane, raisins secs, chocolat, beurre, cassonade, farine', '30 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Éplucher les pommes et les couper en petits morceaux.', 'Les faire revenir dans du beurre à feu moyen pendant 15 min en les saupoudrant de 2 cuillères à soupe de cassonade et en ajoutant les raisins au bout de 5 min de cuisson.', 'Mettre le mélange dans un plat beurré.', 'Parsemer des pépites de chocolat.', 'Recouvrir des bananes découpées en rondelles.', 'Mélanger la farine et 80 g de cassonade', 'Ajouter le beurre coupé en petits morceaux et ramolli.', 'Mélanger et répartir la pâte obtenue sur les bananes.', 'Mettre au four 35 min.'], ['Pince de cuisine', 'Verre doseur', 'Moule à tarte'], ['raisins et chocolat', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'cassonade', 'chocolat', 'facile', 'bon marché', 'crumble aux pommes', 'bananes', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'pomme', 'beurre', 'raisins secs', 'Crumble pommes', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:34:00.483077', [{'ingredient_id': 'd97b6ced-0f14-4f28-9654-03ea4a2a4e77', 'quantite': '3'}, {'ingredient_id': 'd75a04e7-9e00-4301-acdf-4cbc4860d0ee', 'quantite': '3'}, {'ingredient_id': '293822e1-c1f5-451e-86d7-667d2b67c276', 'quantite': '1'}, {'ingredient_id': '5d7af969-5d92-4be1-bcb5-7a93710cc291', 'quantite': '75 g'}, {'ingredient_id': 'f7085028-497c-4f1c-a61f-549639ef82d0', 'quantite': '80 g'}, {'ingredient_id': '59460aab-a219-4042-9a68-83a1fc6ffa4a', 'quantite': '80 g'}, {'ingredient_id': 'b1c84c4b-2bce-465f-993c-0868fad9e6bd', 'quantite': '150 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (52610, 'Compote banane pomme noix caramélisées', 'banane, pomme, crème fraîche, cassonade, sucre, cerneau de noix, huile, gingembre, cannelle, cerneaux de noix de pécan', '15 min', ['Faire chauffer le sucre avec 1 cuillère à soupe d''eau dans une casserole sans cesser de touiller.', 'Quand le mélange commence à dorer, ajouter les noix et les noix de pécan.', 'Touiller afin que tous les cerneaux soient enrobés de caramel.', 'L''opération n''est très longue.', 'Verser ensuite le tout sur une plaque huilée en veillant à détacher les noix les unes des autres.', 'Eplucher et couper en morceaux les bananes et les pommes.', 'Les mettre dans un plat allant au micro-ondes.', 'Ajouter la cassonade, la crème fraîche, le gingembre et la cannelle.', 'Bien mélanger le tout.', 'Couvrir et passer 8 minutes au micro-ondes puissance maximum.', 'Au moment de servir, ajouter les noix caramélisées. ', 'Se manger chaud ou froid.'], ['Louche', 'Économe', 'Pince de cuisine'], ['gingembre', 'entrée', 'banane', 'cerneaux de noix de pécan', 'recettes de cuisine', 'crème fraîche', 'cerneau de noix', 'confiserie', 'testées', 'cassonade', 'facile', 'compote de pomme', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'dessert', 'plat de résistance', 'pomme', 'Compote banane pomme noix caramélisées', 'cannelle', 'sucre', 'cocktail'], 'Dessert', 75bf5086-594d-4280-b25e-edac188c2442, '2025-09-26T15:34:06.016760', [{'ingredient_id': '3b1cee2d-8dd8-40f6-abbd-42990ee31ba0', 'quantite': '3'}, {'ingredient_id': '19f7e9ab-ab9d-4fd9-8071-919a315a00b1', 'quantite': '4'}, {'ingredient_id': '540844c0-c802-41b4-90a7-c5c0b5b7b376', 'quantite': '50 cl'}, {'ingredient_id': '8b7684fc-cb31-403a-aed0-147f7c53e1fa', 'quantite': '50 g'}, {'ingredient_id': 'c4100d8f-d1f3-4100-b8c5-ec8182e4cf0e', 'quantite': '50 g'}, {'ingredient_id': '89fcc9f8-7922-4c29-973b-b4a4d64d414e', 'quantite': '125 g'}, {'ingredient_id': '1dc61468-a3fd-4340-9a00-67b13f6c8cb7', 'quantite': '1 cuillères'}, {'ingredient_id': '92226473-046b-4893-964f-44c0ab6fe6ec', 'quantite': '1 cuillères'}, {'ingredient_id': '78435609-6f6d-438b-9623-bfa08b64089d', 'quantite': '2 cuillères'}, {'ingredient_id': '32815139-933d-4c0b-96b5-f94122dc2e88', 'quantite': '125 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (30089, 'Poulet au curry et a la noix de coco...', 'poulet, banane, pomme, tomate, oignon, noix de coco, curry, lait, crème fraîche', '15 min', ['Tout d''abord, faire cuire le poulet sur un filet d''huile d''olive et le réserver.', 'Ensuite versez le lait dans une casserole et faire chauffer, attendre l''ébulition puis retirer du feu. Incorporez la noix de coco râpée et laissez infuser à couvert.', 'Epluchez la pomme et la banane puis coupez-les en dés. Coupez la tomate en  fines lamelles et gardez le jus, puis émincez les oignons.', 'Dans un faitout, faites blondir les oignons dans l''huile d''olive. Ensuite passez sur un feu doux et incorporez la pomme. Laissez-la 5 mn en prenant soin qu''elle n''attache pas au fond, puis ajoutez la banane et la tomate avec son jus. Laissez cuire a feu doux jusqu''à l''obtention d''une sorte de purée avec des grumeaux.', 'Mettez la moitié de la dose de curry pour colorer le mélange. Ensuite rajoutez le mélange de lait et de coco.', 'Toujours a feu doux laissez réduire de moitié(a peu près) et rajoutez le reste de curry et la crème fraîche, mélangez et déposez le poulet sur la sauce pour qu''il s''imprègne du goût.', 'Laissez toujours sur le feu jusqu''à ce que la sauce s''épaississe.', 'Servez dans un plat accompagné de riz.'], ['Presse-agrumes', 'Tire-bouchon'], ['poulet', 'banane', 'entrée', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'très facile', 'bon marché', 'curry de poulet', 'tomate', 'plat', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'Poulet au curry et a la noix de coco...', 'dessert', 'plat de résistance', 'pomme', 'noix de coco', 'lait', 'curry', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:34:10.639536', [{'ingredient_id': 'e8d146e6-7302-4f1a-b63a-881c9557db5c', 'quantite': '800 g'}, {'ingredient_id': 'bd415f3d-bfb1-4b33-aa16-6e1c1faadcc7', 'quantite': '1'}, {'ingredient_id': '4bffdc9d-25bd-4214-b706-a07520ea3cac', 'quantite': '1'}, {'ingredient_id': '35df73e8-f877-422a-8938-5db4387c1cfc', 'quantite': '1'}, {'ingredient_id': '21c90f67-867c-44ab-b98a-0698e217dc31', 'quantite': '1'}, {'ingredient_id': '42948f57-ea02-4be9-a69e-df38d9bdf456', 'quantite': '3 cuillères'}, {'ingredient_id': '931c858e-a4fe-432a-bc4d-7e889d92816a', 'quantite': '1 cuillères'}, {'ingredient_id': '644bb499-941f-43f7-8793-2215ea8e0461', 'quantite': ''}, {'ingredient_id': 'e068a95a-00b8-4467-b725-1cdca17ab947', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (58871, 'Plaisirs de fruits en verrine (sans sucre ajouté)', 'orange, banane, pomme, framboises, fromage blanc, cannelle, cerneau de noix', '15 min', ['Coupez tous les fruits en petits dés. Ajoutez de la cannelle selon votre goût et laissez mariner au réfrigérateur pendant 1 h.', 'Séparément : émiettez les cerneaux de noix et battez les fromages blancs vanillés.', 'Dans 4 jolis verres à pied, répartissez un peu de salade de fruits. Pour chaque verre : mettez un cerneau de noix émietté puis une couche de fromage blanc vanillé battu. Finissez par une couche de fruits et les cerneaux de noix restants.', 'Servez bien frais.'], ['Batteur électrique', 'Fouet', 'Poêle', 'Mixeur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'cerneau de noix', 'confiserie', 'testées', 'très facile', 'framboises', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'fromage blanc', 'dessert', 'Plaisirs de fruits en verrine (sans sucre ajouté)', 'plat de résistance', 'pomme', 'orange', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:34:16.232497', [{'ingredient_id': '90edd795-0808-4e61-8017-abcff82fc153', 'quantite': '2'}, {'ingredient_id': '50287e3e-02c9-4fb8-bb49-d2dbed9e72c6', 'quantite': '1'}, {'ingredient_id': '3726c2aa-e047-4b19-a758-c4f49f7a7a83', 'quantite': ''}, {'ingredient_id': '4feec7f1-7cc1-4b50-8748-378107c640ad', 'quantite': '100 g'}, {'ingredient_id': '8cfe0df7-03f8-409b-9104-fc688a097ed0', 'quantite': '4'}, {'ingredient_id': 'e2b94b2a-7a78-4969-8a17-d820907a71c8', 'quantite': ''}, {'ingredient_id': '7597f911-c205-4b4c-ab55-53466d63f8e8', 'quantite': '8'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (217197, 'Glace Banane-Ananas', 'ananas, blanc d''oeuf, jus de citron, banane', '10 min', ['Couper l''ananas dans sa longueur.', 'Retirer à l''aide d''un couteau et d''une cuillère toute la chair de l''ananas.', 'Mettre l''ananas avec tous les ingrédients dans un mixer et réduire en purée.', 'Mettre cette purée dans un plat au congélateur.', 'Mixer une fois cette purée au cours de la congélation.', 'Remixer peu de temps avant de servir pour éviter les paillettes et obtenir une purée très froide mais pas trop dure (peut se faire avant le dîner).', 'Servir dans les coques d''ananas que l''on aura conservées au frais'], ['Tire-bouchon', 'Presse-agrumes'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'jus de citron', 'ananas', 'glace à l''italienne', 'blanc d''oeuf', 'Glace Banane-Ananas', 'cocktail'], 'Dessert', b5e3c001-0ecd-4a3f-aae4-36b3536231ff, '2025-09-26T15:34:21.725715', [{'ingredient_id': 'c65df452-3a62-4446-8673-c99a053f2c67', 'quantite': '1'}, {'ingredient_id': 'e79f3e7b-b5c1-4c2d-991d-6fbfe49f1635', 'quantite': '1'}, {'ingredient_id': 'fcabee25-a6ac-4180-a244-a04f849ac7e9', 'quantite': '1'}, {'ingredient_id': '59a5084a-8ea5-4513-b154-a459ed3ac670', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (83246, 'Poulet aux bananes et aux courgettes avec paprika', 'escalope de poulet, banane, courgette, citron, yaourt, paprika, beurre', '15 min', ['Verser le yaourt dans un bol, ajouter le jus d''un demi citron et les deux cuillères de paprika, remuer.', 'Appliquer la sauce ainsi obtenue sur les escalopes de poulet, sur les deux côtés puis réserver au frais.', 'Peler les bananes, les trancher en rondelles, verser le jus de l''autre demi citron dessus et laisser imprégner.', 'Peler les courgettes, les trancher et les faire revenir à la poêle recto-verso pendant environ 8 minutes.', 'Sur une feuille d''aluminium, disposer un peu de bananes, un peu de courgettes, une escalope, et par dessus encore quelques bananes et courgettes, plier l''aluminium de façon, à faire des papillotes.', 'Renouveler autant de fois qu''il y a d''escalopes.', 'Enfourner 25 minutes puis déguster.'], ['Rouleau à pâtisserie', 'Louche', 'Passoire', 'Planche à découper', 'Râpe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'très facile', 'bon marché', 'paprika', 'Poulet aux bananes et aux courgettes avec paprika', 'plat', 'escalope de poulet', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'citron', 'courgette', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:34:25.741566', [{'ingredient_id': '0e7cfe77-8454-4cac-9a90-6af3c92238d2', 'quantite': '4'}, {'ingredient_id': '0cd40860-f149-49a4-94a7-ba3708213f0d', 'quantite': '3'}, {'ingredient_id': '63ad4839-d02a-4e5c-96b7-ff23ed816bf6', 'quantite': '4'}, {'ingredient_id': '4c468423-a01d-4b08-89d9-30bb085f90bb', 'quantite': '1'}, {'ingredient_id': '886f9cab-611e-409e-bcde-9dcbed4bd8e4', 'quantite': '1'}, {'ingredient_id': '0d1d8073-6fa5-43b8-9634-9b0d282472e5', 'quantite': '2 cuillères'}, {'ingredient_id': 'ec77752e-7959-4135-abf0-9808272b42c0', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (50123, 'Divin cake (banane, amandes, pépites de chocolat)', 'beurre salé, sucre en poudre, oeuf, farine, levure chimique, banane, chocolat pâtissier, amandes', '15 min', ['Préchauffez le four (200°C, thermostat 6-7).', 'Travaillez le beurre (salé obligatoirement sinon ça vaut pas), avec le sucre, de manière à obtenir une pommade (à la fourchette, c''est plus facile).', 'Ecrasez les bananes avec ladite fourchette.', 'Incorporez au mélange beurre-sucre.', 'Ajoutez les oeufs entiers, puis la farine et la levure.', 'Mélangez bien.', 'Débitez le chocolat en pépites (chauffez un peu le chocolat pour que ça soit plus facile), et hâchez grossièrement les amandes.', 'Mélez amandes et chocolat à la pâte.', 'Mettez l''appareil dans un moule à cake beurré, décorez de quelques amandes entières et zou au four.', 'Pour la cuisson : 10 min à 200°C (thermostat 6-7), puis 30 min environ à 170°C (thermostat 5-6).', 'N''hésitez pas à contrôler la cuisson, il faut que ça soit bien moelleux.', 'Laissez refroidir (ou pas !), et régalez-vous !'], ['Mixeur', 'Batteur électrique', 'Presse-agrumes', 'Tire-bouchon'], ['amandes', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'pépites de chocolat)', 'levure chimique', 'très facile', 'beurre salé', 'bon marché', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'chocolat pâtissier', 'cuisine', 'recettes', 'Divin cake (banane', 'boisson', 'farine', 'autres cakes', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:34:29.621297', [{'ingredient_id': '2542ace9-bd9d-49de-942e-95fdf71db2ad', 'quantite': '150 g'}, {'ingredient_id': '9361c2e3-5290-498e-86b2-cfd9b9700292', 'quantite': '80 g'}, {'ingredient_id': '28cc1025-bb85-4842-a8af-9a50a412551d', 'quantite': '3'}, {'ingredient_id': '02340996-e5e0-4307-aa0c-d420cafa822c', 'quantite': '250 g'}, {'ingredient_id': 'bbd29b72-02da-4ae1-8960-772925a6d10a', 'quantite': '1'}, {'ingredient_id': '06e4e6d7-6de8-46f7-9c8b-81b36c662b4a', 'quantite': '2'}, {'ingredient_id': '11472e04-93a3-4de3-ab47-7acd3f458b2c', 'quantite': '100 g'}, {'ingredient_id': 'af732562-b1e2-4eb1-afb6-c29227e29478', 'quantite': '70 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (338071, 'Biscuits choco-banane', 'farine, flocons d''avoine, sucre, sel, sucre vanillé, levure, margarine, huile, miel, oeuf, banane, chocolat noir', '30 min', ['Préchauffez le four à 200°C (thermostat 6-7)', 'Dans un saladier, mélangez tous les ingrédients l''un après l''autre: farine, flocons d''avoine, sucre, sel, sucre vanillé, levure.', 'Faites fondre la margarine et ajoutez-la aux autres ingrédients puis ajoutez huile, miel, oeuf.', 'Coupez en petits dés banane et chocolat et mélangez à nouveau (pas trop longtemps pour ne pas faire de la bouillie).', 'Formez les biscuits avec une cuillère à soupe, ou - encore mieux - à la main et déposez les sur du papier sulfurisé sur le lèche-frites.', 'Enfournez 15 minutes.', 'Sortez-les tout de suite et laissez refroidir 5/10 min sur une grille (froide).'], ['Moule à tarte', 'Presse-agrumes', 'Planche à découper', 'Mixeur'], ['entrée', 'Biscuits choco-banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'autres biscuits et petits gâteaux', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'miel', 'recettes', 'boisson', 'huile', 'farine', 'margarine', 'dessert', 'plat de résistance', 'sucre vanillé', 'sucre', 'flocons d''avoine', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:34:34.093409', [{'ingredient_id': '7becdb25-95e6-4f41-8c79-f9d5ea14224b', 'quantite': '240 g'}, {'ingredient_id': '057c0886-a478-49b0-93b3-9dcc2a9aee61', 'quantite': '60 g'}, {'ingredient_id': 'db70a457-b87f-4c4a-8003-d6d6c52668f4', 'quantite': '110 g'}, {'ingredient_id': '49eca388-6012-4948-a7f9-a68b3cf259fb', 'quantite': '1'}, {'ingredient_id': '7b82da79-c41c-4e9c-9f54-759337ec8479', 'quantite': '1'}, {'ingredient_id': '8f4d28da-cfbd-4ee0-8931-5a1b832db173', 'quantite': ''}, {'ingredient_id': '7c4bb737-d201-4064-b197-98911566b3c7', 'quantite': '100 g'}, {'ingredient_id': '5a5ba7ec-7193-4e7f-bf0d-2df9783192b3', 'quantite': '2 cuillères'}, {'ingredient_id': '1c7f7868-f9b3-43b3-b69c-6f000f831e41', 'quantite': '1 cuillères'}, {'ingredient_id': 'e4cc5d0f-8604-4bb1-8136-478fe462c970', 'quantite': '1'}, {'ingredient_id': '6b94c201-6a97-49da-a42a-f31b4241263b', 'quantite': ''}, {'ingredient_id': '43ecc10a-233d-4a4b-a03d-801f13e24f23', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (60287, 'Mousse de bananes délicieuse', 'banane, sucre, citron, crème fraîche, gélatine', '20 min', ['A préparer la veille de préférence.', 'Laisser tremper les feuilles de gélatine dans de l''eau pendant la préparation des bananes.', 'Mixer les bananes (ou les écraser à la fourchette), puis les faire revenir à feu moyen dans une casserole avec une noisette de beurre, ajouter le jus de citron, le sucre, et les feuilles de gélatine et laisser mijoter à feu doux en remuant pendant 1 min.', 'Incorporer la crème fraîche hors du feu.', 'Mettre la préparation dans des petits ramequins individuels ou dans un seul et même plat (plat à gâteau par exemple), puis laisser au frigo pendant 12 h.', 'Sortir la mousse de banane 30 min environ avant de servir.', 'La servir avec de la crème anglaise, des petites tranches de kiwi et des copeaux de noix de coco.'], ['Casserole', 'Batteur électrique', 'Râpe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'gélatine', 'citron', 'Mousse de bananes délicieuse', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:34:38.392514', [{'ingredient_id': '0a09f12a-e36f-418c-9c15-deb90bdedabb', 'quantite': '6'}, {'ingredient_id': '93c241b4-ea3a-49ff-b7c9-c6d3b7281558', 'quantite': '40 g'}, {'ingredient_id': '0b81c30b-63ea-4e90-b40a-8fce033881a4', 'quantite': ''}, {'ingredient_id': '7fb1c867-f62d-4699-8add-9ff1e7ce00c6', 'quantite': '20 cl'}, {'ingredient_id': '60ef6039-bc0f-43a1-a3a9-3342a95a47c2', 'quantite': '5'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (21852, 'Muffins citron et coco acidulés', 'oeuf, sucre, farine, levure chimique, beurre, noix de coco, banane, citron', '20 min', ['Dans une terrine, mélanger la farine et la levure, avec la noix de coco et le sucre en poudre. ', 'Y ajouter le beurre, les 2 oeufs (battus de quelques rapides coups de fourchette) et une quantité variable de zeste de citron. Mélanger encore (l''ensemble reste assez farineux). ', 'D''autre part, peler les fruits et les couper en petits morceaux, les intégrer au mélange avec le jus des citrons (la texture obtenue doit rester épaisse, mais on peut ajouter un peu d''eau au besoin pour mieux lier la pâte). ', 'Verser dans les moules à muffins préparés, et encore saupoudrer d''un mélange de sucre et de coco, à l''envi. ', 'Cuisson : ', 'Mettre à four moyen (200-220°C) 30 mn environ. ', 'Régalez-vous bien !'], ['Verre doseur', 'Passoire', 'Tire-bouchon', 'Moule à tarte', 'Poêle'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'Muffins citron et coco acidulés', 'dessert', 'plat de résistance', 'muffin', 'citron', 'beurre', 'noix de coco', 'sucre', 'cocktail'], 'Dessert', d4d17f20-7367-43ef-a3db-89925cd245b1, '2025-09-26T15:34:42.379369', [{'ingredient_id': 'c5e94c99-ec01-48c5-9ced-0f0b16791371', 'quantite': '2'}, {'ingredient_id': '69c91cda-7105-4a0d-b25e-9d64c93d11ea', 'quantite': '150 g'}, {'ingredient_id': '1cfd02c2-1d50-40d5-bda0-ad46ce6cb491', 'quantite': '400 g'}, {'ingredient_id': '8ec9a60b-a44d-47ab-8c6e-308b4812b883', 'quantite': '5.5 g'}, {'ingredient_id': '080fd7dd-bdf6-4682-b1ae-8e78dc7f8046', 'quantite': '100 g'}, {'ingredient_id': '7a085b7f-b81f-4c38-88fa-aff6f3cc1048', 'quantite': '100 g'}, {'ingredient_id': 'b2ca2709-fc09-4574-b467-e46f0323a390', 'quantite': '2'}, {'ingredient_id': '7e151665-838c-4082-ab4a-2b697e942fa1', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (81183, 'Crevettes marinées poêlées sur lit de salade', 'crevettes, banane, salade, poivre, sel, cumin, jus de citron, miel', '15 min', ['Décortiquer les crevettes et les placer dans un bol. Y ajouter une pincée de sel, quelques tours de moulin à poivre, le cumin, arroser d''une cuiller à soupe de jus de citron. ', 'Mélanger le tout et mettre à mariner au frais pendant une heure ou deux minimum.', 'Au moment du repas, recouvrir le fond de chaque assiette d''un petit lit de verdure avec un assaisonnement léger (huile de noix et un doigt de vinaigre balsamique).', 'Puis, faire revenir les crevettes marinées dans une poêle, à feu moyen pendant environ 10 minutes, elles commencent alors à roussir légèrement.', 'Ajouter à ce moment une banane coupée en tranches (3 ou 4 par assiette) et une cuiller à soupe de miel. Laisser griller environ 2 minutes, jusqu''à ce que les tranches de bananes dorent.', 'Disposez ensuite les crevettes au centre de l''assiette de salade puis y déposer les tranches de bananes. Il est possible de déglacer le jus de la poêle en y mettant un peu de jus de citron.'], ['Économe', 'Batteur électrique', 'Moule à tarte', 'Presse-agrumes', 'Pince de cuisine'], ['entrée', 'banane', 'salade', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'cumin', 'très facile', 'rapide', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'Crevettes marinées poêlées sur lit de salade', 'dessert', 'crevettes', 'plat de résistance', 'jus de citron', 'moyen', 'poivre', 'cocktail'], 'Entrée', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:34:46.361623', [{'ingredient_id': '53ad04db-acd3-4760-8dd2-b0236da643ad', 'quantite': '30'}, {'ingredient_id': 'ad413847-426d-45e1-a70d-64de386dd046', 'quantite': '2'}, {'ingredient_id': '96490d7e-9eb8-417d-8234-a0d7f4f684c0', 'quantite': ''}, {'ingredient_id': '53d08ab4-8634-4917-802d-4468d0e6d485', 'quantite': ''}, {'ingredient_id': 'f3e7040d-0302-4fc9-81ef-800e2a19f5b6', 'quantite': ''}, {'ingredient_id': 'f479f92f-e346-4778-9935-fca6fab84359', 'quantite': ''}, {'ingredient_id': 'cde0fc70-bafe-47db-bbcf-c45398f35287', 'quantite': ''}, {'ingredient_id': 'c22605b6-3a61-4eb5-a694-1a800e6657c3', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (21142, 'Tarte Banane Chocolat', 'pâte sablée, chocolat pâtissier, crème fleurette, banane, beurre, sucre', '15 min', ['Faire cuire à blanc la pâte sablée dans un moule à tarte préalablement beurré 15 à 20 min. Prenez soins de parsemer de haricots secs pour que la pâte ne lève pas. ', 'Couper les bananes en tranches épaisses. ', 'Faire fondre 50 g de beurre dans une poêle. Ajouter les bananes et le sucre. Faire légèrement caraméliser .', 'Faire bouillir la crème fleurette.  ', 'En même temps, faire fondre le chocolat au bain-marie. Hors du feu, intégrer la crème, en remuant au fouet. ', 'Retirer les haricots secs et démouler le fond de tarte. Recouvrir avec les bananes, puis verser le chocolat ', 'Placer au froid pendant 2 à 3 heures. Servir frais mais pas glacé'], ['Verre doseur', 'Tire-bouchon', 'Couteau de chef'], ['entrée', 'tarte au chocolat', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'crème fleurette', 'bon marché', 'pâte sablée', 'plat', 'recette', 'chocolat pâtissier', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Tarte Banane Chocolat', 'beurre', 'sucre', 'cocktail'], 'Dessert', 9387fadc-49e2-41b1-b2a5-4578b60f8f52, '2025-09-26T15:34:51.491902', [{'ingredient_id': '3980b8f9-38c9-4699-ad8f-f2b68fd3e45e', 'quantite': '1'}, {'ingredient_id': '6f75875e-304b-42ad-a5a8-608011b80858', 'quantite': '200 g'}, {'ingredient_id': '41529487-bf63-423b-b3f1-01535035964f', 'quantite': '200 g'}, {'ingredient_id': 'e061ae40-72b2-4608-974d-d9f2ca751127', 'quantite': '4'}, {'ingredient_id': '0195bd00-8d77-4d63-acaa-98be12f89d08', 'quantite': '80 g'}, {'ingredient_id': '4b1783ca-6608-413d-96f7-f4f3d9eed1b8', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (229695, 'Milk-shake melon et banane', 'melon, banane, sucre, lait', '2 min', ['Peler et couper en rondelles les bananes.', 'Vider et couper en petits morceaux le melon.', 'Les mettre sur une assiette environ 2h au  congélateur (donc à faire à l''avance).', 'Mettre les fruits congelés dans le blender, mixer 1 min.', 'Ajouter le sucre et le lait puis mixer à nouveau 1 min.', 'Et voilà, votre boisson est prête !', 'Bonne dégustation !'], ['Économe', 'Pince de cuisine', 'Balance de cuisine', 'Poêle'], ['', 'melon', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Milk-shake melon et banane', 'dessert', 'plat de résistance', 'sucre', 'lait', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:34:55.920153', [{'ingredient_id': '8cb6e406-2af9-4b27-999a-6bedd54501fb', 'quantite': '1'}, {'ingredient_id': '77e1babe-3908-4b56-9deb-19daf06d39ee', 'quantite': '4'}, {'ingredient_id': 'c14a2af8-f6bc-490b-9376-eb9f401d70db', 'quantite': ''}, {'ingredient_id': 'd5e67657-af31-451c-a540-04544bc71200', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (167844, 'Tarte pomme-banane à la cannelle', 'pâte feuilletée, pomme, banane, oeuf, farine, amandes en poudre, vanille, sucre, cannelle', '15 min', ['Étalez la pâte feuilletée sur un moule à tarte.Piquez légèrement le fond avec une cuillère.Versez la cannelle sur la pâte.', '  Couper en rondelles la pomme et la banane.disposez-les harmonieusement sur la pâte feuilletée selon votre convenance.', '  Dans un bol,mélanger bien le sucre,les œufs,la poudre d''amande,la farine et l''essence de vanille.', '  Versez cette préparation sur les fruits.', '  Mettre au four 15 min à 180°.'], ['Louche', 'Moule à tarte'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Tarte pomme-banane à la cannelle', 'facile', 'bon marché', 'amandes en poudre', 'oeuf', 'plat', 'tarte à la banane', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'vanille', 'dessert', 'plat de résistance', 'pâte feuilletée', 'pomme', 'cannelle', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:35:00.326749', [{'ingredient_id': '081eb6ec-529c-43c2-9dc6-fe5301ea13d2', 'quantite': '1'}, {'ingredient_id': '982a3df9-e475-434b-b63f-2e50041fefbe', 'quantite': '1'}, {'ingredient_id': '1d25fa80-56a2-4fb4-a8b9-61d9951b90b4', 'quantite': '1'}, {'ingredient_id': '23cbe000-74b2-48a7-b189-0596b3bbc82b', 'quantite': '2'}, {'ingredient_id': '018308ec-8528-4ee9-9ad2-270d1fbe2e74', 'quantite': '1 cuillères'}, {'ingredient_id': '5af6097d-1691-4891-9365-fda58e9c4a2a', 'quantite': '1 cuillères'}, {'ingredient_id': '0ad9b819-49cf-4f78-90c6-450b9ca9505a', 'quantite': '2 cuillères'}, {'ingredient_id': 'b1da4504-c922-4f03-9d26-bae84a120532', 'quantite': '2 cuillères'}, {'ingredient_id': '3d0e6564-bba2-4262-b21f-ecd301f65957', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (41392, 'Gâteau léger et moelleux à la banane', 'banane, oeuf, sucre, farine, maïzena, levure chimique, bicarbonate, fromage blanc, huile, chocolat, rhum', '10 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Ecraser les bananes avec le sucre, et ajouter les oeufs entiers et le fromage blanc. Bien mélanger.', 'Ajouter progressivement les poudres préalablement mélangées (farine, maïzena, levure, bicarbonate).', 'Ajouter l''huile délicatement, puis le rhum et enfin les pépites.', 'Verser la préparation dans un moule à cake puis enfourner pour 45 min.'], ['Presse-agrumes', 'Louche', 'Balance de cuisine', 'Râpe'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'levure chimique', 'chocolat', 'très facile', 'maïzena', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'farine', 'fromage blanc', 'dessert', 'plat de résistance', 'gâteau à la banane', 'Gâteau léger et moelleux à la banane', 'sucre', 'cocktail', 'bicarbonate'], 'Dessert', c765e63b-a321-4f7c-9863-7d5d2a953d29, '2025-09-26T15:35:07.980550', [{'ingredient_id': '0c3d745b-be1e-43b9-b294-043b0e95f5cb', 'quantite': '2'}, {'ingredient_id': '1a9d955d-8c42-4f6d-8b5c-6545c70d6797', 'quantite': '2'}, {'ingredient_id': '96acfbb4-4936-4cb7-8021-77e50851e30e', 'quantite': '150 g'}, {'ingredient_id': '60409d43-a658-4cf5-bf71-03aa44396f55', 'quantite': '120 g'}, {'ingredient_id': '54fc9cb2-3f70-44de-8fac-f32ab7ec995b', 'quantite': '40 g'}, {'ingredient_id': '46ef1a49-1b66-4445-be61-6c6e538f4a11', 'quantite': '1 cuillères'}, {'ingredient_id': '4060978e-5246-416e-bd52-8356a295bb22', 'quantite': '1'}, {'ingredient_id': '5c520913-d548-4875-bb7c-f43ea5b567f5', 'quantite': '1'}, {'ingredient_id': 'd857f363-bc77-40d2-8ce0-c75b99824c12', 'quantite': '2 cuillères'}, {'ingredient_id': '57472ab8-ca70-4344-ab65-7409bb61f68b', 'quantite': '50 g'}, {'ingredient_id': '6d2ed0a1-1518-44c2-b1f7-dfd6562dde52', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (17046, 'Mousse banane chocolat', 'banane, crème liquide, chocolat en poudre', '5 min', ['Peler la banane, puis la couper en morceaux dans un bol.', 'Ajouter la crême liquide et le chocolat en poudre. Écraser et mélanger le tout.', 'Passer au four micro-onde 1 mn. Manger frais.'], ['Pince de cuisine', 'Ouvre-boîte', 'Rouleau à pâtisserie', 'Passoire'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'mousse au chocolat', 'rapide', 'plat', 'recette', 'Mousse banane chocolat', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'dessert', 'plat de résistance', 'chocolat en poudre', 'cocktail'], 'Dessert', 0f1c2582-3303-44f7-bc5f-c2fbcc0aa3da, '2025-09-26T15:35:11.552561', [{'ingredient_id': '772fcbdd-d3e6-4e0c-8b48-20979156bcd3', 'quantite': '1'}, {'ingredient_id': '024249ea-07af-486b-bafe-a554319ee6ad', 'quantite': '50 ml'}, {'ingredient_id': '2a1f4ee2-5f75-488a-9582-16500c6167d5', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (35292, 'Diplomate au caramel salé de tatie lolo', 'biscuits à la cuillère, poire, banane, Confiture de prune, amandes en poudre, jus de citron, sucre en poudre, lait, farine, jaune d''oeuf, beurre, beurre tendre, crème fleurette, sucre semoule', '60 min', ['Commencez par préparer le caramel : ', 'Mettre le sucre dans une cocotte anti-adhésive à hauts bords avec 1 cuillère à soupe d''eau, et mettre sur feu vif. Parallèlement, mettre à bouillir le beurre et la crème dans une seconde casserole. De façon simultanée, il faut que la crème bout lorsque le caramel est doré (mais pas trop foncé), enlever les deux casseroles du feu et verser la crème par dessus le caramel en fouettant vivement. Prenez vos précautions, le caramel va bouillir et tripler de volume pendant quelques secondes. Encore chaud, versez votre caramel dans un pot de confiture vide, et gardez de côté. ', 'Faire la crème pâtissière : ', 'Dans une casserole, mélanger les jaunes d''oeuf avec la farine au fouet à main. Puis ajouter le lait au fur et à mesure en remuant sans cesse pour éviter les petits grumeaux. Rajouter le sucre et mettre sous feu moyen. Sans cesser de remuer à la cuillère en bois, arrêter la cuisson lorsque le mélange épaissit et a une consistance crémeuse. Ajouter la noix de beurre, remuer. Laisser refroidir. ', 'Egoutter les poires (en conservant le sirop dans un bol) et les émincer assez finement. Eplucher et couper en rondelles les bananes, et les arroser d''un filet de jus de citron. ', 'Commencer le diplomate : ', 'Tremper rapidement les biscuits à la cuillère dans le sirop, et constituer une 1ère couche régulière de biscuit au fond de votre plat de présentation (saladier en verre transparent de préférence, car le résultat final des couches successives est joli à voir !). ', 'Tartiner tous les biscuits de confiture, puis mettre une couche de crème pâtissière, quelques lamelles de poires et des rondelles de bananes. Parsemez le tout de caramel salé, par petites touches ça et là, et finir par de la poudre d''amandes en pluie fine. ', 'Renouveler l''opération dans le même ordre autant de fois que vous avez d''ingrédients, en terminant par de la crème pâtissière. ', 'Mettre 24 heures au réfrigérateur. ', 'Présenter bien frais dans le plat de présentation, rehaussé de quelques feuilles de menthe en décoration. Servir dans des coupes à dessert.'], ['Presse-agrumes', 'Moule à tarte', 'Tire-bouchon'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'biscuits à la cuillère', 'poire', 'facile', 'caramel', 'amandes en poudre', 'plat', 'recette', 'cuisine', 'Confiture de prune', 'recettes', 'boisson', 'Diplomate au caramel salé de tatie lolo', 'dessert', 'plat de résistance', 'jus de citron', 'moyen', 'cocktail'], 'Dessert', 69297d9d-1a59-4225-aa7e-6ff0da85dc1e, '2025-09-26T15:35:15.194638', [{'ingredient_id': '0fbb420a-d387-40d4-9188-c5282cc57962', 'quantite': '400 g'}, {'ingredient_id': '2b0092d3-5c78-4068-975e-dffb16f44166', 'quantite': '1'}, {'ingredient_id': 'f5bd218b-f97e-40a3-9020-5b55cec6ec50', 'quantite': '2'}, {'ingredient_id': 'e1aae1c2-b8d5-475d-b3f3-66382ed2c62a', 'quantite': '1'}, {'ingredient_id': '437ac802-67e6-4b69-87f1-d991e0ffcba3', 'quantite': '125 g'}, {'ingredient_id': 'da8084d1-758c-421b-803a-118509e449bc', 'quantite': '1'}, {'ingredient_id': '51ee2f81-bbbc-43dc-adeb-c09ca1e07d19', 'quantite': '140 g'}, {'ingredient_id': 'f943675f-fdb7-443b-b34f-d51d1c7ad952', 'quantite': '1 l'}, {'ingredient_id': 'f305b21e-fb73-4a2b-8906-6ba1576ef305', 'quantite': '100 g'}, {'ingredient_id': 'b6f1bcae-11f7-4e15-ac52-6606e25a8dc8', 'quantite': '6'}, {'ingredient_id': '9c69c2b8-e043-4258-bf0d-d36c2e8c954c', 'quantite': '1'}, {'ingredient_id': 'e3fbb790-d5b3-4018-b90a-f244e3d77e4a', 'quantite': '125 g'}, {'ingredient_id': '4b3560fd-d093-4eae-93ed-e1b12a0dd9d0', 'quantite': '75 ml'}, {'ingredient_id': '0c539a6b-15b5-4b88-837e-5e95b490e488', 'quantite': '300 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (58403, 'papillotes aux bananes et aux fraises', 'banane, fraises, pâte à tartiner, lavande', '10 min', ['Découper 6 carrés de papiers d''aluminium de 20 cm de côté pour les papillotes.', 'Découper les bananes et les fraises en rondelles.', 'Mettre une petite quantité de rondelles de bananes et de fraises par papillote.', 'Ajouter de la pâte à tartiner à votre convenance.', 'Puis mettre quelques graines de lavande (sèches ou fraîches).', 'Fermer les papillotes et les mettre sur le barbecue à la fin du repas, le temps de cuisson variera selon la consistance du plat que vous voulez, c''est à dire plus ou moins fondant.', 'Déguster à la petite cuillère.'], ['Spatule', 'Batteur électrique'], ['', 'lavande', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'papillotes aux bananes et aux fraises', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cocktail', 'pâte à tartiner'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:35:20.008814', [{'ingredient_id': 'b26abf63-178a-47d3-be35-75eae27b9d49', 'quantite': '4'}, {'ingredient_id': 'ef62a142-9746-43c2-816b-26848a650bd1', 'quantite': '500 g'}, {'ingredient_id': '5fdff0e1-2205-4390-83c9-d1e691aca624', 'quantite': ''}, {'ingredient_id': '9c67ed80-ddec-46b6-9a6f-a24d2cebf827', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (337331, 'Mon Colombo de Poisson', 'poisson, queue, poudre de colombo, gingembre, cive, aubergine, banane plantain, oignon rouge, ail, citron vert, piment, piment fort, huile d''olive, lait de coco, sel, poivre', '30 min', ['Faire mariner le poisson coupé en dés de 2 cm dans la moitié du Colombo, 1 oignon émincé, 3 gousses d''ail, 1 verre d''eau quelques heures ou mieux depuis la veille.', 'Faire griller les aubergines : les laver, sécher et couper longitudinalement en tranches d''1 cm d''épaisseur, dans le lèche frite, saler et ajouter un peu d''huile d''olive.', 'Mettre au four à 200°C (thermostat 6/7) pendant 20 min, retourner à mi cuisson, réserver.', '3Dans une cocotte ou sauteuse mettre le 2e oignon émincé à revenir dans un peu d''huile quand il commence à blondir ajouter la part solide de la marinade dont vous aurez retiré et essuyé  les morceaux de poisson.', 'Laisser blondir environ 5 min puis ajouter le liquide de la marinade (eau oignon, ail, colombo) ajouter le gingembre, le reste du colombo, la banane plantain coupée en rondelles d''1 cm. ', 'Ajouter du sel et du poivre.', 'Laisser cuire à feu doux 30 min en surveillant qu''il reste toujours du liquide, ajouter de l’eau si besoin.', 'Ajouter les aubergines grillées, le piment fort (attention de ne pas le percer, je m''en passe et propose du tabasco ou du piment frais à table) laisser cuire encore 20 min.', 'Ajouter le lait de coco, les morceaux de poisson laisser cuire 15 min, à mi cuisson ajouter les piments végétariens, les queues crevettes.', 'Juste avant de servir rectifier l’assaisonnement (sel, poivre), arroser du jus de citron.', 'Servir avec du riz 3 parfums ou Basmati'], ['Casserole', 'Pince de cuisine', 'Tire-bouchon', 'Mixeur', 'Ouvre-boîte'], ['', 'aubergine', 'gingembre', 'lait de coco', 'entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'cocktail', 'facile', 'ail', 'plat', 'recette', 'piment', 'cuisine', 'piment fort', 'oignon rouge', 'recettes', 'boisson', 'poisson', 'huile d''olive', 'dessert', 'Mon Colombo de Poisson', 'plat de résistance', 'queue', 'banane plantain', 'moyen', 'cive', 'citron vert', 'poivre', 'poudre de colombo'], 'Plat principal', cef85041-53f5-47f0-b462-5d07f561f793, '2025-09-26T15:35:24.598351', [{'ingredient_id': '0329783e-fd8c-4a32-a81b-eb125d19e994', 'quantite': '1 kg'}, {'ingredient_id': 'de4ebfb5-95af-496f-9794-4a123bd1eaea', 'quantite': '12'}, {'ingredient_id': '43f5d60f-2899-45aa-9ef8-59b007e4d3e6', 'quantite': '100 g'}, {'ingredient_id': '151f3697-5376-4768-8d64-aeb84b675e82', 'quantite': '1 cuillères'}, {'ingredient_id': '284edbde-ca3a-4f07-94a3-ce5d7a73cdf1', 'quantite': '1'}, {'ingredient_id': 'df0d550f-ef1b-4aea-8ba7-179a0bbee023', 'quantite': '2'}, {'ingredient_id': '03dfba4b-11fe-4b05-9a1c-4f6a55122947', 'quantite': '1'}, {'ingredient_id': '23d3ad42-bfde-4e82-b4a2-aab5b50da432', 'quantite': '2'}, {'ingredient_id': 'ccbd7b2d-4238-469b-9d73-d49b668595a9', 'quantite': '3'}, {'ingredient_id': 'ed7afa79-8f4b-467c-a0a4-b652d4b93540', 'quantite': '2'}, {'ingredient_id': 'ead8aa74-2d60-4b14-8973-7c7f6e29fea0', 'quantite': '4'}, {'ingredient_id': 'bc5e3086-5b67-46c4-97c4-980ad084faa1', 'quantite': '1'}, {'ingredient_id': 'd20ad8e7-1b78-48ec-8cd5-dfcd80a4c2b1', 'quantite': '1 cuillères'}, {'ingredient_id': 'd316f713-95be-495c-b91f-6581116b3d71', 'quantite': '20 cl'}, {'ingredient_id': '6e1317fa-5be7-4666-afdd-39b73676b4ab', 'quantite': '1'}, {'ingredient_id': '7ee05e6a-7678-42d2-8a3b-27456aa42579', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (18384, 'Coupes Fraîcheur', 'pomme, nectarine, orange, banane, fraises, raisin, groseilles, menthe, crème, crème chantilly', '45 min', ['Laver les fruits et les couper en petits morceaux. Les mélanger pour en faire une salade, en gardant seulement de côté les groseilles et la menthe.', 'Mettre au fond de chaque coupe deux boules de crème glacée.', 'Puis ajouter trois ou quatre cuillères à soupe de salade de fruits.', 'Garnir avec de la chantilly, une feuille de menthe et quelques groseilles.'], ['Presse-agrumes', 'Planche à découper', 'Rouleau à pâtisserie'], ['', 'raisin', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'nectarine', 'menthe', 'bon marché', 'rapide', 'plat', 'fraises', 'crème', 'recette', 'cuisine', 'recettes', 'boisson', 'crème chantilly', 'groseilles', 'Coupes Fraîcheur', 'dessert', 'plat de résistance', 'pomme', 'orange', 'cocktail'], 'Dessert', 624e4c9e-3fc4-4b8a-aab4-1854297018d3, '2025-09-26T15:35:28.990403', [{'ingredient_id': '23224047-c32a-4894-b83a-d0d511c91931', 'quantite': '2'}, {'ingredient_id': '5dc9434e-b603-4a72-b2cf-3c10a37c7678', 'quantite': '3'}, {'ingredient_id': '51dd0e98-d6ce-4bda-beed-cf3d032b6c9d', 'quantite': '2'}, {'ingredient_id': '482dafc2-fa30-4c00-82c8-127e695a6aa5', 'quantite': '2'}, {'ingredient_id': '6e2f1989-0791-43b3-aa84-92caa891b23a', 'quantite': '250 g'}, {'ingredient_id': 'df8966c0-1257-42b1-9d09-66fcd7a6a5db', 'quantite': '1'}, {'ingredient_id': '71c0e728-bdc4-42fa-a954-0c75ff053718', 'quantite': ''}, {'ingredient_id': '41b87192-2b60-4387-9bd8-0e9c0d3a4d63', 'quantite': ''}, {'ingredient_id': '8c9d1d64-7005-4d04-bd57-bd9ad212c7f8', 'quantite': '1 l'}, {'ingredient_id': 'a36f512b-a9d5-4303-a21a-0807aa5c9c92', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (51347, 'Crème à la banane facile', 'lait, maïzena, sucre, arôme vanille, oeuf, banane', '10 min', ['Couper la banane en rondelles et repartir celles-ci dans le fond du plat.', 'Mélanger les 2 oeufs avec la maïzena dans une casserole. Un fois le mélange bien homogène, ajouter le lait, le sucre et la vanille.', 'Mettre sur le feu et ne pas cesser de remuer jusqu''à ébullition, le mélange doit être bien onctueux; retirer du feu et verser la préparation sur les bananes.', 'Laisser tiédir avant de mettre au frigo pour que ce soit bien frais.'], ['Presse-agrumes', 'Casserole', 'Tire-bouchon', 'Louche', 'Ouvre-boîte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'maïzena', 'bon marché', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'arôme vanille', 'Crème à la banane facile', 'sucre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:35:32.552582', [{'ingredient_id': '78ff7225-57f1-4f70-a30c-138aa6a2118b', 'quantite': ''}, {'ingredient_id': '2c8f7e5b-cfd8-4eda-8c9e-770f9d3cfcb1', 'quantite': '4 cuillères'}, {'ingredient_id': 'be50c73b-f40c-4f3c-b368-65e6de36a0a7', 'quantite': '6'}, {'ingredient_id': 'ae84a803-61c4-4f9a-aeb5-ba31f40a1fa9', 'quantite': '1 cuillères'}, {'ingredient_id': '496588ac-737f-4375-9fe1-f4192997b10b', 'quantite': '2'}, {'ingredient_id': 'a50d74ae-aea0-4711-aec2-74aa633c7de9', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (17710, 'Sablé aux bananes (Haïti)', 'banane, sucre, farine, beurre, oeuf, sucre vanillé', '10 min', ['Épluchez les bananes, coupez-les en rondelles, et mettez-les dans un plat à four beurré.', 'Dans un saladier, mettez la farine, le beurre fondu, le sucre, la vanille, les oeufs. Mélangez-les bien, et mettez cette pâte sur les bananes.', 'Mettez le plat au four (thermostat 6/180°C) et faites cuire 35 mn.'], ['Louche', 'Rouleau à pâtisserie', 'Économe', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'sablés', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'beurre', 'sucre', 'cocktail', 'Sablé aux bananes (Haïti)'], 'Dessert', 4e952671-000b-4b93-b2d8-38a35286b25d, '2025-09-26T15:35:39.229502', [{'ingredient_id': 'e94594bd-123b-490f-8f48-dd6a1989ec85', 'quantite': '3'}, {'ingredient_id': '8216cdad-a02b-456a-aa44-ed3906bb6e28', 'quantite': '125 g'}, {'ingredient_id': '1fd2e2db-e1c5-4797-a1e1-763dc54d4bb9', 'quantite': '125 g'}, {'ingredient_id': 'f0c6f4cf-7745-448a-b1e8-913e8835afac', 'quantite': '125 g'}, {'ingredient_id': '33a34c09-0da1-4cf3-b12d-03e2f54b8dbd', 'quantite': '2'}, {'ingredient_id': '991f4ed1-748f-4c17-9d67-e775c6031433', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (83569, 'Soupe Akwaba', 'poireau, banane plantain, cube de bouillon, oignon, huile, poivre, eau', '20 min', ['Nettoyez les poireaux et détaillez les en rondelles. ', 'Émincez l''oignon. Pelez et coupez les bananes en rondelles. ', 'Faites chauffer le litre d''eau dans une casserole.', 'Faites chauffer l''huile d''olive puis faites-y revenir les oignons et les poireaux pendant 5 min, le tout en mélangeant.', 'Ajoutez alors les rondelles de bananes ainsi que le cube émietté et l''eau bouillante. Portez le tout à ébullition puis baissez le feu et couvrez pour laisser cuire, couvert, pendant 30 min. ', 'Une fois que les légumes sont bien tendres, mixez la soupe. Ajoutez de l''eau ou du lait en fonction de l''épaisseur désirée. Poivrez et salez selon votre goût.'], ['Fouet', 'Verre doseur'], ['entrée', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'très facile', 'bon marché', 'Soupe Akwaba', 'plat', 'recette', 'cube de bouillon', 'cuisine', 'recettes', 'oignon', 'boisson', 'huile', 'soupe', 'poireau', 'dessert', 'plat de résistance', 'banane plantain', 'poivre', 'cocktail'], 'Entrée', 590d7d51-a03a-4d85-b692-f81987b523b0, '2025-09-26T15:35:43.626596', [{'ingredient_id': 'd5d96505-0756-407b-a812-b4218c17232b', 'quantite': '300 g'}, {'ingredient_id': '4debbb7c-fe44-4ca2-b7e4-4bc9fd4d280c', 'quantite': '300 g'}, {'ingredient_id': 'c96fded9-4dfb-42fd-a29f-69bf0706b338', 'quantite': '1'}, {'ingredient_id': '2023dfcd-245b-44c8-bba5-0d3748c28bda', 'quantite': '1'}, {'ingredient_id': '4fb0d63d-5ae6-4a67-82c9-872100ae784c', 'quantite': '1 cuillères'}, {'ingredient_id': 'adbb27f1-6f02-4d18-ad35-2f4053e88670', 'quantite': ''}, {'ingredient_id': '875b58c1-ead9-4e36-ad78-9767addd1a84', 'quantite': '1 l'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (39781, 'tarte tatin banane noix de coco', 'pâte feuilletée, banane, citron, sucre, rhum, cannelle, noix de coco', '20 min', ['Préchauffer votre four à 180°C (Thermostat 6).', 'Faire chauffer le sucre avec le jus d''1/2 citron afin d''obtenir un caramel (ne pas le laisser trop brunir).', 'Peler et couper les bananes en deux puis les recouper dans le sens de la longueur. Les arroser avec le jus d''1/2 citron.', 'Dans un moule à manquer, verser le caramel. Disposer les quartiers de bananes sur le caramel. Arroser de rhum, soupoudrer de cannelle et mettre la noix de coco.', 'Disposer la pâte feuilleté dessus en repliant le bord à l''intérieur.', 'Mettre au four 25 min et démouler 5 min après la sortie du four.'], ['Fouet', 'Râpe', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'tarte Tatin', 'dessert', 'plat de résistance', 'pâte feuilletée', 'citron', 'tarte tatin banane noix de coco', 'cannelle', 'sucre', 'noix de coco', 'cocktail'], 'Dessert', 6942256e-fc5d-4a30-905a-727a67af7aaa, '2025-09-26T15:35:47.191089', [{'ingredient_id': '4425ee99-6a40-4649-afcf-971732a6cc7e', 'quantite': '1'}, {'ingredient_id': 'e5b01a82-3220-434e-aa2a-bbc4ad044726', 'quantite': '4'}, {'ingredient_id': '410d25ff-4bf7-4d4a-b3e6-b3aa2f0f942d', 'quantite': ''}, {'ingredient_id': '07e82897-0d6b-4a4f-9aaf-337861de5efb', 'quantite': '100 g'}, {'ingredient_id': 'de89961e-26d6-4d13-b0e8-72b5bf32e30e', 'quantite': '2 cuillères'}, {'ingredient_id': 'b8f04634-15fc-45bf-a254-45480e8cb166', 'quantite': '2'}, {'ingredient_id': 'a9ebdefa-d284-4a39-9c1c-b6af32fb2f02', 'quantite': '60 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (26916, 'Milk-shake light à la banane', 'banane, lait, glaçons, édulcorant, extrait de vanille liquide', '3 min', ['Couper les bananes en rondelles, les mettre dans le mixeur, ajouter le verre de lait, l''extrait de vanille et 2 cuillères à soupe d''édulcorant, ainsi que les glaçons.', 'Mixer 2 mn et boire immédiatement.'], ['Tire-bouchon', 'Pince de cuisine', 'Balance de cuisine', 'Louche'], ['', 'entrée', 'banane', 'recettes de cuisine', 'extrait de vanille liquide', 'confiserie', 'testées', 'Milk-shake light à la banane', 'très facile', 'bon marché', 'rapide', 'plat', 'édulcorant', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'glaçons', 'lait', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:35:50.654106', [{'ingredient_id': 'e96340dc-16ab-4e16-9f08-b4bdef0a22d0', 'quantite': '1'}, {'ingredient_id': '84dcc2dc-d96d-470a-b364-ea9606e91a39', 'quantite': '20 cl'}, {'ingredient_id': 'cffc0d19-fa86-4c61-a909-779b5aea752c', 'quantite': '3'}, {'ingredient_id': '508a5f0b-d764-41d4-af9a-92930a60d66c', 'quantite': ''}, {'ingredient_id': 'c6a7f8a0-e116-4b12-9be6-e45613ab9868', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (85136, 'gourmandises miniatures', 'chocolat blanc, chocolat noir, farine, sucre, crème fraîche, lait, oeuf, levure, beurre, confiture de fraises, crème anglaise, banane, kiwi, pomme, litchi au sirop, brique, crème, lait', '30 min', ['Préparer tout d''abord le premier au chocolat noir :  faire fondre les 200 g de chocolat noir avec 80 g de beurre 2 min au micro-ondes. ', 'Ensuite ajouter 150 g de farine, 100 g de sucre, 2,5 cl de lait, 10 cl de crème, 3 œufs et le sachet de levure.', 'Battre le tout et faire cuire 5 min 30 au micro-ondes.', 'Préparer celui au chocolat blanc: même recette sauf qu''il faut utiliser le chocolat blanc.', 'Une fois les deux gâteaux refroidis, mettre une bonne couche de confiture de fraise sur celui au chocolat noir et le recouvrir avec celui au chocolat blanc.', 'Pour la crème catalane : verser la préparation mélangée au lait dans des petites verrines.', 'Pour la salade de fruits :', 'Couper en petits morceaux le kiwi, la banane, la pomme, les litchis et les faire imbiber dans le sirop de la boîte de litchi mélangée avec le jus d''orange.', 'Pour la présentation :', 'Dans l''assiette, poser un petit carré du gâteau, avec une petite verrine de crème anglaise, un ramequin dans lequel il y a de la salade de fruits et la petite verrine de crème catalane.'], ['Moule à tarte', 'Rouleau à pâtisserie', 'Louche', 'Ouvre-boîte', 'Couteau de chef'], ['', 'entrée', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'facile', 'rapide', 'oeuf', 'plat', 'recette', 'gourmandises miniatures', 'confiture de fraises', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'chocolat noir', 'moyen', 'beurre', 'chocolat blanc', 'sucre', 'lait', 'cocktail', 'crème anglaise'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:35:55.042744', [{'ingredient_id': '578f1e1e-665f-4b7c-a6c6-75843add4e3e', 'quantite': '200 g'}, {'ingredient_id': '95e2460c-6d35-4f39-b891-3a06f98450ee', 'quantite': '200 g'}, {'ingredient_id': '03d6cc54-aa23-48cc-a2fa-00ac2218f7b7', 'quantite': '300 g'}, {'ingredient_id': '589337fc-4d23-481a-8aed-6b767ee91fe6', 'quantite': '200 g'}, {'ingredient_id': '64d17f0d-3ca4-4e19-9a2a-2ee09750328e', 'quantite': '20 cl'}, {'ingredient_id': '6fe08aef-3b4b-486f-9b60-4f441a42e48a', 'quantite': '5 cl'}, {'ingredient_id': '92e1d7c4-5f8b-43bc-8218-927a241ec733', 'quantite': '6'}, {'ingredient_id': 'b92850d0-ddde-426a-b113-5b8e9d0ebb3c', 'quantite': '2'}, {'ingredient_id': 'bdf6db1d-4489-4119-af99-11e2154b879a', 'quantite': '160 g'}, {'ingredient_id': '4ef1a5cd-fbaa-4a71-a9a9-d017a5ece129', 'quantite': '1'}, {'ingredient_id': '3de3a413-63a9-4936-aed6-bf61636fcb89', 'quantite': '50 ml'}, {'ingredient_id': 'abba4430-d815-4b09-8411-11851730fcb4', 'quantite': '1'}, {'ingredient_id': 'ab40e57d-0d55-4c1a-b15e-0695ab2d19fc', 'quantite': '1'}, {'ingredient_id': '77082c61-56cf-4ce3-9d10-bd1a03e86e61', 'quantite': '1'}, {'ingredient_id': '6f6882bc-19fc-4eb3-b089-f63e66057539', 'quantite': '1'}, {'ingredient_id': 'd7ce27a9-9e6f-4cb9-85b5-6e5ca340002b', 'quantite': '1'}, {'ingredient_id': 'cd514b28-9873-4546-82b3-a47e897e3bbd', 'quantite': '1'}, {'ingredient_id': 'f1d35f14-6a74-441b-bf8e-d7e1caa28998', 'quantite': '75 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (175138, 'Smoothie aux myrtilles', 'myrtilles, banane, cerises, chocolat noir', '0 min', ['Râpez très finement le chocolat.', 'Gardez-en une moitié pour la garniture et mettez l''autre dans le mixeur.', 'Pelez la banane et coupez-la en morceaux.', 'Mettez dans le mixeur ; ajoutez les myrtilles et le nectar à la cerise et mixez de manière à obtenir une pâte homogène.', 'Versez dans un verre. Saupoudrez avec le reste de chocolat et mélangez avant de servir.'], ['Presse-agrumes', 'Couteau de chef', 'Balance de cuisine', 'Poêle'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'myrtilles', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat noir', 'smoothies', 'cocktail', 'cerises', 'Smoothie aux myrtilles'], 'Boisson', 3e511ec7-bbcf-4ad6-8fc8-0d3829fdfc22, '2025-09-26T15:35:58.550739', [{'ingredient_id': 'd34b0b21-3661-473d-94e0-dad46ed8b7da', 'quantite': '100 g'}, {'ingredient_id': '7b96ae06-ddcd-41f5-9904-c38da064648c', 'quantite': '1'}, {'ingredient_id': 'fac95cef-a45a-4004-b45e-e643a91eda31', 'quantite': '10 cl'}, {'ingredient_id': '98de2a4c-7772-4929-bea8-a239ea0890b9', 'quantite': '10 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (57152, 'Muffin myrtilles banane sans oeuf', 'beurre, banane, sucre, farine, levure, vanille, sel, lait, myrtilles', '10 min', ['Faire fondre le beurre.', 'Ecraser la banane dans un saladier, ajouter le beurre et bien mélanger.', 'Ajouter tous les ingrédients un par un sauf les myrtilles.', 'Bien mélanger pour faire une pâte assez épaisse.', 'Ajouter les myrtilles et mélanger rapidement.', 'Verser dans les alvéoles de la plaque à muffin.', 'Faire cuire 12 à 15 minutes au four à 180°C (thermostat 6).'], ['Pince de cuisine', 'Balance de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'myrtilles', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'vanille', 'Muffin myrtilles banane sans oeuf', 'dessert', 'plat de résistance', 'muffin', 'beurre', 'sucre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:36:02.397819', [{'ingredient_id': 'c312da72-7ff9-4472-ba20-65749c62b677', 'quantite': '30 g'}, {'ingredient_id': 'c33de4dc-619f-4405-ac5b-9bb8bca377cd', 'quantite': '1'}, {'ingredient_id': 'a61c7531-892e-4978-881f-852271ecbb1d', 'quantite': '100 g'}, {'ingredient_id': '33b60767-b049-4261-836a-3c58435352ca', 'quantite': '100 g'}, {'ingredient_id': '7777e2e7-6b63-43cd-bd2c-cf08a2fba8ef', 'quantite': ''}, {'ingredient_id': '49a1c935-dcd1-4a91-9c11-214f5b2250a6', 'quantite': ''}, {'ingredient_id': '5cbbf135-63f0-4c26-bbca-dd18d48c7fbf', 'quantite': '1'}, {'ingredient_id': '9668512b-d03a-4766-868f-c327580c798a', 'quantite': '5 cl'}, {'ingredient_id': 'ed988d6d-07d4-4e64-ac0d-0165684719a2', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (40764, 'Confiture bananes kiwis', 'banane, kiwi, kiwi, pomme, pruneau, sucre', '20 min', ['Dans un saladier :', 'Couper les pruneaux en petits morceaux, les bananes en rondelles, les kiwis en petits dés, ainsi que la pomme.', 'Ajouter le sucre spécial confiture, bien mélanger, et laisser macérer au frigo, pendant une douzaine d''heures.', 'La macération terminée, mixer les fruits, et mettre le mélange  obtenu, dans une grande sauteuse sur feu vif.', 'Faire cuire, en remuant souvent, pendant une dizaine de minutes.', 'Pendant ce temps, préparer vos pots de confiture (ils doivent être parfaitement propre, pour éviter les moisissures).', 'Une fois les dix minutes écoulées, remplir les deux pots, bien fermer, et les retourner (attention aux risques de brûlure).', 'Une fois les pots refroidis, les replacer à l''endroit, et les conserver dans un endroit frais et propre.'], ['Spatule', 'Casserole', 'Mixeur'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'Confiture bananes kiwis', 'confiserie', 'testées', 'pruneau', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'sucre', 'cocktail'], 'Confiserie', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:36:05.973057', [{'ingredient_id': '220a55a9-1ae9-4787-8940-d30e3a472b65', 'quantite': '2'}, {'ingredient_id': '4d25b3bd-f0ac-4d20-877b-ae92a3527f5e', 'quantite': '2'}, {'ingredient_id': '004999d1-b211-4d7e-b737-7dc3a8f08b3f', 'quantite': '1'}, {'ingredient_id': 'a58e2a56-ffdd-4a17-bcb3-9d596cf47c5f', 'quantite': '1'}, {'ingredient_id': '8ea1a465-37cb-44ac-ac5e-65e123011fb1', 'quantite': '5'}, {'ingredient_id': '258ca3a7-0504-40c2-abb7-384ee0f5a11f', 'quantite': '150 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (83943, 'Verrine Nutella banane speculoos', 'Nutella, spéculoos, banane', '5 min', ['Déposer le Nutella dans le fond de la verrine. Couper la banane en rondelles et la disposer au dessus du chocolat.', 'Ecraser un spéculoos et disperser les miettes au dessus des rondelles de banane.'], ['Mixeur', 'Batteur électrique'], ['Verrine Nutella banane speculoos', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'spéculoos', 'cuisine', 'recettes', 'speculoos', 'boisson', 'Nutella', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', 7bf33814-1665-4daf-9dde-a7995b95476a, '2025-09-26T15:36:10.641273', [{'ingredient_id': '5953dbf1-0e30-41e6-8412-915dabbb8797', 'quantite': '3 cuillères'}, {'ingredient_id': '0039f7b7-abd5-403d-9537-8624450e0765', 'quantite': '1'}, {'ingredient_id': 'cefceb64-96f1-4f37-a6ca-9b1207f54bb4', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (21655, 'Gâteau au yaourt citron - pomme - banane', 'crème, farine, levure, sucre roux, oeuf, huile, pomme, banane', '15 min', ['Mélanger le yaourt avec les oeufs, le sucre et l''huile. Puis ajoutez à cette préparation la farine ainsi que la levure, bien mélanger pour obtenir une pâte homogène. ', 'Pelez les pommes et les couper en dés. ', 'Coupez les bananes en rondelles pas trop épaisses. ', 'Ajoutez les fruits à la pâte à gâteau. ', 'Beurrez légèrement un moule à manqué. ', 'Versez-y la préparation et mettre au four préchauffé à 200°C pendant 20-25 mn (tout dépend de votre four). ', 'Voila, bon appétit !'], ['Râpe', 'Verre doseur', 'Mixeur', 'Ouvre-boîte'], ['entrée', 'banane', 'recettes de cuisine', 'Gâteau au yaourt citron - pomme - banane', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'crème', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'huile', 'farine', 'dessert', 'plat de résistance', 'pomme', 'gâteau à la banane', 'cocktail', 'sucre roux'], 'Dessert', 31824519-17fc-46c3-95d2-21cfd9214bcd, '2025-09-26T15:36:14.313651', [{'ingredient_id': '69c2e59f-0f68-4409-bc99-899e80f3f502', 'quantite': '1'}, {'ingredient_id': '4d65d29a-804f-46cc-b9eb-a4a7779f90cd', 'quantite': '3'}, {'ingredient_id': 'edc6d1fa-d343-4a82-97be-91342538bfb4', 'quantite': ''}, {'ingredient_id': '7436059c-a975-4f07-ba20-6031b8a96119', 'quantite': '1'}, {'ingredient_id': '55b86fff-ef58-4448-bc2b-9ea27445f811', 'quantite': '3'}, {'ingredient_id': 'eb7149c7-ec4e-4b14-ab44-779be6dcb86b', 'quantite': ''}, {'ingredient_id': 'a2374fbc-c129-4231-953b-bcf7a0451a71', 'quantite': '1'}, {'ingredient_id': '2988b881-dc64-403a-8359-96aad4c8f693', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (314041, 'Cocktail Exotic fruits', 'banane, fruit de la passion, citron, sucre', '10 min', ['Mixer les fruits de la passion.', 'Couper les bananes en rondelles puis les mixer.', 'Ensuite, presser les citrons.', 'Mélanger les bananes, les fruit de la passions, les citrons et le sucre.', 'Mettre au réfrigérateur, secouer et déguster.'], ['Casserole', 'Tire-bouchon', 'Spatule', 'Économe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'Cocktail Exotic fruits', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'fruit de la passion', 'dessert', 'plat de résistance', 'citron', 'sucre', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:36:18.921273', [{'ingredient_id': '791238cd-e872-4424-b1ce-578519aebea3', 'quantite': '2'}, {'ingredient_id': '53c235d2-359f-4897-9ff2-d8fac951e318', 'quantite': '3'}, {'ingredient_id': '562fef41-284c-4679-930d-9fcf14ef15cc', 'quantite': '2'}, {'ingredient_id': 'beda27e3-d8ee-4508-8eb0-db0a5cd10c83', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (65050, 'Recette de fruits de Nico', 'orange, banane, pomme, kiwi, thé, eau, calvados, sucre', '15 min', ['Eplucher les fruits et les couper en morceaux.', 'Faire bouillir l''eau, faire infuser le thé.', 'Ajouter le sucre puis le calvados dans l''eau.', 'Mettre les fruits dans le sirop.'], ['Verre doseur', 'Rouleau à pâtisserie'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'très facile', 'bon marché', 'Recette de fruits de Nico', 'thé', 'rapide', 'plat', 'calvados', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'orange', 'sucre', 'cocktail'], 'Entrée', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:36:23.387708', [{'ingredient_id': '5af645e0-08d3-4d69-a218-6f41ae75ef93', 'quantite': '3'}, {'ingredient_id': 'a9e043f0-6a22-483e-a956-48db5c45c6eb', 'quantite': '2'}, {'ingredient_id': '8ad06d34-9807-4b09-8efa-c39276335ad2', 'quantite': '3'}, {'ingredient_id': '17ebd265-4918-4f14-8636-4f7e5ae295a8', 'quantite': '3'}, {'ingredient_id': '84023ca5-e9cb-4500-b6a4-f646dfe7b9cc', 'quantite': '1'}, {'ingredient_id': '1dd63d34-db4d-44ec-b92a-44363b3eec0d', 'quantite': '50 cl'}, {'ingredient_id': '01a5f49e-3c73-4d5d-b083-7f7a84160c3d', 'quantite': '8 cl'}, {'ingredient_id': 'dfc69c7d-32ca-40b7-9a39-745733f987ab', 'quantite': '250 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (42660, 'Croque-monsieur à la banane façon café parisien', 'pain de mie, edam, yaourt nature, oeuf, banane, jambon, poivre, sel, beurre', '10 min', ['Préchauffez votre four à 180°C (thermostat 6), ou utilisez un grille-pain.', 'Beurrez tendrement les 4 tranches de pain de mie, sur un seul côté. Et retournez-les.', 'Mélangez dans un bol, le yaourt avec l''oeuf, et assaisonnez cette sauce à votre goût.', 'Revenez à vos tranches de pain de mie, pour disposer sur la face non beurrée, dans l''ordre : ', '- une tranche de jambon', '- la sauce à base de yaourt (à tartiner, mais ne pas en abuser, parce que cela peut couler à la cuisson)', '- les bananes coupées en rondelles', '- autant de tranches de fromage que vous voulez', 'Recouvrez par une tranche de pain, côté beurré au dessus.', 'Enfournez 10 à 15 min au four, 5 min dans un grille-pain bien chaud, et servez sur une table conviviale.'], ['Poêle', 'Passoire'], ['entrée', 'banane', 'recettes de cuisine', 'jambon', 'sel', 'confiserie', 'testées', 'yaourt nature', 'cocktail', 'très facile', 'bon marché', 'edam', 'rapide', 'oeuf', 'plat', 'recette', 'croque-monsieur', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'poivre', 'Croque-monsieur à la banane façon café parisien', 'pain de mie'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:36:26.938339', [{'ingredient_id': '57c4eb9b-e1e7-4807-8f37-2004a41f5731', 'quantite': '4'}, {'ingredient_id': '5f418219-6f96-4486-a2a3-d0f8f41f2aff', 'quantite': ''}, {'ingredient_id': '169c47c9-5c85-4a66-8d7a-1574b1c61c52', 'quantite': '1'}, {'ingredient_id': '83c03a53-6114-4ffc-9da5-8324bfa33793', 'quantite': '1'}, {'ingredient_id': '30474f27-82d5-4f98-bf72-c6da2cefab80', 'quantite': '1'}, {'ingredient_id': 'a71055c3-c9e2-433e-9d49-06611a8f37ef', 'quantite': '2'}, {'ingredient_id': '17f8ca87-188f-4b61-8775-b7c31fda5e83', 'quantite': ''}, {'ingredient_id': 'fc5c6bc1-e8d8-4145-b263-aafbe88274b1', 'quantite': ''}, {'ingredient_id': '1a128111-d884-42a1-9699-09011abde181', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (18404, 'Cake à la banane et au chocolat', 'beurre doux, sucre, oeuf, farine, extrait de vanille, bicarbonate, lait, banane, levure, sucre glace, beurre, cacao', '10 min', ['Préchauffer le four à 375 °F (= 190 ° C)', 'Battre le beurre, le sucre, les oeufs et la vanille jusqu’à ce que le mélange soit léger et mousseux. ', 'Dissoudre le bicarbonate de soude dans le yogourt (ou le lait sur). Ajouter ce mélange à la préparation précédente et bien mélanger.', 'Ajouter les bananes, alternativement, avec la farine, et mélanger, sans trop. ', 'Verser la préparation dans un moule rectangulaire beurré et fariné. Enfourner et cuire four à 350 °F pendant 45 à 50 minutes.', 'Le cake est cuit lorsque la lame d’un couteau en ressort propre et sèche.', 'Laisser reposer 10 mn avant de démouler. '], ['Presse-agrumes', 'Louche', 'Casserole', 'Poêle'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'extrait de vanille', 'très facile', 'bon marché', 'cacao', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'Cake à la banane et au chocolat', 'boisson', 'farine', 'autres cakes', 'dessert', 'plat de résistance', 'beurre', 'beurre doux', 'sucre glace', 'sucre', 'lait', 'cocktail', 'bicarbonate'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:36:30.485955', [{'ingredient_id': '5c4d3787-8701-4d4b-973b-c9ea13e3c675', 'quantite': ''}, {'ingredient_id': 'b75daf4c-c737-40f2-931a-6ce62accf15e', 'quantite': '1'}, {'ingredient_id': '294a20af-75d2-4f19-8b7d-234f86557bff', 'quantite': '2'}, {'ingredient_id': '0b1b9453-7eda-4626-9257-6434b92b8963', 'quantite': '1'}, {'ingredient_id': 'b3b924b5-f742-48ff-89a6-56413e579db9', 'quantite': '1 cuillères'}, {'ingredient_id': 'f0066c69-77ce-4d16-8302-3566d06b1525', 'quantite': '1 cuillères'}, {'ingredient_id': 'b149f5d9-f047-4a83-805c-ef18bc686841', 'quantite': ''}, {'ingredient_id': '217c543c-3caf-4e72-a8dd-a9c0abbf2883', 'quantite': '1'}, {'ingredient_id': 'aa0a6a72-b736-44af-9c25-4cc1208ac543', 'quantite': '1 cuillères'}, {'ingredient_id': '1d988e54-b957-4fd5-b864-c70f608c50f7', 'quantite': '1'}, {'ingredient_id': 'ad9f3712-d0a6-4355-94d9-20b1afe11700', 'quantite': '1 cuillères'}, {'ingredient_id': '4cf9bf0d-d7e3-4dc3-a578-3f7bff873821', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (20337, 'Thon à la banane et à l''ananas', 'thon rouge, ananas, piment vert, banane, citron vert, huile de noix, poivre', '25 min', ['Couper le demi-ananas en deux. Couper le quart d''ananas en petits dés. ', 'Couper le piment vert en tous petits dés. Mélanger les petits dés d''ananas avec les dés de piment vert et les baies roses. Ce mélange constituera la garniture appelée "Salsa de fruits". ', 'Couper l''autre quart d''ananas en gros dés. Pour obtenir la sauce, mixer les gros dés d''ananas avec la 1/2 banane, le jus de citron vert, ajouter 3 cuillères à soupe d''huile de noix, du sel et du poivre du moulin. ', 'Mettre de l''huile dans une poêle et cuire les pavés de thon salés et poivrés, 2 min de chaque côté. ', 'Servir les pavés de thon nappés de la sauce et décorés de la "salsa de fruits".'], ['Tire-bouchon', 'Râpe', 'Fouet'], ['', 'Thon à la banane et à l''ananas', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'thon rouge', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'huile de noix', 'dessert', 'plat de résistance', 'moyen', 'piment vert', 'ananas', 'citron vert', 'poivre', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:36:35.482873', [{'ingredient_id': 'ae3cf1bd-e074-4b4e-880c-13a29c8362b4', 'quantite': '4'}, {'ingredient_id': 'b2cd4b03-9070-4d1f-866a-71111ab8bb4b', 'quantite': ''}, {'ingredient_id': 'e36df34c-b414-4a19-b8f9-6878d132ef5c', 'quantite': '1'}, {'ingredient_id': '44ae6ba8-baf8-4f5a-bf20-59d093894c6e', 'quantite': ''}, {'ingredient_id': '8f40f9cd-749b-4e90-ace5-964bd2c831dd', 'quantite': ''}, {'ingredient_id': '6e4542a8-41cf-4bd7-aeb7-e433214bec24', 'quantite': ''}, {'ingredient_id': 'c08926c1-2e31-4a84-a420-e5e9cbc77aed', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (312180, 'Cake aux spéculoos et à la banane', 'oeuf, farine, sucre, levure, beurre, banane, spéculoos, chocolat', '25 min', ['Faire préchauffer le four à 200°C (thermostat 6).', 'Casser les œufs et les mélanger avec le sucre, y ajouter le beurre fondu.', 'Mélanger le 1/2 sachet de levure à la farine.', 'Ajouter la farine + levure à la préparation (œuf, sucre et beurre fondu). Bien mélanger.', 'Prélever 3 cuillères à soupe de cette pâte et la mettre de côté.', 'Couper les bananes en tranches moyennes et les mélanger à la pâte. Y incorporer 40 g de pépites de chocolat.', 'Bien mélanger et mettre cette pâte dans un moule rectangulaire.', 'Émietter 100 g de spéculoos. Mettre les miettes dans le restant de la pâte mise de côté.', 'Cela donne une pâte très sèche mais écraser la pâte avec les spéculoos.', 'Poser ce mélange sur la pâte déjà dans le moule.', 'Aplatir et lissez l''ensemble. ', 'Faire cuire 20 min.', 'Laisser refroidir, démouler.'], ['Passoire', 'Ouvre-boîte', 'Râpe', 'Spatule', 'Casserole'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'spéculoos', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'autres cakes', 'dessert', 'plat de résistance', 'beurre', 'Cake aux spéculoos et à la banane', 'sucre', 'cocktail'], 'Dessert', c06e3101-a8c8-4ffc-940e-2ca308246b93, '2025-09-26T15:36:39.076026', [{'ingredient_id': 'fe097a66-878b-4c4b-b369-d8ff0ecb75ef', 'quantite': '2'}, {'ingredient_id': '7ac4f4bd-24ff-4135-8bd8-633e3dd4eeb8', 'quantite': '140 g'}, {'ingredient_id': 'd118e05b-3a59-4e41-b806-cf8647f71c77', 'quantite': '80 g'}, {'ingredient_id': 'b33896cf-cbbf-49c8-83c1-393eb0b17523', 'quantite': ''}, {'ingredient_id': '6e631b5a-3db4-494c-87b8-c6babdffbb05', 'quantite': '100 g'}, {'ingredient_id': '83cdda78-aed5-4e24-9573-48508e37c889', 'quantite': '3'}, {'ingredient_id': '664249fc-ba2b-4e9f-9ca5-f33cc38eb01e', 'quantite': '100 g'}, {'ingredient_id': '27d78a63-5f19-4bf2-9217-8f3c55a5b72f', 'quantite': '40 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (345664, 'Smoothie bicolore avec morceaux de fruits', 'kiwi, ananas, banane, nectarine, myrtilles, framboises', '10 min', ['Éplucher le kiwi et le découper en fines rondelles. Réserver.', 'Éplucher les fruits et les couper en morceaux. ', 'Dans un blender, mixer l''ananas, la banane et des glaçons. Réserver la préparation.', 'Rincer le blender puis mixer les framboises, les myrtilles et la nectarine avec des glaçons. ', 'Dans un verre, verser le premier jus jusque mi-hauteur, coller des rondelles de kiwi sur tout le tour à l''intérieur du verre puis verser la seconde préparation pour remplir le verre.', 'Boire bien frais.'], ['Tire-bouchon', 'Râpe', 'Casserole', 'Économe', 'Spatule'], ['entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'nectarine', 'framboises', 'bon marché', 'rapide', 'plat', 'myrtilles', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'Smoothie bicolore avec morceaux de fruits', 'plat de résistance', 'ananas', 'smoothies', 'cocktail'], 'Boisson', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T15:36:42.606754', [{'ingredient_id': '5ab3f57c-3237-4d6f-b30d-047841c56878', 'quantite': '1'}, {'ingredient_id': '48220d5b-629f-4f93-8565-c905ce5a5d76', 'quantite': '1'}, {'ingredient_id': '7299553a-d3b7-45e1-a429-79fe868e1728', 'quantite': '1'}, {'ingredient_id': 'c912bf8c-458b-4ab2-b875-c3a9b4ac0317', 'quantite': '1'}, {'ingredient_id': '8b8656ae-73e5-4272-84d2-d03b28bc250b', 'quantite': '100 g'}, {'ingredient_id': '0f6d8392-55d5-4240-a782-ade8ce957912', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (41431, 'fondant de banane au chèvre', 'banane, chèvre, échalote, lardons, estragon, crème fraîche, poivre, sel', '15 min', ['Ciseler les échalotes et couper en rondelles assez épaisse les bananes. ', 'Disposer le tout dans quatre assiettes. ', 'Ajouter les lardons, une tranche de chèvre, l''estragon, et un filet de crème fraîche. ', 'Saler, poivrer, et enfourner dans un four chaud 20 à 30 min à 180°C (thermostat 6).', 'Bon appétit !'], ['Pince de cuisine', 'Mixeur', 'Fouet', 'Planche à découper'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'sel', 'confiserie', 'testées', 'fondant de banane au chèvre', 'très facile', 'lardons', 'bon marché', 'chèvre', 'plat', 'recette', 'cuisine', 'recettes', 'estragon', 'boisson', 'dessert', 'plat de résistance', 'poivre', 'cocktail', 'échalote'], 'Entrée', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:36:46.257082', [{'ingredient_id': 'e50dfad8-83f9-4fba-80ed-9679ee0b12d0', 'quantite': '4'}, {'ingredient_id': '6e3671fe-5dd8-4862-b970-eac828181215', 'quantite': '4'}, {'ingredient_id': 'f2374129-902a-49e5-84fe-6311509e569c', 'quantite': '2'}, {'ingredient_id': '6196cd99-7d02-4925-97c7-ac172953e520', 'quantite': '150 g'}, {'ingredient_id': '8d3554ce-4770-4144-a46c-56ff165bb3c7', 'quantite': ''}, {'ingredient_id': '959449db-8c1a-4786-a4fb-b7ac64e14a24', 'quantite': ''}, {'ingredient_id': '8adea0f1-95ce-40c6-9a4f-fe2ceb0b28ea', 'quantite': ''}, {'ingredient_id': 'ac4020e7-3d92-4077-8a37-07ce35f030d0', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (42579, 'Gâteau aux bananes mixées (pour écouler des bananes trop mûres!)', 'banane, jus d''orange, sucre, sucre vanillé, cannelle, farine, levure chimique, oeuf', '10 min', ['Mixer les bananes et le jus d''orange. ', 'Ajouter le sucre, le sucre vanillé, la pincée de cannelle, les oeufs, la farine tamisée et la levure.', 'Verser dans un petit moule beurré, et enfourner à 180°C (thermostat 6), pendant 20 à 30 min.'], ['Casserole', 'Pince de cuisine', 'Ouvre-boîte', 'Passoire', 'Tire-bouchon'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'Gâteau aux bananes mixées (pour écouler des bananes trop mûres!)', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'jus d''orange', 'cannelle', 'sucre', 'cocktail'], 'Dessert', 07344df9-f185-4d01-98e5-80f3d0f98074, '2025-09-26T15:36:52.132632', [{'ingredient_id': 'c4f66a95-1b1f-49a5-860d-f7fa2baf9d29', 'quantite': '3'}, {'ingredient_id': 'b79967ae-18a7-466b-9da7-2196c88349a0', 'quantite': '1'}, {'ingredient_id': '13e70ba5-a134-4a91-b2e2-ccb01955f404', 'quantite': '80 g'}, {'ingredient_id': 'dfb02cbf-4c16-48f9-85cc-886cc85c8db1', 'quantite': '1'}, {'ingredient_id': 'd900cea7-1da1-4035-82a5-3567628d5b6e', 'quantite': '1'}, {'ingredient_id': '846f760c-ce30-40ba-82c1-42333eadba1d', 'quantite': '100 g'}, {'ingredient_id': 'cbe264b3-1e33-4501-ab12-322531e62677', 'quantite': ''}, {'ingredient_id': '914efb40-a89a-4f77-80b3-d09a71be8d66', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (195058, 'Bananes flambées de Sofia', 'banane, vergeoise, amandes, glace vanille, crème fraîche, sucre vanillé, rhum, beurre salé', '30 min', ['Dans un premier temps, fouettez la crème fraîche pour qu’elle double de volume. Ajoutez ensuite le sucre vanillé et fouettez pour qu’elle devienne onctueuse.', 'Épluchez et coupez les bananes en tronçons assez larges.', 'Faites fondre le beurre dans une poêle puis ajoutez les bananes et saupoudrez de vergeoise. Laissez-les légèrement caraméliser.', 'Faites chauffer le rhum 30 secondes au micro-ondes. Arrosez les bananes et flambez-les.', 'Dressez dans des assiettes creuses ou dans des bols : 2 boules de glace à la vanille, ajoutez les bananes, surmontez d’un dôme de crème fouettée, parsemez d’amandes effilées et pour finir, arrosez avec le jus qui s’est formé dans la poêle avec les bananes.', 'Servez sans attendre.'], ['Fouet', 'Verre doseur', 'Pince de cuisine', 'Balance de cuisine'], ['', 'amandes', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'rhum', 'confiserie', 'Bananes flambées de Sofia', 'testées', 'facile', 'beurre salé', 'bon marché', 'vergeoise', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'glace vanille', 'dessert', 'plat de résistance', 'sucre vanillé', 'cocktail'], 'Dessert', 72521eb2-0ede-47e0-b1f0-3cec08551aa8, '2025-09-26T15:36:55.912205', [{'ingredient_id': '9999543e-3d48-410e-8897-4859249a51fe', 'quantite': '4'}, {'ingredient_id': '03459b19-0712-40e7-8fff-0db0b7cc705b', 'quantite': '2 cuillères'}, {'ingredient_id': '37916008-64d2-4fc1-b39a-730caefff78f', 'quantite': '2 cuillères'}, {'ingredient_id': '5bcdc3f3-dff1-4b70-b618-051bfc3a0412', 'quantite': '8'}, {'ingredient_id': 'a9e1c614-891c-4898-ae31-f2ca0c858d1b', 'quantite': '1'}, {'ingredient_id': '734901b0-1b28-4525-ad19-d7d8756ae6df', 'quantite': '3'}, {'ingredient_id': '2024fbdd-9f63-4e36-8d4e-7ea607b0e169', 'quantite': '20 cl'}, {'ingredient_id': '86e574a7-0312-449b-bed5-b9fd20994267', 'quantite': '30 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (48584, 'Délicieux cake à la banane et aux noix du Dr Girafe', 'beurre tendre, sucre roux, oeuf, vanille, bicarbonate, yaourt brassé, farine complète, farine, sel, banane, noix de grenoble', '15 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Mélanger le beurre et le sucre roux. ', 'Ajouter les œufs et la vanille, la consistance doit être légère et homogène.', 'Mélanger le yaourt avec le bicarbonate de soude, et mélanger le tout à la préparation précédente.', 'Ajouter les farines, les bananes écrasées et les noix.', 'Verser dans un moule à cake beurré et fariné, et enfourner pendant 50 min à 180°C (thermostat 6); la lame du couteau doit ressortir propre.'], ['Pince de cuisine', 'Poêle', 'Rouleau à pâtisserie', 'Râpe'], ['entrée', 'banane', 'recettes de cuisine', 'yaourt brassé', 'sel', 'confiserie', 'testées', 'beurre tendre', 'très facile', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Délicieux cake à la banane et aux noix du Dr Girafe', 'farine', 'vanille', 'autres cakes', 'dessert', 'plat de résistance', 'moyen', 'farine complète', 'noix de grenoble', 'cocktail', 'sucre roux', 'bicarbonate'], 'Dessert', 27e5c5b7-50ce-4ce8-8f7e-5a9a4f5f4a6b, '2025-09-26T15:36:59.651777', [{'ingredient_id': '24dd7f43-0280-4144-98f1-30af63a0a5f4', 'quantite': '115 g'}, {'ingredient_id': '19310523-064b-4947-b7c9-2a7e049ea4a1', 'quantite': '240 g'}, {'ingredient_id': 'bacbf80f-274a-42ff-a1c3-4e51c75e34a2', 'quantite': '3'}, {'ingredient_id': '4f359796-52ba-4cae-bb09-e290b6fda6f2', 'quantite': '1 cuillères'}, {'ingredient_id': '975013a4-7f5c-4cb0-a4ac-49aa213e6096', 'quantite': '1 cuillères'}, {'ingredient_id': '69f71b5f-cad0-4b3f-ad7d-34bc2723b117', 'quantite': '45 g'}, {'ingredient_id': '179a38e5-f70d-4d55-875d-c6345b6cffc4', 'quantite': '75 g'}, {'ingredient_id': '580c489d-fb52-42fe-bbd1-407cdfad0227', 'quantite': '75 g'}, {'ingredient_id': '90cc5d31-e400-4de7-bece-c7d75e1b219d', 'quantite': '1'}, {'ingredient_id': '70293fee-3efd-41f9-85df-02645e8fa6e0', 'quantite': '2'}, {'ingredient_id': 'cf8eecfa-7c9e-45fe-8d5d-3ea1231907cc', 'quantite': '125 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (30679, 'délice des îles chocolaté', 'banane, pêche, ananas, chocolat de couverture, sucre, beurre', '10 min', ['Faire fondre le chocolat au bain-marie. ', 'Dès que celui ci est fondu y incorporer le sucre et le beurre. ', 'Coupez les bananes en rondelles, les pêches en quartiers et l''ananas en morceaux. ', 'Disposez la salade de fruits fraichement préparé dans une jarre. ', 'Versez délicatement au dessus le chocolat. ', 'Laisser posez 10 mn et mettre au frigidaire jusqu''à dégustation'], ['Verre doseur', 'Casserole', 'Batteur électrique', 'Râpe', 'Louche'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'assez cher', 'très facile', 'rapide', 'plat', 'chocolat de couverture', 'recette', 'cuisine', 'recettes', 'boisson', 'délice des îles chocolaté', 'dessert', 'plat de résistance', 'beurre', 'ananas', 'pêche', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:37:04.778771', [{'ingredient_id': '9057e451-d9f7-4e5b-84e6-803e372605b1', 'quantite': ''}, {'ingredient_id': 'e74ad85d-8265-4398-935b-c346264a80db', 'quantite': ''}, {'ingredient_id': '425347f4-dd08-49c7-b60b-875c1fffdacf', 'quantite': ''}, {'ingredient_id': 'f24f8f2e-46bb-4dbe-9596-f8e52337c4c4', 'quantite': '200 g'}, {'ingredient_id': 'ef134ef5-4cf7-4d9e-bfa9-de3d51fe54cb', 'quantite': '50 g'}, {'ingredient_id': '8483f6de-1595-4cec-a628-0c6b27ec10c6', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (13195, 'Crumble à la banane', 'farine, beurre tendre, cassonade, sucre, banane, pomme, citron, pistaches, sel', '10 min', ['Préchauffez le four à 180°C.', 'Dans un saladier, mélangez la farine, la cassonade, et une pincée de sel. Incorporez-y du bout des doigts 120 g de beurre mou sans trop pétrir la pâte, afin d''obtenir un sable grossier. Ajoutez un peu de farine si nécessaire.', 'Pelez, épépinez les pommes et détaillez chacune en 16 quartiers. Epluchez les bananes et coupez-les en rondelles. Arrosez-les du jus de citron.', 'Faites fondre 30g de beurre dans une poêle et faites-y revenir les pommes 3 à 4 minutes en les retournant. Poudrez-les de sucre et laissez légèrement caraméliser.', 'Beurrez 4 petits ramequins. Etalez-y les pommes puis les rondelles de bananes. Couvrez avec de la pâte et saupoudrez de pistaches concassées.', 'Enfournez pour 15 mn. En fin de cuisson, faites dorer 2 min. sous le gril.', 'Servez tiède ou froid avec de la glace à la vanille.'], ['Batteur électrique', 'Pince de cuisine', 'Ouvre-boîte', 'Râpe', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'crumble banane', 'testées', 'beurre tendre', 'cassonade', 'facile', 'bon marché', 'plat', 'pistaches', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'Crumble à la banane', 'dessert', 'plat de résistance', 'pomme', 'citron', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:37:11.592353', [{'ingredient_id': 'ca561185-b625-43e6-b921-8d0411e5a0d9', 'quantite': '125 g'}, {'ingredient_id': '5687057d-8dc3-4708-b427-baa9d9631df4', 'quantite': '180 g'}, {'ingredient_id': 'e707b7cd-e8ad-4ff4-b706-ea73c8b720eb', 'quantite': '60 g'}, {'ingredient_id': '535d4e72-ec2d-477e-b5ee-b8d24a43cfbc', 'quantite': '30 g'}, {'ingredient_id': 'f7fecf01-26ab-4a92-a587-9dc5ae89c5ec', 'quantite': '3'}, {'ingredient_id': '015e1a4c-447e-4ec4-a0cc-c4c692d529ae', 'quantite': '2'}, {'ingredient_id': '665af892-5906-407a-9abd-79144924902d', 'quantite': ''}, {'ingredient_id': '507c3761-dc34-444b-97a4-b70914661463', 'quantite': '4 cuillères'}, {'ingredient_id': '89294789-267d-4378-9a05-d60acf76d256', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (25519, 'Salade de fruits au champagne', 'banane, cerises, fraises, raisin, abricot, pomme, poire, orange, sucre en poudre, champagne', '30 min', ['Éplucher les bananes, les abricots, la pomme, la poire et l''orange. Épépiner et dénoyauter les fruits. Couper les fruits en morceaux, à l''exception des cerises et des raisins.', 'Faire fondre le sucre dans le champagne. En arroser les fruits rassemblés dans un saladier.', 'Laisser mariner pendant 4 h au réfrigérateur.', 'Servir bien glacer dans des coupes.'], ['Moule à tarte', 'Tire-bouchon'], ['', 'raisin', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'assez cher', 'abricot', 'poire', 'facile', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'Salade de fruits au champagne', 'orange', 'cocktail', 'cerises'], 'Dessert', 91073c31-788a-41a3-a644-461064f47299, '2025-09-26T15:37:15.241893', [{'ingredient_id': 'cd0da903-abd4-4bff-980b-9933c28b5943', 'quantite': '2'}, {'ingredient_id': 'e0c62f46-efaa-45c7-a034-27b4faa56858', 'quantite': '200 g'}, {'ingredient_id': '00722ff4-c138-4d3b-b214-68a40dc60f24', 'quantite': '200 g'}, {'ingredient_id': '98d64092-2e17-45e8-9d3b-e8002aeecd01', 'quantite': '200 g'}, {'ingredient_id': 'e3059e4a-2906-4150-a282-679e11cc54be', 'quantite': '2'}, {'ingredient_id': '6fa2bcc4-2ce9-4a58-bfc5-3318cf54e542', 'quantite': '1'}, {'ingredient_id': 'df1007e1-1d53-4e7e-b1de-f59c6f3779e2', 'quantite': '1'}, {'ingredient_id': '3b61fb9d-fe32-47f0-b7cd-b2be2aee6edf', 'quantite': '1'}, {'ingredient_id': '1076af3a-4434-4b25-a2b8-05f2926d5b42', 'quantite': '200 g'}, {'ingredient_id': '0cf267f5-8e0a-49d1-845d-38e5db325238', 'quantite': '75 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (53123, 'Bananes en papillotes', 'banane, vanille, cassonade, rhum, chocolat, raisins secs, jus d''orange, alcool pour fruits, sucre vanillé', '15 min', ['Mettre dans une casserole les raisins secs, recouvrir avec l’alcool de fruit et le jus d’orange et le sucre vanillé. ', 'Porter à ébullition, puis laisser mijoter pendant 20 à 30 min pour que les raisins secs gonflent avec l’alcool et prennent le goût de l’orange.', 'Prendre les gousses de vanille, les couper en deux; écraser les 2 carrés de chocolat, et préparer 4 feuilles de papier aluminium.', 'Prendre une banane, (sans les peler!), faire une entaille sur le dessus (dans la peau) et incorporer la moitié de la gousse de vanille, une cuillère à soupe de cassonade et la moitié d’un carré de chocolat écrasé.', 'Arroser d’une cuillère à soupe de rhum.', 'Disposer la banane dans une feuille de papier alu et disposer quelques raisins par dessus.', 'Répéter l’opération pour les 3 autres bananes  ', 'Faire cuire 35 min à 180°C (th 6), et servir chaud avec de la glace vanille.'], ['Couteau de chef', 'Verre doseur'], ['', 'Bananes en papillotes', 'banane', 'entrée', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'cassonade', 'chocolat', 'alcool pour fruits', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'vanille', 'dessert', 'plat de résistance', 'sucre vanillé', 'raisins secs', 'jus d''orange', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:37:18.872197', [{'ingredient_id': 'a36ed867-930e-46c9-9957-1cd77e107287', 'quantite': '4'}, {'ingredient_id': '9ac7771e-0191-4292-8fbd-8556b39d2865', 'quantite': '2'}, {'ingredient_id': 'b3e645fd-3b92-41b9-9571-c0fa75175841', 'quantite': '4 cuillères'}, {'ingredient_id': '6e9efeda-100c-4842-bb74-f31c8e708d55', 'quantite': '4 cuillères'}, {'ingredient_id': 'e6a48d89-8915-4ada-b34f-59694fe334ac', 'quantite': '2'}, {'ingredient_id': '253a2984-b51e-4849-987d-45fdc88f4ec6', 'quantite': '10'}, {'ingredient_id': '86549f01-66c4-437e-9cbc-c50c41b7463b', 'quantite': ''}, {'ingredient_id': '089b2d1c-4a9f-4d19-af7b-aa76db42a0e4', 'quantite': ''}, {'ingredient_id': '524c98b6-9fc7-4e5d-9939-fa9fd0dc3039', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (23077, 'Piña colada', 'lait de coco, jus d''ananas, jus de banane, rhum, extrait de vanille, cannelle, muscade', '15 min', ['Ustensiles : 1 blender ou à défaut un mixer', 'La veille verser les jus d''ananas et de banane ainsi que le rhum dans un grand saladier, rajouter la vanille, le bâton de cannelle et le râpé de noix de muscade, le tout étant bien sûr facultatif mais après quelques essais je la trouve meilleure ainsi. ', 'Mélanger le tout puis passer au blender avec le lait de coco, mettez ensuite le saladier au frigo jusqu''à environ 10 mn de l''apéro. ', 'Au moment de servir verser dans le blender à travers une passoire afin de récuperer la cannelle (pas forcément agréable sous la dent) puis faites mousser avant de remplir les verres sans avoir oublié le lit de glace pilée et enfin déguster. ', 'Alors bien sûr comme c''est frais le rhum ne se sent pas de suite mais il est bien présent, vous pouvez donc diminuer ou même enlever le rhum, ce serra toujours aussi bon et les enfants pourront en profiter.'], ['Verre doseur', 'Presse-agrumes', 'Moule à tarte'], ['lait de coco', 'entrée', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'Piña colada', 'extrait de vanille', 'muscade', 'facile', 'rapide', 'plat', 'jus de banane', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'jus d''ananas', 'moyen', 'cannelle', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:37:24.644284', [{'ingredient_id': '0597e29d-8a5c-4e56-b6e3-1a9d7f87957d', 'quantite': '400 ml'}, {'ingredient_id': '1453b189-873d-4d47-9d54-20798d0f9fdb', 'quantite': '1 l'}, {'ingredient_id': '0655f46a-ee14-4bdf-b0cf-83a9cc89d090', 'quantite': ''}, {'ingredient_id': 'c0c8bbd9-cbbe-4b91-8ef7-4237f5cc1bac', 'quantite': '25 cl'}, {'ingredient_id': '887449ec-b01d-4e42-97e9-3cf6c5effd6c', 'quantite': '2 cuillères'}, {'ingredient_id': 'e50734cb-bec3-47f0-9e0e-a595cdb5f759', 'quantite': '1'}, {'ingredient_id': '9ada52a6-8291-43bf-b623-5f8646a0ebf2', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (73383, 'Gâteau au fromage banana split', 'noix de coco, noix de pécan, sucre, beurre, fromage blanc, sucre, oeuf, vanille, banane, purée, nappage chocolat, cacao', '30 min', ['- Pour la croûte:', 'Fondre le beurre dans une casserole.', 'Mélanger dans une jatte les flocons de noix de coco, les noix de pécan et le sucre.', 'Rajouter le beurre fondu, mélanger.', 'Verser le mélange dans un moule à charnière de 23 cm.', 'Réfrigérer 5 min, puis faire cuire 7 min dans un four préchauffé à 180°, thermostat 6.', 'Laisser refroidir.', '- Pour le remplissage:', 'Battre au fouet électrique le fromage et le sucre en crème.', 'Ajouter les oeufs, tout en battant, un à un.', 'Ajouter la vanille.', 'Partager cette masse en 3 partie égales.', 'Ajouter la banane dans l''une, les fraises dans l''autre, le cacao et le chocolat fondu dans la dernière.', 'Verser la préparation au chocolat sur la croûte, faire cuire 25 min.', 'Verser soigneusement la préparation aux bananes par dessus le chocolat et cuire encore 25 min.', 'Ajouter enfin la préparation aux fraises et faire cuire 30 min.', 'Transférer sur une grille et laisser refroidir à température ambiante.', 'Réfrigérer 8 h ou toute une nuit.'], ['Pince de cuisine', 'Économe'], ['entrée', 'recettes de cuisine', 'confiserie', 'testées', 'banana split', 'noix de pécan', 'facile', 'Gâteau au fromage banana split', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'beurre', 'noix de coco', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:37:28.308665', [{'ingredient_id': '0379235a-be9e-48c7-8a31-84160c969698', 'quantite': '100 g'}, {'ingredient_id': 'c7156f19-39ec-459a-9ab5-95dfac5aa805', 'quantite': '135 g'}, {'ingredient_id': '1cbd9d19-b4fe-4bbb-b498-5b4cef63fb22', 'quantite': '70 g'}, {'ingredient_id': '33f9571a-9a4d-4d7c-a993-05af4ca245ee', 'quantite': '50 g'}, {'ingredient_id': 'db814347-973a-4b60-9417-f212e5d39443', 'quantite': '675 g'}, {'ingredient_id': 'a3bf6304-ec7a-4a19-8cca-9c8487656eda', 'quantite': '200 g'}, {'ingredient_id': 'c6fdfe36-cc2f-4189-802a-84b9aa812a20', 'quantite': '3'}, {'ingredient_id': '3f9b0662-2dcf-4bc0-a448-7199b2b134a0', 'quantite': '5 ml'}, {'ingredient_id': '2cc6d81d-1ca1-4b18-8a37-48a034b0ab04', 'quantite': '12.5 cl'}, {'ingredient_id': '3e7f20a3-fc7e-48ee-b0c2-57fe66518ae4', 'quantite': '12.5 cl'}, {'ingredient_id': 'ba4af56d-69d1-4387-8450-e2440d80941a', 'quantite': '60 g'}, {'ingredient_id': '6e6d82b1-a8fc-4991-970b-5886ea66590f', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (392353, 'California Dream', 'fraises, banane, jus d''oranges, kiwis, yaourt nature', '0 min', ['Réalisez la recette "California Dream" directement dans le verre.', 'Peler les kiwis et les bananes et les couper en morceaux. Placer tous les ingrédients dans le bol d’un blender avec des glaçons et mixer jusqu’à onctuosité. Verser dans les verres.', 'Servir dans un verre de type "old fashioned".'], ['Pince de cuisine', 'Mixeur', 'Planche à découper', 'Casserole', 'Balance de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'yaourt nature', 'facile', 'kiwis', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'California Dream', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'jus d''oranges', 'cocktail'], 'Boisson', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T15:37:34.061524', [{'ingredient_id': '079176f6-479f-47b0-994d-c77383bfb0a6', 'quantite': '6'}, {'ingredient_id': '9cd5f5d7-976d-4677-8274-842d89fb7ae3', 'quantite': '1'}, {'ingredient_id': '8130c563-86b5-4f00-a0d6-28c09ce76614', 'quantite': '15 cl'}, {'ingredient_id': 'db674d4c-aa3d-4bd9-aa0d-24e40589b3c8', 'quantite': '1'}, {'ingredient_id': 'f17c5512-0a2d-49cb-a15d-ee7f8e907d90', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (321121, 'Banocake', 'Digestive, banane, Philadelphia, sucre, extrait de vanille, confiture de lait', '20 min', ['Écraser les biscuits à l''aide d''un rouleau à pâtisserie pour obtenir une poudre. Mixer les bananes puis les mélanger à la poudre de biscuits. ', 'On obtient une pâte collante qui est étalée au fond d''un moule recouvert de papier sulfurisé.', 'Dans un saladier, mélanger la fromage, le sucre et l''extrait de vanille au batteur. ', 'Ajouter un à un les oeufs en mélangeant bien à chaque fois (on peut aussi monter les blancs en neige pour avoir un gâteau plus aéré).', 'Verser la confiture de lait sur la pâte de biscuit puis le mélange.', 'Mettre au four à 180°C 20 à 30 min. ', 'Laisser reposer au réfrigérateur quelques heures.'], ['Louche', 'Mixeur', 'Presse-agrumes', 'Couteau de chef', 'Casserole'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'extrait de vanille', 'facile', 'bon marché', 'plat', 'Philadelphia', 'recette', 'cuisine', 'recettes', 'boisson', 'confiture de lait', 'Digestive', 'dessert', 'plat de résistance', 'Banocake', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:37:37.809742', [{'ingredient_id': 'ad3b5ead-5078-449b-a6d1-595542ce4e61', 'quantite': '200 g'}, {'ingredient_id': '8bc7b10c-e3a6-4993-8db0-6f7c6b71ab1d', 'quantite': '2'}, {'ingredient_id': '94d85e8f-1bb5-4de4-8f49-329c1b3b8568', 'quantite': '500 g'}, {'ingredient_id': '7efbecb7-a4f4-4a9e-9e82-175ab071fafa', 'quantite': '75 g'}, {'ingredient_id': 'd73782ee-12c5-4bea-ae16-151c9ae61bb6', 'quantite': '1 cuillères'}, {'ingredient_id': 'cd901380-1620-4b56-a00a-6f2373337918', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (55920, 'Baguettes chaudes nutella bananes', 'banane, Nutella, baguette', '10 min', ['Allummer votre four à 170°C (thermostat 5-6).', 'Couper les bananes en rondelles ou en lamelles dans le sens de la longueur selon vos goûts.', 'Couper les baguettes en deux puis en long, tartiner de nutella', 'puis ajouter les bananes sur le nutella.', 'Refermer les baguettes façon sandwich, mettre au four jusqu''à ce que le pain soit croustillant et le nutella fondant!', 'Servir chaud, c''est un régal!'], ['Fouet', 'Pince de cuisine', 'Rouleau à pâtisserie'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'Baguettes chaudes nutella bananes', 'recette', 'cuisine', 'recettes', 'boisson', 'Nutella', 'dessert', 'plat de résistance', 'baguette', 'cocktail'], 'Dessert', 586193ce-1870-46f7-8406-99614e04f334, '2025-09-26T15:37:42.848363', [{'ingredient_id': 'f2a25016-1cbc-44f0-8163-e8c4c50d9032', 'quantite': '4'}, {'ingredient_id': 'f5dd65ae-15d8-4e28-a940-8f4fc363d134', 'quantite': '1'}, {'ingredient_id': 'ec8d6352-46bf-45f8-a06a-6a26ab8612bc', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (39029, 'filet mignon de porc lard-bananes-oreillons de pêche', 'filet mignon, lard, citron, poivre, sel, paprika, oignon, persil, gruyère, crème fraîche épaisse, crème fraîche liquide, beurre, banane, pêche', '15 min', ['Couper le filet mignon de porc, en tranches de 1 cm d''épaisseur.', 'Enduire de jus de citron, assaisonner avec du poivre, du sel et du paprika. ', 'Enrouler dans une tranche de lard.', 'Faire fondre du beurre, dans un plat et couvrir le fond d''oignons,  finement hachés. Poser la viande dessus et boucher les trous, avec du persil haché.', 'Faire cuire 20 min dans un four préchauffé à 180°C (thermostat 6).', 'Puis, couvrir la viande, de petites tranches de gruyère. ', 'Arroser, avec la crème fraiche, et refaire cuire environ 30 min. ', 'Dans une poêle, faire dorer les bananes coupées en deux et les demi oreillons de pêche, dans du beurre.'], ['Spatule', 'Poêle'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche épaisse', 'sel', 'confiserie', 'testées', 'filet mignon de porc lard-bananes-oreillons de pêche', 'paprika', 'plat', 'moyenne', 'recette', 'crème fraîche liquide', 'cuisine', 'recettes', 'oignon', 'boisson', 'lard', 'dessert', 'persil', 'plat de résistance', 'filet mignon', 'moyen', 'beurre', 'citron', 'pêche', 'gruyère', 'poivre', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:37:46.580747', [{'ingredient_id': 'c8fc76d6-0ef8-4bd8-89a1-880fd6592bf2', 'quantite': '800 g'}, {'ingredient_id': '9128b3f7-6056-40b9-9f9d-8e2757d321aa', 'quantite': '10'}, {'ingredient_id': 'b97b51cc-8dba-4c2e-8ecd-8430bbbd9fb6', 'quantite': ''}, {'ingredient_id': 'a0551854-f774-447a-9f17-89f85d0d95ef', 'quantite': ''}, {'ingredient_id': '75835126-f165-4e35-944b-02a5284be2fa', 'quantite': ''}, {'ingredient_id': '6e85ccdb-4765-4379-a9df-23a7f0c0803a', 'quantite': ''}, {'ingredient_id': 'edefddfd-4ddb-4662-906a-d8e29238043e', 'quantite': '6'}, {'ingredient_id': '00089411-c1f7-4d25-92a8-5d49f48c66f4', 'quantite': '2'}, {'ingredient_id': '50e0569a-2717-4f36-9d35-db520ed6fac7', 'quantite': '100 g'}, {'ingredient_id': '5bc2a8f7-f169-47ee-80fb-fb65aa90db7a', 'quantite': '40 cl'}, {'ingredient_id': 'fc67c883-7ffa-43ca-adfa-cbfe52d5275c', 'quantite': '60 cl'}, {'ingredient_id': '017bae65-7b77-4301-8322-c1b8a00f01a3', 'quantite': ''}, {'ingredient_id': '21e7a97a-11c3-4597-a05a-6c3b34d9d346', 'quantite': '2'}, {'ingredient_id': '4d78000b-dc6c-4d3d-81c1-0fdce60b6d76', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (170773, 'Salade de fruits fraîcheur', 'melon, papaye, mangue, pêche, citron vert, banane, miel, basilic', '15 min', ['Pelez les fruits et découpez-les en dés de même taille.', 'Pressez le jus des 2 citrons verts et versez-le sur les fruits.', 'Ajoutez le miel (plus ou moins selon le sucre des fruits et votre goût).', 'Ciselez très finement le basilic, parsemez les fruits avec.', 'Réservez 1 h au réfrigérateur avant de servir.'], ['Casserole', 'Spatule', 'Mixeur', 'Économe'], ['', 'melon', 'entrée', 'banane', 'papaye', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'rapide', 'plat', 'mangue', 'basilic', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'citron vert', 'pêche', 'Salade de fruits fraîcheur', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:37:52.163413', [{'ingredient_id': '8f10e449-9b89-48cc-a5f6-0df9d041a016', 'quantite': ''}, {'ingredient_id': '9c4d9b8f-10fe-4961-9bf4-e1dafee8bb8b', 'quantite': '1'}, {'ingredient_id': '9fd78b3d-996d-4f9b-9801-e67b7859c89c', 'quantite': '1'}, {'ingredient_id': '8686e067-5e5c-47f4-ac77-049be699fc0c', 'quantite': '2'}, {'ingredient_id': '9b0e58f5-38e3-42ab-9446-7151f284333a', 'quantite': '2'}, {'ingredient_id': '33d017d4-dd8d-44da-b2ac-56a5ae87c847', 'quantite': '1'}, {'ingredient_id': '0ca10f7c-d805-433b-934e-30d2eac6a873', 'quantite': '1.5 cuillères'}, {'ingredient_id': '85a55337-0818-43a8-a9eb-be0d6f5cd201', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (531579, 'cake des îles banane rhum amandes au cook expert', 'huile d''olive, lait de coco, levure chimique, farine, amandes en poudre, sucre vanillé, banane, beurre, rhum, sucre, oeuf', '60 min', ['Mettre tous les ingrédients sauf le rhum, les bananes et les amandes dans la cuve inox munie de sa lame et lancer le programme automatique "pâte/gâteau".', 'Pendant ce temps éplucher les bananes et les écraser dans un bol.', 'Ajouter les bananes, le rhum et les amandes dans la cuve et relancer le programme "pâte/gâteau".', 'Huiler et fariner votre moule à cake : passer l''huile avec un pinceau sur toute la surface de votre moule et saupoudrer d''un peu de farine sur toute la surface. Remuer alors le moule dans tous les sens de façon à ce que la farine aille bien sur toute la surface et récupérer le surplus de farine.', 'Verser la préparation dans le moule et enfourner à 170° pendant 50 minutes (+ou- selon votre four). Vérifier la cuisson en piquant avec un couteau pointu au centre du gâteau  (il doit ressortir sec). Rectifier la cuisson si nécessaire. Laisser refroidir avant de déguster.'], ['Presse-agrumes', 'Économe', 'Batteur électrique', 'Tire-bouchon'], ['lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'cake des îles banane rhum amandes au cook expert', 'levure chimique', 'très facile', 'bon marché', 'gâteau', 'amandes en poudre', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'huile d''olive', 'dessert', 'plat de résistance', 'sucre vanillé', 'beurre', 'sucre', 'cocktail'], 'Dessert', 028ede8e-d5c8-4905-b8cc-5f1061cecc1d, '2025-09-26T15:37:58.692575', [{'ingredient_id': '9c46029c-d4db-4c68-83a9-2718e9144fdd', 'quantite': '1 cuillères'}, {'ingredient_id': '7541beb0-d4cd-4bc7-91c4-cf3f7da17729', 'quantite': '100 g'}, {'ingredient_id': 'd607cf83-26fc-4603-96b1-234b1e57102b', 'quantite': '10 g'}, {'ingredient_id': '226f8357-baf0-45ec-85a2-8336098d9094', 'quantite': '250 g'}, {'ingredient_id': '3921b517-d970-415c-8c0a-b743470f561d', 'quantite': '70 g'}, {'ingredient_id': '6ec6395e-88ad-4a15-a097-cce918128a3f', 'quantite': '1'}, {'ingredient_id': 'b1c53ba0-659a-4e0e-b232-46fd6b30699a', 'quantite': '2'}, {'ingredient_id': 'd95f5a1a-ef4a-4993-9c46-ff6270001597', 'quantite': '20 g'}, {'ingredient_id': '87490f14-9ed5-46e8-a4dc-36563221a114', 'quantite': '1 cuillères'}, {'ingredient_id': '37ae9368-1a26-4f8c-9cdb-544d884d399a', 'quantite': '150 g'}, {'ingredient_id': '951d4f32-e68c-4ca1-8374-f744f8e21204', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (85812, 'Smoothie kiwi - banane', 'kiwi, banane, glaçons', '15 min', ['Éplucher et couper les fruits en morceaux. ', 'Mixer tous les ingrédients dans un blender. ', 'Ajouter plus ou moins de glaçons pour obtenir la consistance adéquate.  ', 'Le smoothie ne doit pas être trop épais, il se boit à la paille ! Inutile de rajouter du sucre.'], ['Balance de cuisine', 'Couteau de chef', 'Presse-agrumes'], ['entrée', 'banane', 'Smoothie kiwi - banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'glaçons', 'smoothies', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:38:03.859935', [{'ingredient_id': '2374f4d2-f99e-4798-8550-c8460c5872f2', 'quantite': '6'}, {'ingredient_id': '760ae3e3-7c50-40db-80fd-96275974050c', 'quantite': '4'}, {'ingredient_id': '99ac9705-2190-46fe-9b5a-649c13d73c52', 'quantite': '10'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (73297, 'Salade de fruits estivale', 'orange, orange, banane, kiwi, fraises, cerises, pomme, melon, citron, sucre en poudre, cannelle', '20 min', ['Tout d''abord, éplucher tous les fruits.', 'Dénoyauter les cerises et épépiner le melon.', 'Couper les bananes et les kiwis en rondelles.', 'Segmenter en quartiers les oranges et couper en 2 chacun des quartiers.', 'Couper la pomme en morceaux.', 'A l''aide d''une cuillère à melon, faire des petites boules de melon.', 'Mettre tous les fruits dans un saladier.', 'Dans un bol, mélanger le jus d''une orange et celui d''un demi citron.', 'Y ajouter la cuillère à soupe de sucre et la pointe de cannelle.', 'Mélanger et incorporer dans la salade de fruits.', 'Mettre au frigo jusqu''au moment de servir.', 'Servir dans des coupelles accompagné d''une boule de glace vanille ou noix de coco ou sorbet fraise selon les goûts de vos hôtes.'], ['Ouvre-boîte', 'Verre doseur'], ['', 'melon', 'entrée', 'banane', 'kiwi', 'Salade de fruits estivale', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'rapide', 'plat', 'fraises', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'moyen', 'citron', 'orange', 'cannelle', 'cocktail', 'cerises'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:38:07.439573', [{'ingredient_id': '4dc1f6ec-e027-4bb3-9d90-e4143dc35239', 'quantite': '2'}, {'ingredient_id': '15def740-df70-4847-8a3e-264ed254f9ba', 'quantite': '1'}, {'ingredient_id': '072045c1-7a98-4583-8d3f-7cbb1bcc15f5', 'quantite': '2'}, {'ingredient_id': 'd3940489-ca5d-440b-9418-6707526c05dd', 'quantite': '3'}, {'ingredient_id': '046e527c-cce9-4aaa-9063-470dceb8eae7', 'quantite': '100 g'}, {'ingredient_id': '67380450-1983-4b72-8c1f-8be7ebf8e552', 'quantite': '100 g'}, {'ingredient_id': '84b9700c-81a8-4bcd-85b9-0bd58dc03453', 'quantite': '2'}, {'ingredient_id': 'e378f2d8-0aab-4c16-a05b-912117b450be', 'quantite': '1'}, {'ingredient_id': '2fb46572-01ab-4ca4-b83a-d7785f310bee', 'quantite': '1'}, {'ingredient_id': '3c57c143-ddad-4c84-b52c-288e5e451436', 'quantite': '1 cuillères'}, {'ingredient_id': '6d84009c-9192-44af-a6fd-35d1fbb6c11c', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (169643, 'Poulet DG', 'poulet, oignon, carotte, poivron rouge, poireau, haricots verts, tomate, curry, gingembre, banane plantain, eau, cube de bouillon, poivre, sel, riz, huile d''arachide', '30 min', ['Couper le poulet en morceaux. Détailler les carottes et les poivrons en bâtonnets de 3 à 4 cm de long et les poivrons en carrés de 2 à 3 cm de côté. Couper les tomates en morceaux et les haricots en 2.', 'Dans une cocotte en fonte, faire chauffer l''huile pour y faire dorer les morceaux de poulet sur toutes les faces, y ajouter les oignons, les faire dorer. Saler, poivrer. Retirer du feu, ajouter le curry, bien mélanger, laisser reposer le temps de préparer les légumes.', 'Dans un wok, faire sauter tous les légumes (sauf les carottes et les tomates) dans un peu d''huile.', 'Les incorporer au poulet, mouiller avec le mélanger eau + cubes de bouillon, ajouter les carottes, les tomates, le gingembre, laisser mijoter 20 minutes. Laisser le jus réduire.', 'Trancher les plantains ou bananes en biais, les faire frire dans l''huile, les incorporer 10 minutes avant de servir (le temps de cuire le riz).', 'Bon appétit !'], ['Planche à découper', 'Couteau de chef', 'Économe', 'Balance de cuisine'], ['', 'gingembre', 'poulet', 'entrée', 'huile d''arachide', 'recettes de cuisine', 'sel', 'confiserie', 'Poulet DG', 'eau', 'testées', 'carotte', 'bon marché', 'tomate', 'plat', 'moyenne', 'recette', 'cube de bouillon', 'cuisine', 'poivron rouge', 'recettes', 'oignon', 'boisson', 'poireau', 'dessert', 'plat de résistance', 'haricots verts', 'riz', 'banane plantain', 'poivre', 'curry', 'cocktail'], 'Plat principal', 374cae44-b0b8-4cbd-99b4-83b311a62ae5, '2025-09-26T15:38:11.102450', [{'ingredient_id': 'cb63c148-c4cd-4dac-b8e1-53f41d4041df', 'quantite': '1'}, {'ingredient_id': '27e8fb69-24f5-4f4b-a4a0-a9514d548a67', 'quantite': '4'}, {'ingredient_id': '7dfa970d-5c65-42df-a143-4d6fb88bca3b', 'quantite': '10'}, {'ingredient_id': '6071ccf1-90de-466e-ab09-69fb5a869447', 'quantite': '1'}, {'ingredient_id': 'd2222744-a4d0-4bec-b2dc-e64930a54601', 'quantite': '3'}, {'ingredient_id': 'cc355744-f82d-4eea-a4b3-68025e7d3963', 'quantite': '300 g'}, {'ingredient_id': '67b54f98-f8ba-4bb6-a11d-46350e8794f0', 'quantite': '4'}, {'ingredient_id': '5e6651fd-6c33-41f0-9d1e-89ee1d36b774', 'quantite': '3 cuillères'}, {'ingredient_id': '4d580b0a-062a-405e-a853-f93f337626a4', 'quantite': '60 g'}, {'ingredient_id': '66a909d0-04b0-4a5a-9432-f93b72ee2361', 'quantite': '6'}, {'ingredient_id': '94c56629-d909-4d0b-ab60-7cd16cf77ef5', 'quantite': '30 cl'}, {'ingredient_id': '105cb391-67d1-463b-9b60-0c1a7bf572db', 'quantite': '2'}, {'ingredient_id': '9fa81e09-086c-4d40-b290-8210c06bca2b', 'quantite': ''}, {'ingredient_id': '586d2ae0-bc6a-4865-8845-ac9edc879d7b', 'quantite': ''}, {'ingredient_id': '194deb29-4cdb-4ebf-a0dc-e12bab94394e', 'quantite': '400 g'}, {'ingredient_id': 'd41f5f8c-4ec8-44f0-8076-b2798458ec2d', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (533394, 'Gâteau à la Banane sans Oeufs et sans Lactose', 'margarine, sucre roux, levure chimique, farine, sucre vanillé, miel liquide, banane, cannelle', '10 min', ['Mélanger le sucre roux et la margarine foudue ensemble dans un saladier avec une cuillère.', 'Ajouter la farine et la levure dans le saladier et remuer.', 'Écraser les bananes dans un bol avec une fourchette et les ajouter au mélange.', 'Ajouter le sucre vanillé, le miel liquide et la cannelle dans le mélange et remuer.', 'Mettre le mélange dans un moule et le mettre au four 30 minutes à 180 degrés.'], ['Râpe', 'Ouvre-boîte'], ['', 'miel liquide', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'Gâteau à la Banane sans Oeufs et sans Lactose', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'margarine', 'dessert', 'plat de résistance', 'sucre vanillé', 'cannelle', 'cocktail', 'sucre roux'], 'Dessert', 73df85de-9811-46e6-ba7e-cb38593cd993, '2025-09-26T15:38:14.708676', [{'ingredient_id': 'ccb70469-7fee-4850-bbae-579f9a681d68', 'quantite': '100 g'}, {'ingredient_id': 'eaff4575-8495-4ce7-b90a-bcb453f71b6e', 'quantite': '50 g'}, {'ingredient_id': 'cd53a528-7e9f-4ba9-8811-d5a0d27570e4', 'quantite': '1'}, {'ingredient_id': '96562322-2274-430c-934d-3d682998b5af', 'quantite': '150 g'}, {'ingredient_id': 'f248fe5c-1da4-4506-a8b5-35ff7d121fc1', 'quantite': '1'}, {'ingredient_id': '28dee2e6-338c-4843-a652-231e0688e4f3', 'quantite': '1 cuillères'}, {'ingredient_id': '9ca47c19-f1e2-4a35-b10b-92d5c7db4433', 'quantite': '4'}, {'ingredient_id': '21575a28-b28b-4bb4-bb3c-ff9ca2465950', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (228215, 'Moelleux choco-banane très légers', 'chocolat noir, édulcorant, oeuf, sel, maïzena, farine, levure chimique, banane, lait écrémé, rhum, extrait de vanille', '5 min', ['Préchauffer votre four au thermostat maximum durant une dizaine de minutes.', 'Dans un saladier, casser le chocolat en carrés et le faire fondre avec 4 cuillères à soupe d’eau durant une minute trente au micro-ondes. ', 'Pendant ce temps, battre les œufs entiers en omelette dans un bol jusqu’à obtenir une texture mousseuse légère. Y ajouter une pincée de sel et verser dans le chocolat fondu. Bien mélanger l’ensemble au fouet de cuisine. ', 'Ajouter la levure, la farine et la maïzena en pluie tout en mélangeant en continu afin d’éviter les grumeaux. ', 'Dans un blender, mixer la banane avec le lait, l’extrait de vanille et le rhum jusqu’à obtenir une texture légère, mousseuse et sans morceau. ', 'Verser cette préparation dans le saladier. Ajouter l’édulcorant et bien mélanger jusqu’à obtenir une pâte lisse.', 'Verser dans des moules à muffins en silicone en veillant à ne les remplir qu’aux 3/4. Enfourner durant 15 minutes à 200°C (thermostat 6-7).', 'Démouler délicatement et saupoudrer le dessus des moelleux de poudre de coco avant de déguster tiède.'], ['Poêle', 'Passoire', 'Batteur électrique', 'Tire-bouchon', 'Pince de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'sel', 'confiserie', 'lait écrémé', 'testées', 'levure chimique', 'extrait de vanille', 'très facile', 'maïzena', 'bon marché', 'oeuf', 'plat', 'édulcorant', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'Moelleux choco-banane très légers', 'dessert', 'plat de résistance', 'chocolat noir', 'gâteau à la banane', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:38:20.034948', [{'ingredient_id': '8e534d2e-bb6e-4d34-a628-d5ff501a06d7', 'quantite': '160 g'}, {'ingredient_id': '5c8b43bf-af3d-4564-a77f-a97594b7359a', 'quantite': '2 cuillères'}, {'ingredient_id': '3f8330de-7e0c-4bac-9bdf-ed58d7fc5cee', 'quantite': '3'}, {'ingredient_id': '3d916365-eec9-473b-821e-c2c853f98613', 'quantite': '1'}, {'ingredient_id': 'cc6ac24c-fca2-4972-a481-1f469b508e14', 'quantite': '40 g'}, {'ingredient_id': 'e39cac9b-4754-41c4-a92b-e676c6f37447', 'quantite': '20 g'}, {'ingredient_id': '6480c1f3-9008-4c3a-ab9c-7b5e5b07a0d5', 'quantite': ''}, {'ingredient_id': 'eb4ff569-23a8-4587-8a29-ed0e6491834b', 'quantite': '1'}, {'ingredient_id': '37ba23b4-b813-4f34-8762-f5ba083827fe', 'quantite': '15 cl'}, {'ingredient_id': '3870a328-c8bf-46b1-9405-d39147bd0152', 'quantite': ''}, {'ingredient_id': '8fe1870c-fedd-407a-aa45-6e55759d9701', 'quantite': '5'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (67018, 'Smoothie fruits et céréales', 'banane, pomme, yaourt nature, raisins secs, flocons d''avoine, lait, glaçons', '5 min', ['Peler la banane et la pomme, les mettre dans un blender avec le yaourt, les raisins secs et les céréales.', 'Rajouter un peu de lait (commencer par 5 cl) et en rajouter si vous souhaitez rendre le smoothie plus liquide.', 'Mixer 1 minute.', 'Rajouter les glaçons, mixer 2 minutes. Servir.'], ['Spatule', 'Ouvre-boîte', 'Verre doseur', 'Casserole'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'yaourt nature', 'très facile', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Smoothie fruits et céréales', 'dessert', 'plat de résistance', 'pomme', 'glaçons', 'moyen', 'raisins secs', 'lait', 'flocons d''avoine', 'smoothies', 'cocktail'], 'Boisson', 93d755e1-5be2-4d9d-9112-32a26f67b500, '2025-09-26T15:38:24.975860', [{'ingredient_id': 'a8ad8a6e-cdd2-493c-a5a3-b08148387b02', 'quantite': ''}, {'ingredient_id': '75395eaf-fa55-4feb-9694-a3ddc5c19e9b', 'quantite': ''}, {'ingredient_id': 'ff55a906-7df6-4666-a73d-6bcc72d0f64c', 'quantite': '1'}, {'ingredient_id': '8451f3ed-d735-483d-92c6-dd7d2fe23b24', 'quantite': '1 cuillères'}, {'ingredient_id': 'be4b4620-9488-463f-adbb-4712a4de6094', 'quantite': '1 cuillères'}, {'ingredient_id': '11af6df8-a6fc-411f-99c7-5cb42cd5f0eb', 'quantite': '5 cl'}, {'ingredient_id': '01b6f33c-c621-478a-8119-d8d996994bb6', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (12012, 'Gâteau à la banane citronnée', 'farine, sucre, levure chimique, sel, huile, oeuf, banane, jus de citron', '20 min', ['Battre l''huile, les jaunes d''oeufs, les bananes écrasées à la fourchette et le jus de citron.', 'Par ailleurs, mélanger la farine, le sucre, la levure et le sel et ajouter au premier mélange. ', 'Battre les blancs en neige ferme. Les incorporer doucement à la pâte. Verser dans le moule.', 'Ce gâteau monte beaucoup, ne remplir le moule qu''au 2/3. Cuire 50 mn à four moyen / 180°C (le gâteau est cuit quand un doigt appuyé ne laisse pas de trace).', 'Laissez refroidir un peu avant de démouler. Saupoudrer de sucre glace.'], ['Poêle', 'Tire-bouchon'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'levure chimique', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'farine', 'dessert', 'plat de résistance', 'jus de citron', 'gâteau à la banane', 'sucre', 'Gâteau à la banane citronnée', 'cocktail'], 'Dessert', 404233bb-51e9-4f9b-bcb0-8c6862069fcc, '2025-09-26T15:38:28.714484', [{'ingredient_id': '3b878398-4ed0-4568-910a-941df2edbce5', 'quantite': '350 g'}, {'ingredient_id': '782d36a7-f52c-4b83-9355-bb04c65b9b45', 'quantite': '250 g'}, {'ingredient_id': '42516f23-0063-4d5a-a7b7-f3b89651610b', 'quantite': '3 cuillères'}, {'ingredient_id': '3d7ee54d-e3e7-4b14-b8ec-c75320dbc648', 'quantite': '1'}, {'ingredient_id': 'ff1a9860-f4fb-4a08-8925-f5313d272b37', 'quantite': '12.5 cl'}, {'ingredient_id': '502c04db-7d45-4cda-9d67-ee84f359a29a', 'quantite': '6'}, {'ingredient_id': '3c999bcf-6800-4219-a84b-b1ae13df225a', 'quantite': '3'}, {'ingredient_id': 'ab2cda9e-3068-4329-b830-bcf8e49ff99e', 'quantite': '4 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (31105, 'Les fraises glacées de Sabrina', 'fraises, glace pilée, rhum, sucre fin, eau, banane, sucre fin', '30 min', ['Décorer vos coupes de sucre fin (sur les bords).', 'Mixer les fraises, y ajouter un peu d''eau pour que le mélange soit plus liquide ainsi que quelques cuillères de sucre fin.', 'Disposer la glace pilée dans les verres, verser ensuite le coulis de fraise sur la glace. Dans chaque coupe, ajouter une petite rasade de rhum blanc (plus ou moins selon les goûts!)', 'Décorer d''une rondelle de bananes le bord de coupe et d''une jolie paille colorée!'], ['Presse-agrumes', 'Pince de cuisine', 'Ouvre-boîte'], ['', 'entrée', 'recettes de cuisine', 'rhum', 'confiserie', 'eau', 'testées', 'sucre fin', 'très facile', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'Les fraises glacées de Sabrina', 'cocktail', 'glace pilée'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:38:34.094200', [{'ingredient_id': '9e374a37-9b79-4f6e-85a6-1fe2dfcd2af1', 'quantite': '1 kg'}, {'ingredient_id': '67c82e09-3875-4b92-917d-344116848e54', 'quantite': ''}, {'ingredient_id': '2ca5ac81-3c0d-4321-abd4-2da67e389fda', 'quantite': ''}, {'ingredient_id': '37bb515f-1fb5-4856-ba76-1d4488258598', 'quantite': ''}, {'ingredient_id': '6e3c6997-3f5a-4f91-b35a-313607de07f3', 'quantite': ''}, {'ingredient_id': '18086135-8bc0-4479-ac8a-456aa4ba3b3f', 'quantite': '3'}, {'ingredient_id': 'fa31028b-ae90-4e8f-b091-2df45040a894', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (58049, 'Génoise aux trois mousses (chocolat blanc coco, banane mangue, chocolat noir)', 'génoise, jaune d''oeuf, sucre, farine, lait, gélatine, chocolat blanc, crème fleurette, crème chantilly, mangue, banane, gélatine, sucre, crème fleurette, crème chantilly, oeuf, lait, sucre, crème dessert au chocolat, farine, crème fleurette, crème chantilly, gélatine, noix de coco rapée, pralin', '240 min', ['Pour la mousse au chocolat-coco :', 'Faites tremper 2 feuilles de gélatine dans de l''eau froide.', 'Battez un jaune d''oeuf avec 40 g de sucre jusqu''à ce que ça blanchisse.', 'Ajoutez 1 cuillère à soupe de farine et le lait bouillant en remuant.', 'Ajoutez le chocolat blanc-coco en morceaux et mélangez.', 'Faites chauffer très doucement pendant 10 min et, hors du feu, incorporez les feuilles de gélatine et mélangez.', 'Laissez refroidir avant de rajouter 200 g de crème fouettée (crème fleurette + la cuillère à soupe de sucre mélangé avec 1 paquet de fix chantilly).', 'Démoulez la génoise, disposez-la sur une assiette.', 'Coupez-la en 3 disques dans l''épaisseur.', 'Sur le premier niveau, étalez le mélange au chocolat blanc-coco.', 'Placez environ 1 heure au réfrigérateur. ', 'Préparez la mousse mangue-banane.', 'Récupérez la chair de la mangue, coupez en morceaux et réduisez en purée au mixer.', 'Rajoutez la banane, un peu d''eau (ou de crème fleurette) et réduisez en purée.', 'Ajoutez le sucre à la préparation.', 'Faites dissoudre les 2 feuilles de gélatine au bain marie et rajoutez-les au mélange jusqu''à complète dissolution.', 'Ajoutez 200 g de crème fouettée.', 'Sur le deuxième niveau du gâteau versez la mousse mangue-banane.', 'Etalez uniformément sur le gâteau et laissez prendre 1 heure au réfrigérateur afin qu''elle durcisse un peu.', 'Préparez la mousse au chocolat noir : suivez la même procédure que pour la mousse au chocolat blanc-coco.', 'Sur le troisième niveau du gâteau, étalez uniformément la mousse au chocolat noir avec une spatule.', 'Finalisez en recouvrant légèrement de mousse au chocolat les bords du gâteau et saupoudrez de pralin.', 'Décorez le gâteau avec la noix de coco râpée.', 'Réservez au frais toute une nuit.'], ['Spatule', 'Économe', 'Ouvre-boîte'], ['boisson', 'Génoise aux trois mousses (chocolat blanc coco', 'recettes', 'entrée', 'recettes de cuisine', 'plat', 'génoise', 'moyenne', 'dessert', 'confiserie', 'recette', 'testées', 'banane mangue', 'plat de résistance', 'cocktail', 'cuisine', 'chocolat noir)', 'moyen'], 'Dessert', eee9fd35-6b08-4157-bb91-ef65a4b5833b, '2025-09-26T15:38:37.836711', [{'ingredient_id': '6787ddfc-183f-4fcd-8418-b85d34464f16', 'quantite': '1'}, {'ingredient_id': '1665d90e-b1df-4a9d-9c90-7232e3f20ea3', 'quantite': '1'}, {'ingredient_id': '202bff79-ef51-4f23-abe2-7f79973416d7', 'quantite': '50 g'}, {'ingredient_id': '4e0e4ee8-70d3-4e42-9a1d-c8c3bc249ef1', 'quantite': '1 cuillères'}, {'ingredient_id': '996a64ac-828f-4e1f-baa6-0a2b422330d1', 'quantite': '12.5 cl'}, {'ingredient_id': '7b53ddd1-3583-43af-86bc-6aca9f7512ab', 'quantite': '2'}, {'ingredient_id': '96645c19-ca7d-4a30-b75c-ab52aeb85875', 'quantite': '150 g'}, {'ingredient_id': '65555580-31cd-4aab-bc51-a37124807b20', 'quantite': '200 g'}, {'ingredient_id': '1509c34c-42d8-4b2e-82d8-f7d66adf9533', 'quantite': '1'}, {'ingredient_id': 'c7446ec7-15ca-423b-8cb7-32eb53beb456', 'quantite': '1'}, {'ingredient_id': '1968995a-11ee-4f73-a62d-3e41ec566555', 'quantite': '1'}, {'ingredient_id': '236a78c4-aef8-45e2-9bad-badcb6b8e0a4', 'quantite': '2'}, {'ingredient_id': '73b88a4e-193c-4f0a-95c6-ad98f9001dc0', 'quantite': '40 g'}, {'ingredient_id': '2636efe7-04ad-4a98-bc9e-0e590d6f9b4a', 'quantite': '200 g'}, {'ingredient_id': 'f3efd13a-cf79-4452-814a-9767fe8fdbe8', 'quantite': '1'}, {'ingredient_id': '9f5e62ea-2a6f-4a3c-8d51-574b3c4cd1fe', 'quantite': '1'}, {'ingredient_id': '0e711ae5-bb13-46c3-987c-141394c37062', 'quantite': '12.5 cl'}, {'ingredient_id': '72812a23-21c6-4990-b7ee-859111237f55', 'quantite': '50 g'}, {'ingredient_id': '4d6751d7-f3a2-4ea8-8338-b1bcbf224cc6', 'quantite': '150 g'}, {'ingredient_id': 'cd1d83da-e66b-4595-a3da-801c6a0268ee', 'quantite': '1 cuillères'}, {'ingredient_id': '97d6999e-fde7-47f6-8f96-d041c0181820', 'quantite': '200 g'}, {'ingredient_id': '6144aa20-36cd-4abe-b7c7-67b000841797', 'quantite': '1'}, {'ingredient_id': 'ca97dd7e-9774-4695-9693-f8f014e65a3c', 'quantite': '2'}, {'ingredient_id': '99057ebf-351d-4551-8724-ca13cba82cae', 'quantite': '50 g'}, {'ingredient_id': 'edbf50f6-6eae-4b57-9568-4af83a1dcb04', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (50651, 'Rondelles de banane dorées à la cannelle', 'banane, cannelle, sucre, beurre', '5 min', ['Coupez la banane en rondelles de moins d''1 cm d''épaisseur.', 'Faites fondre le beurre dans une poêle, et faites-y dorer la banane. ', 'Lorsqu''elle devient lègerement dorée, retournez les rondelles.', 'Ajoutez le sucre et la cannelle.', 'Après une légère caramélisationn ôtez la banane du feu. Disposez-la dans une assiette, et dégustez chaud !'], ['Moule à tarte', 'Passoire', 'Batteur électrique'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Rondelles de banane dorées à la cannelle', 'dessert', 'plat de résistance', 'beurre', 'cannelle', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:38:42.267660', [{'ingredient_id': '342c75af-f537-4ecc-b67f-7cab6411e4d2', 'quantite': '1'}, {'ingredient_id': '4f5184a5-c442-472b-b9e8-e4b3337aebe2', 'quantite': ''}, {'ingredient_id': 'ff6f35a1-8a1d-4105-8337-accbc46bcd1b', 'quantite': ''}, {'ingredient_id': 'c72edc5d-8a64-4606-8ef1-278c46e37ea2', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (337361, 'Banane au chocolat et smarties', 'banane, sucre, rhum, chocolat, Chocolat smarties', '5 min', ['Dans votre papillote, déposez les bananes épluchées, versez le sucre et le chocolat puis arrosez du rhum.', 'Cuisez 1 min au micro-ondes puissance moyenne et disposez les dans un plat.', 'Concassez grossièrement les smarties et parsemez-les sur les bananes.'], ['Balance de cuisine', 'Poêle', 'Tire-bouchon', 'Moule à tarte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'chocolat', 'Banane au chocolat et smarties', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Chocolat smarties', 'dessert', 'plat de résistance', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:38:46.982373', [{'ingredient_id': '53692a1c-970f-414d-bb69-95051c6464d1', 'quantite': '4'}, {'ingredient_id': '6cad6745-1bfc-47bc-85e8-bac3f43fea75', 'quantite': '1 cuillères'}, {'ingredient_id': '423b301a-06bf-4fa0-8e1a-c4f527ad7c40', 'quantite': '1 cuillères'}, {'ingredient_id': '142b5ce8-50b2-4aac-b97f-0191a421e9b4', 'quantite': '40 g'}, {'ingredient_id': 'cc8c138c-cee3-49c2-a06a-992ad181548b', 'quantite': '20 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (65810, 'Bananes à l''orange', 'banane, sucre, beurre, orange', '10 min', ['Eplucher les bananes et les couper en deux dans le sens de la longueur.', 'Presser l''orange.', 'Faire fondre le beurre dans une poêle à feu moyen. Quand il est complètement fondu, poser les bananes dans la poêle.', 'Les saupoudrer avec le sucre et laisser cuire 4 min.', 'Les retourner ensuite avec une spatule.', 'Au bout de 3 minutes, verser le jus d''orange dans la poêle.', 'Servir quand le jus est presque complètement évaporé.'], ['Pince de cuisine', 'Moule à tarte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'Bananes à l''orange', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'orange', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:38:50.616224', [{'ingredient_id': '1dcd6a51-50f8-46b2-91ef-0c0fb8135499', 'quantite': '2'}, {'ingredient_id': 'e67809f5-3dbe-4de8-901e-acc5077eb2ac', 'quantite': '2 cuillères'}, {'ingredient_id': 'e82a0ecc-66b9-4916-a3c8-3ce2d4de8eb5', 'quantite': '1 cuillères'}, {'ingredient_id': '11c27be6-5a72-4c58-8b35-3d698979e2ae', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (201408, 'Glace allégée à la banane', 'banane, citron, fromage blanc, crème épaisse, sucre vanillé, édulcorant', '5 min', ['Couper les bananes en rondelles les mouiller avec le jus de citron, ajouter les autres ingrédients et mixer dans un blender ou mixer à main 1 min environ.', 'Mettre dans un récipient en plastique et faire prendre au congélateur environ 4 heures.'], ['Râpe', 'Ouvre-boîte', 'Couteau de chef', 'Passoire', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'édulcorant', 'recette', 'cuisine', 'recettes', 'boisson', 'Glace allégée à la banane', 'fromage blanc', 'dessert', 'plat de résistance', 'sucre vanillé', 'citron', 'glace à l''italienne', 'crème épaisse', 'cocktail'], 'Dessert', 1724cf52-0371-4931-bff5-c7014f46177d, '2025-09-26T15:38:55.117526', [{'ingredient_id': '0c24f98d-d72a-44f1-ba8e-9532bbede91a', 'quantite': '2'}, {'ingredient_id': '5d503dce-d953-4cc9-b75c-8ae739308852', 'quantite': ''}, {'ingredient_id': '112dc11a-1f81-4063-aed4-3b41961afae7', 'quantite': '200 g'}, {'ingredient_id': '43dd3821-4087-4d44-8297-644f77713f78', 'quantite': '1 cuillères'}, {'ingredient_id': '2030b9eb-fb9e-4971-8422-974937e4fc6a', 'quantite': '1'}, {'ingredient_id': 'ac773450-7a2a-488b-810a-8550641ae7c0', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (343038, 'Fondant chocolat-banane sans oeufs ni lait', 'chocolat, huile de tournesol, lait de soja, farine, sucre, banane', '10 min', ['Faire fondre le chocolat avec un peu des 200 ml d''huile au bain-marie.', 'Dans un saladier, mettre le sucre, le lait, la farine, l''huile restante et la banane écrasée.', 'Une fois le chocolat fondu, l''ajouter avec le reste des ingrédients.', 'Battre le tout énergiquement ou au batteur pour éviter les grumeaux.', 'Mettre le tout dans un moule en silicone ou dans un moule classique tapissé de papier sulfurisé.', 'Faire cuire 20 minutes au four à 180°C (thermostat 6).', 'Démouler le gâteau une fois tiède ou froid  pour ne pas qu''il se casse.', 'Bon appétit!'], ['Couteau de chef', 'Planche à découper', 'Économe', 'Fouet', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Fondant chocolat-banane sans oeufs ni lait', 'farine', 'huile de tournesol', 'dessert', 'plat de résistance', 'lait de soja', 'sucre', 'cocktail', 'oeufs au lait'], 'Dessert', 305e73a2-c7ce-4329-9d71-794ad1f2514c, '2025-09-26T15:38:59.788331', [{'ingredient_id': '7a416fb9-bce2-42a2-a95c-ab7c8b6bd43d', 'quantite': '200 g'}, {'ingredient_id': '0761ebf5-111b-4554-bc66-3f4ee7c1330e', 'quantite': '200 ml'}, {'ingredient_id': '3dd411ac-b887-4eb4-883f-f6e73a259667', 'quantite': '200 ml'}, {'ingredient_id': 'f0ec4bff-b4d4-41e4-a958-6a6b3d3622e8', 'quantite': '200 g'}, {'ingredient_id': '1e5d6a02-d2b3-4a44-a9e0-969793b64425', 'quantite': '180 g'}, {'ingredient_id': 'c65025c5-611d-4e23-ac2e-d77366b4e346', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (24844, 'cake tendre chocolat - banane', 'oeuf, sucre, beurre, farine, fécule de pomme de terre, levure, banane, crème fraîche, sucre vanillé, pépites de chocolat', '20 min', ['Mélanger le sucre et les oeufs, puis ajouter le beurre fondu. ', 'Ajouter la farine, la fécule et la levure. ', 'A part, écraser les bananes, puis faire une bouillie avec la crème, et ajouter le sucre vanillé. ', 'Ajouter la préparation de bananes au mélange, puis ajouter le chocolat cassé en très petits morceaux (sinon ils coulent au fond du plat !). ', 'Verser la préparation dans un moule à cake beurré. ', 'Faire cuire 50 mn à 180°C.'], ['Fouet', 'Casserole', 'Moule à tarte'], ['entrée', 'banane', 'recettes de cuisine', 'cake tendre chocolat - banane', 'crème fraîche', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'pépites de chocolat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'autres cakes', 'dessert', 'fécule de pomme de terre', 'plat de résistance', 'sucre vanillé', 'beurre', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:39:06.918038', [{'ingredient_id': 'a99f1112-ba68-49a4-b026-c19b964aa4a5', 'quantite': '2'}, {'ingredient_id': '9fa044ce-2a4d-4604-b022-5e4a572e6f1c', 'quantite': '100 g'}, {'ingredient_id': '9544435b-0c8b-44c5-be28-5901c19bca71', 'quantite': '100 g'}, {'ingredient_id': '1c0f3b1d-5d17-4873-9484-9d3bb43cca4a', 'quantite': '100 g'}, {'ingredient_id': '95b779bd-9c22-4914-ac17-c13d7c77ce3e', 'quantite': '50 g'}, {'ingredient_id': 'b1cff359-4ee3-4358-8d58-6834f3ef79ea', 'quantite': '1'}, {'ingredient_id': '2552427a-a546-4b13-9646-43ecb64c8a6a', 'quantite': '3'}, {'ingredient_id': '3ccdc49c-76b4-4a65-ab7a-aa7b18064117', 'quantite': '3 cuillères'}, {'ingredient_id': '5ec488cc-189a-43d9-be83-07ab46fd1209', 'quantite': '1'}, {'ingredient_id': '835090c4-ac52-45fa-a849-ab01b28ff16b', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (58218, 'Muffins de Karina', 'farine, sucre en poudre, levure, beurre, oeuf, lait, chocolat noir, lait, banane', '20 min', ['Mélanger la farine, le sucre, la levure et le beurre.', 'Battre l''œuf avec le lait et l''ajouter au mélange.', 'Ajouter la banane et le chocolat coupés en morceaux.', 'Verser dans des ramequins appropriés et faire cuire à 220°C (thermostat 7-8) pendant 20 à 25 minutes.', 'Mon astuce : Je coupe les carrés de chocolat assez épais (en 4).', 'Régalez-vous !'], ['Batteur électrique', 'Verre doseur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'Muffins de Karina', 'dessert', 'plat de résistance', 'chocolat noir', 'muffin', 'beurre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:39:11.866879', [{'ingredient_id': 'c5f79e8d-542b-40bf-9500-09dc9fd26b9d', 'quantite': '175 g'}, {'ingredient_id': '25a46128-9fd4-4b50-ba52-772247ae58d6', 'quantite': '100 g'}, {'ingredient_id': 'a812ece6-8506-4861-94b3-3b8fc718da24', 'quantite': '1.5 cuillères'}, {'ingredient_id': '94193e59-ad42-4c38-8bd4-fbc4a587dea7', 'quantite': '50 g'}, {'ingredient_id': 'df715f2e-061d-4113-a96e-c28403850c4e', 'quantite': '1'}, {'ingredient_id': '68db2e9f-60d6-47b3-ab0b-ffedfa239ecd', 'quantite': '10 cl'}, {'ingredient_id': '25ffdcf9-4d9b-45f2-8f41-26018dbc5cc9', 'quantite': '100 g'}, {'ingredient_id': '6877de87-b953-4473-888f-ae8b7ef7bf96', 'quantite': ''}, {'ingredient_id': '13a6f850-151b-45c0-ab0e-6dfb3d77a9b4', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (20153, 'milk shake banane, kiwi et mandarine', 'banane, kiwi, mandarine, lait, glaçons, sucre', '5 min', ['Dans un mixer, mettre les fruits coupés et les mixer. ', 'Ajouter un peu de sucre.', 'Quand tout est bien mélangé, mettre les glaçons et mixer doucement, puis assez vite.', 'Et c''est prèt!!!'], ['Rouleau à pâtisserie', 'Casserole', 'Passoire', 'Économe'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'kiwi et mandarine', 'très facile', 'mandarine', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'glaçons', 'lait', 'sucre', 'cocktail', 'milk shake banane'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:39:15.468110', [{'ingredient_id': '19e4ba87-d0fe-480b-9223-f0324b25813f', 'quantite': '1'}, {'ingredient_id': 'ac39065a-1155-4ee6-92b8-f32ae831beca', 'quantite': '1'}, {'ingredient_id': 'cca20949-b254-4ba8-b19b-450845699c13', 'quantite': '1'}, {'ingredient_id': '8364c3dd-f116-465b-ac76-9bf9b3b6ee8f', 'quantite': '1'}, {'ingredient_id': '2ae24666-21b9-48bc-91d4-a4ec31ede07a', 'quantite': '15'}, {'ingredient_id': '6b6a8d7f-e380-4d31-b56b-83c528aeff3d', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (32393, 'Jus de fruits à la banane', 'orange, citron, banane, poire, eau, sucre', '10 min', ['Presser l''orange et le demi citron, couper la banane en petits morceaux et la demi poire en fines lamelles. Mixer le tout. ', 'Vous pouvez rajouter un peu d''eau si le mélange est trop épais, et rajouter du sucre selon l''acidité de l''orange et du citron. ', 'Mettre au frigo, jusqu''à ce que ça soit bien frais. ', 'La recette est pour 1 personne, pour 5 personnes ne mettez que 4 bananes et demi.'], ['Couteau de chef', 'Louche', 'Poêle'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'poire', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Jus de fruits à la banane', 'citron', 'orange', 'sucre', 'cocktail'], 'Boisson', 72578b21-612c-4a8f-8d56-90025fe9a603, '2025-09-26T15:39:19.012725', [{'ingredient_id': 'f06820ce-5090-4261-9142-05d9e41fd6c1', 'quantite': '1'}, {'ingredient_id': '73fbe13e-3293-4257-9d6c-e3bd9c717494', 'quantite': ''}, {'ingredient_id': '228630ba-b12b-4e2c-92ef-e59da0a97fce', 'quantite': '1'}, {'ingredient_id': '8a98e2e9-f4f2-4230-b4be-6f9170af8fec', 'quantite': ''}, {'ingredient_id': '33e5f4c4-cbf7-4868-a942-da8b3be50f72', 'quantite': ''}, {'ingredient_id': 'e94e858d-8fc7-4773-991c-9f73be7995f7', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (29142, 'Croque-monsieur au chocolat', 'pain de mie, beurre, chocolat noir, banane', '5 min', ['Brancher votre appareil à croque-monsieur ou allumer le grill du four. ', 'Beurrer les deux tranches de pain de mie (sur une seule face, hein !)', 'Disposer les carrés de chocolat et fermer le sandwich. ', 'Faire griller et.... ', 'Attendre que ça refroidisse un peu avant de se régaler!'], ['Mixeur', 'Louche', 'Casserole', 'Batteur électrique', 'Économe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Croque-monsieur au chocolat', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat noir', 'beurre', 'cocktail', 'pain de mie'], 'Dessert', eb7f69a0-23ad-41be-b988-51cc588b1e2a, '2025-09-26T15:39:22.674609', [{'ingredient_id': '2a24f34c-24b4-4913-87f9-6b1bb36d30be', 'quantite': '2'}, {'ingredient_id': '2ac1d088-30de-4bf3-b3fe-bb9f79a7672e', 'quantite': ''}, {'ingredient_id': '0c49d49d-c492-4374-8dc1-67496c9f81fb', 'quantite': '2'}, {'ingredient_id': '4550cf1a-12aa-4f1e-9be2-c348248a1d29', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (195267, 'Papillotes de fruits à la noix de coco (au barbecue)', 'pomme, poire, banane, ananas, jus de citron, noix de coco rapée, cassonade', '15 min', ['Préchauffez le four à 200°C (thermostat 6-7).', 'Prenez un grand saladier.', 'Épluchez les pommes et les poires, épépinez-les puis coupez-les en dés.', 'Pelez ensuite les bananes, coupez-les en deux dans la longueur puis en tranches.', 'Ajoutez ensuite l''ananas en versant un peu de sirop dans le saladier.', 'Saupoudrez de noix de coco à votre convenance, ajoutez le sucre puis un peu de jus de citron et mélangez bien cette salade de fruits.', 'Filmez et conservez au frigo au moins une heure pour qu''il y ait suffisamment de sirop.', 'Préparez ensuite 6 feuilles de papier aluminium dans lesquelles vous répartirez la salade de fruits, fermez-les bien, mais pas trop serrées que le papier ne se déchire pas en les sortant du feu ou du four.', 'Mettez les papillotes dans un four préchauffé à 200°C (thermostat 6-7) pendant au moins 10 minutes, ou bien au barbecue sur des braises pas trop puissantes (après les merguez et le camembert c''est parfait) jusqu''à ce que l''odeur envahisse le jardin et vous dise que c''est cuit.', 'Servez avec une bonne glace à la vanille et dégustez.'], ['Verre doseur', 'Moule à tarte', 'Rouleau à pâtisserie', 'Pince de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'cassonade', 'poire', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'Papillotes de fruits à la noix de coco (au barbecue)', 'boisson', 'noix de coco rapée', 'dessert', 'plat de résistance', 'jus de citron', 'pomme', 'ananas', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:39:28.193371', [{'ingredient_id': '92b9204b-b93d-4e81-b65e-ab368358aca4', 'quantite': '4'}, {'ingredient_id': 'd9a8a292-9f3a-449a-85a8-2774a3e82770', 'quantite': '4'}, {'ingredient_id': '49517694-095d-4cba-8551-4a4e1705e79c', 'quantite': '2'}, {'ingredient_id': '7e8201eb-e8c2-46e0-84d7-1581fdd7b59b', 'quantite': '1'}, {'ingredient_id': 'fcc48c05-061e-4d7f-bf91-b59e696e8322', 'quantite': ''}, {'ingredient_id': '8ef93ad6-978a-4891-a231-f6ebc85b0106', 'quantite': ''}, {'ingredient_id': 'd05691f2-2963-4e52-bcdb-3b2d7c45177f', 'quantite': '20 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (32193, 'Banana-split ''Caraïbes''', 'banane, ananas, glace à la noix de coco, glace vanille, chocolat noir, rhum', '10 min', ['Sortez les glaces du congélateur.', 'Coupez la banane en 2 sur la longueur et passez la légèrement au micro-ondes.', 'Diposez deux boules de glace à la vanille et une boule de glace noix de coco dans une coupe.', 'Ajoutez une cuillère à soupe de rhum blanc.', 'Coupez les deux moitiés de banane et l''ananas en dés, puis disposez-les dans la coupe.', 'Râpez le chocolat et saupoudrez-en le dessert.', 'Voila, c''est prêt, il ne reste plus qu''à déguster!', 'Astuce décoration : givrez votre coupe avec du jus de citron vert et du sucre roux.'], ['Pince de cuisine', 'Verre doseur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'glace vanille', 'glace à la noix de coco', 'dessert', 'plat de résistance', 'chocolat noir', 'ananas', 'Banana-split ''Caraïbes''', 'cocktail'], 'Dessert', c8b1b551-15c8-4403-a28e-c2200bed2450, '2025-09-26T15:39:31.795841', [{'ingredient_id': '56aa14c8-0e92-4e49-b4ae-13245771f416', 'quantite': '1'}, {'ingredient_id': '197492a3-d99e-47b3-b71b-5af2713dfe71', 'quantite': ''}, {'ingredient_id': '2c0b1fcb-1203-4f19-a141-fdfc78a5f65b', 'quantite': ''}, {'ingredient_id': '36ea1e5f-5543-4fd2-976d-9c25094a62c1', 'quantite': ''}, {'ingredient_id': '2300b13c-7eef-4e06-b7a4-98a72c73670e', 'quantite': '30 g'}, {'ingredient_id': '243373af-94f6-43df-ac19-1a5ff779b25b', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (312358, 'Compote pomme-banane', 'banane, pomme, sucre roux, sucre vanillé', '30 min', ['Préparer les fruits : éplucher les pommes et couper les en petits cubes. Éplucher les bananes et les couper en rondelles.', 'Mettre tous les fruits dans une casserole, ajouter les sucres et faire cuire à feu moyen pendant 15 min. ', 'Pendant ce 1/4 d''heure, bien mélanger régulièrement. ', 'A la fin de ce temps, les bananes auront "fondu".', 'Continuer la cuisson des fruits pendant 1h à feu doux en mélangeant de temps en temps.', 'En fin de cuisson, mixer les fruits si vous voulez obtenir une compote lisse.', 'Bon appétit !'], ['Ouvre-boîte', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'compote de pomme', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'Compote pomme-banane', 'cocktail', 'sucre roux'], 'Dessert', a6e76fc2-246b-43f2-abbf-2f947e677626, '2025-09-26T15:39:35.734486', [{'ingredient_id': 'd3eee8dd-893b-4f19-9237-fa3231f1b5ee', 'quantite': '3'}, {'ingredient_id': '35af4633-fac6-4bab-b541-76593020265f', 'quantite': '6'}, {'ingredient_id': 'c78ccd3b-1a65-4009-bba5-8bcaca7c434e', 'quantite': '100 g'}, {'ingredient_id': '3d4da98f-c8e0-4c03-b9e0-98f7acaf6207', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (35523, 'Pain aux bananes et aux fraises ( banana and strawberry bread )', 'oeuf, huile, sucre, fraises, banane, farine, flocons d''avoine, levure, sel', '10 min', ['Dans un récipient, battre les oeufs, ajouter l''huile, le sucre, les fraises et les bananes.', 'Dans un second récipient, mélanger farine, flocons d''avoine, levure et sel. Réunir les 2 contenus et mélanger.', 'Cuire à 180°C pendant 1 heure à peu près, puis vérifier avec le test du couteau (qu''on y plonge et qui doit ressortir sec).'], ['Ouvre-boîte', 'Économe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'Pain aux bananes et aux fraises ( banana and strawberry bread )', 'oeuf', 'plat', 'fraises', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'huile', 'farine', 'dessert', 'plat de résistance', 'sucre', 'flocons d''avoine', 'cocktail'], 'Dessert', b035dd0c-3906-4bc5-ba8e-23f12fdc2d71, '2025-09-26T15:39:39.342518', [{'ingredient_id': 'c087b5fa-c316-4e9b-808a-fa17e4c8ed13', 'quantite': '2'}, {'ingredient_id': 'a7caa54e-ea2b-46c1-8f63-939b3d79ca51', 'quantite': '5 cl'}, {'ingredient_id': '1df813a9-d4f9-410c-9f85-ec80f9703796', 'quantite': '250 g'}, {'ingredient_id': 'a772d73f-65b2-43ab-97fe-945cfd58833d', 'quantite': '130 g'}, {'ingredient_id': 'c6452770-4bbf-462a-8ed0-7fac5aa4b9e4', 'quantite': '130 g'}, {'ingredient_id': 'c9eae981-4e82-49d6-b614-de68aa20af22', 'quantite': '430 g'}, {'ingredient_id': '08081302-f30e-442c-9a89-79e96e277530', 'quantite': '125 g'}, {'ingredient_id': 'a57865ef-895d-48f8-961d-12eea83f61a0', 'quantite': '1'}, {'ingredient_id': '1a32db79-25cf-48d9-a6a2-fbc3ae8f05f0', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (43251, 'Gâteau aux bananes et au miel express', 'oeuf, miel liquide, beurre, rhum, farine, banane, noix, cannelle, levure chimique', '25 min', ['Préchauffer le four à 220°C (thermostat 7-8).', 'Au batteur électrique, battre les oeufs entiers avec le miel, jusqu''à obtenir un mélange blanc et mousseux.', 'Faire fondre le beurre sans le faire bouillir. Il ne doit pas être chaud pour ne pas faire cailler les oeufs. Ajouter le beurre à la préparation tout en continuant de battre.', 'Incorporer la farine, la cannelle et la levure, puis le rhum, puis les bananes écrasées et enfin les noix moulues. Pour préserver le goût des noix, il est recommandé de les moudre soi-même au mixeur, au dernier moment.', 'Verser la pâte dans un moule rond, beurré et fariné. Cuire 35 à 40 minutes.', '5 minutes avant la fin de la cuisson, on peut verser par-dessus le gâteau un sirop au rhum.'], ['Ouvre-boîte', 'Louche'], ['', 'miel liquide', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'levure chimique', 'facile', 'Gâteau aux bananes et au miel express', 'oeuf', 'plat', 'recette', 'cuisine', 'noix', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'moyen', 'beurre', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:39:42.968740', [{'ingredient_id': '0ac8312b-db65-40b9-ac90-4c2a62b7924c', 'quantite': '4'}, {'ingredient_id': 'c34b830e-d76a-4351-89e1-d46c40e9033e', 'quantite': '200 g'}, {'ingredient_id': '3e890177-d08b-43bd-81b2-0932d5c272b8', 'quantite': '200 g'}, {'ingredient_id': '6e605eaa-1a9d-4414-8822-74ebe77dd507', 'quantite': '1'}, {'ingredient_id': '4406fa45-9492-46d6-922d-fc04cc193ed2', 'quantite': '2'}, {'ingredient_id': '2caf4d9c-ca81-4179-8652-12dc11ee4209', 'quantite': '2'}, {'ingredient_id': 'dbf0629b-bb6e-43a1-bf58-0cf8a0687c9b', 'quantite': '1'}, {'ingredient_id': 'fdb772f3-e410-4301-b1d5-491242ef971e', 'quantite': ''}, {'ingredient_id': '25097874-29de-4d4b-a12d-75629c06ad94', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (83516, 'Fruits frais chauds', 'banane, pomme, orange, citron, ananas, jus d''ananas, sucre, bleu, sucre vanillé, beurre', '20 min', ['Éplucher les fruits puis les couper en rondelles.', 'Mettre tous les fruits dans un saladier ainsi que le jus d''ananas.', 'Presser le jus du citron sur ce mélange et ajouter le sucre, puis le curacao.', 'Mélanger délicatement tous les ingrédients.', 'Laisser reposer 30 mns au frigo.', 'Verser cette marinade dans un plat à gratin.', 'Disposer quelques noix de beurre sur le plat et saupoudrer de sucre vanillé.', 'Cuire 20 min à 200°c (thermostat 6-7).', 'Déguster quelques minutes après la sortie du four.'], ['Râpe', 'Planche à découper', 'Louche'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'Fruits frais chauds', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'bleu', 'plat de résistance', 'jus d''ananas', 'sucre vanillé', 'pomme', 'beurre', 'citron', 'orange', 'ananas', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:39:46.688122', [{'ingredient_id': '9a0b559e-8c7a-4aea-b203-7492817850bd', 'quantite': '3'}, {'ingredient_id': '0f3c1f0e-98f6-4a4c-b179-1ad1d877dbb6', 'quantite': '3'}, {'ingredient_id': '73727da6-f00d-40f2-9ad2-13be99bdf120', 'quantite': '2'}, {'ingredient_id': '86762ccb-6044-462e-a634-1404c670963c', 'quantite': '1'}, {'ingredient_id': 'c11117e4-b25c-4f80-8736-9ec1d27548d3', 'quantite': '8'}, {'ingredient_id': 'f0418a4c-b345-4af7-baf9-88320f013036', 'quantite': '10 cl'}, {'ingredient_id': 'f112b592-b67f-49ba-b7a5-d3327dec1dbe', 'quantite': '4 cuillères'}, {'ingredient_id': 'ffdc4050-e050-40f3-a584-a73b930fac61', 'quantite': '4 cuillères'}, {'ingredient_id': 'f6989d64-1b58-49bd-8088-58ea82c8ec0a', 'quantite': '1'}, {'ingredient_id': '0f6007e1-b957-40ae-a307-8d3323d2faba', 'quantite': '25 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (90501, 'Tarte à la banane et au nutella', 'pâte brisée, banane, Nutella, fromage blanc, chocolat', '15 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Déposer la pâte brisée dans un moule à tarte. ', 'Etaler le nutella sur le fond de la pâte.', 'Ecraser les 4 bananes bien mures avec une fourchette et y ajouter les 2 pots de fromage blanc stracciatella. ', 'Bien mélanger la préaparation et la verser sur le nutella.', 'Couper la banane un peu plus ferme en rondelles et les disposer sur la tarte de manière harmonieuse avec les carrés de chocolat.', 'Enfourner 30 minutes.'], ['Pince de cuisine', 'Batteur électrique', 'Presse-agrumes'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'très facile', 'bon marché', 'Tarte à la banane et au nutella', 'plat', 'tarte à la banane', 'recette', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'fromage blanc', 'Nutella', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:39:52.016859', [{'ingredient_id': '6949fc0e-5647-453f-b2ef-7b8e6b740fb0', 'quantite': '1'}, {'ingredient_id': '3b3dce41-bd26-455c-b65f-9404a4803781', 'quantite': '4'}, {'ingredient_id': '1bde3680-e68c-4504-bafe-eb84dc901c0a', 'quantite': '5 cuillères'}, {'ingredient_id': '9caa91ce-71b3-4f9a-b0f6-05a2a9081f7b', 'quantite': '2'}, {'ingredient_id': 'a942ed14-ff40-463e-8b83-f673424bb4f6', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (61101, 'Ragoût de chataîgnes, pommes de terre et  banane plantain', 'pomme de terre, châtaignes, banane plantain, échalote, ail, thym, laurier, huile, poivre, sel', '15 min', ['Dans une sauteuse faire frire les bananes plantain préalablement coupées en gros morceaux dans une quantité d''huile suffisante. Les réserver.', 'Mettre à dorer les pommes de terre, une fois dorées ajouter de l''eau ainsi que les arômates au jus de cuisson.', 'Couvrir et laisser mijoter jusqu''à ce que les pommes de terre soient presque cuites.', 'Ajouter les chataîgnes et éventuellement un peu d''eau. Lorsque les chataîgnes commencent à réduire en purée, ajouter les bananes sans couvrir.', 'Saler, poivrer et servir très chaud.'], ['Planche à découper', 'Casserole', 'Passoire', 'Couteau de chef'], ['', 'laurier', 'entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'cocktail', 'très facile', 'bon marché', 'ail', 'pommes de terre et  banane plantain', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'dessert', 'plat de résistance', 'banane plantain', 'Ragoût de chataîgnes', 'thym', 'poivre', 'pomme de terre', 'châtaignes', 'échalote'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:39:56.962011', [{'ingredient_id': '0a7d697a-2748-4abb-85a7-f5782ee6e5fe', 'quantite': '6'}, {'ingredient_id': '32198ec6-d075-45bd-847e-0887c44a6e23', 'quantite': ''}, {'ingredient_id': '00d97fe3-d2ea-4c5c-8885-3b5fcbc391ec', 'quantite': ''}, {'ingredient_id': '7860ea4b-7281-443e-8962-725bbab8b97b', 'quantite': '1 cuillères'}, {'ingredient_id': '15218949-93b3-4a71-9606-c3e476aae759', 'quantite': ''}, {'ingredient_id': '94909ec6-20a1-4538-9d88-17083f8b1dcf', 'quantite': ''}, {'ingredient_id': 'fe7db99b-6bec-467e-8724-866dbcc1f03e', 'quantite': ''}, {'ingredient_id': '0701b638-b79e-4abc-8de7-c1a3304452e0', 'quantite': ''}, {'ingredient_id': '71a08741-da75-4edd-b5d3-b661566e0ebd', 'quantite': ''}, {'ingredient_id': 'e879e3c4-fa71-4a99-b904-3783647d79a6', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (61038, 'Poulet soleil aux fruits et légumes', 'filet de poulet, tomate, poivron rouge, poivron vert, mangue, pêche, banane, ananas, huile d''olive', '20 min', ['Découper les filets de poulets en morceaux.', 'Les faire cuire dans une sauteuse avec de l''huile d''olive.', 'Ajouter les poivrons (vert et rouge) préalablement coupés en cubes.', 'Attendre qu''ils réduisent.', 'Ajouter les tomates coupées en morceaux. Laisser mijoter pendant 30 bonnes minutes.', 'Ajouter les morceaux d''ananas.', 'En fin de cuisson, ajouter les morceaux de mangue, ceux de bananes et ceux de pêche.', 'Accompagnez votre plat avec du riz, c''est un délice pour les amateurs de sucré-salé.', 'BON APPÉTIT!!!!!!!!!!!!!'], ['Moule à tarte', 'Batteur électrique', 'Verre doseur'], ['', 'Poulet soleil aux fruits et légumes', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'poivron vert', 'filet de poulet', 'facile', 'bon marché', 'tomate', 'plat', 'mangue', 'recette', 'cuisine', 'poivron rouge', 'recettes', 'boisson', 'huile d''olive', 'dessert', 'plat de résistance', 'ananas', 'pêche', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:40:00.675808', [{'ingredient_id': 'aa571917-8a00-47f0-af0e-25892cf0d04e', 'quantite': '400 g'}, {'ingredient_id': 'a20d702d-b178-4249-9859-8cf5b5d234f9', 'quantite': '4'}, {'ingredient_id': 'd651861a-ead8-4bc1-a727-7031d57780f4', 'quantite': '1'}, {'ingredient_id': '193fedf6-cdf8-49a9-a08e-460eb5e0c520', 'quantite': '1'}, {'ingredient_id': '7442753a-9f53-4c62-950e-55baa15a545f', 'quantite': '1'}, {'ingredient_id': 'b4db1477-44fd-4315-91f5-79b6e827f963', 'quantite': '1'}, {'ingredient_id': 'efad1021-26d8-438f-9734-bd0edea07999', 'quantite': '1'}, {'ingredient_id': 'b07e115a-9441-40f3-9c7b-dbeaca034149', 'quantite': '50 g'}, {'ingredient_id': '1000c4c9-9ecc-4a9e-83c6-a7e45f943ab2', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (31478, 'Thon au lait de coco', 'thon rouge, safran, cannelle, piment vert, lait de coco, banane plantain, oignon blanc, huile d''olive, ail, gingembre', '10 min', ['Retirez la peau, les arêtes et les parties brunes du thon. Badigeonnez-le de 2 cuillerées à soupe d''huile d''olive. Salez, poivrez. Détaillez-le en gros cubes, puis réservez. ', 'Pelez les bananes et coupez-les en deux dans le sens de la longueur. Epluchez et hachez le gingembre. Pelez et émincez l''ail et les oignons. Coupez le piment en lanières. ', 'Dans une sauteuse, faites suer dans le reste d''huile, pendant 5 min, l''ail et les oignons émincés avec le gingembre haché et les bananes. ', 'Ajoutez les cubes de thon en remuant pour les colorer de tous côtés, puis retirez-les et réservez-les sur un plat. ', 'Versez dans la sauteuse le lait de coco. Saupoudrez de safran et de cannelle. Laissez mijoter 5 min à feu vif. Ajoutez le piment. Remuez. ', 'Nappez le thon de cette sauce et servez aussitôt.', 'Pour en savoir plus sur le <a href="http://www.marmiton.org/Magazine/Dossiers-Marmiton_thon-rouge_1.aspx"><u>thon rouge, cliquez ici</u></a>.'], ['Fouet', 'Poêle', 'Verre doseur'], ['', 'lait de coco', 'gingembre', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'thon rouge', 'ail', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'huile d''olive', 'Thon au lait de coco', 'dessert', 'oignon blanc', 'plat de résistance', 'banane plantain', 'moyen', 'piment vert', 'cannelle', 'cocktail', 'safran'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:40:04.588184', [{'ingredient_id': 'ac9d5444-8f88-47a9-9941-516aff0747d5', 'quantite': '800 g'}, {'ingredient_id': '18898523-859d-4b16-933d-ae56c2ebeeaa', 'quantite': '1'}, {'ingredient_id': '0f44f976-e7ab-4768-ac94-9e4176114f6b', 'quantite': '1 cuillères'}, {'ingredient_id': '062aadf5-fc65-4f0b-9129-d6bb84d8ca46', 'quantite': '1'}, {'ingredient_id': '5f5ba9a2-d597-489f-bdf4-de1edd3bdff0', 'quantite': '20 cl'}, {'ingredient_id': 'a537adfa-0681-426f-9e9c-ce58b7cc1535', 'quantite': '3'}, {'ingredient_id': '09961fff-0c23-4dae-8b82-65d4ee7a0c0e', 'quantite': '3'}, {'ingredient_id': 'aa2d8348-dc46-43a3-8d0b-31a5c184740e', 'quantite': '4 cuillères'}, {'ingredient_id': '423d9389-f4f8-4df4-ae89-6ee8a1ed5678', 'quantite': '4'}, {'ingredient_id': '89db030e-120d-43a8-8d3a-ca207f91be59', 'quantite': '5 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (65640, 'Poé tahitien  à la banane', 'banane, eau, vanille, fécule, beurre, sucre, lait de coco', '40 min', ['Mettre les bananes épluchées à cuire dans l''eau avec la vanille pendant 15 min.', 'Egoutter, laisser refroidir et passer à la moulinette pour obtenir une compote.', 'Mélanger la compote avec la fécule de manioc.', 'Verser dans un plat de 3 à 4 cm de hauteur préalablement beurré.', 'Mettre au four pendant 30 min, thermostat 6 (180°).', 'Découper le po''e, saupoudrer de sucre et napper de lait de coco.', 'Laisser tiédir ou refroidir et déguster.', ' Ta ma''a maitai !'], ['Balance de cuisine', 'Mixeur'], ['', 'lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'très facile', 'bon marché', 'plat', 'Poé tahitien  à la banane', 'recette', 'cuisine', 'recettes', 'boisson', 'vanille', 'dessert', 'plat de résistance', 'beurre', 'fécule', 'sucre', 'cocktail'], 'Dessert', b912ad15-7546-408e-8786-c32c532fc4bc, '2025-09-26T15:40:08.231194', [{'ingredient_id': '4038725d-ef4f-4385-9dd3-6a00de126e58', 'quantite': '1.3 kg'}, {'ingredient_id': '4ee4f927-dbfc-40bc-a47d-cde421190e7b', 'quantite': '1.5 l'}, {'ingredient_id': 'ed13a883-6725-4f85-a26f-32b3aef1157e', 'quantite': ''}, {'ingredient_id': '4eb7b5d4-48dc-4aff-b070-f87ad98fbfb1', 'quantite': '150 g'}, {'ingredient_id': '454415cb-57f8-4329-8ab2-e8e8c1dd22e4', 'quantite': '1'}, {'ingredient_id': 'c7ac43bd-2eb3-482e-8693-7c5e02805411', 'quantite': '100 g'}, {'ingredient_id': '6fd04220-cc9f-42ae-bf6d-6f08f0285eb2', 'quantite': '20 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (37999, 'Confiture de fraises et bananes avec morceaux', 'fraises, banane, sucre', '15 min', ['Stériliser les pots de confiture en les plongeant dans l''eau bouillante et les mettre à sécher sur un torchon propre.', 'Eplucher les bananes, les couper très finement, puis les mettre dans une marmite ou une bassine a confiture.', 'Laver, équeuter et couper les fraises très finement aussi, puis les ajouter à la banane. Ecraser les fruits grossièrement.', 'Verser le sucre et cuire à feu doux en remuant régulièrement.', 'A partir de l''ébullition,poursuivre la cuisson 6 min (pas une de plus!) tout en écumant.', 'A la fin de la cuisson, remplir les pots immédiatement, les fermer et les retourner pendant 2 minutes pour stériliser les couvercles (attention aux risques de brûlure).'], ['Planche à découper', 'Batteur électrique', 'Fouet', 'Mixeur', 'Pince de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'confiture de fraise', 'testées', 'facile', 'bon marché', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre', 'Confiture de fraises et bananes avec morceaux', 'cocktail'], 'Confiserie', 3797625c-f089-4ba3-ae09-c25617d44ac5, '2025-09-26T15:40:11.889690', [{'ingredient_id': '12122a59-da31-40b2-865e-f79e7a48a0b7', 'quantite': '500 g'}, {'ingredient_id': 'f7c1254e-e7ed-4ee1-85e8-112ab45b1d03', 'quantite': '500 g'}, {'ingredient_id': 'cae8fc68-3a67-4b1e-8ec0-3342645d31b4', 'quantite': '600 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (45469, 'Salade exotique Mimi', 'pomme, banane, orange, arbouse, gingembre, sucre, citron, orange, menthe', '15 min', ['Couper les pommes en dés et les bananes en rondelles; et placer le tout dans un saladier. ', 'Verser 1 cuillère à soupe de jus de citron.', 'Ajouter la dizaine d''arbouses et les quartiers d''oranges.', 'Saupoudrer la préparation de sucre et de gingembre fraîchement râpé.', 'Préparer le jus : ', 'Verser dans un bol le jus d''1 orange et d''1/2 citron. ', 'Ajouter le jus d''arbouses (assez sucré), à votre goût; verser sur la salade de fruits et décorer d''une feuille de menthe.'], ['Planche à découper', 'Spatule', 'Râpe'], ['arbouse', 'gingembre', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Salade exotique Mimi', 'très facile', 'menthe', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'citron', 'orange', 'sucre', 'salade de fruits exotiques', 'cocktail'], 'Dessert', 3d672196-11d1-4241-9b84-64b83782e8d3, '2025-09-26T15:40:15.600485', [{'ingredient_id': '0509ef83-30d9-4892-9235-150d2d0b21ca', 'quantite': '3'}, {'ingredient_id': '01faad41-15e4-43dc-a532-2a62df1c3c00', 'quantite': '2'}, {'ingredient_id': '970bf8ea-10f5-4f33-b612-b549ad4e3a1c', 'quantite': '2'}, {'ingredient_id': '4c9767d8-61dd-447c-be35-6b63cdd11d78', 'quantite': '12'}, {'ingredient_id': 'b42f5410-ecaa-4f2c-9242-43c24e626e7d', 'quantite': '2'}, {'ingredient_id': '82dec5c3-22cb-4227-bbf2-523977a9fa97', 'quantite': '2 cuillères'}, {'ingredient_id': 'b961e4b2-41d4-448f-831f-12673626eff1', 'quantite': '1'}, {'ingredient_id': '803f3d52-543d-46c3-9819-0f540d00b7fd', 'quantite': '1'}, {'ingredient_id': '76e20c90-6b64-4fd2-a98b-a6b37dd093c2', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (42864, 'Sauce curry / pomme / banane', 'oignon, pomme, banane, beurre, curry, gingembre, brique', '10 min', ['Eplucher l''oignon, et le couper en morceaux hyper fin.', 'Faire fondre le beurre, et faire revenir l''oignon (sans le faire griller!).', 'Ajouter la pomme et la banane, coupées en petit cubes. Laisser fondre le mélange.', 'Ajouter ensuite la crème, le curry, et le gingembre. Saler et poivrer.', 'Laisser mijotter à feu très doux.'], ['Spatule', 'Casserole'], ['gingembre', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'Autres sauces', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'beurre', 'curry', 'brique', 'cocktail', 'Sauce curry / pomme / banane'], 'Sauce', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:40:19.153534', [{'ingredient_id': '80c18778-e00f-450f-b6a5-e9c856af57dd', 'quantite': ''}, {'ingredient_id': '895d5e0a-e545-4e03-98a3-0e1a2997c994', 'quantite': '1'}, {'ingredient_id': '3cda5dc5-d406-4015-9dc3-87c49796780e', 'quantite': '1'}, {'ingredient_id': '15866ad6-6aa6-44e6-a422-95fdb23d6617', 'quantite': '20 g'}, {'ingredient_id': '63dd3c97-0c30-4db1-9b12-94da7fec63a4', 'quantite': '2 cuillères'}, {'ingredient_id': 'd925710b-9894-4db6-9516-875d48eec1cd', 'quantite': ''}, {'ingredient_id': '39b73e84-3d88-4f6f-854e-71d47ec3e329', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (359666, 'Agneau aux groseilles et banane', 'côte d''agneau, sucre, groseilles, coriandre, cumin, cannelle, paprika, banane, cresson, citron, vin rouge, poivre', '15 min', ['Préchauffez votre four sur la fonction grill. Pendant ce temps, commencez la préparation de la sauce.
Dans une casserole, mélangez le vin et le sucre jusqu''à complète dissolution.
Ajoutez la moitié des épices (la coriandre, le cumin, la cannelle, le paprika et le poivre).', 'Après avoir lavé les groseilles, réservez 4 grappes pour dresser les assiettes et égrainez les autres. ', 'Ajoutez-les à la sauce obtenue dans la casserole. Portez l''ensemble très progressivement à ébullition, sans cesser de remuer. ', 'Baissez ensuite le feu et laissez réduire environ 15 minutes jusqu''à ce que la consistance de la sauce soit devenue sirupeuse.', 'Roulez généreusement les côtes d''agneau dans la deuxième partie du mélange d''épices, et poivrez-les. ', 'Passez-les sous le grill de votre four entre 2 et 3 minutes par face.', 'Rincez le cresson en laissant de côté les tiges trop importantes.', 'Pour le dressage des assiettes, commencez par verser un fond de sauce avant de déposer la côte d''agneau. Décorez selon vos envies avec le cresson et les grappes de groseilles restantes. 
Vous pouvez également utiliser des tomates cerise ou du persil par exemple.'], ['Louche', 'Presse-agrumes'], ['côtelettes', 'entrée', 'banane', 'côte d''agneau', 'recettes de cuisine', 'confiserie', 'testées', 'cumin', 'paprika', 'plat', 'moyenne', 'recette', 'cuisine', 'recettes', 'cresson', 'boisson', 'groseilles', 'vin rouge', 'dessert', 'plat de résistance', 'moyen', 'citron', 'Agneau aux groseilles et banane', 'coriandre', 'cannelle', 'sucre', 'poivre', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:40:22.801239', [{'ingredient_id': 'a4cc7c16-efe1-4b8f-8c14-f21f6a5584d8', 'quantite': '200 g'}, {'ingredient_id': '04c8ae76-a393-431c-83bd-2b724934bd01', 'quantite': '50 g'}, {'ingredient_id': '6a5df8e4-b04e-4dea-8c66-999d715f7c82', 'quantite': '200 g'}, {'ingredient_id': '70558811-3ece-448c-b2bc-8e3421b9f8c2', 'quantite': '3 cuillères'}, {'ingredient_id': 'f97a812a-4734-4497-9ead-b6c182293f2f', 'quantite': '2 cuillères'}, {'ingredient_id': 'f6833c75-f837-4a07-92fc-02db7af15861', 'quantite': '1 cuillères'}, {'ingredient_id': '533eadc7-071e-4f30-b11c-de232a45c155', 'quantite': ''}, {'ingredient_id': '3c80bc8b-7fa3-4180-ba5e-b10bdd551de2', 'quantite': '2'}, {'ingredient_id': '0aecbf69-38b6-4cb7-9a89-7ce4df3ee42b', 'quantite': '20 g'}, {'ingredient_id': 'afff5d0d-afc3-4aab-ab41-f253a4aa27e0', 'quantite': '10 g'}, {'ingredient_id': '3dddeb6b-0507-4827-8ccc-db3471da8b16', 'quantite': '70 cl'}, {'ingredient_id': 'cc0810f6-16a7-4764-9345-5bbb452c6e0d', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (50320, 'Pannequets de bananes', 'pâte à crêpe, banane, crème, orange, sucre en poudre, Noix concassée, huile de friture, jus d''orange', '20 min', ['Réserver un peu de pâte à crêpes (environ 2 c. à soupe) et faire cuire les crêpes en les gardant au chaud quand elles sont cuites.', 'Couper les bananes en rondelles puis écraser les bananes à la fourchette jusqu''à ce qu''elles soient lisses et sans morceaux.', 'Incorporer le yaourt, le zeste, 1 cuillère à soupe de sucre et les noix.', 'Au milieu de chaque crêpe, placer environ 2 cuillères à soupe de mélange à la banane en étalant légèrement.', 'Enduire d''un peu de pâte à crêpes réservée le bord de la crêpe le plus éloigné de vous.', 'Rouler la crêpe à partir du bord devant vous pour en faire un paquet et appuyer sur l''extrémité enduite de pâte crue pour souder le pannequet.', 'Faire chauffer l''huile à 185°C et déposer précautionneusement les pannequets dans l''huile.', 'Faire frire 2 minutes, ils doivent être croustillants et dorés.', 'Les mettre au fur et à mesure sur du papier absorbant avec une écumoire.', 'Quand ils sont tous prêts, arroser du jus d''orange et saupoudrer du reste du sucre.', 'Servir immédiatement.'], ['Spatule', 'Poêle', 'Râpe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'huile de friture', 'bon marché', 'rapide', 'plat', 'crème', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'pâte à crêpe', 'dessert', 'plat de résistance', 'Noix concassée', 'orange', 'jus d''orange', 'cocktail', 'Pannequets de bananes'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:40:27.434192', [{'ingredient_id': '9693ce69-51c4-4223-b21b-350eafbf8645', 'quantite': '25 cl'}, {'ingredient_id': 'e10d93ac-5e09-4762-82c3-84ae0b6705f5', 'quantite': '4'}, {'ingredient_id': 'b95e21ef-4401-4768-bcb8-1cc8e0d5609b', 'quantite': '4 cuillères'}, {'ingredient_id': 'b05c49f0-2e95-4367-bc71-72989f53b41f', 'quantite': '1'}, {'ingredient_id': '0f046b66-5d64-4d42-94f9-0bd9cbe62206', 'quantite': '3 cuillères'}, {'ingredient_id': 'ecdf4223-00a0-4633-8fb2-dfa51713a52b', 'quantite': '120 g'}, {'ingredient_id': 'b7f1a571-78a1-419a-bb8e-9975f1819347', 'quantite': ''}, {'ingredient_id': '5e8b2c06-fff6-42d9-b367-959ecceb0b02', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (34779, 'Melon surprise aux saveurs exotiques', 'melon, kiwi, mangue, banane, litchi, orange, citron, sucre', '25 min', ['Couper les melons en 2 et les épépiner. Mettre au frais.', 'Eplucher kiwi, mangue, banane, litchis et orange. Les couper en petits quartiers ou en petits cubes. Arroser avec le jus d''un citron. Ajouter un peu d''édulcorant si nécessaire. Placer au réfrigérateur.', 'Garnir les melons avec les fruits refoidis.', 'Servir bien frais.'], ['Balance de cuisine', 'Tire-bouchon', 'Rouleau à pâtisserie', 'Louche', 'Moule à tarte'], ['', 'melon', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'Melon surprise aux saveurs exotiques', 'testées', 'très facile', 'rapide', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'citron', 'orange', 'sucre', 'litchi', 'cocktail'], 'Dessert', be48ffa6-246e-4c45-8f1e-b29fc2641231, '2025-09-26T15:40:32.519785', [{'ingredient_id': '11acab14-defb-4279-b2d3-8bd13e4b1ce6', 'quantite': '2'}, {'ingredient_id': '0d0ef783-9970-45d9-9696-ac178cae3acd', 'quantite': '1'}, {'ingredient_id': '3779e9df-a2a9-4121-bbbe-8913aaf098a3', 'quantite': ''}, {'ingredient_id': 'e899f517-4af9-4af6-a06d-a48a2f97be8b', 'quantite': '1'}, {'ingredient_id': '9184855b-6272-4e42-b501-1d836758e0cc', 'quantite': '4'}, {'ingredient_id': '116a426d-47f0-417e-9ed3-b8ac82123c3a', 'quantite': '1'}, {'ingredient_id': '98d79ad7-8486-4171-9b0e-eeb31ee6ae77', 'quantite': ''}, {'ingredient_id': '58495e2c-d3fe-4961-a393-d5b7fdb3c555', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (57080, 'Bananes et poitrine fumée', 'banane, poitrine fumée', '10 min', ['Couper les bananes en 4 tronçons.', 'Les tronçons doivent faire à peu près 4 cm environ.', 'Enrouler la bande de poitrine fumée autour d''un tronçon puis maintenir à l''aide d''un cure dent.', 'Une fois tous les tronçons prêts, les installer dans un plat allant au four.', 'Laisser cuire environ 15 minutes.', 'Vérifier la cuisson à l''aide d''un couteau.', 'La chair des bananes doit être bien ramollie.', 'La cuisson peut également se faire à la poêle.'], ['Économe', 'Tire-bouchon'], ['', 'bon marché', 'boisson', 'recettes', 'banane', 'entrée', 'recettes de cuisine', 'plat', 'Bananes et poitrine fumée', 'dessert', 'confiserie', 'recette', 'testées', 'plat de résistance', 'cocktail', 'poitrine fumée', 'cuisine', 'très facile'], 'Amuse-gueule', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:40:36.098495', [{'ingredient_id': '2d12ec56-437e-4930-a058-37b258a91226', 'quantite': '4'}, {'ingredient_id': '6d3c87b5-dfae-4eb7-9a24-eea157d3c9c3', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (25956, 'Gâteau moelleux aux bananes', 'farine complète, beurre demi-sel, cassonade, banane, oeuf, crème liquide, cannelle, levure chimique', '25 min', ['Faites préchauffez le four à 200°C. ', 'Dans une poêle, faites caraméliser les bananes tranchées saupoudrées d''une cuillère à soupe de cassonade dans 15-20 g de beurre salé. Saupoudrez d''une cuiller à café de cannelle. Réservez. ', 'Dans un saladier battez les oeufs en omelette avec le sucre, la crème et 1 cuiller à café de cannelle. ', 'Ajoutez ensuite la farine et la levure. ', 'Incorporez ensuite le beurre fondu chaud et mélangez délicatement. ', 'Terminez avec les bananes et veillez à bien les répartir dans la pâte. ', 'Versez la pâte dans le moule à manqué et enfournez 40 mn. ', 'La cuisson est terminée quand le gâteau est doré et que la lame de couteau ressort sèche. ', 'Démoulez le gâteau encore chaud (environ maximum 1 h après sortie du four) Dégustez-le complètement refroidi.'], ['Râpe', 'Rouleau à pâtisserie', 'Spatule'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'cassonade', 'levure chimique', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'beurre demi-sel', 'boisson', 'crème liquide', 'dessert', 'plat de résistance', 'farine complète', 'Gâteau moelleux aux bananes', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:40:42.899802', [{'ingredient_id': '0a13c15c-9c5b-458e-b57e-5cfed59d10e1', 'quantite': '200 g'}, {'ingredient_id': '18670e60-4665-41ef-9bac-086e02c31241', 'quantite': '125 g'}, {'ingredient_id': '01cc1c74-614b-4787-b7f2-05339d460a7d', 'quantite': '150 g'}, {'ingredient_id': '59bc9e78-0af4-4780-9a86-a44c87e163d0', 'quantite': '3'}, {'ingredient_id': '32d6e438-6624-4d0a-a76c-c170f781e41a', 'quantite': '4'}, {'ingredient_id': '7d1e5422-0cdf-4058-9786-43261005c0c6', 'quantite': '20 cl'}, {'ingredient_id': 'b6b0913c-d9df-4fa9-bc2e-1491bc914ac8', 'quantite': '2 cuillères'}, {'ingredient_id': 'f651ea35-af05-4105-b698-52faf4c50184', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (72818, 'Smoothie Violet (Banane, Cassis et Soja)', 'lait de soja, banane, cassis, cannelle, sucre', '5 min', ['Mixer le tout environ 30 secondes !', 'C''est la consistance que j''aime mais vous pouvez rajouter du lait de soja si cela vous parait trop épais ou un peu de banane si c''est trop liquide.'], ['Louche', 'Mixeur', 'Économe', 'Tire-bouchon'], ['cassis', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Cassis et Soja)', 'très facile', 'bon marché', 'rapide', 'Smoothie Violet (Banane', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'lait de soja', 'cannelle', 'sucre', 'smoothies', 'cocktail'], 'Boisson', 1bbf76fc-dec1-4652-bcab-1659df9f0cf5, '2025-09-26T15:40:46.494447', [{'ingredient_id': '3f92722f-0cdc-4c9f-bec8-cd4adb265735', 'quantite': '15 cl'}, {'ingredient_id': 'a7589a0f-cbbe-432a-88f3-59b71d951ab1', 'quantite': '1'}, {'ingredient_id': '62d57388-5858-4fc3-9a2c-0467bcd1f25c', 'quantite': '2'}, {'ingredient_id': 'bdd0df78-0235-4174-9b2c-454103eb3b0d', 'quantite': '1'}, {'ingredient_id': '670a9fdf-5efe-4586-9be2-51a1b46ac9eb', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (167994, 'Papillote de Poisson façon Thaï', 'poisson, citronnelle, échalote, piment, citron vert, carotte, courgette, haricots plats, brocoli, nuoc mam, galanga, ciboulette, coriandre, lait de coco, feuille de bananier', '20 min', ['- Couper le poisson en gros dés.', '- Arroser le poisson avec 2cs de nuoc mam.', '- Poivrer.', '- Couper les carottes en julienne (réserver)', '- Couper la courgette en rondelles (réserver)', '- Mélanger 3 tiges de citronnelle émincées + 1 échalote émincée + 2 zest de citrons verts + 2cm de galanga + ciboulette thaï.', '- Mixer le plus finement possible.', '- Prélever la crème sur le dessus d''une boîte de lait de coco (Ne pas secouer la boîte avant utilisation).', '- Ajouter la purée d''épices à la crème de coco.', '- Bien mélanger.', '- Répartir les dés de poisson sur des feuilles de bananier lavées (ou aluminium).', '- Recouvrir avec les rondelles de courgette, la julienne de carotte et quelques haricots plats', '- Recouvrir avec la crème de coco.', '- Ajouter 1 piment oiseau émincé (en fonction des goûts).', '- Ajouter un peu de ciboulette thaï ciselé + quelques feuilles de coriandre.', '- Fermer la papillote.', 'Cuire 30 à 45 min au four (ou BBQ).', 'Servir avec un riz collant'], ['Fouet', 'Balance de cuisine'], ['lait de coco', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'carotte', 'brocoli', 'plats thaï', 'facile', 'bon marché', 'plat', 'ciboulette', 'feuille de bananier', 'recette', 'galanga', 'piment', 'cuisine', 'recettes', 'boisson', 'poisson', 'nuoc mam', 'citronnelle', 'dessert', 'plat de résistance', 'haricots plats', 'Papillote de Poisson façon Thaï', 'coriandre', 'citron vert', 'courgette', 'cocktail', 'échalote'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:40:50.134549', [{'ingredient_id': '1042a7d3-45a5-4e6f-b6c2-ccf7755feec3', 'quantite': '600 g'}, {'ingredient_id': '1deb0e63-b183-48c3-9630-ff0c5f9934cc', 'quantite': '3'}, {'ingredient_id': '8da1d1a5-68b7-4223-a894-23cb48eed8d9', 'quantite': '1'}, {'ingredient_id': 'c3d1d3a5-fd35-4a78-96fd-76d2f28ce7db', 'quantite': '1'}, {'ingredient_id': 'af537bd8-964c-4b29-9946-b72ce11f6ce7', 'quantite': '2'}, {'ingredient_id': '5403a722-530c-4284-bb72-28073dca6646', 'quantite': '2'}, {'ingredient_id': '38c61061-efaa-415c-914a-9753c32d9bd9', 'quantite': '1'}, {'ingredient_id': '8534d4ed-b76b-40be-ada7-66b69420a527', 'quantite': '1'}, {'ingredient_id': '7d4f4a83-208f-48de-9f86-73adab05c21d', 'quantite': '1'}, {'ingredient_id': 'ca2af27e-29be-4cf3-ac5e-774bf50ef3e3', 'quantite': ''}, {'ingredient_id': 'b731ebc9-d101-4c47-b8aa-e95998895277', 'quantite': '2'}, {'ingredient_id': 'b252941f-520c-45d7-a740-7254107bf05e', 'quantite': ''}, {'ingredient_id': '227526a7-2600-42d8-be67-39f609982b04', 'quantite': ''}, {'ingredient_id': 'e0963b7d-a693-4570-a471-4566a1162da0', 'quantite': '40 cl'}, {'ingredient_id': '32249f2c-964d-4435-8089-152ead8e274e', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (18655, 'Blanc de poulet, sauce à l''ananas', 'beurre, ananas, coriandre, piment, blanc de poulet, riz basmati, cube de bouillon, banane, coriandre, poivre, sel', '10 min', ['Préchauffez le four à 200°C, beurrez un plat à gratin. ', 'Versez les cubes d''ananas dans le bol du robot ménager avec le coriandre et le piment, mixez. ', 'Fendez les blancs de poulet dans leur épaisseur et salez poivrez à l''intérieur et extérieur. Farcissez de purée d''ananas. ', 'Posez-les dans le plat, nappez du reste de purée, faites cuire 20 mn à four chaud. ', 'Faites cuire le riz à l''eau bouillante salée et aditionnée du cube de bouillon. Egouttez le. ', 'Pelez et coupez la banane en rondelles. Mélangez-les au riz. ', 'Déposez un blanc de poulet par assiette, nappez le de la sauce, répartissez le riz et garnissez de brin de coriandre.'], ['Fouet', 'Balance de cuisine'], ['poulet en sauce', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'riz basmati', 'facile', 'sauce à l''ananas', 'plat', 'blanc de poulet', 'recette', 'cube de bouillon', 'piment', 'cuisine', 'recettes', 'boisson', 'dessert', 'Blanc de poulet', 'plat de résistance', 'moyen', 'beurre', 'ananas', 'coriandre', 'poivre', 'cocktail'], 'Plat principal', 8c8c9164-d44e-410e-9865-492f72f9886f, '2025-09-26T15:40:53.835513', [{'ingredient_id': '43226109-196d-41a0-afa8-ce8005c5d9ba', 'quantite': ''}, {'ingredient_id': 'e3ee963d-e9da-4d2d-9d1c-5116b6dd8f00', 'quantite': '1'}, {'ingredient_id': 'c04e5258-4642-47cd-816f-ca6a5c82aeac', 'quantite': '2 cuillères'}, {'ingredient_id': '2b590de9-2c63-4068-aa09-b2493a6bdab3', 'quantite': '1'}, {'ingredient_id': '82690691-3326-42fa-8375-df0425d99d53', 'quantite': '4'}, {'ingredient_id': '1941ad99-64e7-4d31-83f7-bbfe66e3bd0a', 'quantite': '200 g'}, {'ingredient_id': '0529e0d1-c04d-470d-affb-d10d1d596d6b', 'quantite': '1'}, {'ingredient_id': '04262b5f-66b4-4b60-84f4-298cce216732', 'quantite': '1'}, {'ingredient_id': 'e883a7ef-4d8c-4100-a808-eeda743c2138', 'quantite': ''}, {'ingredient_id': '31c09818-47d0-46f1-affc-b482beaac679', 'quantite': ''}, {'ingredient_id': 'f9602107-a13f-4c43-84e9-df93b781ab7d', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (68821, 'fondant fleur d''oranger bananes caramélisées', 'banane, farine, sucre, sucre vanillé, oeuf, huile, beurre, eau de fleur d''oranger, vanille', '15 min', ['Mettre les 3 noisettes de beurre dans une poêle chaude et laisser fondre, rajouter les bananes coupées en 2 dans le sens de la longueur.', 'Incorporer les 2 sachets de sucre vanillé et la vanille liquide et laisser caraméliser à feu doux.', 'Pendant ce temps préparer la pâte à gâteau: mélanger le sucre, la farine , les oeufs , l''huile et mélanger pour obtenir une pâte lisse.', 'Incorporer la fleur d''oranger et mélanger.', 'Beurrer un moule rond à gateau et tapisser le fond de pâte.', 'Disposer les banane uniformémént sur la pâte et recouvrir tout avec le restant.', 'Préchauffer votre four à 140°C (thermostat 4/5) et laisser cuire pendant 30 à 40 min (selon les fours).'], ['Batteur électrique', 'Mixeur', 'Balance de cuisine', 'Rouleau à pâtisserie'], ['', 'fondant fleur d''oranger bananes caramélisées', 'banane', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'farine', 'vanille', 'dessert', 'plat de résistance', 'sucre vanillé', 'beurre', 'eau de fleur d''oranger', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:40:57.486087', [{'ingredient_id': '7fb1dd7d-996e-4566-970c-e923a7d704db', 'quantite': '3'}, {'ingredient_id': 'cca4bfd8-6927-435b-9dd2-356191cf2a73', 'quantite': '125 g'}, {'ingredient_id': '5769e11f-1e64-4aa1-a037-b8bb34ec417e', 'quantite': '100 g'}, {'ingredient_id': '37988e4f-e202-4f87-abb7-53f9b2ac6067', 'quantite': '2'}, {'ingredient_id': '1638d1e7-67b3-426d-90eb-b840d3fe790a', 'quantite': '3'}, {'ingredient_id': 'a2f087d2-0116-4929-a5e5-89d8fdb79a5b', 'quantite': '15 cl'}, {'ingredient_id': '9ba3acb9-1e54-4505-9485-322e48fbade0', 'quantite': '3'}, {'ingredient_id': '38c02086-9953-46f0-931b-d7a7d8c6a903', 'quantite': '15 cl'}, {'ingredient_id': 'ea9badc7-8955-404a-a2e8-9408946279a2', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (32640, 'Aloko (Côte d''Ivoire)', 'banane plantain, sel, huile de palme', '20 min', ['Prendre des bananes plantain bien mûres, les couper en dés, les assaisonner avec du sel, faire chauffer de l''huile à 180°C (thermostat 6) dans une large poêle, faire frire les bananes jusqu''à ce qu''elles deviennent DORÉES.'], ['Spatule', 'Mixeur', 'Planche à découper', 'Rouleau à pâtisserie', 'Moule à tarte'], ['entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'facile', 'plats africains', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'banane plantain', 'Aloko (Côte d''Ivoire)', 'huile de palme', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:41:01.105106', [{'ingredient_id': '6a9bc566-fe04-41b1-a78c-c63edb86f9ea', 'quantite': '4'}, {'ingredient_id': '4aac8c56-ff0d-4a7c-80f9-532f961512ae', 'quantite': ''}, {'ingredient_id': '11d5677d-b0ac-42fc-9b3e-7e01c65495f8', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (69532, 'Charlotte chocolat banane', 'jaune d''oeuf, chocolat, lait, crème fraîche épaisse, gélatine, biscuits à la cuillère, jus de banane, banane, sucre, sirop', '40 min', ['Versez dans une assiette creuse du jus de banane. Ajoutez-y un peu de sirop de framboise.', 'Trempez les biscuits dans ce mélange et disposez les au fond et sur les bords d''un moule à charlotte en prenant soin d''en garder suffisamment pour pouvoir en mettre sur le dessus.', 'Faites fondre le chocolat et 50 g de sucre dans le lait. Lorsque le lait bout, ajoutez un à un les jaunes d''œufs en tournant vigoureusement. ', 'Faites épaissir la crème anglaise ainsi obtenue à feu très doux et en tournant continuellement. Lorsqu''elle commence à bouillir, retirez la aussitôt du feu.', 'Ajoutez-y la gélatine (préparée à l''avance), puis la crème fraîche lorsque le mélange a tiédi.', 'Mixez les bananes avec 50 g de sucre et 10 cl de jus de banane afin d''obtenir un coulis que vous ajouterez à la préparation. Versez le tout dans le moule.', 'Rajoutez des biscuits trempés sur le dessus de la charlotte, coupez si nécessaire le haut de certains biscuits pour mettre à niveau, puis placez la charlotte au réfrigérateur pendant 3 à 5h (jusqu''à ce qu''elle soit solidifiée).', 'Avant de servir, démoulez la charlotte en passant un couteau fin sur les bords du moule.'], ['Mixeur', 'Planche à découper', 'Casserole'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche épaisse', 'confiserie', 'testées', 'chocolat', 'biscuits à la cuillère', 'facile', 'bon marché', 'rapide', 'plat', 'jaune d''oeuf', 'Charlotte chocolat banane', 'jus de banane', 'recette', 'cuisine', 'recettes', 'boisson', 'charlotte au chocolat', 'dessert', 'plat de résistance', 'gélatine', 'sirop', 'lait', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:41:04.745761', [{'ingredient_id': '41cf9477-097f-4242-a643-400f80eecd7f', 'quantite': '5'}, {'ingredient_id': 'f2ad6b3b-3a84-4112-94be-edd975ea380b', 'quantite': '220 g'}, {'ingredient_id': '98948624-e096-4fd6-9810-1f985e660a5c', 'quantite': '3'}, {'ingredient_id': '0772ba84-1595-47ae-96fb-a4276510281b', 'quantite': '180 g'}, {'ingredient_id': '9c11bc36-fd0e-4fac-9c90-722a5e7d7369', 'quantite': '6'}, {'ingredient_id': 'aad3a96a-0607-43d7-bd98-9f52b53e9db5', 'quantite': '36'}, {'ingredient_id': '89d47e00-b401-4b0f-80f0-995e958a194c', 'quantite': ''}, {'ingredient_id': '612ed5db-6409-452d-91c8-4128a21bfcda', 'quantite': '2'}, {'ingredient_id': 'cf7f60fb-3b62-438b-8cc8-f63fb7220c2a', 'quantite': '100 g'}, {'ingredient_id': 'e35c7fa1-e5f9-46ba-9f46-383fcd025806', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (36370, 'Pizza banane chocolat', 'crème fraîche, banane, pâte à pizza, chocolat pâtissier, sucre, sucre vanillé', '10 min', ['Préchauffer le four à 210°C (thermostat 7).', 'Etaler la pâte à pizza sur un plan fariné. ', 'Couper les bananes en rondelle et couper le chocolat en copeaux.', 'Mélanger la crème fraîche, avec le sucre et le sucre vanillée.', 'Verser le mélange sur la pâte à pizza, puis disposer les bananes en rondelles et les copeaux de chocolat.', 'Enfourner pendant environ 15 min.', 'Servir chaud !!!'], ['Balance de cuisine', 'Batteur électrique', 'Fouet'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'chocolat pâtissier', 'cuisine', 'recettes', 'pâte à pizza', 'boisson', 'Pizza banane chocolat', 'dessert', 'plat de résistance', 'sucre vanillé', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:41:08.485362', [{'ingredient_id': '3f153da1-ed5f-4a20-8a35-9759dd09a127', 'quantite': '1'}, {'ingredient_id': 'aed90f02-3631-4fbe-b7f5-530978c3f7a9', 'quantite': '4'}, {'ingredient_id': '9d89ed60-f341-4e8d-9139-b18ea85e6fde', 'quantite': '1'}, {'ingredient_id': '4266f423-acb0-4745-8a9e-52d9799b9df3', 'quantite': '200 g'}, {'ingredient_id': '96d54c6a-1b96-405b-a494-f1ffc6386815', 'quantite': '75 g'}, {'ingredient_id': 'cf028b20-08b5-4a44-b17e-75bec1e6fefa', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (35886, 'Alokos ( bananes plantain frites )', 'banane plantain, huile de friture, sel', '5 min', ['Eplucher et couper les bananes en tronçons d''environ 5 mm d''épaisseur. Saler.', 'Faire chauffer un bain de friture à 180°C environ (pas le plus chaud d''une friteuse). Y plonger les bananes. Surveiller.', 'Quand un côté est bien doré, retourner les rondelles.', 'Bien égoutter avant de déguster.', 'Mieux vaut faire plusieurs fournées, car s''ils s''empilent, les alokos se collent les uns aux autres.'], ['Passoire', 'Pince de cuisine', 'Presse-agrumes', 'Casserole', 'Spatule'], ['', 'entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'huile de friture', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Alokos ( bananes plantain frites )', 'dessert', 'plat de résistance', 'banane plantain', 'cocktail'], 'Accompagnement', 5e6531ac-01f0-455d-9f53-2cbf3e35fd23, '2025-09-26T15:41:11.940208', [{'ingredient_id': '6ee4c3bf-87b6-4250-acac-fea925e1f817', 'quantite': '3'}, {'ingredient_id': 'd39b4a9a-5c77-485c-a313-8df344daffcf', 'quantite': ''}, {'ingredient_id': 'b926b182-1f66-4918-bbd0-9b546b5c5497', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (20988, 'Salade multi-fruits tropicale', 'ananas, arbouse, litchi, banane, orange, avocat, goyave, mangue, citron vert, rhum, sirop de canne, cannelle', '25 min', ['Peler tous les fruits et les avocats et leur ôter les noyaux et les pépins. Couper les bananes en rondelles, les oranges en quartiers et détailler les avocats, les mangues et les goyaves en dés.', 'Egoutter les fruits au sirop en gardant le jus. Les mélanger aux rondelles de bananes, aux quartiers d''oranges et aux dés d''avocats, de mangues et de goyaves.', 'A part, mélanger le sirop de canne avec le rhum, les jus du citron et des fruits. Arrosez les fruits avec ce liquide sans remuer.', 'Réserver au réfrigérateur au moins 2 h avant de servir.'], ['Tire-bouchon', 'Moule à tarte'], ['', 'arbouse', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'avocat', 'goyave', 'très facile', 'sirop de canne', 'rapide', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'orange', 'ananas', 'citron vert', 'Salade multi-fruits tropicale', 'cannelle', 'litchi', 'cocktail'], 'Dessert', 8a8a8ff4-5284-4946-9b19-004c333b2b4f, '2025-09-26T15:41:16.392069', [{'ingredient_id': '736a3b7a-88ef-4067-99d1-2091922e1c07', 'quantite': '250 g'}, {'ingredient_id': '5bb99ec8-9c03-4242-b301-f766a0afa627', 'quantite': '250 g'}, {'ingredient_id': '29efa6a4-47fc-4ca5-909d-df42d4d82150', 'quantite': '250 g'}, {'ingredient_id': '0a6cc727-9fb2-4821-99f0-bfd5c56a372d', 'quantite': '2'}, {'ingredient_id': 'e1ddecc4-3d7c-47cd-bb32-f53d5aa79d86', 'quantite': '2'}, {'ingredient_id': 'ad5874a0-9cdb-4844-88d8-80efda770d3f', 'quantite': '2'}, {'ingredient_id': 'd49ba70e-57af-4768-b641-87e2a3e8f165', 'quantite': '2'}, {'ingredient_id': 'bf727c71-7d8d-4ccf-8f8c-d0eaf2ee5ec8', 'quantite': '2'}, {'ingredient_id': '1fc3dc69-d04a-4f27-85c5-f39754768da5', 'quantite': '1'}, {'ingredient_id': '000e3a9d-2020-4b7a-9168-9bdb766a0ab0', 'quantite': '6 cl'}, {'ingredient_id': '522ab998-0ecf-4969-a856-fe17231f99b8', 'quantite': '30 cl'}, {'ingredient_id': 'c4f2e204-2d92-4217-a098-1194aab72541', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (68502, 'Tarte au rocher coco', 'noix de coco, sucre, beurre, oeuf, amandes en poudre, rhum, farine, pâte sablée, banane, citron vert, chocolat pâtissier', '30 min', ['Pour la préparation à rochers :', 'Sortez 100 g de beurre à température ambiante et coupez-le en petits morceaux pour qu''il ramollisse. Versez 50 g de poudre d''amandes, 50 g de noix de coco râpée et 100 g de sucre dans une terrine.', 'Incorporez le beurre ramolli dans la terrine en mélangeant énergiquement à la cuillère en bois. Ajoutez un oeuf et mélangez à nouveau vivement. Ajoutez petit à petit 1 bonne cuillère à soupe de farine tamisée, puis 3 cl de rhum blanc.', 'Incorporez 70 g de noix de coco râpée à la pâte, puis 20 g de sucre et 2 jaunes d''oeuf. Mélangez avec soin.', 'Pour la préparation de la tarte :', 'Faites précuire à blanc un fond de tarte en pâte sablée (10 minutes au four à 180°C - thermostat 6).', 'Etalez dessus la préparation à rochers, puis des rondelles de bananes macérées dans du jus de citron vert. Poudrez de sucre et faites cuire au four à 160°C (thermostat 5-6) pendant 20 min.', 'Pour servir, nappez la tarte, si vous le voulez, de chocolat chaud fondu! Bon appétit pour les gourmands!'], ['Économe', 'Rouleau à pâtisserie'], ['entrée', 'recettes de cuisine', 'Tarte au rocher coco', 'rhum', 'confiserie', 'testées', 'facile', 'tarte noix de coco', 'amandes en poudre', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'moyen', 'beurre', 'noix de coco', 'sucre', 'cocktail'], 'Dessert', 51d20b8b-6023-4c45-8daf-26f9a9b5cb7d, '2025-09-26T15:41:20.857742', [{'ingredient_id': '9f2da42c-f846-4a1e-ad32-4bcb155d5be6', 'quantite': '120 g'}, {'ingredient_id': '30e5b48d-0c8c-4644-99a5-e1833948635c', 'quantite': '120 g'}, {'ingredient_id': 'ea64d14d-200d-4c7e-aba6-7d035df832fb', 'quantite': '100 g'}, {'ingredient_id': '3093368b-6272-447e-a297-78f72ee301f0', 'quantite': '1'}, {'ingredient_id': '4e338fdc-0b5b-472c-b1a3-d89024d164a2', 'quantite': '50 g'}, {'ingredient_id': '82a91cd7-9ca4-475e-8865-f217d365b2b8', 'quantite': '3 cl'}, {'ingredient_id': '30ea94b0-5cce-4bc9-b530-472357550394', 'quantite': '1 cuillères'}, {'ingredient_id': '8647e0cf-4e36-476c-9e61-efbe0c606856', 'quantite': '1'}, {'ingredient_id': 'f7f5b828-2963-4409-bd1c-4193e9d3f4fb', 'quantite': '1'}, {'ingredient_id': '5566d62f-0f4d-4683-bafa-edd7f836b561', 'quantite': '1'}, {'ingredient_id': '6f3826ec-6a7c-491c-ac8e-6230b00c3b5e', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (38986, 'Confiture fraise-mangue-banane', 'fraises, mangue, banane, citron, sucre, confiture', '30 min', ['Laver et couper les fraises. Eplucher et couper les mangues. Eplucher et couper les bananes,', 'Poser tous les fruits dans un saladier et ajouter le jus de citron, par dessus (1/2 citron).', 'Ajouter le sucre spécial confiture, bien mélanger et laisser reposer pendant 2 h.', 'Mixer grossièrement.', 'Transvaser la préparation, dans une casserole (pas trop petite, la préparation doit la remplir de moitié).', 'Cuire en mélangeant, régulièrement, à l''aide d''une cuillère en bois.', 'Lorsque la préparation bouillonne fortement, compter 4 min supplémentaires.', 'Remplir les pots de confiture, préalablement ébouillantés. ', 'Les refermer directement, et retourner le pot (attention aux risques de brûlure). Laisser refroidir.'], ['Passoire', 'Rouleau à pâtisserie', 'Fouet', 'Batteur électrique'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'confiture de fraise', 'confiture', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'mangue', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'citron', 'sucre', 'Confiture fraise-mangue-banane', 'cocktail'], 'Confiserie', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:41:24.555447', [{'ingredient_id': '1a77a685-9a7b-4826-b5b6-6ebbc424b2b1', 'quantite': '500 g'}, {'ingredient_id': 'd3aefe67-287d-4fed-92e1-1d0535e3240c', 'quantite': '2'}, {'ingredient_id': 'e3bfc404-82ae-4cec-920f-0b20f6c8955e', 'quantite': '2'}, {'ingredient_id': 'eee864fa-bcb0-4866-aedb-e0a0afd25604', 'quantite': '1'}, {'ingredient_id': '8dcc0e74-e3fe-4005-8828-a9f3af20a9f6', 'quantite': '1'}, {'ingredient_id': 'd674f32a-f202-49f5-975c-2bfdde33ff92', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (370749, 'Bowl cake "banane écrasée"', 'flocons d''avoine, pépites de chocolat, banane, oeuf, lait, levure, miel', '5 min', ['Pelez la banane et écrasez-la dans un bol à l''aide d''une fourchette.
Ajoutez le lait et l’œuf puis mélangez bien.
Ajoutez les flocons d''avoine, la levure chimique, le miel et les pépites de chocolat. Remuez bien.', 'Faites cuire pendant 2 à 3 minutes au micro-ondes à pleine puissance.', 'A la fin de la cuisson, laissez tiédir le bowl cake pendant 2 minutes puis démoulez dans une assiette.
Dégustez tiède décoré de rondelles de banane et de pépites de chocolat.'], ['Couteau de chef', 'Poêle', 'Râpe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'autres gâteaux', 'très facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'pépites de chocolat', 'recette', 'levure', 'cuisine', 'miel', 'recettes', 'boisson', 'Bowl cake "banane écrasée"', 'dessert', 'plat de résistance', 'lait', 'flocons d''avoine', 'cocktail'], 'Confiserie', 5aacfbdb-bdd5-4f53-b1a8-5263cabb6161, '2025-09-26T15:41:28.127995', [{'ingredient_id': 'e2fcf026-21f5-4887-80ed-08fb0fab6778', 'quantite': '40 g'}, {'ingredient_id': '222c82d0-a1d1-4468-bd7a-e9efa026736b', 'quantite': '25 g'}, {'ingredient_id': '4777b400-faae-4a6f-b86e-421c2b00dd36', 'quantite': '1'}, {'ingredient_id': '7902814d-c8d9-4ffd-9069-fe60bd69b7ef', 'quantite': '1'}, {'ingredient_id': 'e0e98ad3-621c-4e82-8e41-24a9b83356f1', 'quantite': '3 cuillères'}, {'ingredient_id': '4c19753c-5d97-4d4a-b8b7-da90c02c1067', 'quantite': '1'}, {'ingredient_id': 'fc067c71-4225-47d0-ada1-0b574203c14c', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (225727, 'Banane rôtie, sauce au chocolat et Grand Marnier', 'banane, crème fraîche, grand-marnier, chocolat noir, pistaches', '5 min', ['Placer les bananes non pelées durant 10 min au four préchauffé à 180°C (thermostat 6).', 'Dans un poêlon faire chauffer la crème fraîche et le grand Marnier ; y faire fondre le chocolat noir en mélangeant.', 'Couper les bananes non pelées dans la longueur et y verser la crème au chocolat.', 'Saupoudrer avec les pistaches hachées.', 'Bonne cuisine et bon appétit !'], ['Passoire', 'Balance de cuisine', 'Rouleau à pâtisserie', 'Pince de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'facile', 'rapide', 'plat', 'pistaches', 'recette', 'cuisine', 'recettes', 'boisson', 'sauce au chocolat et Grand Marnier', 'Banane rôtie', 'dessert', 'plat de résistance', 'chocolat noir', 'moyen', 'grand-marnier', 'cocktail'], 'Dessert', efa21c65-2f56-493b-9736-d4795be507e6, '2025-09-26T15:41:32.542778', [{'ingredient_id': '2f1dc533-dc9b-4e94-bc1a-18a934b02462', 'quantite': '4'}, {'ingredient_id': '5d201c0a-683d-4da2-905b-ef672811408c', 'quantite': '4 cuillères'}, {'ingredient_id': 'dd73ac17-00ca-40f4-8227-6dfa5071a0f4', 'quantite': '1 cuillères'}, {'ingredient_id': 'd554d333-ad79-4ee0-9db8-fb06d64d3d80', 'quantite': '100 g'}, {'ingredient_id': 'bd875fc3-e9b3-4745-9adf-84a1004eb8c9', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (20540, 'beignets de bananes plantain sucrés', 'banane plantain, sucre roux, huile de friture, sucre vanillé, citron vert', '10 min', ['Couper les deux extrémités de la banane. Inciser la peau sur toute la longueur afin de la peler facilement. ', 'Couper la banane en lamelles d''environ 5 mm dans le sens de la longueur, légèrement en biais. ', 'Faire chauffer l''huile dans une poêle. Faire frire les lamelles de bananes à feu moyen et les retourner de temps à autre pour qu''elles soient bien dorées sur les deux faces. ', 'Quand elles sont cuites, les égoutter et les poser sur du papier absorbant. Les saupoudrer de sucre roux, de sucre vanillé et de zeste de citron vert.'], ['Balance de cuisine', 'Économe', 'Ouvre-boîte'], ['entrée', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'huile de friture', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'beignets sucrés', 'dessert', 'plat de résistance', 'banane plantain', 'sucre vanillé', 'citron vert', 'beignets de bananes plantain sucrés', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:41:36.111557', [{'ingredient_id': '355d2af7-5532-466b-9b41-799e10776da9', 'quantite': '4'}, {'ingredient_id': '533009f3-5a8b-4b64-a4bb-69215f6b2a73', 'quantite': ''}, {'ingredient_id': '1ee27d19-ee14-4b1e-8609-4e765618b933', 'quantite': ''}, {'ingredient_id': '701f3084-54ed-48a9-b991-638217fd4a45', 'quantite': ''}, {'ingredient_id': '6ca9aac0-c997-479c-9a5c-9bd71ebca2ae', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (25914, 'Bananes en chocolat', 'chocolat, eau, sucre glace, banane', '15 min', ['Faire fondre le chocolat dans l''eau. ', 'Ajouter le sucre. ', 'Couper les bananes en deux, sur la longueur et retirer la chair sans abimer la peau. ', 'Dans le mélangeur, réduire en purée les bananes avec le mélange au chocolat. ', 'Remplir les 12 demi-peaux de bananes avec le mélange et mettre au congélateur environ 15-20 mn. ', '"réassembler" les bananes et les maintenir ensemble avec du papier d''aluminium. ', 'Mettre au frigo environ 2 heures. ', 'Vous aurez alors des bananes ayant la forme et la texture des vraie bananes, mais avec le goût et la couleur du chocolat :)'], ['Moule à tarte', 'Planche à découper', 'Verre doseur', 'Poêle'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'chocolat', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre glace', 'Bananes en chocolat', 'cocktail'], 'Dessert', 11245a70-1cbb-46b7-bf72-39b87c83b975, '2025-09-26T15:41:39.705115', [{'ingredient_id': '3f3c719f-e501-4042-b0d1-024737584dc8', 'quantite': '200 g'}, {'ingredient_id': '8025ecd9-729b-4398-9b2d-80f94252e5e8', 'quantite': ''}, {'ingredient_id': 'f58f7d5c-5c1d-4ada-beb4-21b3016b96c2', 'quantite': '100 g'}, {'ingredient_id': '0e0f3ff7-7754-4c18-8c93-c7dbd995baf2', 'quantite': '6'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (172356, 'Moelleux au chocolat et son rocher praliné', 'chocolat noir, oeuf, sucre, beurre, farine, praliné, banane', '20 min', ['Casser le chocolat en petit morceaux dans un bol, humidifier et mettre au micro-ondes pour le faire fondre (ou au bain marie).', 'Faire fondre le beurre et le mélanger au chocolat fondu.', 'Pendant que le chocolat tiédit un peu, casser les oeufs en séparant le blanc des jaunes.', 'Incorporer le sucre avec les jaunes à l''aide d''un fouet.', 'Ajouter ensuite la farine puis le chocolat mélangé au beurre fondu.', 'Battre les blancs en neige fermement. ', 'Incorporer les blancs à l apâte délicatement pour ne pas les casser.', 'Verser la pâte dans un moule beurré.', 'Introduire les 6 rochers pralinés en les alignant et en essayant de ne pas les recouvrir totalement (le dessus du rocher doit être légèrement visible).', 'Mettre au four pendant 25/30 minutes à 160°C.', 'A la sortie du four, disposer les 4 rondelles de banane sur le gateau, au niveau des rochers.', 'Laisser refroidir et démouler.'], ['Économe', 'Couteau de chef', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Moelleux au chocolat et son rocher praliné', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'chocolat noir', 'beurre', 'gâteau au chocolat', 'sucre', 'cocktail', 'praliné'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:41:44.377931', [{'ingredient_id': '70533a90-a5f8-40dd-90a1-c287c8a2ef95', 'quantite': '250 g'}, {'ingredient_id': '12abe7a4-c25c-4af2-a423-9b66e9373f66', 'quantite': '3'}, {'ingredient_id': '352db164-2967-4831-af1c-f97e4767ffe9', 'quantite': '150 g'}, {'ingredient_id': '4d185a6a-ecac-4fa6-b939-b93aa168b11e', 'quantite': '150 g'}, {'ingredient_id': '5bb89be3-7cf4-45eb-979e-15b3b1afb73a', 'quantite': '50 g'}, {'ingredient_id': 'c8883c30-09fd-4041-ad96-05b0d0caab42', 'quantite': '6'}, {'ingredient_id': '70725ca5-eda8-4d9b-b15b-650c55955783', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (17978, 'Brochettes de fruits au barbecue', 'pêche, banane, fraises, ananas, miel, sucre brun, beurre, rhum, cardamome', '10 min', ['Préparez la marinade en mélangeant le miel et le beurre fondu, puis le sucre, le rhum, la cardamome. ', 'Préparez les brochettes (de fines brochettes en bois d''environ 15 à 20 cm de long vont très bien): une fraise, un quartier de pêche, une rondelle de banane (assez épaisse), un morceau d''ananas, une fraise. ', 'Posez les brochettes dans un plat et arrosez avec la marinade, au moins une heure à l''avance. ', 'Faites cuire au barbecue sur un papier aluminium, en les retournant de temps en temps.'], ['Balance de cuisine', 'Tire-bouchon', 'Ouvre-boîte', 'Économe', 'Presse-agrumes'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'Brochettes de fruits au barbecue', 'dessert', 'plat de résistance', 'ananas', 'pêche', 'cocktail'], 'Dessert', 4fdef01d-3b4b-46b8-9807-9388571d01c8, '2025-09-26T15:41:48.028797', [{'ingredient_id': '6b757b37-2b99-45e8-876b-d4b18dd03c9d', 'quantite': '1'}, {'ingredient_id': '60784705-c26e-479b-9e6d-832b7a3e253d', 'quantite': '1'}, {'ingredient_id': '9928e7d0-8208-4e59-aa2c-6823609cf874', 'quantite': '24'}, {'ingredient_id': 'deb576da-37ff-4748-b086-32a6d6159f81', 'quantite': ''}, {'ingredient_id': 'c27dd07c-23fa-490a-ad85-e085194637a1', 'quantite': '2 cuillères'}, {'ingredient_id': 'd9403f47-d376-41e3-943b-9b49f5de626a', 'quantite': '2 cuillères'}, {'ingredient_id': 'dbc283a4-412b-4e9b-8813-b8fc6ac23256', 'quantite': '25 g'}, {'ingredient_id': '692ffdc5-897a-4678-85d7-ba03b06e2022', 'quantite': '1 cuillères'}, {'ingredient_id': '2724d1b5-88da-403b-b1d6-34a1be38eca7', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (28179, 'Gratin de fruits exotiques rapide', 'pomme, ananas, kiwi, banane, mangue, beurre, rhum, sucre en poudre, sucre vanillé', '20 min', ['1) Epluchez les fruits, coupez-les en tranches fines (ou en dés). ', '2) Etalez un peu de beurre au fond d''un plat à gratin, répartissez toutes les tranches (je mets la mangue en dernier). Arrosez de rhum, saupoudrez de sucre, puis de sucre vanillé. ', '3) Répartissez le reste du beurre en noisettes et mettez à gratiner pendant 10 mn environ sous le grill préchauffé.'], ['Fouet', 'Poêle', 'Pince de cuisine'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'mangue', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'beurre', 'ananas', 'Gratin de fruits exotiques rapide', 'cocktail'], 'Dessert', 4739b22e-8ead-4791-b72b-4ff405ddc61e, '2025-09-26T15:41:51.694002', [{'ingredient_id': '8ef93ddb-d5af-4740-a59e-36bff2cfb5fa', 'quantite': '2'}, {'ingredient_id': '29fb3624-db75-40e4-9b5f-a9d74ad7bbcc', 'quantite': ''}, {'ingredient_id': 'c359bca2-b0c4-48df-a702-906d16997a9d', 'quantite': '2'}, {'ingredient_id': '86dd3fe4-b49e-489a-b10e-b5536422b74d', 'quantite': '2'}, {'ingredient_id': '2703a4bc-27f8-4908-afe2-c3df078f2eee', 'quantite': '1'}, {'ingredient_id': '5cc59da7-6d74-4033-b9ee-a370bb378c9a', 'quantite': '50 g'}, {'ingredient_id': '12a748ea-6b92-4574-959f-63b195218ad7', 'quantite': '10 cl'}, {'ingredient_id': 'aa3cfae8-c620-4c48-9c2e-89b0236d4f33', 'quantite': '50 g'}, {'ingredient_id': '38f941aa-dba4-4459-a9e1-ac702c8d01ba', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (11036, 'Bonbons de fruits au blanc glacé', 'carré frais, jus de citron, miel, banane, poire, sucre, sucre glace', '15 min', ['Mélanger les carré frais, le jus de citron et le miel. Mettre la préparation au congélateur.', 'Couper la banane en rondelle, et la poire en petits cubes. Disposer les fruits au centre d''une assiette.', 'Préparer un caramel avec le sucre et 2 cuillères à soupe d''eau.', 'Dès que le caramel bruni, le verser sur les fruits et laisser refroidir.', 'Sortir la préparation du congélateur, former une jolie boule et disposer sur les bonbons de fruits.', 'Technique de dégustation : avec la petite cuillère, prendre un petit peu de blanc, et un fruit caramélisé.', 'L''association du sucré croquant et de l''acide très froid est sensationnel.'], ['Passoire', 'Moule à tarte', 'Ouvre-boîte', 'Râpe'], ['', 'carré frais', 'banane', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'Bonbons de fruits au blanc glacé', 'cuisine', 'miel', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'jus de citron', 'sucre glace', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:41:56.415653', [{'ingredient_id': 'bfa76e38-758d-4396-acae-faeca9d0d3be', 'quantite': '3'}, {'ingredient_id': '1c3444cd-d65b-4c27-9626-00ab1fb65e16', 'quantite': '2 cuillères'}, {'ingredient_id': '07e9414b-3fb7-423f-8fed-80e6e012a55c', 'quantite': '1 cuillères'}, {'ingredient_id': '4b9e8898-406f-4d2c-a233-c4a0d355063a', 'quantite': '1'}, {'ingredient_id': '347d9150-9b69-44fc-bdee-dd0383ffdc26', 'quantite': '1'}, {'ingredient_id': '7213f1e2-4a17-4cb6-b7de-e442dc1ef2f4', 'quantite': '10'}, {'ingredient_id': '998a0941-3fe2-4fb7-a570-1aad688cb690', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (70186, 'Muffins banane Nutella', 'beurre demi-sel, oeuf, farine, levure, sucre glace, banane, Nutella', '10 min', ['Préchauffez le four chaleur tournante à 180°C, thermostat 6.', 'Dans un saladier, mélangez le beurre et le sucre glace. Incorporez un à un les oeufs, puis la farine.', 'Ajoutez ensuite la banane écrasée.', 'Versez la moitié de la préparation dans les 6 moules (ou caissettes à muffins), puis déposer un cuillerée à café de Nutella et recouvrez avec le reste de la pâte.', 'Faire cuire 25 min environ.', 'Démoulez quand c''est tiède.'], ['Rouleau à pâtisserie', 'Mixeur', 'Poêle'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'Muffins banane Nutella', 'beurre demi-sel', 'boisson', 'farine', 'Nutella', 'dessert', 'plat de résistance', 'muffin', 'sucre glace', 'cocktail'], 'Confiserie', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:42:01.063231', [{'ingredient_id': '9bf1f77a-1c13-4332-9ca6-568040c195e6', 'quantite': '125 g'}, {'ingredient_id': '9e7093b0-559c-4b53-b2f9-98f2340a9219', 'quantite': '3'}, {'ingredient_id': '67ca0bb6-5409-4374-9892-40a3661a0bfa', 'quantite': '150 g'}, {'ingredient_id': '61b4475c-8fb0-42d8-989c-53da07329e00', 'quantite': '1'}, {'ingredient_id': 'e789eb95-798b-4b09-9f46-6b27ce670edf', 'quantite': '125 g'}, {'ingredient_id': '2241941c-5bf5-4668-bb6c-bc3a68ad8dad', 'quantite': '1'}, {'ingredient_id': '4aabbe56-b477-49ca-a7b9-d2f6bcfa4cac', 'quantite': '6 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (166214, 'Nuages banane chocolat', 'banane, chocolat en poudre, sucre vanillé, blanc d''oeuf, chocolat pâtissier, sucre glace', '15 min', ['Faire revenir les bananes au beurre dans une poële. ', 'Hors du feu, ajouter le sucre vanillé. ', 'Mixer le tout et ajouter le chocolat en poudre. ', 'Battre le blanc en neige bien ferme et l''incorporer au mélange.', 'Verser la préparation dans les verrines (ou ramequins). ', 'Mettre au réfrigérateur pendant deux heures. ', 'Râper le chocolat en copeaux. ', 'Avant de servir, saupoudrer de sucre glace et ajouter les copeaux de chocolat. Servir bien frais. ', 'Bon appétit!'], ['Ouvre-boîte', 'Poêle'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'chocolat pâtissier', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'Nuages banane chocolat', 'sucre glace', 'chocolat en poudre', 'blanc d''oeuf', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:42:05.123037', [{'ingredient_id': 'ab1307f1-fd53-409a-9be7-40ab0dcb58f8', 'quantite': '4'}, {'ingredient_id': '105daf71-3174-4458-ac02-b0de8f928717', 'quantite': '50 g'}, {'ingredient_id': 'b197440d-dd0c-4455-82dd-400c4ab60b47', 'quantite': '1'}, {'ingredient_id': 'a05e89ce-4d2f-4fac-a06c-09a7b4326cbf', 'quantite': '1'}, {'ingredient_id': 'a5c58043-f3cf-47fa-bbc3-da9d65e7fe25', 'quantite': ''}, {'ingredient_id': 'b27d8278-9742-42eb-b54b-51f1ee46fbca', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (87550, 'Muffins chocolat poire/banane super légers', 'chocolat, beurre, sucre roux, oeuf, sel, farine, levure, lait, poire, chocolat', '15 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Mettre le chocolat à fondre avec le beurre au micro-ondes.', 'Le mélanger avec les œufs, le sucre roux et la pincée de sel.', 'Ajouter farine, levure et lait. Bien mélanger pour avoir une pâte homogène. ', 'Ajouter soit les poires en morceaux, soit les bananes (ou les deux si vous voulez, c''est très bon aussi).', 'Mettre la pâte dans des moules à muffins (vous pouvez mettre des pépites de chocolat par dessus) et enfourner pendant 20 min, bien surveiller.', 'Laisser refroidir les muffins et déguster sans complexes.'], ['Économe', 'Tire-bouchon', 'Balance de cuisine', 'Louche'], ['entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'chocolat', 'poire', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'muffin', 'beurre', 'Muffins chocolat poire/banane super légers', 'lait', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:42:08.971324', [{'ingredient_id': '02b9b1cd-ccf2-448e-96f6-e61875f25d16', 'quantite': '150 g'}, {'ingredient_id': '12cf5801-ad4b-40ff-9e85-bd6f37c2cd17', 'quantite': '35 g'}, {'ingredient_id': '7ae41733-a35f-4c12-abb4-884c2efed19a', 'quantite': '100 g'}, {'ingredient_id': 'be80db6b-e6d0-4a28-88e1-51235d371a9b', 'quantite': '3'}, {'ingredient_id': 'bc4f29b5-6b00-4e51-9b9b-d91a0ac74513', 'quantite': '1'}, {'ingredient_id': 'b19bc26e-0412-4ca4-a7d4-83e3acb0a666', 'quantite': '225 g'}, {'ingredient_id': '58d1e373-b937-403f-a1eb-4fda1bd973ee', 'quantite': '1'}, {'ingredient_id': 'bc5c30aa-87a2-4867-8297-8e97ae56c442', 'quantite': '13 cl'}, {'ingredient_id': '54a0bab9-d59e-4288-80a5-0d73069de624', 'quantite': '2'}, {'ingredient_id': '4e25c0d0-44de-45f3-8cfc-90c2c55ce2c0', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (92864, 'Tarte au lait de coco aux bananes ou aux pommes', 'pâte feuilletée, oeuf, sucre de canne, sucre vanillé, lait de coco, banane, pomme', '15 min', ['Préchauffer le four thermostat 5, 150°C.', 'Mettre la pâte feuilletée dans un moule à tarte, la piquer avec une fourchette.', 'Suivant le fruit choisi, éplucher, couper en rondelles ou en morceaux et disposer sur le fond de tarte.', 'Dans un récipient, casser les oeufs en séparant les blancs des jaunes.', 'Monter les oeufs en neige, ajouter progressivement le sucre vanillé, le sucre de canne sans arrêter de battre les blancs.', 'Bien secouer et ouvrir la boîte de lait de coco, la verser dans le récipient où il y a les jaunes d''oeuf, mélanger au fouet ou à la fourchette.', 'Incorporer doucement ce mélange aux blancs en neige avec une spatule.', 'Verser sur les fruits, mettre au four pour 30 min environ.', 'Le gâteau est cuit lorsque le dessus est marron clair. Sortir du four et laisser refroidir avant de démouler.', 'Si vous n''avez pas de fonds de tarte, vous pouvez le réaliser en versant la préparation dans un plat à bord haut, préalablement beurré.'], ['Presse-agrumes', 'Fouet'], ['lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'Tarte au lait de coco aux bananes ou aux pommes', 'oeuf', 'plat', 'tarte aux pommes', 'recette', 'cuisine', 'recettes', 'boisson', 'sucre de canne', 'dessert', 'plat de résistance', 'pâte feuilletée', 'sucre vanillé', 'pomme', 'moyen', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:42:12.636472', [{'ingredient_id': '7b07152a-815b-4c8e-bb5a-579cd504fc43', 'quantite': '1'}, {'ingredient_id': '61fd61cb-c457-469f-b5a8-954e5849c6d4', 'quantite': '4'}, {'ingredient_id': '1125cfe8-e3fb-43f2-93d3-87768547e2be', 'quantite': '100 g'}, {'ingredient_id': '2ca955b4-bc18-4099-b21a-0e7003ee5316', 'quantite': '2'}, {'ingredient_id': 'dd77baf8-b090-49b8-9948-b9d8e219bee7', 'quantite': '1'}, {'ingredient_id': 'e1d97f1c-3e06-401e-a0bd-1c39a24834f1', 'quantite': '3'}, {'ingredient_id': '9a214547-c655-4931-8750-005da159e2e5', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (314631, 'Cake croustillant ananas-banane', 'oeuf, sucre roux, beurre doux, farine, levure, vanille, citron vert, ananas, banane, rhum', '15 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Faire ramollir le beurre.', 'Dans un saladier, mélanger les œufs entiers avec le sucre, faire blanchir, ajouter le beurre mou (pas fondu hein !) jusqu''à obtenir un mélange mousseux.', 'Ajouter la vanille, puis la farine et la levure, la banane écrasée, le jus du citron vert, l''ananas.', 'Le mélange doit être onctueux.', 'Beurrer et fariner le moule à cake, verser la préparation, enfourner à 180°C pendant 20 min, puis baisser la température à 150°C et laisser cuire encore pendant au moins 40 min, veiller à la fin de cuisson en plongeant le couteau.', 'Le cœur restera bon mais humide, ici on dit patia, ce qui va bien avec le croustillant.', 'Si vous préférez une cuisson homogène, baisser le four à 120-130°C, vous pourrez prolonger la cuisson encore 10 min.', 'Si vous avez des craintes pour le démoulage, vous pouvez chemiser le moule au papier cuisson, je vous conseille du coup de mettre quelques morceaux d''ananas dans le fond du moule.'], ['Ouvre-boîte', 'Presse-agrumes', 'Râpe'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'vanille', 'autres cakes', 'dessert', 'plat de résistance', 'ananas', 'beurre doux', 'citron vert', 'Cake croustillant ananas-banane', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:42:16.443837', [{'ingredient_id': '958cd7b8-0069-46c0-af5f-f13655f3779c', 'quantite': '2'}, {'ingredient_id': 'a7fa8b0f-7c04-4b07-a307-79803ed11c35', 'quantite': '100 g'}, {'ingredient_id': '9928665c-95e2-48fb-b6c6-2d447c302e8a', 'quantite': '100 g'}, {'ingredient_id': 'a8c48c07-e715-46fd-bb2a-08591b3d0e49', 'quantite': '100 g'}, {'ingredient_id': '6ac6450f-ee9e-4e5d-8c4f-751901126c9d', 'quantite': '1'}, {'ingredient_id': '93cee646-56d5-4758-92fa-ab10a33b6d24', 'quantite': '1'}, {'ingredient_id': 'eff7aa22-be71-4bc6-b304-52dfa49e3ee9', 'quantite': '1'}, {'ingredient_id': '89800082-8ca7-40ab-ba4d-df1ec1fb199c', 'quantite': '100 g'}, {'ingredient_id': 'a57a2990-27ab-4bcc-b716-020d57b15269', 'quantite': '1'}, {'ingredient_id': 'a49ebc4d-6005-4bed-a9e3-18edafc8a019', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (23419, 'Glacé de bananes', 'banane, nappage chocolat', '10 min', ['Couper les bananes en gros tronçons et les piquer sur des bâtonnets.', 'Faire fondre le chocolat. ', 'Tremper les tronçons de banane dans le chocolat et placer sur une plaque recouverte de papier sulfurisé. ', 'Placer au congélateur. ', 'Sortir quelques minutes avant de déguster.'], ['Ouvre-boîte', 'Passoire'], ['', 'entrée', 'banane', 'Glacé de bananes', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'nappage chocolat', 'cocktail'], 'Dessert', 9d5b8a41-fe36-46f4-b2aa-5b30c7727c91, '2025-09-26T15:42:19.928779', [{'ingredient_id': '5aef2880-351a-4e84-a81b-87174ee46d16', 'quantite': '4'}, {'ingredient_id': '86cd0032-037c-4d16-a932-1a5ce2486790', 'quantite': '200 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (228555, 'Milshake aux prunes et à la banane', 'banane, prune, sucre vanillé, lait', '10 min', ['Couper les bananes grossièrement.', 'Couper les prunes en deux en enlevant les noyaux. ', 'Ajouter le lait et le sucre vanillé.', 'Mixer au blender. Mettre le mélange au réfrigérateur. A déguster très frais.'], ['Couteau de chef', 'Planche à découper', 'Ouvre-boîte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'prune', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Milshake aux prunes et à la banane', 'dessert', 'plat de résistance', 'sucre vanillé', 'lait', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:42:24.430612', [{'ingredient_id': 'a375b226-e268-4c5f-82d9-e7d7f4d44b40', 'quantite': '2'}, {'ingredient_id': 'c5990b57-3e3b-4f5f-8261-e45546cde696', 'quantite': '12'}, {'ingredient_id': '49c14d85-911e-45e4-b1fa-0b8e85716f2b', 'quantite': '2'}, {'ingredient_id': '87a109a3-7143-4b16-aa71-3210bac3d6e4', 'quantite': '50 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (11043, 'Pavé a la banane et au chocolat', 'beurre, sucre, oeuf, sel, levure, bicarbonate, fromage blanc, banane, farine, vanille, chocolat', '15 min', ['Préchauffez le four à thermostat 5/6 (165°C). Beurrez un moule à cake.', 'Travaillez le beurre et le sucre. Ajouter ensuite les oeufs et le sel.', 'Dans un petit bol, dissolvez la levure et le bicarbonate dans le fromage blanc et mélangez à la préparation beurre-sucre-oeufs.', 'Ecrasez les bananes à la fourchette et incorporez-les avec la vanille dans le mélange. Versez graduellement la farine, en faisant un mélange homogène.', 'Faites cuire au four d''abord 20 min.', 'Sortez le gâteau et enfoncez les morceaux de chocolat dans la pâte qui commence juste à prendre. Remettez au four encore environ 1 heure.'], ['Poêle', 'Presse-agrumes', 'Ouvre-boîte'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'chocolat', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'fromage blanc', 'vanille', 'dessert', 'plat de résistance', 'beurre', 'Pavé a la banane et au chocolat', 'gâteau au chocolat', 'sucre', 'cocktail', 'bicarbonate'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:42:29.165526', [{'ingredient_id': '27135ba6-d6ef-4341-b81d-0696b9cdd3bf', 'quantite': '125 g'}, {'ingredient_id': 'b99a2cec-cf74-4f12-9c73-954136649529', 'quantite': '320 g'}, {'ingredient_id': 'a7289674-7f52-420d-bd9f-3e6d050b2961', 'quantite': '2'}, {'ingredient_id': 'bf3131eb-fd41-4a53-b529-642f4b5e7830', 'quantite': '1'}, {'ingredient_id': 'da581f5e-ee80-4c18-b35f-744a266a4cbd', 'quantite': '1 cuillères'}, {'ingredient_id': '2e0e3834-c437-4271-8f2e-d0426f1cb9c9', 'quantite': '1 cuillères'}, {'ingredient_id': '2ee9b9d2-07e1-48ef-8bdf-fb17ecb9c515', 'quantite': '100 g'}, {'ingredient_id': '7b6bd58b-6237-4850-bf7a-4a38e6663e69', 'quantite': '3'}, {'ingredient_id': '33ba3105-5bb0-4a75-9de7-b45db30f2f64', 'quantite': '250 g'}, {'ingredient_id': '24873796-f739-4041-a5fd-25864353892d', 'quantite': '1 cuillères'}, {'ingredient_id': 'd2ebf4a5-ffad-4fc6-a89b-99bf61bcdbcd', 'quantite': '200 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (175378, 'Petits cakes au pépites de chocolat et bananes', 'farine, sucre, oeuf, pépites de chocolat, nappage chocolat, banane, lait, beurre, moules', '25 min', ['Préchauffez le four à 210°C (thermostat 7).', 'Dans un saladier, mélangez la farine avec les œufs.', 'Mélangez. Ajoutez le sucre. Mélangez.', 'Ajoutez le beurre fondu et le lait puis mélangez jusqu’à obtenir une pâte homogène. ', 'Coupez les 100 g de chocolat en pépites (environ 3 petits bouts par carrés) puis mettez-les dans la pâte. Coupez la banane en rondelles puis mettez-les dans la pâte. Mélangez.', 'Beurrez les moules à cakes puis versez la préparation dans les moules (la pâte ne doit pas dépasser la moitié du moule). Enfournez puis laissez cuire 45 min.', 'Quand c''est cuit, laissez refroidir sans démouler.', 'Une fois que c''est froid , faites fondre l''autre demi tablette avec une cuillère à soupe d''eau à feu doux.', 'Quand le chocolat est fondu, versez le chocolat sur les gâteaux puis mettez au frais. Environ 1/4 d''heure après, démoulez puis dégustez : bon appétit !!!'], ['Planche à découper', 'Économe', 'Râpe', 'Fouet'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'pépites de chocolat', 'Petits cakes au pépites de chocolat et bananes', 'recette', 'cuisine', 'moules', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'beurre', 'nappage chocolat', 'sucre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:42:32.794079', [{'ingredient_id': '400c72a9-0fbd-4322-896f-f3071e16fefe', 'quantite': '500 g'}, {'ingredient_id': 'b90a5b91-d32c-4f75-bf17-a119187ec68b', 'quantite': '375 g'}, {'ingredient_id': '12415d4a-a963-449c-bc27-69225164a11e', 'quantite': '8'}, {'ingredient_id': '9b90fa58-8a73-44af-b80c-cfcd82b7d262', 'quantite': '100 g'}, {'ingredient_id': '05ea603c-c981-4591-93ea-6025ba32150c', 'quantite': '100 g'}, {'ingredient_id': 'fa5b9299-14e0-4bd9-9318-086415065796', 'quantite': '1'}, {'ingredient_id': 'a62386c8-0228-4d9d-be0a-4e7160e72db7', 'quantite': '10 cl'}, {'ingredient_id': '636a057f-c0ed-4c3a-a967-5767cc57535b', 'quantite': '300 g'}, {'ingredient_id': '7880dd00-0f98-45f3-87b7-dcd37275e69f', 'quantite': '6'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (345584, 'Smoothie estival concombre + banane + citron + pomme', 'concombre, citron, pomme, banane, jus d''orange', '10 min', ['Éplucher tous les fruits et légumes et couper en petits morceaux. ', 'Pour le citron j''enlève la peau et la partie blanche du milieu. ', 'Pour le concombre enlever les pépins (la peau facultatif selon les goûts). ', 'Mixer le tout en démarrant avec un peu de jus d''orange. ', 'Servir frais avec de la glace pilée ou des glaçons.'], ['Planche à découper', 'Moule à tarte', 'Verre doseur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'citron', 'concombre', 'jus d''orange', 'smoothies', 'Smoothie estival concombre + banane + citron + pomme', 'cocktail'], 'Boisson', 5d2997f9-c983-4818-8785-ef6942dd0196, '2025-09-26T15:42:36.374236', [{'ingredient_id': '97ff8378-4144-4adb-9dbe-80b951e6ddc8', 'quantite': '1'}, {'ingredient_id': 'f2d5217c-5d5b-40b0-90e8-a65a456ba1ec', 'quantite': '1'}, {'ingredient_id': '02131ad3-f048-4f63-986c-a5620ff5f0b6', 'quantite': '1'}, {'ingredient_id': '5da1a717-8748-4572-ae71-e20d428d0038', 'quantite': '1'}, {'ingredient_id': 'e59b5195-dd5b-47d4-968a-13450d8b495e', 'quantite': '10 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (24258, 'Far à la banane', 'oeuf, lait concentré non sucré, farine, fructose, banane, rhum, sucre roux', '15 min', ['Faire préchauffer le four à 200°C. ', 'Battre les oeufs avec le fructose. ', 'Incorporer la farine. ', 'Ajouter peu à peu le lait concentré non sucré en mélangeant, puis le rhum. ', 'Verser la préparation dans une plat légèrement graissé, répartir les rondelles de banane sur la pâte et saupoudrer d''un peu de sucre roux. ', 'Mettre au four pendant 40 mn à 200°C.'], ['Pince de cuisine', 'Casserole', 'Couteau de chef'], ['entrée', 'banane', 'recettes de cuisine', 'Far à la banane', 'rhum', 'confiserie', 'testées', 'très facile', 'bon marché', 'far breton', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'lait concentré non sucré', 'fructose', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:42:39.997380', [{'ingredient_id': 'b3191315-a4b7-4c15-9e72-a37a5988eea7', 'quantite': '4'}, {'ingredient_id': 'a8db8ce5-71dd-495d-a3e7-1076041b0b7c', 'quantite': '410 g'}, {'ingredient_id': '97926d8a-1df9-4ffc-b85a-672f7edd2720', 'quantite': '3 cuillères'}, {'ingredient_id': 'dd6687fa-7b41-4b29-9640-41e756f1a4cd', 'quantite': '5 cuillères'}, {'ingredient_id': '68d51061-edcc-46cd-9096-a75abf88b596', 'quantite': '1'}, {'ingredient_id': '5360b775-0268-43dd-8cc6-7516e75c59fa', 'quantite': '1 cuillères'}, {'ingredient_id': 'befdd427-a2ab-49ea-be03-1001df0523b1', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (87600, 'Tarte aux bananes, noix de coco et raisins', 'pâte feuilletée, banane, noix de coco rapée, oeuf, sucre vanillé, sucre, raisins secs, crème fraîche liquide', '15 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Disposer la pâte feuilletée dans un moule à tarte et la faire précuire au four durant 5 à 10 min.', 'Pendant ce temps, séparer les blancs d''oeufs des jaunes. Mélanger les jaunes avec le sucre en poudre, le sucre vanillé, la crème fraîche et la noix de coco. Ajouter les raisins secs et le rhum (c''est meilleur !).', 'Battre les blancs d''oeufs en neige et les incorporer délicatement au mélange.', 'Garnir le fond de pâte avec les bananes coupées en rondelles et verser la préparation dessus.', 'Enfourner pour environ 20 min. Vérifier la cuisson en piquant la tarte avec un couteau qui doit ressortir sec.'], ['Fouet', 'Râpe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'noix de coco et raisins', 'facile', 'bon marché', 'Tarte aux bananes', 'oeuf', 'plat', 'tarte à la banane', 'recette', 'crème fraîche liquide', 'cuisine', 'recettes', 'boisson', 'noix de coco rapée', 'dessert', 'plat de résistance', 'pâte feuilletée', 'sucre vanillé', 'raisins secs', 'sucre', 'cocktail'], 'Dessert', 95bc7959-927c-4032-809b-60e0be169a0d, '2025-09-26T15:42:43.739245', [{'ingredient_id': 'a7e23c3b-6aed-43c3-aec2-95ba37fc5204', 'quantite': '1'}, {'ingredient_id': '7e1d7016-d005-4714-a29b-2b42f29ba2c8', 'quantite': '2'}, {'ingredient_id': '89e8b6c0-2c0d-4e3b-9a97-1ff2c7c566bc', 'quantite': '125 g'}, {'ingredient_id': 'eeaee780-f9bd-477a-9564-4ceae0a1c98f', 'quantite': '3'}, {'ingredient_id': '53b7e492-6549-4878-80f9-2dc4f842ee04', 'quantite': '2'}, {'ingredient_id': '52aa6720-0217-47b4-bd6e-31f3b57f07b8', 'quantite': '80'}, {'ingredient_id': 'f79bb9c2-a565-4e75-bf43-bbf4d4f18e62', 'quantite': '50 g'}, {'ingredient_id': '520df29e-10ee-43a1-88d9-89ee10ab5cd5', 'quantite': '20 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (43894, 'Espadon sur lit de banane', 'escalope, banane, coriandre, curry', '10 min', ['Si vous souhaitez accompagner le plat de riz à la sauce soja,', 'faites cuire le riz.', 'Puis, préparez des papillotes avec du papier sulfurisé : ', 'mettez les bananes écrasées grossièrement, puis une bonne couche de coriandre hachée, puis l''escalope d''espadon. ', 'Saupoudrez de curry à votre goût, et couvrez de coriandre.', 'Refermez les papillotes, et placez-les au micro-ondes. ', 'Pour 2 escalopes de 100 à 150 g chacune, ', 'comptez 4 min à 500 W.', 'Sortez du micro-ondes, et dressez sur l''assiette avec le riz... Voilà, c''est prêt!'], ['Presse-agrumes', 'Râpe', 'Passoire', 'Planche à découper', 'Couteau de chef'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'escalope', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Espadon sur lit de banane', 'dessert', 'plat de résistance', 'coriandre', 'curry', 'cocktail'], 'Plat principal', 0a1e163d-a3b9-4499-978c-b7337ca1ad6e, '2025-09-26T15:42:47.336651', [{'ingredient_id': 'fc0c2778-1932-456d-b2c6-9102c54a1a6a', 'quantite': '2'}, {'ingredient_id': '7238c2fc-0c8b-4422-9e5f-8ea57b182b38', 'quantite': '2'}, {'ingredient_id': '268a55fd-0ecf-44ed-b541-5211fe2c93d6', 'quantite': ''}, {'ingredient_id': '7a6e6ba1-332b-4963-b213-090356cb4d74', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (165805, 'Verrine Tutti frutti', 'banane, clémentine, pomme, ananas, amandes effilées, sucre', '15 min', ['Couper les bananes, les clémentines et les pommes en petits morceaux avant de les passer au mixeur. Vous avez la possibilité de rajouter un peu de sucre mais ce n''est pas nécessaire à mon gout.', 'Une fois que le tout est bien mixé, alterner dans un verrine une fine couche de cette préparation puis une fine couche de yaourth à l''ananas. Répéter l''opération jusqu''à épuisement des ingrédients.', 'Et enfin, terminer par quelques amandes effilées (vous pouvez remplacer les amandes par du musli aux fruits secs).', 'Laisser au frais 1h minimum avant de servir. ', 'Déguster!'], ['Verre doseur', 'Mixeur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'Verrine Tutti frutti', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'clémentine', 'dessert', 'plat de résistance', 'pomme', 'ananas', 'sucre', 'amandes effilées', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:42:51.683646', [{'ingredient_id': '8b6691ec-cfc6-497f-845d-de203869b319', 'quantite': '2'}, {'ingredient_id': 'bb67dc04-d095-488e-9134-7ec70df17a54', 'quantite': '2'}, {'ingredient_id': 'fa319d09-ad43-4bbc-87a9-b38c4a56912c', 'quantite': '2'}, {'ingredient_id': '83772031-ebb2-4126-a6fa-5a4fa702502f', 'quantite': '2'}, {'ingredient_id': '4673ea8c-0ec8-4d8c-b4ae-f3dcb9889382', 'quantite': '4'}, {'ingredient_id': '84266f51-6308-44a5-941f-c6200b92ebb6', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (392558, 'Muffins banane / crème de marrons', 'banane, farine de châtaigne, fécule de maïs, sucre, levure, crème de marrons, oeuf, lait', '5 min', ['Préchauffer le four à 180° (T6).', 'Dans un bol, écraser la banane à la fourchette jusqu''à obtenir une pâte assez homogène. Ajouter la farine, la fécule, la levure et le sucre, puis mélanger pour que la banane imprègne bien les ingrédients secs. Le mélange reste à ce stade sablonneux.', 'Ajouter la crème de marron et mélanger jusqu''à l''obtention d''une pâte très épaisse.', 'Ajouter l''oeuf et le lait. Bien mélanger le tout (on retrouve la consistance d''une pâte à gâteau).', 'Répartir la préparation dans 6 moules à muffins (remplis au 3/4).', 'Faire cuire entre 10 et 15 minutes selon votre four.'], ['Tire-bouchon', 'Poêle', 'Passoire', 'Moule à tarte'], ['Muffins banane / crème de marrons', 'crème de marrons', 'banane', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'petits gâteaux', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'farine de châtaigne', 'moyen', 'sucre', 'lait', 'cocktail', 'fécule de maïs'], 'Dessert', 52e15716-1c51-485c-a814-a8da0ddeaccd, '2025-09-26T15:42:55.241150', [{'ingredient_id': 'b9383ee4-a409-4143-8105-db1eec113e78', 'quantite': '1'}, {'ingredient_id': 'ec29d4de-b9fc-43ef-87fe-204f655d418a', 'quantite': '3 cuillères'}, {'ingredient_id': '9234be43-2869-4794-97c0-3f9616d58f4e', 'quantite': '3 cuillères'}, {'ingredient_id': 'e4b69c4b-afd7-430a-846d-e81f44d338d0', 'quantite': '1 cuillères'}, {'ingredient_id': '496eb7e3-21f6-4206-85bb-02d72c5844fc', 'quantite': '1 cuillères'}, {'ingredient_id': '192cd1d9-21be-4b29-975e-1b831c77ee93', 'quantite': '1 cuillères'}, {'ingredient_id': 'd5a6d0fe-ba4c-4708-9821-860e633a284a', 'quantite': '1'}, {'ingredient_id': '047ba92e-1bd2-483a-b0b2-ec5425d36497', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (167112, 'Verrines banane-biscuits choco-crème d''orange', 'biscuit, banane, orange, cassonade, mascarpone', '20 min', ['Ecraser les deux bananes. Y ajouter 2 cuillères à soupe de cassonade. Bien mélanger, puis répartir au fond des verrines.', 'Briser en morceaux grossiers les biscuits au chocolat par-dessus la banane écrasée.', 'Préparer la crème d''orange : mélanger le zeste des deux oranges avec le mascarpone. Ajouter 3 cuillères à soupe de cassonade. Presser le jus des oranges et ajouter la quantité souhaitée au mélange (plus ou moins selon que vous vouliez une crème plus ou moins épaisse). Bien mélanger, puis répartir cette crème au-dessus des biscuits dans les verrines.', 'Décorer selon votre imagination !'], ['Fouet', 'Ouvre-boîte'], ['entrée', 'banane', 'recettes de cuisine', 'mascarpone', 'confiserie', 'testées', 'cassonade', 'très facile', 'bon marché', 'autres biscuits et petits gâteaux', 'rapide', 'plat', 'biscuit', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Verrines banane-biscuits choco-crème d''orange', 'orange', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:42:58.875278', [{'ingredient_id': '8a85b1bc-fef7-4217-870e-87e6624bf6c2', 'quantite': '150 g'}, {'ingredient_id': '070137fb-9076-45ab-acf3-0526b0b65115', 'quantite': '2'}, {'ingredient_id': 'e2ab9dcc-c83e-4e29-9b65-88f88c526bae', 'quantite': '2'}, {'ingredient_id': '0ce733df-94e9-4d32-b0d0-787da3309f56', 'quantite': '5 cuillères'}, {'ingredient_id': '7dda3aef-9975-44af-9d8b-c0c6e959104e', 'quantite': '250 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (21554, 'Feuilles de bananier farcies au lieu épicé', 'lieu noir, noix de coco rapée, cumin en poudre, gingembre, ail, citron, garam masala, eau, feuille de bananier, poivre, sel', '20 min', ['Préparer d’abord la « pâte à épices » :', 'Peler les gousses d’ail et la racine de gingembre, puis presser le jus du citron.', 'Déposer l’ail et le gingembre dans le bol d’un mixeur et les arroser du jus de citron.', 'Ajouter ensuite le cumin, le garam massala, la noix de coco puis mouiller le tout d’eau chaude.', 'Mixer jusqu’à l’obtention d’une sorte de « pâte à épices ».', 'Saler, poivrer.', 'Découper les feuilles de bananiers en 4 rectangles.', 'Détailler les filets de lieu en 4 morceaux, puis les déposer sur chaque feuille de bananiers.', 'Napper de pâte à épices en veillant à bien la répartir, puis refermer les feuilles et les maintenir à l’aide d’un pique en bois.', 'Déposer les feuilles de bananier farcies dans la partie haute d’un couscoussier ou d’un cuit vapeur puis laisser cuire 8 min environ.'], ['Passoire', 'Couteau de chef', 'Fouet'], ['', 'gingembre', 'entrée', 'cumin en poudre', 'recettes de cuisine', 'sel', 'confiserie', 'eau', 'testées', 'facile', 'ail', 'rapide', 'plat', 'feuille de bananier', 'recette', 'cuisine', 'recettes', 'boisson', 'noix de coco rapée', 'dessert', 'plat de résistance', 'moyen', 'citron', 'poivre', 'garam masala', 'cocktail', 'lieu noir', 'Feuilles de bananier farcies au lieu épicé'], 'Plat principal', 19671005-0754-48d0-88d8-9bf02e44e8f9, '2025-09-26T15:43:03.270687', [{'ingredient_id': '220b4b12-62dd-4a17-810e-8cdee272835f', 'quantite': '500 g'}, {'ingredient_id': '1e5ee4f3-d5c0-4fcf-9b42-97943f354a3a', 'quantite': '200 g'}, {'ingredient_id': '8189c932-12e8-454f-988f-9c36ddeb073f', 'quantite': '1 cuillères'}, {'ingredient_id': '25808fce-44ce-4303-8664-7b1fe3b7ff22', 'quantite': '2'}, {'ingredient_id': '4cebb644-dd31-4ce5-b8f3-dcf992728209', 'quantite': '3'}, {'ingredient_id': '59b2d284-8bc1-445a-a928-17358c52006d', 'quantite': ''}, {'ingredient_id': 'f5c2f21d-77b6-4cc2-a412-417909d25921', 'quantite': ''}, {'ingredient_id': 'a1f22cb4-5586-4536-b427-5a85b84d6fc3', 'quantite': ''}, {'ingredient_id': '5e50e52e-09eb-4c72-b9ef-65e5e182e336', 'quantite': ''}, {'ingredient_id': '196106e7-c89a-4e4b-b425-807f7d15c353', 'quantite': ''}, {'ingredient_id': '6f0d0208-d849-4961-a1c1-2e242695b3e9', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (535055, 'Verrines express banane yaourt chocolat', 'banane, yaourt, pâte à tartiner, granola', '5 min', ['Dans 4 verrines, déposer 2 cuillères à soupe de yaourt coco.', 'Éplucher et couper les bananes en tranches', 'Déposer des tranches de banane sur le tour du pot.', 'Ajouter ensuite 2 cuillères à café de pâte à tartiner.', 'Recouvrer avec le reste du yaourt coco. Parsemer le dessus d''un peu de granola.'], ['Rouleau à pâtisserie', 'Économe', 'Mixeur', 'Planche à découper', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'très facile', 'granola', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Verrines express banane yaourt chocolat', 'dessert', 'plat de résistance', 'cocktail', 'pâte à tartiner'], 'Dessert', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T15:43:06.818583', [{'ingredient_id': '8410f0b4-0646-4587-8158-85fa644dc486', 'quantite': '2'}, {'ingredient_id': '48a1dbac-72e5-483c-aefa-85e5e07d75b7', 'quantite': '250 g'}, {'ingredient_id': '19cadccd-cf65-412a-8cae-e2c48ea7d4da', 'quantite': '150 g'}, {'ingredient_id': 'd45b225c-2678-483c-b88a-7154133d738b', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (528103, 'Tiramisu à la banane', 'oeuf, mascarpone, sucre, spéculoos, banane, miel', '15 min', ['Séparer les jaunes des blancs d''œufs.', 'Mélanger les blancs en neige te mettre au frigo.', 'Dans un autre saladier, mélanger le jaune d''œuf avec le sucre et le mascarpone pour obtenir un mélange bien mousseux.', 'Incorporer délicatement avec une spatule les blancs dans le mascarpone.', 'Couper les bananes en rondelles.', 'Mettre dans les verrines : quelques rondelles de banane, le mascarpone avec la composition et par dessus des biscuits de spéculoos et enfin du miel par dessus. Mettre au frais et régalez-vous.'], ['Batteur électrique', 'Planche à découper', 'Spatule', 'Pince de cuisine'], ['entrée', 'banane', 'Tiramisu à la banane', 'recettes de cuisine', 'mascarpone', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'recette', 'spéculoos', 'cuisine', 'miel', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre', 'cocktail'], 'Dessert', c2a082c6-1011-43b9-93e2-d9aee42ce6cc, '2025-09-26T15:43:10.419398', [{'ingredient_id': '7f254646-c15b-4707-8207-f3e1a477ecb8', 'quantite': '3'}, {'ingredient_id': '6ecf876e-c58d-4cb5-afbd-945d7d489f73', 'quantite': '250 g'}, {'ingredient_id': 'd961ee2f-9b61-4d7f-8b8e-fe0db3fd3986', 'quantite': '50 g'}, {'ingredient_id': '929c4aa3-ebcc-4049-bd62-6bfe5e8c6e94', 'quantite': '1'}, {'ingredient_id': '46551a2e-b8c4-40e0-ad37-733b98e7a072', 'quantite': '3'}, {'ingredient_id': '6ff18ab2-c26a-4fa2-9c38-b8ed83671f63', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (227745, 'Crème bananes caramélisées maison', 'banane, beurre, sucre vanillé, lait, sucre en poudre, maïzena', '10 min', ['Couper les bananes et les faire caraméliser à la poêle avec le beurre et le sucre vanillé', 'Mixer les bananes.', 'Ajouter le lait, la maïzena et le sucre.', 'Dans une casserole, remuer le mélange jusqu''à ', 'Verser dans des ramequins, laisser tiédir et mettre au frigo.', 'Servir très frais'], ['Verre doseur', 'Louche', 'Mixeur', 'Batteur électrique'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'maïzena', 'bon marché', 'Crème bananes caramélisées maison', 'rapide', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'beurre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:43:14.000712', [{'ingredient_id': '7099a741-1143-402e-92e2-fb65946c881a', 'quantite': '2'}, {'ingredient_id': 'c19f4184-e2fe-4fee-bb8d-53a63282e059', 'quantite': '1'}, {'ingredient_id': '792cde5c-fd34-4d02-a004-57769bac00f5', 'quantite': '1'}, {'ingredient_id': '1eb8017f-8e70-470b-9cdf-9757588d6b58', 'quantite': '50 cl'}, {'ingredient_id': '8ea3679b-5166-48d6-9638-c9e7f68d3083', 'quantite': '20 g'}, {'ingredient_id': '8219063e-0c8c-4c68-9609-f22c40678b93', 'quantite': '4 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (68111, 'Muffins bananes au coeur chocolat', 'sucre en poudre, beurre, oeuf, farine de blé, farine de maïs, levure chimique, banane, chocolat au lait', '15 min', ['Dans une jatte, mélangez le beurre fondu au sucre avec une cuillère en bois jusqu''à ce le mélange refroidisse.', 'Préchauffez le four à 180°C (thermostat 6). ', 'Écrasez les bananes dans une assiette avec une fourchette.', 'Ajoutez à la préparation les œufs un à un.', 'Dans un bol, mélangez les deux farines avec la levure.', 'Ajoutez ensuite le tout au mélange. Mélangez énergiquement pour arriver à une pâte lisse.', 'Finissez en ajoutant les bananes écrasées et remuez.', 'Garnissez de petits moules en papier sulfurisé aux deux tiers avec la pâte.', 'Dans chaque moule, déposez un carré de chocolat sur la pâte et enfoncez-les un peu.', 'Enfournez et laissez cuire jusqu''à ce que les muffins soient dorés.', 'A déguster encore chaud, c''est meilleur !'], ['Verre doseur', 'Rouleau à pâtisserie', 'Couteau de chef'], ['chocolat au lait', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'Muffins bananes au coeur chocolat', 'testées', 'levure chimique', 'très facile', 'bon marché', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'farine de blé', 'muffin', 'beurre', 'farine de maïs', 'cocktail'], 'Dessert', fe302c01-0409-4763-9381-6100c53197b5, '2025-09-26T15:43:18.628064', [{'ingredient_id': 'e694f208-4c80-4418-8989-7d3cd971cb71', 'quantite': '125 g'}, {'ingredient_id': 'f764b6a6-f2dd-401c-ab1f-693bb0885c8e', 'quantite': '125 g'}, {'ingredient_id': '71d9cea6-621b-4fc0-ab17-4bbbed7a9b02', 'quantite': '3'}, {'ingredient_id': '0a41ee76-165b-4a45-a017-38720a694b3e', 'quantite': '100 g'}, {'ingredient_id': 'e989895e-c424-4e5b-8466-96f1c68c9b53', 'quantite': '100 g'}, {'ingredient_id': '7338edc8-d7d8-43d5-bfa7-8455d77d84ff', 'quantite': '1'}, {'ingredient_id': 'e296ded2-7f28-4b62-9bfa-97832422700f', 'quantite': '3'}, {'ingredient_id': '44bd3e33-831d-473e-9750-3c947794d80c', 'quantite': '12'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (232347, 'Rhum arrangé de bananes, vanille et cannelle', 'rhum, banane, vanille, cannelle, sucre de canne', '5 min', ['Mettre dans un bocal d''un litre les bananes épluchées et coupées en morceaux, la gousse de vanille fendue, le bâton de cannelle, le sucre de canne et le rhum.', 'Laisser macérer au moins un mois (plus ça macère, mieux c''est).'], ['Louche', 'Moule à tarte'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'facile', 'rapide', 'vanille et cannelle', 'plat', 'cocktail rhum', 'recette', 'cuisine', 'recettes', 'boisson', 'sucre de canne', 'vanille', 'Rhum arrangé de bananes', 'dessert', 'plat de résistance', 'moyen', 'cannelle', 'cocktail'], 'Boisson', 3797625c-f089-4ba3-ae09-c25617d44ac5, '2025-09-26T15:43:22.141273', [{'ingredient_id': '226aee42-9d7f-4f2a-b8a1-c72c4e46474e', 'quantite': '70 cl'}, {'ingredient_id': 'f71fb167-be58-4540-bf69-e14b1952222e', 'quantite': '2'}, {'ingredient_id': '00140052-fa9c-450c-ab14-9fefe0171058', 'quantite': '1'}, {'ingredient_id': '8519f159-ef0a-4086-8455-31da15615595', 'quantite': '1'}, {'ingredient_id': '9d907827-873a-4cbe-a4fe-ece8d6ded9f9', 'quantite': '4 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (16845, 'Confiture rhubarbe et banane', 'rhubarbe, sucre, banane', '30 min', ['Couper la rhubarbe en petits tronçons, la faire macérer avec le sucre durant quelques heures ou une nuit.', 'Le lendemain, ajouter les bananes en rondelles et cuire environ 20 mn. Mettre en pots.'], ['Ouvre-boîte', 'Économe', 'Presse-agrumes'], ['entrée', 'banane', 'recettes de cuisine', 'confiture de rhubarbe', 'confiserie', 'testées', 'très facile', 'rhubarbe', 'bon marché', 'plat', 'Confiture rhubarbe et banane', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre', 'cocktail'], 'Confiserie', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:43:26.661310', [{'ingredient_id': 'ad3a032f-1deb-4df7-b39a-baf81142d221', 'quantite': '1 kg'}, {'ingredient_id': '916ed145-d79b-401a-a429-ffca983f3c67', 'quantite': '1 kg'}, {'ingredient_id': 'f457dd75-27ad-4313-b7f3-333963b3b45a', 'quantite': '300 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (12207, 'Fondue au chocolat', 'chocolat noir, lait, crème fraîche, beurre, cannelle, extrait de vanille, rhum, noisettes, noix de coco rapée, banane, poire, mandarine, chamallow, fruits secs, jus de citron', '20 min', ['Eplucher les fruits et les couper en tranches (sauf les mandarines).', 'Les arroser de jus de citron. Les disposer dans un plat de services avec les fruits secs.', 'Déposer la noix de coco et les noisettes dans des coupelles.', 'Dans un poêlon, placer au bain-marie, casser le chocolat en morceaux, ajouter le lait.', 'Lorsque le chocolat s''est ramolli, ajouter la crème en lissant le mélange au fouet.', 'Au dernier moment, incorcorer le beurre en parcelles aisi que la vanille, la cannelle et le rhum.', 'Porter le poêlon sur le réchaud entouré des ingrédients. Chacun pique tour à tour un morceau de fruit ou autre sur sa fourchette, la plonge dans le chocolat, puis le roule dans dans la coupelle de son choix.'], ['Fouet', 'Passoire', 'Rouleau à pâtisserie', 'Moule à tarte', 'Couteau de chef'], ['', 'chamallow', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'rhum', 'confiserie', 'testées', 'extrait de vanille', 'poire', 'très facile', 'mandarine', 'bon marché', 'rapide', 'plat', 'fruits secs', 'recette', 'noisettes', 'cuisine', 'recettes', 'boisson', 'noix de coco rapée', 'dessert', 'plat de résistance', 'chocolat noir', 'jus de citron', 'Fondue au chocolat', 'beurre', 'cannelle', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:43:33.639985', [{'ingredient_id': '5ae588bf-cf3f-402b-b48f-e5eb598d053f', 'quantite': '300 g'}, {'ingredient_id': 'df42a0dd-2de7-4343-8c0e-eb68113da2ad', 'quantite': '2 cuillères'}, {'ingredient_id': 'f0ee120a-1e3d-4ba0-ba82-65664e7bb049', 'quantite': '25 cl'}, {'ingredient_id': 'bc3d6d93-cbf4-4d54-b93d-1e894b832417', 'quantite': '75 g'}, {'ingredient_id': '354f6396-180f-406c-af4b-e52658bb42e8', 'quantite': '1'}, {'ingredient_id': '77d1a8b4-eb3f-4e20-bcf4-15498f0815d0', 'quantite': '1 cuillères'}, {'ingredient_id': 'b5878648-9478-4a36-bcd4-574a681c78ce', 'quantite': '2 cuillères'}, {'ingredient_id': '5d264f1c-baf2-4058-97a6-0f9034de9a08', 'quantite': '150 g'}, {'ingredient_id': '410dcdfa-a6d4-4f45-9d6d-97c51890284e', 'quantite': '150 g'}, {'ingredient_id': 'd5139e01-28dc-488e-b225-132fd28fb66f', 'quantite': '3'}, {'ingredient_id': 'ce95b816-ab34-40f9-bbd9-ef3d20a710c6', 'quantite': ''}, {'ingredient_id': '85c6221f-53a0-4629-99d8-50302dad07bd', 'quantite': ''}, {'ingredient_id': 'cc824841-b835-4bc0-8caf-cb404d4f741d', 'quantite': '12'}, {'ingredient_id': '73409174-7fa0-4866-a6c1-17cc0d430f36', 'quantite': ''}, {'ingredient_id': '944dbd4e-bd4d-4d95-aa34-1e09929c7252', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (57123, 'Cake banane, chocolat et curry', 'farine, oeuf, sucre, banane, beurre, levure, curry, chocolat noir', '20 min', ['Couper les bananes dans le sens de la longueur, puis en dés.', 'Les placer dans un saladier, avec un peu de jus de citron.', 'Allumer le four à thermostat 7 (210°C).', 'Placer dans une terrine beurre ramolli, sucre, levure, curry et sel, puis mélanger.', 'Ajouter les oeufs un à un en travaillant la pâte.', 'Verser la farine d''un seul coup.', 'Ajouter les bananes, puis le chocolat coupé en (petits) morceaux.', 'Bien mélanger.', 'Verser dans un moule à cake beurré et cuire 15 min à thermostat 7, puis 30 min à thermostat 6 (180°C).'], ['Passoire', 'Casserole', 'Rouleau à pâtisserie', 'Ouvre-boîte', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'chocolat et curry', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'autres cakes', 'dessert', 'Cake banane', 'plat de résistance', 'chocolat noir', 'beurre', 'sucre', 'curry', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:43:38.040377', [{'ingredient_id': 'c33674db-3275-44b3-95ad-824209e82025', 'quantite': '250 g'}, {'ingredient_id': '773e25bc-43b9-4169-bf4a-7181222a1b08', 'quantite': '3'}, {'ingredient_id': '819f299a-c498-4f23-b0c6-9693012e611f', 'quantite': '125 g'}, {'ingredient_id': 'd501e985-1e00-4ef9-8857-68876f2d3b6b', 'quantite': '2'}, {'ingredient_id': '7d2e7ffc-f414-4e02-bf3a-f2c81fd4fa1d', 'quantite': '175 g'}, {'ingredient_id': '2d1a3345-70d8-4397-ad5b-e8e5f376d49b', 'quantite': ''}, {'ingredient_id': 'b8eef532-4475-4662-b2a5-02dc85de38b3', 'quantite': '1 cuillères'}, {'ingredient_id': '1a13bac2-99e1-4c98-8544-90cafbc24a52', 'quantite': '125 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (68351, 'charlotte noix de coco banane et chocolat', 'lait de coco, noix de coco rapée, boudoir, banane, fromage blanc, chocolat noir, crème liquide, sucre glace, malibu coco', '15 min', ['Mélanger le lait de coco et le malibu dans un saladier.', 'Mélanger le frommage blanc à la noix de coco rapée et au sucre glace dans un autre saladier.', 'Tremper rapidement les boudoirs dans le lait de coco puis les déposer dans le moule à charlotte de façon à le recouvrir.', 'Remplir ensuite le moule par couches: rondelles de bananes / fromage blanc / boudoirs trempés.', 'Terminer par une couche de boudoirs.', 'Réserver la charlotte environs 6 h au réfrigérateur.', 'Au moment de servir, présenter la charlotte dans son plat recouverte de chocolat fondu (au bain marie avec la crème liquide)'], ['Verre doseur', 'Casserole', 'Fouet'], ['lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'charlotte noix de coco banane et chocolat', 'bon marché', 'rapide', 'plat', 'moyenne', 'recette', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'charlotte au chocolat', 'fromage blanc', 'noix de coco rapée', 'dessert', 'plat de résistance', 'chocolat noir', 'malibu coco', 'boudoir', 'sucre glace', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:43:42.450423', [{'ingredient_id': 'e7f4d1ed-3234-4185-b1fd-ef5b1b459295', 'quantite': ''}, {'ingredient_id': '0d0ec0f7-afc2-455f-984b-b32d80c8ebfb', 'quantite': '20 g'}, {'ingredient_id': 'c4b534f2-1d89-4c7c-b4e4-43f09b602141', 'quantite': '30'}, {'ingredient_id': 'd32ca098-bc35-4830-adc5-69ad40f5e133', 'quantite': '4'}, {'ingredient_id': '0de3aeb3-9d51-482a-ba05-ff2b2c89e2fa', 'quantite': '500 g'}, {'ingredient_id': 'de92733c-8423-422d-aa19-776401ce1f71', 'quantite': '100 g'}, {'ingredient_id': 'a6ff5e58-ebaf-4c76-b105-6e4d9a81b17c', 'quantite': '10 cl'}, {'ingredient_id': 'b451c449-cd9c-449c-a113-ae8b5f988f7e', 'quantite': '4 cuillères'}, {'ingredient_id': '69136465-44eb-4061-93a1-e8bcdc950a59', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (338375, 'Banofee cheesecake sans cuisson', 'spéculoos, beurre tendre, gélatine, fruits, blanc d''oeuf, banane, caramel au beurre salé, crème fouettée, mascarpone, fromage blanc, sucre en poudre', '15 min', ['Prévoir 6 emporte-pièces cercles ou (et) carrés.', 'Mélanger le beurre avec les spéculoos mixés afin d''obtenir une pâte bien homogène. ', 'Tapisser le fond des emporte-pièces avec cette pâte. Réserver au frais 10 minutes.', 'Couper les bananes en rondelles et les faire cuire, dans une poêle, 2 minutes à feu doux. Laisser refroidir.', 'Ramollir la gélatine dans de l''eau très froide 5 minutes, l''essorer et la dissoudre dans le jus de fruit chaud.Monter le blanc en neige très ferme avec 1 cuillère à soupe de sucre.', 'Battre au fouet le mascarpone avec le fromage blanc + 1 cuillère à soupe de sucre pendant 3 à 4 secondes.', 'Dans un grand bol ou saladier mélanger le blanc en neige avec le mascarpone-fromage blanc, le jus de fruit et la crème fouettée.', 'Mélanger délicatement. Sortir les emporte-pièces (ronds ou (et) carrés) du réfrigérateur, et verser dans le fond 1 cuillère à café de caramel ou de confiture de lait, couvrir de rondelles de banane.', 'Remplir à ras bord de crème.', 'Laisser au frais plusieurs heures, voir toute une nuit.', 'Au moment de servir, démouler délicatement. Verser sur le dessus un nuage de crème fouettée avec un filet de caramel.', 'C''est trop bonnnnnnnnnnnn.'], ['Moule à tarte', 'Verre doseur'], ['entrée', 'banane', 'recettes de cuisine', 'mascarpone', 'confiserie', 'testées', 'beurre tendre', 'facile', 'bon marché', 'rapide', 'plat', 'crème fouettée', 'caramel au beurre salé', 'sucre en poudre', 'recette', 'spéculoos', 'cuisine', 'recettes', 'boisson', 'fromage blanc', 'Banofee cheesecake sans cuisson', 'dessert', 'cheesecake', 'plat de résistance', 'gélatine', 'fruits', 'blanc d''oeuf', 'cocktail'], 'Dessert', 8bed0194-005e-4e97-b802-daff09780064, '2025-09-26T15:43:46.047554', [{'ingredient_id': '09384a02-3b25-4f4f-91da-09f5045a8f44', 'quantite': '200 g'}, {'ingredient_id': 'fd04a345-5877-4019-9fdd-8385ef75d23b', 'quantite': '2 cuillères'}, {'ingredient_id': 'a8a73a5b-f5ea-4bac-bc94-6b6e805f92be', 'quantite': '3'}, {'ingredient_id': 'b7621e1c-2bb6-4088-99bc-ac9fe0f9ce4e', 'quantite': '4 cuillères'}, {'ingredient_id': 'ed05fc5d-6044-4d8d-9574-34073b471e09', 'quantite': '1'}, {'ingredient_id': 'ab462855-b97f-44e8-b22c-d8d595f332a3', 'quantite': '1'}, {'ingredient_id': 'a801c11b-75dd-4789-a063-e767eb3ce2aa', 'quantite': '6 cuillères'}, {'ingredient_id': 'f22e800b-9944-4093-a2bf-6a281a02565d', 'quantite': '1'}, {'ingredient_id': 'cbf4beb1-6f37-4a0c-9291-d2a28b792a95', 'quantite': '2 cuillères'}, {'ingredient_id': 'eec1eabe-53bb-4ace-9196-f954158d6483', 'quantite': '2 cuillères'}, {'ingredient_id': 'e6df927e-66a2-449b-9ad4-5d5205f6742b', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (341939, 'Gâteau à couches de Marina', 'kiwi, banane, lait concentré sucré, chocolat, vanille, beurre', '30 min', ['Si on aime la facilité ou que l''on est pressé, acheter des préparations de gâteau toutes faites ou réaliser deux moelleux maison (les cuire 45 minutes à 150°C (thermostat 5).', 'Laisser refroidir et couper les gâteaux en deux de façon à obtenir 4 couches.', 'Faire cuire dans une casserole d''eau bouillante les 2 boites de lait concentré sucré fermé, pendant 2 heures.', 'Pendant ce temps peler les fruits et les couper en tranches fines.', 'Après cuisson, ouvrir les boites de lait concentré sucré et incorporer le beurre.', 'Monter le gâteau : une couche de gâteau, une couche de fruits (banane ou kiwi, au choix et on alterne), mettre par dessus une bonne couche de sauce et réitérer jusqu''à obtenir 4 couches de gâteau.'], ['Louche', 'Tire-bouchon'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'plat', 'moyenne', 'recette', 'cuisine', 'recettes', 'lait concentré sucré', 'boisson', 'vanille', 'dessert', 'plat de résistance', 'moyen', 'beurre', 'Gâteau à couches de Marina', 'cocktail'], 'Dessert', 6d30f324-fbdc-49a8-a242-7865c676e5fd, '2025-09-26T15:43:50.659518', [{'ingredient_id': 'eafd79b0-f773-4ddc-aac7-27485a465120', 'quantite': '5'}, {'ingredient_id': 'f3431949-02b4-4377-aa5f-6b21b919f35c', 'quantite': '4'}, {'ingredient_id': '5e617ea2-1c8c-42b9-b3b3-d26c21731936', 'quantite': '2'}, {'ingredient_id': '3ef60ab0-d161-492d-a80d-8bda2635ec15', 'quantite': '1'}, {'ingredient_id': '4712cb05-e7d3-4314-b660-6fc36dab1e65', 'quantite': '1'}, {'ingredient_id': '53d097b4-390d-478b-b15f-a41e66d4f1c6', 'quantite': '200 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (18089, 'Compote pomme banane', 'pomme, banane, sucre vanillé', '10 min', ['Eplucher les pommes et les couper en petits dés. ', 'Couper la banane en rondelles. ', 'Mettre le tout dans une casserole avec 1 verre d''eau. ', 'Ajouter les 3 sachets de sucre vanillé, et laisser mijoter pendant 1 heures. ', 'Remuer régulièrement et rajouter de l''eau si besoin. ', 'Après la cuisson, écraser les fruits cuits, laisser refroidir et déguster.'], ['Pince de cuisine', 'Balance de cuisine', 'Ouvre-boîte'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'compote de pomme', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'Compote pomme banane', 'cocktail'], 'Dessert', 0595ecd5-a766-4109-8816-1f8430fed82b, '2025-09-26T15:43:56.329945', [{'ingredient_id': '2593a579-1328-449b-bf8d-78d029edaeaf', 'quantite': '2'}, {'ingredient_id': '10123428-098d-4f02-ae27-b75b0212a7d0', 'quantite': '1'}, {'ingredient_id': '88948150-73f9-4696-83e0-21ce97405d7d', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (44947, 'Planteur antillais', 'rhum, sirop de sucre de canne, jus de fruit multivitaminé, jus d''ananas, goyave, cannelle, cannelle, vanille, muscade, banane, kiwi, ananas, citron vert, kumquat', '1440 min', ['Mélanger tous les ingrédients, ajouter 50 cl litre de jus d''oranges pour rendre le planteur moins corsé si vous le souhaitez.', 'A préparer la veille, et mettre au frigo.'], ['Économe', 'Passoire', 'Planche à découper', 'Casserole', 'Moule à tarte'], ['sirop de sucre de canne', 'jus de fruit multivitaminé', 'banane', 'entrée', 'kiwi', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'assez cher', 'goyave', 'muscade', 'très facile', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Planteur antillais', 'vanille', 'punch', 'dessert', 'plat de résistance', 'jus d''ananas', 'kumquat', 'ananas', 'citron vert', 'cannelle', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:43:59.873523', [{'ingredient_id': '9e96e63e-58cb-4286-9741-1466cb3cc4f9', 'quantite': '50 cl'}, {'ingredient_id': 'f27f615f-4131-4f56-aa1b-1dfa843aa4f2', 'quantite': '12.5 cl'}, {'ingredient_id': '5a664423-0c24-4dad-84af-543180442cbf', 'quantite': '2 l'}, {'ingredient_id': '01aa1327-f825-443d-939f-e2b0768b6756', 'quantite': '50 cl'}, {'ingredient_id': '08823295-b31a-4497-a857-e164992956c9', 'quantite': '50 cl'}, {'ingredient_id': 'f232d177-86a7-4767-952b-c24d73ba4e8d', 'quantite': '1'}, {'ingredient_id': '403be637-f780-4889-b7f1-cc62be6d9347', 'quantite': ''}, {'ingredient_id': 'aafeffd1-69e1-49f9-bcac-f914a70a8fb3', 'quantite': '1'}, {'ingredient_id': '8aef5077-52d3-4986-9681-70c117e87dc8', 'quantite': ''}, {'ingredient_id': 'bed62491-07c3-4617-819f-6a4528d49fcf', 'quantite': '1.5'}, {'ingredient_id': '64ae4e9b-0830-4ee0-aafe-46e5dc223ebd', 'quantite': '2'}, {'ingredient_id': 'aee9349e-488d-4238-8ffd-890edaaeef94', 'quantite': ''}, {'ingredient_id': 'b5efea0d-86ad-4f96-b4ce-ff80b6a3f5c6', 'quantite': '2'}, {'ingredient_id': 'a3c9e011-8d68-41fc-bb96-286066955529', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (32392, 'Tiramisu banane pas cher', 'banane, boudoir, crème épaisse, oeuf, rhum, sucre, cacao, beurre', '20 min', ['Découper les bananes en rondelles, en réserver une. ', 'Faire revenir les deux autre avec du beurre, 2 cuillères de sucre, 2 cuillères de rhum et 1 cuillère d''eau à feux doux. ', 'Mélanger la crème, le jaune d''oeuf le reste de sucre et de rhum; battre énergiquement pour obtenir un mélange onctueux. ', 'Battre le blanc en neige, et l''incorporer doucement au mélange. ', 'Retirer les bananes du feu et de la poêle, laisser refroidir le sirop obtenu dans la poêle. ', 'Imbiber les boudoirs, que vous aurez placés au fond du plat de façon à le recouvrir; les recouvrir de bananes, puis de crème. Saupoudrer avec le chocolat. ', 'Laisser au moins 3 heures au frais. ', 'Au moment de servir, décorer avec la banane qui vous reste.'], ['Spatule', 'Économe', 'Planche à découper', 'Moule à tarte'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'facile', 'bon marché', 'cacao', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Tiramisu banane pas cher', 'tiramisu', 'beurre', 'boudoir', 'sucre', 'crème épaisse', 'cocktail'], 'Dessert', d52500e0-34f7-445b-b890-b813c57c12bb, '2025-09-26T15:44:04.832388', [{'ingredient_id': '433f6c70-f11a-46bd-ba8c-f44da97650ef', 'quantite': '3'}, {'ingredient_id': 'a8f0c62a-ff61-4763-98f9-d9e7cba16ea8', 'quantite': '20'}, {'ingredient_id': '7e33f668-f121-45f7-9208-23fddcd50fa4', 'quantite': '20 cl'}, {'ingredient_id': '692744d7-1b16-4e95-8016-cbfac050a21d', 'quantite': '1'}, {'ingredient_id': '7d330d1d-26f2-4c9a-a1de-50149ba5c52c', 'quantite': '3 cuillères'}, {'ingredient_id': '8c896f24-5887-4954-9cba-3ebc51efdea5', 'quantite': '3 cuillères'}, {'ingredient_id': 'b59d6e58-0c24-419d-84c3-50595e384042', 'quantite': '2 cuillères'}, {'ingredient_id': 'e4a65091-3043-4611-a6f0-9227e6b7116e', 'quantite': '10 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (337339, 'Rhum arrangé - Ananas Banane', 'rhum, banane, ananas, vanille, citron vert', '20 min', ['Prévoir 1 bocal en verre de 1.5 l qui ferme bien.', 'Couper les 3 bananes en tranches de 1 à 2 cm et les poser au fond du bocal.', 'Couper l''un ananas en cubes de 2 à 3 cm et les positionner au dessus des morceaux de bananes.', 'A l''aide d''un couteau fin et pointu, fendre la gousse de vanille sur toute la longueur et la positionner à l''intérieur du bocal, au milieu des fruits avec les graines. Couper le demi citron en deux et l''ajouter au bocal. ', 'Recouvrir l''ensemble de rhum blanc (40 à 50°, selon vos goûts). ', 'Fermer le bocal hermétiquement. Marquer le bocal avec la date de la préparation et attendre 4 à 5 mois pour déguster.', 'Je n''ajoute du sucre roux (une à deux cuillères à soupe) qu''après le temps de maturation...Tout dépend du sucre contenu dans les fruits.', 'Deux possibilités pour la dégustation:', '- Proposer les fruits imbibés en même temps qu''une coupe de rhum.', '- Séparer le rhum des fruits et le servir seul.', 'Une autre recette est possible sans bananes, mais avec ananas et kiwi (voir mes autres recettes).'], ['Balance de cuisine', 'Spatule', 'Presse-agrumes'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'facile', 'rapide', 'plat', 'cocktail rhum', 'recette', 'cuisine', 'recettes', 'boisson', 'vanille', 'dessert', 'plat de résistance', 'moyen', 'ananas', 'citron vert', 'Rhum arrangé - Ananas Banane', 'cocktail'], 'Boisson', de676beb-d29a-42af-972c-58bf070fded7, '2025-09-26T15:44:08.347570', [{'ingredient_id': '0195cc7f-8412-4b78-9c57-b49dd41bab0a', 'quantite': '70 cl'}, {'ingredient_id': '7c8d4915-a470-4544-a714-737eecc89168', 'quantite': '3'}, {'ingredient_id': '50e483b8-84ed-4cb8-b9b9-a84d97fb6c1c', 'quantite': ''}, {'ingredient_id': '700f722f-dbfe-42b5-87ce-b4d5d22e293b', 'quantite': '1'}, {'ingredient_id': 'ea6f9f65-a4fb-42d9-93d6-27fc2a360a5b', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (339912, 'Petits gâteaux chocolat-banane croquants et moelleux', 'banane, oeuf, chocolat au lait, farine, sucre, levure chimique, lait, extrait de vanille, amandes en poudre, sucre glace', '10 min', ['Faire fondre le chocolat au bain marie ou au micro-ondes et pendant ce temps écraser la banane à l''aide d''une fourchette (si vous voulez qu''il y ait des morceaux) ou munissez vous d''un mixeur. Réunir ces deux ingrédients dans un saladier et les mélanger.', 'Ajouter l''oeuf, la farine, la levure, le sucre et le lait (vous pouvez ajouter une cuillère à café d''extrait de vanille si vous le souhaitez). Mélanger jusqu''à obtention d''une pâte homogène et ferme.', 'Avec votre pâte former des boules sur du papier sulfurisé que vous aurez préalablement disposé sur une plaque.'], ['Économe', 'Passoire', 'Poêle'], ['Petits gâteaux chocolat-banane croquants et moelleux', 'chocolat au lait', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'extrait de vanille', 'facile', 'bon marché', 'amandes en poudre', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre glace', 'gâteau au chocolat', 'sucre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:44:11.904773', [{'ingredient_id': '6a6d2031-20ad-4c8f-9bb5-7b8ee427b887', 'quantite': '1'}, {'ingredient_id': 'aa8da5ee-3bb2-47cd-b367-72729b00b3d4', 'quantite': '1'}, {'ingredient_id': 'c99ef577-fa6c-41ea-b13a-d3fcffda6587', 'quantite': '50 g'}, {'ingredient_id': '75df453e-2148-4f18-84a6-69c9211259a2', 'quantite': '150 g'}, {'ingredient_id': '7c65b8d2-b80f-45a4-a700-d1017f678b23', 'quantite': '20 g'}, {'ingredient_id': '2bbe56ae-5cc8-4980-8f21-d52e64d1e692', 'quantite': ''}, {'ingredient_id': '52601dcd-eb45-4ec8-9fb1-56cb8eeb1fe3', 'quantite': '2 cl'}, {'ingredient_id': '0c5ffc5a-e2c7-43d1-b6af-966d86b3e581', 'quantite': ''}, {'ingredient_id': '0a3cb7ef-f13a-46dc-bec1-b2ffb59b710f', 'quantite': ''}, {'ingredient_id': 'c8d1646d-5bfd-42e9-8d9b-68ba82d77a24', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (211377, 'Le milkshake kiwi-banane d''Ambre', 'kiwi, banane, yaourt nature, lait, sucre vanillé, extrait d''amande amère', '10 min', ['Éplucher les kiwis, les couper en morceaux et les réserver dans un petit saladier.', 'Éplucher et couper la banane en rondelles, les mettre dans le saladier avec les kiwis.', 'Mixer à l''aide d''un mixer jusqu''à obtenir une texture onctueuse.', 'Ajouter un yaourt et mixer pour bien mélanger, renouveler l''opération avec le 2ème yaourt.', 'Ajouter du lait par petites quantités et mixer entre chaque ajout de lait jusqu''à obtention de la bonne texture (c''est-à-dire assez liquide pour être bu à la paille mais pas trop non plus pour que le mélange reste onctueux).', 'Verser le sachet de sucre vanillé, mixer.', 'Finir avec l''amande amère et mixer à nouveau.', 'Réserver au réfrigérateur au moins 30 min.', 'Servir dans dans un grand verre avec une paille.'], ['Tire-bouchon', 'Balance de cuisine'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'yaourt nature', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'Le milkshake kiwi-banane d''Ambre', 'lait', 'cocktail', 'extrait d''amande amère'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:44:15.509360', [{'ingredient_id': '5482661d-3c4f-4d88-a27a-f0c3e9d5a4d9', 'quantite': '4'}, {'ingredient_id': '094b26ad-1b20-40e9-9e2e-3de2fc44e223', 'quantite': '1'}, {'ingredient_id': '872c5072-b5fa-4867-81ce-389447c81a5e', 'quantite': '2'}, {'ingredient_id': '9283a904-0fd0-4ff1-99da-8785b89f60bf', 'quantite': ''}, {'ingredient_id': '9f86eff5-c266-4266-8c79-8d56bbed2c64', 'quantite': '1'}, {'ingredient_id': '189ff517-d0dd-4575-82c9-c87f8e25b929', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (45452, 'Bananes au lait de coco tout simple', 'lait de coco, banane, cassonade, cannelle', '5 min', ['Faire bouillir le lait de coco sucré à votre convenance, avec un peu de cannelle.', 'Ajouter la banane en rondelles, et laisser cuire 5 min.', 'Servir aussitôt!'], ['Rouleau à pâtisserie', 'Pince de cuisine', 'Couteau de chef', 'Louche', 'Poêle'], ['', 'lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'cassonade', 'très facile', 'bon marché', 'rapide', 'Bananes au lait de coco tout simple', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:44:19.054369', [{'ingredient_id': '716ce41a-bd4a-4cd9-a6ed-a16cadeb2b7e', 'quantite': '150 ml'}, {'ingredient_id': 'df8b69d0-96bd-41c8-b301-1e5afdc1d78f', 'quantite': '1'}, {'ingredient_id': 'df7cf14d-4d7e-4d06-b821-6cddd2672cf1', 'quantite': ''}, {'ingredient_id': '81627e5a-00d9-4fc9-9d27-b82668971e6e', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (343256, 'Gateau au yaourt kaki-banane', 'yaourt, farine, cassonade, oeuf, banane, kaki, huile, levure chimique, limoncello', '10 min', ['Mélanger le yaourt, la farine, la cassonade, l''oeuf, la banane écrasée, l''huile, la levure chimique et le limoncello dans un grand saladier.', 'Verser la pâte obtenue dans un moule beurré.', 'Couper le kaki en dés et les ajouter à la pâte.', 'Laisser cuire 30 min à 180°C (thermostat 6) dans un four traditionnel.'], ['Râpe', 'Batteur électrique', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'cassonade', 'levure chimique', 'très facile', 'bon marché', 'Gateau au yaourt kaki-banane', 'oeuf', 'limoncello', 'plat', 'recette', 'cuisine', 'kaki', 'recettes', 'boisson', 'huile', 'farine', 'dessert', 'plat de résistance', 'gâteau à la banane', 'cocktail'], 'Dessert', 17b2bd6c-504a-4bc3-943d-e867ff903502, '2025-09-26T15:44:22.656190', [{'ingredient_id': '4d7a7676-9a05-4c72-89fe-3a607cf350f2', 'quantite': '1'}, {'ingredient_id': 'fc0e47fe-e7bc-4e36-9658-83ecfb5f96bd', 'quantite': '2'}, {'ingredient_id': '0bf75467-1fd8-4790-b699-354716dd966b', 'quantite': ''}, {'ingredient_id': 'e3580207-3811-4b01-8c17-aa2e4c25cfb2', 'quantite': '1'}, {'ingredient_id': 'ea0252fa-d265-429a-af16-8feeca8eb1d3', 'quantite': '1'}, {'ingredient_id': '7a750eed-1f12-4846-960f-0b7038a21550', 'quantite': '1'}, {'ingredient_id': 'f5d1eb19-fb33-46d2-bbe6-226d8137836d', 'quantite': ''}, {'ingredient_id': '13a1eabb-3892-4ab9-89dc-8b01657b2247', 'quantite': '1'}, {'ingredient_id': '81e4755d-b807-41e3-ae95-f23e33525dc7', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (22936, 'Paupiettes antillaises', 'banane, jambon blanc, crème liquide, gruyère râpé, paprika, poivre, sel', '15 min', ['Couper les bananes et les tranches de jambon en deux, saupoudrer le jambon d''une belle pincée de paprika et de poivre, et enrouler chaque moitié de banane dans chaque demi-tranche de jambon. ', 'Disposer le tout dans un plat à gratin, arroser de crème liquide +/- selon les goûts, parsemer de fromage, saler très légèrement et mettre à four chaud, jusqu''à ce que le dessus soit bien doré. ', 'Servir avec une salade verte bien assaisonnée.'], ['Économe', 'Rouleau à pâtisserie', 'Tire-bouchon', 'Planche à découper'], ['paupiette', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'paprika', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'gruyère râpé', 'Paupiettes antillaises', 'jambon blanc', 'dessert', 'plat de résistance', 'poivre', 'cocktail'], 'Plat principal', e84d3972-a4d7-4c81-92b9-5fdcac6a4ba3, '2025-09-26T15:44:26.287347', [{'ingredient_id': '47819ec0-f27f-4943-aed5-bfef75efc8d7', 'quantite': '4'}, {'ingredient_id': 'b3e3dc3a-84b6-4ed9-86d0-b14e4139c978', 'quantite': '4'}, {'ingredient_id': '049e72b7-d69e-47a7-be23-25ed0a80ee6f', 'quantite': '20 cl'}, {'ingredient_id': 'db9ecae2-a5d9-4f05-9863-ba788ed096c8', 'quantite': '125 g'}, {'ingredient_id': 'c3be0b7f-1599-4ac2-b024-4f8f3a7bcd5d', 'quantite': ''}, {'ingredient_id': '8f05751b-bb77-4870-9051-aca5b5f3f570', 'quantite': ''}, {'ingredient_id': 'ca2dd88b-17af-4a61-8783-2d7d8cd92421', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (57229, 'Bananes à la noix de coco et au praliné', 'banane, beurre, oeuf, praliné, noix de coco rapée, chocolat, sucre, rhum, noisettes, café, café, vermicelles', '25 min', ['Peler les bananes.', 'Faire le beurre dans une poêle et mettre les banane à dorer.', 'Les saupoudrer de sucre cristallisé, arroser de rhum et les flamber.', 'Casser le chocolat dans une casserole contenant le café.', 'Mettre à fondre sur feu doux en fouettant, puis y ajouter le praliné et les jaunes d''oeufs (réserver les blancs) hors du feu.', 'Battre les blancs d''oeufs en neige, puis les ajouter au mélange ainsi que les noisettes préalablement dorées au four.', 'Verser la mousse dans des coupes individuelles.', 'Poser une banane dessus, saupoudrer de nois de coco, de vermicelles au chocolat et décorer avec les grains de café.', 'Mettre 3 heures au réfrigérateur.'], ['Rouleau à pâtisserie', 'Planche à découper', 'Batteur électrique'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'assez cher', 'chocolat', 'vermicelles', 'oeuf', 'plat', 'moyenne', 'Bananes à la noix de coco et au praliné', 'recette', 'café', 'noisettes', 'cuisine', 'recettes', 'boisson', 'noix de coco rapée', 'dessert', 'plat de résistance', 'beurre', 'sucre', 'cocktail', 'praliné'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:44:30.693105', [{'ingredient_id': '8f0ed2f6-c4c9-42a9-918b-05606efd0da5', 'quantite': '6'}, {'ingredient_id': '5039974e-1f6f-4cb5-9d8f-02f7d8697c5e', 'quantite': '50 g'}, {'ingredient_id': '9aba7855-5675-488a-a3fb-a08ce68a88e9', 'quantite': '3'}, {'ingredient_id': 'eb667bc4-7541-486b-924b-a808b5a63638', 'quantite': '125 g'}, {'ingredient_id': 'e064860b-5495-4b91-bbbf-6c14f04fadea', 'quantite': '125 g'}, {'ingredient_id': '4e09121c-70a6-4d75-ba74-705384faeec4', 'quantite': '250 g'}, {'ingredient_id': 'e4dac2a2-f733-4c0c-92fd-3fa369e79274', 'quantite': '30 g'}, {'ingredient_id': 'b20623db-8364-4542-8ec3-8ccfbf45432a', 'quantite': '10 cl'}, {'ingredient_id': 'f8c47b5c-ec9e-4c8a-ad2e-0bf1203f8909', 'quantite': '50 g'}, {'ingredient_id': '802540a7-c1b1-46e0-bb99-01a14ddd9cd3', 'quantite': '4 cuillères'}, {'ingredient_id': '2b13690f-ac8d-46f4-8948-ca8c65625eea', 'quantite': '12'}, {'ingredient_id': 'd688d1bb-4406-4460-867a-ff09c64d816f', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (70340, 'Poulet gourmand au curry et lait de coco', 'escalope de poulet, poivron vert, concombre, banane, tomates pelées, carotte, pomme de terre, lait de coco, curry, oignon, échalote, cube de bouillon, huile d''olive, gingembre, cannelle', '30 min', ['Faites revenir le poulet avec 1 cuillère à soupe d''huile d''olive jusqu''à qu''il devienne blanc puis le retirer. Dans la même casserole, faire revenir l''oignon et l''échalote ainsi que le poivron coupés en petits morceaux.', 'Peler le concombre, le couper dans le sens de la longueur et enlever les pépins. Le couper en petits morceaux et l''ajouter avec la carotte et la pomme de terre préalablement pelée ainsi que la banane.', 'Passer la boîte de tomates pelées à la passoire, ajouter les tomates au mélange et conserver le jus.', 'Remettre le poulet dans la préparation avec le lait de coco et les 2 cuillères à café de curry.', 'Mélanger le jus de tomate avec un bouillon de poule et l''ajouter à la ', 'préparation. Ajouter le gingembre et la cannelle.', 'Laisser mijoté 1 h à feu moyen en remuant de temps en temps.', 'A servir avec du riz.'], ['Couteau de chef', 'Mixeur', 'Casserole', 'Louche', 'Râpe'], ['lait de coco', 'gingembre', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'tomates pelées', 'carotte', 'poivron vert', 'curry de poulet', 'plat', 'moyenne', 'escalope de poulet', 'recette', 'cube de bouillon', 'cuisine', 'recettes', 'oignon', 'boisson', 'huile d''olive', 'Poulet gourmand au curry et lait de coco', 'dessert', 'plat de résistance', 'moyen', 'concombre', 'cannelle', 'pomme de terre', 'curry', 'cocktail', 'échalote'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:44:34.339684', [{'ingredient_id': '5673068b-aa56-457f-9ea3-7c94b79c56a6', 'quantite': '4'}, {'ingredient_id': '785e47a5-549c-4692-894b-884c59acf4e1', 'quantite': '1'}, {'ingredient_id': '52c68146-59e1-44f2-9c60-0791f89cae9a', 'quantite': '1'}, {'ingredient_id': '631fed4f-8ce5-4c9a-b7b6-3755ac843984', 'quantite': '1'}, {'ingredient_id': 'dd57b2ff-ffea-44bf-a66b-204d56e7f3a2', 'quantite': '1'}, {'ingredient_id': 'b953cac4-8e66-47fe-826f-b674645f6df2', 'quantite': '1'}, {'ingredient_id': '952e59e3-c40b-4f60-94b8-fa329cec2ace', 'quantite': '1'}, {'ingredient_id': '9606507b-b8c6-4f64-b268-4a526dccc120', 'quantite': '1'}, {'ingredient_id': 'ae033ccc-40df-416a-a65d-2e7cfab37a1d', 'quantite': '2 cuillères'}, {'ingredient_id': '1a7ca04d-3af0-4b1a-9425-9551ad67f3a4', 'quantite': '1'}, {'ingredient_id': '49debfa6-6b7e-4bcd-8a54-2050bb23ff10', 'quantite': '1'}, {'ingredient_id': 'e85b0308-575e-41c7-a896-e5cd0790dad0', 'quantite': '1'}, {'ingredient_id': '2bb536b5-dbd1-441b-b6af-e285b847b817', 'quantite': '1 cuillères'}, {'ingredient_id': 'e6a4a724-4eed-4946-be18-6c974c969d2d', 'quantite': '1'}, {'ingredient_id': '6a66d0c1-5068-47f7-b34b-d83190dc3750', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (36944, 'Gateau papou pilou', 'oeuf, beurre, farine, sucre en poudre, chocolat, levure, noix de coco, banane, chocolat amer', '30 min', ['Faire fondre le chocolat avec le beurre (au bain-marie ou au micro-onde), bien mélanger.', 'Séparer les blancs des jaunes d''oeufs.', 'Battre les jaunes avec le sucre jusqu''à blanchiment de la préparation.', 'Battre les blancs en neige ferme.', 'Ajouter le mélange chocolat fondu-beuure à la préparation jaune-sucre.', 'Ajouter les blancs et la farine à la préparation précédente. Enfin ajouter la noix de coco rapée, bien mélanger.', 'Mettre au four à 180°C (thermostat 6) pendant 40 minutes.', 'Lorsque le gâteau est cuit et tiédi le couper en 2 dans l''épaisseur.', 'Sur la moitié du dessous y disposer les bananes en rondelle et recouvrir avec la deuxième moitié de gâteau.', 'Faire un glacage avec le chocolat amer en poudre délayé dans de l''eau et en recouvrir le gâteau.', 'Saupoudrer le gâteau glacé de noix de coco rapé.'], ['Passoire', 'Casserole', 'Tire-bouchon', 'Mixeur', 'Batteur électrique'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'facile', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'levure', 'recettes', 'Gateau papou pilou', 'boisson', 'farine', 'dessert', 'plat de résistance', 'chocolat amer', 'moyen', 'beurre', 'noix de coco', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:44:38.009350', [{'ingredient_id': '86c32e54-1261-4e55-b23d-ef7c5971e37e', 'quantite': '3'}, {'ingredient_id': '3aafe5b9-3124-4161-a518-0b9efd4fde4e', 'quantite': '75 g'}, {'ingredient_id': 'ebae9044-1d8c-446b-9c3e-9c19596d55e8', 'quantite': '75 g'}, {'ingredient_id': '5728145b-3e2e-4cd5-b040-54cb4e15d951', 'quantite': '100 g'}, {'ingredient_id': 'd1e05c58-81b0-46f4-993d-3a6359b0f92e', 'quantite': '100 g'}, {'ingredient_id': 'f31eb121-f97b-4bba-9a76-774c839afa8b', 'quantite': ''}, {'ingredient_id': '66fb4479-d8f0-4e23-bdaa-c13d6a7b8eb9', 'quantite': '200 g'}, {'ingredient_id': '776f9c33-bc41-4e11-9d08-29ce89b51d2f', 'quantite': '3'}, {'ingredient_id': 'ec863041-5af6-4151-a257-5f3a4d90ba81', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (392342, 'Banana Kiwi', 'banane, kiwis, citron, sirop d''érable', '0 min', ['Réalisez la recette "Banana Kiwi" directement dans le verre.', 'Pelez les kiwis et la banane et coupez-les en rondelles. Versez dans votre bol mixer, ajoutez le jus du citron et le miel.  Mixez pour obtenir un mélange bien lisse et versez dans les verres.', 'Servir dans un verre de type "tumbler".'], ['Casserole', 'Économe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Banana Kiwi', 'sirop d''érable', 'facile', 'kiwis', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'citron', 'cocktail'], 'Boisson', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T15:44:41.522694', [{'ingredient_id': '0d86dedc-ad58-4ce8-807d-de401dda9a61', 'quantite': '1'}, {'ingredient_id': 'c0d66f03-a761-4c7d-b6e7-f46ceac2b0bd', 'quantite': '5'}, {'ingredient_id': '99108f15-c23c-4ebe-baa5-61365bd7ddbc', 'quantite': '1'}, {'ingredient_id': 'bbecfee3-6fef-4f52-9861-670fe5232445', 'quantite': '4 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (26530, 'Rôti des îles', 'rôti de porc, poivre, sel, clou de girofle, ananas, banane, pomme, rhum', '20 min', ['1) Piquer le rôti de clous de girofle et assaisonner de sel et de poivre. Couvrir et placer le rôti au four à 210°C. ', '2) Pendant la cuisson, préparer les fruits : trancher les bananes en rondelles et les pommes en lamelles assez épaisses. Les faire revenir à la poêle dans du beurre pour qu’ils caramélisent. Egoutter les tranches d’ananas. Mettre le tout de côté dans un plat qui va au four. ', '3) Découvrir le rôti pour la dernière demi-heure de cuisson. Mettre les pommes et bananes au four pendant le dernier quart d’heure pour qu’ils soient bien chauds et placer les tranches d’ananas dans le plat du rôti. ', '4) Placer le rôti dans un plat de service et disposer les fruits tout autour. Préparer un sirop de rhum en faisant chauffer dans une casserole 2/3 de rhum et 1/3 d’eau sans atteindre l''ébullition. Verser le sirop sur le rôti et faire flamber !'], ['Poêle', 'Presse-agrumes'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'sel', 'confiserie', 'testées', 'assez cher', 'facile', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'clou de girofle', 'dessert', 'plat de résistance', 'pomme', 'Rôti des îles', 'ananas', 'poivre', 'cocktail', 'rôti de porc'], 'Plat principal', 9306a76a-7260-4601-9c7f-70372150372d, '2025-09-26T15:44:45.118893', [{'ingredient_id': 'ec5a7a49-7634-41a2-bfb4-4ffa582761dd', 'quantite': '1'}, {'ingredient_id': 'f3a1b3d8-9357-435b-8bb4-0998650c84a3', 'quantite': ''}, {'ingredient_id': '5021e14f-5779-4723-a914-921874424892', 'quantite': ''}, {'ingredient_id': '327d45c1-ff56-4558-9fe9-6d8854ff05c4', 'quantite': ''}, {'ingredient_id': 'f9446d72-89ad-4031-8d84-6b95978d6db7', 'quantite': '1'}, {'ingredient_id': 'd7084b25-e5c8-4de8-9c61-e0aaf64de6d6', 'quantite': '3'}, {'ingredient_id': '01a75897-11d3-47bf-b50a-e077374d1392', 'quantite': '3'}, {'ingredient_id': '2fd9bb4d-345c-45e0-a120-87d703d53577', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (68301, 'salade de fruits au chocolat', 'banane, orange, fraises, kiwi, citron, Nutella', '30 min', ['-Coupez les bananes en fines rondelles.', '-Pelez a vif l''orange et coupez la en tranches plates.', '-Coupez les fraises en deux', '-Pelez le kiwi,puis le découpez en tranches.', '-Posez les tranches d''orange a plat au fond d''un saladier.', '-Faire la même chose mais par dessus l''orange avec le kiwi', '-Placez pareillement les rondelles de bananes sur le kiwi', '-Recouvrir le tout par des fraises', '-Répartir le chocolat sur la salade.', '-Enfin arrosé la salade par le jus d''un citron.', 'Mangez votre salade tout de suite.', 'NE PAS METTRE AU FRIGO OU LE CHOCOLAT VA DURCIR.'], ['Pince de cuisine', 'Ouvre-boîte', 'Spatule', 'Poêle'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'Nutella', 'dessert', 'plat de résistance', 'moyen', 'citron', 'orange', 'cocktail', 'salade de fruits au chocolat'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:44:49.378013', [{'ingredient_id': 'bbfc3cd0-1e38-4dec-bfab-afc6c372165a', 'quantite': '2'}, {'ingredient_id': '100619a0-9e26-444c-b83a-2ddb12696b33', 'quantite': '1'}, {'ingredient_id': 'bc7bbe25-6a26-4eb7-a730-e11d89fe6757', 'quantite': '250 g'}, {'ingredient_id': 'c054fdb1-c650-4149-aafb-45b40ce65503', 'quantite': '3'}, {'ingredient_id': '001b0fec-39f3-46a4-97b3-6101cc4eb30a', 'quantite': '1'}, {'ingredient_id': 'ed0a9207-f4e2-4cde-83c7-3849e3e27d7b', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (68473, 'Smoothie Mangue Kiwi Banane', 'mangue, banane, kiwi, orange, yaourt, fruits', '15 min', ['Mettez le yaourt et le jus de fruit dans le fond du blender.', 'Epluchez et coupez les fruits en petit morceaux puis mettez-les dans le blender.', 'Mixez quelques instants.'], ['Mixeur', 'Poêle'], ['entrée', 'banane', 'kiwi', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'orange', 'fruits', 'Smoothie Mangue Kiwi Banane', 'smoothies', 'cocktail'], 'Boisson', fc616e9e-2f07-4e5f-9453-79bca5abae1e, '2025-09-26T15:44:52.941403', [{'ingredient_id': '76ac0140-6bf9-4582-b4c3-107ac8ac3529', 'quantite': '1'}, {'ingredient_id': 'c3e06542-b14f-42a0-8113-1830e453efe4', 'quantite': '1'}, {'ingredient_id': '6735bb50-9629-4ad6-854b-61a71671d35f', 'quantite': '2'}, {'ingredient_id': 'd516e991-4bfc-4e03-b728-1f2c59d8e7b8', 'quantite': '2'}, {'ingredient_id': '101d66b5-ddb3-47e6-9ff7-79781651713a', 'quantite': '1'}, {'ingredient_id': 'd8b15648-f672-4fb2-a396-677b8ec1bd1d', 'quantite': '25 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (15809, 'Tarte aux bananes des îles', 'banane, oeuf, sucre roux, vanille, gelée, rhum vieux, farine, beurre, oeuf, vanille', '25 min', ['Préparer la pâte brisée en mélangeant la farine au beurre ramolli, puis lier le tout avec l''oeuf et la vanille.', 'Ecraser les bananes (en garder 1 pour la déco et la couper en rondelles), puis les mélanger avec le sucre, la vanille et le rhum.', 'Mettre la ''compote'' de bananes sur votre pâte brisée dans un moule à tarte et faire cuire 10 mn à four chaud (230°C / thermostat 8), puis 25 mn à four moyen (180°C / thermostat 6).', 'Lorsque la tarte est cuite et encore chaude, la napper de gelée de groseilles, puis laisser refroidir.'], ['Passoire', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'rhum vieux', 'testées', 'facile', 'bon marché', 'Tarte aux bananes des îles', 'oeuf', 'plat', 'tarte à la banane', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'vanille', 'dessert', 'plat de résistance', 'gelée', 'beurre', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:44:56.565617', [{'ingredient_id': '73905ebd-f657-4e99-b243-b0193a71df0f', 'quantite': '5'}, {'ingredient_id': 'f9beeb29-520c-4d85-967a-51bd3e0735c8', 'quantite': '2'}, {'ingredient_id': '006f7f11-8d91-407a-9bd1-fb72c9f8aaf9', 'quantite': '30 g'}, {'ingredient_id': '642ec52e-714a-4370-bd02-ba9e3fc2d14b', 'quantite': '2 cuillères'}, {'ingredient_id': 'd754f993-dac1-44b5-bd87-1f5564b050c1', 'quantite': '3 cuillères'}, {'ingredient_id': '329828ac-0132-4663-b3b3-a10966f329e0', 'quantite': '1'}, {'ingredient_id': '00094854-641f-4c12-a931-0bad957c53b2', 'quantite': '200 g'}, {'ingredient_id': '488f4e2a-4bac-4315-bf9e-41ac15b3428e', 'quantite': '100 g'}, {'ingredient_id': 'ac480ab5-a980-4ad2-8aa6-efcda9a59c24', 'quantite': '1'}, {'ingredient_id': 'a5cab2a0-2c32-458b-ab10-8d0d22a1cb14', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (330207, 'Tartelette banane façon crumble', 'banane, pâte feuilletée, sucre vanillé, rhum, beurre salé, farine, amandes en poudre, cannelle, cacao', '10 min', ['Préchauffer le four à 180°C (thermostat 6). ', 'Tailler la pâte feuilletée pour les moules. Piquer le fond et précuire 5 minutes. Conserver les chutes.', 'Écraser 1/2 banane grossièrement avec 1 cuillère à café de sucre vanillé et le rhum. Répartir dans les moules.', 'Découper le reste de la banane en fines rondelles. Les placer en forme de rosace sur la tartelette.', 'Pour le crumble :', 'Mélanger le beurre mou, 1 cuillère à café de sucre vanillé, la farine, la poudre d''amandes et la cannelle pour obtenir une consistance sableuse. ', 'Saupoudrer cette pâte sur la tartelette.', 'Avec les chutes, vous pouvez décorer le dessus en découpant des lamelles. ', 'Ajouter une petite touche de cacao en poudre pour finir. ', 'Faire dorer 15 minutes environ.'], ['Balance de cuisine', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'facile', 'beurre salé', 'cacao', 'bon marché', 'amandes en poudre', 'plat', 'tarte à la banane', 'recette', 'Tartelette banane façon crumble', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'pâte feuilletée', 'sucre vanillé', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:45:01.168391', [{'ingredient_id': '55e6e60b-6901-47e4-9daa-53c399c83110', 'quantite': '1'}, {'ingredient_id': '8e95ba03-7916-475a-8333-56b2f54e4059', 'quantite': ''}, {'ingredient_id': '3d3409c6-3d0c-4b17-8935-14e9dfd085a3', 'quantite': '2 cuillères'}, {'ingredient_id': '64085aa3-015d-4b7c-a0e4-c64da2a262ad', 'quantite': '1 cuillères'}, {'ingredient_id': '236bc50c-f348-46e1-a480-8f5ded10b419', 'quantite': '15 g'}, {'ingredient_id': 'bbb7b806-1b7f-4270-adec-857de3a6d1df', 'quantite': '1 cuillères'}, {'ingredient_id': '1c180009-d697-4977-8eb1-6bf2093f26aa', 'quantite': '1 cuillères'}, {'ingredient_id': '63fddcae-8811-4ea9-b0f7-2091561274be', 'quantite': '1'}, {'ingredient_id': '7020d836-9201-4ef4-8a60-b2bd3d0b66fc', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (65020, 'Crumble choco-banana rhum (façon Kinou)', 'banane, sucre, beurre tendre, farine, crème dessert au chocolat, rhum, sucre vanillé', '10 min', ['Eplucher les bananes et les couper en fines tranches.', 'Dans une petite casserole, faire chauffer un peu de beurre et y faire cuire les bananes à feu très doux.', 'Pendant ce temps, préparer dans un saladier la pâte du crumble.', 'Malaxer le beurre, la farine et 70 g de sucre.', 'Quand les bananes sont cuites, verser 30 g de sucre et un sachet de sucre vanillé. Remuer.', 'Préchauffer le four à 180°C (thermostat 6).', 'Déposer les bananes dans le fond d''un plat.', 'Ajouter une cuillère à soupe de rhum. Bien mélanger.', 'Ensuite, faire fondre 40 g de chocolat. Verser le chocolat fondu sur les bananes et bien mélanger.', 'Répartir enfin la pâte sur la préparation et mettre au four environ 30 minutes (dès que la pâte du crumble dore).', 'A déguster tiède ou chaud.'], ['Râpe', 'Pince de cuisine', 'Ouvre-boîte'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'beurre tendre', 'très facile', 'bon marché', 'Crumble choco-banana rhum (façon Kinou)', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'autres crumbles', 'crème dessert au chocolat', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:45:04.836672', [{'ingredient_id': '70038a27-4588-4f00-882c-31656194bb6c', 'quantite': '2'}, {'ingredient_id': '5a2f513c-b4e2-456a-aa73-c87142479eba', 'quantite': '100 g'}, {'ingredient_id': '4972d05d-d091-446c-a616-9412a369f5d3', 'quantite': '70 g'}, {'ingredient_id': 'fa1b44b1-d94f-412b-ad42-15d513140f1d', 'quantite': '80 g'}, {'ingredient_id': '98040d05-19d4-4546-a045-b21c47f252e2', 'quantite': '40 g'}, {'ingredient_id': 'f4fe1906-15a4-4b39-8cd5-6fbdc4e1da86', 'quantite': '1 cuillères'}, {'ingredient_id': 'e86f9fc8-4eb5-4dd7-9578-96b9a1a58fdd', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (64096, 'Cake moelleux rapide', 'farine, levure, cassonade, beurre, oeuf, lait, rhum, raisins secs, noix, amandes, chocolat, pomme, banane', '10 min', ['Précahuffer le four à 210°C (thermostat 7).', 'Mélanger tous les ingrédients dans l´ordre et y ajouter à la fin fruits secs et/ou fruits frais. Mettre la pâte dans un moule à cake en silicone.', 'Enfourner à four chaud et cuire 30 mn environ. (Vérifier la cuisson avec un couteau)'], ['Couteau de chef', 'Poêle', 'Pince de cuisine'], ['', 'amandes', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'cassonade', 'chocolat', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'noix', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'pomme', 'beurre', 'Cake moelleux rapide', 'raisins secs', 'lait', 'cocktail'], 'Dessert', 5892e9b3-e324-49f3-9898-f812042a73a5, '2025-09-26T15:45:09.626395', [{'ingredient_id': '59df2045-2c12-4279-8570-ebf119cd3e81', 'quantite': '220 g'}, {'ingredient_id': '9f456cbd-f60e-49aa-a231-7a37a563d9dd', 'quantite': '1'}, {'ingredient_id': '45a15a33-8025-4542-a90f-5c42721ea656', 'quantite': '110 g'}, {'ingredient_id': '51600bd8-7858-4720-b92b-aded6825fe5d', 'quantite': '60 g'}, {'ingredient_id': 'bd0904ce-62e1-47a4-be21-251d5f225b02', 'quantite': '2'}, {'ingredient_id': '2e8ad1b7-13d2-49ff-a1b3-b1c27e5e5426', 'quantite': ''}, {'ingredient_id': 'ef3c0b8b-f888-4e09-94ec-5f9ff0385d51', 'quantite': ''}, {'ingredient_id': '0422d10e-8c35-4641-8d2c-00d61e1f0b8a', 'quantite': ''}, {'ingredient_id': 'ba7183af-9bb7-47b7-b286-dcae4c5d883f', 'quantite': ''}, {'ingredient_id': 'ce4ab618-4be0-4644-8b26-1ab0846f4141', 'quantite': ''}, {'ingredient_id': '045a608d-15cc-4a50-9d83-85994cf213b1', 'quantite': ''}, {'ingredient_id': '96f97074-3b82-40c9-82c7-ff6a620340ce', 'quantite': ''}, {'ingredient_id': '85ae9582-bcf3-42c1-9f9c-56847677b1df', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (18422, 'Brochettes au chocolat', 'chocolat pâtissier, banane, pomme, kiwi, fraises, noix de coco rapée, beurre, eau, jus de citron', '15 min', ['Au bain-marie, faire fondre le chocolat avec le beurre et l''eau.', 'Laver, peler, couper et citronner les fruits si nécessaire.', 'Enfiler les fruits sur des pics à brochettes en bois puis poser sur du papier alumnium et napper de chocolat fondu. Saupoudrer de noix de coco rapé.', 'Poser les brochettes dans une assiette et placer minimum une heure au réfrigérateur.', 'Sortir juste avant de servir. Avec le chocolat fondu non utilisé, préparer une sauce : pour cela, ajouter, quelques cuillères à soupe de lait de coco. Mélanger et servir bien frais. Ou napper les brochettes une fois servies de chocolat chaud.'], ['Casserole', 'Pince de cuisine', 'Spatule', 'Couteau de chef', 'Mixeur'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'chocolat pâtissier', 'cuisine', 'recettes', 'boisson', 'noix de coco rapée', 'dessert', 'plat de résistance', 'jus de citron', 'pomme', 'beurre', 'Brochettes au chocolat', 'cocktail'], 'Dessert', bfd08d48-ddc8-4226-807b-532e8c4399fa, '2025-09-26T15:45:13.126660', [{'ingredient_id': 'e4999cba-4437-4d66-a505-e75206067390', 'quantite': '200 g'}, {'ingredient_id': '6653cda5-327c-418b-8c3b-09e76258eeec', 'quantite': '2'}, {'ingredient_id': '7b3f1501-7e7f-4804-86aa-b7e89ebaf0ee', 'quantite': '2'}, {'ingredient_id': 'd3f801ca-21f2-41cc-9857-06b6d2d43ede', 'quantite': '2'}, {'ingredient_id': '1b5d4775-1299-4555-a020-c60f21c45d49', 'quantite': '8'}, {'ingredient_id': 'b043b63f-55d3-4f81-88fd-3e07148a02f7', 'quantite': '4 cuillères'}, {'ingredient_id': '841f90fd-727f-4c94-9f72-7d5cb142e135', 'quantite': '50 g'}, {'ingredient_id': 'cb15f88a-f60d-44c1-8069-08a1137d461e', 'quantite': '2 cuillères'}, {'ingredient_id': '0b2820ea-673a-49b6-b208-f3479a1a2ead', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (64584, 'Brownie au chocolat et aux fruits', 'chocolat, beurre salé, sucre, sucre vanillé, oeuf, farine, gingembre, ananas, banane, raisin, rhum, pistaches', '20 min', ['Préchauffer le four 210°C (thermostat 7).', 'Découper la banane en rondelles, couper en 2 les raisins et les épépiner.', 'Dans un bol, mettre tous les fruits ensemble et verser le verre de rhum.', 'Faire fondre le chocolat et le beurre.', 'Battre les oeufs, le sucre et le sucre vanillé 15 min pour homogénéiser le tout.', 'Ajouter le mélange obtenu au chocolat fondu lentement.', 'Ajouter la farine et le gingembre et mélanger avec un fouet 10 min pour que la préparation soit homogène.', 'Ajouter la poudre de pistaches.', 'Verser la préparation finale dans un plat et y répartir les fruits.', 'Enfourner le tout 20 min.', 'Bon appétit!!!'], ['Ouvre-boîte', 'Spatule', 'Planche à découper', 'Fouet'], ['gingembre', 'raisin', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'brownie', 'chocolat', 'très facile', 'beurre salé', 'bon marché', 'oeuf', 'plat', 'pistaches', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'ananas', 'Brownie au chocolat et aux fruits', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:45:16.857435', [{'ingredient_id': '2e61f539-6526-4147-9504-c925c2000440', 'quantite': '250 g'}, {'ingredient_id': '55bf52a8-d3a4-4660-8d06-9108e64f1f13', 'quantite': '125 g'}, {'ingredient_id': '3b3b72b0-5dd2-41fa-9518-08ac7eeb508f', 'quantite': '125 g'}, {'ingredient_id': 'bf4f7d49-adec-4e0d-ab8c-3c4e7e22f3c5', 'quantite': '1'}, {'ingredient_id': 'ab564008-8348-442c-bcf0-df3d671c7c0e', 'quantite': '4'}, {'ingredient_id': '71ac525a-6ae1-42d7-b299-ff9c13f5df5a', 'quantite': '70 g'}, {'ingredient_id': '8471b4d9-3ab8-4a6c-af43-56104490d142', 'quantite': '1 cuillères'}, {'ingredient_id': '0bb2ea39-8afa-4af7-9002-994789a80903', 'quantite': '50 g'}, {'ingredient_id': 'f02f03cc-edf6-43ad-8b21-c0e76a8e827b', 'quantite': '1'}, {'ingredient_id': '6e425dc1-5351-436e-8b13-3e9a63bd4b0e', 'quantite': '20'}, {'ingredient_id': '4342de18-fe4b-4d28-bcdd-4a2038a59037', 'quantite': '1'}, {'ingredient_id': 'cbaf131b-c86e-4ebd-b1fc-304fda7f0e39', 'quantite': '3 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (36617, 'Pina-colada améliorée', 'rhum, rhum, jus de banane, jus d''ananas, lait de coco, banane, ananas, glace pilée', '5 min', ['Mettre tous les ingrédients dans un gros récipient + une rondelle d''ananas.', 'Mixer le tout au blender.', 'Déguster avec modération, décoré d’une tranche ananas et d’une rondelle de banane.'], ['Balance de cuisine', 'Moule à tarte', 'Couteau de chef', 'Mixeur', 'Fouet'], ['lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'Piña colada', 'facile', 'rapide', 'plat', 'jus de banane', 'recette', 'Pina-colada améliorée', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'jus d''ananas', 'moyen', 'ananas', 'cocktail', 'glace pilée'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:45:20.516631', [{'ingredient_id': '80f6bff7-fd90-4066-9096-11f828bbd23c', 'quantite': '7 cl'}, {'ingredient_id': 'bc0f1c5c-a2e9-4ff6-8cf6-df04f4475900', 'quantite': '3 cl'}, {'ingredient_id': 'aaf219b2-8b3e-4b2c-82ba-80f3ba96275b', 'quantite': '7 cl'}, {'ingredient_id': '559e18de-ae0f-4bd8-8334-1c71fae6aeb3', 'quantite': '16 cl'}, {'ingredient_id': '96a644a5-c9c6-4a89-8849-984675076393', 'quantite': '25 cl'}, {'ingredient_id': 'b80d74d7-6a46-481d-b46b-bb4ba8dc5400', 'quantite': ''}, {'ingredient_id': 'a23c04ed-0fdd-4a4c-9850-0289ec03bb6c', 'quantite': '1'}, {'ingredient_id': 'c6add84e-bd7d-480c-935d-e17367c3235c', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (227576, 'Banoffee Cake', 'lait concentré sucré, biscuit sablé, beurre, banane, crème fraîche liquide, sucre glace, cacao amer', '120 min', ['Pour préparer le "Toffee" (confiture de lait) :', 'Il est possible de le préparer jusqu''à une semaine avant. Dans une cocotte minute, immerger la boite de lait concentré sucrée dont vous aurez préalablement enlevé l''étiquette. Fermer, mettre sur le feu et à partir de la mise sous pression (1er sifflement) compter 45 minutes. Puis retirer du feu, laisser la pression s''échapper puis ouvrir mais ne pas vider l''eau ni retirer la boite, laisser refroidir tel quel, boite dans l''eau. Une fois bien refroidi, vous pouvez ouvrir la boite et transférer le toffee dans un pot de confiture par exemple.', 'Pour la préparation du Banoffee :', 'Placer la crème, un saladier et le un fouet au réfrigérateur en prévision du montage de la chantilly.', 'Mixer les biscuits jusqu''à l''obtention d''une fine chapelure.', 'Faire fondre le beurre (au micro-ondes) et le mélanger à la poudre de biscuits.', 'Dans le fond d''un cercle à pâtisserie ou d''un moule à charnière de 22cm environ, étaler et tasser la préparation obtenue.', 'Placer au réfrigérateur 30 minutes minimum.', 'Etaler le toffee sur la couche de biscuits durcie. Personnellement, je ne mets que les 2/3, un peu plus, de la boite mais cela dépend des gourmands !', 'Couper les bananes en rondelles généreuses. Les placer en couche uniforme, sans les superposer, sur la confiture de lait.', 'Monter la chantilly, à mi-parcours, ajouter le sucre glace.', 'Étaler uniformément la chantilly sur les bananes.', 'Placer le tout au minimum une heure au réfrigérateur.', 'Au moment de servir, saupoudrer de cacao amer.', 'Et régalez vous ! (Après un repas léger, bien sur...)'], ['Couteau de chef', 'Presse-agrumes'], ['', 'entrée', 'banane', 'recettes de cuisine', 'cacao amer', 'confiserie', 'testées', 'biscuit sablé', 'rapide', 'plat', 'moyenne', 'recette', 'crème fraîche liquide', 'Banoffee Cake', 'cuisine', 'recettes', 'lait concentré sucré', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'beurre', 'sucre glace', 'cocktail'], 'Dessert', 7b76d9be-76ed-4fa8-ba35-5285d5d9f4ed, '2025-09-26T15:45:25.289399', [{'ingredient_id': '2c51a327-7757-4a93-aa41-adb8aece140e', 'quantite': '1'}, {'ingredient_id': '1d496280-8bdc-4130-b315-04d2d41ee578', 'quantite': '150 g'}, {'ingredient_id': 'bab64260-8531-480d-af10-92162468932c', 'quantite': '75 g'}, {'ingredient_id': '7a6320f4-a601-4e0e-aed5-2104f1fe49a5', 'quantite': '3'}, {'ingredient_id': '3f69758f-bbd4-45d7-9a7d-f773b383d194', 'quantite': '25 cl'}, {'ingredient_id': '3804b519-b6c6-4ae0-9853-3f6f8f9793dd', 'quantite': '1 cuillères'}, {'ingredient_id': '9061934b-8d18-4aef-8214-03dffc94a293', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (58633, 'Lait pomme-banane', 'banane, pomme, lait écrémé', '5 min', ['Faites chauffer le lait dans une casserole ou directement dans le bol aux micro-ondes, couper la banane et la pomme en morceaux et ensuite les mettre dans le bol.'], ['Mixeur', 'Verre doseur', 'Rouleau à pâtisserie', 'Râpe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'lait écrémé', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Lait pomme-banane', 'dessert', 'plat de résistance', 'pomme', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:45:28.902686', [{'ingredient_id': '285745cb-ad51-47fd-847d-5730f690edb9', 'quantite': '1'}, {'ingredient_id': '890004d3-933a-474d-9c17-2ab4daeef208', 'quantite': '1'}, {'ingredient_id': '0464e339-b5d2-4c10-a14f-eeab77081fbc', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (25995, 'Banana-split', 'banane, glace vanille, glace au chocolat, glace fraise, crème chantilly, nappage chocolat', '10 min', ['Mettre une banane dans chaque plat (de préférence de la même forme). ', 'Placer ensuite 3 boules de glace puis napper de chocolat. ', 'Ajouter quelques noisettes de chantilly !!!'], ['Batteur électrique', 'Mixeur', 'Verre doseur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'glace fraise', 'coupe glacée', 'rapide', 'plat', 'recette', 'cuisine', 'Banana-split', 'recettes', 'boisson', 'crème chantilly', 'glace vanille', 'dessert', 'plat de résistance', 'moyen', 'nappage chocolat', 'glace au chocolat', 'cocktail'], 'Dessert', d19aa796-920e-41c3-b2b5-029b9bae5265, '2025-09-26T15:45:32.419100', [{'ingredient_id': 'a181f7a7-4add-44ce-8ea5-f66953b674a0', 'quantite': '4'}, {'ingredient_id': '34d50b53-743f-44bf-a7fa-c92a9204dc22', 'quantite': ''}, {'ingredient_id': 'b5a2f082-42fd-4496-a38e-e3b5c57ce416', 'quantite': ''}, {'ingredient_id': 'ea5caf9a-f52d-4b0c-843b-60dd36156a9f', 'quantite': ''}, {'ingredient_id': '30ddd5cf-3290-478e-94fa-435215b37aff', 'quantite': '20 cl'}, {'ingredient_id': 'b000a87a-6fd8-4b7e-a17d-86fc3a086b1c', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (51997, 'Porc au curry, pommes et bananes', 'échine de porc, oignon, tomate, pomme, banane, yaourt, concentré de tomates, gin, curry, curcuma, ail, cannelle, margarine, soja', '30 min', ['Dans un faitout :', 'Saisir la viande dans un peu de margarine puis réserver de côté.', 'Faire fondre les oignons dans la margarine, ajouter les tomates en dés, le concentré de tomates et les épices.', 'Ne pas faire bruler les épices !', 'Ajouter la viande, le gin et de l''eau à hauteur.', 'Couvrir et faire cuire à ébullition à feu doux pendant 1h30.', 'Laisser éventuellement refroidir une nuit pour reprendre la cuison le lendemain matin.', 'Ajouter les pommes épluchées et coupées grossièrement et laisser cuire à couvert à feu doux pendant 45 minutes.', 'Ajouter la banane coupée en morceaux, le yaourt et laisser cuire à découvert pour réduire la sauce.', 'En fin de cuisson, ajouter de la sauce de soja pour saler à votre goût.', 'En accompagnement : un riz thaï à la cardamone.'], ['Batteur électrique', 'Économe', 'Pince de cuisine', 'Couteau de chef', 'Casserole'], ['entrée', 'banane', 'recettes de cuisine', 'yaourt', 'échine de porc', 'soja', 'confiserie', 'testées', 'pommes et bananes', 'concentré de tomates', 'facile', 'tomate', 'ail', 'plat', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'curcuma', 'margarine', 'dessert', 'plat de résistance', 'pomme', 'moyen', 'Porc au curry', 'cannelle', 'curry', 'gin', 'viande à l''indienne', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:45:35.994835', [{'ingredient_id': '52f3537a-e047-4ee8-b02f-41836484419b', 'quantite': '2 kg'}, {'ingredient_id': '9fec3974-457d-4bff-8f5f-d5606fbf87b1', 'quantite': '5'}, {'ingredient_id': '266eb8a9-0072-482f-9c87-914f8e961bca', 'quantite': '2'}, {'ingredient_id': 'c878ef57-77cf-4fd6-a06f-e68611840096', 'quantite': '3'}, {'ingredient_id': '38c3b4a1-9618-487e-aea5-2376984b2235', 'quantite': '1'}, {'ingredient_id': '483af489-3800-4f6b-8a01-2beba6ff8119', 'quantite': '1'}, {'ingredient_id': 'f8e801e9-9ff3-44d7-abf3-d52b353282ff', 'quantite': '1 cuillères'}, {'ingredient_id': 'd115acf0-a119-437f-85ba-af04f5909ac6', 'quantite': '10 cl'}, {'ingredient_id': '532b4a23-e150-46fc-9db2-c5faa9638136', 'quantite': ''}, {'ingredient_id': 'cdac72fd-a422-4282-b44d-ec981ba90006', 'quantite': '2 cuillères'}, {'ingredient_id': 'bae88620-0fd5-4a78-a5e3-5cc4199ae151', 'quantite': '2'}, {'ingredient_id': '2d0ac6d8-3d6d-4299-97c8-2afa583030ac', 'quantite': ''}, {'ingredient_id': 'd20ac643-2aee-4a7d-b138-e5daa699a6b4', 'quantite': ''}, {'ingredient_id': '2914cffc-23ba-47fd-af07-1506f4feb8d9', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (29631, 'Ti nains-Morue', 'banane, morue, oignon, citron, ail, persil, piment, huile, vinaigre, poivre, sel, clou de girofle', '30 min', ['Faites tramper la morue depuis la veille avec le jus d''un des citrons.', 'Epluchez les bananes, lavez-les puis disposez-les dans une assez grande casserole d''eau et mettez-y au dessus la morue. Ajouter 1/2 cuillère à café de girofle et de bois d''Inde moulu, 1 gousse d''ail. Mettre à cuire à feu moyen.', 'Dans un récipient, râper l''oignon et l''ail, ajouter l''huile, le vinaigre, le piment doux, un peu de poivre et de sel, puis le persil et 1/2 jus de citron.', 'Lors de la fin de cuisson des bananes, ajouter un peu de bouillon dans ce récipient, puis mettre la morue dans cette sauce.', 'C''est prêt!! Bon appétit des Antilles!!'], ['Fouet', 'Mixeur', 'Passoire', 'Tire-bouchon'], ['', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'Ti nains-Morue', 'facile', 'ail', 'plat', 'recette', 'piment', 'cuisine', 'recettes', 'oignon', 'boisson', 'huile', 'clou de girofle', 'dessert', 'persil', 'plat de résistance', 'moyen', 'citron', 'morue', 'poivre', 'vinaigre', 'cocktail'], 'Plat principal', a3c5f301-c65c-457d-a62c-59bd5ab975a6, '2025-09-26T15:45:39.535028', [{'ingredient_id': '396f3057-8b72-4e24-80d7-76a788870a8f', 'quantite': '12'}, {'ingredient_id': '99400d2b-511f-4317-bd34-64e38192420c', 'quantite': '500 g'}, {'ingredient_id': '63d6d91a-a05b-4d55-9f78-e5a06f26a45f', 'quantite': '2'}, {'ingredient_id': 'b549a9f4-9987-44e4-bb66-eb73fc18e00d', 'quantite': '2'}, {'ingredient_id': '8c0f49db-4139-4ed4-b43e-162c7b431fee', 'quantite': '3'}, {'ingredient_id': 'fc5f8c98-c563-426a-aefd-7ef8d1ee862d', 'quantite': ''}, {'ingredient_id': 'cd43cedb-3fd6-458e-857a-43bc92e1645a', 'quantite': ''}, {'ingredient_id': '3edd00d6-b5c3-4829-86bf-8fe06d6137fa', 'quantite': '2 cuillères'}, {'ingredient_id': '240ec249-08fe-4908-88fe-574cc8f687f2', 'quantite': '1 cuillères'}, {'ingredient_id': '8c245b73-8353-4708-b788-8245de68ef54', 'quantite': ''}, {'ingredient_id': 'a36f331e-72d1-4054-82c7-529928ff889b', 'quantite': ''}, {'ingredient_id': '0a8064ee-2a97-4522-a1e0-42e684ca846d', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (18761, 'flan à la banane', 'banane, orange, lait, oeuf, sucre, rhum', '15 min', ['Coupez les bananes en 2 dans la longueur et encore en 2 . Les faire revenir dans une poêle anti-adhésive 1 mn de chaque côté. Flambez avec le rhum puis versez le jus de l''orange. ', 'Cuire 1 mn. Mêlez les oeufs, le lait, le sucre et le jus de cuisson des bananes. ', 'Versez sur les bananes dans un plat à gratin ou dans 4 ramequins. ', 'Cuire au bain-marie 20 mn Th 6 . ', 'SERVEZ TIEDE'], ['Tire-bouchon', 'Ouvre-boîte', 'Casserole', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'flan', 'orange', 'flan à la banane', 'lait', 'sucre', 'cocktail'], 'Dessert', c8812ff8-d528-4565-81d3-defd3240270c, '2025-09-26T15:45:43.107843', [{'ingredient_id': 'be43df5d-b409-4473-baee-fa40eb6c171d', 'quantite': '2'}, {'ingredient_id': 'd3037f95-0b19-4608-9e59-c18524f718d3', 'quantite': '1'}, {'ingredient_id': 'fd19b21f-5452-40d6-a6a2-52408cd3208e', 'quantite': '40 cl'}, {'ingredient_id': '52d5ef16-2997-4a82-907f-729f8830a780', 'quantite': '4'}, {'ingredient_id': 'd85de415-3ac3-45e6-870e-adba8ff42a97', 'quantite': '3 cuillères'}, {'ingredient_id': '7947380a-d7df-4bfd-88af-0e13fe36d3c2', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (81727, 'Aumônières de banane à la liqueur de mandarine', 'banane, crêpe, miel, Liqueur', '5 min', ['Astuce: pour faire cette recette le plus simplement possible, je ne fais pas les crêpes moi-même, mais j''utilise des crêpes toutes prêtes achetées en sachet sous-vide, en grande surface. ', 'Couper les bananes en fines tranches, et les étaler sur une assiette; mettre au four micro-ondes (1 minute à 850 W): on obtient une marmelade de bananes.', 'Etaler une crêpe sur une assiette ou un plat qui va au four; si la crêpe est trop fine et que vous craignez qu''elle ne se rompe, vous pouvez mettre deux crêpes l''une sur l''autre. Verser au centre la marmelade de bananes.', 'Verser environ une cuillère à soupe de miel sur la marmelade de banane, et replier les côtés de la crêpe pour refermer et former une aumônière (si nécessaire, fixer avec un cure-dents en bois).', 'Mettre au four 2 minutes environ, juste le temps que la crêpe se réchauffe et que ses bords deviennent croustillants.', 'Servir très chaud, en arrosant d''un filet de liqueur de mandarine (j''utilise une délicieuse liqueur produite par les moines de l''Abbaye de Lérins et que l''on peut commander en ligne sur leur site, mais à défaut je pense que du Grand Marnier doit aller).'], ['Spatule', 'Verre doseur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'Aumônières de banane à la liqueur de mandarine', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'crêpe', 'dessert', 'plat de résistance', 'Liqueur', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:45:47.622168', [{'ingredient_id': '1d3eb064-c454-4939-88a5-ee026b46af94', 'quantite': '1'}, {'ingredient_id': 'c39739ee-aa98-418f-af6f-16c721e8f486', 'quantite': '1'}, {'ingredient_id': '1d814406-9e33-420c-aefd-c51ae3fb3a65', 'quantite': '1 cuillères'}, {'ingredient_id': '95b67b1d-1c9a-47bd-b3d5-b3db709ba048', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (33488, 'ananas rôti à la vanille', 'ananas, sucre roux, gingembre, vanille, rhum, citron vert, banane', '30 min', ['Préchauffer le four à 180°C. ', 'Faire fondre 150 g de sucre avec une bonne cuillère de gingembre haché et une gousse de vanille fendue en deux (gratter les graines avec un couteau). ATTENTION il ne faut pas que ça brûle.... ', 'Pendant ce temps éplucher l''ananas en enlevant tous les yeux, récupérer le jus et piquer l''ananas comme un rôti avec des morceaux des 2 gousses de vanille. ', 'Quand c''est fondu (le sucre) ajouter un verre d''eau (attention aux projections) le jus d''ananas et deux cuillères à soupes de rhum. ', 'Mettre l''ananas dans un plat à gratin et arroser du caramel et mettre au four 45 mn à 180°C, il faut retourner et arroser l''ananas souvent et vérifier qu''il reste bien assez de liquide (au besoin ajouter 1/2 verre d''eau). ', 'Ensuite mettre le tout à refroidir. ', 'Qand l''ananas est froid, récupérer le caramel, ajouter encore une cuillère de rhum, le jus d''un demi-citron vert et 1/2 banane écrasée (facultatif mais super bon). ', 'Donner un petit coup de bouillon au caramel. ', 'Servir les tranches d''ananas froid avec la sauce chaude.'], ['Poêle', 'Tire-bouchon', 'Moule à tarte'], ['', 'gingembre', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'vanille', 'dessert', 'plat de résistance', 'ananas', 'citron vert', 'cocktail', 'sucre roux', 'ananas rôti à la vanille'], 'Dessert', 308d0c5a-9fbb-464d-bba0-5a9bf0868f7f, '2025-09-26T15:45:51.208158', [{'ingredient_id': 'd783cc42-5664-4df3-bc48-ca81be498505', 'quantite': '1'}, {'ingredient_id': 'd6ab6863-d054-45a0-9940-3b844be2aa9d', 'quantite': '150 g'}, {'ingredient_id': 'adc57624-0236-441e-a1c7-2b5168c78189', 'quantite': '1 cuillères'}, {'ingredient_id': '9ed42cf5-fe8a-4638-8375-8f7284f93965', 'quantite': '3'}, {'ingredient_id': '0eae4aee-c620-417a-9508-facc669a27ee', 'quantite': ''}, {'ingredient_id': '562f4cb9-1530-4573-85e0-8c96078ebacc', 'quantite': ''}, {'ingredient_id': '4ae3761c-30cd-44c6-9dd5-cf9a32837cce', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (56974, 'Fondue au nutella', 'Nutella, pomme, banane, fraises, chamallow, meringue, brioche, noix de coco rapée, noisettes', '10 min', ['C''est très simple, il suffit de couper en gros cubes les fruits et les morceaux de brioche, de déposer la noix de coco et les noisettes sur des petites assiettes.', 'On dispose tout sur la table, avec des petits bol, fourchettes, cuillères, et pics.', 'On fait fondre le nutella dans un appareil à fondu (special chocolat, ou non).', 'On peut tremper tous ce qui ne fait pas de miette, et pour le reste (la brioche) on a la délicatesse de se servir d''une petite cuillère, et de son bol !', 'Les plus gourmands, rouleront leur brochettes dans une assiette de noix de coco ou de noisettes concassées.', 'Un délice.'], ['Presse-agrumes', 'Ouvre-boîte', 'Fouet', 'Louche'], ['', 'chamallow', 'brioche', 'entrée', 'banane', 'Fondue au nutella', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'noisettes', 'cuisine', 'recettes', 'boisson', 'noix de coco rapée', 'Nutella', 'dessert', 'plat de résistance', 'pomme', 'meringue', 'cocktail'], 'Dessert', c58b9f08-791c-4004-8cf2-1465f4f301b3, '2025-09-26T15:45:55.729841', [{'ingredient_id': '9f559987-43cb-4e09-9919-0a6a061372b7', 'quantite': '1'}, {'ingredient_id': 'a526f5f0-16b7-4be2-a91c-bcf5b92f87c1', 'quantite': '2'}, {'ingredient_id': '5a954d90-490d-45ee-97fa-762de8e0d79c', 'quantite': '2'}, {'ingredient_id': '11f0cc7a-7699-4376-87fb-e44b0d0c709b', 'quantite': '1'}, {'ingredient_id': '2ece7cf6-7b28-43c3-b68e-1ac31702b240', 'quantite': ''}, {'ingredient_id': '0d6878b6-cb8a-4a13-919a-ac9da6ef2f0b', 'quantite': ''}, {'ingredient_id': 'd0e64a26-33fb-4a5b-beb1-cec834d228f7', 'quantite': ''}, {'ingredient_id': 'ba62980f-1a59-4688-8c60-d76edc85ba2d', 'quantite': ''}, {'ingredient_id': '0ee59cac-cd4c-4207-b0aa-ac9c852b58da', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (392295, 'Fleur d''amour', 'jus d''ananas, jus de mangues, jus de bananes', '0 min', ['Réalisez la recette "Fleur d''amour" au shaker.', 'Verser les produits dans le shaker rempli de Glaçons et bien frapper. Servir dans un verre tulipe ou cocktail. Saupoudrer de poudre de coco râpée.
.', 'Servir dans un verre de type "verre tulipe".', 'Aucune décoration.'], ['Ouvre-boîte', 'Passoire', 'Planche à découper', 'Moule à tarte'], ['', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'jus d''ananas', 'moyen', 'Fleur d''amour', 'jus de mangues', 'jus de bananes', 'cocktail'], 'Boisson', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T15:46:00.102328', [{'ingredient_id': '10f4d4bc-b1d4-4649-be10-dd9e5d15ed91', 'quantite': '4 cl'}, {'ingredient_id': '4d17ec03-88a2-42b6-b55f-952d82638961', 'quantite': '7 cl'}, {'ingredient_id': 'bfb77b22-72ca-42a6-925a-cd416802248b', 'quantite': '7 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (46665, 'Boeuf grillé aux feuilles de bananier', 'feuille de bananier, boeuf, lard, sel, poivre, échalote, citronnelle', '20 min', ['Couper la viande en petites tranches, les mélanger avec le reste des ingrédients.', 'Passer au robot jusqu''à ce que cela donne un mélange souple et fin.', 'Huiler les feuilles de bananier. Mettre une cuillère à soupe du mélange sur une feuille, plier les 4 côtés pour que cela donne la forme d''un rectangle d''environ 4 à 5 cm. ', 'Bien étaler  et envelopper encore dans une autre feuille. Pareil pour le reste. ', 'Mettre le tout sur un barbecue ou sur une plaque allant au four et faire griller.', 'Ce plat s''accompagne de salade et de sauce aigre-douce.'], ['Casserole', 'Louche', 'Verre doseur'], ['', 'entrée', 'recettes de cuisine', 'boeuf', 'sel', 'confiserie', 'testées', 'bon marché', 'plat', 'moyenne', 'feuille de bananier', 'recette', 'Boeuf grillé aux feuilles de bananier', 'cuisine', 'recettes', 'boisson', 'lard', 'citronnelle', 'dessert', 'plat de résistance', 'poivre', 'cocktail', 'échalote'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:46:04.268410', [{'ingredient_id': '64b418fa-e0c9-4d8f-9fe3-80ed44d0687e', 'quantite': ''}, {'ingredient_id': 'aa9054db-eb3d-47f5-bf94-c4d594c61eb3', 'quantite': '500 g'}, {'ingredient_id': 'ffa07636-13d5-497e-a3a2-7e8d88cdf498', 'quantite': '50 g'}, {'ingredient_id': '3454f541-f93d-4cef-bd17-7d403e2ca5b3', 'quantite': '1 cuillères'}, {'ingredient_id': '654738c4-7c39-40f2-940f-adddcdc95d83', 'quantite': ''}, {'ingredient_id': '6b074583-152c-432b-8f20-0fa17d50a008', 'quantite': '1 cuillères'}, {'ingredient_id': 'bb21c972-3f07-40ba-9b04-c5cd0212ddb8', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (43721, 'Poulet pruneaux / bananes', 'poulet, banane, pruneau, ail, garam masala, piment, citron, cardamome, crème liquide, sel aux herbes', '15 min', ['Dans une cocotte en fonte, mettre les bananes coupées en rondelles, les pruneaux, et les gousses d''ail dégermées et coupées en 2.', 'Disposer le poulet par dessus. Napper d''huile d''olive (1 ou 2 cuillères à soupe). Saupoudrer de cardamome, de garam masala, et de lemon and chili.', 'Pour finir, verser la crème (si elle emporte trop d''épices, en remettre un peu, le poulet doit en avoir un peu sur le dessus).', 'Mettre à four chaud pendant environ 1 h à 1 h 30, en fontion de la taille du poulet. C''est cuit, quand ça sent le caramel. Le poulet est doré, et entouré d''une sauce onctueuse et parfumée.', 'Servir avec de la semoule.'], ['Batteur électrique', 'Planche à découper', 'Rouleau à pâtisserie', 'Spatule', 'Verre doseur'], ['', 'poulet', 'banane', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'sel aux herbes', 'pruneau', 'très facile', 'bon marché', 'ail', 'cardamome', 'plat', 'recette', 'piment', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'dessert', 'plat de résistance', 'citron', 'garam masala', 'Poulet pruneaux / bananes', 'cocktail'], 'Plat principal', b70c42b4-ac2d-43f9-97be-9f09de598f36, '2025-09-26T15:46:07.969323', [{'ingredient_id': '7d29853f-ee9a-4ad8-921d-3a1366952d1f', 'quantite': '1'}, {'ingredient_id': '30d63146-e565-481d-9a56-5fb063bc4f7e', 'quantite': '4'}, {'ingredient_id': '60e7e647-a7d5-4ad2-80f6-62bc030d5375', 'quantite': '15'}, {'ingredient_id': 'c80fcaf7-4b9f-4909-991c-e99e949ccca8', 'quantite': '4'}, {'ingredient_id': '04313516-71b1-4b6e-b018-2f429b96f93f', 'quantite': ''}, {'ingredient_id': '61b1777f-cb3b-4d21-84f6-e4c88c2d822a', 'quantite': ''}, {'ingredient_id': '5e1173d3-5228-412f-8b4f-e5f8630e3912', 'quantite': ''}, {'ingredient_id': 'e9ec08f3-14ea-49be-ad74-4ac8120ab176', 'quantite': ''}, {'ingredient_id': 'b8ca04d6-a5f6-449b-b023-dbf8a23eaa54', 'quantite': '25 cl'}, {'ingredient_id': '0e9647b4-675a-4729-a504-a9663b18c3d7', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (22191, 'Pizza dessert au Nutella', 'pâte à pizza, Nutella, banane, amandes', '10 min', ['Tartinez généreusement une pâte à pizza « toute faite » de Nutella, en laissant une marge de 2 ou 2,5 cm des bords.', 'Garnissez-la à votre guise de lamelles de bananes, amande effilées…', 'Repliez la pâte sur une moitié, et soudez les bords en faisant des motifs.', 'Placez au four pour obtenir une pâte bien dorée, à 180°C (th 6) pendant 15 min environ. ', 'Et dégustez tiède !'], ['Batteur électrique', 'Planche à découper', 'Balance de cuisine'], ['', 'amandes', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'Pizza dessert au Nutella', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'pâte à pizza', 'boisson', 'Nutella', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', c440a3b8-1a84-4899-aef8-1100b8b9ac2a, '2025-09-26T15:46:12.828163', [{'ingredient_id': '4ba3e05e-3dbf-4d01-9aee-4f13ff665c74', 'quantite': '1'}, {'ingredient_id': '0c27ab3a-18d7-4c32-90a1-65fce2d13d2b', 'quantite': ''}, {'ingredient_id': '449f4de2-7727-443e-ac9b-aa5182a75a0f', 'quantite': ''}, {'ingredient_id': '7a609656-e03b-46f6-aef3-f41bd7f41e3a', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (335790, 'Verrine de purée de banane et son tartare de pommes', 'banane, pomme, sucre vanillé, sucre glace, crème, lait, jus de citron, cannelle', '15 min', ['Éplucher la pomme, puis la couper en petits morceaux.', 'Préparer la crème : ajouter la crème, la moitié du verre de lait, le sucre glace et le sucre vanillé.', 'Mélanger les pommes et la crème.', 'Faire la purée de bananes : couper la banane en tranches. Ajouter le reste de lait et mettre au micro-ondes 40 secondes.', 'Ensuite, ajouter de la cannelle (selon vos goûts) et le citron. ', 'Maintenant, alterner dans la verrine : pomme, banane, pomme, banane, pomme (cela dépend de la taille de vos verrines) et puis si vous le souhaitez, ajouter de la cannelle au dessus.'], ['Couteau de chef', 'Presse-agrumes', 'Ouvre-boîte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'Verrine de purée de banane et son tartare de pommes', 'rapide', 'plat', 'crème', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'jus de citron', 'pomme', 'sucre glace', 'cannelle', 'lait', 'cocktail'], 'Dessert', 936ee2fe-f4c8-4568-a099-3911e3e296a3, '2025-09-26T15:46:16.403853', [{'ingredient_id': '7aab6f3e-948b-4913-a6a1-3c7326e6f37d', 'quantite': '1'}, {'ingredient_id': '8105e29a-2b6c-4f0a-9c26-f49c066fa57a', 'quantite': '1'}, {'ingredient_id': '3164ca54-e446-428d-844d-9c6305be5cf2', 'quantite': '1 cuillères'}, {'ingredient_id': '894df3a8-53d8-47f8-863d-0d1a6f723bd6', 'quantite': '2 cuillères'}, {'ingredient_id': '0225dfc0-37f4-442e-a11e-91a025879b8a', 'quantite': ''}, {'ingredient_id': '38e96b98-209a-4bd4-b701-9b386f95a199', 'quantite': '1'}, {'ingredient_id': '2c15cb4b-4ef9-462e-a42e-64dceac2894f', 'quantite': '5'}, {'ingredient_id': 'bd66e2f2-9add-4a5f-b5d2-decde8716cd0', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (42494, 'crème budwig', 'fromage blanc, huile de tournesol, céréale, banane, noix, jus de citron, fruits', '5 min', ['Dans un bol, mixez le fromage blanc et l''huile, puis ajoutez tous les autres ingrédients. ', 'Voilà c''est prêt !!!'], ['Casserole', 'Batteur électrique'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'crème budwig', 'très facile', 'rapide', 'plat', 'céréale', 'recette', 'cuisine', 'noix', 'recettes', 'boisson', 'fromage blanc', 'huile de tournesol', 'dessert', 'plat de résistance', 'jus de citron', 'moyen', 'fruits', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:46:19.988253', [{'ingredient_id': 'd16e878a-1a95-4a26-afd3-3ced78b71a80', 'quantite': ''}, {'ingredient_id': '7422de09-b80b-4269-ab3d-c60724cceedf', 'quantite': '2 cuillères'}, {'ingredient_id': '716c3617-54b2-4d15-9eb5-1d17f9957c61', 'quantite': '2 cuillères'}, {'ingredient_id': 'effb81b2-909b-4c83-86af-ef8f3347e2d9', 'quantite': ''}, {'ingredient_id': 'cbc3c3a4-010c-4702-a0c1-a1f9cd6fd4f3', 'quantite': '2 cuillères'}, {'ingredient_id': '60d9de84-6fbc-4cbe-9b25-f1bc10cf04a4', 'quantite': ''}, {'ingredient_id': 'e4e20fc3-d57e-447b-9065-7981b1ecb954', 'quantite': '150 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (166350, 'Verrine aux 5 fruits', 'banane, pomme, poire, orange, kiwi, yaourt nature, sucre', '50 min', ['Epluchez vos fruits. Pour chaque fruit, partager la portion en deux. ', 'Une moitié sera coupée en tranche et réservée -avec du jus de citron pour ceux qui s''oxydent (ici la pomme et la poire)- et l''autre réduite en bouillie à l''aide d''un mixeur.', 'Vous vous trouvez donc avec 5 parts de fruits en tranches et 5 bouillies de fruits.', 'Partagez vos yaourt en 5 et mélangez la bouillie d''un fruit avec une part de yaourt. Placez vos tranches de fruits dans des assiettes, saupoudrez avec un peu de sucre et placez au congélateur (30min). Sucrez à votre guise les "crèmes de fruit" et placez les elles aussi au congélateur pour une demie-heure. ', 'Lorsque tous a bien refroidi, montez vos verrines. Placez une couche de crème, agrémentez de morceaux de fruits et ainsi de suite jusqu''à obtention votre dessert.', 'PS : Cette recette peut se faire avec n''importe quels fruits. Si vous utilisez un kiwi faites attention, mixer les graines donne un goût amer infâme. Si vous trouvez un moyen de faire notre bouillie de kiwi ou une quelconque amélioration à apporter à cette recette n''hésitez pas.'], ['Batteur électrique', 'Fouet', 'Économe', 'Verre doseur', 'Pince de cuisine'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'yaourt nature', 'poire', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'Verrine aux 5 fruits', 'orange', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:46:23.540852', [{'ingredient_id': '2fea0cd4-b7d2-4846-9f36-73d3d2c67046', 'quantite': '1'}, {'ingredient_id': 'bfc7959f-59fd-49d7-99da-706e24a34160', 'quantite': '1'}, {'ingredient_id': '8578d811-eb06-4339-bcab-25574a7d3430', 'quantite': '1'}, {'ingredient_id': 'ded3734f-0061-4a02-afab-f5bc74ac9d07', 'quantite': '1'}, {'ingredient_id': '70332302-516c-4186-b23f-ea7fda7f243a', 'quantite': ''}, {'ingredient_id': '87ff08e4-3059-4fc8-b8ad-a79bbf4e8f13', 'quantite': ''}, {'ingredient_id': '300cafb0-b17a-41d4-8e32-dfccf69502ef', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (23014, 'Jus de fruits', 'nectarine, pêche, banane, fraises, framboises, sucre', '5 min', ['Peler et couper en morceaux les fruits (si besoin est). Mixer le tout. Passer le mélange à la passoire pour enlever les pépins. ', 'Mettre au frais. ', 'Boire.'], ['Spatule', 'Économe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'nectarine', 'framboises', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pêche', 'sucre', 'Jus de fruits', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:46:27.123757', [{'ingredient_id': '57ad8792-7682-4147-895c-715d53144fcd', 'quantite': '2'}, {'ingredient_id': '386465ad-b496-4866-8d48-6f093fbaa5f8', 'quantite': '2'}, {'ingredient_id': '506c549d-1f2d-4fd6-bc8c-a2d306301b6d', 'quantite': '1'}, {'ingredient_id': '36df17c9-8035-443e-86c4-535f748c5f05', 'quantite': '10'}, {'ingredient_id': 'c1d2845c-8bb9-4090-9b52-80787725f282', 'quantite': '50 g'}, {'ingredient_id': 'b1db18b8-b4da-4ebe-b870-57560585f915', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (61770, 'Cocktail aux fruits sans alcool', 'limonade, jus d''orange, jus d''ananas, sucre de canne, pomme, poire, banane, ananas', '10 min', ['Versez l''ensemble des ingrédients et les fruits préalablement coupés en dés dans un bouteille de 2 l.', 'Laissez macérer au réfrigirateur l''ensemble une nuit.', 'Server frais!'], ['Planche à découper', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'Cocktail aux fruits sans alcool', 'boisson', 'sucre de canne', 'dessert', 'plat de résistance', 'jus d''ananas', 'pomme', 'cocktail sans alcool', 'ananas', 'limonade', 'jus d''orange', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:46:30.839326', [{'ingredient_id': 'b2c5cdca-1081-4dba-9451-fdeb3f2220b6', 'quantite': '30 cl'}, {'ingredient_id': 'c66c9871-4c24-4969-85f1-2162bd95e9b2', 'quantite': '25 cl'}, {'ingredient_id': '1d00ca24-ce6e-488b-9ab6-ca16344f2374', 'quantite': '25 cl'}, {'ingredient_id': '4a3e20b5-f77d-4d46-9f91-7599b2ff5a4b', 'quantite': '20 cl'}, {'ingredient_id': '97343127-a0c9-438d-8076-1b9df0aa1bc8', 'quantite': ''}, {'ingredient_id': 'c7c1bb4f-a6a7-48d5-a4e6-170db3225320', 'quantite': ''}, {'ingredient_id': '28179fa1-bdc7-49c1-b959-135d372094ed', 'quantite': ''}, {'ingredient_id': '670d0f60-e2c1-4217-b374-e449854af5a3', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (349578, 'Moelleux à la banane et au gingembre sans gluten ni lactose', 'farine de riz, farine de sorgho, farine de sarrasin, banane, gingembre, jus de citron, quatre-épices, café, lait d''amande, sucre roux, oeuf', '35 min', ['Dans une assiette creuse, écrasez les bananes à l''aide d''une fourchette.', 'Pelez le gingembre et coupez le finement puis l''ajoutez aux bananes.', 'Ajoutez y le jus d''un citron et la cuillère à café de mélange 4 épices. Mélangez et réservez.', 'Dans un saladier, mettez les 3 farines et faites un puit.', 'Séparez les blancs des jaunes.', 'Dans le puit, ajoutez le sucre, les jaunes d''oeufs et l''oeuf entier.', 'Mettre le four à préchauffer à 180°C (thermostat 6).', 'Ajoutez le lait d''amande.', 'Une fois le mélange bien lisse, incorporez la mixture banane, gingembre, épices.', 'Battez les blancs en neige.', 'Incorporez le délicatement, en soulevant l''appareil.', 'Mettre l''appareil dans un moule préalablement préparé avec du papier cuisson.', 'Cuire environ 40min.'], ['Mixeur', 'Couteau de chef', 'Économe'], ['gingembre', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'farine de riz', 'Moelleux à la banane et au gingembre sans gluten ni lactose', 'testées', 'lait d''amande', 'facile', 'oeuf', 'plat', 'farine de sorgho', 'recette', 'café', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'jus de citron', 'gâteau à la banane', 'farine de sarrasin', 'moyen', 'quatre-épices', 'cocktail', 'sucre roux'], 'Dessert', 05d1109a-fe1a-4880-97c9-9d55f15dfb56, '2025-09-26T15:46:34.439974', [{'ingredient_id': '1990c659-ebdb-41d0-8767-15c10751d1e7', 'quantite': '100 g'}, {'ingredient_id': '017b7fd6-6eaa-4068-8d19-d7924c67c928', 'quantite': '100 g'}, {'ingredient_id': 'cc6187e8-8b63-4440-b4bb-ec96cecaadf3', 'quantite': '50 g'}, {'ingredient_id': '0b3036f8-fe33-4b85-b32f-1d45744ecbcf', 'quantite': '3'}, {'ingredient_id': '0d2089ee-5539-427d-b2a8-6ec626cdadb7', 'quantite': '15 g'}, {'ingredient_id': '0c2416fc-bbe5-4e9f-8319-15985fb32cc5', 'quantite': '1'}, {'ingredient_id': '646189a4-276f-47c2-840b-5903ec26350e', 'quantite': '1 cuillères'}, {'ingredient_id': '1adacdf5-d767-41d3-a49c-be6fb27b415a', 'quantite': '1 cuillères'}, {'ingredient_id': '99be65a5-ee12-4351-8373-28d4bd0a9a7b', 'quantite': '250 ml'}, {'ingredient_id': '80e48a8a-fd16-486a-b7a2-0ce043895671', 'quantite': '80 g'}, {'ingredient_id': 'b67edda5-8666-4912-a6e3-59156e5fa924', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (391496, 'Cake à la banane et au caramel', 'farine, oeuf, banane, levure, beurre, sucre, eau, beurre, sel', '20 min', ['Recette du Caramel :', 'Prenez une casserole, et mettez-y le sucre, un peu d''eau, le beurre et la pincée de sel. ', 'Chauffez à feu doux en remuant.', 'Restez près du feu. Quand ça bulle et que cela ressemble à du caramel sortez du feu.', 'Pour la pâte à cake :
Mettez la farine, les œufs, le sucre qui reste, les bananes, la levure dans un bol puis mélangez énergiquement.', 'C’est bon, c’est homogène ? Parfait ! Insérez le caramel.', 'Mettez la pâte dans le moule beurre.', 'Puis mettez au four pendant 40 min minimum.', 'C’est cuit (milieu non onctueux) ? Alors laissez refroidir le cake pendant 10 min et déguste tiède !', 'Je vus souhaite une bonne dégustation.'], ['Poêle', 'Balance de cuisine', 'Casserole', 'Fouet', 'Moule à tarte'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'eau', 'testées', 'facile', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'Cake à la banane et au caramel', 'plat de résistance', 'gâteau à la banane', 'moyen', 'beurre', 'sucre', 'cocktail'], 'Dessert', 6bcb4666-6c54-4a80-8933-8068bb6c9410, '2025-09-26T15:46:37.984768', [{'ingredient_id': 'ae534552-8baa-4b96-8685-2b711e49efff', 'quantite': '170 g'}, {'ingredient_id': 'fd4bc3e9-eab9-43f5-8f92-9927d2b8ee91', 'quantite': '3'}, {'ingredient_id': '218c3a44-20f0-4722-8f64-a26daf9c0bf4', 'quantite': '2'}, {'ingredient_id': '362be78a-289e-42c6-817f-d3d596b9afc3', 'quantite': '1'}, {'ingredient_id': '27fdc0d7-0758-41b7-b982-9cf27a6ddf37', 'quantite': '45 g'}, {'ingredient_id': '06c267c7-87c0-4a72-aaee-2a5b1b499d68', 'quantite': '100 g'}, {'ingredient_id': '4ad00281-e9c7-479e-add7-3d63eb36c06b', 'quantite': ''}, {'ingredient_id': '42726884-feca-47b5-8e42-0aaae36e0151', 'quantite': '15 g'}, {'ingredient_id': 'ea95de92-553c-4e5d-8546-dc2d5b5338ba', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (25197, 'Cake à la banane et au sucre brun', 'beurre, sucre brun, oeuf, farine, levure chimique, banane, raisins secs, sel', '20 min', ['1) Battre le beurre et le sucre brun en crème et ajouter l''oeuf en remuant bien. ', '2) Mélanger la farine avec la levure et une pincée de sel. ', '3 Au mélange 1 , ajouter alternativement une cuillerée de farine et une cuillerée de bananes écrasées. ', '4) Ajouter les raisins secs. ', '5) Verser le tout dans un moule à cake. ', '6) Faire cuire à four moyen jusqu''à ce que le couteau ressorte sec.'], ['Presse-agrumes', 'Verre doseur', 'Batteur électrique', 'Râpe'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'levure chimique', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'sucre brun', 'autres cakes', 'Cake à la banane et au sucre brun', 'dessert', 'plat de résistance', 'beurre', 'raisins secs', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:46:41.478952', [{'ingredient_id': 'b5b47bc7-411e-40c5-85a1-6a8f29b9a5af', 'quantite': '100 g'}, {'ingredient_id': 'b77044dc-0eb6-445e-b1bf-d4fac6e07a7d', 'quantite': '100 g'}, {'ingredient_id': '877c7d6c-c7bd-413a-ba67-221024ee3d5a', 'quantite': '1'}, {'ingredient_id': '7c8891ca-bf49-4862-a891-5e5afdcd76fe', 'quantite': '250 g'}, {'ingredient_id': '17de71db-0c43-4c4e-9438-fb9e9374b1b3', 'quantite': '1 cuillères'}, {'ingredient_id': 'a8dc5ff0-2b7d-4f70-9790-c0df3fb9fbd1', 'quantite': '2'}, {'ingredient_id': '0922b10f-726e-4523-a4ce-c9285e2b2890', 'quantite': '100 g'}, {'ingredient_id': '25792c33-dd8e-4ef2-b4b2-8b3c1467b984', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (334437, 'Mugcake banane-Nutella', 'banane, mûres, sucre glace, Nutella, oeuf, farine, levure, lait', '5 min', ['Ajouter tous les ingrédients dans l''ordre, en remuant bien au fur et à mesure, dans un gros mug (35 cl minimum), car la préparation va bien gonfler.', 'Mettre 1 min 20 au micro-ondes (800W), laisser refroidir 1 min et déguster. '], ['Batteur électrique', 'Balance de cuisine', 'Couteau de chef', 'Louche', 'Casserole'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'mugcake', 'Mugcake banane-Nutella', 'recette', 'mûres', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'Nutella', 'dessert', 'plat de résistance', 'sucre glace', 'lait', 'cocktail'], 'Dessert', e70a4f76-f3df-449c-9ac0-2797e15dce27, '2025-09-26T15:46:45.052263', [{'ingredient_id': 'bc9adaca-72f8-486a-8a92-cf40155103a0', 'quantite': ''}, {'ingredient_id': '0927d6ee-6749-4cff-82ed-66d01e82d064', 'quantite': ''}, {'ingredient_id': 'af920b2a-fadd-43be-9d00-e1d7c4827b09', 'quantite': '1 cuillères'}, {'ingredient_id': '68763083-d0ed-4394-828e-85ba4cf77fb5', 'quantite': '2 cuillères'}, {'ingredient_id': '29c2b44b-a523-4a3e-a496-e30d1eff2586', 'quantite': '1'}, {'ingredient_id': 'c6a90f83-12b3-44e9-b954-cb14c6bc4cf1', 'quantite': '3 cuillères'}, {'ingredient_id': 'dec82fd2-cfce-47bf-b59d-9361ba19e113', 'quantite': '1 cuillères'}, {'ingredient_id': '23ee1dd2-896d-4ad6-9017-e7bce2d92e40', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (528217, 'Gâteaux au yaourt et à la banane', 'yaourt, farine, levure chimique, sucre, huile, oeuf, sucre vanillé, banane', '10 min', ['Préchauffer le four à 180℃ (thermostat 6).', 'Dans un saladier, mettre le yaourt, la farine, la levure, le sucre, l''huile, les oeufs puis le sucre vanillé.', 'Mélanger le tout avec un fouet jusqu''à l''obtention d''une pâte fluide.', 'Couper en petits dés une banane et 1/3 de la deuxième et les rajouter à la pâte', 'Beurrer le moule (ou huiler) puis y verser la pâte.', 'Couper en rondelles les 2/3 de la deuxième banane et les disposer en décoration. Mettre au four pendant environ 30 minutes.'], ['Poêle', 'Râpe', 'Rouleau à pâtisserie', 'Ouvre-boîte'], ['entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'levure chimique', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'gâteau au yaourt', 'cuisine', 'recettes', 'boisson', 'huile', 'farine', 'dessert', 'plat de résistance', 'Gâteaux au yaourt et à la banane', 'sucre vanillé', 'sucre', 'cocktail'], 'Dessert', 56797f84-a792-468c-917f-856ee8f3e0a4, '2025-09-26T15:46:48.556597', [{'ingredient_id': '6dbf2bf1-beb3-414a-b34f-a7230a5a88fb', 'quantite': '1'}, {'ingredient_id': '1c6b58fc-a291-4a41-812c-87f07103236a', 'quantite': '3'}, {'ingredient_id': 'bc14e391-885a-4c27-bda5-4239bf857299', 'quantite': ''}, {'ingredient_id': '487bf45f-60ea-46e1-82cb-09661037b3dd', 'quantite': '2'}, {'ingredient_id': '4f478efe-1c3a-44e0-b743-910713296fe7', 'quantite': ''}, {'ingredient_id': '6a86bbe4-4c44-4d65-a64f-35908ab8906b', 'quantite': '2'}, {'ingredient_id': 'c772553e-c496-413b-a6b7-6c9ce7cc0f6f', 'quantite': ''}, {'ingredient_id': '9183a8f7-5b2e-4a23-9790-4faa724c4c87', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (311821, 'Cake banane citron vanille sans gluten', 'banane, citron, vanille, oeuf, sucre, sel, poivre, amandes, bicarbonate, maïzena', '15 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Fendre la gousse de vanille et extraire les grains. Garder la coque. ', 'Éplucher puis écraser les bananes dans un saladier', 'Ajouter le sucre, le citron pressé, la vanille, le sel et le poivre, bien mélanger.', 'Ajouter un à un les œufs en battant hardiment le mélange.', 'Incorporer la poudre d''amandes, puis le bicarbonate et la fécule de pomme de terre en mélangeant de sorte à ce qu''il n''y ait plus de grumeaux.', 'Verser dans un moule légèrement beurré et déposer la coque de vanille au dessus de la pâte. Mettre au four pendant 25 minutes environ.', 'Bon appétit !'], ['Presse-agrumes', 'Balance de cuisine', 'Verre doseur', 'Tire-bouchon', 'Pince de cuisine'], ['amandes', 'entrée', 'banane', 'recettes de cuisine', 'cake au citron', 'sel', 'confiserie', 'testées', 'facile', 'maïzena', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'vanille', 'Cake banane citron vanille sans gluten', 'dessert', 'plat de résistance', 'citron', 'poivre', 'sucre', 'cocktail', 'bicarbonate'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:46:52.229955', [{'ingredient_id': '7af37f40-b231-4dc5-9dbd-68c5e0a1a9b0', 'quantite': '3'}, {'ingredient_id': 'e1ad754c-58bc-45ca-9f2c-5c91f7f7fe34', 'quantite': ''}, {'ingredient_id': 'f14e6d21-aa8f-4e92-bba7-217410e1b9ba', 'quantite': '1'}, {'ingredient_id': 'f5631f05-baf1-4e5c-92b1-8abee8e85594', 'quantite': '3'}, {'ingredient_id': 'f4f7f40f-35f4-431a-89f5-550948e7e873', 'quantite': '100 g'}, {'ingredient_id': '2729bf44-789c-4f4f-b690-fd2f2fc5c585', 'quantite': '1'}, {'ingredient_id': '78f26834-7c1e-4843-b5e1-1e5863cb02a0', 'quantite': ''}, {'ingredient_id': '90101e8d-5cd2-4e2a-8279-617cb66e2b21', 'quantite': '125 g'}, {'ingredient_id': 'cbf6078d-0496-4040-a389-2a713c178ccb', 'quantite': ''}, {'ingredient_id': 'f9943208-77e1-4740-9ca3-ed299272cc0e', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (19227, 'Perles de coco asiatiques', 'tapioca, lait de coco, banane, eau, sucre en poudre', '30 min', ['Verser le lait de coco et le verre d''eau dans une casserole et faire chauffer. Ecraser les bananes et mettre de côté. ', 'Quand le mélange est chaud, versez environ la moitié du sachet de tapioca ainsi que les bananes écrasées. Mélanger sans cesser de remuer jusqu''à ce que le tapioca soit devenu transparent. ', 'Truc : Si le tapioca à collé au fond de la casserole, mettre à tremper toute la nuit dans de l''eau bien chaude.', 'Confectionner des boules de la taille voulue. On peut les rouler dans de la noix de coco râpée ou du sucre glace.'], ['Balance de cuisine', 'Tire-bouchon', 'Pince de cuisine'], ['', 'lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'Perles de coco asiatiques', 'très facile', 'bon marché', 'plat', 'sucre en poudre', 'recette', 'tapioca', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', b2111825-bb63-4c2c-ba6e-1a07e4f54abf, '2025-09-26T15:46:55.809607', [{'ingredient_id': '174c7524-f08f-42d0-a33e-64d6aa978d4b', 'quantite': '1'}, {'ingredient_id': 'ff240daa-1a96-4672-b32f-751292ff7efb', 'quantite': '1'}, {'ingredient_id': 'adfaf9df-48bc-427c-bd1a-ffa854468c80', 'quantite': '2'}, {'ingredient_id': 'd591ad12-d279-4c2d-8dce-fe86d8f4c06e', 'quantite': '1'}, {'ingredient_id': 'a05978db-d77d-4ceb-b517-f97a88d27c49', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (16903, 'Flan aux bananes', 'banane, lait écrémé, oeuf, vanille, beurre, sucre', '20 min', ['Éplucher les bananes et les couper en fines rondelles.', 'Préparer le flan avec le lait (dans lequel on aura fait infuser la vanille) et les oeufs et le sucre.', 'Déposer les bananes bien rangées dans un plat à gratin beurré.', 'Verser délicatement le flan refroidi ou tiédi sur les bananes et faire cuire à chaleur modérée (175°C), pendant 20 mn environ. Le flan doit coaguler, colorer légèrement, mais non gonfler. Peut se servir chaud.'], ['Batteur électrique', 'Ouvre-boîte', 'Verre doseur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'lait écrémé', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'vanille', 'dessert', 'plat de résistance', 'beurre', 'flan', 'Flan aux bananes', 'sucre', 'cocktail'], 'Dessert', d59c1f77-faad-462d-ac36-86f9a9f58905, '2025-09-26T15:46:59.428954', [{'ingredient_id': 'bdce55f9-aae9-4999-8de5-10103f3b75e8', 'quantite': '3'}, {'ingredient_id': '7430595b-8c4d-4817-89d7-8cd5229157ab', 'quantite': '50 cl'}, {'ingredient_id': '048867ed-c91b-4741-b526-17385e9d0039', 'quantite': '4'}, {'ingredient_id': '6e6712e6-3679-41e4-a5a8-d47fc7e54ef0', 'quantite': '1'}, {'ingredient_id': '9401ddf4-2751-4353-bb6d-c0704493f680', 'quantite': '20 g'}, {'ingredient_id': '71dbd5c9-2478-4dec-953a-9aee4ef0d6cb', 'quantite': '80 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (164591, 'Riz Casimir', 'veau, crème fraîche, curry, banane, pêche, poire, cerises, amandes effilées, riz', '15 min', ['Cuire le riz sec.', 'Pendant ce temps, rôtir la viande dans une grande poêle.', 'Quand la viande est bien rôtie, hors du feu,  saupoudrer de curry jaune (à vous de doser en fonction de vos goûts - fort ou plutôt doux) et bien mélanger.', 'Ajouter la crème et mélanger à nouveau.', 'Ajouter la banane coupée en rondelles, les pêches coupées en lamelles, les poires coupées en lamelles et les cerises.', 'Remettez le tout sur le feu et faite chauffer à petit feu pendant quelques minutes. (Ne pas cuire mais simplement chauffer...sinon les fruits se défont, particulièrement la banane!)', 'Servez au milieu d''une couronne de riz blanc et parsemez d''amandes effilées.'], ['Balance de cuisine', 'Presse-agrumes', 'Ouvre-boîte', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'Riz Casimir', 'testées', 'poire', 'facile', 'veau', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'plat de riz', 'dessert', 'plat de résistance', 'riz', 'moyen', 'pêche', 'amandes effilées', 'curry', 'cocktail', 'cerises'], 'Plat principal', a57d5a65-5cb8-4e16-b8c5-9191b753d335, '2025-09-26T15:47:03.061726', [{'ingredient_id': 'b7c2cb2e-2a81-4fb3-a115-69b65c7f0879', 'quantite': '600 g'}, {'ingredient_id': '955ea398-e5c3-459f-866c-6c62e4fae9ec', 'quantite': '2.5'}, {'ingredient_id': '2e0958b1-7bf3-4923-8dcc-4feb420898fe', 'quantite': ''}, {'ingredient_id': 'ce8c7ddf-519b-4770-89ab-c373c232a690', 'quantite': '1'}, {'ingredient_id': '5b20e4b4-48b1-45b7-a27e-988c7f3e390b', 'quantite': '1'}, {'ingredient_id': '14fb1314-f2f6-451f-846e-674c9478e8c5', 'quantite': '1'}, {'ingredient_id': '1c7f4067-08f3-4622-bca2-04d3d61c9770', 'quantite': '1'}, {'ingredient_id': '00fe5bcd-5846-4378-8f2c-1d1fe62d43f7', 'quantite': ''}, {'ingredient_id': 'acd09c7d-6a74-444b-b4f8-07cc340cb14b', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (13693, 'Curry d''agneau facile (pomme, banane, poivron)', 'épaule, oignon, pomme, banane, poivron rouge, curry, raisins secs', '45 min', ['Couper l''épaule d''agneau en morceaux de 5cm environ (carrés).', 'Faire chauffer huile + beurre, puis y faire revenir à feu vif l''agneau saupoudré très largement de curry, avec le sel et les oignons émincés.', 'Laisser à feu vif en mélangeant pour bien imprégner le curry jusqu''à ce que la viande rende du jus.', 'Couvrir d''eau et laisser cuire 3/4 h en couvrant.', 'Ajouter pommes en lamelles, bananes coupées, poivrons en lanières et raisins secs.', 'Laisser mijoter et rectifier l''assaisonnement.', 'A servir avec du riz.'], ['Ouvre-boîte', 'Économe'], ['poivron)', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'plat', 'moyenne', 'recette', 'cuisine', 'poivron rouge', 'recettes', 'Curry d''agneau facile (pomme', 'oignon', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'moyen', 'raisins secs', 'épaule', 'curry', 'viande à l''indienne', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:47:06.678971', [{'ingredient_id': '48cb3021-d32b-461a-9d06-78dc2ebe5fe8', 'quantite': '1.2 kg'}, {'ingredient_id': '2e7f18b6-7fcf-465a-8c1b-281dd1d5c68c', 'quantite': '3'}, {'ingredient_id': '7c5a3874-cda6-4f65-8ccd-502eee4e9468', 'quantite': '2'}, {'ingredient_id': '789a3429-b603-4310-8cfb-a94ab12fd028', 'quantite': '1'}, {'ingredient_id': 'd8a3933c-0ceb-4fac-97a6-0c0a7b8d2632', 'quantite': '1'}, {'ingredient_id': 'd0fab981-d06d-49e8-bd07-86c4bf76007e', 'quantite': ''}, {'ingredient_id': '56fc67ae-9c07-49de-a0ca-5ebbe453dc26', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (217989, 'Salade de fruits frais façon été', 'pomme, poire, cerises, banane, sucre de canne', '10 min', ['Coupez les pommes et les poires en dés puis, mettez-les dans un récipient de votre choix (type saladier).', 'Coupez les bananes en rondelles et les cerises griottes en deux (enlevez les noyaux), puis ajoutez le tout dans le récipient avec les pommes et les poires.', 'Enfin, saupoudrez d''un peu sucre de canne et réservez au frais avant de déguster.'], ['Louche', 'Râpe', 'Presse-agrumes', 'Spatule', 'Poêle'], ['entrée', 'salade de fruits originale', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'très facile', 'bon marché', 'rapide', 'Salade de fruits frais façon été', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'sucre de canne', 'dessert', 'plat de résistance', 'pomme', 'cocktail', 'cerises'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:47:11.529025', [{'ingredient_id': '79b07698-e397-4bcf-ac67-8f759bd33403', 'quantite': '4'}, {'ingredient_id': '621aece9-85bf-4045-aaf2-abc5ff4a1fbf', 'quantite': '3'}, {'ingredient_id': 'e0e7eaf4-1cd4-48b4-8874-ae5b09307bb7', 'quantite': '250 g'}, {'ingredient_id': '699345bd-1ac4-4b5a-b95d-d71e64497c82', 'quantite': '2'}, {'ingredient_id': 'd3457a47-a1e8-41c1-8ce5-20746c1603c4', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (30957, 'Glace au lait de soja et à la banane', 'banane, sucre, eau, lait de soja', '20 min', ['Porter l''eau et le sucre à ébullition jusqu''à ce que le sucre soit fondu. Laisser refroidir. ', 'Ecraser les bananes à la fourchette dans une assiette. ', 'Mélanger le lait de soja avec le sirop refroidi. ', 'Verser dans la sorbetière, et quand le mélange est bien durci, transférer dans un récipient au congélateur.'], ['Batteur électrique', 'Ouvre-boîte', 'Pince de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'facile', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'lait de soja', 'sucre', 'Glace au lait de soja et à la banane', 'glace à l''italienne', 'cocktail'], 'Dessert', 8bbf7fe2-a6be-4f79-8ea3-9c2cda7177a8, '2025-09-26T15:47:15.086354', [{'ingredient_id': 'd8e1ad23-9b66-428c-b64f-ee9acb5bc53f', 'quantite': '3'}, {'ingredient_id': '97055ea6-6b86-4b12-acd8-bbac0c8031be', 'quantite': '115 g'}, {'ingredient_id': 'b239a1eb-36b5-407c-b700-ef3e55cb90cc', 'quantite': '15 cl'}, {'ingredient_id': 'ee5f43d8-4f2b-4249-97cb-cef835829462', 'quantite': '300 ml'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (27934, 'Curry de poulet et pommes de terre au lait de coco', 'pomme de terre, poulet, pomme, banane, lait de coco, curry, oignon nouveau, piment, huile d''olive, poivre, sel', '10 min', ['Découper le poulet en morceaux et les faire dorer dans une sauteuse avec un peu d''huile d''olive. ', 'Ajouter les oignons coupé en fines tranches, ainsi que le 1/4 de pomme et de la banane coupées en tout petits morceaux. Faites dorer. ', 'Saupoudrez de curry. Salez et poivrez. ', 'Versez le lait de coco. Mélangez. ', 'Laissez mijoter doucement à couvert pendant 20 mn. ', 'Pendant ce temps, épluchez les pommes de terre et les couper en fins quartiers. ', 'Les ajouter au curry de volaille avec le piment découpé en rondelles puis laisser cuire à feux doux pendant 15-20 mn.'], ['Fouet', 'Pince de cuisine', 'Presse-agrumes'], ['lait de coco', 'poulet', 'banane', 'entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'curry de poulet', 'plat', 'recette', 'piment', 'cuisine', 'recettes', 'boisson', 'huile d''olive', 'Curry de poulet et pommes de terre au lait de coco', 'oignon nouveau', 'dessert', 'plat de résistance', 'pomme', 'poivre', 'pomme de terre', 'curry', 'cocktail'], 'Plat principal', daf082ca-6e60-45d6-8789-dc630f9ad9dd, '2025-09-26T15:47:18.728753', [{'ingredient_id': '3e21fd3c-16a4-4c1a-a0ab-96c508cfa4d6', 'quantite': '800 g'}, {'ingredient_id': '673dd926-e3b7-43c9-a212-7a6336d3d354', 'quantite': '1'}, {'ingredient_id': '50d76063-c6f0-4a48-9197-60199a8aa8ae', 'quantite': ''}, {'ingredient_id': '0b85d7ef-d9d6-4e4f-a696-082f97b3bf41', 'quantite': ''}, {'ingredient_id': '2e6d2b83-de84-4eed-b2dd-46161bba2d5f', 'quantite': '400 ml'}, {'ingredient_id': '2679c17b-22b7-4aa1-84b7-efeb792340b3', 'quantite': '1 cuillères'}, {'ingredient_id': 'fe5d661f-942a-4bfd-a4b1-8c0fc1cdc257', 'quantite': '4'}, {'ingredient_id': 'd41e46bf-0b4d-467f-a399-3a9d59f09776', 'quantite': ''}, {'ingredient_id': 'f9ac3f2e-7151-4d38-9ed7-bd52095aa90f', 'quantite': ''}, {'ingredient_id': '0f47adc7-e477-4522-ba41-eb13b7a922fc', 'quantite': ''}, {'ingredient_id': '49ba6f0a-59af-4f22-b397-793c5ce80cdc', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (86936, 'Purée de banane pour accompagnement', 'banane, jus d''orange, crème fraîche', '15 min', ['Enlevez la peau des bananes.', 'Coupez-les en rondelles et mettez-les dans une casserole.', 'Ajoutez 1/3 du jus d''orange et la crème fraîche.', 'Chauffez à feu moyen tout en écrasant les bananes avec une fourchette.', 'Au fur et à mesure, ajoutez le reste du jus d''orange.', 'Lorsque les bananes sont bien écrasées, retirez-les du feu. ', 'Vous pouvez les passer au blender pour qu''elles soient bien mixées.'], ['Tire-bouchon', 'Balance de cuisine', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'Purée de banane pour accompagnement', 'boisson', 'dessert', 'plat de résistance', 'purée', 'jus d''orange', 'cocktail'], 'Accompagnement', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:47:22.250784', [{'ingredient_id': '8b44b65d-ac5b-4cf3-8b33-40028ad31c50', 'quantite': '2'}, {'ingredient_id': '5ec2cf06-7784-444a-b472-f93011f9f98b', 'quantite': '15 cl'}, {'ingredient_id': '852733df-e6ee-47b7-acd0-0eeeb03ee0cf', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (27881, 'bricks antillaises', 'brick, banane, noix de coco, sucre, extrait de vanille liquide, beurre', '5 min', ['Badigeonnez au pinceau les feuilles de brick de beurre fondu. puis saupoudrez de sucre. ', 'Découpez les bananes en rondelles et les disposer sur les bricks. ', 'Ajoutez la noix de coco et quelques gouttes d''extrait de vanille liquide. ', 'Rabattez les feuilles de brick de façon à former des carrés et les glisser au four Th 5/6 pendant 10 mn environ.'], ['Fouet', 'Ouvre-boîte', 'Planche à découper', 'Presse-agrumes', 'Louche'], ['', 'bricks antillaises', 'banane', 'entrée', 'recettes de cuisine', 'extrait de vanille liquide', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'brick', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'noix de coco', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:47:25.782623', [{'ingredient_id': '5aad92b9-be65-4675-8ad5-4be9543f3c96', 'quantite': '4'}, {'ingredient_id': 'b36db8cf-e088-4bfc-b5f6-aebdf98697b0', 'quantite': '4'}, {'ingredient_id': '1b546bd6-fc45-468e-9d1e-43ac91e7f795', 'quantite': '4 cuillères'}, {'ingredient_id': '22e8ae42-42e5-4e92-823e-9a35c03d5322', 'quantite': ''}, {'ingredient_id': '86956742-90a1-4f30-a2ad-de2b58b3a479', 'quantite': ''}, {'ingredient_id': '84b05a48-88d5-4fee-be99-20c8794b6ef6', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (82706, 'Potage à la tomate et aux bananes', 'oignon, tomates pelées, bouillon de poule, banane, curry, crème fraîche, poivre de Cayenne, poivre, sel', '15 min', ['Pelez et hachez grossièrement les oignons.', 'Faites revenir dans un faitout, lorsqu''ils deviennent transparents, ajoutez les tomates, le jus, le bouillon, 2 bananes (pelées et découpées),le curry, sel, poivre.', 'Laissez mijoter.', 'Mixez le tout, ajoutez la crème fraiche, et éventuellement le poivre de Cayenne.', 'Décorez de rondelles de bananes.'], ['Spatule', 'Poêle', 'Tire-bouchon'], ['bouillon de poule', 'banane', 'entrée', 'recettes de cuisine', 'crème fraîche', 'sel', 'Potage à la tomate et aux bananes', 'confiserie', 'testées', 'tomates pelées', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'soupe', 'dessert', 'plat de résistance', 'poivre de Cayenne', 'poivre', 'curry', 'cocktail'], 'Entrée', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:47:29.362124', [{'ingredient_id': '2b4b6101-0ad0-45b7-9f33-6e7204a53423', 'quantite': '2'}, {'ingredient_id': 'ace3ab16-a799-44d7-9a0d-283e32e65a25', 'quantite': '240 g'}, {'ingredient_id': 'fdc2877f-7b55-49a1-b8c1-be66520b17f0', 'quantite': '15 cl'}, {'ingredient_id': 'ab3e3c91-0f3e-441e-8d33-14887a326f7f', 'quantite': '3'}, {'ingredient_id': '50c2eae2-9379-4ecc-a140-502f57149294', 'quantite': '1 cuillères'}, {'ingredient_id': '1cf2655d-7245-4e39-a15d-80284ba9ff07', 'quantite': '15 cl'}, {'ingredient_id': '03125a40-e47c-4922-93c7-d4011eb51719', 'quantite': ''}, {'ingredient_id': '67e8f9ec-820c-494a-8e84-cc302a9b78f9', 'quantite': ''}, {'ingredient_id': 'b9fe4da1-0e64-49dc-8986-bb1352d8bd5f', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (71349, 'craquant de bananes', 'banane, boudoir, crème liquide, sucre glace, vanille, chocolat noir, beurre', '15 min', ['Emietter les boudoirs en petits morceaux. ', 'Faire fondre le chocolat et le beurre. ', 'Ecraser les bananes grossièrement. ', 'Préparer la chantilly en mélangeant la crème avec le sucre glace et la vanille.', 'Disposer le tout dans une verre :', 'une couche de biscuit, une couche de chocolat, une couche de purée de banane, une autre couche de chocolat, une couche de biscuit, des rondelles de banane, la chantilly. ', 'Pour décorer, mettre des copeaux de chocolat.'], ['Moule à tarte', 'Économe', 'Spatule', 'Mixeur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'vanille', 'dessert', 'plat de résistance', 'chocolat noir', 'craquant de bananes', 'beurre', 'boudoir', 'sucre glace', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:47:33.778603', [{'ingredient_id': 'a924d664-bd88-492e-9bd7-41828bfae993', 'quantite': '5'}, {'ingredient_id': '5109c70c-db66-4987-ac30-7aea965c2b9a', 'quantite': '10'}, {'ingredient_id': 'e44f6844-6d6a-4e4d-99de-27786565e3fb', 'quantite': '50 cl'}, {'ingredient_id': '23a0de65-41cb-4359-a9bb-ea48a9dcccd4', 'quantite': ''}, {'ingredient_id': '806bbd9d-f19d-484c-965f-bab769187383', 'quantite': ''}, {'ingredient_id': '8176ded2-ecda-4bc9-a8ed-ce5ffb0fb6c6', 'quantite': ''}, {'ingredient_id': 'dc91cb3c-f050-4871-87db-cd4f54e5f4c4', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (70492, 'Cake rhum-raisin-banane', 'yaourt nature, sucre en poudre, farine, levure chimique, oeuf, huile, rhum, raisins secs, banane, extrait de vanille', '10 min', ['Je vous propose une variante du gâteau au yaourt.', 'Dans un bol, faire mariner les raisins avec le rhum. ', 'Dans un saladier, mélanger dans l''ordre : yaourt, sucre, farine, levure, oeufs et levure.', 'Ajouter le rhum et les raisins, puis la banane.', 'Verser dans la préparation l''arôme de vanille. Ajouter l''huile.', 'Bien mélanger le tout, et mettre dans un moule à cake préalablement beurré.', 'Placer au four à 120° (th.4). Monter le four à 150-160° (th. 5-5,5) lorsque le gâteau a bien levé. ', 'Retirer du four quand le dessus du cake est doré et que la pointe d''un couteau en ressort sèche.', 'Laisser refroidir un peu avant de démouler.', 'Il ne reste plus qu''à savourer ! Succès garanti !'], ['Spatule', 'Ouvre-boîte', 'Verre doseur'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'levure chimique', 'yaourt nature', 'extrait de vanille', 'très facile', 'bon marché', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'Cake rhum-raisin-banane', 'farine', 'autres cakes', 'dessert', 'plat de résistance', 'raisins secs', 'cocktail'], 'Dessert', 9fa73b46-6a68-4f7c-a1ea-1cee5cb1d88c, '2025-09-26T15:47:37.350703', [{'ingredient_id': 'e079803d-636b-43d3-8236-893e1d6644aa', 'quantite': '1'}, {'ingredient_id': '2073c2de-acb7-4479-9788-21423e3a2afe', 'quantite': '2'}, {'ingredient_id': '073bff07-011b-44ad-98e6-c44c8fcdc639', 'quantite': '3'}, {'ingredient_id': 'e99ccb49-ac75-4b03-80f8-2380de2877f6', 'quantite': ''}, {'ingredient_id': 'c7403259-acc7-42e0-8c94-d796590277d7', 'quantite': '3'}, {'ingredient_id': '626b6ea7-f24e-45a0-9c6f-6f62c2602f2a', 'quantite': ''}, {'ingredient_id': 'dfc88c48-d959-4a42-93d6-0650e74a9f54', 'quantite': '3 cuillères'}, {'ingredient_id': '084310f3-1232-455e-bf6e-5329734e532c', 'quantite': '2'}, {'ingredient_id': '66476344-a9ea-4455-8c4a-6360483ef6dc', 'quantite': '1'}, {'ingredient_id': 'ec8e9a51-5c30-446c-bb7e-ea9e2d3af226', 'quantite': '5 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (56514, 'tarte bananes-poires', 'pâte sablée, banane, poire, blanc d''oeuf', '10 min', ['Mettre la pâte au fond d''un moule beurré, déposer dessus 2 bananes coupées en rondelles et mettre la pâte à précuire.', '<bt>Mixer les poires et le reste de bananes.', 'Faire monter les blancs en neige.', 'Mélanger soigneusement les fruits et les blancs et les verser sur la pâte et les bananes.', 'Mettre au four à 180°C entre 20 et 30 min, jusqu''à ce que le dessus soit bien doré.'], ['Spatule', 'Rouleau à pâtisserie', 'Verre doseur', 'Casserole'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'très facile', 'bon marché', 'pâte sablée', 'plat', 'tarte à la banane', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'tarte bananes-poires', 'blanc d''oeuf', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:47:40.857682', [{'ingredient_id': 'b79fea33-7df7-4296-afd3-4f6b709fa6a4', 'quantite': ''}, {'ingredient_id': 'c14bb6ae-4568-4307-ab9d-258cd55c1973', 'quantite': '4'}, {'ingredient_id': 'a311764b-fbc9-4d5d-a1da-601d7205cf2a', 'quantite': '2'}, {'ingredient_id': 'bc773565-6130-41fb-b9b2-e4d1c8471b00', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (383754, 'Crème de banane au Monsieur Cuisine', 'banane, crème fraîche, yaourt à la grecque, cassonade, jus de citron, sucre vanillé', '5 min', ['Épluchez, puis coupez les bananes en petits morceaux. Déposez-les dans la cuve de votre Monsieur Cuisine. Arrosez de jus de citron, ajoutez le reste des ingrédients, puis mixez pendant 40 sec / vit. 1 à 10 / 0 °C. ', 'Dégustez immédiatement ou placez au frais pendant 15 minutes maximum.'], ['Passoire', 'Rouleau à pâtisserie'], ['yaourt à la grecque', 'banane', 'entrée', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'cassonade', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'jus de citron', 'Crème de banane au Monsieur Cuisine', 'cocktail', 'crème dessert'], 'Dessert', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T15:47:44.408343', [{'ingredient_id': '94c0de2d-67b2-44c2-84f7-5548f79b0dc7', 'quantite': '4'}, {'ingredient_id': '47ce7b3f-3876-41c4-8de2-30d652183849', 'quantite': '2 cuillères'}, {'ingredient_id': '9e2bdd2c-229c-4f03-90bc-59554c4c18b1', 'quantite': '2 cuillères'}, {'ingredient_id': '75779406-3e40-4399-b49a-d29ebde7ad82', 'quantite': '2 cuillères'}, {'ingredient_id': 'd849aaaa-aaaf-4b21-86a2-06736024a3e3', 'quantite': '2 cuillères'}, {'ingredient_id': 'af0a108f-a2f1-4c22-8f27-dbfa2e852139', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (62131, 'Bananes rôties au feu de bois', 'banane, orange, raisins secs, cassonade', '10 min', ['Après avoir préparé un barbecue, prenez les bananes et coupez-les dans le sens de la longueur en laissant la peau.', 'Disposez-les sur le gril, au-dessus des braises encore chaudes.', 'Ajoutez un peu de cassonade pour que ça caramélise mais pas trop car la banane est déjà sucrée.', 'Pressez l''orange et au fur et à mesure de la cuisson, versez-en un peu sur les bananes.', 'Une fois qu''elles sont bien chaudes et qu''elles commencent à prendre une teinte plus orangée, retirez-les du feux et disposez-les sur une assiette.', 'Ajoutez quelques raisins secs et servez aussitôt.'], ['Passoire', 'Fouet', 'Batteur électrique', 'Balance de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'cassonade', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'orange', 'raisins secs', 'cocktail', 'Bananes rôties au feu de bois'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:47:48.929950', [{'ingredient_id': '20350383-4395-4ab9-b4fa-c21f678b90c2', 'quantite': '4'}, {'ingredient_id': '68a954dd-eff3-4872-a664-b8e907eecaaa', 'quantite': '1'}, {'ingredient_id': '50eb83c2-dfbf-4dc1-99e9-d35744123687', 'quantite': ''}, {'ingredient_id': '88e460f3-a6e2-4940-93ef-2a47c3ad4e5c', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (53848, 'Muffins bananes, chocolat et cannelle', 'banane, farine, sucre vanillé, cassonade, levure chimique, cannelle, cacao amer, oeuf, beurre, rhum, citron vert, sel', '20 min', ['Préchauffez le four à 210°C (TH 7). ', 'Faites fondre le beurre sans trop le faire chauffer. ', 'Peler et couper les bananes en petits cubes, les arroser de jus de citron.', 'Battre les jaunes d''oeufs avec la cassonade et le sucre vanillé jusqu''à blanchiment. ', 'Incorporer petit à petit la farine mélangée avec la cannelle, le cacao, la levure. Pas de panique, si à ce stade la préparation est plus que compacte et que toute la farine ne s''incorpore pas, c''est normal ! ', 'Incorporer le beurre fondu et le rhum.', 'Une fois la pâte homogène, incorporer les blancs montés en neige avec la pincée de sel et enfin les bananes.', 'Verser la pâte dans les moules à muffins. Beurrer les moules, s''ils ne sont pas en silicone. ', 'Le temps de cuisson est d''environ 15 min, vérifier la cuisson avec un couteau, la lame doit ressortir sèche.'], ['Pince de cuisine', 'Batteur électrique', 'Verre doseur', 'Mixeur', 'Économe'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'cacao amer', 'sel', 'confiserie', 'testées', 'cassonade', 'levure chimique', 'Muffins bananes', 'facile', 'chocolat et cannelle', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'moyen', 'muffin', 'beurre', 'citron vert', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:47:52.553991', [{'ingredient_id': '6501aef8-8da0-4e33-9a4e-85cd58e848db', 'quantite': '3'}, {'ingredient_id': '86f2c379-c9a9-4e2b-afae-840941fd279b', 'quantite': '180 g'}, {'ingredient_id': '53f5e165-8ba0-4db9-ae49-ce42870b93b6', 'quantite': '1'}, {'ingredient_id': '18e12680-949f-4626-9e62-d6b069730000', 'quantite': '180 g'}, {'ingredient_id': '23db7abd-59cd-476c-8362-01e5b2ccc966', 'quantite': '2 cuillères'}, {'ingredient_id': 'dbc335ee-5a8e-4b5f-a12f-448cdeaa0966', 'quantite': '1 cuillères'}, {'ingredient_id': '97d01ed1-af36-45c9-9309-82a29b9cd2a3', 'quantite': '2 cuillères'}, {'ingredient_id': 'f4ad97e8-9d9b-4798-9063-b892463a450c', 'quantite': '3'}, {'ingredient_id': '1262fd76-9c02-4f81-a00b-3944d735d8cc', 'quantite': '180 g'}, {'ingredient_id': 'beff538e-8b27-4f41-b2a2-9b55aabdb671', 'quantite': '5 cl'}, {'ingredient_id': '648e0b1f-5150-47a0-a14c-d3c981969105', 'quantite': '1'}, {'ingredient_id': '936657e2-b99d-480f-a4b5-4168a3bbc69b', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (29663, 'Flan de tapioca aux bananes et aux épices (recette malgache)', 'lait, vanille, sucre semoule, muscade, clou de girofle, tapioca, crème, banane, beurre, oeuf', '25 min', ['Amenez le lait à ebullition avec la vanille, le sucre, la noix de muscade et le clou de girofle.', 'Hors du feu, jetez le tapioca en pluie et mélangez. Puis, remettez sur feu doux. Remuez fréquemment avec une cuillère en bois pendant 10 minutes.', 'Préchauffer le four à 180°C (thermostat 6)', 'Ecrasez les bananes et ajoutez-les au tapioca. Incorporez la crème et les oeufs un à un. Versez la préparation dans un moule rond beurré.', 'Enfournez 15 minutes et laissez refroidir avant de servir.'], ['Batteur électrique', 'Mixeur', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'cocktail', 'muscade', 'facile', 'bon marché', 'oeuf', 'plat', 'crème', 'recette', 'tapioca', 'cuisine', 'recettes', 'sucre semoule', 'boisson', 'clou de girofle', 'vanille', 'dessert', 'plat de résistance', 'beurre', 'flan', 'lait', 'Flan de tapioca aux bananes et aux épices (recette malgache)'], 'Dessert', 34fd4997-5e37-4f34-80df-d4dfd8a8f16a, '2025-09-26T15:47:56.252125', [{'ingredient_id': '460b3228-6932-4fac-a93c-1605f2be2dca', 'quantite': '50 cl'}, {'ingredient_id': 'b58ac1c1-6798-4763-a4e4-53b30e0e1259', 'quantite': '1'}, {'ingredient_id': '13013ed3-282a-47e1-b223-1fc0c5e19d1c', 'quantite': '4 cuillères'}, {'ingredient_id': '07a81a99-fb07-4383-8b94-1b9ad8312f02', 'quantite': '1'}, {'ingredient_id': 'b442abcd-ad54-4fea-9ae9-fecd7f56658d', 'quantite': '1'}, {'ingredient_id': '7c67bf6b-a31c-4b26-9f16-e74c2e55c3dc', 'quantite': '5 cuillères'}, {'ingredient_id': 'e1d77ee8-6069-40a5-be17-6772066b0513', 'quantite': '2 cuillères'}, {'ingredient_id': 'c6a25f77-ae9f-4ac9-9251-4b7c47004ab6', 'quantite': '4'}, {'ingredient_id': 'df686238-5989-4f3e-8a70-fe5fab97e0e8', 'quantite': '15 g'}, {'ingredient_id': '7a472a8d-284f-437b-987d-0e3c3fb18a8d', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (25090, 'Tourte banane et chocolat', 'banane, pâte feuilletée, cassonade, crème fraîche épaisse, rhum, chocolat noir', '20 min', ['1) Etalez une pâte feuilletée dans un moule à tarte. ', '2) Epluchez et coupez les bananes en rondelles. ', '3) Répartissez les bananes sur la pâte. ', '4) Ajoutez la cuillère à soupe de rhum, la cassonade. ', '5) Etalez la crème sur les bananes. ', '6) Coupez le chocolat noir en petits dés. ', '7) Répartissez le chocolat sur les bananes. ', '8) Etalez la deuxième pâte sur la tarte. Soudez bien les bords. ', '9) Piquez la pâte avec une fourchette pour permettre à la vapeur de s''échapper. ', '10) Faites cuire 35 mn à 180°C. ', '11) Servez légèrement tiède ou froid.'], ['Rouleau à pâtisserie', 'Moule à tarte', 'Pince de cuisine', 'Planche à découper'], ['entrée', 'tarte au chocolat', 'banane', 'recettes de cuisine', 'crème fraîche épaisse', 'rhum', 'confiserie', 'testées', 'cassonade', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pâte feuilletée', 'chocolat noir', 'Tourte banane et chocolat', 'cocktail'], 'Dessert', 45e798d4-d4e4-433a-9b13-87a793f474e7, '2025-09-26T15:47:59.843545', [{'ingredient_id': '1db27692-7e2a-40c0-8059-699ee474acad', 'quantite': '4'}, {'ingredient_id': '34a0ee17-9942-4653-be9c-2970306fba04', 'quantite': '2'}, {'ingredient_id': '16e37060-28c9-4a3d-815e-181d047c298a', 'quantite': '3 cuillères'}, {'ingredient_id': '2a19eef0-adc8-4f22-b670-283f5e3c4ed9', 'quantite': '3'}, {'ingredient_id': '04000870-630c-47cc-8663-cf8af7cff5da', 'quantite': '1 cuillères'}, {'ingredient_id': '4ece7541-4ffc-4a93-b2d3-c6362d6dab0f', 'quantite': '80 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (28278, 'Salade de fruits jaunes au rhum', 'pamplemousse, banane, mirabelle, sucre en poudre, rhum, jus de citron', '15 min', ['Egoutter les mirabelles et faire chauffer le jus avec le sucre. Hors du feu, parfumer de rhum.', 'Couper les pamplemousses en 2 et les évider sans abimer les coques.', 'Détailler la chair de pamplemousse en morceaux, les bananes en rondelles et les mirabelles en 2.', 'Mettre les fruits dans un saladier, les arroser de jus de citron puis du sirop parfumé au rhum.', 'Mélanger et répartir la salade dans les coques de pamplemousse.', 'Réserver au frais jusqu''au moment de servir.   '], ['Planche à découper', 'Râpe', 'Batteur électrique'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'rapide', 'plat', 'sucre en poudre', 'recette', 'mirabelle', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pamplemousse', 'jus de citron', 'Salade de fruits jaunes au rhum', 'moyen', 'cocktail'], 'Dessert', a36ccd86-5f6b-40cc-bbe8-03f1cbd0405c, '2025-09-26T15:48:03.448903', [{'ingredient_id': '8d633fe3-f8c5-481f-bfc4-823366a247cb', 'quantite': '3'}, {'ingredient_id': '35ead215-4c98-402e-b4e2-e17726ccdf4d', 'quantite': '4'}, {'ingredient_id': '07a72dfa-77ed-47bc-99e4-a9a72fcef051', 'quantite': '1'}, {'ingredient_id': '6a558496-f46c-4874-aab4-5a8039991e37', 'quantite': '125 g'}, {'ingredient_id': '3f84a3a0-fd8f-4730-aa4d-6705857140ff', 'quantite': '5 cl'}, {'ingredient_id': '40fb3707-5606-4c5b-9158-9180f420e27b', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (534330, 'Tarte tatin banane et noix de Quentin', 'banane, lait, beurre, pâte brisée, sucre, jus de citron, cerneau de noix, jaune d''oeuf, cannelle', '30 min', ['Mettez dans une poêle , le sucre, le beurre, le jus de citron , la cannelle et faites cuire à feux moyen jusqu''à obtenir un beau caramel. ', 'Coupez en rondelles la banane.
Mettez une cuillère à café de caramel au fond de petits moules à tarte d''environ 8cm.
Ajoutez quelques rondelles de bananes , de nouveau du caramel puis recouvrez le tout de pâte brisée. ', 'On oublie pas de dorer la pâte avec un jaune d''œuf et du lait.  
On enfourne le tout pendant 20min à 170°C ', 'Une fois que c''est cuit on peut démouler et ajoutez des morceaux de noix en toppings ! '], ['Casserole', 'Passoire', 'Pince de cuisine'], ['', 'Tarte tatin banane et noix de Quentin', 'banane', 'entrée', 'recettes de cuisine', 'cerneau de noix', 'confiserie', 'testées', 'facile', 'bon marché', 'plat', 'jaune d''oeuf', 'recette', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'jus de citron', 'beurre', 'cannelle', 'lait', 'sucre', 'cocktail'], 'Dessert', d8dcb53d-93e5-4ea7-8f94-b7376edece2a, '2025-09-26T15:48:08.010943', [{'ingredient_id': 'e1d1ea3d-9cb2-4e6e-b6ab-84f3c0eaaae2', 'quantite': '1'}, {'ingredient_id': 'c6f1a2a9-847d-40a3-b8f8-c41f37bbc996', 'quantite': '2 cuillères'}, {'ingredient_id': '7353adcc-762a-416a-994e-0a6385db6b8c', 'quantite': '50 g'}, {'ingredient_id': '05ac5055-cb2f-4f74-95cc-47a003d2e7a2', 'quantite': '1'}, {'ingredient_id': '3e8b1a79-62be-4b8d-901c-b0c775f3032e', 'quantite': '100 g'}, {'ingredient_id': 'f2da355e-e8d3-49cf-b0bf-c73e166ce801', 'quantite': '1 cuillères'}, {'ingredient_id': '0314f4d7-cd81-4aab-bac7-de65889f9db9', 'quantite': '20 g'}, {'ingredient_id': '890c47ed-2c2a-48f8-b4f4-d80defe6f392', 'quantite': '1'}, {'ingredient_id': 'c897d1d2-8826-410a-83b1-d686d7533605', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (62194, 'Arroz a la cubana ( riz)', 'riz, oeuf, banane, tomate, huile d''olive, beurre, sel', '30 min', ['Faire bien chauffer l''eau pour le riz en y ajoutant une grande cuillère de sel.', 'Verser le riz et le cuire au petit feu avec le couvercle pendant 17 minutes en remuant toutes les 3 minutes.', 'Pendant la cuisson du riz, couper la banane et la faire revenir avec du beurre jusqu''à ce qu''elle soit caramélisée.', 'Une fois la banane préparée, casser les oeufs et les frire.', 'Les déposer sur l''assiette avec les rondelles de banane.', 'Egoutter le riz et le mettre dans un verre pour faire des petits tas sur l''assiette afin que ça soit plus joli. Verser la tomate et voila.', 'Bon appétit !'], ['Ouvre-boîte', 'Presse-agrumes', 'Passoire', 'Poêle', 'Râpe'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'tomate', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'Arroz a la cubana ( riz)', 'boisson', 'plat de riz', 'huile d''olive', 'dessert', 'plat de résistance', 'riz', 'beurre', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:48:11.597229', [{'ingredient_id': 'ed10fe92-ed60-49c7-92b8-477e5b595b06', 'quantite': '2.5'}, {'ingredient_id': 'd0f09ee4-b1f0-43fc-ae93-72b4ef8170ef', 'quantite': '4'}, {'ingredient_id': '284cab97-9a4c-4645-837d-ddc044ff111a', 'quantite': '1'}, {'ingredient_id': '58e2992f-5c8f-43e1-b40a-79ab7c614ee1', 'quantite': '20 cl'}, {'ingredient_id': '6575c6e8-da1a-4778-aefa-5676b541a8a3', 'quantite': ''}, {'ingredient_id': '6fd08a43-02c3-448c-9051-cdca6c29d596', 'quantite': ''}, {'ingredient_id': '34a80113-1aa5-4eea-b239-a3f6edf0803b', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (308201, 'Glace orange banane yaourt', 'banane, orange, sirop de sucre de canne, yaourt', '10 min', ['Dans le bol du mixeur, mettre tous les ingrédients et mixer pendant 2 minutes.', 'Verser la préparation dans la turbine à glace (ou sorbetière) et faire prendre pendant 40 minutes.'], ['Poêle', 'Verre doseur', 'Planche à découper', 'Rouleau à pâtisserie', 'Râpe'], ['sirop de sucre de canne', 'banane', 'entrée', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'orange', 'glace à l''italienne', 'cocktail', 'Glace orange banane yaourt'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:48:15.132711', [{'ingredient_id': 'a15f1b30-7636-488b-a8c7-0aa086b34152', 'quantite': '3'}, {'ingredient_id': 'e5386b1f-ce70-4ec4-ac0e-820620171944', 'quantite': ''}, {'ingredient_id': '09ae7ecc-6427-4ea4-bd36-153e6246ab85', 'quantite': '18 cl'}, {'ingredient_id': '64a58090-dd97-43bf-ac44-384dda81ee2b', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (88656, 'Gâteau choco-banane façon Alice', 'banane, sucre, farine, oeuf, lait, crème dessert au chocolat, beurre', '20 min', ['Faire fondre le chocolat avec le lait selon la méthode de votre choix (micro-ondes, bain-marie...).', 'Pendant ce temps, dans un saladier, mélanger les jaunes d''oeuf avec le sucre jusqu''à ce que le mélange blanchisse.', 'Ajouter le mélange chocolat/lait aux jaunes puis la farine.', 'Monter les blancs en neige et les incorporer délicatement au mélange.', 'Verser le gâteau dans un moule rectangulaire de préférence.', 'Couper les bananes en rondelles et les répartir sur l''ensemble du gâteau en les enfonçant légèrement.', 'Cuire dans un four à 180°C (thermostat 6) pendant 25 minutes.', 'Vérifier la cuisson en piquant régulièrement le gâteau.'], ['Couteau de chef', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'gâteau à la banane', 'Gâteau choco-banane façon Alice', 'beurre', 'crème dessert au chocolat', 'sucre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:48:18.787168', [{'ingredient_id': 'f341fe2e-ab51-44ae-9c1c-182aab36fcfc', 'quantite': '2'}, {'ingredient_id': '8fdb5cbb-6313-4b1d-bb89-88f4b0313158', 'quantite': '100 g'}, {'ingredient_id': '9a4da844-ae2b-490b-abb8-7f731eefab38', 'quantite': '100 g'}, {'ingredient_id': '08faa613-7ebc-4535-a4f2-5a4746d6c274', 'quantite': '3'}, {'ingredient_id': '2e875bad-fcfb-4cb1-b323-6770cf37bf90', 'quantite': '250 ml'}, {'ingredient_id': '1e711e9d-b263-4935-82fc-86be45abd07d', 'quantite': '150 g'}, {'ingredient_id': '8b52cc74-70e9-4238-b389-2cbebbe08319', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (31971, 'Bananes et poires rôties au lait de coco', 'banane, poire, lait de coco, sucre vanillé, beurre', '10 min', ['Faites revenir les bananes coupées en rondelles dans le beurre, à feu moyen. Epluchez les poires et ajoutez-les aux bananes.', 'Ajoutez le sucre vanille ou la gousse, mélangez et augmentez le feu pour caraméliser le tout, cela pendant  une quinzaine de minutes.', 'Une fois le tout bien caramélisé, ajoutez le lait de coco, baissez le feu et laissez cuire pendant 20 à 25mn.', 'Versez le tout dans un saladier et laissez refroidir.'], ['Verre doseur', 'Passoire', 'Couteau de chef', 'Planche à découper', 'Batteur électrique'], ['', 'lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Bananes et poires rôties au lait de coco', 'dessert', 'plat de résistance', 'sucre vanillé', 'beurre', 'cocktail'], 'Dessert', 35123a2d-595b-4382-9390-e51dc1226d76, '2025-09-26T15:48:22.437695', [{'ingredient_id': 'af8361b0-ed9c-4cdb-b8fe-66260cc8c954', 'quantite': '3'}, {'ingredient_id': '358c4276-2dc5-4c40-9b67-3534fbd02522', 'quantite': '3'}, {'ingredient_id': '9e401f30-50d6-449f-b588-9f97bee6ce13', 'quantite': '50 cl'}, {'ingredient_id': '9b5ac294-7423-4e23-92a1-0dee96da03ec', 'quantite': '2'}, {'ingredient_id': '8152e120-2f5b-4b48-8a91-053ac04a0ab6', 'quantite': '25 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (94480, 'Soupe au poireau, aux bananes, aux carottes et céleri blanc', 'poireau, banane, carotte, céleri, bouillon de poule, crème fraîche, noix de coco, curry, feuilles de coriandre, poivre, sel', '8 min', ['Tailler le poireau, les bananes, les carottes et les branches de céleri en petits morceaux.', 'Placer le tout dans un faitout et ajouter le bouillon de poule.', 'Porter à ébullition et laisser cuire pendant 15 minutes et bien mixer.', 'Saler et poivrer.', 'Fouetter fermement la crème fraîche et ensuite ajouter le curry et la noix de coco moulue.', 'Répartir la soupe dans des bols et ajouter 1/2 cuillère à soupe de crème de coco.', 'Terminer avec de la coriandre ciselée ou du persil ciselé.', 'Bon appétit.'], ['Économe', 'Spatule'], ['bouillon de poule', 'banane', 'entrée', 'recettes de cuisine', 'crème fraîche', 'sel', 'confiserie', 'testées', 'carotte', 'très facile', 'bon marché', 'Soupe au poireau', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'aux bananes', 'poireau', 'soupe', 'dessert', 'plat de résistance', 'feuilles de coriandre', 'aux carottes et céleri blanc', 'noix de coco', 'poivre', 'curry', 'cocktail', 'céleri'], 'Entrée', efa21c65-2f56-493b-9736-d4795be507e6, '2025-09-26T15:48:26.115771', [{'ingredient_id': '4a1bd02c-6dd5-4ce0-844e-3503dad97bfb', 'quantite': '1'}, {'ingredient_id': 'cac21ae0-05e2-4136-9dd3-802040564e23', 'quantite': '2'}, {'ingredient_id': '9f88234d-b0f0-4cc3-88b6-d5a563ea1417', 'quantite': '2'}, {'ingredient_id': '4ad8375a-7ba7-4365-8a04-06ee1182ddc8', 'quantite': '2'}, {'ingredient_id': '16140c9e-3e64-4906-a5d0-f62ee2f9b66c', 'quantite': '1 l'}, {'ingredient_id': '632139f2-820d-462a-8073-53baa1d6bdb5', 'quantite': '1'}, {'ingredient_id': 'f09e03a3-281f-4f3d-b472-f180c2d9a82c', 'quantite': '1 cuillères'}, {'ingredient_id': 'b1955fa7-8122-4643-a8ec-afb4acdbdb8f', 'quantite': ''}, {'ingredient_id': 'f30fcd1d-6495-4a4d-b0a4-1206b37518f1', 'quantite': '12'}, {'ingredient_id': 'a08ab5a2-5041-4f22-81c3-d6ccb2852ff8', 'quantite': ''}, {'ingredient_id': '278e0487-4a1c-4ef7-850a-f83889561967', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (344906, 'Muffin banane avoine light', 'édulcorant, arôme vanille, oeuf, avoine, banane, yaourt nature, levure chimique', '15 min', ['Préchauffer le four à 180°C en chaleur tournante.', 'Broyer les flocons d''avoine en poudre.', 'Mélanger dans un saladier les 2 oeufs, 1 yaourt 0%, 1 banane écrasée, 2 cuillères à café d''arôme vanille et 1 cuillère à café d''édulcorant.', 'Ajouter la poudre de flocon d''avoine et la levure chimique au premier mélange.', 'Déposer le mélange dans les moules à muffin (à mi-hauteur).', 'Couper la banane restante en rondelles du nombre de moules remplis. Glisser dans chaque moule une rondelle.', 'Cuire pendant 15 minutes environ.', 'Sortir et Déguster !'], ['Économe', 'Ouvre-boîte', 'Batteur électrique', 'Louche', 'Pince de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'yaourt nature', 'facile', 'bon marché', 'oeuf', 'plat', 'édulcorant', 'recette', 'cuisine', 'recettes', 'boisson', 'avoine', 'dessert', 'plat de résistance', 'arôme vanille', 'muffin', 'Muffin banane avoine light', 'cocktail'], 'Dessert', 382571b8-8ba2-4223-895c-347e9316289b, '2025-09-26T15:48:29.722565', [{'ingredient_id': '6a24eb0a-3e3d-4d37-831e-18c3f3eb45c3', 'quantite': '1 cuillères'}, {'ingredient_id': '221c749f-ca9f-467b-952c-9736c8659e9c', 'quantite': '2 cuillères'}, {'ingredient_id': 'f1be0999-00c4-47f3-a481-3cf1d295cbd4', 'quantite': '2'}, {'ingredient_id': '807e6c6b-bf8a-4bfe-aedb-0cee193922c2', 'quantite': '90 g'}, {'ingredient_id': '321027a7-2649-439c-96ae-3a0dd52c4008', 'quantite': '2'}, {'ingredient_id': 'e200d822-593b-4f96-9c9f-8a5289377371', 'quantite': '1'}, {'ingredient_id': '856e43fa-a815-4bdf-9425-a30382bedb62', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (18434, 'Poulet colombo', 'poulet, oignon, épices à colombo, concentré de tomates, thym, banane, noix de coco rapée', '30 min', ['Coupez le poulet en morceaux, faites le revenir dans de l''huile d''olive (dans une cocotte allant au four si possible), ajoutez l''oignon émncé, salez et poivrez. Quand le tout est bien doré recouvrez d''eau, ajoutez 4 ou 5 cuillères à soupe de colombo, le concentré de tomate et une grosse pincée de thym. Recouvrez et mettez au four moyen pendant une heure, ou laissez cuire sur le gaz, remuez de temps en temps. Au moment de servir, faites revenir les bananes coupées en rondelles dans du beurre, faites cuire du riz et servez le tout séparement. Quand les invités se seront servis leur assiette parsemez-la de noix de coco râpée.'], ['Presse-agrumes', 'Verre doseur', 'Batteur électrique', 'Mixeur'], ['poulet', 'banane', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'concentré de tomates', 'facile', 'bon marché', 'curry de poulet', 'plat', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'noix de coco rapée', 'dessert', 'plat de résistance', 'thym', 'Poulet colombo', 'épices à colombo', 'cocktail'], 'Plat principal', 87359c14-63dd-428f-ba08-d14e0c3e049b, '2025-09-26T15:48:33.328178', [{'ingredient_id': '4936d171-df7d-442b-9640-06481238afcc', 'quantite': '1'}, {'ingredient_id': '67328246-b130-465d-a227-b22068bb82a4', 'quantite': '1'}, {'ingredient_id': '9b82689b-688a-4e38-8ed6-e5b2b2f7f4f1', 'quantite': ''}, {'ingredient_id': '4d37773b-0000-4e5a-a193-a3958186af91', 'quantite': '1'}, {'ingredient_id': '72c267d0-5108-405d-8fa4-916105058bfb', 'quantite': ''}, {'ingredient_id': '74565d9c-1cdf-41d2-8d70-372212a66003', 'quantite': '3'}, {'ingredient_id': 'c4617ba3-4ec2-4e85-9ccc-a3b9c287f452', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (31110, 'Clafoutis aux bananes et coco', 'oeuf, sucre semoule, sucre vanillé, rhum, crème fraîche épaisse, farine, banane, oeuf, sucre semoule, beurre, noix de coco', '20 min', ['Préchauffez le four à thermostat 4 (150°C).', 'Préparez la pâte à clafoutis : fouettez les oeufs avec les sucres. Ajoutez le rhum, la crème fraiche, la farine et la levure. Mélangez bien et versez dans un moule à manqué beurré.', 'Préparez la garniture : pelez et coupez les bananes en fines rondelles. Disposez-les sur la pâte à clafoutis.', 'Dans une terrine, battez vivement les oeufs avec le sucre, le beurre fondu et la noix de coco. Couvrez les bananes avec ce mélange.', 'Mettez 45 min au four à thermostat 4 (150°C).'], ['Presse-agrumes', 'Économe', 'Poêle', 'Planche à découper'], ['entrée', 'recettes de cuisine', 'crème fraîche épaisse', 'rhum', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'sucre semoule', 'boisson', 'farine', 'dessert', 'plat de résistance', 'clafoutis', 'sucre vanillé', 'Clafoutis aux bananes et coco', 'cocktail'], 'Dessert', 6b476b38-2186-45b5-9aaa-1ee4ab56c2f1, '2025-09-26T15:48:37.020636', [{'ingredient_id': '85259740-28bc-4f3f-be29-19b89930cd0d', 'quantite': '2'}, {'ingredient_id': 'a046fe06-1237-4236-9271-c060899ee473', 'quantite': '100 g'}, {'ingredient_id': '6f03c726-1818-4bff-952e-bba7a975121b', 'quantite': '2'}, {'ingredient_id': '3ed8d20b-6482-4546-a786-f94853398d34', 'quantite': '1 cuillères'}, {'ingredient_id': '1e0cc27f-d291-49e3-a922-4e21a3fabc0d', 'quantite': '100 g'}, {'ingredient_id': '827e2390-92e7-4e4f-93d9-e42102875baf', 'quantite': '125 g'}, {'ingredient_id': 'c01974de-6145-4664-882d-a03337bb93e6', 'quantite': '2'}, {'ingredient_id': '12a56160-65d3-40c1-a3aa-1ce130910248', 'quantite': '2'}, {'ingredient_id': '30631864-ef1d-4e3b-ba92-79a61c8b8a2e', 'quantite': '75 g'}, {'ingredient_id': '47be9f3a-76f3-4564-9aa1-803bda86d60e', 'quantite': '75 g'}, {'ingredient_id': '8c2a8590-25ff-485a-83b8-defc9b6c3ead', 'quantite': '60 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (336250, 'Tarte à la banane facile', 'beurre, pâte brisée, banane, extrait de vanille, cassonade', '5 min', ['Dans un plat à tarte, dérouler la pâte brisée.', 'Avec un pinceau, mettre une couche de beurre fondu au fond et saupoudrer d''un peu de cassonade.', 'Couper les bananes et les disposer sur la pâte.', 'Mettre quelques gouttes d''extrait de vanille, mélanger au reste du beurre fondu et passer sur les bananes à l aide du pinceau et saupoudrer de cassonade.', 'Cuire 20 min à 180°C (thermostat 6) et déguster.'], ['Ouvre-boîte', 'Passoire', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'Tarte à la banane facile', 'confiserie', 'testées', 'cassonade', 'extrait de vanille', 'facile', 'bon marché', 'plat', 'tarte à la banane', 'recette', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:48:40.686363', [{'ingredient_id': '3b660cc8-9f56-45de-91be-28929aad93ca', 'quantite': '25 g'}, {'ingredient_id': 'a0ff5eb9-3856-47aa-b586-4ba6cf360568', 'quantite': '1'}, {'ingredient_id': 'eedea4d3-a58b-46fb-9e86-3ba9ab20807d', 'quantite': '3'}, {'ingredient_id': 'd0584d54-d8eb-42ff-be4f-8e4eb0a80808', 'quantite': '3'}, {'ingredient_id': '7bb340bd-68db-4099-9c31-68d5df496b04', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (528523, 'Cookies à l''okara d''avoine & éclats de peaux de banane caramélisées', 'Peau de banane, sucre, eau, banane, farine, sucre, poudre à lever, huile végétale, Peau de banane, okara', '15 min', ['Couper la chair de banane en rondelles, mettre quelques rondelles de côté et écraser le reste de la chair à la fourchette. Ajouter le reste des ingrédients (garder quelques éclats pour la décoration) à la purée de banane, et mélanger.', 'Former des petites boules avec des cuillères à café. Disposer les éclats et rondelles de banane restants sur le dessus.', 'Les disposer sur une plaque de papier cuisson huilé.', 'Faire cuire 30 minutes à 180°C.'], ['Louche', 'Mixeur', 'Moule à tarte', 'Poêle'], ['Peau de banane', 'entrée', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'facile', 'Cookies à l''okara d''avoine & éclats de peaux de banane caramélisées', 'bon marché', 'cookie', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre', 'cocktail'], 'Dessert', 0c4435fa-724e-4942-b7c4-72ed9adb14d0, '2025-09-26T15:48:44.235935', [{'ingredient_id': '927191c0-f398-43ce-9c4f-d75c2d0c0cf6', 'quantite': '1'}, {'ingredient_id': '9f6f14a0-4590-4818-8cc0-517d60732df2', 'quantite': '50 g'}, {'ingredient_id': '985591d1-4f69-469f-af2d-db5a7b755087', 'quantite': '125 g'}, {'ingredient_id': '1988a3e1-0d8a-4f69-94ff-90d11f625c39', 'quantite': '1'}, {'ingredient_id': '9599bb9c-1e67-438b-b6fd-ec89ae38a253', 'quantite': '140 g'}, {'ingredient_id': '73ffa741-eec9-4b8b-8fc0-46bdab5f9747', 'quantite': '40 g'}, {'ingredient_id': '5e41c683-5019-461a-a66f-45b14907ccaa', 'quantite': ''}, {'ingredient_id': 'bb6bcb85-c390-4ae4-9f42-46083c145e1c', 'quantite': '4 cl'}, {'ingredient_id': '77dfda5d-6a15-406c-bb4f-35dcd80fe440', 'quantite': ''}, {'ingredient_id': 'ade60294-b52d-4576-8a51-abfefd20fcb7', 'quantite': '120 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (50259, 'Milk shake à la banane et au fromage blanc', 'banane, glaçons, fromage blanc, sucre en poudre, jus de citron', '5 min', ['Dans un blender prévu pour faire de la glace pilée, ajouter tous les ingrédients et mixer jusqu''à ce que les glaçons soient réduits en glace pilée.', 'Verser dans des verres à milk shake, et déguster sans tarder !', 'Pour la déco : saupoudrer de cacao en poudre.', 'PS : pour les amateurs, on peut ajouter une larme de rhum...'], ['Pince de cuisine', 'Poêle', 'Économe', 'Moule à tarte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'fromage blanc', 'Milk shake à la banane et au fromage blanc', 'dessert', 'plat de résistance', 'jus de citron', 'glaçons', 'cocktail'], 'Boisson', bc1b12ac-138f-4862-9df5-c2a733f3e774, '2025-09-26T15:48:47.892626', [{'ingredient_id': 'b469b1cc-966c-4213-bbe6-3b20763e03e2', 'quantite': '1'}, {'ingredient_id': 'da2bf782-4d50-4e43-b699-d93cdb442cf3', 'quantite': '6'}, {'ingredient_id': '2e4c8681-d0b4-487a-a123-472bb89fc19a', 'quantite': '2 cuillères'}, {'ingredient_id': 'd83e333e-ba55-48d9-bc8f-50e2255e18f3', 'quantite': '1 cuillères'}, {'ingredient_id': 'dc57719f-cde2-4187-805b-449107f38c74', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (225029, 'Raclette exotique et autres variantes', 'pomme de terre, oignon, tomate, banane, fromage à raclette, cornichons, champignon, salami, poivron rouge, poivron jaune, pain, lardons, paprika, thym, curry, persil, noix de coco', '30 min', ['Voilà quelques préparations possibles :', '- Raclette exotique', 'Recouvrez le fromage de petits morceaux de bananes, puis saupoudrez de curry ou de flocons de noix de coco.', '- Raclette rustique', 'Empilez de fines rondelles de pomme de terre dans le poêlon, posez le fromage dessus, ajoutez des rondelles d’oignons et des cornichons, puis saupoudrez de paprika.', '- Raclette végétarienne', 'Recouvrez le fromage de champignons et de rondelles d’oignons, puis parsemez de thym.', '- Raclette enragée', 'Recouvrez le fromage de salami et de fines lamelles de poivron, puis parsemez d’oignons avant de déguster.', '- Raclette l’italienne', 'Recouvrez le fromage d’une rondelle de tomate, de lamelles de poivrons rouge et de lardons.', '- Raclette grain de folie', 'Recouvrez le fromage de dés de pain et de rondelles de bananes, puis parsemez de persil.'], ['Fouet', 'Verre doseur', 'Économe'], ['champignon', 'Raclette exotique et autres variantes', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'lardons', 'bon marché', 'tomate', 'paprika', 'rapide', 'plat', 'raclette', 'recette', 'cuisine', 'poivron rouge', 'recettes', 'oignon', 'boisson', 'fromage à raclette', 'dessert', 'persil', 'plat de résistance', 'thym', 'cornichons', 'salami', 'noix de coco', 'pain', 'pomme de terre', 'poivron jaune', 'curry', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:48:52.507360', [{'ingredient_id': 'd0baaed4-4fc0-4756-919f-cd386674c178', 'quantite': '4'}, {'ingredient_id': '0f334431-3686-4537-b8da-00f6d6daa939', 'quantite': '2'}, {'ingredient_id': 'ead799c6-3c99-4fbf-b639-5b61eafdb417', 'quantite': '2'}, {'ingredient_id': 'c9568447-62d9-445b-814e-c0746ce14c76', 'quantite': '2'}, {'ingredient_id': '7fe89826-8c43-448d-b34e-41a9b6f9fd5d', 'quantite': '250 g'}, {'ingredient_id': '58d50ff3-a213-4bd3-a596-39bbfc553e42', 'quantite': '1'}, {'ingredient_id': 'b6d58464-1ab1-40b8-86d1-be0de3453d82', 'quantite': '1'}, {'ingredient_id': '21e971d7-7043-4f8b-833d-10fc889f8a2d', 'quantite': '1'}, {'ingredient_id': '559a5920-1a7b-4464-b76a-d3c6b24dcb6d', 'quantite': '1'}, {'ingredient_id': '4b05c97b-c29d-4b5b-88a1-92617156091a', 'quantite': '1'}, {'ingredient_id': '87e988e2-06ad-4847-8334-f0181474c0d7', 'quantite': ''}, {'ingredient_id': 'f2a44b62-b254-4c8b-ac96-dfa5d7054667', 'quantite': '250 g'}, {'ingredient_id': '7c502c66-e93b-4321-ae24-b80bcae713a1', 'quantite': '50 g'}, {'ingredient_id': '5aeeec53-00e1-493a-8bbd-1955a095d76e', 'quantite': '50 g'}, {'ingredient_id': '46551a06-7999-4e98-bc67-fcd31b8e713a', 'quantite': '50 g'}, {'ingredient_id': 'bc2ab5c2-34d3-407b-aeb3-4081223ac093', 'quantite': '50 g'}, {'ingredient_id': '398f9259-d921-4f4c-b2e6-8f1f36e84a37', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (53882, 'Flan de bananes', 'banane, oeuf, sucre, farine, lait', '15 min', ['Eplucher les bananes et les disposer coupées en rondelles dans un plat en gratin.', 'Préparer une pâte avec les oeufs, le sucre, la farine et le lait.', 'Verser ce mélange sur les bananes, et enfourner pendant 25 min à 180°C (Th 6).', 'Avant la fin de la cuisson, saupoudrer de sucre pour caraméliser le dessus.'], ['Moule à tarte', 'Couteau de chef', 'Casserole', 'Râpe', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'Flan de bananes', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'flan', 'sucre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:48:57.221182', [{'ingredient_id': 'b88e1256-1542-49c1-a77e-ea365b93390c', 'quantite': '4'}, {'ingredient_id': '426dfb5f-44be-4609-bda4-5afbc317473e', 'quantite': '4'}, {'ingredient_id': '358e2169-63bb-4a7f-86ed-392b3674dceb', 'quantite': '200 g'}, {'ingredient_id': '4f55458f-d61c-4fa1-b2bb-2207e221c049', 'quantite': '4 cuillères'}, {'ingredient_id': 'f01eed5d-7ee7-48fd-beb5-c8d635bb9417', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (30256, 'Croustilles bananes et chocolat', 'banane, chocolat pâtissier, pâte filo, sucre, beurre', '10 min', ['Faire fondre une noix de beurre dans une poêle et y faire revenir et dorer les bananes en rondelles, saupoudrées de sucre.', 'Faire fondre le chocolat au micro onde et, séparément, 50g de beurre.', 'Peindre une feuille de filo de beurre, en mettre une autre par dessus et la peindre aussi, plier en 2, peindre, mettre 1/4 des bananes au milieu, des noisettes de chocolat fondu et refermer en 4 en fixant avec du beurre fondu.', 'Répéter l''orération avec les autres et cuire à la poêle dans une noix de beurre, bien faire dorer et servir chaud.'], ['Pince de cuisine', 'Louche'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'pâte filo', 'recette', 'chocolat pâtissier', 'cuisine', 'recettes', 'Croustilles bananes et chocolat', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'sucre', 'cocktail'], 'Dessert', 34b161f7-d353-4a86-bd50-0c26cdf2b9c2, '2025-09-26T15:49:00.823417', [{'ingredient_id': '80f5f447-f1d1-44af-b4ac-bed0fde0ee42', 'quantite': '3'}, {'ingredient_id': '8115a1d2-ada4-45cf-81d6-c504e2bd4e15', 'quantite': '100 g'}, {'ingredient_id': '58fe9edf-4098-4afb-9818-88b247084cdf', 'quantite': '8'}, {'ingredient_id': 'c92f09be-a7c9-4170-bcdc-5abdcb907103', 'quantite': ''}, {'ingredient_id': 'af940878-cd16-45eb-9a5d-025b63f784cf', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (49775, 'Banoffee au verre', 'banane, lait concentré sucré, gâteaux, yaourt', '30 min', ['Après un test raté de banoffee en forme de tarte (des miettes de biscuit partout dans la cuisine), j''ai opté pour une version au verre, beaucoup plus facile à servir.', 'La 1ère étape, si vous avez la patience, est de faire vous même votre toffee (= confiture de lait). ', 'Il suffit de mettre une boîte de lait concentré sucré fermée dans votre cocotte minute, de mettre de l''eau (j''avais pratiquement couvert la boîte), et d''attendre 45 min à 1 h, à partir de la mise sous pression. La cuisson d''1 h donne un toffee assez foncé, cuire un peu moins pour un goût plus léger.', 'Enfin, la methode la plus rapide est d''acheter la confiture de lait toute prête !', 'Après cuisson à la cocotte il faut attendre le complet refroidissement de la boîte avant de l''ouvrir, sinon ça gicle partout!', 'Pendant ce temps là, émiettez les biscuits... Moi, j''ai fait un assortiment fond de placard; l''essentiel est que les biscuits ne soient pas trop sucrés, pour apporter un contraste avec le toffee.', 'Découpez les bananes en rondelles, et citronnez-les pour éviter qu''elles noircissent. ', 'Puis, procédez au montage, dans une coupe ou un verre transparent : 1 couche de miettes de biscuits, 1 couche de toffee, 1 couche de rondelles de bananes, 1 couche de yaourt. ', 'Faire plusieurs couches, suivant la forme du verre.', 'Placer au frais, jusqu''au moment de servir... et dégustez !'], ['Planche à découper', 'Batteur électrique', 'Fouet'], ['', 'entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'lait concentré sucré', 'Banoffee au verre', 'boisson', 'dessert', 'plat de résistance', 'gâteaux', 'cocktail'], 'Dessert', cd1e8657-0741-4bd6-98b4-10edd1f43ef1, '2025-09-26T15:49:04.493235', [{'ingredient_id': '9a651132-262c-44ac-b530-fc5a4a2b94f2', 'quantite': '4'}, {'ingredient_id': '1b95b7a0-f6f5-4eda-b37b-70cbe4175364', 'quantite': '1'}, {'ingredient_id': '3650a245-b970-4822-8833-7181dc71b999', 'quantite': '150 g'}, {'ingredient_id': 'ce598007-a5d8-4caf-842a-85cd6a2c3393', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (219242, 'Pancakes aux bananes', 'banane, oeuf, farine, lait, beurre, sucre en poudre, huile', '10 min', ['Pelez les 3 bananes et écrasez-les à la fourchette. Faites fondre 45 g de beurre.', 'Dans un saladier, battez les œufs en omelette, ajoutez les bananes écrasées. Incorporez la farine en mélangeant bien, puis ajoutez le lait et le beurre fondu.', 'Faites chauffer une petite poêle avec du beurre ou de l''huile et faites cuire la pâte en formant des disques plus ou moins épais.', 'Laissez dorer 2 minutes environ de chaque côté.'], ['Spatule', 'Poêle', 'Économe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'Pancakes aux bananes', 'testées', 'pancake', 'facile', 'bon marché', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'farine', 'dessert', 'plat de résistance', 'beurre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:49:08.124978', [{'ingredient_id': '9c37dba8-ce70-453b-b3dd-ca6598850b2b', 'quantite': '3'}, {'ingredient_id': '9b65616d-f40d-4c23-a02c-987ce6cd4095', 'quantite': '4'}, {'ingredient_id': 'fdb9289e-1607-42dd-b7a0-3e1f93d449ab', 'quantite': '375 g'}, {'ingredient_id': '380a9444-281f-4cde-8a1c-0e2b38bf256a', 'quantite': '75 cl'}, {'ingredient_id': 'aaace150-4a66-4081-8798-72fb8dc01c3b', 'quantite': '75 g'}, {'ingredient_id': '0bfbec9a-f3ca-4145-903d-122046ecf7a4', 'quantite': '15 g'}, {'ingredient_id': '84aead87-8f00-49a5-8720-bcd5405d90de', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (39961, 'Gâteau aux amandes sans oeuf', 'farine, levure, sucre, amandes en poudre, beurre, lait, pêche, banane', '20 min', ['Mélanger la farine, la levure, le sucre et la poudre d''amande dans un saladier. Dans un bol mélanger le lait et le beurre fondu puis les mélanger au reste de la préparation.', 'Vous pouvez y ajouter un ou deux fruits coupés en petits morceaux selon vos envies mais le gateau est aussi bon nature. ', 'Faire cuire à 180°C (thermostat 6) environ 30 minutes, jusqu''à ce que la pointe d''un couteau ressorte propre quand vous la plantez dedans. ', 'Bon ap''!'], ['Balance de cuisine', 'Couteau de chef', 'Fouet', 'Passoire'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'amandes en poudre', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'beurre', 'pêche', 'sucre', 'lait', 'cocktail', 'Gâteau aux amandes sans oeuf'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:49:11.618874', [{'ingredient_id': 'e4c75569-6ced-4bd1-882b-f17237c7fcc0', 'quantite': '250 g'}, {'ingredient_id': '288e56d9-0986-46e4-acb4-c5f2d5cfa253', 'quantite': ''}, {'ingredient_id': '249f358c-274e-4c57-be66-45d61e532c7b', 'quantite': '120 g'}, {'ingredient_id': '3f0d8edc-bb2e-4db1-bc19-c5eff97153b7', 'quantite': '60 g'}, {'ingredient_id': '31f4e85e-63d7-4a64-859b-1b1d8ca96115', 'quantite': '200 g'}, {'ingredient_id': '1ce05398-82a5-4efc-b1f9-c5a38ee91a1f', 'quantite': '1'}, {'ingredient_id': 'c2d8df4c-82e9-4baf-982d-7fd7efc81d22', 'quantite': '1'}, {'ingredient_id': '3a3e163a-9651-47ce-8b86-cc05443613d3', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (43621, 'Crème à la banane (vietnamien)', 'banane, sucre, sel, perles du Japon, lait de coco', '10 min', ['Faire bouillir 3/4 de litre d''eau, avec le lait de coco, le sucre, le sel, et les perles. Faire cuire pendant 3 min.', 'Verser les bananes en rondelles, mélanger jusqu''à ébullition, puis faire cuire 10 min, en remuant tout le temps.', 'Couper le feu, et rajouter la crème de coco (préalablement mise de côté au début de la préparation).', 'Mélanger, et verser dans des ramequins, puis servir très, très frais!'], ['Batteur électrique', 'Tire-bouchon', 'Râpe', 'Moule à tarte', 'Spatule'], ['', 'lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'perles du Japon', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre', 'cocktail', 'Crème à la banane (vietnamien)'], 'Dessert', 735572a5-c32d-4b64-a8ac-e6efc928cb92, '2025-09-26T15:49:15.186670', [{'ingredient_id': '104e9746-354d-47fd-af71-d0f681acbb41', 'quantite': '10'}, {'ingredient_id': 'c13f03b8-2793-41d0-ae1e-e7a07009914a', 'quantite': '200 g'}, {'ingredient_id': '55f31325-d004-42f3-8925-286fd92abcae', 'quantite': '1'}, {'ingredient_id': '047fb181-9dd7-4b26-b29f-7bca38122f7b', 'quantite': '8 cuillères'}, {'ingredient_id': '06ff962e-73a5-4a46-8528-6e87e3d09301', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (382734, 'Smoothie bowl avocat banane', 'banane, avocat, lait, miel', '600 min', ['Mixer deux bananes mûres avec 2 avocats.', 'Ajouter dans le blender 4 cs de lait (animal ou végétal). Vous pouvez en mettre plus ou moins si vous voulez une préparation plus ou moins épaisse.', 'Ajouter 2 cc de miel ou sirop d''agave ou d''érable. Et encore une fois, mixer.', 'Verser le tout dans deux bols.'], ['Mixeur', 'Casserole', 'Poêle'], ['entrée', 'Smoothie bowl avocat banane', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'avocat', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'lait', 'smoothies', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:49:19.683722', [{'ingredient_id': '37c4fbaa-60e8-45d4-b783-0b9d634686c1', 'quantite': '2'}, {'ingredient_id': '52633488-6ea1-4133-96f2-01d66f8c564f', 'quantite': '2'}, {'ingredient_id': '5abc0ed7-a7b0-463a-abb1-c2ca08361b2a', 'quantite': '4 cuillères'}, {'ingredient_id': 'a02a8e86-b99a-4595-8cef-44757e51ccfb', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (173732, 'Muffins aux mûres (végétaliens et sans gluten)', 'maïzena, banane, sirop d''agave, huile d''olive, farine de riz, mûres, bicarbonate, sel', '5 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Laisser décongeler les mûres.', 'Mélanger tous les ingrédients, mixer le tout et ajouter au dernier moment les mûres.', 'Enfourner 12 min.'], ['Presse-agrumes', 'Spatule', 'Balance de cuisine', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'Muffins aux mûres (végétaliens et sans gluten)', 'sel', 'farine de riz', 'confiserie', 'testées', 'très facile', 'maïzena', 'bon marché', 'rapide', 'sirop d''agave', 'plat', 'recette', 'mûres', 'cuisine', 'recettes', 'boisson', 'huile d''olive', 'dessert', 'plat de résistance', 'muffin', 'cocktail', 'bicarbonate'], 'Dessert', a5677764-ba95-4a3d-8513-8aadf9c54f9a, '2025-09-26T15:49:23.276245', [{'ingredient_id': 'd4b825c7-cbdb-4f4b-b935-3627ce773aef', 'quantite': '40 g'}, {'ingredient_id': 'f0dadf0f-ffd9-4f6b-8ecc-944b377755d2', 'quantite': ''}, {'ingredient_id': '643c0549-61e3-431a-8a1f-eb0a8dfc5157', 'quantite': '150 g'}, {'ingredient_id': '1de65a45-c25b-4bb3-b794-3edab76ac228', 'quantite': '30 g'}, {'ingredient_id': '0e56077c-caef-4522-9b25-0e3ed5abcf3b', 'quantite': '60 g'}, {'ingredient_id': '975c30fb-b479-44ee-9842-88b295e51e8c', 'quantite': '70 g'}, {'ingredient_id': 'e360eeae-97a7-4630-9e6e-cac8bce2cadf', 'quantite': ''}, {'ingredient_id': 'be46d9d8-7001-4ae7-b4cf-3208dd84ae5f', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (46392, 'Brownies coco - banane', 'chocolat, beurre, farine, sucre, oeuf, noix de coco rapée, banane', '15 min', ['Préchauffer le four à 150°C (thermostat 5).', 'Faire fondre le chocolat et le beurre au micro-ondes (ou dans une casserole).', 'Pendant ce temps, mélanger les oeufs, la farine, le sucre, la noix de coco.', 'Ajouter le beurre, le chocolat fondu, et la banane coupée en morceaux. Mélanger bien, puis verser dans un plat carré.', 'Mettre au four pendant 20 à 25 min, à 150°C (th 5).', 'Découper le brownies en petites parts, lorsqu''il est froid.'], ['Rouleau à pâtisserie', 'Verre doseur', 'Fouet', 'Économe', 'Ouvre-boîte'], ['Brownies coco - banane', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'brownie', 'chocolat', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'noix de coco rapée', 'dessert', 'plat de résistance', 'beurre', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:49:27.445758', [{'ingredient_id': '45323eda-97a7-4d3b-b963-1d6e5d6edbee', 'quantite': '200 g'}, {'ingredient_id': '48c1cfbc-6ae4-412b-b775-8c7b225dcab8', 'quantite': '60 g'}, {'ingredient_id': '2a5f61d6-02eb-456e-bce7-07d90bd11cb0', 'quantite': '30 g'}, {'ingredient_id': '5d4ba3cc-f071-4431-a834-ab4dc28e79df', 'quantite': '50 g'}, {'ingredient_id': '6cf50b53-07fe-49f0-9256-5005d4ea776f', 'quantite': '2'}, {'ingredient_id': '081bf1b4-252b-4676-bd8c-ad3d4c4c1b55', 'quantite': '30 g'}, {'ingredient_id': 'c3f6f779-f796-442c-bbf3-118d30a44a6c', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (57920, 'Concombre bana-chèvre', 'concombre, banane, fromage de chèvre, feuilles de coriandre, miel liquide', '10 min', ['Eplucher le concombre et le râper (pas trop fin).', 'Ajouter le fromage de chèvre, la banane et le miel puis écraser avec une fourchette.', 'Hacher la coriandre (dans un verre avec des ciseaux, c''est très pratique).', 'Mélanger le tout.', 'Assaisonner à votre convenance.'], ['Économe', 'Rouleau à pâtisserie', 'Passoire'], ['', 'miel liquide', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'fromage de chèvre', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'Concombre bana-chèvre', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'feuilles de coriandre', 'concombre', 'cocktail'], 'Entrée', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:49:32.340255', [{'ingredient_id': 'a1e6c43e-8ca0-4fa1-a6e7-5cece7e1a898', 'quantite': '1'}, {'ingredient_id': '10d1b9a1-5081-42b3-9306-56378f2b1e4e', 'quantite': '1'}, {'ingredient_id': 'a7c5e28c-3bbf-4677-9208-25bf4e6d4e99', 'quantite': '80 g'}, {'ingredient_id': 'fc027522-dfa7-4f69-b4cb-0af202003601', 'quantite': ''}, {'ingredient_id': 'e2de9d3b-b079-4673-a8e7-da614e73bad4', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (32604, 'Crumble Chobaba', 'banane, chocolat, beurre, gâteaux, farine, beurre, sucre', '15 min', ['Parsemer 25 g de beurre coupé en morceaux sur le fond d''un plat à gratin de 30 cm x 15 cm.', 'Couvrir avec 3 bananes épluchées et coupées en rondelles moyennes (un demi centimètre!).', 'Répartir le paquet de pépites de chocolat sur les bananes puis recouvrir avec les 3 bananes restantes en rondelles.', 'Préparer les miettes à crumble en mélangeant puis en effritant entre les doigts la farine,le sucre, les bastognes écrasés et les 100g de beurre en pommade.', 'Répartir sur le mélange banane/chocolat, enfourner four thermostat 6 pendant 30 minutes environ.', 'Le crumble est prêt lorsque les miettes sont dures et couleur brun pain d''épice.'], ['Verre doseur', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'autres crumbles', 'beurre', 'Crumble Chobaba', 'cocktail'], 'Dessert', 8d6073e1-5b0f-45e1-aef1-4d592cf130d0, '2025-09-26T15:49:36.053910', [{'ingredient_id': 'c099440d-8295-4a44-bf0c-b2f40bf4adb4', 'quantite': '6'}, {'ingredient_id': '43bb413c-72ca-433e-a7da-9388652bf692', 'quantite': '1'}, {'ingredient_id': 'cbf6f988-a769-4d49-bc47-d14edba19949', 'quantite': '50 g'}, {'ingredient_id': 'ed791373-756e-44f6-a6f2-3705b9def9ad', 'quantite': ''}, {'ingredient_id': 'd1a0edb4-b52c-4691-854a-f5d6bbf3c529', 'quantite': '100 g'}, {'ingredient_id': '164cca22-f3cf-4f30-858e-737132e151a5', 'quantite': '100 g'}, {'ingredient_id': '18e5bfe8-135d-45a3-aefd-6bde62a58648', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (11750, 'Poulet à la banane', 'ananas, banane, pâte de curry, crème fraîche, blanc de poulet', '20 min', ['Faire revenir les blancs de poulet émincés dans un peu d''huile puis ajouter le jus d''ananas.', 'Ajouter l''ananas coupé en morceaux.', 'Délayer la pâte de curry dans la crème fraiche puis verser sur le poulet en fin de cuisson.', 'Au moment de servir, ajouter des rondelles de banane crue et froide.', 'Servir avec du riz créole.'], ['Batteur électrique', 'Tire-bouchon', 'Râpe'], ['', 'pâte de curry', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'plat', 'blanc de poulet', 'moyenne', 'recette', 'cuisine', 'recettes', 'boisson', 'Poulet à la banane', 'dessert', 'plat de résistance', 'moyen', 'ananas', 'cocktail'], 'Plat principal', 7b50d671-dfa5-49eb-9a9c-3fc9717a1457, '2025-09-26T15:49:39.785340', [{'ingredient_id': '42f65b5e-ebaa-48ce-8308-01159dbd829b', 'quantite': '340 g'}, {'ingredient_id': 'fa5b669a-023d-4b7f-a0e3-d2d1f083f951', 'quantite': '2'}, {'ingredient_id': '08a78e38-311f-4435-9730-28fc6205565d', 'quantite': '2 cuillères'}, {'ingredient_id': '00f77965-cdde-46f3-ad95-e02a771f2c27', 'quantite': ''}, {'ingredient_id': 'ad0b276f-0f71-4157-9431-14d0389fd4a8', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (370799, 'Banana Split flambé au Pastis', 'banane, pastis, noisettes, glace au chocolat, sucre vanillé, nappage chocolat', '10 min', ['Coupez les bananes en 2 dans le sens de la longueur. ', 'Dans une poêle faire revenir les bananes avec un peu de beurre fondu à feu moyen.', 'Lorsque les bananes sont dorées, ajoutez le sucre vanillé. Laisser caraméliser.', 'Faites fondre au bain-marie le chocolat.', 'Verser le pastis sur le dessus des bananes et faire flamber. Quand les flammes sont éteintes, mettre chaque banane dans un plat, y placer une boule de glace, et napper de chocolat.'], ['Presse-agrumes', 'Tire-bouchon', 'Rouleau à pâtisserie', 'Moule à tarte', 'Planche à découper'], ['Banana Split flambé au Pastis', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'banana split', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'noisettes', 'pastis', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'nappage chocolat', 'glace au chocolat', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:49:43.845268', [{'ingredient_id': 'db40c7c5-0f11-4085-bd83-43845b1f0e97', 'quantite': '2'}, {'ingredient_id': 'ca43339d-bd2a-4d3b-b80b-297a95b6833d', 'quantite': '1'}, {'ingredient_id': '20826390-5149-47df-9bcc-bb9f3ffadd78', 'quantite': '1'}, {'ingredient_id': '82e57378-b74a-4679-8016-81dbec35b10d', 'quantite': '2'}, {'ingredient_id': 'b02c7953-7e52-4d40-904b-9c2dadbb8f75', 'quantite': '1'}, {'ingredient_id': '176a9323-bad7-4873-8fbc-b703284d427a', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (308998, 'Tarte façon brownie bananes chocolat pécan', 'farine, beurre, sucre, lait, sel, banane, cognac, beurre, cerneaux de noix de pécan, chocolat pâtissier, sucre, farine, oeuf, beurre', '20 min', ['C''est une tarte qui se prépare en 3 grandes étapes :', 'Préparation de la pâte brisée :', 'Mélanger la farine, le sucre et le sel puis y ajouter le beurre en pommade. ', 'Malaxer le tout avec les doigts pour obtenir un conglomérat grossier. ', 'Ajouter au final 5 cl de lait tiède (très peu en somme) pour lier le tout et obtenir une belle boule de pâte.', 'Étaler la pâte, la mettre dans le plat et la cuire à blanc dans au four à 180°C pendant 10 min environ. La pâte doit être cuite mais pas roussie car elle va repasser au four avec le fond et l’appareil à la fin.', 'Préparation du fond bananes et noix de pécan :', 'Découper les deux bananes en rondelles et les déposer dans une poêle. Y ajouter une noix de beurre et 2 cuillères à soupe de cognac. Faire revenir les rondelles de bananes. Vigilance, car elles doivent être cuites sans pour autant qu’elles ne deviennent de la purée de bananes ! Maintenant concasser grossièrement les noix de pécan et répartir l’ensemble en fond de tarte sur la pâte.', 'Préparation de l’appareil chocolat façon brownies :', 'Faire fondre le chocolat dans une casserole avec un peu de lait à feu doux.', 'Battre les oeufs avec le sucre. Y ajouter le beurre en pommade (ou légèrement fondu au micro-ondes) puis la farine petit à petit en continuant de battre au fouet.', 'Ajouter le chocolat fondu au fur et à mesure à la préparation.', 'Au final, verser l’appareil sur le fond de tarte. ', 'Et mettre la tarte au four à 150°C pour environ 30 minutes. ', 'La tarte est cuite quand le dessus est craquelé et l’intérieur encore fondant.'], ['Louche', 'Batteur électrique', 'Passoire', 'Poêle', 'Balance de cuisine'], ['entrée', 'tarte au chocolat', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'facile', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'Tarte façon brownie bananes chocolat pécan', 'moyen', 'beurre', 'sucre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:49:49.445016', [{'ingredient_id': 'ff974e62-a0cd-4c33-8472-d9451d0ac9a0', 'quantite': '200 g'}, {'ingredient_id': '14c2ad31-94aa-4e0d-8b5e-56f00442520c', 'quantite': '100 g'}, {'ingredient_id': '43b9b100-af40-4528-8a32-00cf12963fd9', 'quantite': '2 cuillères'}, {'ingredient_id': '4f444248-9f1c-4e34-be1e-8974f61b67ea', 'quantite': '5 cl'}, {'ingredient_id': '0bfd3d54-86a2-4612-ae3c-b7109af04f7c', 'quantite': '2'}, {'ingredient_id': 'fa1cb9c8-bbdc-4524-8b24-4fba0d27cac5', 'quantite': '2'}, {'ingredient_id': '8a2c84a9-891a-4ead-b822-0fc46e3ac9d0', 'quantite': '2 cuillères'}, {'ingredient_id': '5e2f1189-cd88-4019-b2c7-bfa00e5a45c0', 'quantite': '1'}, {'ingredient_id': '046ae273-68de-4f7a-b2db-7ee506d964ed', 'quantite': '50 g'}, {'ingredient_id': '80a67fcb-a645-4fcb-93d9-4993db76297b', 'quantite': '150 g'}, {'ingredient_id': '1f85a6fd-c115-471d-a936-43e761ade7ed', 'quantite': '90 g'}, {'ingredient_id': '7677fff2-de9e-4222-96d5-39d2ddc2322a', 'quantite': '50 g'}, {'ingredient_id': '75f0b2a0-8843-47a8-a7e0-8e9d2d32e41a', 'quantite': '2'}, {'ingredient_id': '27184fdd-a47f-4933-b4ff-2772a1c6262b', 'quantite': '90 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (165542, 'milkshake choco-banane', 'banane, sucre en poudre, lait, glaçons, sucre vanillé, crème dessert au chocolat, chocolat en poudre', '10 min', ['Mettre la banane avec les glaçons dans un mixeur et mixer pendant 1 minute.', 'Ajouter le sucre vanillé, le sucre en poudre et un peu de lait.', 'Mixer à nouveau pendant 1 min. Compléter ensuite avec le lait restant et le chocolat.', 'Dès que l''on obtient une belle mousse, c''est prêt !', 'Une fois servie vous pourrez flattez vos papilles mais aussi vos pupilles aux deux niveaux de couleurs dans votre verre'], ['Ouvre-boîte', 'Mixeur', 'Spatule'], ['', 'milkshake choco-banane', 'banane', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'glaçons', 'crème dessert au chocolat', 'lait', 'chocolat en poudre', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:49:54.795335', [{'ingredient_id': 'c9a8e7af-3955-4e82-ac5d-8a411c564502', 'quantite': '1'}, {'ingredient_id': 'bbcdc736-6317-4980-99cb-ae5d39ba62e6', 'quantite': '2 cuillères'}, {'ingredient_id': 'db46e557-b7c8-4b14-8ee7-6f49b470db3f', 'quantite': ''}, {'ingredient_id': 'a51f5ab1-10c1-4e14-a6ab-396a01d59ece', 'quantite': '2'}, {'ingredient_id': 'a7bdbaa7-9db4-463e-a3db-591f81697940', 'quantite': '1'}, {'ingredient_id': 'e1436604-cdde-4abe-97c4-7d115d1b3ecb', 'quantite': '100 g'}, {'ingredient_id': '3487812c-9a4b-4082-aba9-92eefcfa334d', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (197565, 'Poulet braisé et bananes plantains', 'banane plantain, oignon, tomate, bouillon, cuisse de poulet, huile, ail, échalote, citron vert, piment, thym, basilic, poivre, sel, moutarde à l''ancienne', '20 min', ['La veille, faites mariner les cuisses dans un mélange de jus de citron, d''ail écrasé, d''échalotes émincées, de thym, basilic, sel, poivre, de piment, moutarde, et du bouillon.', 'Le jour même, épluchez les bananes, puis coupez-les en rondelles.', 'Épluchez les oignons et coupez-les en dés. ', 'Coupez également les tomates en dés. ', 'Faites frire les bananes. ', 'A part dans une poêle, ajoutez le poulet, les oignons et les tomates et ainsi que les cubes de bouillon jusqu’à se que cela cuisse.', 'Faites griller le tout sous le gril du four ou sur le barbecue jusqu''à ce que les morceaux soient cuits et bien dorés.'], ['Couteau de chef', 'Verre doseur', 'Économe', 'Poêle'], ['', 'entrée', 'recettes de cuisine', 'Poulet braisé et bananes plantains', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'tomate', 'ail', 'plat', 'basilic', 'bouillon', 'recette', 'piment', 'cuisine', 'cuisse de poulet', 'recettes', 'oignon', 'boisson', 'huile', 'dessert', 'plat de résistance', 'banane plantain', 'thym', 'citron vert', 'poivre', 'moutarde à l''ancienne', 'cocktail', 'échalote'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:50:00.424708', [{'ingredient_id': 'e3e14dcc-bbf8-46ca-af5a-fc9b745b1a80', 'quantite': '18'}, {'ingredient_id': '31131d9e-7e0f-4832-b611-40356188660b', 'quantite': '15'}, {'ingredient_id': '3263c6c6-4968-4059-9658-57842c7206d9', 'quantite': '17'}, {'ingredient_id': '435a90f5-5308-41dd-ab4f-e1f5b24b73f9', 'quantite': '2'}, {'ingredient_id': 'c37e7422-ed8c-4cc2-8b4d-1019e089a0cd', 'quantite': '6'}, {'ingredient_id': '097c1ded-003f-4fbb-ab67-96a1040d5bea', 'quantite': ''}, {'ingredient_id': '5e76d258-bae3-47b5-8e3a-e54f30584575', 'quantite': '5'}, {'ingredient_id': 'b42d42ff-bb51-4145-a1e7-8e57710a0e57', 'quantite': '3'}, {'ingredient_id': 'd60b8604-4450-4f85-b2ba-445b637da9c6', 'quantite': '2'}, {'ingredient_id': '38a38df8-51b0-4236-bbe9-6b39ab5efa2d', 'quantite': '1'}, {'ingredient_id': 'a26d27af-042a-4f63-8b6c-cdc3a566f29d', 'quantite': ''}, {'ingredient_id': '4a47c329-b676-4290-b2bf-c7d9b28c9b7c', 'quantite': ''}, {'ingredient_id': '32903cba-f640-4ead-80ab-1fa3fe90bc07', 'quantite': ''}, {'ingredient_id': '26c6401b-2e98-4406-8691-fdabee1f3886', 'quantite': ''}, {'ingredient_id': 'fa1942b2-ddc7-44a6-b280-62ee7e982f80', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (13808, 'Banane caramélisée', 'banane, beurre, jus de citron, sucre', '5 min', ['Couper la banane en 2 dans le sens de la longueur,', 'faire fondre le beurre dans la poêle, diposer les 2 tranches de banane à plat.', 'Saupoudrer de sucre, ajouter le jus de citron ,', 'puis faire cuire au four (180°C) jusqu''à ce que la banane caramélise et devienne molle.'], ['Mixeur', 'Râpe', 'Casserole', 'Ouvre-boîte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'Banane caramélisée', 'boisson', 'dessert', 'plat de résistance', 'jus de citron', 'beurre', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:50:05.039421', [{'ingredient_id': 'f41a25af-6aa5-44f5-9238-023c8172e660', 'quantite': '1'}, {'ingredient_id': '6b8a0d6d-729b-41c9-8221-7a26aebf9c63', 'quantite': ''}, {'ingredient_id': '5cd641af-1f31-4f3a-b05e-bf6032ca27eb', 'quantite': '1'}, {'ingredient_id': 'bbe37b41-b875-478e-b88d-14d9a0b649ab', 'quantite': '30 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (342743, 'Bananes gourmandes (chocolat, chantilly et cookie)', 'banane, crème anglaise, cookie, crème chantilly, amandes effilées, nappage chocolat', '5 min', ['Peler les bananes, les couper en fines rondelles, réserver.', 'Dans une verrine ou un ramequin assez large, mélanger la crème anglaise avec un peu de chantilly.', 'Y incorporer le cookie cassé en morceaux, les amandes, puis les bananes.', 'Terminer avec de la chantilly et le nappage chocolat.'], ['Spatule', 'Planche à découper', 'Casserole', 'Pince de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'cookie', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'crème chantilly', 'chantilly et cookie)', 'dessert', 'plat de résistance', 'nappage chocolat', 'amandes effilées', 'cocktail', 'crème anglaise', 'Bananes gourmandes (chocolat'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:50:10.473652', [{'ingredient_id': '51ad5426-949f-4f8e-a8ae-e080108ef5be', 'quantite': '1'}, {'ingredient_id': '0ef34eff-ed59-4d90-9629-df277a23fbb6', 'quantite': '1 cuillères'}, {'ingredient_id': 'b07acb28-1829-48e0-b12a-3239780f6337', 'quantite': ''}, {'ingredient_id': '0eaf6233-525e-4dd9-97f0-41c9cd82e600', 'quantite': '1 cuillères'}, {'ingredient_id': '042c3f48-dd0f-4b7e-8c65-70b0a9592aab', 'quantite': '1 cuillères'}, {'ingredient_id': '5cfc00d5-5355-4e55-8df9-aba1990b8f55', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (38264, 'Poulet sauté aux fruits', 'filet de poulet, orange, kiwi, banane, miel, poivre, sel, huile d''olive', '15 min', ['Couper les filets de poulet en morceaux et les laisser mariner quelques instants dans un peu d''huile d''olive, du sel et du poivre.', 'Eplucher 2 oranges et en prélever la chair. Eplucher les 2 kiwis. Couper tous ces fruits en dés.', 'Faire sauter les morceaux de poulet, par exemple dans un wok, sans ajouter de matière grasse. Lorsqu''ils sont bien dorés, les retirer et déglacer avec le jus des 2 autres oranges. ', 'Ajouter une bonne cuillère à soupe de miel, les dés de kiwi et d''orange ainsi que le poulet. Laisser mijoter quelques minutes. Bien assaisonner.', 'Au dernier moment ajouter enfin les rondelles de banane, cela évitera qu''elles ne noircissent.', 'Servir ce plat avec du riz.', 'Bon appétit!'], ['Balance de cuisine', 'Fouet', 'Pince de cuisine', 'Mixeur', 'Poêle'], ['entrée', 'banane', 'kiwi', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'filet de poulet', 'très facile', 'Poulet sauté aux fruits', 'bon marché', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'huile d''olive', 'sauté de volaille', 'dessert', 'plat de résistance', 'orange', 'poivre', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:50:15.844178', [{'ingredient_id': 'ee5f1b26-cba2-4165-823b-77f3a27d8720', 'quantite': '4'}, {'ingredient_id': 'cecd1226-bcf6-4c71-b32e-ef48c510f3c1', 'quantite': '4'}, {'ingredient_id': '7e6c8c4a-4539-41c4-a735-5268f1d17d97', 'quantite': '2'}, {'ingredient_id': 'c29d3ebb-5e93-4617-8797-1071b2e7c002', 'quantite': '2'}, {'ingredient_id': 'd3e3dc8a-1754-4ab9-9009-08457239ecf3', 'quantite': ''}, {'ingredient_id': 'def31733-59e5-4dee-a797-eeb997bd63cb', 'quantite': ''}, {'ingredient_id': '368ca112-c393-4394-8c87-58d588f92ac7', 'quantite': ''}, {'ingredient_id': '7cce1d73-f532-4a77-aa0d-9d23ea87e8c6', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (13380, 'Confiture de bananes à l''orange', 'banane, jus d''orange, sucre, jus de citron', '20 min', ['Couper les bananes en tranches, ajouter le sucre et les jus de citrons et d''oranges et faire bouillir doucement en remuant de temps en temps (pour que le mélange ne prenne pas au fond) jusqu''à ce qu'' il épaississe et devienne d''une belle couleur rouge. ', 'Mettre en pots et couvrir.'], ['Rouleau à pâtisserie', 'Fouet', 'Louche', 'Moule à tarte', 'Pince de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'jus de citron', 'Confiture de bananes à l''orange', 'jus d''orange', 'sucre', 'cocktail', 'confiture d''orange'], 'Confiserie', 19671005-0754-48d0-88d8-9bf02e44e8f9, '2025-09-26T15:50:19.474434', [{'ingredient_id': 'dbf53ab8-d79a-4cd1-86c6-c90f71adffd3', 'quantite': '500 g'}, {'ingredient_id': '09fc0a99-7658-4d20-87d7-18cd3dec8458', 'quantite': '4'}, {'ingredient_id': 'f3ba8089-90b1-41d6-8331-dd2a84165fb1', 'quantite': '350 g'}, {'ingredient_id': '85d3773d-048f-4022-a440-ecd55ded3c5a', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (307777, 'Tarte aux fraises et à la banane', 'pâte sablée, fraises, banane, lait, oeuf, farine, sucre, sucre vanillé', '15 min', ['Commencez par préchauffer votre four à 150°C.', 'Insérer votre pâte sablée dans un plat à tarte puis dans le four (pour précuire la pâte afin d''éviter d''avoir un dessous de mou). ', 'Laisser votre pâte entre 5 et 10 min puis sortez-la du four. ', 'Pendant ce temps la, coupez vos fraises en deux, ainsi que vos bananes en rondelles.', 'Pour la crème pâtissière : ', 'Mettre le lait à bouillir. ', 'Travailler l’œuf avec le sucre jusqu''à ce que la pâte devienne homogène, ajouter la farine. ', 'Verser le lait bouillant sur le mélange en tournant bien. ', 'Remettre dans la casserole sur le feu. ', 'Faire cuire en tournant très soigneusement. ', 'Retirer après ébullition. ', 'Verser la crème sur le fond de tarte et disposer joliment les fraises et les bananes.', 'Il est possible de réserver le tout au réfrigérateur ou de consommer tout de suite !'], ['Ouvre-boîte', 'Couteau de chef', 'Poêle', 'Spatule', 'Fouet'], ['entrée', 'Tarte aux fraises et à la banane', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'pâte sablée', 'rapide', 'oeuf', 'plat', 'fraises', 'recette', 'cuisine', 'tarte aux fraises', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'lait', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:50:23.123151', [{'ingredient_id': '1a3ad12f-3bc3-4e35-b235-80260a6ff265', 'quantite': '1'}, {'ingredient_id': 'd77828a0-115a-4885-87a8-7b1aa53e450a', 'quantite': '250 g'}, {'ingredient_id': 'f5d3e592-17e0-4ad2-ba24-a59caaec5223', 'quantite': '2'}, {'ingredient_id': 'a457e0c8-7bf4-4e72-82ed-f91a3f76438a', 'quantite': '25 cl'}, {'ingredient_id': 'dccb576b-0447-429e-b57d-9a0075c91662', 'quantite': '1'}, {'ingredient_id': 'edf214cf-b880-48f6-8d86-6d7f0caa1620', 'quantite': '30 g'}, {'ingredient_id': '37156a03-920b-4b9f-9133-7b91cca7c2aa', 'quantite': '40 g'}, {'ingredient_id': '0c7d65e3-45bc-4fbe-957d-216dc709dae9', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (36976, 'Milk shake light', 'lait concentré non sucré, banane, glaçons, aspartame', '5 min', ['Mettre tous les glaçons dans le mixeur.', 'Arroser des autres ingrédients choisis (le lait + le parfum + l''aspartame).', 'Mixer jusqu''à ce que les glaçons soient bien réduits (il ne faut plus entendre de bongs contre le bol mais il faut quand même laisser quelques paillettes de glaçons, sinon cela fondra trop vite). Compter 1 minute environ.', 'Verser dans un grand verre avec une cuiller longue et une paille (mais attention aux gros glaçons tombés au fond du verre et qui vont venir boucher la paille :o)'], ['Balance de cuisine', 'Pince de cuisine', 'Fouet', 'Verre doseur', 'Rouleau à pâtisserie'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Milk shake light', 'dessert', 'plat de résistance', 'glaçons', 'lait concentré non sucré', 'aspartame', 'cocktail'], 'Boisson', 0142707c-bafb-467a-9200-5b25a54b6b0b, '2025-09-26T15:50:26.690504', [{'ingredient_id': 'a927ada6-b8c3-41f6-8848-34662a7b3f8e', 'quantite': '1'}, {'ingredient_id': 'ce83c596-4cb7-43f6-956a-d2f31001c3d0', 'quantite': '1'}, {'ingredient_id': '29f4d7b6-7c64-4908-ae00-d362df2be813', 'quantite': '1'}, {'ingredient_id': '79107055-55ed-4a9b-8e86-6ea59c5b8041', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (52749, 'Bananes au citron', 'banane, sucre vanillé, citron', '5 min', ['Couper les bananes en rondelles et les mettre dans un bol.', 'Les arroser de jus de citron et saupoudrer de sucre vanillé.', 'Remuer avec précaution et déguster.'], ['Mixeur', 'Moule à tarte', 'Couteau de chef', 'Rouleau à pâtisserie', 'Poêle'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Bananes au citron', 'sucre vanillé', 'citron', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:50:30.301126', [{'ingredient_id': '5fe5f50c-47a8-48da-b46d-6cae2382eba3', 'quantite': '4'}, {'ingredient_id': '005f2910-81e3-4247-ae59-6ba8cfd1f419', 'quantite': '1'}, {'ingredient_id': 'f8e0b56f-18dc-4ca0-a74d-845af69c6e88', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (171059, 'Tarte banane chocolat au lait concentré sucré', 'pâte sablée, chocolat pâtissier, banane, beurre, lait concentré sucré, citron, gélatine', '20 min', ['Cuire la pâte sablée.', 'Écraser les bananes avec les 2/3 du lait concentré et le jus d''1/2 citron.', 'Tremper les feuilles de gélatine dans de l''eau froide jusqu''à ce qu''elles soient ramollies, les essorer et les faire fondre avec le reste du jus de citron au micro-ondes (par tranche de 15 secondes) jusqu''à ce qu''elles aient fondu.', 'Mélanger à la préparation bananes-citron.', 'Verser cette préparation sur la pâte et mettre 1h au frigo.', 'Faire fondre le chocolat avec le tiers de lait concentré restant et le beurre dans une casserole, jusqu''à obtention d''une pâte onctueuse.', 'Verser sur la préparation figée.', 'Laisser reposer minimum 2h au frigo.', 'A déguster froid.'], ['Rouleau à pâtisserie', 'Casserole', 'Balance de cuisine', 'Couteau de chef', 'Râpe'], ['entrée', 'tarte au chocolat', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'pâte sablée', 'Tarte banane chocolat au lait concentré sucré', 'rapide', 'plat', 'recette', 'chocolat pâtissier', 'cuisine', 'recettes', 'lait concentré sucré', 'boisson', 'dessert', 'plat de résistance', 'citron', 'gélatine', 'beurre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:50:33.930042', [{'ingredient_id': 'bca44f8e-d469-4859-b086-633ba783bb63', 'quantite': '1'}, {'ingredient_id': '8f7f0ccf-7e0a-48b9-8ea1-d64057be6eb1', 'quantite': '150 g'}, {'ingredient_id': '48e29c12-77f6-487c-b3c8-bc3525bdb4b3', 'quantite': '3'}, {'ingredient_id': '9d618b23-03dc-4ffe-b825-009888356da9', 'quantite': '25 g'}, {'ingredient_id': '900a8721-f4af-4428-9d63-d11e5bc957e7', 'quantite': '1'}, {'ingredient_id': '69bd001d-d13c-4a50-be53-1e9ec237a654', 'quantite': ''}, {'ingredient_id': '8879cff3-6168-476f-8ec1-252e75c39220', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (211499, 'Crème banane-kiwi-chocolat', 'oeuf, sucre, maïzena, lait, banane, kiwi, chocolat noir', '20 min', ['Pour la crème à la banane :', 'Faire chauffer 1/2 l de lait avec la banane préalablement découpée en rondelles.', 'Dans une casserole, mélanger 1 œuf, 50 g de sucre et 1 cuillerée à soupe de maïzena.', 'Verser ensuite 1/3 du lait chaud dans la casserole et fouetter énergiquement puis verser le reste et fouetter.', 'Remettre sur le feu en remuant jusqu''à ébullition et répartir ensuite dans 6 verres (ou ramequins).', 'Sur la crème à la banane, répartir les 2 kiwis épluchés, coupés en petits morceaux.', 'Pour la crème au chocolat :', 'Faire chauffer 1/2 l de lait avec 8 carrés de chocolat.', 'Dans une casserole, mélanger 1 œuf, le reste de sucre et 1 cuillerée de maïzena.', 'Verser 1/3 du lait chaud et fouetter et refaire la même chose que pour la crème à la banane.', 'Laisser refroidir et mettre au frais plusieurs heures.'], ['Louche', 'Passoire'], ['entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'maïzena', 'bon marché', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'crème au chocolat', 'chocolat noir', 'sucre', 'lait', 'cocktail', 'Crème banane-kiwi-chocolat'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:50:37.496543', [{'ingredient_id': 'c00419e2-fafe-4de2-8d5d-c5df46078d4a', 'quantite': '2'}, {'ingredient_id': 'd7931489-05be-49b8-885d-1ae1a250a6d5', 'quantite': '100 g'}, {'ingredient_id': '80e92032-7797-4a34-9678-1de5a94e1679', 'quantite': '3 cuillères'}, {'ingredient_id': '8caa6899-d24e-4210-9453-a0eb1e874ece', 'quantite': '1 l'}, {'ingredient_id': '3c7abf87-2ff2-4fde-9dbe-114d9ae56407', 'quantite': '1'}, {'ingredient_id': 'd806690f-d864-494a-8924-bba757d5eecc', 'quantite': '2'}, {'ingredient_id': '5c333832-453f-4aa0-a912-d10b8473af59', 'quantite': '8'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (59889, 'Flan de brousse à la banane', 'brousse, oeuf, banane, sucre, rhum, caramel, cannelle', '5 min', ['Préchauffer le four à 180°C (themostat 6).', 'Verser le caramel dans un moule, réserver au congélateur.', 'Peler les bananes, les couper en rondelles.', 'Mixer tous les ingrédients jusqu''à obtention d''une crème lisse.', 'Verser dans le moule, cuire au bain marie (en placant le moule dans un moule plus grand rempli d''eau) au four environ 35 min.', 'Laisser refroidir puis réserver au réfrigérateur au moins 2 h.', 'Démouler puis servir.'], ['Pince de cuisine', 'Passoire', 'Économe'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'Flan de brousse à la banane', 'très facile', 'caramel', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'brousse', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'flan', 'cannelle', 'sucre', 'cocktail'], 'Dessert', 7dea048d-fa5e-4ba7-b52f-f36665327e1a, '2025-09-26T15:50:41.225657', [{'ingredient_id': '0d93af30-006a-4daa-9955-686084601bc6', 'quantite': '250 g'}, {'ingredient_id': '98c57055-3a67-42dd-a68b-d80434efb713', 'quantite': '2'}, {'ingredient_id': '3329b543-2f0f-48f8-9f9f-61d62e939c60', 'quantite': '2'}, {'ingredient_id': 'f7631c71-fb4d-4d8c-a54e-5d3e2071835e', 'quantite': '100 g'}, {'ingredient_id': '6601bbe3-8333-4726-9f1e-7a3053e72c42', 'quantite': '1 cuillères'}, {'ingredient_id': 'd0614f81-3c0f-44e2-b80a-d21a4255fbe3', 'quantite': ''}, {'ingredient_id': 'b18e1e90-1bb0-4722-a839-e760b6f93722', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (63269, 'Cake du petit-déjeuner banane-chocolat', 'farine, levure chimique, cassonade, oeuf, beurre, banane, chocolat, cardamome, lait', '15 min', ['Préchauffer le four à 220°C (thermostat 7).', 'Dans un saladier, mélanger la farine, la levure, la cassonade, l''oeuf, le beurre, la banane coupée en petits dés, le chocolat coupés en pépites, le lait et la cardamome.', 'Verser dans un plat à cake souple de préférence et enfourner pour 30 minutes.', 'Au bout de ce temps, la pointe du couteau plantée dans le cake doit ressortir sèche !'], ['Économe', 'Mixeur', 'Râpe', 'Casserole'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'cassonade', 'levure chimique', 'chocolat', 'très facile', 'bon marché', 'cardamome', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'autres cakes', 'dessert', 'plat de résistance', 'beurre', 'lait', 'cocktail', 'Cake du petit-déjeuner banane-chocolat'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:50:46.052286', [{'ingredient_id': '5898ddbe-9a26-4749-be40-36e146c5300c', 'quantite': '180 g'}, {'ingredient_id': '9b52fef3-8176-4231-bd71-485b6e5fad2b', 'quantite': ''}, {'ingredient_id': '693b741e-5f2b-40fc-9458-9fbbf961b4de', 'quantite': '70 g'}, {'ingredient_id': '6dd79910-1cbe-46db-b5a9-7deb2061867c', 'quantite': '1'}, {'ingredient_id': 'c5886508-4867-4f76-97e0-770e864b1125', 'quantite': '20 g'}, {'ingredient_id': 'e8485533-e628-492b-b635-f91dae932607', 'quantite': '1'}, {'ingredient_id': '78a1db5e-8e8e-4d4d-bda6-4ac7318663bb', 'quantite': '40 g'}, {'ingredient_id': '41b6df0f-dc8b-456b-b205-336c6801e65f', 'quantite': '1'}, {'ingredient_id': '5ad1902d-9683-4e60-bb85-e7482c2e1a1a', 'quantite': '60 ml'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (13113, 'Poulet aux fruits', 'poulet, oignon, banane, pomme, curry, citron, vin blanc sec, crème fraîche, chutney, riz', '15 min', ['Faire revenir le poulet en morceaux sans la peau.', 'Faire fondre l''oignon émincé.', 'Ajouter la banane écrasée, la pomme émincée.', 'Saler, poivrer.', 'Ajouter le curry, le jus de citron, le vin blanc, 2 cuil. à soupe de crème fraîche.', 'Faire mijoter 1h 1/4.', 'Au moment de servir, ajouter le reste de crème fraîche.', 'Servir avec du riz ou de la purée et du chutney de mangue si vous en avez !'], ['Balance de cuisine', 'Mixeur', 'Poêle', 'Pince de cuisine'], ['', 'poulet', 'banane', 'entrée', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'très facile', 'plat', 'Poulet aux fruits', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'vin blanc sec', 'dessert', 'plat de résistance', 'riz', 'pomme', 'moyen', 'citron', 'curry', 'cocktail', 'chutney'], 'Plat principal', 4f7f4393-37f8-4562-bc49-d9c492aef915, '2025-09-26T15:50:49.683244', [{'ingredient_id': '17ae2f93-024b-4626-96fc-0ecae83ebb10', 'quantite': '1'}, {'ingredient_id': '51bd0fa0-2c7b-4e15-8da1-522eb88247aa', 'quantite': '1'}, {'ingredient_id': '6fdc9f2e-4666-477b-a438-eba6eeb9ab82', 'quantite': '1'}, {'ingredient_id': 'ea717e54-af2e-410a-b970-5d84355b6ba8', 'quantite': '1'}, {'ingredient_id': '8285a58b-9ad6-485e-8577-f6c965ff3d40', 'quantite': '4 cuillères'}, {'ingredient_id': '310f271c-0e68-4675-af4e-1d8262bc4b97', 'quantite': '1'}, {'ingredient_id': 'ceaf03b7-38fe-4a40-a282-7bd36b6a7d72', 'quantite': '15 cl'}, {'ingredient_id': '7f8fc612-41cd-4d72-9dc1-afbbe7f667de', 'quantite': '25 cl'}, {'ingredient_id': '08195c77-58c6-4e8a-908d-e63e36c92dd2', 'quantite': ''}, {'ingredient_id': 'eb05c4c0-692e-4cf6-8086-3ef9165d0b5e', 'quantite': '480 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (94818, 'Brick poulet banane', 'brick, escalope de poulet, pomme de terre, amandes effilées, lait de coco, banane', '45 min', ['Couper les escalopes de Poulet en dés et les faire revenir dans une poêle antiadhésive saler poivrer. Ajouter de lait de coco et laisser réduire afin que ça ne soit plus trop liquide.Réserver.', 'Faire cuire les pommes de terre rissolées dans de l''huile de pépin de raisin (c''est plus sain en friture)saler. Réserver.', 'Sur votre plan de travail étaler séparément les feuilles de brick, au centre de chacune placer une rondelle de banane (environ 5mm d''épaisseur)puis 6 autres rondelles autour afin de former une sorte de fleur environ 3 min entre chaque. ', 'Répartir une petite poignée d''amandes effilées puis recouvrir de la préparation de poulet et finir par les pommes de terre. Rabattre les bords tel une bourse et mettre dans une poêle chaude huilée côté fermeture banane vers le haut. ', 'Laisser dorée puis retourner. ', 'A déguster dans les minutes qui suivent afin que ça reste bien croquant.'], ['Économe', 'Tire-bouchon', 'Presse-agrumes', 'Planche à découper'], ['Brick poulet banane', 'lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'escalope de poulet', 'recette', 'cuisine', 'brick', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'amandes effilées', 'pomme de terre', 'cocktail'], 'Entrée', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:50:54.670250', [{'ingredient_id': '04fe790f-3a13-4eb1-a970-5cf33c11e48e', 'quantite': '6'}, {'ingredient_id': '25ef5f61-cd3f-4d41-9648-e99d25f6168a', 'quantite': '2'}, {'ingredient_id': '9e662eef-96b6-4fa9-9e62-af9590623208', 'quantite': '100 g'}, {'ingredient_id': 'f9011bdf-f3ef-4d06-8603-6049d4e3eff6', 'quantite': '50 g'}, {'ingredient_id': '9ad3822c-0728-4e7c-b83d-7b9aa44bdb7e', 'quantite': '15 cl'}, {'ingredient_id': '5769287f-0fa6-4fd2-a702-fe155547c98a', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (87700, 'Bricks croustillantes aux fruits d''hiver', 'brick, compote, mangue, ananas, banane, citron', '30 min', ['Eplucher les pommes, les couper en huit et les mettre à cuire à feu doux pendant 1 heure, avec le couvercle.', 'Une fois cuites, ne pas les mixer mais les égoutter soigneusement.', 'Couper l''ananas, la mangue et la banane en petits dés et réserver.', 'Mettre au centre de chacune des feuilles de brick un lit de compote de pommes, puis répartir le reste des fruits. Verser un peu de jus de citron.', 'Refermer les feuilles de façon à former des petites aumônières, et maintenir avec deux piques en bois de manière perpendiculaire. Enfourner environ 8 minutes à 220°C (thermostat 8)'], ['Tire-bouchon', 'Spatule', 'Balance de cuisine', 'Passoire'], ['', 'Bricks croustillantes aux fruits d''hiver', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'mangue', 'recette', 'compote', 'cuisine', 'brick', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'citron', 'ananas', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:50:59.334754', [{'ingredient_id': '2cc92f4e-8a07-4a22-b851-a1e01ea5b4af', 'quantite': '6'}, {'ingredient_id': 'ce710822-f866-44e7-877d-ecc102589a6e', 'quantite': ''}, {'ingredient_id': '734009ca-25fe-422d-9215-c2a0dcd9fafc', 'quantite': '1'}, {'ingredient_id': '043227f4-8276-4540-aa43-af1c2c773660', 'quantite': '1'}, {'ingredient_id': 'bddb4ad9-cfef-4877-ae18-4edda6b805d2', 'quantite': '1'}, {'ingredient_id': '99b38eb5-044c-4a7e-8134-6f32b3075e47', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (530329, 'Barres de céréales sport', 'banane, purée d''amandes, amandes, flocons d''avoine, miel, fruits secs', '900 min', ['Mélanger les flocons, la banane écrasée, les amandes et les fruits secs (écrasées ou broyés en morceaux. Pas en poudre pour garder de la texture).', 'Ajouter miel et purée d''amande. Bien mélanger pendant 2 minutes, manuellement', 'Mettre dans un plat, environ 20x10cm pour 10 grosses barres, avec le papier de cuisson', 'Four 30 minutes à 180°C.', 'Conserver au frigo permet de durcir les barres.', 'Déguster !'], ['Pince de cuisine', 'Râpe', 'Planche à découper', 'Louche', 'Ouvre-boîte'], ['', 'amandes', 'entrée', 'banane', 'recettes de cuisine', 'Barres de céréales sport', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'fruits secs', 'recette', 'purée d''amandes', 'cuisine', 'miel', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'flocons d''avoine', 'cocktail'], 'Confiserie', b09b3d88-995c-45cd-8176-4205999c1c02, '2025-09-26T15:51:03.477735', [{'ingredient_id': '55923146-ea78-47d8-8901-bfb05b904a03', 'quantite': '80 g'}, {'ingredient_id': 'a65eb1f9-6d6e-4218-87b5-4281789dbf43', 'quantite': '60 g'}, {'ingredient_id': 'e8e3fd28-92c6-4654-97c9-48ff0c615417', 'quantite': '50 g'}, {'ingredient_id': '8743f697-1bf1-4145-b8c4-70640904c248', 'quantite': '160 g'}, {'ingredient_id': '7fc8f598-cc05-44ab-88cf-5c061f651e94', 'quantite': '120 g'}, {'ingredient_id': '1521733a-21f5-4cbb-93a1-35fc041fc109', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (38010, 'Petits choux express', 'pâte à choux, carotte, brocoli, tomate, banane, framboises, kiwi', '10 min', ['Choisir un fruit ou un légume de la liste ci-dessus et suivre la même recette pour tous.', 'Eplucher le légume (ou fruit) choisi, et le passer au mixer. Vous obtiendrez soit de la purée (banane, kiwi, framboise, brocoli, tomate) ou bien des  râpures (carotte).', 'Pour la purée : il suffit de la mêler à la pâte à choux et de former des « tas » sur une plaque pour obtenir des choux parfumés', 'Pour les râpures : il suffit de mêler les râpures à la pâte à choux et de repasser le tout au mixer pour obtenir une pâte homogène. Ensuite faire comme ci-dessus (des petits tas).', 'Il faut mettre les choux à cuire pendant 15 min à 180°C.'], ['Balance de cuisine', 'Casserole', 'Verre doseur'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'Petits choux express', 'confiserie', 'testées', 'carotte', 'brocoli', 'très facile', 'framboises', 'bon marché', 'tomate', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pâte à choux', 'cocktail'], 'Amuse-gueule', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:51:08.331037', [{'ingredient_id': 'd2713de3-3b40-4e56-b592-8c79730388b8', 'quantite': '150 g'}, {'ingredient_id': 'e30c31b1-7643-4762-9b36-dfa8262b86d6', 'quantite': '2'}, {'ingredient_id': 'b25a8b13-ef88-41e5-a64a-140e37bc55a5', 'quantite': '2'}, {'ingredient_id': 'd2609ddc-20f7-4472-a371-036100f1ddbf', 'quantite': '2'}, {'ingredient_id': '83b98ac5-cd5c-4f22-a6c9-2f27ac2579b6', 'quantite': '2'}, {'ingredient_id': '6271025e-affc-4c02-ae70-72a544f68cbb', 'quantite': '10'}, {'ingredient_id': '32c468b1-471f-4dce-a11a-6158b31c72d2', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (28413, 'Beignets à la banane', 'banane, oeuf, sucre, farine', '10 min', ['Ecraser les bananes puis ajouter les oeufs. ', 'Rajouter le sucre, mélanger. ', 'Rajouter la farine, mélanger. ', 'Faire cuire dans l''huile.'], ['Planche à découper', 'Poêle', 'Moule à tarte', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'Beignets à la banane', 'recette', 'cuisine', 'recettes', 'boisson', 'beignets sucrés', 'farine', 'dessert', 'plat de résistance', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:51:15.052963', [{'ingredient_id': 'b7eb349b-f9ad-4905-9684-7924c2262713', 'quantite': '3'}, {'ingredient_id': '348d867c-da0b-4770-b0c6-3e80b00a4aa2', 'quantite': '2'}, {'ingredient_id': '51d81164-f26c-4738-abed-88aeef33974b', 'quantite': '75 g'}, {'ingredient_id': '462e2874-9081-4c4a-b169-273f4d5c5817', 'quantite': '150 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (373310, 'Salade de Fruits caramel fleur d’oranger', 'banane, kiwi, nectarine, melon, sucre, sucre vanillé, miel, jus de citron', '30 min', ['Pour faire le caramel à la fleur d’oranger : ', 'Verser les deux sortes de sucre dans une poêle et le jus de citron. ', 'Mélanger jusqu''à ce que les sucres fondent.', 'Faites monter le caramel, puis reposer quand le caramel est prêt. ', 'Ajouter ensuite 5 cuillères à soupe de fleur d’organes à ce caramel. Mettez de côté. ', 'Couper les fruits en dés et les mettre dans un grand saladier. ', 'Ajouter les 5 autres cuillères à soupe d''arôme de fleur d’oranger. Et 5 cuillères à soupe d’eau. Mélanger le tout. ', 'Ajouter le caramel à la fleur d’oranger et le miel. Mélanger à nouveau.'], ['Batteur électrique', 'Râpe', 'Tire-bouchon', 'Économe'], ['melon', 'entrée', 'banane', 'kiwi', 'salade de fruits', 'recettes de cuisine', 'Salade de Fruits caramel fleur d’oranger', 'confiserie', 'testées', 'très facile', 'nectarine', 'bon marché', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'jus de citron', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:51:19.540412', [{'ingredient_id': 'efd6b695-a3c6-4dc7-8f27-d8b5b053f47e', 'quantite': '3'}, {'ingredient_id': '431ed2e8-0706-4c06-aa69-e45adf0ad72c', 'quantite': '3'}, {'ingredient_id': 'f46a6c6d-1f9f-4d8f-b364-967642819a4c', 'quantite': '3'}, {'ingredient_id': '2c3d0dd1-f7e3-4691-b368-ce44bdf9ec5c', 'quantite': '1'}, {'ingredient_id': '36b0254a-6776-4270-bd30-f15ea786d600', 'quantite': '50 g'}, {'ingredient_id': 'ad7c1a8d-1bea-4e5f-838b-942f00b5ab53', 'quantite': '25 g'}, {'ingredient_id': '756cd4f8-af91-4f11-b60c-0d88872436d3', 'quantite': '1 cuillères'}, {'ingredient_id': '2b64b3b0-ada4-479d-8544-24127be59291', 'quantite': '5 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (18691, 'Rôti de porc spécial', 'rôti de porc, pomme, carotte, blanc de poireau, banane, oignon, gingembre, curry, crème fraîche, ananas, pomme', '30 min', ['Rôtir la viande de tous côtés dans 1 cuillère à soupe d''huile et un peu de margarine. ', 'Mettre la viande de côté et ajouter à la sauce l''oignon, la carotte et le blanc de poireau coupés fins. ', 'Laisser cuire 5 min puis ajouter la banane et la pomme coupées en morceaux. ', 'Laisser recuire 10 min. ', 'Ajouter le rôti, le gingembre et le curry. ', 'Cuire +/- 1 heure 30 min. ', 'Retirer le rôti et passer la sauce au mixer. ', 'Lier avec la crème fraîche. ', 'Mettre chauffer les tranches d''ananas. ', 'Servir avec des croquettes et des pommes cuites au four. ', 'Pour le service du plat de rôti, alterner une tranche de rôti, une tranche d''ananas et ainsi de suite. ', 'Garnir de sauce et servir également de la sauce en saucière.'], ['Balance de cuisine', 'Verre doseur', 'Spatule'], ['gingembre', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'carotte', 'très facile', 'plat', 'Rôti de porc spécial', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'moyen', 'blanc de poireau', 'ananas', 'curry', 'cocktail', 'rôti de porc'], 'Plat principal', bce8d101-ceb0-4c7b-b294-d7686d7eee67, '2025-09-26T15:51:23.183581', [{'ingredient_id': '6fdd3d2d-0efc-447a-9430-aec9a4ecb55a', 'quantite': '1 kg'}, {'ingredient_id': 'fbc05124-34a0-48df-a0ac-a94ed549f4df', 'quantite': '1'}, {'ingredient_id': '9b4d9444-7bd8-426f-90fe-1b79b54176ae', 'quantite': '1'}, {'ingredient_id': '3f302502-5a86-4c2c-a1eb-2eb481496a4f', 'quantite': '1'}, {'ingredient_id': 'cc8cccad-5eb6-4add-ad4d-5295b4b70d00', 'quantite': '1'}, {'ingredient_id': 'ffd2f29a-3f94-4552-a25b-ca1714e7ab7b', 'quantite': '1'}, {'ingredient_id': '8ce1e5ca-925c-42a7-8697-07de858b59c7', 'quantite': ''}, {'ingredient_id': 'd356b4fc-0fd2-4625-a1cc-973617591e6a', 'quantite': ''}, {'ingredient_id': '04cdb3bf-17ec-4872-90b6-237290fb410e', 'quantite': '100 g'}, {'ingredient_id': 'de759321-d150-470d-aa19-a97dfab2b8ae', 'quantite': ''}, {'ingredient_id': 'd74cbd63-7c3e-4805-88c4-72b470e9a277', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (33034, 'Confiture de rhubarbe et framboises', 'rhubarbe, banane, framboises, citron, sucre', '15 min', ['Peler la rhubarbe et la couper en tronçons de 4 cm environ. ', 'La mettre dans une bassine à confiture avec le sucre et laisser macérer à couvert pendant 12 h. ', 'Egoutter la rhubarbe et faire réduire le jus et le sucre à petits frémissements 15 min. ', 'Rajouter la rhubarbe et faire cuire environ 15 min, jusqu''à ce que les bâtons soient tendres. Ajouter les bananes en tranches et les framboises. Cuire la confiture environ 20 min. ', 'Tester la prise en laissant tomber une goutte de confiture sur une assiette. Mettre au frigo. Au bout de quelques minutes, si la surface de la confiture se ride sous le doigt, la confiture est prête. ', 'Laisser tiédir et mettre en pots ébouillantés et secs.'], ['Pince de cuisine', 'Balance de cuisine', 'Tire-bouchon', 'Poêle'], ['entrée', 'banane', 'confiture de framboise', 'recettes de cuisine', 'confiserie', 'testées', 'rhubarbe', 'facile', 'framboises', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'Confiture de rhubarbe et framboises', 'plat de résistance', 'citron', 'sucre', 'cocktail'], 'Confiserie', 658bb91e-64d3-43d0-bcaf-9d7765b90605, '2025-09-26T15:51:26.759848', [{'ingredient_id': 'af30d7bc-ba1d-40cf-b3ab-036265809a6c', 'quantite': '1 kg'}, {'ingredient_id': 'da0e5a4a-7917-46a0-a719-4d4165511081', 'quantite': '4'}, {'ingredient_id': 'ac9a731f-7e9a-4cd2-bc80-9e9be88649bc', 'quantite': '150 g'}, {'ingredient_id': '7cdae0e0-d495-421e-ba29-c44ad1a919c2', 'quantite': ''}, {'ingredient_id': 'ae7a0e14-6775-4683-a3d5-8972b8b852ce', 'quantite': '1 kg'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (344489, 'Pudding coco banane sésame', 'pain, lait, lait de coco, oeuf, sucre roux, banane, sésame', '15 min', ['Préchauffer le four à 200°C (thermostat 6-7).', 'Couper le pain en petits cubes et les disposer dans un récipient (ex : saladier, plat).', 'Mélanger le lait, le lait de coco et le sucre et faire chauffer le mélange au micro-ondes ou dans une casserole. Le mélange doit être bouillant et le sucre doit être totalement fondu et incorporé.', 'Verser le mélange laits/sucre sur le pain en cubes et mélanger en écrasant pour que le pain soit bien imbibé et ramolli. ', 'Ajouter les oeufs un à un et mélanger pour qu''ils soient bien incorporés.', 'Couper les bananes en rondelles ou en cubes selon les goûts, et les ajouter en mélangeant bien pour les répartir équitablement.', 'Préparer un moule à gâteau avec du papier sulfurisé et/ou du beurre et verser le mélange dedans.', 'Saupoudrer de graines de sésames torréfiées ou non (à votre convenance) et enfourner dans un four préchauffé à 200°C pendant 25 à 30 min (à surveiller).'], ['Fouet', 'Planche à découper', 'Tire-bouchon', 'Spatule', 'Économe'], ['lait de coco', 'entrée', 'banane', 'Pudding coco banane sésame', 'recettes de cuisine', 'sésame', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'pudding', 'dessert', 'plat de résistance', 'lait', 'pain', 'cocktail', 'sucre roux'], 'Dessert', 5d46db2b-9444-438f-972e-a04ecc041251, '2025-09-26T15:51:31.367493', [{'ingredient_id': '5e8a9169-ed64-4e74-8aac-cdfd8f6ec917', 'quantite': '300 g'}, {'ingredient_id': '53c54055-f61c-4afc-aad6-1e3e4dd55882', 'quantite': '40 cl'}, {'ingredient_id': '78242bbf-cae2-4375-b9b4-41a3569aade8', 'quantite': '20 cl'}, {'ingredient_id': '1e430364-6cbb-4d87-b9ad-f66d5261471b', 'quantite': '2'}, {'ingredient_id': '2c4c04ed-31e0-4529-966c-768975cfbc86', 'quantite': '60 g'}, {'ingredient_id': '93872e75-f62c-4a47-8550-8768dc70dbdd', 'quantite': '2'}, {'ingredient_id': '7aa3fe11-c496-4858-af83-5b6965a71809', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (392235, 'Banana bread au chocolat et aux flocons d''avoine', 'banane, yaourt nature, flocons d''avoine, oeuf, cannelle, levure chimique, chocolat noir, noisettes', '15 min', ['Écraser la banane et ajouter l''oeuf. Bien mélanger.', 'Mélanger avec le yaourt.', 'Ajouter les flocons d''avoine et la levure et bien mélanger.', 'Enfin, incorporer les noisettes, le chocolat haché et la cannelle.', 'Mettre au four à 180°C pendant 35/40 minutes.', 'Laisser reposer quelques minutes et... C''est prêt !'], ['Poêle', 'Verre doseur', 'Balance de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'yaourt nature', 'cakes', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'noisettes', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat noir', 'Banana bread au chocolat et aux flocons d''avoine', 'cannelle', 'flocons d''avoine', 'cocktail'], 'Dessert', 03516cbf-1178-4cab-9794-39f566889cf7, '2025-09-26T15:51:34.877627', [{'ingredient_id': 'cf639cb5-1309-4846-b01b-caac2161d445', 'quantite': '2'}, {'ingredient_id': 'fbdb96cd-59b4-4d4d-bac5-efe1247cb513', 'quantite': '100 g'}, {'ingredient_id': 'f42ad309-f19e-4a2c-a880-2a44a6c07dec', 'quantite': '80 g'}, {'ingredient_id': '92b745ca-6e05-4d69-8014-f23a1c8fcab8', 'quantite': '1'}, {'ingredient_id': 'fcf2a6b9-3997-4688-b658-6fbc46e32caa', 'quantite': '1 cuillères'}, {'ingredient_id': '4bc4585e-8171-4eb7-a815-489f592427f0', 'quantite': ''}, {'ingredient_id': '56672b23-5ebe-4931-8f7b-35dcf7bff787', 'quantite': '10'}, {'ingredient_id': '65845434-ebe6-40b3-af93-a675bfc77431', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (336502, 'Cabillaud à la banane en petit curry', 'lieu noir, banane, tomates pelées, oignon, ail, beurre, lait de coco, gingembre confit, pâte de curry, huile de sésame', '20 min', ['Hachez ensemble dans le même mixeur l’oignon, l’ail et le gingembre.', 'Faites-les revenir à la sauteuse avec l’huile de sésame.', 'Ajoutez le curry, et laissez revenir 1 min.', 'Ajoutez le lait de coco, les bananes en rondelles et les tomates pelée en morceaux (sans leur jus) et laissez mijoter 10 min.', 'Pendant ce temps, faites cuire le cabillaud dans le beurre à feu vif dans une poêle.', 'Servez immédiatement le poisson à l’assiette, accompagné de riz basmati, et nappé de sauce à la banane.'], ['Presse-agrumes', 'Pince de cuisine', 'Passoire'], ['pâte de curry', 'lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'tomates pelées', 'gingembre confit', 'facile', 'bon marché', 'ail', 'plat', 'recette', 'cuisine', 'recettes', 'oignon', 'Cabillaud à la banane en petit curry', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'huile de sésame', 'viande à l''indienne', 'cocktail', 'lieu noir'], 'Plat principal', d58f6b10-8e4f-45cb-8ce0-a34e98f7b580, '2025-09-26T15:51:38.440121', [{'ingredient_id': '534bc14f-d637-4cd6-9ff7-c514b86fa1df', 'quantite': '600 g'}, {'ingredient_id': '3057e629-b5cd-42c0-95e7-e4c632c2ba34', 'quantite': '2'}, {'ingredient_id': 'c67c271b-8e3d-4cb6-9e63-9cb71e96a8aa', 'quantite': '230 g'}, {'ingredient_id': 'a4d363c1-cbea-4ed7-bfc4-f7a426996395', 'quantite': '1'}, {'ingredient_id': 'e95eef42-ee81-40c2-896e-688e31ef8ce7', 'quantite': '1'}, {'ingredient_id': '248e6a78-a1b5-4b00-aeb8-c9a7a019a2e8', 'quantite': '20 g'}, {'ingredient_id': 'c046084d-4ce9-4e70-bd0c-a47ca147ed30', 'quantite': '40 cl'}, {'ingredient_id': '879a53af-aa25-4032-bd23-f14857e6ea2b', 'quantite': '8'}, {'ingredient_id': '6b1ffde0-9f69-4699-99d3-7113aab31e9b', 'quantite': '1 cuillères'}, {'ingredient_id': '7e564cc8-3719-4d98-921f-0339e696059a', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (16694, 'Gâteau tutti-frutti', 'farine, sucre fin, sucre vanillé, yaourt, yaourt, oeuf, levure chimique, banane, orange, citron, poire, pêche, prune, abricot, kiwi', '25 min', ['Tamiser le mélange farine-levure dans une terrine.', 'Faire une fontaine et y mettre le sucre et les yaourts.', 'Mélanger bien puis ajouter l''huile,les oeufs battus et le sucre vanillé. Travailler le tout pour obtenir une pâte lisse.', 'Presser le jus de citron et de l''orange. Eplucher la banane et la couper en rondelles. Mettez-la dans un saladier et arrosez-la avec le jus des fruits pressés. Couper tous les autres fruits en dés et les ajouter.', 'Beurrer un moule et y verser la pâte. Répartir sur cette pâte 500 à 600g de fruits égouttés et les enfoncer légèrement. ', 'Faire cuire à four moyen 1 heure environ.', 'démouler le gâteau encore chaud sur une grille'], ['Verre doseur', 'Économe'], ['', 'entrée', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'levure chimique', 'sucre fin', 'facile', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'moyen', 'Gâteau tutti-frutti', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:51:42.054590', [{'ingredient_id': '4e3d3f0d-bfe5-4e04-94b1-feb9bbdaf5aa', 'quantite': '300 g'}, {'ingredient_id': '96fea55a-494c-4216-9e20-c928b6a3fc0b', 'quantite': '250 g'}, {'ingredient_id': '18824a84-14f2-4105-a944-c56971234860', 'quantite': '2'}, {'ingredient_id': '5232c341-7b5b-44e9-935c-b8fc935aca7e', 'quantite': '2'}, {'ingredient_id': 'ab8e13b4-2b8e-4f81-b38c-9412401b9a24', 'quantite': '1'}, {'ingredient_id': '69428afb-368f-4810-8b52-9b7f836a876b', 'quantite': '3'}, {'ingredient_id': '04fa73fb-d3b2-45de-bbbc-423ff3dcd103', 'quantite': '1'}, {'ingredient_id': '93809157-6217-4477-bb1b-81e30e1de784', 'quantite': '1'}, {'ingredient_id': 'c4ce2d95-2afd-4409-902f-f7e0fa8cc2ef', 'quantite': '1'}, {'ingredient_id': 'c59857c2-c53b-4d01-8ed5-284f56ccd897', 'quantite': '1'}, {'ingredient_id': '94b8da6b-4a34-4680-a50c-a1699b4ef9ef', 'quantite': '1'}, {'ingredient_id': 'ea260e49-75cf-48fa-9837-c7c37ed75473', 'quantite': '2'}, {'ingredient_id': '68ed997e-3485-4d70-9f0e-bbbcee2e4523', 'quantite': '4'}, {'ingredient_id': '387e2865-b6ba-42c1-9cf6-31c5761f03f9', 'quantite': '4'}, {'ingredient_id': '3101e957-0ba7-47db-9f9d-3666638e21c4', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (70995, 'Verrine  banane poire nutella', 'banane, poire, Nutella, crème liquide, glace vanille, arachide', '15 min', ['Couper les bananes en rondelles et les poires en petits morceaux, répartissez dans 4 verres (verre à whisky par exemple).', 'Faite chauffer le nutella et la crème à feu doux en mélangeant bien puis verser sur les fruits.', 'Ajouter 1 ou 2 boules de glaces selon la taille des verres et l''appétit des gourmands. Saupoudrez de cacahuètes et déguster.'], ['Spatule', 'Balance de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'arachide', 'recettes', 'boisson', 'crème liquide', 'glace vanille', 'Nutella', 'dessert', 'plat de résistance', 'Verrine  banane poire nutella', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:51:45.622131', [{'ingredient_id': 'ba4e1136-ad52-4d7d-95ef-7cf8a9d1d374', 'quantite': '3'}, {'ingredient_id': '88a2139f-9f57-43d4-bfa8-f795671f3d48', 'quantite': '3'}, {'ingredient_id': 'f49da642-9543-4be6-8c34-40edab683aa7', 'quantite': '4 cuillères'}, {'ingredient_id': 'd50e79cc-d7e7-4f8b-8761-220eebad279b', 'quantite': '5 cl'}, {'ingredient_id': '31650996-fe11-4f03-ab70-d73e82ffa537', 'quantite': '1'}, {'ingredient_id': 'ddb4cd3e-64e0-4e9f-ab82-d2f83e4c78bb', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (27446, 'Muësli maison', 'flocons d''avoine, raisin, eau, yaourt, banane, sucre, citron, poudre de noisette', '10 min', ['La veille :', 'Faites tremper les flocons d''avoine et les raisins dans l''eau froide.', 'Le lendemain :', 'Ajoutez aux flocons d''avoine les yaourts et les banane coupées en rondelles. Sucrez au goût, arrosez de jus de citron et saupoudrez de noisettes.', 'Dégustez aussitôt.'], ['Couteau de chef', 'Mixeur', 'Spatule', 'Batteur électrique', 'Pince de cuisine'], ['', 'raisin', 'entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'eau', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'poudre de noisette', 'recette', 'cuisine', 'recettes', 'boisson', 'Muësli maison', 'dessert', 'plat de résistance', 'citron', 'sucre', 'flocons d''avoine', 'cocktail'], 'Dessert', bbdf1f5a-435b-48fa-ae97-4260fdd5cc34, '2025-09-26T15:51:50.357924', [{'ingredient_id': 'b2148b9d-1ca9-4aa1-bd25-f7b5afee66c6', 'quantite': '8 cuillères'}, {'ingredient_id': 'ca69cd86-5992-4887-9517-261ae8e098b9', 'quantite': '4 cuillères'}, {'ingredient_id': '269d4c25-463e-47e6-89c0-248be47b9804', 'quantite': '16 cuillères'}, {'ingredient_id': 'fab5d954-b232-41a7-880d-05f456abaf2e', 'quantite': '4'}, {'ingredient_id': 'c7725015-5197-407b-9a38-5b32107c37c1', 'quantite': '4'}, {'ingredient_id': '48d1b832-95d9-4d65-896a-247f4e5b1ac2', 'quantite': ''}, {'ingredient_id': 'd62d8cda-6624-465e-8559-1999370e78af', 'quantite': ''}, {'ingredient_id': '12f4d37d-1a31-4ff5-bb50-18741cd4ab72', 'quantite': '4 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (254255, 'Gâteaux au yaourt, banane et raisin', 'yaourt nature, farine, sucre, huile, levure, lait, sucre, sel, beurre, banane, raisins secs', '20 min', ['Préchauffer le four 10 minutes à 170° (thermostat 5-6). Mettre tous les ingrédients (sauf banane et raisins secs) dans un saladier et mélanger avec une cuillère en bois.', 'Prendre un moule et beurrer soigneusement les bords. Mettre la pâte dans le moule et ajouter les raisins. Couper la banane en morceaux et la mettre dans la pâte.', 'Faire cuire à four chaud pendant 35 minutes environ. Vérifier la cuisson avec une lame de couteau qui doit ressortir sèche.', 'Démouler une fois tiède.'], ['Planche à découper', 'Fouet', 'Casserole'], ['', 'entrée', 'banane', 'recettes de cuisine', 'Gâteaux au yaourt', 'sel', 'confiserie', 'testées', 'yaourt nature', 'facile', 'bon marché', 'plat', 'banane et raisin', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'huile', 'farine', 'dessert', 'plat de résistance', 'beurre', 'raisins secs', 'sucre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:51:54.526912', [{'ingredient_id': 'bf07a73a-1cf2-4d24-b225-8e4bc782441a', 'quantite': '1'}, {'ingredient_id': '9889f336-5c4d-4493-a9fc-c62908ebd0e3', 'quantite': '3'}, {'ingredient_id': 'a5600217-a7ca-4ee8-9ebc-7f90785436d6', 'quantite': '2'}, {'ingredient_id': 'e4985f3f-8b4a-4d34-b1ea-a3113ff4902c', 'quantite': ''}, {'ingredient_id': '2df8c2e4-d1d9-4c23-8118-a31cfef35569', 'quantite': ''}, {'ingredient_id': '20425fd0-6514-481e-bef9-6feeb43413f9', 'quantite': ''}, {'ingredient_id': '2b329124-18cf-44aa-ad33-7ee7e08f74cd', 'quantite': '2 cuillères'}, {'ingredient_id': '9873983e-a724-4b52-825a-58ce1d18beb7', 'quantite': '1'}, {'ingredient_id': 'ad2c3cce-0004-4c33-b08b-508cc3a075fe', 'quantite': '15 g'}, {'ingredient_id': '393f0ca3-1ae7-4133-8a33-3fb945858f65', 'quantite': '1'}, {'ingredient_id': '481c6809-fe57-429d-a260-e7c49b521e57', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (66815, 'Gâteau banane-cannelle', 'yaourt nature, sucre, farine, levure chimique, oeuf, cannelle, banane', '10 min', ['Préchauffez le four à 180°C (thermostat 6).', 'Dans un saladier, mélangez tous les ingrédients ainsi que la banane coupée en rondelles.', 'Beurrer et fariner un moule à manqué.', 'Verser la pâte et enfourner 45 min.'], ['Râpe', 'Mixeur', 'Planche à découper', 'Poêle', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'yaourt nature', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'gâteau à la banane', 'Gâteau banane-cannelle', 'cannelle', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:51:58.811014', [{'ingredient_id': '100bb453-c94f-4d63-978b-85063805ef2b', 'quantite': '1'}, {'ingredient_id': '264ef201-4b1e-461f-ae5f-a400b77b2927', 'quantite': '2'}, {'ingredient_id': 'cbc50d05-42f0-4614-9bfa-765d12e35563', 'quantite': '3'}, {'ingredient_id': '9802c52d-8b7b-46ae-a8bb-5641e9054a74', 'quantite': '1'}, {'ingredient_id': '8daf5f1a-5523-442e-83d9-aaec85b57ad3', 'quantite': '2'}, {'ingredient_id': 'd01114e9-f4f0-4856-b008-b818927a4e93', 'quantite': '2 cuillères'}, {'ingredient_id': 'bbbfe5b7-f617-4b3d-9dd2-cd456bc53502', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (392392, 'Banana bread sans oeufs', 'banane, beurre, farine, maïzena, levure chimique, lait, sucre, fleur de sel, pépites de chocolat', '10 min', ['Faire fondre le beurre au micro-ondes ou au bain-marie.', 'Conserver une demie-banane et écraser le reste dans un saladier.', 'Ajouter tous les ingrédients secs (farine, maizena, levure chimique, sucre, fleur de sel) et mélanger.', 'Ajouter les ingrédients liquides (lait, beurre fondu) et mélanger.', 'A cette étape, il est possible d''ajouter des pépites de chocolat ou des noix. Mélanger à nouveau.', 'Verser dans un moule à cake beurré et fariné puis ajouter la demi banane restante sur le dessus pour décorer.', 'Faire cuire environ 25 minutes à 180°C en vérifiant régulièrement la cuisson. Le cake est cuit lorsque la pointe d''un couteau ressort sec.'], ['Moule à tarte', 'Râpe', 'Louche', 'Balance de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'très facile', 'maïzena', 'bon marché', 'plat', 'pépites de chocolat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'autres cakes', 'dessert', 'fleur de sel', 'plat de résistance', 'beurre', 'lait', 'sucre', 'Banana bread sans oeufs', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:52:02.491312', [{'ingredient_id': '43c3b720-4fc2-4d80-bd21-480c1ebf43dc', 'quantite': '2'}, {'ingredient_id': 'b46d104a-b3be-4d84-9463-3a2f6766e868', 'quantite': '40 g'}, {'ingredient_id': 'b01ce0e5-e5e8-4588-ab0a-8a478ac5c74a', 'quantite': '60 g'}, {'ingredient_id': 'ec414fd1-313e-4c0f-908c-541f19040058', 'quantite': '60 g'}, {'ingredient_id': '1f4490b5-59c5-43a0-8687-af7464c0a021', 'quantite': ''}, {'ingredient_id': '506faabb-bec6-464f-b2bc-7d7bdc493acc', 'quantite': '90 g'}, {'ingredient_id': 'dc9e73b6-bbba-46cb-8d88-01c69c5240db', 'quantite': '40 g'}, {'ingredient_id': '293e928c-79ca-417b-8491-620c1af8ffc7', 'quantite': '1'}, {'ingredient_id': '234c781a-5748-4637-8fbb-f1905eea0f8f', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (530771, 'Porridge renardo', 'mangue, poire, banane, myrtilles, flocons d''avoine, miel liquide, amandes, cannelle', '15 min', ['Dans une casserole, verse les flocons d’avoine et le lait. Faits chauffer sur feu doux en remuant régulièrement.
S’il manque du liquide, ajoute un peu d’eau
au fur et à mesure. Saupoudre d’un peu
de cannelle. Ajoute le miel en fin de cuisson.', 'Forme 6 fines tranches de poire ainsi qu’une plus grosse pour la queue. Découpe un morceau en guise de langue et 2 triangles pour les oreilles. Ôte la peau de la
mangue et coupe-la en cubes. Tranche la banane.', 'Dépose le porridge crémeux. Dispose d’abord les rondelles de bananes, puis les myrtilles. Ajoute les morceaux de mangue sur toute la partie haute du bol. Place les triangles au niveau des oreilles puis les moustaches et la langue.
Pose le bol sur une assiette plate afin de pouvoir
placer la queue et 2 amandes en guise de pattes.'], ['Couteau de chef', 'Verre doseur', 'Planche à découper', 'Ouvre-boîte'], ['miel liquide', 'amandes', 'entrée', 'banane', 'recettes de cuisine', 'Porridge', 'confiserie', 'testées', 'poire', 'très facile', 'bon marché', 'plat', 'mangue', 'myrtilles', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cannelle', 'flocons d''avoine', 'cocktail', 'Porridge renardo'], 'Dessert', 5b367c7c-67ed-44f7-b5e9-bee1bc6abb0e, '2025-09-26T15:52:06.124447', [{'ingredient_id': '1acddb62-f06f-436f-952b-9f2ca3517c67', 'quantite': ''}, {'ingredient_id': '573e1ceb-1abe-44af-9d0e-32490b03233c', 'quantite': ''}, {'ingredient_id': '2c6fac83-672d-4a16-b971-dc5a627a9ca9', 'quantite': ''}, {'ingredient_id': 'ae5add13-7c7a-47cc-9b6d-8363095d5640', 'quantite': '3'}, {'ingredient_id': '3876d96f-d64f-4de4-8228-34b9af621c33', 'quantite': '40 g'}, {'ingredient_id': 'ab69a5af-cb14-471b-874b-066fa847a8ef', 'quantite': '1 cuillères'}, {'ingredient_id': '4240926f-61f2-4111-9682-e5ad21a44cea', 'quantite': '2'}, {'ingredient_id': '2fd7f02e-fc5b-4f36-806a-88c988061ab4', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (37235, 'Bananes au pralin', 'banane, chocolat noir, pralin, sucre en poudre, beurre', '15 min', ['Dans une poêle bien chaude, faites revenir les bananes avec le beurre.', 'Dès coloration des bananes, ajouter le sucre, les carrés de chocolat noir râpés, bien faire caraméliser le tout avant d''ajouter le pralin, mélanger et servir de suite avec une boule de glace vanille.'], ['Spatule', 'Poêle', 'Économe', 'Pince de cuisine', 'Rouleau à pâtisserie'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'pralin', 'dessert', 'plat de résistance', 'chocolat noir', 'Bananes au pralin', 'beurre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:52:09.670169', [{'ingredient_id': '8eea73eb-e86d-4f3c-a7b3-da3009d0dcb4', 'quantite': '4'}, {'ingredient_id': '5e6b19db-13e1-4af5-b4d0-ac2a4a36ea8d', 'quantite': '4'}, {'ingredient_id': '0d9c5dbb-53fb-488e-9bf7-3ab091de456b', 'quantite': '3 cuillères'}, {'ingredient_id': '9825a904-9b38-43f6-af60-9b6ad6d9d782', 'quantite': '1 cuillères'}, {'ingredient_id': 'b0b09568-02ca-4876-b8be-76268ba456bd', 'quantite': '20 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (90954, 'Tarte au caramel et aux bananes', 'sucre, beurre, farine, oeuf, lait, jaune d''oeuf, sucre, fécule de pomme de terre, gélatine, banane, glace vanille, framboises', '40 min', ['Préparation de la pâte : ', 'Malaxer la farine, le sucre, le beurre et l''œuf. ', 'Réserver au frigo pendant 20 minutes. ', 'Etaler la pâte dans un plat adapté. ', 'Faire dorer au four préchauffé à 200°C (thermostat 6-7) pendant 20 minutes. ', 'Laisser la pâte refroidir dans le plat. ', 'Éplucher les bananes et les couper en rondelles.', 'Pour la crème caramel : ', 'Fairechauffer la moitié du sucre dans une casserole pour réaliser un caramel à sec. ', 'Lorsque le caramel commence à roussir verser 3 cl d''eau, mélanger , retirer du feu et laisser refroidir. ', 'Faire tremper les feuilles de gélatine dans de l''eau froide.', 'Faites bouillir le lait. ', 'Battre les jaunes d''œufs avec une pincée de sel et le reste du sucre jusqu''à l''obtention d''une crème onctueuse, puis incorporer peu à peu la fécule de pomme de terre. ', 'Mélanger le lait bouillant à la crème, reverser le tout dans la casserole et porter à ébullition à feu doux en remuant constamment.', 'Ajouter le caramel et la gélatine à la crème, et laissez refroidir.', 'Étaler la crème au caramel sur la pâte. Recouvrir de bananes.', 'Il est possible de servir ce dessert avec une boule de glace vanille et quelques framboises.'], ['Ouvre-boîte', 'Poêle', 'Louche'], ['entrée', 'recettes de cuisine', 'Tarte au caramel et aux bananes', 'confiserie', 'testées', 'facile', 'caramel', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'moyen', 'beurre', 'sucre', 'cocktail'], 'Dessert', d3f6c9c8-2a0a-4bfe-9dee-fb6e25b2737a, '2025-09-26T15:52:14.248853', [{'ingredient_id': '43dbaee8-5759-4fa3-95f9-c18e921031a5', 'quantite': '100 g'}, {'ingredient_id': 'c973b852-b186-4d1b-9df8-737725a171a1', 'quantite': '200 g'}, {'ingredient_id': 'bffcab68-cc87-4661-a9ae-3f2e90e87219', 'quantite': '300 g'}, {'ingredient_id': '5aecd036-3c5e-4796-8c2d-0e4f510bac28', 'quantite': '1'}, {'ingredient_id': 'a93c1d41-f668-400c-a1a2-a876a05e260e', 'quantite': ''}, {'ingredient_id': '86379963-c710-46c7-8595-ced0b82203a9', 'quantite': '5'}, {'ingredient_id': '5631b084-e7cd-45d8-a8ed-9aed5ae8b4f4', 'quantite': '150 g'}, {'ingredient_id': 'ac683bd9-088e-4266-a808-dc0a5a94c0bd', 'quantite': '40 g'}, {'ingredient_id': '5ff28697-70bb-41c7-98c2-d0b29c787742', 'quantite': '3'}, {'ingredient_id': '9fb56cd3-b9e1-432e-b86d-ce04303bc909', 'quantite': '2'}, {'ingredient_id': '89db5a8e-254e-4836-af06-3239b4119119', 'quantite': ''}, {'ingredient_id': 'c5a04ba4-d9af-4d41-8a50-b685d5db1b63', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (164987, 'Salade de fruits frais (imitation créole)', 'papaye, pomme, litchi, orange, ananas, banane, jus d''orange, sucre de canne, lait de coco', '30 min', ['- Epluchez les papayes que vous couperez grossièrement; ', '- Puis coupez la pomme verte sans enlever la pelure (en effet, ça donnera de la couleur à la salade);', '- Epluchez et dénoyautez les litchi puis les couper en quatre;', '- Epluchez et coupez chaque quartier d''orange en quatre;', '- Epluchez et coupez l''ananas comme pour la papaye;', '- Enfin, épluchez et coupez en rondelle toutes les bananes;', 'Mélangez le tout dans un grand saladier.', 'Pour le jus :', '- Videz la brique de jus d''orange dans le saladier avec les fruits, y ajouter 3/4 d''un verre de sucre de canne et les 200 mL de lait de coco en brique (Cela vous fera surement penser à un jus de fruits matinal que les enfants aiment bien).'], ['Moule à tarte', 'Batteur électrique', 'Casserole', 'Mixeur', 'Tire-bouchon'], ['lait de coco', 'entrée', 'salade de fruits originale', 'banane', 'papaye', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'sucre de canne', 'dessert', 'plat de résistance', 'pomme', 'orange', 'ananas', 'jus d''orange', 'Salade de fruits frais (imitation créole)', 'litchi', 'cocktail'], 'Dessert', f7abbfea-1087-41dd-9250-b8ae23b99b47, '2025-09-26T15:52:18.911448', [{'ingredient_id': '051cfe6a-3ca8-4b9a-bbcb-046a4035c01b', 'quantite': '2'}, {'ingredient_id': 'da5877bd-b2c6-4496-ba7d-737139f9f8d6', 'quantite': '1'}, {'ingredient_id': '0704c081-f130-4ba1-b50f-a36f8b130cd4', 'quantite': '500 g'}, {'ingredient_id': 'a81a9913-b854-4945-b992-aa2c6c771e16', 'quantite': '3'}, {'ingredient_id': '34ed74f4-da45-4bca-86a9-f6184a4d2984', 'quantite': ''}, {'ingredient_id': 'a368eae0-7c32-41a6-a60c-e1c8b93a7073', 'quantite': '6'}, {'ingredient_id': 'ecd3318d-64b4-42d9-928a-5b334293eed6', 'quantite': '1 l'}, {'ingredient_id': '559d5613-54fe-4274-acf0-5c54040a1023', 'quantite': ''}, {'ingredient_id': '0f8fca5f-58c2-4da2-9837-719a21602cf3', 'quantite': '200 ml'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (324182, 'Smoothies de fruits glacés', 'pêche, abricot, banane, fraises', '15 min', ['Mixer tous les fruits lavés, équeutés et épluchés, en même temps puis les mettre dans les étuis pour réaliser des bâtonnets de glace.', 'Laisser au congélateur pendant minimum 4 heures. '], ['Tire-bouchon', 'Passoire', 'Poêle'], ['', 'Smoothies de fruits glacés', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'abricot', 'facile', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pêche', 'cocktail'], 'Dessert', bef9d9c9-540c-40ed-ba80-777c64e3688a, '2025-09-26T15:52:22.525095', [{'ingredient_id': '80ed3c3d-a35b-4ac0-9915-9c6538e134d4', 'quantite': '2'}, {'ingredient_id': 'a80ebee2-d2ac-42e1-8c76-bc42f83d9547', 'quantite': '2'}, {'ingredient_id': '5c4d72a8-407f-4a2a-9942-ab9ebc1e0615', 'quantite': '2'}, {'ingredient_id': 'dabc7b9f-b566-4556-92c6-b58eb0f3a979', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (372753, 'Nice cream', 'banane, framboises, framboises, boisson aux amandes, muesli', '10 min', ['Couper deux bananes en rondelles et les déposer sur une plaque recouverte de papier sulfurisé.  ', 'Laisser une nuit au congélateur.', 'Placer les morceaux de bananes congelés dans un blender avec les framboises surgelées, la boisson végétale et mixer le tout. ', 'Servir dans un bol et ajouter des fruits frais sur le dessus, un peu de muesli, de la coco râpée, des copeaux de chocolat ou tout autre topping à votre goût.'], ['Couteau de chef', 'Batteur électrique', 'Mixeur', 'Balance de cuisine', 'Économe'], ['entrée', 'banane', 'boisson aux amandes', 'recettes de cuisine', 'confiserie', 'testées', 'muesli', 'très facile', 'framboises', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'autres glaces', 'Nice cream', 'cocktail'], 'Dessert', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T15:52:26.220492', [{'ingredient_id': '400bd618-4aad-4ba3-ba3f-cd69f67ecea2', 'quantite': '2'}, {'ingredient_id': 'a9bdfc3e-5430-4209-9520-4a353fa081d9', 'quantite': '200 g'}, {'ingredient_id': '4c371cc9-e3a7-4205-b1c9-0e99005617df', 'quantite': '100 g'}, {'ingredient_id': '543d2dc3-dcb2-4bd5-a07f-fc61651a6b38', 'quantite': '2 cuillères'}, {'ingredient_id': '85078ce0-61d3-4202-a7b7-468591255adf', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (19107, 'Brochettes de fruits exotiques', 'ananas, orange, banane, mangue, noix de coco rapée, citron vert, cassonade, rhum, crème fleurette, vanille, sucre glace', '60 min', ['Tout d''abord il faut préparer les fruits : éplucher l''ananas, peler les oranges à vif, les couper en cubes de 3 cm, éplucher les bananes, les découper en tronçons, peler les mangues et les couper en morceaux. ', 'Pressez le jus des citrons et en arroser immédiatement les fruits préparés. ', 'Mettez ensuite ces fruits dans une jatte et ajoutez y le sucre et le rhum. Vous couvrez et laissez macérer au minimu 1 h. ', 'Vous enfilerez ensuite les fruits sur les brochettes en bois en les alternant et en veillant à mélanger les parfums. ', 'Roulez ensuite chaque brochette dans la noix de coco râpée et disposez les sur un plat que vous pourrez décorer si vous le souhaiter avec de la menthe fraîche. ', 'Placez le tout au frais. ', 'A servir avec une crème chantilly vanillée.'], ['Pince de cuisine', 'Ouvre-boîte', 'Louche'], ['', 'entrée', 'banane', 'Brochettes de fruits exotiques', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'cassonade', 'très facile', 'bon marché', 'rapide', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'noix de coco rapée', 'dessert', 'plat de résistance', 'orange', 'ananas', 'citron vert', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:52:31.013648', [{'ingredient_id': 'abd7bd0e-0e65-4bf2-8c1d-8e248373f7ea', 'quantite': '1'}, {'ingredient_id': '6f527baa-ab69-4281-b5d1-e216b20bce84', 'quantite': '3'}, {'ingredient_id': '4e726cf5-8c9d-47e9-b1d5-3555ca149964', 'quantite': '3'}, {'ingredient_id': '4d96134e-66ca-4c72-b3e6-657823a24475', 'quantite': '3'}, {'ingredient_id': 'daf2463f-7daa-4568-a68e-2101088ea7d7', 'quantite': '200 g'}, {'ingredient_id': '683271fc-a600-4652-a8da-06ebe8fe8104', 'quantite': '2'}, {'ingredient_id': '84c308d5-8a40-4a61-94f0-f13689ee2629', 'quantite': '100 g'}, {'ingredient_id': 'f1bd2b48-a442-45e7-916d-973af6bfeef8', 'quantite': '2 cuillères'}, {'ingredient_id': '2019949b-8061-4bf6-8d5b-63de0a9e9035', 'quantite': '40 cl'}, {'ingredient_id': '46ec10fe-5f43-45ef-97ac-6a93e538fc25', 'quantite': '1 cuillères'}, {'ingredient_id': '2e67b7ba-7ea2-4155-a9ad-f13605648eb5', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (167530, 'Gâteau pomme, banane, chocolat', 'sucre, beurre, farine, oeuf, pomme, banane, chocolat pâtissier, levure', '15 min', ['- Préchauffer le four a 180°c', '- Faire fondre le beurre', '- Mélanger le sucre avec les oeufs, y   ajouter la farine+levure et le beurre fondu', '- Râper le chocolat et l''ajouter à la pâte', '- Couper la pomme et la banane en lamelles et les ajouter au mélange ', '- Faire cuire 20 à 25 min'], ['Mixeur', 'Balance de cuisine'], ['Gâteau pomme', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'chocolat pâtissier', 'levure', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'pomme', 'beurre', 'gâteau au chocolat', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:52:34.551503', [{'ingredient_id': 'c16e14d5-20a4-4094-8000-aaae0b3e2274', 'quantite': '125 g'}, {'ingredient_id': 'efa91a5c-0b19-496e-a5b8-40306f435022', 'quantite': '125 g'}, {'ingredient_id': '236d0fb3-0617-4717-93b5-da6a0f0cf68f', 'quantite': '160 g'}, {'ingredient_id': 'a4470f66-3496-476e-8174-691130ebd182', 'quantite': '3'}, {'ingredient_id': '8254312e-a9ad-4739-9a05-d5c5f00be041', 'quantite': ''}, {'ingredient_id': '063cac99-e6f1-474e-8696-9620435b7350', 'quantite': '1'}, {'ingredient_id': '8c3613a1-3151-4dc5-8c9b-07839bc389cf', 'quantite': '150 g'}, {'ingredient_id': '6d5a2880-d9f4-44db-8ef6-3720c35170ce', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (30340, 'Poêlée de bananes sauce chocolat', 'banane, nappage chocolat, beurre, eau, rhum', '15 min', ['Faites fondre le chocolat dans l''eau avec la noix de beurre.', 'Ajoutez y le rhum quand le chocolat est fondu.', 'Mettez le beurre dans une poêle pour le faire chauffer. Faites  y dorer ensuite les bananes coupées en deux dans le sens de la longueur.', 'Disposez joliment les bananes dans un plat et nappez les fruits encore chaud de sauce au chocolat.', 'Flambez les bananes au rhum si vous le souhaitez mais faites le avant de les napper de sauce au chocolat.'], ['Râpe', 'Rouleau à pâtisserie', 'Verre doseur', 'Presse-agrumes'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'eau', 'testées', 'très facile', 'rapide', 'plat', 'Poêlée de bananes sauce chocolat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'sauce chocolat', 'plat de résistance', 'moyen', 'beurre', 'nappage chocolat', 'cocktail'], 'Dessert', a3c069d1-7f4d-4c09-a9fe-bd99ac27e024, '2025-09-26T15:52:38.074492', [{'ingredient_id': 'c93da1f1-3c32-401a-9ced-adabc69687bc', 'quantite': '2'}, {'ingredient_id': '1a52bf2d-7925-4278-ac2e-c1f1df420fcf', 'quantite': '100 g'}, {'ingredient_id': 'ea955f63-7215-4c4b-a22f-ca7113780293', 'quantite': '25 g'}, {'ingredient_id': 'b9c7e952-8aec-410c-8a1c-57aa313659c2', 'quantite': '5 cl'}, {'ingredient_id': 'ce908ae8-63f5-456c-b546-99c8839c1b48', 'quantite': '3 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (20632, 'banana bread', 'banane, farine fermentante, sucre fin, beurre, oeuf, sel', '15 min', ['Mélanger la farine avec le sucre et le sel. ', 'Ajouter les 2 oeufs entiers puis le beurre fondu et terminer par les bananes que vous aurez au préalable mixées. ', 'Cuire au four à 180°C pendant une petite heure.'], ['Couteau de chef', 'Planche à découper', 'Économe', 'Balance de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'sucre fin', 'facile', 'bon marché', 'oeuf', 'plat', 'farine fermentante', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'banana bread', 'beurre', 'cocktail'], 'Dessert', cd164d9e-4116-4252-bb58-5bfe08f00c6d, '2025-09-26T15:52:43.992464', [{'ingredient_id': '2a4b5065-49a7-4aaa-a29c-6fae26b160b9', 'quantite': '3'}, {'ingredient_id': '71ae2aa9-fa45-4c8a-89ea-aa357280f389', 'quantite': '150 g'}, {'ingredient_id': '5ad6a7c4-5a8c-4163-9ca7-406482f22f16', 'quantite': '125 g'}, {'ingredient_id': 'af546767-0a5a-4523-8fd0-66a55b64d6a8', 'quantite': '100 g'}, {'ingredient_id': 'a10fae64-b424-4a1f-9560-40678a3cc198', 'quantite': '2'}, {'ingredient_id': '58323350-2684-49b4-824a-951fff25dc57', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (23710, 'Tarte banane et chocolat blanc', 'banane, pâte sablée, chocolat blanc, noix de coco rapée, rhum, sucre, crème fraîche épaisse, crème liquide, oeuf', '20 min', ['Etalez la pâte dans un moule à tarte.', 'Faites fondre le chocolat blanc avec la crème liquide. Hors du feu, ajoutez un oeuf et la noix de coco. Mélangez.', 'Etalez cette garniture sur la pâte.', 'Epluchez les bananes et coupez les en rondelles assez épaisses.', 'Répartissez harmonieusement les bananes sur la pâte en rang serré.', 'Dans un saladier, mélangez 4 oeufs avec le sucre et 3 grosses cuillères à soupe de crème.Ajoutez le rhum. Répartissez cette préparation sur les bananes.', 'Faites cuire 35 mn à thermostat 6 (180°C).', 'Servez tiède ou froid.'], ['Mixeur', 'Rouleau à pâtisserie', 'Pince de cuisine', 'Spatule', 'Râpe'], ['entrée', 'tarte au chocolat', 'banane', 'recettes de cuisine', 'crème fraîche épaisse', 'rhum', 'confiserie', 'testées', 'très facile', 'bon marché', 'pâte sablée', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'noix de coco rapée', 'dessert', 'plat de résistance', 'Tarte banane et chocolat blanc', 'chocolat blanc', 'sucre', 'cocktail'], 'Dessert', 45e798d4-d4e4-433a-9b13-87a793f474e7, '2025-09-26T15:52:48.711305', [{'ingredient_id': 'b7bfee4a-44f4-4c37-aa6f-c877bc5b7a7a', 'quantite': '4'}, {'ingredient_id': 'a140189a-5de2-40b5-b4a6-1a9b1e8eb28a', 'quantite': '1'}, {'ingredient_id': '631f1913-1a64-4f70-ac0f-59646f874926', 'quantite': '200 g'}, {'ingredient_id': 'd0985f4e-b57c-4ef3-875d-83d01265cf80', 'quantite': '50 g'}, {'ingredient_id': '0be657d2-cd33-441e-a508-8d57d9406d42', 'quantite': '1 cuillères'}, {'ingredient_id': 'ad2098dc-e6fd-4132-9c34-dacd43aa21bf', 'quantite': '100 g'}, {'ingredient_id': 'f8dbb1dd-bf53-44b2-9ed6-4b69c634a87b', 'quantite': '50 cl'}, {'ingredient_id': '66608031-ca5e-4719-8b7e-b1236452e754', 'quantite': '20 cl'}, {'ingredient_id': '0085bb88-8eed-4ebd-af7e-b64db8abe99a', 'quantite': '5'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (55070, 'Milk shake à la banane exotique', 'lait, banane, glace vanille, cannelle, gingembre', '10 min', ['Mixer les bananes dans un shaker.', 'Une fois les bananes mixées, rajouter la moitié du lait et la boule de glace.', 'Ensuite remixer... Rajouter le reste du lait (pas forcément tout le demi litre, tout dépend de la texture souhaitée). ', 'Pour finir, rajouter la cannelle et le gingembre et mixer à nouveau...', 'C''est prêt !'], ['Casserole', 'Moule à tarte', 'Râpe'], ['', 'gingembre', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'glace vanille', 'dessert', 'plat de résistance', 'cannelle', 'lait', 'cocktail', 'Milk shake à la banane exotique'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:52:52.256354', [{'ingredient_id': '7bda678b-4d35-4865-8d9d-dda986109ae9', 'quantite': '1 l'}, {'ingredient_id': '3620175b-7a44-40f2-a784-7ac6e24a97c0', 'quantite': '2'}, {'ingredient_id': 'd0ac1d73-fee1-45e1-a85a-0607afe86225', 'quantite': '1'}, {'ingredient_id': 'aabaddc1-b620-4714-9445-e16c99f2c987', 'quantite': ''}, {'ingredient_id': '97b401f3-8a17-461a-b45b-390120595606', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (28640, 'poulet coco -amandes -banane', 'escalope de poulet, purée de tomate, banane, crème de coco, gingembre, noix de coco rapée, amandes, amandes effilées, poivre, sel, cube de bouillon', '10 min', ['1) Dans de l''eau frémissante faire cuire les 4 escalopes de poulet mélangées au bouillon de poule. ', '2) dans une casserole (wok), à feu doux, mélanger la purée de tomate, la crème de coco, le gingembre et laisser mijoter 10 mn. ', '3) introduire à la sauce, les escalopes puis la coco rapée etles amandes rapées. laisser mijoter10 mn. ', '4) une fois la sauce épaissie, introduire la banane coupée en rondelles moyennes (en mettre deux si vos convives apprécient ce fruit!) Ajouter à cela, les amandes effilées. ', 'Laisser mijoter à nouveau 10 mn. ', 'Saler poivrer si vous le souhaitez. ', 'Puis servir chaud. ', 'Attention : la sauce ne doit pas être liquide ! elle est épaisse et s''apprécie comme telle.'], ['Batteur électrique', 'Louche'], ['amandes', 'poulet en sauce', 'gingembre', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'purée de tomate', 'facile', 'bon marché', 'plat', 'escalope de poulet', 'recette', 'cube de bouillon', 'cuisine', 'recettes', 'boisson', 'crème de coco', 'noix de coco rapée', 'dessert', 'plat de résistance', 'poulet coco -amandes -banane', 'poivre', 'amandes effilées', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:52:55.872335', [{'ingredient_id': 'c0f9ad54-38ae-4401-971c-7e3e97a23a45', 'quantite': '4'}, {'ingredient_id': '47cd4962-dbbf-4ace-927e-45512aac5749', 'quantite': '500 ml'}, {'ingredient_id': '05296a51-53b2-4a9f-91ac-653cf54dc3f6', 'quantite': '1'}, {'ingredient_id': 'e99a1a0c-39c0-4c3d-b416-54b5b95db455', 'quantite': '500 ml'}, {'ingredient_id': '601a973f-ec53-44d4-bf1a-7ffb851e7632', 'quantite': '2 cuillères'}, {'ingredient_id': 'c2955b11-36a8-4c69-8789-3afc0ee402bd', 'quantite': '3 cuillères'}, {'ingredient_id': '9c836d88-e9d0-49f9-9d84-4fbcd0f89468', 'quantite': '3 cuillères'}, {'ingredient_id': 'f270f9e0-52af-45e4-88c2-6259ecc39abf', 'quantite': '3 cuillères'}, {'ingredient_id': 'a84e26e1-77a6-46fa-b380-82348a04a4ad', 'quantite': '1'}, {'ingredient_id': '989a998d-8844-47b0-a136-891e38796c28', 'quantite': ''}, {'ingredient_id': 'b4c2b6ab-2783-4660-894f-f0c2faa33dae', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (50194, 'Milk-shake coco banane', 'lait écrémé, glace à la noix de coco, banane', '5 min', ['Mixez tous les ingrédients pendant 3 minutes.', 'Versez dans de grands verres et ajoutez des pailles.', 'Voilà c''est déjà prêt et délicieux !'], ['Mixeur', 'Rouleau à pâtisserie'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'lait écrémé', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Milk-shake coco banane', 'glace à la noix de coco', 'dessert', 'plat de résistance', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:53:00.176029', [{'ingredient_id': 'cfab9753-1667-44d5-aa45-cb4d4622ccd3', 'quantite': '40 cl'}, {'ingredient_id': '86ac7887-d246-46f4-b833-35c13cdd6926', 'quantite': '4'}, {'ingredient_id': '2b4bd91f-0382-4440-980d-ad913e344687', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (19043, 'Muffins à la banane et aux corn-flakes', 'farine, levure, corn flakes, muscade, lait écrémé, cannelle, cassonade, sel, oeuf, huile, banane', '15 min', ['Mélangez ensemble la farine, la levure, le sel, les épices, la cassonade et les céréales. Mettre de côté. ', 'Dans un grand saladier mélangez l''oeuf, le lait et l''huile puis ajoutez les bananes. ', 'Mélangez les deux préparations ensemble puis remplir des moules à muffins avec la pâte obtenue. ', 'Cuire environ 20 min à 200°C (thermostat 6-7) où jusqu''à ce que les muffins brunissent.'], ['Presse-agrumes', 'Ouvre-boîte', 'Casserole'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'lait écrémé', 'testées', 'Muffins à la banane et aux corn-flakes', 'cassonade', 'corn flakes', 'muscade', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'huile', 'farine', 'dessert', 'plat de résistance', 'muffin', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:53:04.014757', [{'ingredient_id': '48f3c17e-0b6c-41eb-9384-2b7f597d8ba3', 'quantite': '1'}, {'ingredient_id': 'dd53d4ed-ac71-488d-980f-8cf5778501ab', 'quantite': '1 cuillères'}, {'ingredient_id': '1dcaa266-8f86-4103-98e8-0337a168c2fd', 'quantite': '2'}, {'ingredient_id': 'f2f52b63-58e1-421a-97d5-23d92b49cdf2', 'quantite': ''}, {'ingredient_id': 'd2881aaf-f927-44a6-b9c6-d6ee78a76145', 'quantite': ''}, {'ingredient_id': 'c9fca7ad-6970-458e-9a39-9cbb0270429e', 'quantite': ''}, {'ingredient_id': '86dc1327-c878-4d3c-818f-c16eb184df12', 'quantite': ''}, {'ingredient_id': '129b5698-324d-4de3-be51-7550ea3d7f4d', 'quantite': ''}, {'ingredient_id': 'e3f4172a-4a44-4cdf-9a53-c86a776c6fbc', 'quantite': '1'}, {'ingredient_id': '8b3b6b65-2d66-4586-b360-f179d1690c65', 'quantite': ''}, {'ingredient_id': '07b69406-de68-4f0b-bbf2-157f5cfd38a3', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (80295, 'Smoothie ET fruits', 'kiwi, banane, pêche, fraises, framboises, smoothie', '15 min', ['Préparation: 15 min', 'Cuisson: 0', 'Ingrédients (pour 4 personnes):', 'Couper tous les fruits en fines tranches. ', 'Le mieux est d''utiliser un coupe-oeuf, à condition que les fruits ne soient pas trop mûres. ', '- Sur une petite assiette ronde, disposer les tranches d''un kiwi sur le bord extérieur. ', 'Puis sur le périmètre intérieur, disposer les rondelles d''une banane et ainsi de suite avec la demie pêche et la fraise. ', 'Disposer quelques framboises par-ci, par-là.', 'Faire de même sur les 4 assiettes.', 'Au centre des assiettes, disposer une petite verrine avec un smoothie au choix.', 'Garnir les verrines d''une petite paille.', 'Dessert idéal en été ! Mais peut être réalisé avec n''importe quel autre fruit au choix.'], ['Pince de cuisine', 'Économe', 'Planche à découper', 'Verre doseur'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'framboises', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'smoothie', 'dessert', 'Smoothie ET fruits', 'plat de résistance', 'moyen', 'pêche', 'cocktail'], 'Dessert', 0d8dcc02-8a59-40c8-b659-a5f609bd760b, '2025-09-26T15:53:08.618186', [{'ingredient_id': '7ce2fbfe-926a-45ff-b9c8-40827df524e1', 'quantite': '4'}, {'ingredient_id': '73b78f2d-7c03-4d64-ac8e-6e5a9cb6ae12', 'quantite': '4'}, {'ingredient_id': 'a71f991b-8892-4953-8d82-b9deca9139bd', 'quantite': '2'}, {'ingredient_id': '05f7c5d1-6103-48e6-9d7e-117b5f4848e1', 'quantite': '4'}, {'ingredient_id': '408b5a71-545a-4b3b-90ed-e66c2f72be45', 'quantite': '12'}, {'ingredient_id': '9c525121-013c-438d-a5e6-3833120d782b', 'quantite': '50 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (52500, 'Crumble banane nutella', 'farine, beurre, sucre, noix de coco rapée, banane, Nutella', '20 min', ['Préchauffer le four à 200°C (thermostat 6-7).', 'Préparer la pâte à crumble :', 'Dans un saladier, mettre la farine, le sucre, la noix de coco râpée et les dés de beurre froid.', 'Mélanger et émietter du bout des doigts pour obtenir une pâte "sableuse".', 'Se munir de 4 ramequins et les beurrer légèrement.', 'Dans chaque ramequin, couper la moitié d''une banane puis recouvrir d''une grosse cuillère de nutella et finir par une couche de pâte à crumble.', 'Mettre au four 20-25 minutes en surveillant.', 'Servir tiède.'], ['Ouvre-boîte', 'Presse-agrumes', 'Batteur électrique', 'Rouleau à pâtisserie', 'Tire-bouchon'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'crumble banane', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'noix de coco rapée', 'Nutella', 'dessert', 'plat de résistance', 'beurre', 'Crumble banane nutella', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:53:14.424503', [{'ingredient_id': 'ed32ab91-3a18-4089-930a-41f54478e12c', 'quantite': '50 g'}, {'ingredient_id': '5837eda9-02d8-45cf-9c5a-9ffd1418e4e1', 'quantite': '50 g'}, {'ingredient_id': 'b908e9dd-d023-46c8-9b11-98643c967701', 'quantite': '50 g'}, {'ingredient_id': '6343b4a0-c0d1-4a59-83d2-20b1a4e400a0', 'quantite': '20 g'}, {'ingredient_id': 'be71b265-806c-4f66-9ade-f00873c70f46', 'quantite': '2'}, {'ingredient_id': 'd076ca92-560f-4435-962f-eaff5d2c24f2', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (175866, 'Salade de fruits gourmands à la gelée de rose', 'banane, nectarine, prune, raisin blanc, fraises, framboises, citron, vin rosé, sirop de canne, eau, agar-agar, menthe', '40 min', ['Coupez les grains de raisin en deux et épépinez-les. Placez de façon équitable dans le fond de chaque verrine. ', 'Coupez la prune en petits dés, répartissez dans les verrines. Faites de même pour la nectarine, la banane et les fraises, à chaque fois en les plaçant en couches successives dans les verrines. ', 'Terminez par les framboises. ', 'Versez sur les fruits de chaque verrine, 1 à 2 cuillères à café de jus de citron pour éviter que les fruits brunissent. ', 'Dans une casserole, versez le vin et le sirop de canne ; faites-les cuire à feu moyen de manière à ce que le surplus d’alcool du vin s’évapore, et ce pendant 8 minutes, puis ajoutez l’agar-agar et faites bouillir pendant 2 minutes en remuant jusqu’à sa dissolution complète. ', 'Éteignez le feu et laissez reposer 3 ou 4 minutes, puis ajoutez 2 cuillères à soupe pleines d’eau de rose. Mélangez bien, goûtez pour ajuster selon votre goût la quantité d’eau de rose (mais il ne faut pas non plus que ce soit la saveur dominante, d’autant qu’elle exhale tout son arôme en refroidissement, alors soyez vigilant sur ce dosage). ', 'Versez immédiatement (oui, le liquide est encore chaud) dans les verrines jusqu’à recouvrir tous – ou presque – les fruits. ', 'Couvrez les verrines d’un film alimentaire et placez-les au réfrigérateur pendant un minimum de 2 heures, 4 idéalement.', 'Au moment de servir, placez une feuille de menthe au-dessus de chaque verrine pour la décoration.'], ['Ouvre-boîte', 'Verre doseur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'assez cher', 'agar-agar', 'menthe', 'nectarine', 'framboises', 'sirop de canne', 'prune', 'rapide', 'plat', 'moyenne', 'fraises', 'recette', 'raisin blanc', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'vin rosé', 'Salade de fruits gourmands à la gelée de rose', 'citron', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:53:18.086611', [{'ingredient_id': '52ffc11a-f51c-44b8-a20b-26e5f01f4eee', 'quantite': '1'}, {'ingredient_id': 'fc87d41a-1339-4763-8d25-6e98ba419abd', 'quantite': '1'}, {'ingredient_id': 'c6a4e260-177f-4f82-a2fb-856f6cef3b76', 'quantite': '1'}, {'ingredient_id': '3b78cbcd-ee49-49ff-b249-299b0a9c18e0', 'quantite': '20'}, {'ingredient_id': '0781e2ab-f4a6-4f01-a69e-c03dee99afc4', 'quantite': '16'}, {'ingredient_id': '92c5f852-1293-4f4b-a904-ffba94098f77', 'quantite': '30'}, {'ingredient_id': '192636a3-3b1e-4799-b4f2-1224f494bee3', 'quantite': '1'}, {'ingredient_id': '496ef29a-70d4-437b-a08f-8ea9cb066a0d', 'quantite': '60 cl'}, {'ingredient_id': '492c6021-87c1-4f3f-81e9-07caf93cc4c7', 'quantite': '15 cl'}, {'ingredient_id': '9cff5b33-11fa-419c-a1bd-49ebe9f5bfa2', 'quantite': '2 cuillères'}, {'ingredient_id': '70f131fb-0c99-4a9e-a7d2-9be00b52fd45', 'quantite': '3 g'}, {'ingredient_id': 'cd766d17-4b40-450a-9e1c-acac7987bb5b', 'quantite': '6'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (47338, 'Petit pot à la banane, chocolat et crème', 'banane, nappage chocolat, crème, sucre vanillé', '5 min', ['Découper les bananes en rondelles.', 'Prendre 4 ramequins, y disposer les rondelles de bananes.', 'Faire fondre le chocolat au bain-marie et le verser sur les rondelles de bananes. Ajouter la crème dessert vanillée.', 'Parsemer les ramequins de sucre vanillé et les passer 5 minutes sous le grill, pour obtenir une belle coloration.'], ['Pince de cuisine', 'Balance de cuisine', 'Fouet', 'Verre doseur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'crème', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'crème au chocolat', 'sucre vanillé', 'Petit pot à la banane', 'nappage chocolat', 'cocktail', 'chocolat et crème'], 'Dessert', 38892ca1-8dc3-4265-a14c-885b1e992063, '2025-09-26T15:53:22.975348', [{'ingredient_id': 'bf14ee62-f1be-477e-a92a-0c97028c9058', 'quantite': '2'}, {'ingredient_id': '915c4411-ecd6-407d-a024-875a3cb4d159', 'quantite': '100 g'}, {'ingredient_id': 'd56ede0e-02b0-44a0-bf9a-b75cb9c7a182', 'quantite': ''}, {'ingredient_id': '9094af6b-e1fa-4582-b418-9609f916ee6f', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (32669, 'Délice de pomme, banane et framboise', 'pomme, banane, framboises', '15 min', ['Couper la pomme en dés, placer ceux-ci dans un plat allant au micro-onde, et faire cuire 5 à 10 mn selon la puissance de votre micro-onde. ', 'Une fois cuit, incorporer les brisures de framboises encore surgelées, puis incorporer également la banane écrasée. ', 'On peux aussi faire cuire la pomme avec de la rhubarbe c''est délicieux !'], ['Batteur électrique', 'Râpe', 'Pince de cuisine', 'Couteau de chef'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'framboises', 'bon marché', 'rapide', 'plat', 'Délice de pomme', 'banane et framboise', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:53:26.503777', [{'ingredient_id': 'a9dc152f-7c53-4897-8bb8-e38415b1636b', 'quantite': '1'}, {'ingredient_id': '3ac52cba-20c6-49d1-83f3-bd72794fc1e8', 'quantite': '1'}, {'ingredient_id': '7aad7d80-494b-404e-a975-4a127960b92d', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (58774, 'Milk-shake énergie', 'lait, framboises, kiwi, banane, yaourt, glace', '5 min', ['Mixer les framboises, les kiwis, la banane et le yaourt puis ajouter le lait et la glace pilée.', 'Déguster aussitôt.'], ['Mixeur', 'Rouleau à pâtisserie'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'très facile', 'framboises', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'glace', 'dessert', 'plat de résistance', 'moyen', 'Milk-shake énergie', 'lait', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:53:31.014914', [{'ingredient_id': '0daee1f0-18cb-4ff1-be4c-e822163c64cb', 'quantite': '1 l'}, {'ingredient_id': '24ad6b96-6af0-40ce-be00-d0f9fa81dc3a', 'quantite': '250 g'}, {'ingredient_id': '4c34e2bd-9354-4778-9931-e83cf21ad000', 'quantite': '3'}, {'ingredient_id': '902de667-a308-4149-9dfd-f1144621037d', 'quantite': '1'}, {'ingredient_id': 'a44959e6-2e52-4251-8e8c-d4f1d9e36b1a', 'quantite': '1'}, {'ingredient_id': 'babedd92-c8d3-4203-a116-45b498b6982b', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (86625, 'Compote originale', 'banane, pomme, grenade, clémentine', '20 min', ['Enlevez la peau des bananes, épluchez la peau de la pomme.', 'Coupez les deux extrémités de la grenade. ', 'Après cela, coupez la grenade en quartiers.', 'Immergez les quartiers séparés dans un bol d''eau. ', 'Libérez les grains avec vos doigts. Les grains vont couler dans le fond du bol et la membrane de la grenade va flotter à la surface.', 'Enlevez la membrane et jetez-la. ', 'Prenez les grains égouttés.', 'Versez le jus de clémentine et mettez le tout (bananes, pomme, grains de grenades et jus de clémentine) dans la casserole. ', 'Faites cuire à feu doux pendant 30 min avec un peu d''eau. ', 'Mixez, passez, servez...'], ['Ouvre-boîte', 'Passoire', 'Spatule', 'Tire-bouchon', 'Pince de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Compote originale', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'clémentine', 'dessert', 'plat de résistance', 'pomme', 'cocktail', 'grenade'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:53:35.570922', [{'ingredient_id': '4a2b7d6d-dbcb-4269-9b94-c1d073bb5576', 'quantite': '3'}, {'ingredient_id': '81c27113-f16b-4c69-a175-b4f53eb9e6db', 'quantite': '1'}, {'ingredient_id': 'b22d5e55-620d-4abc-ad69-39265356524e', 'quantite': '1'}, {'ingredient_id': 'f736254e-c073-46ad-8e41-f8bebd8442e5', 'quantite': '20 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (347953, 'Curry de poulet aux pommes et bananes', 'poulet, curry, oignon, pomme, banane, crème fraîche épaisse, huile d''olive', '30 min', ['Couper le poulet en cubes.', 'Les saupoudrer avec une cuillère de curry.', 'Émincer l''oignon en petits morceaux.', 'Faire revenir l''oignon dans une cocotte avec l''huile d''olive.', 'Ajouter la cuillère de curry.', 'Mettre le poulet dans la cocotte. Ajouter les pommes coupées en cube et les bananes ainsi que la crème fraîche.', 'Laisser cuire environ 20min.'], ['Fouet', 'Couteau de chef', 'Casserole'], ['poulet', 'banane', 'entrée', 'recettes de cuisine', 'crème fraîche épaisse', 'confiserie', 'testées', 'curry de poulet', 'plat', 'moyenne', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'huile d''olive', 'dessert', 'Curry de poulet aux pommes et bananes', 'plat de résistance', 'pomme', 'moyen', 'curry', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:53:39.225684', [{'ingredient_id': 'daf54026-5369-4096-a9a1-7d66939fdd16', 'quantite': '600 g'}, {'ingredient_id': '37464f51-6854-4026-b218-329519505be0', 'quantite': '1 cuillères'}, {'ingredient_id': 'f98ec0dc-bde3-4a6a-ae7d-1978fdb57637', 'quantite': '1'}, {'ingredient_id': 'dff6c85b-1a45-4365-9086-e86f2651fa7c', 'quantite': '3'}, {'ingredient_id': '8563a02a-6560-40d7-8174-6d92d63b5630', 'quantite': '2'}, {'ingredient_id': '77bf559b-93c2-4607-818a-86557c69cbd0', 'quantite': '3 cuillères'}, {'ingredient_id': '39912c55-47e9-46ec-b216-90514820b4d2', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (47201, 'Tarte à la banane et pépites de chocolat', 'pâte sablée, banane, crème fraîche liquide, oeuf, sucre en poudre, chocolat, noix de coco rapée', '20 min', ['Mettre la pâte sablée dans un moule à tarte avec la feuille de cuisson. Piquer la pâte à l''aide d''une fourchette.', 'Découper les bananes en rondelles et les positionner dans le fond de la tarte. Saupoudrer de coco râpée et de pépites.', 'Dans un saladier, battre les oeufs avec la crème et le sucre.', 'Verser cette préparation sur les bananes et enfourner à 180°C (thermostat 6) pendant 30 min.'], ['Rouleau à pâtisserie', 'Presse-agrumes', 'Spatule', 'Verre doseur', 'Batteur électrique'], ['entrée', 'tarte au chocolat', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'très facile', 'pâte sablée', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'crème fraîche liquide', 'cuisine', 'recettes', 'boisson', 'noix de coco rapée', 'Tarte à la banane et pépites de chocolat', 'dessert', 'plat de résistance', 'moyen', 'cocktail'], 'Dessert', 71c9ca45-db91-435e-a690-b967ebfffa8f, '2025-09-26T15:53:42.752673', [{'ingredient_id': 'd6631a67-de3f-4cab-a204-f16b52a74b87', 'quantite': '1'}, {'ingredient_id': 'b4bd469e-9d9b-49d2-bedc-ac802a02f4a6', 'quantite': '3'}, {'ingredient_id': '77a93003-e2cb-405a-ba2d-b8477d88fa86', 'quantite': '20 cl'}, {'ingredient_id': 'ce3f9c15-117e-425d-a1c9-6f57b7c9fa41', 'quantite': '3'}, {'ingredient_id': '592141b1-5cab-4096-b932-6cd3e3765ff8', 'quantite': '80 g'}, {'ingredient_id': '317d8788-b032-4567-bd88-dcf546514d6c', 'quantite': ''}, {'ingredient_id': 'd52e45a9-2f95-4a54-892b-bbaf3db08186', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (66798, 'Tarte créole aux bananes, ananas et noix de coco', 'pâte sablée, banane, noix de coco rapée, crème fraîche, oeuf, ananas, sucre semoule', '15 min', ['Préchauffer le four à 210°C (thermostat 7).', 'Etaler la pâte de votre choix (garder le papier pour éviter qu''elle ne colle) et en piquer le fond avec une fourchette. Réserver au réfrigérateur.', 'Casser les oeufs dans un saladier.', 'Ajouter 100 g de sucre en poudre et fouetter jusqu''à l''obtention d''un mélange mousseux.', 'Ajouter la crème fraîche et la moitié de noix de coco. Fouetter à nouveau et réverver.', 'Répartir les rondelles de bananes et les tranches d''ananas coupés en morceaux sur le fond de tarte.', 'Verser la crème à la noix de coco dessus et saupaudrer avec la noix de coco restante ainsi qu''avec le reste de sucre.', 'Mettre au four pendant 25 à 30 min.', 'Votre tarte doit être bien colorée. Bon appétit !'], ['Verre doseur', 'Balance de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'très facile', 'bon marché', 'pâte sablée', 'oeuf', 'plat', 'tarte à la banane', 'recette', 'cuisine', 'recettes', 'sucre semoule', 'boisson', 'noix de coco rapée', 'dessert', 'plat de résistance', 'Tarte créole aux bananes', 'ananas', 'ananas et noix de coco', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:53:46.360528', [{'ingredient_id': '4ea67451-df8a-4c26-b3f5-b0d574cccdfb', 'quantite': '1'}, {'ingredient_id': 'f846368a-e029-4994-aa0c-ad6e7049e8b7', 'quantite': '2'}, {'ingredient_id': '840ff85b-86ed-4228-b963-916ff2a53a59', 'quantite': '75 g'}, {'ingredient_id': 'eecfe8d8-67f1-4871-b977-77834aac2609', 'quantite': '250 g'}, {'ingredient_id': 'f0b6f566-1e48-43ef-b2d8-1e6fc90d0c59', 'quantite': '4'}, {'ingredient_id': '1b6ffb9e-7e24-4f34-bef8-8157c40eb6c1', 'quantite': '4'}, {'ingredient_id': '9991cece-5caf-45a4-89f0-07ad248fab4f', 'quantite': '150 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (59355, 'Esquimaux de banane', 'banane, chocolat, vermicelles', '30 min', ['Epluchez les 4 bananes.', 'Plantez des bâtons d''esquimaux dedans.', 'Mettez les bananes dans le freezer jusqu''à ce qu''elles soient dures (c''est pour que les bâtons tiennent).', 'Cassez le chocolat en morceaux. Faites fondre les morceaux de chocolat.', 'Trempez les bananes dans le chocolat.', 'Saupoudrez les de vermicelles multicolores.', 'Remettez les bananes dans le congélateur jusqu''à que le chocolat prenne.'], ['Passoire', 'Mixeur', 'Presse-agrumes', 'Batteur électrique'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'très facile', 'vermicelles', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'Esquimaux de banane', 'plat de résistance', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:53:50.784134', [{'ingredient_id': 'e66d4ec5-cf80-47c8-b364-9b0010d5d17a', 'quantite': '4'}, {'ingredient_id': '9bc0210e-5823-43f9-8171-76cbb5d76907', 'quantite': '1'}, {'ingredient_id': '829d835a-446a-4a44-9a02-a32b335484d4', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (13812, 'Bananes en chemise', 'banane, jambon blanc, moutarde', '10 min', ['Tartiner les tranches de jambon avec un peu de moutarde. Ne pas oter le gras.', 'Peler les bananes et les enrouler dans leur  ''chemise'' de jambon.', 'Placer les bananes dans un plat beurré.', 'Mettre sous le grill chaud du four environ 15 mn jusqu''à ce que les bananes soient convenablement rôties.'], ['Mixeur', 'Spatule', 'Râpe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'Bananes en chemise', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'jambon blanc', 'dessert', 'plat de résistance', 'moutarde', 'cocktail'], 'Entrée', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:53:54.295484', [{'ingredient_id': 'a7825861-df19-4527-af87-4c1b822b1de8', 'quantite': '1'}, {'ingredient_id': '3317a55e-7a78-4f77-8324-0c577d8b1739', 'quantite': '1'}, {'ingredient_id': '15489367-0e36-4cad-9f97-f600d9dcffef', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (348542, 'Banana bread en bocal', 'banane, chocolat, cacao, farine, cassonade, beurre, oeuf, levure, sel', '15 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Réserver une banane et écraser les 2 autres à la fourchette.', 'Mélanger le sucre avec le beurre jusqu''à l''obtention d''une crème lisse.', 'Ajouter les oeufs et battre bien le tout.', 'Ajouter le cacao, la farine, la levure, les bananes écrasées et le sel en une fois et mélanger bien.', 'Faire fondre le chocolat et ajouter à la préparation.', 'Verser la pâte dans un bocal préalablement beurré et fariné. Attention à ne pas remplir jusqu''en haut.', 'Eplucher la banane réservée et l''enfoncer au milieu du bocal (ce n''est pas grave si elle dépasse de la pâte, le gâteau va lever pendant la cuisson).', 'Enfourner 45 minutes.', 'Laisser tiédir avant de démouler.'], ['Spatule', 'Passoire'], ['', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'cassonade', 'chocolat', 'très facile', 'Banana bread en bocal', 'bon marché', 'cacao', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'beurre', 'cocktail'], 'Dessert', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T15:53:57.991286', [{'ingredient_id': 'e86f40d7-e5dc-4860-9a34-7e94234463c3', 'quantite': '3'}, {'ingredient_id': '913e3db0-ec45-4018-b5b9-1da359b67383', 'quantite': '130 g'}, {'ingredient_id': 'c0d7acc7-9228-4187-8d5a-9631366ae180', 'quantite': '30 g'}, {'ingredient_id': '81a13f17-44f2-4226-9fb0-c01b3c41aa91', 'quantite': '180 g'}, {'ingredient_id': '7b29a052-16ea-42b5-abd1-43d56a1589ac', 'quantite': '80 g'}, {'ingredient_id': 'af0bea8f-ccbc-4c34-bc89-80face217973', 'quantite': '120 g'}, {'ingredient_id': 'a5b52f39-c3de-49e3-86c4-51993a40efa0', 'quantite': '2'}, {'ingredient_id': '3872fb5e-51ae-42fa-a9eb-e47a9925e1b6', 'quantite': '1'}, {'ingredient_id': 'bb88d276-340a-4411-8942-d35e6c6a34b4', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (41957, 'Tarte soufflée bananes-noix de coco', 'pâte feuilletée, banane, noix de coco, sucre en poudre, oeuf, sucre vanillé, rhum', '15 min', ['Faire précuire la pâte feuilletée 10 min au four, à 180°C (thermostat 6).', 'Pendant ce temps, dans une terrine, écraser les bananes à la fourchette, ajouter la noix de coco, le sucre en poudre, 3 jaunes d''oeufs, le sucre vanillé, et le rhum.', 'Battre les blancs d''oeufs en neige très ferme, et les mélanger délicatement à la préparation.', 'Verser le tout sur le fond de tarte précuit, et remettre au four 30 min, à la même température.'], ['Moule à tarte', 'Verre doseur'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'tarte à la banane', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pâte feuilletée', 'sucre vanillé', 'Tarte soufflée bananes-noix de coco', 'noix de coco', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:54:01.642500', [{'ingredient_id': 'd6bcd3dc-cb29-457c-a302-57ff592b5509', 'quantite': '1'}, {'ingredient_id': '72ee6a31-1df7-42fb-a0a6-30cba32985a5', 'quantite': '4'}, {'ingredient_id': '499d85f8-b0d6-46dc-8217-36f7714723a0', 'quantite': '75 g'}, {'ingredient_id': '19271a11-0f4c-4318-9b71-af9adef0d710', 'quantite': '75 g'}, {'ingredient_id': 'af0b8b69-5917-425d-b525-5637ef2b79fd', 'quantite': '3'}, {'ingredient_id': '301472b6-4dad-4a4c-90c3-88516b8c8326', 'quantite': '1'}, {'ingredient_id': '6a247e8d-bdd4-410b-a260-deee02994a36', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (20272, 'Curry d''agneau', 'épaule, pomme, tomate, oignon, yaourt, bouillon de volaille, curry, gingembre, huile, cannelle, sel, poivre, noix de coco, pomme, orange, banane', '60 min', ['Dans un plat, mélanger le gingembre, le poivre, le sel et 3 cuillères d’huile. Mettre les morceaux à macérer pendant 1 h 30 . ', 'A part, faire dorer la viande avec le reste d’huile. La sortir et faire dorer les oignons émincés puis ajouter les tomates en dés. Laisser cuire 6 à 7 mn. ', 'Ajouter les pommes en dés, la cannelle et le curry. ', 'Mouiller avec le bouillon, couvrir et laisser cuire à feu moyen 1 h 15 environ. ', 'En fin de cuisson, ajouter le yaourt. ', 'Servir avec du riz ou de la semoule de couscous, entouré de quelques ingrédients ci-dessus qui servent à la décoration.'], ['Couteau de chef', 'Moule à tarte', 'Mixeur'], ['gingembre', 'entrée', 'recettes de cuisine', 'yaourt', 'sel', 'confiserie', 'testées', 'très facile', 'tomate', 'plat', 'bouillon de volaille', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'huile', 'dessert', 'plat de résistance', 'pomme', 'moyen', 'Curry d''agneau', 'épaule', 'cannelle', 'poivre', 'curry', 'viande à l''indienne', 'cocktail'], 'Plat principal', eedfd72e-b1a5-4900-b49d-f0f24d6014f6, '2025-09-26T15:54:05.275136', [{'ingredient_id': '0300d0fa-36a7-41b4-8bd6-6626abc105af', 'quantite': '1.8 kg'}, {'ingredient_id': '1cf943eb-044f-45bd-ad83-6ea61423c063', 'quantite': '2'}, {'ingredient_id': '97dce9bf-465b-473d-b989-2f1de16d43b4', 'quantite': '2'}, {'ingredient_id': 'd1050ea6-4773-4632-8f68-aaab2dbb4e54', 'quantite': '2'}, {'ingredient_id': '56a481cf-56e8-4094-8991-695140cdc095', 'quantite': '6 cuillères'}, {'ingredient_id': '1be50cc4-bfe9-44d5-b4ea-c07cada84265', 'quantite': '3'}, {'ingredient_id': 'd23ea3df-974d-4850-844a-a7cbab3b8bc7', 'quantite': '3 cuillères'}, {'ingredient_id': '310782d8-c962-4f52-8214-438511ff1b12', 'quantite': '1 cuillères'}, {'ingredient_id': '74f350c9-d9bb-49c8-a36e-6878fafda2e0', 'quantite': '6 cuillères'}, {'ingredient_id': '6aa3907d-9cb1-4fb8-b3a6-4c94e61c0c99', 'quantite': '1 cuillères'}, {'ingredient_id': '6d05e9d2-3b7f-41f4-bd78-142791a20dd1', 'quantite': ''}, {'ingredient_id': 'fec59bf0-eb3b-4f90-ab18-c8819530bd3c', 'quantite': ''}, {'ingredient_id': '24de3345-05d8-424b-b6f6-d759ef3bc809', 'quantite': ''}, {'ingredient_id': 'ecaa180c-7924-4bf4-b274-50262934e1da', 'quantite': ''}, {'ingredient_id': '16e8bed7-f6e9-4f51-90df-e88b50dff05b', 'quantite': ''}, {'ingredient_id': 'b049fde6-4117-4251-b974-a69730fe7b98', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (40768, 'Curry de poulet antillais aux bananes', 'escalope de poulet, banane, raisins secs, lait de coco, yaourt nature, ail, oignon, citron vert, curry, beurre, poivre, sel', '20 min', ['Râpez le zeste des citrons, pressez leur jus. Mettez le tout dans un plat creux avec le lait de coco, la moitié du curry, salez, poivrez, et mélangez les escalopes de poulet dans cette marinade. ', 'Réservez une heure.', 'Pelez et hâchez l''ail et l''oignon. Faites chauffer 30 g de beurre dans une cocotte, et faire revenir ces 2 ingrédients sans coloration 3 minutes avec le reste de curry.', 'Egouttez le poulet de sa marinade, ajoutez-le dans la cocotte, mélangez bien, faites dorer 2 minutes, puis ajoutez la marinade.', 'Laissez mijoter 7 minutes à feu doux à couvert, puis 7 minutes à feu moyen à découvert après avoir retourné une fois les escalopes.', 'Incorporez le yaourt en fin de cuisson, rectifiez l''assaisonnement en sel et poivre et mélangez. Gardez au chaud.', 'Chauffez 20 g de beurre dans une poêle. Faites revenir quelques minutes les bananes en rondelles avec les raisins secs jusqu''à ce que ces derniers soient bien gonflés.', 'Disposez les escalopes de poulet dans chaque assiette, recouvrir de sauce.', 'Servir avec un riz blanc (ex: basmati), décorez l''assiette de bananes et de raisins secs, et saupoudrez le tout de noix de coco râpée.', 'Servez bien chaud!'], ['Casserole', 'Planche à découper'], ['lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'yaourt nature', 'très facile', 'bon marché', 'curry de poulet', 'ail', 'plat', 'escalope de poulet', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'Curry de poulet antillais aux bananes', 'dessert', 'plat de résistance', 'beurre', 'raisins secs', 'citron vert', 'poivre', 'curry', 'cocktail'], 'Plat principal', 69297d9d-1a59-4225-aa7e-6ff0da85dc1e, '2025-09-26T15:54:11.131377', [{'ingredient_id': 'a7c9af8d-8630-409a-a364-ab99ef8becfc', 'quantite': '4'}, {'ingredient_id': 'c722021c-1beb-4777-bba3-3ded53461b6f', 'quantite': '2'}, {'ingredient_id': 'bc25fa32-6ac9-4371-aed0-8e3e6fac3260', 'quantite': '25 g'}, {'ingredient_id': '5183cd8d-e82a-4978-a388-08c96b433f95', 'quantite': '1'}, {'ingredient_id': '8f20ab43-9f47-4171-b36a-5f1a12105f32', 'quantite': '1'}, {'ingredient_id': '78cda0da-8f3f-45c5-88fd-71daf78ae4fa', 'quantite': '2'}, {'ingredient_id': 'f33d9f9f-a9b7-4be4-bb6e-807137928429', 'quantite': '1'}, {'ingredient_id': '4958ceaa-db93-4711-b177-1ed81e9e3304', 'quantite': '2'}, {'ingredient_id': '9f8e2331-1460-4c1f-a82d-538185bb4c88', 'quantite': '3 cuillères'}, {'ingredient_id': '56f8a55d-a2bd-418a-b358-ca716ab441fc', 'quantite': '50 g'}, {'ingredient_id': '163244bc-9392-4c24-b219-db26a85d17ab', 'quantite': ''}, {'ingredient_id': '2ca9b17f-ef1a-407f-8539-77d2012512a3', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (85834, 'Banane galante', 'banane, crème fleurette, caramel, café', '5 min', ['Couper la banane en 2 dans le sens de la longueur.', 'Napper le fond d''une assiette à dessert ou mieux d''une petite assiette creuse de caramel.', 'Déposer la banane de manière symétrique (face bombée vers le haut, les 2 parties de la banane formant un ovale).', 'Recouvrir délicatement de crème liquide.', 'Finir en saupoudrant de quelques pincées de café.'], ['Batteur électrique', 'Mixeur', 'Pince de cuisine', 'Rouleau à pâtisserie', 'Planche à découper'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'crème fleurette', 'caramel', 'bon marché', 'rapide', 'plat', 'recette', 'café', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cocktail', 'Banane galante'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:54:14.648596', [{'ingredient_id': '694a4aaa-dc8a-4e8a-8d70-bb8b11a1eb95', 'quantite': '1'}, {'ingredient_id': '0fd902e0-d7ca-4ffd-84c1-99f821d33b5d', 'quantite': '10 cl'}, {'ingredient_id': 'a7fe158b-19fb-4ad3-a2fd-dfa16df1ab45', 'quantite': '2 cuillères'}, {'ingredient_id': '3426d754-df92-49da-b69c-36920bc68a83', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (338387, 'Fondant choco-banane-pêche', 'oeuf, yaourt nature, chocolat en poudre, sucre, banane, pêche', '20 min', ['Battre les oeufs dans un saladier, ajouter le yaourt ainsi que le chocolat. Bien mélanger. Écraser les bananes à la fourchette et les ajouter au mélange.', 'Enfourner 25 minutes à 180°C.', 'Durant la cuisson, laver, éplucher les pêches, les faire fondre à feu doux avec le sucre. ', 'Ajouter la compote de pêche sur le dessus du gâteau, placer au réfrigérateur. ', 'Attendre au moins 1 heure avant la dégustation.'], ['Casserole', 'Presse-agrumes'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Fondant choco-banane-pêche', 'yaourt nature', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pêche', 'chocolat en poudre', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:54:19.118035', [{'ingredient_id': 'e75792c1-8cac-4a99-98c7-c469c25274f1', 'quantite': '3'}, {'ingredient_id': 'efd85e80-6306-48ad-a95f-f77ead69369b', 'quantite': '1'}, {'ingredient_id': 'e9a10db4-feff-485f-a029-dee29d97dd4c', 'quantite': '5 cuillères'}, {'ingredient_id': '59a3de00-fcca-4811-b1fd-db567c72d2c7', 'quantite': '5 cuillères'}, {'ingredient_id': '4afaa1eb-c489-4e9d-b03f-60e5b2c7d471', 'quantite': '2'}, {'ingredient_id': '3dda1c84-c7f3-4062-a498-268a14473c9a', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (232664, 'Punch lillois de Graine', 'rhum, abricot, jus d''orange, jus d''ananas, clémentine, banane, vanille, cannelle, sucre', '20 min', ['Mélanger tous les ingrédients.', 'Préparation d''environ 4 L à laisser macérer pendant au moins 4h histoire que les bananes et les clémentines apportent de la douceur à l''ensemble.'], ['Poêle', 'Fouet', 'Couteau de chef'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'abricot', 'Punch lillois de Graine', 'facile', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'vanille', 'punch', 'clémentine', 'dessert', 'plat de résistance', 'jus d''ananas', 'moyen', 'jus d''orange', 'cannelle', 'sucre', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:54:23.595596', [{'ingredient_id': '3725693f-f716-48cb-b178-531e276e7a49', 'quantite': '70 cl'}, {'ingredient_id': '58b6f7c6-baa4-4997-87bd-7b51ec738960', 'quantite': '1 l'}, {'ingredient_id': '5a5d8040-3b7c-48ad-a954-e9a68d5851c0', 'quantite': '1 l'}, {'ingredient_id': '249a5ab8-a13f-421e-9875-73c56a8b138f', 'quantite': '1 l'}, {'ingredient_id': 'ffb16946-3a73-49bc-93df-bd54c2bc391f', 'quantite': '2'}, {'ingredient_id': 'e5227fad-cf75-4885-a707-076d0fed9530', 'quantite': '3'}, {'ingredient_id': 'b5db95f2-24ee-4a1d-a85d-18fe1d82655b', 'quantite': '1'}, {'ingredient_id': 'fb3d433b-586a-4022-a99d-ce1d0e9ef6a6', 'quantite': '1 cuillères'}, {'ingredient_id': '117ef835-9360-4984-9051-b1ccd3a11841', 'quantite': '5'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (335972, 'Crème de banane au lait de coco', 'banane, lait de coco, citron vert, oeuf, crème fraîche, lait, sucre, maïzena, sucre vanillé, pistaches, sel', '15 min', ['Pelez les bananes et coupez-les en rondelles. ', 'Pressez le 1/2 citron vert. Mettez le lait de coco, le sucre, le sucre vanillé et 1 pincée de sel dans une casserole et portez à ébullition. ', 'Ajoutez les rondelles de banane puis, hors du feu, réduisez la préparation en purée.', 'Délayez la Maïzena dans le lait, ajoutez les oeufs et mélangez. ', 'Incorporez l''ensemble de la purée de banane. ', 'Portez cette préparation à ébullition sans cesser de tourner, puis versez-la immédiatement dans un saladier à travers un tamis et laissez refroidir en remuant de temps à autre. ', 'Fouettez la crème fraîche et incorporez-la, ainsi que le jus de citron, dans la crème de banane refroidie. ', 'Répartissez dans des coupelles et décorez de pistaches hachées.'], ['Mixeur', 'Rouleau à pâtisserie', 'Poêle', 'Balance de cuisine', 'Moule à tarte'], ['', 'lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'sel', 'confiserie', 'testées', 'facile', 'maïzena', 'bon marché', 'oeuf', 'plat', 'pistaches', 'recette', 'cuisine', 'recettes', 'Crème de banane au lait de coco', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'citron vert', 'lait', 'sucre', 'cocktail'], 'Dessert', 64058412-561b-4ff9-b5cc-1d7809a3ef3e, '2025-09-26T15:54:28.085561', [{'ingredient_id': '3f30d82e-cec5-4851-a6ad-b90a573cc2f2', 'quantite': '2'}, {'ingredient_id': '96f43675-6b03-4d38-ab5f-e2a4f90c0c36', 'quantite': '50 cl'}, {'ingredient_id': 'b85d5cba-d747-436c-961a-073887ef69e6', 'quantite': ''}, {'ingredient_id': '199c7ab8-e78e-427c-95e8-0ae2e206cf32', 'quantite': '2'}, {'ingredient_id': '42a4f0c0-ce24-4fcc-b34b-8ae715575cd2', 'quantite': '15 cl'}, {'ingredient_id': '7c6f3b2d-26c5-4966-8687-14c39fbf25ed', 'quantite': '10 cl'}, {'ingredient_id': 'a1ddc154-f6d9-4b52-9114-951b7e540cc9', 'quantite': '5 cuillères'}, {'ingredient_id': 'a49b11e6-cee1-4b14-9a19-8589e32adf4b', 'quantite': '1 cuillères'}, {'ingredient_id': '55bb1ca4-9301-42b4-a597-42578f766df3', 'quantite': '1'}, {'ingredient_id': '176eed49-e7e1-4660-9578-c4c524fe57b5', 'quantite': '100 g'}, {'ingredient_id': '2859c85a-4329-4492-b637-179f3d010943', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (65770, 'Salade de laitue sucrée salée', 'laitue, raisins secs, banane, citron, orange, sel, purée, miel d''acacia, orange', '20 min', ['Mettre les raisins à tremper dans un bol d''eau tiède.', 'Laver la laitue, l''égoutter et la couper grossièrement', 'Couper la banane épluchée en rondelles, détailler l''orange épluchée en quartiers, éplucher les grains de raisin.', 'Mettre tous les ingrédients dans un saladier, saler légèrement et arroser de jus de citron.', 'Dans un bol, mélanger la purée d''amandes coupée d''eau, le miel et le jus d''orange.', 'Verser l''assaisonnement sur la salade, mélanger délicatement et servir aussitôt.'], ['Rouleau à pâtisserie', 'Presse-agrumes', 'Planche à découper', 'Tire-bouchon', 'Poêle'], ['', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'cocktail', 'très facile', 'rapide', 'plat', 'Salade de laitue sucrée salée', 'recette', 'laitue', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'citron', 'orange', 'raisins secs', 'purée', 'miel d''acacia'], 'Entrée', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:54:32.511209', [{'ingredient_id': 'bd336a2a-c59a-4269-896d-f28d1c03e78f', 'quantite': '1'}, {'ingredient_id': '8795b0f0-716a-420d-8f96-e17d3e5b41f2', 'quantite': '50 g'}, {'ingredient_id': '7d032647-d23f-4604-95f3-ed8b4418d22b', 'quantite': '1'}, {'ingredient_id': '7a621f52-7707-45d0-9d71-1e25dea70de6', 'quantite': ''}, {'ingredient_id': '6529b3e2-10e7-49af-8425-39374cf8dd22', 'quantite': '1'}, {'ingredient_id': '42d60372-8c51-49a8-94f6-d9ff8b8c9376', 'quantite': ''}, {'ingredient_id': '99f3a463-80ce-4c4b-a264-f3d26744749a', 'quantite': '2 cuillères'}, {'ingredient_id': '6dc78ec7-2f50-4af9-853b-9941159bf295', 'quantite': '1 cuillères'}, {'ingredient_id': '255a2ece-505b-4b25-a4b9-cbbe08f288f5', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (27611, 'Tarte à la banane simplissisme', 'pâte brisée, banane, oeuf, crème fraîche, cannelle, sucre roux', '5 min', ['Etaler pâte brisée dans moule à tarte. ', 'Couper en rondelles les 4 bananes. ', 'Dans un saladier, mélanger oeufs, crème, sucre roux et cannelle. ', 'Ajouter cette préparation sur les bananes et mettre au four 3/4 d''heure à 180°C.'], ['Balance de cuisine', 'Batteur électrique'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'tarte à la banane', 'recette', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'Tarte à la banane simplissisme', 'dessert', 'plat de résistance', 'cannelle', 'cocktail', 'sucre roux'], 'Dessert', 08b29570-c378-4844-af50-6d4dda417f58, '2025-09-26T15:54:36.104427', [{'ingredient_id': 'f38c7f61-22a8-45b5-b998-6f0f7929c777', 'quantite': '1'}, {'ingredient_id': '15666661-4089-4782-a25e-12ec039900a1', 'quantite': '4'}, {'ingredient_id': '5b524310-3fbe-460c-9f63-d8029543a4df', 'quantite': '3'}, {'ingredient_id': 'b9f99639-06a6-4f15-9a1a-2649adf106f5', 'quantite': '3 cuillères'}, {'ingredient_id': '18ead526-ae90-42b7-b02d-d5ffc96c8a87', 'quantite': '1'}, {'ingredient_id': 'f99eea85-5498-4c68-be5c-39cb421fa4d1', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (62788, 'Croquettes de banane', 'banane, oeuf, chapelure, huile', '5 min', ['Coupez la banane en 3 les passez dans les oeufs batttus.', 'Roulez dans la chapelure et faites frire dans l''huile.'], ['Ouvre-boîte', 'Louche', 'Tire-bouchon', 'Économe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'Croquettes de banane', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'chapelure', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'dessert', 'plat de résistance', 'cocktail'], 'Accompagnement', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:54:39.628296', [{'ingredient_id': 'db961eb1-39c5-4f08-bfa5-665eedab29df', 'quantite': '4'}, {'ingredient_id': '3f8b99ac-29c5-4935-b5e0-1e219117a75e', 'quantite': '2'}, {'ingredient_id': '0b36339e-6b64-4f9a-b4a1-c5dfb4bcbe90', 'quantite': '1 cuillères'}, {'ingredient_id': '71c8a19d-29f6-4720-8512-79d03c83d1be', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (31497, 'tarte banane noix de coco', 'banane, sucre, rhum, oeuf, noix de coco, pâte feuilletée, lait', '10 min', ['Mettre la pâte feuilletée dans un moule à tarte et piquer le fond avec une fourchette. La cuire à blanc pendant 15 min. ', 'Pendant ce temps, mélanger le sucre, la noix de coco et les œufs. Ajouter le lait et faire épaissir le mélange sur feu doux. ', 'Enlever du feu et rajouter le petit verre de rhum. Couper les bananes en rondelles. ', 'Lorsque la pâte est cuite, verser le mélange oeufs-noix de coco-sucre-lait et déposer les rondelles de banane sur la tarte. ', 'La faire cuire à 180°C pendant 10 min.'], ['Passoire', 'Verre doseur', 'Spatule', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'tarte à la banane', 'recette', 'cuisine', 'recettes', 'boisson', 'tarte banane noix de coco', 'dessert', 'plat de résistance', 'pâte feuilletée', 'noix de coco', 'sucre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:54:43.285882', [{'ingredient_id': 'fde0f39d-ff82-4533-b846-1f6346ee5f15', 'quantite': '4'}, {'ingredient_id': '280fdecc-c753-4d9d-833d-03b4d2d044ca', 'quantite': '180 g'}, {'ingredient_id': '5aee0829-e85a-4a44-bb07-4a25dfacb833', 'quantite': '1'}, {'ingredient_id': '261299a0-f163-4994-8305-6a60e04d2415', 'quantite': '2'}, {'ingredient_id': 'b84888f4-e72a-4cc1-95c0-efa4af9cba6c', 'quantite': '80 g'}, {'ingredient_id': 'dad1d1a9-5b83-4005-add6-f4f4837e150c', 'quantite': '1'}, {'ingredient_id': 'ef1c69ec-d041-48be-8bde-309d8b3e3934', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (43091, 'muffins choco-banane', 'banane, chocolat pâtissier, sucre, oeuf, beurre, farine, levure chimique, chocolat', '10 min', ['Faire préchauffer le four 10 minutes à 180°C (thermostat 6)', 'Ecraser les bananes dans un récipient sans toutefois les réduire en purée.', 'Ajouter l''oeuf et le beurre préalablement ramolli.', 'Faire fondre le chocolat et l''ajouter à la préparation.', 'Ajouter ensuite le sucre, la farine et la levure.', 'Mélanger le tout jusqu''à l''obtention d''une pâte qui ne doit pas être totalement homogène.', 'Verser la pâte dans des moules à muffins ou des petits ramequins préalablement graissés.', 'Ajouter sur les muffins quelques pépites de chocolat.', 'Cuire au four à 180°C (thermostat 6) pendant 15 à 20 minutes.'], ['Ouvre-boîte', 'Planche à découper'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'chocolat', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'chocolat pâtissier', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'muffin', 'beurre', 'muffins choco-banane', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:54:49.993722', [{'ingredient_id': 'd3b02e96-4bf2-45e0-9c31-07bec7e6b82d', 'quantite': '3'}, {'ingredient_id': 'd3a82c8f-ec7a-4304-ab50-c7f01714c9aa', 'quantite': '50 g'}, {'ingredient_id': '1abee81f-f53f-473e-aceb-a4e07a79417f', 'quantite': '75 g'}, {'ingredient_id': 'dc61b32e-eda9-4af3-84f3-3f2f59133dcb', 'quantite': '1'}, {'ingredient_id': '806faedc-76e1-4ad4-abb7-2970795fb767', 'quantite': '75 g'}, {'ingredient_id': '45b3ce93-7a30-4446-9a69-66584788b390', 'quantite': '150 g'}, {'ingredient_id': '40a19576-3e43-49cb-a977-8c956153bec3', 'quantite': '2 cuillères'}, {'ingredient_id': '2dbfe8db-539f-4887-aaa7-1900bba5f348', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (334297, 'Summer smoothie', 'banane, pomme, orange, glaçons', '5 min', ['Couper les bananes en rondelles.', 'Couper les pommes en petits morceaux.', 'Mettre les fruits coupés dans le mixeur.', 'Ajouter les glaçons.', 'Presser les oranges et les ajouter au reste.', 'Mixer jusqu''à ce que les fruits soient bien mélangés.'], ['Casserole', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'glaçons', 'orange', 'Summer smoothie', 'smoothies', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:54:53.590184', [{'ingredient_id': 'b55b3402-943b-443c-9d22-a5b05d58c4b7', 'quantite': '2'}, {'ingredient_id': '1a7623ab-70bb-4f5c-8b1e-8df1bf875c9f', 'quantite': '2'}, {'ingredient_id': '376f7542-e2fe-4ac5-a3ff-e9a42ad788fc', 'quantite': '5'}, {'ingredient_id': '55047499-49ce-49ef-98aa-9368e2fce554', 'quantite': '6'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (383751, 'Crème de banane au Cookeo', 'banane, crème fraîche, yaourt à la grecque, cassonade, jus de citron, sucre vanillé', '5 min', ['Épluchez, puis coupez les bananes en petits morceaux. Déposez-les dans la cuve de votre Cookeo. Arrosez de jus de citron, ajoutez le reste des ingrédients, puis mixez. ', 'Dégustez immédiatement ou placez au frais pendant 15 minutes maximum.'], ['Spatule', 'Pince de cuisine', 'Balance de cuisine'], ['Crème de banane au Cookeo', 'yaourt à la grecque', 'banane', 'entrée', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'cassonade', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'jus de citron', 'cocktail', 'crème dessert'], 'Dessert', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T15:54:58.169153', [{'ingredient_id': '008a3800-dac4-4edb-ae05-cf9587916978', 'quantite': '4'}, {'ingredient_id': 'b778e662-0337-4881-b149-ef4726c91f57', 'quantite': '2 cuillères'}, {'ingredient_id': '15129aa2-8aaa-4f69-80bc-3c7c1f9c15d7', 'quantite': '2 cuillères'}, {'ingredient_id': '94dbd615-2564-49ae-b602-733492d2def7', 'quantite': '2 cuillères'}, {'ingredient_id': '4b7836d1-45b6-4e39-bf95-f3d682dfc4a0', 'quantite': '2 cuillères'}, {'ingredient_id': '47644078-fe7a-4265-8a38-bec4efcd6b48', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (17794, 'Entremets au chocolat et à la banane', 'beurre, chocolat amer, beurre, oeuf, banane, Liqueur, sirop de sucre de canne, jus de citron, sel', '5 min', ['Tapissez entièrement un moule à cake de film étirable ou de papier sulfurisé. Râpez le chocolat dans une terrine, ajoutez le beurre en petits morceaux puis placez-la dans un bain-marie sur feu modéré. Lorsque le chocolat est entièrement fondu, retirez la terrine du feu et remuez bien jusqu''à ce que le mélange soit homogène. ', 'Ajoutez ensuite les jaunes d''oeuf l''un après l''autre, en travaillant suffisamment pour obtenir une crème épaisse et lisse, puis 1 cuillère à soupe de liqueur de banane ou de rhum. Laissez refroidir complètement. ', 'Montez les blancs en neige ferme avec le sel et incorporez-les dans la crème bien froide. Préparez un sirop avec 5 cl d''eau, le sirop de sucre de canne et la liqueur de banane ou le rhum restant. Epluchez les bananes. Coupez-les en deux dans le sens de la longueur. ', 'Garnissez le fond du moule à cake d''une couche fine de préparation au chocolat. Couvrez-la d''une couche de petits-beurre rapidement trempés dans le sirop. Déposez dessus 2 demi-bananes, face coupée contre les gâteaux, puis masquez_les d''une couche de crème en remplissant les interstices. Tapissez à nouveau de petits-beurre trempés puis de 3 demi-bananes. Continuez ainsi le montage en terminant par des petits-beurre. Couvrez le moule de papier film et entreposez-le au frais jusqu''au lendemain. ', 'Pour servir, retirez le papier film. Renversez le moule sur le plat de service et enlevez le papier restant. Décorez le dessus du gâteau de rondelles de bananes citronnées. Coupez le gâteau en tranches avec un couteau trempé dans l''eau chaude et essuyé entre chaque opération.'], ['Spatule', 'Balance de cuisine', 'Casserole', 'Pince de cuisine'], ['sirop de sucre de canne', 'banane', 'entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'entremets', 'rapide', 'oeuf', 'plat', 'moyenne', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat amer', 'jus de citron', 'moyen', 'beurre', 'Entremets au chocolat et à la banane', 'Liqueur', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:55:01.879842', [{'ingredient_id': 'c4d4279e-5e84-4026-8f89-07df37703045', 'quantite': '24'}, {'ingredient_id': 'f40da751-089b-43dc-b072-c16c5195dd13', 'quantite': '250 g'}, {'ingredient_id': 'fa00a7ae-6f77-42a5-ac30-41d54c7fb502', 'quantite': '100 g'}, {'ingredient_id': '940a3d0b-63b1-47ce-a328-b4af8c808827', 'quantite': '3'}, {'ingredient_id': '6ed593cb-c108-49f9-8e74-e16171c577d1', 'quantite': '4'}, {'ingredient_id': 'b6f5ebec-24e8-4599-8d76-7359a8d8b014', 'quantite': '10 cl'}, {'ingredient_id': '65884223-3989-4214-b223-d838329fe791', 'quantite': '5 cl'}, {'ingredient_id': 'e08de4ab-ea53-4d21-be23-6c3124350efb', 'quantite': ''}, {'ingredient_id': 'f902b014-fcf1-4af2-ab7e-52e254bc7679', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (67426, 'Madeleine à la banane', 'farine, sucre, sel, levure chimique, oeuf, beurre, eau de fleur d''oranger, banane, lait', '15 min', ['Mélanger la farine, la levure, le sucre, le sel, les oeufs et le beurre fondu refroidi. Incorporer la fleur d''oranger et la banane mixée. ', 'Laisser reposer 5 minute au réfrigérateur. ', 'Préchauffer le four à 220°C (thermostat 7-8).', 'Après ce repos, ajouter le lait à la pâte. Mettre l''équivalent d''une cuillère à café de pâte dans les moules adaptés (moi je préfère les moules en silicones, ils n''adhèrent pas). Enfourner et baisser le four à 160°C (thermostat 5-6), laisser cuire 10 minute.', 'Bon appétit!!!'], ['Passoire', 'Batteur électrique'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'levure chimique', 'très facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'madeleine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'Madeleine à la banane', 'beurre', 'eau de fleur d''oranger', 'sucre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:55:05.581003', [{'ingredient_id': '4fbca7b0-10e4-4334-b47d-bfa950583d56', 'quantite': '200 g'}, {'ingredient_id': 'e42f69b9-b2d9-4cc5-97f9-ffcc3fad1b88', 'quantite': '120 g'}, {'ingredient_id': '1b415aea-553e-4da5-97de-5aa351fbb7a5', 'quantite': '1'}, {'ingredient_id': 'f771e20a-1e37-411f-a09f-b4cbc0e484e8', 'quantite': '1 cuillères'}, {'ingredient_id': 'a70d2c81-7b92-456d-9b90-f4823c7af14f', 'quantite': '3'}, {'ingredient_id': '4870321f-5b91-4859-9ccb-4c5fbf673c38', 'quantite': '100 g'}, {'ingredient_id': '7f4252af-e65e-44ea-993a-4b011c4368e2', 'quantite': '1 cuillères'}, {'ingredient_id': '6df362e8-93d9-420e-a12e-b1d7faf24c92', 'quantite': '1'}, {'ingredient_id': 'e82c87de-7ccf-448e-abe8-b5f30ea91b40', 'quantite': '10 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (35300, 'Poulet Saïb', 'poulet, margarine, oignon, curry, farine, tomate, ail, eau, banane, pomme, bouquet garni, poivre, sel, crème fraîche', '20 min', ['Hacher les oignons et les faire revenir quelques minutes dans la margarine avec les morceaux de poulet. ', 'Ajouter le curry, la farine, les tomates, l''ail, l''eau la banane, la pomme le bouquet garni et le sel. ', 'Couvrir et laisser mijoter 20 mn en cocotte ou 1 h en sauteuse. ', 'Quand le poulet est cuit, le réserver et laisser bouillir la sauce. La passer au mixeur ou au presse-purée. ', 'Au dernier moment, ajouter la crème fraîche et les morceaux de poulet. ', 'Se sert avec du riz pilaf parsemé d''amandes grillées.'], ['Passoire', 'Presse-agrumes', 'Mixeur', 'Économe'], ['', 'poulet', 'banane', 'entrée', 'recettes de cuisine', 'crème fraîche', 'sel', 'confiserie', 'eau', 'testées', 'facile', 'bouquet garni', 'bon marché', 'tomate', 'ail', 'plat', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'farine', 'margarine', 'Poulet Saïb', 'dessert', 'plat de résistance', 'pomme', 'poivre', 'curry', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:55:09.769668', [{'ingredient_id': 'f8139bd3-0774-482a-a194-ff50698995f8', 'quantite': '1'}, {'ingredient_id': '595d9b9f-0085-4353-ba45-bbd238e73fb3', 'quantite': '40 g'}, {'ingredient_id': '9d782f30-e778-486f-9d1d-aa2c85cfce4f', 'quantite': '2'}, {'ingredient_id': '7583c11b-42f3-43f8-9c4d-8a630e703f66', 'quantite': '1 cuillères'}, {'ingredient_id': '24d3e68e-c4ac-463a-bfbc-68d1b7c963b2', 'quantite': '1 cuillères'}, {'ingredient_id': 'ce4d5364-1c05-4e5b-b519-f12e92dae4dd', 'quantite': '2'}, {'ingredient_id': '81090662-b15c-4a5b-bfd3-54410c730314', 'quantite': '1'}, {'ingredient_id': '7af6295e-84d4-40de-8f01-b2a1c6406c30', 'quantite': '1'}, {'ingredient_id': '44557636-bb02-4740-a0fd-52a805c68c93', 'quantite': '1'}, {'ingredient_id': '17362d17-be4d-4447-ab26-2dccd4aaceb9', 'quantite': '1'}, {'ingredient_id': '965347e8-8ef7-45dd-865b-6481896bb53d', 'quantite': '1'}, {'ingredient_id': '389a599c-fd28-4ad7-8c5c-80db71238b8e', 'quantite': ''}, {'ingredient_id': '96ff3d2e-25b7-4b12-af28-99cf2c935e82', 'quantite': ''}, {'ingredient_id': 'd561edaf-2c6d-4635-adeb-869ecd2828ea', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (30004, 'Compote pomme banane au thé', 'pomme, banane, sucre roux, thé', '10 min', ['Couper les pommes en dés et les bananes en rondelles.', 'Dans une casserole, mettre le thé, les fruits et le sucre. Laissez cuire à feu doux 15 mn. LE mélange doit ainsi ''compoter''.', 'Laisser tiédir, puis servir sur un lit de fromage blanc.'], ['Planche à découper', 'Mixeur', 'Rouleau à pâtisserie'], ['Compote pomme banane au thé', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'compote de pomme', 'bon marché', 'thé', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:55:13.581237', [{'ingredient_id': 'da75e40a-cb9e-48b4-9254-955ff1326474', 'quantite': '3'}, {'ingredient_id': '12fa404d-36bb-4e3b-953f-3b419a93fea1', 'quantite': '1'}, {'ingredient_id': '9e623b53-c18c-4f81-94ee-b14de1ab1bfb', 'quantite': '40 g'}, {'ingredient_id': 'c451931e-69ca-4acb-8698-8f88d7539ab4', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (335554, 'banoffee', 'petit beurre, beurre doux, beurre demi-sel, sucre, banane, crème liquide, jaune d''oeuf, mascarpone, cacao amer', '25 min', ['Écraser en miettes les petits beurre et les mélanger avec le beurre doux. ', 'Disposer la préparation au fond d''un moule à fond amovible. Bien tasser.', 'Préparer le caramel beurre salé: ', 'faire chauffer le sucre dans une casserole, dès que le caramel colore, y ajouter le beurre salé et la crème liquide préalablement chauffée dans une casserole.', 'Disposer le caramel beurre salé refroidi sur le gâteau.', 'Couper les bananes en rondelles et les disposer sur le caramel.', 'Battre les blancs en neige ferme. ', 'Mélanger le mascarpone avec le jaune d''oeuf, ajouter le sucre. ', 'Ajouter à cette préparation les blancs en neige délicatement.', 'Mettre le tout dans une poche à douille et disposer sur les bananes en formant des petits dômes.', 'Réserver au frais.', 'Au moment de servir saupoudrer de cacao amer pour la décoration.', 'A faire 4 à 6 heures à l''avance.'], ['Verre doseur', 'Casserole'], ['', 'entrée', 'banane', 'recettes de cuisine', 'mascarpone', 'cacao amer', 'banoffee', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'jaune d''oeuf', 'recette', 'cuisine', 'recettes', 'beurre demi-sel', 'boisson', 'crème liquide', 'dessert', 'plat de résistance', 'beurre doux', 'petit beurre', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:55:17.092746', [{'ingredient_id': '5b1bdc79-875a-4497-89c8-6d4aa752e44e', 'quantite': '1'}, {'ingredient_id': '1b6f1e11-b28d-41eb-a29c-7894b2080d74', 'quantite': '100 g'}, {'ingredient_id': 'c1527837-eda9-4493-a045-409086a0df5b', 'quantite': '50 g'}, {'ingredient_id': 'a98a09b7-00fe-42ea-bd8e-0baefe5d6009', 'quantite': '5 cuillères'}, {'ingredient_id': '780780ee-6709-43e6-bbe3-2ef0f2af118d', 'quantite': '3'}, {'ingredient_id': 'a7500a11-a9a6-432c-bfa6-c07facedcb68', 'quantite': '20 cl'}, {'ingredient_id': '6f362a23-8401-4071-8411-320d85a64417', 'quantite': '1'}, {'ingredient_id': '84d53c4e-01be-4652-b749-bb0df1db9479', 'quantite': '250 g'}, {'ingredient_id': '95dd7cf6-7519-42e7-a51a-77c72811df96', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (92398, 'Compote pomme-banane très simple', 'banane, pomme', '10 min', ['Coupez vos pommes en lamelles très fines et faites les cuire dans une casserole à feu doux avec un fond d''eau pour que ça ne colle pas.', 'Une fois que les pommes sont bien cuite set hachées incorporez les rondelles de bananes, celles-ci vont cuire très vite. ', 'Mélangez bien le tout afin d''obtenir une compote'], ['Batteur électrique', 'Casserole', 'Spatule', 'Tire-bouchon', 'Poêle'], ['boisson', 'compote de pomme', 'bon marché', 'Compote pomme-banane très simple', 'banane', 'recettes', 'entrée', 'recettes de cuisine', 'cuisine', 'plat', 'dessert', 'confiserie', 'recette', 'testées', 'plat de résistance', 'cocktail', 'pomme', 'très facile'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:55:20.670406', [{'ingredient_id': 'be17ad83-96a4-4910-86e0-9429f007faa9', 'quantite': '1'}, {'ingredient_id': '2c977c44-3720-4625-a11f-6f2a25db8652', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (86226, 'Milkshake à la banane', 'banane, sucre en poudre, lait, glaçons, sucre vanillé', '10 min', ['Mettre la banane avec les glaçons dans un mixeur et mixer pendant 1 minute. ', 'Ajouter le sucre vanillé, le sucre en poudre et un peu de lait.', 'Mixer à nouveau pendant 1 min. Compléter ensuite avec le lait restant.', 'Dès que l''on obtient une belle mousse, c''est prêt ! '], ['Spatule', 'Râpe', 'Rouleau à pâtisserie', 'Économe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'sucre en poudre', 'recette', 'Milkshake à la banane', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'glaçons', 'lait', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:55:27.512304', [{'ingredient_id': '206c2c03-8c1c-4363-aabe-cbf8de518aae', 'quantite': '1'}, {'ingredient_id': '97089358-3dc4-452b-af5f-fc3a2da29181', 'quantite': '2 cuillères'}, {'ingredient_id': 'a106e031-80c8-4bc1-87ae-6d6d041ea9ad', 'quantite': ''}, {'ingredient_id': '714c0e48-e2f5-4062-94ee-33724cf8ca7d', 'quantite': '2'}, {'ingredient_id': '453da7f7-a3eb-4ac6-954f-7dccd232e1a6', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (372330, 'Smoothie Light à la Banane et à l''Avoine', 'banane, lait de coco, yaourt nature, avoine, sirop d''agave', '5 min', ['Couper la banane en petits morceaux.', 'Mettre dans le mixeur, la banane, le yaourt nature, le lait, l''avoine et si vous le voulez le sirop d''agave.
Mixer.', 'Verser le tout dans deux mugs et déguster.'], ['Mixeur', 'Balance de cuisine'], ['lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'yaourt nature', 'très facile', 'bon marché', 'rapide', 'sirop d''agave', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'avoine', 'dessert', 'plat de résistance', 'Smoothie Light à la Banane et à l''Avoine', 'smoothies', 'cocktail'], 'Dessert', c7d8d724-5a5f-4e0f-bf62-26b7158621c7, '2025-09-26T15:55:31.031258', [{'ingredient_id': 'ba90c8ee-f81d-4658-99a7-be740f9fcbcc', 'quantite': '1'}, {'ingredient_id': 'bc8d095d-b8cb-4319-bc45-eb792042514b', 'quantite': '25 cl'}, {'ingredient_id': 'c4d29f6b-9f75-4baa-8974-b27c2e81c698', 'quantite': '1'}, {'ingredient_id': '403555ca-072c-4e8c-a2b8-8973efe3bab1', 'quantite': '1'}, {'ingredient_id': '73b41ce8-ba5b-4908-a908-0a703d98c29a', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (326819, 'Mousse de banane express', 'banane, oeuf, sucre vanillé, sucre en poudre, fromage frais, gélatine, citron, spéculoos', '10 min', ['Écraser les bananes dans un bol avec le sucre vanillé, le sucre blanc, le fromage frais, le jus de citron et le jaune d''oeuf.', 'Dans un autre bol, monter le blanc d''oeuf en neige ferme (avec une pincée de sel ou pas).', 'Dans un sachet congélation, écraser grossièrement les biscuits. Remplir le fond de 2 verres avec le résultat obtenu.', 'Après avoir fait ramollir la gélatine dans de l''eau froide, la faire fondre dans un récipient pendant 25 secondes au four à micro-ondes avec une goutte de lait. Verser la gélatine fondue dans la préparation à base de banane.', 'Mélanger délicatement le mélange banane dans le blanc d''oeuf en neige.', 'Verser la totalité de la préparation dans les verrines, au-dessus du lit de biscuits dans les 2 verres, réserver au frais pendant 2 heures.', 'Bonne dégustation !'], ['Moule à tarte', 'Râpe', 'Économe'], ['Mousse de banane express', 'banane', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'sucre en poudre', 'fromage frais', 'recette', 'spéculoos', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'citron', 'gélatine', 'mousse fruits', 'cocktail'], 'Dessert', 2c11e649-2477-4edc-9de6-de885576565e, '2025-09-26T15:55:34.791012', [{'ingredient_id': 'bdcee724-9bee-41d0-9530-80f6d0f2e096', 'quantite': '2'}, {'ingredient_id': '65860b6e-094b-4022-a308-571aabd71817', 'quantite': '1'}, {'ingredient_id': 'a63e103b-cd42-4458-84f9-1ca0027823f7', 'quantite': '1'}, {'ingredient_id': 'b101d17d-ba5c-478b-942f-ff6eb424c587', 'quantite': '1 cuillères'}, {'ingredient_id': '8550129b-e176-49f7-9de9-6fc05ae51e70', 'quantite': '20 g'}, {'ingredient_id': 'ab444b27-f630-4db5-9969-69fa078d8cb1', 'quantite': '2'}, {'ingredient_id': 'a511fd72-7a17-4fc6-bd7a-ba5a7a701382', 'quantite': ''}, {'ingredient_id': '181cc9f2-c15a-49a7-8479-4a55ee758c01', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (65126, 'Gâteau banane-chocolat Autrichien', 'oeuf, farine, sucre, beurre tendre, confiture d''abricot, banane, lait, beurre, sucre, chocolat, beurre', '90 min', ['Préparer le biscuit :', 'Préchauffer le four à 180°C (thermostat 6).', 'Mélanger la farine, les jaunes, le sucre, le beurre, puis les blancs en neige.', 'Etaler la préparation sur une grande plaque de four.', 'Mettre à cuire 10 à 15 min. Laisser refroidir.', 'Garnir le biscuit :', 'Après refroidissement du biscuit (tiède), tartiner de confiture d''abricots et de rondelles de bananes.', 'Préparer la crème :', 'Pour 75 cl de lait, préparer une crème pâtissière, y ajouter 250 g de beurre et 250 g de sucre.', 'Lorsque le mélange est fluide et homogène, le verser sur le biscuit garni.', 'Laisser refroidir au réfrigérateur.', 'Pour le glaçage :', 'Faire fonde en mélangeant parfaitement le beurre et le chocolat, lorsque c''est bien chaud, verser en nappage sur la crème pâtissière.', 'Laisser refroidir à l''air ambiant puis au réfrigérateur.'], ['Râpe', 'Louche', 'Ouvre-boîte', 'Mixeur', 'Économe'], ['entrée', 'recettes de cuisine', 'confiserie', 'testées', 'beurre tendre', 'Gâteau banane-chocolat Autrichien', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'gâteau au chocolat', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:55:38.433472', [{'ingredient_id': '8043f781-35c4-4073-aeae-93d5da18dda8', 'quantite': '6'}, {'ingredient_id': '35a2084f-dc76-46b5-90c9-7388d3762348', 'quantite': '180 g'}, {'ingredient_id': 'eff9787f-e8c0-4289-b895-fca2a435afa5', 'quantite': '150 g'}, {'ingredient_id': '3bc1557e-c8f3-4f39-9b85-4fd2b430baed', 'quantite': '250 g'}, {'ingredient_id': 'e16a6c08-45b1-4f17-9d9c-5f770868b291', 'quantite': '6 cuillères'}, {'ingredient_id': '31c3c25c-28aa-4e5b-9759-ba0006e67c9e', 'quantite': '4'}, {'ingredient_id': '544e54e7-104b-4cdc-8645-db89391a7aea', 'quantite': '75 cl'}, {'ingredient_id': '8473c24e-0707-4984-9f31-6d6dd58a9c87', 'quantite': '250 g'}, {'ingredient_id': '776381d0-95e9-458f-a70f-17b657057416', 'quantite': '250 g'}, {'ingredient_id': 'bb1ea45b-20ec-4474-a470-9d04e38a767f', 'quantite': '50 g'}, {'ingredient_id': 'fb5700f4-cb88-4791-bcf0-bff2965110b6', 'quantite': '200 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (33591, 'Douceur exotique', 'banane, ananas, noix de coco rapée, crème fraîche épaisse, lait écrémé, sucre', '10 min', ['Couper les bananes et l''ananas en dés. ', 'Mettre au frais. ', 'Mélanger la noix de coco râpée avec la crème fraîche et le sucre. Délayer avec le lait versé petit à petit pour que cela soit plus fluide. ', 'Egoutter l''ananas. ', 'Mélanger le tout. ', 'Servir frais. ', 'Bon appétit.'], ['Verre doseur', 'Couteau de chef', 'Passoire'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche épaisse', 'confiserie', 'lait écrémé', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'noix de coco rapée', 'dessert', 'plat de résistance', 'ananas', 'sucre', 'cocktail', 'Douceur exotique'], 'Dessert', 26d62d89-14c4-4d45-9400-7da06b693cff, '2025-09-26T15:55:42.903715', [{'ingredient_id': 'eec4e32d-23b7-4209-998b-b6eb166b654d', 'quantite': '6'}, {'ingredient_id': '5f447043-e40e-4845-b55f-db1a87c13a95', 'quantite': '1'}, {'ingredient_id': '11d00bc6-8751-4e53-8a74-3f2ed94d0af3', 'quantite': '250 g'}, {'ingredient_id': '05581b4e-5dc6-497d-a0fe-0374248825a7', 'quantite': '50 cl'}, {'ingredient_id': '5ded0fda-5573-49e3-bf85-8bc9d6748a4f', 'quantite': '20 cl'}, {'ingredient_id': '5d6bdd97-480b-4886-8cc8-917fdcf8487f', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (254535, 'Clafoutis à la banane et aux framboises', 'oeuf, sucre, sucre vanillé, beurre, farine, lait demi-écrémé, banane, framboises', '10 min', ['Préchauffez le four à 190°C (thermostat 6-7).', 'Mélangez les oeufs avec le sucre et le sachet de sucre vanillé.', 'Lorsque le mélange blanchi, ajoutez la farine, le beurre et le lait, mélangez.', 'Ajoutez ensuite les framboises et remuez.', 'Découpez les bananes en rondelles et les placez au fond du moule à manquer puis versez la préparation dessus.', 'Enfournez 35 minutes.'], ['Batteur électrique', 'Fouet', 'Moule à tarte', 'Verre doseur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'framboises', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'clafoutis', 'sucre vanillé', 'beurre', 'Clafoutis à la banane et aux framboises', 'sucre', 'lait demi-écrémé', 'cocktail'], 'Dessert', c58f453e-6e6d-4745-9b0f-aa79c684e626, '2025-09-26T15:55:46.441605', [{'ingredient_id': 'd443c12b-ef74-4012-97ed-d0468f32017b', 'quantite': '3'}, {'ingredient_id': '7a8cc738-eefc-4cb7-98a6-794442de04b9', 'quantite': '100 g'}, {'ingredient_id': '479c116d-1fa9-48aa-877e-e637c65aa1d7', 'quantite': '1'}, {'ingredient_id': 'c3599b1a-403e-44cf-8761-210420105a49', 'quantite': '50 g'}, {'ingredient_id': 'ef84c669-e937-47a0-a4c8-aaffb8f114a9', 'quantite': '80 g'}, {'ingredient_id': '372bb925-d1cb-4945-bf17-0b4f7bd54481', 'quantite': '25 cl'}, {'ingredient_id': '0af31928-5f49-48a9-9fdf-46f8239e568d', 'quantite': '3'}, {'ingredient_id': '0646d947-4645-4408-a7d2-83518ed13949', 'quantite': '60 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (12953, 'Bananes au lait de coco avec perles du japon', 'perles du Japon, lait de coco, banane', '5 min', ['Verser en pluie 30g de perles japon dans 25 cl de lait de coco bouillant.', 'Cuire 30 mn, laisser refroidir.', 'Ajouter à volonté les bananes écrasées ou en morceaux + d''autres fruits si vous voulez (ananas,...).'], ['Moule à tarte', 'Balance de cuisine', 'Rouleau à pâtisserie', 'Tire-bouchon', 'Mixeur'], ['', 'lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'perles du Japon', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Bananes au lait de coco avec perles du japon', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:55:49.924280', [{'ingredient_id': 'ddd20805-10cd-4aac-8ed9-fee7f9b5012a', 'quantite': '30 g'}, {'ingredient_id': 'e330a0b4-f6ea-4f2f-b7c9-a9b6cfb3bd24', 'quantite': '25 cl'}, {'ingredient_id': '0ceee1db-b8d2-44b1-b2ca-d7b590d7af8d', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (528360, 'Compote de bananes', 'banane, sucre vanillé, cannelle, gingembre, sucre roux, citron vert', '5 min', ['Faire chauffer les bananes trop mûres quelques minutes avec un peu de sucre, quelques épices au choix, du citron vert.', 'Le tour est joué, un vrai délice.'], ['Ouvre-boîte', 'Fouet'], ['', 'gingembre', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'citron vert', 'cannelle', 'cocktail', 'Compote de bananes', 'sucre roux'], 'Dessert', 13bf5b47-6880-4893-9689-4470cbbbc5cd, '2025-09-26T15:55:54.161260', [{'ingredient_id': 'efaea167-ac85-472a-b140-aaac680f3aa4', 'quantite': '3'}, {'ingredient_id': 'dc91e674-4509-4426-b815-0d2c3ec1f240', 'quantite': ''}, {'ingredient_id': '91af97ea-0fdc-4c8f-983b-baf52d968d6e', 'quantite': ''}, {'ingredient_id': 'd401d8cc-2d41-436f-8133-4dad2eb124ab', 'quantite': ''}, {'ingredient_id': 'd16a7b87-4c71-4e2f-9067-151b8aada469', 'quantite': '1'}, {'ingredient_id': 'b03d73b0-fe10-4edd-9b30-20c73c926a47', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (200990, 'Banana Choco''s (banane au chocolat)', 'banane, chocolat en poudre, crème chantilly', '5 min', ['Installer une banane bien mûre dans une petite assiette.', 'Ne pas enlever la peau. Couper le milieu et écarter bien. ', 'Faire chauffer la banane 1 min au micro-ondes.', 'Verser les 3 à 4 cuillères de chocolat en poudre dans la banane (avec la peau). ', 'Puis ajouter de la chantilly par dessus.'], ['Économe', 'Mixeur', 'Louche', 'Ouvre-boîte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'crème chantilly', 'Banana Choco''s (banane au chocolat)', 'dessert', 'plat de résistance', 'chocolat en poudre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:55:58.527513', [{'ingredient_id': '181e0eb6-e957-4b43-b73b-98fa432d634d', 'quantite': '1'}, {'ingredient_id': '8b66f879-b559-4340-bdfd-d699fdd47981', 'quantite': '3 cuillères'}, {'ingredient_id': '2140523a-441a-4473-82b3-ea4c1ab4d4ad', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (67527, 'Bananes aux framboises', 'banane, framboises, citron, sucre semoule, crème fraîche', '15 min', ['Peler et couper les bananes en rondelles. Dans un saladier, recouvrir les bananes d''un tiers de sucre et les arroser du jus d''un demi-citron.', 'Dans une assiette ou un saladier, écraser les framboises à la fourchette et les mélanger au reste du sucre.', 'Battre vigoureusement la crème fraîche additionnée de 2 cuillères à soupe d''eau froide. Ajouter les framboises et mélanger délicatement.', 'Répartir les bananes dans les assiettes (ou des coupelles individuelles) et les napper du mélange crème-framboises. Servir frais.'], ['Ouvre-boîte', 'Verre doseur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'très facile', 'framboises', 'bon marché', 'Bananes aux framboises', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'sucre semoule', 'boisson', 'dessert', 'plat de résistance', 'citron', 'cocktail'], 'Dessert', 51d20b8b-6023-4c45-8daf-26f9a9b5cb7d, '2025-09-26T15:56:03.583445', [{'ingredient_id': '1581ed87-fd58-4425-aebf-21967b697e4a', 'quantite': '4'}, {'ingredient_id': '8b148f1c-c475-41b0-b7a5-30c9714605f7', 'quantite': '200 g'}, {'ingredient_id': '18fe5a92-d1bc-43ce-86c3-bd10e6ffd1a9', 'quantite': '1'}, {'ingredient_id': 'ada4ce3a-37d5-4f71-9824-652e1a2420f9', 'quantite': '100 g'}, {'ingredient_id': '01e1f418-7bc3-40ab-a92a-15ffc6ea4962', 'quantite': '125 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (327595, 'Milk-shake gourmand biscuits-banane', 'spéculoos, glace vanille, lait, banane, crème chantilly', '10 min', ['Mettre 3 biscuits de côté pour la déco.', 'Mixer le reste des biscuits (en mettre plus ou moins en fonction de leur taille) avec la glace, la banane coupée en rondelles et le lait.', 'Verser dans un verre haut, sans aller jusqu''au bord pour laisser la place à la chantilly.', 'Recouvrir de chantilly et décorer chaque verre d''un biscuit entier planté dans la chantilly et de miettes de chantilly.', 'Servir avec des pailles immédiatement.'], ['Économe', 'Moule à tarte', 'Verre doseur', 'Balance de cuisine', 'Spatule'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Milk-shake gourmand biscuits-banane', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'spéculoos', 'cuisine', 'recettes', 'boisson', 'crème chantilly', 'glace vanille', 'dessert', 'plat de résistance', 'lait', 'cocktail'], 'Boisson', e0249296-5ddc-4d1d-8491-0f4b95f1302f, '2025-09-26T15:56:07.339083', [{'ingredient_id': '7ea0465f-eb7a-4df6-b0a5-cf63e70bdb38', 'quantite': '10'}, {'ingredient_id': '863f60b3-661d-4647-a603-4836d99cf338', 'quantite': '350 g'}, {'ingredient_id': 'dcc1c6f3-fd26-4c7b-b4b5-3408c703c71b', 'quantite': '40 cl'}, {'ingredient_id': 'e6a06b53-e869-4a2c-ad82-d5062e87902f', 'quantite': '1'}, {'ingredient_id': 'e40fa18f-573c-441d-86ea-5dc3def31d33', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (34208, 'Tartare de thon, saumon, ananas et fruits de la passion', 'thon rouge, saumon, fruit de la passion, ananas, sel, gingembre, banane plantain, huile d''olive, citron vert', '30 min', ['Prendre deux saladiers différents pour d''un côté le tartare de saumon, et de l''autre celui de thon. ', 'Nous allons voir la préparation du tartare au saumon, la recette pour le thon sera identique. ', 'Couper le saumon en tartare (de mon côté, j''ai fait des petites lanières de 2 cm de long sur 0,8 de large environ). Le poissonnier s''il est plus gentil que le mien, peut aussi vous le préparer. ', 'Rajouter une demi-cuillère d''huile d''olive (plus ou moins selon votre convenance : plus permet d''avoir une sauce pour la tartare, mais je ne trouve pas ça très utile). ', 'Rajouter un demi-citron vert pressé, une pincée de gingembre et une petite pincée de sel. ', 'Vider un fruit de la passion et le mettre dans la préparation (conserver les coques du fruit pour la déco). ', 'Hacher très finement de l''ananas (la quantité correspond schématiquement au volume d''un petit doigt, l''ananas est juste fait pour renforcer la saveur, et ne doit pas être mis en trop grande quantité, car l''élément principal est quand même le poisson !). Rajouter l''ananas émincé dans la préparation (conserver la tête de l''ananas pour la déco). ', 'Mélanger le tout avec les doigts, ce qui permet de ne pas abîmer le poisson. ', 'Mettre le tout dans des ramequins (j''ai suivi le conseil de mettre du film plastique dans le ramequin avant de rajouter la préparation. Ceci permet de démouler facilement les tartares). ', 'Mettre au frais et sortir 30 min avant de servir. ', 'Préparation identique pour le thon. Vous pouvez toujours ajouter d''autres ingrédients pour la préparation tel que ail, poivre.... ', 'Couper le reste de l''ananas (donc la très grosse partie de celui-ci puisqu''une petite quantité a été utilisée) : couper la moitié en fines tranches, l''autre moitié en carrés. ', 'Couper les bananes plantain en rondelles puis les faire frire. ', 'Présentation : ', 'Mettre de façon non symétrique les tartares dans l''assiette. ', 'Couper la tête verte de l''ananas en deux et la disposer entre les tartares. ', 'Dans les coques vides conservées des fruits de la passion, rajouter l''ananas coupés en dés. ', 'Combler le reste de l''assiette par les tranches d''ananas et les bananes frites. ', 'Enfin rajouter un fruit de la passion ouvert en deux, dans chaque assiette. ', 'Bon appétit ! (normalement le plaisir visuel est au rendez-vous avant le plaisir des papilles). ', 'J''ai beaucoup parlé mais c''est très simple à faire, je trouve.'], ['Presse-agrumes', 'Spatule'], ['gingembre', 'entrée', 'recettes de cuisine', 'saumon', 'sel', 'confiserie', 'testées', 'très facile', 'thon rouge', 'Tartare de thon', 'rapide', 'plat', 'ananas et fruits de la passion', 'recette', 'cuisine', 'recettes', 'boisson', 'huile d''olive', 'fruit de la passion', 'dessert', 'plat de résistance', 'banane plantain', 'moyen', 'ananas', 'citron vert', 'tartare', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:56:11.177287', [{'ingredient_id': '11d41199-2c08-4c10-b4ce-471cef290fda', 'quantite': '200 g'}, {'ingredient_id': '9f570683-b4c0-4738-ba82-2779c3c512c3', 'quantite': '200 g'}, {'ingredient_id': 'f7205cd6-0191-48b3-8093-87019993e2c1', 'quantite': '4'}, {'ingredient_id': '16ca515a-010a-4e97-80dd-f538a8aedc79', 'quantite': '1'}, {'ingredient_id': 'a73661be-419d-45fc-8328-dd4988922ba5', 'quantite': '1'}, {'ingredient_id': 'e25984af-079f-4e0c-b14a-74168bf91565', 'quantite': '1'}, {'ingredient_id': 'e50a1d84-3da8-48ce-8cda-2007727376d4', 'quantite': '2'}, {'ingredient_id': 'ffdb0ef6-50a5-4046-8eb7-0ad080ac09e8', 'quantite': '1 cuillères'}, {'ingredient_id': '21c956c5-8e12-45c7-ade9-ece8282581b0', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (22752, 'Coupe de fruits / muesli minceur', 'pomme, banane, poire, kiwi, fraises, orange, raisins secs, muesli, citron, sirop d''érable, crème allégée', '15 min', ['Dans un saladier, mettre tous les fruits épluchés et coupés en menus morceaux. Ajouter le jus de citron et bien remuer. ', 'Faire tremper quelques minutes les raisins secs dans le jus d''orange. ', 'Ajouter aux autres fruits dans le saladier. Bien remuer. ', 'Répartir dans quatre coupes. Ajouter dans chaque coupe 2 cuillères à soupe de muesli, arroser d''une cuillère à soupe de sirop d''érable et napper de crème allégée (plus ou moins selon le régime...). ', 'Mettre au frais 1 heure avant de servir.'], ['Casserole', 'Passoire', 'Moule à tarte', 'Balance de cuisine'], ['entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'muesli', 'poire', 'très facile', 'sirop d''érable', 'bon marché', 'Coupe de fruits / muesli minceur', 'rapide', 'plat', 'fraises', 'crème allégée', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Muesli', 'pomme', 'citron', 'orange', 'raisins secs', 'cocktail'], 'Dessert', 2eb78987-3dfb-40f0-90e1-8f193335a2a8, '2025-09-26T15:56:14.805119', [{'ingredient_id': 'd1693770-9efd-4b86-9a39-3d30c8280c5f', 'quantite': '1'}, {'ingredient_id': 'c0beebb3-7ad4-4217-909e-b14d4c05b3ba', 'quantite': '1'}, {'ingredient_id': '24058a50-f4c6-4b9e-869e-5c1ce06faca8', 'quantite': '1'}, {'ingredient_id': 'afdf9df3-7a49-490f-9d25-0da8252bb1b4', 'quantite': '1'}, {'ingredient_id': '5ad59c69-4a7c-4180-b204-316ab45be3eb', 'quantite': '12'}, {'ingredient_id': '85746c7f-928c-4f3a-b769-0cac03f3ca6f', 'quantite': '1'}, {'ingredient_id': '57c4c697-f1de-4a36-ac32-c35c90e9887d', 'quantite': '25 g'}, {'ingredient_id': '6a93a2d1-5e07-4ec5-8282-5f2c9eb1f8e6', 'quantite': '8 cuillères'}, {'ingredient_id': '94b43461-5a84-4585-a577-bb26e992abcc', 'quantite': '1'}, {'ingredient_id': 'ff62b578-8e43-4d64-8716-7075927286d5', 'quantite': '4 cuillères'}, {'ingredient_id': '41efa62e-f890-490e-a17c-f37480946260', 'quantite': '4 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (15331, 'Soufflé de boudin blanc à la banane', 'banane, boudin blanc, oeuf, crème liquide, beurre, mélange 4 épices, sel', '15 min', ['Dans une poêle, faire dorer les rondelles de 2 boudins et de 2 bananes.', 'Mixer les autres boudins et bananes, la crème, les oeufs, les épices.', 'Faire chauffer un bain-marie (au four, à 190°C).', 'Dans des ramequins beurrés, disposer alternativement : couche de rondelles de boudin, préparation mixée, rondelles de bananes, rondelles boudin, préparation, rondelles de banane.', 'Cuire au bain-marie à 190°C, jusqu''à ce que la préparation se tienne et soit dorée.'], ['Presse-agrumes', 'Pince de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'boudin', 'boudin blanc', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'mélange 4 épices', 'cuisine', 'recettes', 'Soufflé de boudin blanc à la banane', 'boisson', 'crème liquide', 'dessert', 'plat de résistance', 'beurre', 'cocktail'], 'Entrée', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:56:18.425211', [{'ingredient_id': '5269e80b-f27b-424b-86dc-ee7b59f2902e', 'quantite': '5'}, {'ingredient_id': 'c416d039-5f7d-459f-8ab5-91d06293a6b1', 'quantite': '5'}, {'ingredient_id': '7201bf60-61a5-4918-bbdc-3093e716f4de', 'quantite': '3'}, {'ingredient_id': 'aece80cb-2ba8-450a-ac7a-d04016e51d5b', 'quantite': '20 cl'}, {'ingredient_id': 'ec8cce23-3664-4287-93be-410e851f237b', 'quantite': '30 g'}, {'ingredient_id': '3850e025-9f48-47d0-b83c-eb81877be441', 'quantite': ''}, {'ingredient_id': '684c7676-5dfd-4f02-a7f7-fdaeb70fd0e8', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (66863, 'Crumble pommes, poires, bananes et chocolat noir', 'poire, pomme, banane, beurre, sucre en poudre, cassonade, farine, chocolat noir', '15 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Pour la pâte :', 'Faire fondre le beurre au micro-ondes.', 'Pendant ce temps, mélanger la farine, les sucres et le beurre fondu. "Sabler" le tout (mélanger de manière à obtenir comme des grosses miettes).', 'Dans un plat à tarte (ou autre), mettre en morceaux le chocolat, les fruits coupés, mélanger le tout.', 'Emietter la pâte sur les fruits et mettre au four 30 minutes environ.'], ['Fouet', 'Couteau de chef'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'cassonade', 'poire', 'très facile', 'bon marché', 'crumble aux pommes', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'chocolat noir', 'pomme', 'beurre', 'bananes et chocolat noir', 'Crumble pommes', 'poires', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:56:22.018041', [{'ingredient_id': 'd34d6168-7e18-4b55-8f70-422329462350', 'quantite': '6'}, {'ingredient_id': '230e5864-6e71-4b02-bb82-a5209a008cef', 'quantite': '3'}, {'ingredient_id': 'e0b72a24-10fd-429d-85a0-1037db6e7c34', 'quantite': '2'}, {'ingredient_id': 'af1a5766-c857-4df3-9772-a54e2aee5678', 'quantite': '100 g'}, {'ingredient_id': 'e21cd05c-ef03-4775-9075-5a38a39b5883', 'quantite': '100 g'}, {'ingredient_id': '121c4b91-c44e-4903-b9e0-82b3a9ca87ad', 'quantite': '20 g'}, {'ingredient_id': '3c857167-9708-4a8c-8d9d-188bc41056f4', 'quantite': '200 g'}, {'ingredient_id': 'ecaada0b-5419-4bba-96a2-58fc8b51353f', 'quantite': '200 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (347873, 'Wraps sucrés', 'farine, beurre, eau, sel, banane, sucre roux, chocolat, beurre, fraises, sucre, sauce chocolat', '20 min', ['Dans un saladier, mélanger la farine, le sel, le sucre et le beurre fondu. ', 'Ajouter l’eau et bien mélanger. ', 'Travailler la pâte à la main pour former une boule. Laisser reposer 1h. ', 'Étaler la pâte et former des galettes rondes (de la taille souhaitée pour les tortillas). ', 'Faire dorer des deux cotés dans une poêle bien chaude.', 'Pour les tortillas banane chocolat.', 'Faire fondre le chocolat avec le beurre dans une casserole. ', 'Eplucher les bananes et les couper en rondelles. ', 'Faire caraméliser dans une poêle avec une peu de beurre et de sucre. ', 'Disposer les bananes sur la tortilla, arroser de sauce chocolat et rouler pour fermer le wrap. ', 'Déposer dans un plat allant au four et enfourner 10 minutes à 180°C (thermostat 6).', 'Pour les tortillas fraises chocolat.', 'Laver les fraises et les équeuter. Couper les fraises en 2 ou 4 et les disposer sur un wrap, saupoudrer de sucre, plier le wrap et napper de sauce chocolat. ', 'Régalez-vous !'], ['Rouleau à pâtisserie', 'Ouvre-boîte', 'Poêle', 'Mixeur'], ['', 'entrée', 'recettes de cuisine', 'sel', 'confiserie', 'eau', 'testées', 'facile', 'bon marché', 'Wraps sucrés', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'beurre', 'cocktail'], 'Dessert', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T15:56:25.650758', [{'ingredient_id': '956e2319-3f07-4818-be25-c63d400fe613', 'quantite': '225 g'}, {'ingredient_id': '1f943f01-7d8f-44c8-b0b6-9ee3e1330cc9', 'quantite': '25 g'}, {'ingredient_id': '676eeeee-f341-463e-86f8-7c67746a5ff8', 'quantite': ''}, {'ingredient_id': '15258bc4-b493-4e5e-8d28-4f5ac065b9a8', 'quantite': '1'}, {'ingredient_id': 'f57a4171-9ec3-4cd0-8986-b819c3ee86f2', 'quantite': '2'}, {'ingredient_id': 'c447d6c8-4e04-46ec-a3af-a4fcfb0f929b', 'quantite': '1 cuillères'}, {'ingredient_id': 'e1a267df-dcca-4a22-bd0a-ac4555156688', 'quantite': '40 g'}, {'ingredient_id': '7469c1d7-c3b4-4640-bba3-a9c298ce4f01', 'quantite': '20 g'}, {'ingredient_id': '8ce191b2-e8a0-4146-9ba8-6e530dbd09d5', 'quantite': '200 g'}, {'ingredient_id': '4762b065-b724-4774-ab45-a608659c320e', 'quantite': '1 cuillères'}, {'ingredient_id': '9ed2c600-cd5f-4fdd-9fac-b788d16e8229', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (172555, 'Cupcake choco-banane', 'beurre, sucre, oeuf, farine, chocolat, levure chimique, bonbon, sucre glace, blanc d''oeuf, colorant alimentaire', '25 min', ['Mettre la farine,la levure, la poudre de chocolat et le sucre dans un saladier, faire un puits, verser le beurre fondu puis mélanger à l''aide d''un fouet jusqu''à obtention d''une pâte homogène.', 'Mettre 2 bonbons "banane" dans la préparation pour chaque caissette (ou moule à cupcake). ', 'Faire cuire 15-20min à 180°C (thermostat 6).', 'Mélanger le sucre glace avec le blanc d''oeuf, une fois l''obtention d''une pâte homogène y verser une ou deux gouttes de colorant et mélanger.', 'Une fois les cupcakes refroidis, y déposer la préparation, et décorer selon votre imagination.'], ['Pince de cuisine', 'Casserole', 'Presse-agrumes'], ['Cupcake choco-banane', 'entrée', 'recettes de cuisine', 'bonbon', 'confiserie', 'testées', 'levure chimique', 'chocolat', 'facile', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'moyen', 'beurre', 'cupcake', 'sucre', 'cocktail'], 'Dessert', 486d934d-3a27-4edd-a512-a2f022c89375, '2025-09-26T15:56:29.328016', [{'ingredient_id': '6fe2fb1e-b246-44d2-91cb-18c3310dfb9b', 'quantite': '75 g'}, {'ingredient_id': '7a0d6f24-61a4-4acd-a3bd-8661ef1768ac', 'quantite': '110 g'}, {'ingredient_id': '382fa9bd-1d46-4f75-94b3-4780c09cd817', 'quantite': '2'}, {'ingredient_id': '46fca439-1cce-410c-b9b2-3a968ced3809', 'quantite': '130 g'}, {'ingredient_id': '131486ac-7ac4-4d63-a675-29a90537a060', 'quantite': '1 cuillères'}, {'ingredient_id': 'b1445042-d835-4494-9d68-30d7d35a2754', 'quantite': ''}, {'ingredient_id': '31148be3-8f5c-4bb4-abba-5ef88e303ca5', 'quantite': '12'}, {'ingredient_id': '83f3fe90-4f26-4b70-8bc8-fabf38976f07', 'quantite': '100 g'}, {'ingredient_id': '3e2975ca-cb7c-4124-aee2-1aa8171dd456', 'quantite': ''}, {'ingredient_id': '8a01be71-365d-489c-9184-52caab0a96e0', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (347619, 'Omelette sucrée à l''avoine et aux bananes', 'oeuf, avoine, banane, huile', '10 min', ['Casser les oeufs et les mélanger avec l''avoine.', 'Couper en petits morceaux la banane et l''ajouter au mélange.', 'Faire chauffer la poêle en ajoutant l''huile (pour éviter que l''omelette ne colle).', 'Faire cuire à feu moyen 5 minutes de chaque coté.', 'Déguster !'], ['Spatule', 'Pince de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'omelette', 'très facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'recette', 'Omelette sucrée à l''avoine et aux bananes', 'cuisine', 'recettes', 'boisson', 'huile', 'avoine', 'dessert', 'plat de résistance', 'cocktail'], 'Plat principal', db7dc1e0-6445-452e-a4a0-ca133d0e4cd4, '2025-09-26T15:56:32.969595', [{'ingredient_id': '2f5d9bbd-1889-4be2-9919-146f93607cbc', 'quantite': '7'}, {'ingredient_id': '1cea35fa-315f-4752-9a09-c18347b4a2e2', 'quantite': '50 g'}, {'ingredient_id': '983f6752-0174-4bdb-9eee-8d4870bd3d5d', 'quantite': '1'}, {'ingredient_id': '9e66cad0-d514-402a-a0e7-37272df92cac', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (16281, 'Batido ou bavaroise à la banane', 'banane, vanille, cannelle, muscade, lait demi-écrémé, sucre en poudre, glaçons, citron vert', '10 min', ['Coupez les bananes en rondelles dans le mixer, ajoutez le sucre, les zestes,  les épices et le lait. Mixez.', 'Ajoutez les glaçons (pas trop) et mixez.', 'Vous devez obtenir la consistance d''un milk-shake mousseux et à la fois onctueux. A boire immédiatement et glaçé!'], ['Verre doseur', 'Presse-agrumes'], ['', 'bon marché', 'boisson', 'recettes', 'banane', 'rapide', 'entrée', 'recettes de cuisine', 'plat', 'Batido ou bavaroise à la banane', 'dessert', 'confiserie', 'recette', 'testées', 'plat de résistance', 'cocktail', 'cuisine', 'très facile'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:56:37.532911', [{'ingredient_id': 'e1e14a81-32a7-4de5-a590-1e932f6857fe', 'quantite': '3'}, {'ingredient_id': 'b51ca2f6-f783-4d46-a965-8c62b57856ed', 'quantite': ''}, {'ingredient_id': '5cdeb0eb-00ef-400b-9eed-922e5bccf8b3', 'quantite': ''}, {'ingredient_id': 'f6256081-694b-462f-9919-db541ec4914a', 'quantite': ''}, {'ingredient_id': 'b60c96a4-7baf-4005-ad39-368449abf88c', 'quantite': ''}, {'ingredient_id': '33adc503-8b4b-44b1-8b4e-831e82d8a321', 'quantite': '4 cuillères'}, {'ingredient_id': '9be1d590-0b48-48d0-8951-4ef4201a0969', 'quantite': ''}, {'ingredient_id': 'fa309a37-844b-45ac-896c-9df0344aece4', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (29907, 'Bananes flambées aux raisins secs', 'banane, beurre, sucre, raisins secs, orange, sucre vanillé, rhum', '15 min', ['Pressez les oranges, mettez les raisins à tremper dans leur jus. Ajoutez le sucre en poudre et le vanillé, mélanger.', 'Préchauffez le plat de service.', 'Faites fondre le beurre dans une poêle et dorez-y les bananes entières sur chaque face. Saupoudrez de sucre puis ajoutez le jus d''orange avec les raisins. Amenez à ébullition puis versez la moitié du rhum. Laissez mijoter 5 minutes.', 'Disposez sur le plat de service et apportez à table.', 'Réchauffez le reste de rhum et flambez les bananes avec.'], ['Ouvre-boîte', 'Balance de cuisine', 'Batteur électrique', 'Louche', 'Passoire'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'facile', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Bananes flambées aux raisins secs', 'dessert', 'plat de résistance', 'sucre vanillé', 'moyen', 'beurre', 'orange', 'raisins secs', 'sucre', 'cocktail'], 'Dessert', 8461cda4-e8c7-405f-ab26-2b37b64c49a2, '2025-09-26T15:56:41.096402', [{'ingredient_id': '8f04b046-e95e-40d4-a535-956a52b0f182', 'quantite': '6'}, {'ingredient_id': '9a331a8e-a9a7-4b6d-8903-273e7553a60a', 'quantite': '50 g'}, {'ingredient_id': '5999a909-3201-49be-a65c-95c8d7d7ea14', 'quantite': '50 g'}, {'ingredient_id': '131abe6e-b3cb-46c0-a66c-dd74427e8c25', 'quantite': '50 g'}, {'ingredient_id': '1d63104f-1668-4db7-a34e-e5e7707c1a80', 'quantite': '2'}, {'ingredient_id': '762fa959-d6a6-47ad-b03b-4cb2d6be8dbf', 'quantite': '1'}, {'ingredient_id': 'c6b558c4-3553-4128-a1da-7df46b3dcc56', 'quantite': '10 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (33715, 'bananes au barbecue cuites dans leur peau', 'banane, cointreau, sucre, crème fraîche liquide', '10 min', ['Séparer les bananes les unes des autres en faisant attention à ne pas arracher la queue et à ne pas endommager la peau. ', 'Poser les bananes sur le barbecue (puissance maximale pour un barbecue électrique ou à gaz, sur des braises déjà consumées par la cuisson de la viande ou du poisson pour un barbecue traditionnel). Retourner en cours de cuisson, chaque fois qu''une zone de la peau a noirci. ', 'Sortir du feu quand toute la peau a bien noirci, voire commencé à se dessécher. Si la peau éclate en cours de cuisson (cela se produit le plus souvent vers la fin), sortir du feu le plus tôt possible, pour éviter que la banane perde tout son jus. ', 'Dresser sur des assiettes à dessert : enlever la peau sur le dessus, fendre la banane en deux dans le sens de la longueur et remplir la fente ainsi créée de sucre et d''alcool à l''orange. ', 'Il est aussi possible de garnir la banane de chocolat, de chantilly ou de crème fraîche liquide.'], ['Économe', 'Louche', 'Fouet', 'Rouleau à pâtisserie', 'Batteur électrique'], ['', 'entrée', 'banane', 'recettes de cuisine', 'bananes au barbecue cuites dans leur peau', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'crème fraîche liquide', 'cuisine', 'recettes', 'boisson', 'cointreau', 'dessert', 'plat de résistance', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:56:44.746379', [{'ingredient_id': 'b2530044-74a5-4c5d-97df-340a1bcb26aa', 'quantite': '6'}, {'ingredient_id': '39168236-a678-413e-b555-020059c9f938', 'quantite': ''}, {'ingredient_id': 'b54f6a43-ee04-4e2c-88ea-4609435812bb', 'quantite': ''}, {'ingredient_id': '8649d3f9-f235-4a36-affb-c96e8bbd13f3', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (336063, 'The crumble pomme-banane', 'pomme, banane, raisins secs, beurre tendre, sucre, sucre vanillé, farine', '10 min', ['Sortir le beurre du réfrigérateur et préchauffer le four à 180°C (thermostat 6).', 'Éplucher les pommes et la banane.', 'Dans un plat à four, couper grossièrement les fruits et repartir équitablement les morceaux de banane sur les pommes (je propose de ne mettre qu''une banane car à la cuisson, elle révèle un goût prononcé).', 'Si vous le souhaitez, dispersez les raisins ou les pépites.', 'Préparer la pâte à crumble et recouvrez les fruits avec.', 'Enfourner pendant 30 min.', 'Préparer la pâte à crumble :', 'Dans un saladier, mettre la farine, le sucre (blanc et vanillé), et le beurre ramolli coupé en morceaux.', 'Avec les mains, malaxer ce mélange jusqu''à obtenir un appareil comparable à la texture du sable.'], ['Couteau de chef', 'Casserole', 'Économe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'crumble banane', 'testées', 'beurre tendre', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'raisins secs', 'sucre', 'cocktail', 'The crumble pomme-banane'], 'Dessert', e12b6da6-5683-452a-a565-58ada2b815c1, '2025-09-26T15:56:49.294474', [{'ingredient_id': '2e94a043-e074-4c42-a96d-fda4bcb34abf', 'quantite': '7'}, {'ingredient_id': 'f0b8f221-fa61-4c12-99bf-a7b64bf96b4b', 'quantite': '1'}, {'ingredient_id': '7fce954a-f362-48b5-9439-293edbf6a465', 'quantite': '1'}, {'ingredient_id': 'bdd219d6-3b1f-4322-a5ae-b65f5c72e2dd', 'quantite': '100 g'}, {'ingredient_id': 'a4025d88-f6f5-4d5d-aa5f-4e74c4220277', 'quantite': '100 g'}, {'ingredient_id': 'b0db9d34-eb7d-4877-b9be-85c56a696249', 'quantite': '1'}, {'ingredient_id': 'a99655aa-94d0-48ac-9363-f496938b811e', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (15020, 'Cake à la carotte et à la banane', 'banane, carotte, oeuf, farine complète, son de blé, yaourt nature, lait, sucre, levure, cannelle, compote', '20 min', ['Râper la carotte et la mixer avec la banane, l''oeuf, le sucre, le yaourt, la cannelle et la compote.', 'Ajouter le lait, puis la farine et le son.', 'Mettre dans un moule antiadhésif et cuire à four chaud (thermostat 7) pendant 20 a 25 mn environ.', 'Etonnant car tellement bon!'], ['Louche', 'Économe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'Cake à la carotte et à la banane', 'testées', 'carotte', 'yaourt nature', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'compote', 'cuisine', 'levure', 'recettes', 'boisson', 'autres cakes', 'dessert', 'plat de résistance', 'farine complète', 'cannelle', 'lait', 'sucre', 'son de blé', 'cocktail'], 'Dessert', 0ff8e3b1-f240-4fd8-bf6e-871b7d312662, '2025-09-26T15:56:52.813338', [{'ingredient_id': 'c57a4543-c332-4123-8f9f-67e7dfeb0308', 'quantite': '1'}, {'ingredient_id': 'c81be33a-ab70-4e87-a84e-238e3013508e', 'quantite': '1'}, {'ingredient_id': '4e3c5536-f88d-4657-8466-a02d322608a6', 'quantite': '1'}, {'ingredient_id': '03632462-4860-4c6a-bb0b-f5d83c951cba', 'quantite': '150 g'}, {'ingredient_id': '93d99222-edba-4295-882d-40140621e301', 'quantite': '50 g'}, {'ingredient_id': 'ba6c707a-6752-4947-a7c3-8deaf67c6b32', 'quantite': '50 g'}, {'ingredient_id': 'ff04f8e5-d9f9-4b33-b1b7-0064d52d21f1', 'quantite': '10 cl'}, {'ingredient_id': '986dbea2-eef8-4ad6-8f2e-01a68b1a22b8', 'quantite': '1 cuillères'}, {'ingredient_id': 'b46bc551-3c32-4152-aebf-b59fbeeeee37', 'quantite': '1 cuillères'}, {'ingredient_id': '48615494-9659-44de-b271-7a32dc2fd190', 'quantite': '1 cuillères'}, {'ingredient_id': 'e43798ee-9aa5-4d86-b031-a4b66405baa9', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (15158, 'Soupe à la banane', 'tomates pelées, banane, bouillon, crème fraîche liquide, poivre, sel, curry, beurre, farine, lait', '10 min', ['Faire fondre le beurre. Ajouter la farine (jusqu''à ce que le beurre l''ait absorbé). Ajouter le lait et ensuite le bouillon.', 'Ajouter les tomates puis les bananes en rondelles. Saler (si nécessaire), poivrer, ajouter du curry (3 cuillères à soupe).', 'Faire cuire à feu moyen pendant environ 20 à 30 mn (attention aux bouillons, la soupe a tendance à déborder).', 'Mixer, ajouter la crème et rectifier l''assaisonnement (le curry doit être bien présent).', 'Servir tel quel ou avec des croûtons.'], ['Tire-bouchon', 'Casserole'], ['Soupe à la banane', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'tomates pelées', 'très facile', 'bon marché', 'plat', 'bouillon', 'recette', 'crème fraîche liquide', 'cuisine', 'recettes', 'boisson', 'farine', 'soupe', 'dessert', 'plat de résistance', 'beurre', 'poivre', 'lait', 'curry', 'cocktail'], 'Entrée', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:56:59.820999', [{'ingredient_id': 'b051d86b-6795-4145-baec-a8da136d5118', 'quantite': '1'}, {'ingredient_id': 'f6f099c9-3dc5-41f7-8663-2d815a9b4bd3', 'quantite': '5'}, {'ingredient_id': '92297ce0-b9ed-4c1c-89c8-807242180df4', 'quantite': '1.5 l'}, {'ingredient_id': '089a3f72-61aa-44e1-8806-757ac9166d96', 'quantite': '20 cl'}, {'ingredient_id': '49d25ab9-2ae0-4868-8fb3-dfd6040dd229', 'quantite': ''}, {'ingredient_id': '6ce23805-9aff-4299-8316-7ee06f01c3ee', 'quantite': ''}, {'ingredient_id': '6e9cd073-e2ab-4d5f-80a9-44c109e503af', 'quantite': ''}, {'ingredient_id': '48b5fce7-49f8-4ef0-9c78-81cc192fb0bf', 'quantite': '50 g'}, {'ingredient_id': '4f3f856d-1778-4dc3-b65c-2d14c67fd2b0', 'quantite': '30 g'}, {'ingredient_id': '538cff6d-7c86-4f5c-8b30-2556b212248a', 'quantite': '15 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (19483, 'Elo banana', 'banane, brick, rhum, sucre vanillé, beurre', '10 min', ['Prendre les bananes et les couper en 2 dans le sens de la longueur, et dans le sens de la largeur. Faire chauffer 2 noix de beurre dans une poêle, y faire dorer les bananes, lorsqu''elles sont dorées et ramollies, ajouter un sachet de sucre vanillé. Puis faire flamber avec les Rhum. ', 'Faire chauffer le four à 200°C . ', 'Sur le plan de travail prendre chaque feuille de brick et les remplir avec une banane, les refermer, et les "coller" avec un peu d''eau. ', 'Faire dorer les gâteaux 5-7 mn au four. ', 'Bon appétit.'], ['Balance de cuisine', 'Moule à tarte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'brick', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Elo banana', 'sucre vanillé', 'beurre', 'cocktail'], 'Dessert', f14d5e44-e3e6-4ddc-9255-93514d147eed, '2025-09-26T15:57:03.451543', [{'ingredient_id': '2aa4f4f5-84cd-4711-92bf-9b7f2850f5df', 'quantite': '4'}, {'ingredient_id': 'beae8577-1fd8-4f41-b637-d978522c57c3', 'quantite': '4'}, {'ingredient_id': '09a05c50-54b4-43b9-b4c0-2cfc4070ab7f', 'quantite': ''}, {'ingredient_id': '5da28289-88ba-4de8-8189-808d0db0e29b', 'quantite': ''}, {'ingredient_id': '63907ba8-81ee-421b-8a22-148c95c17fa2', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (82221, 'Poulet citron aux patates surprises', 'blanc de poulet, patate douce, pomme de terre, banane, jus de citron, purée de piment, mélange d''épices mexicaines, sel de céleri', '20 min', ['Préparer la marinade : dans un saladier, mélanger le jus de citron, la purée de piment, le mélange d''épices mexicain et le sel de céleri. ', 'Couper les blancs de poulet en dés et les mettre dans la marinade. Réserver.', 'Faire cuire les patates douces et les pommes de terre dans de l''eau bouillante pendant environ 10 minutes (tester avec un couteau : la lame doit s''enfoncer facilement dans les patates douces et pommes de terre).', 'Eplucher les patates douces, les pommes de terre ainsi que les bananes et les couper en lamelles.  ', 'Dans une poêle, faire rissoler, dans de l''huile, les patates douces et les pommes de terre. ', 'A mi-cuisson (au bout de 10 minutes), ajouter les bananes coupées en lamelles.', 'En parallèle, dans une autre poêle, faire rissoler (dans de l''huile) le poulet avec la marinade.'], ['Casserole', 'Poêle', 'Batteur électrique', 'Tire-bouchon'], ['poulet en sauce', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'patate douce', 'facile', 'bon marché', 'plat', 'blanc de poulet', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Poulet citron aux patates surprises', 'pomme de terre', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:57:08.011757', [{'ingredient_id': 'd87db584-0675-4293-8cfd-eb99e92f381e', 'quantite': '4'}, {'ingredient_id': '645310dd-64da-4458-bbd3-cacaabbb771d', 'quantite': '6'}, {'ingredient_id': '8546d864-b1a5-4b56-b549-59cc5c22fac1', 'quantite': '2'}, {'ingredient_id': '76c48d3c-5f44-4245-9d4e-e9de0a0f56c3', 'quantite': '3'}, {'ingredient_id': '16aff8db-508c-4699-a804-2e21019546c5', 'quantite': '30 cl'}, {'ingredient_id': '236ba261-ae19-42e3-b74a-b1adc25d3235', 'quantite': '1 cuillères'}, {'ingredient_id': 'de8081c1-0b96-4c31-8be5-3cc29cd83ac6', 'quantite': '3 cuillères'}, {'ingredient_id': 'ebae6161-002a-403d-9bc5-b3266ca84918', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (21635, 'CAKE à la BANANE et au BOURBON', 'noix de pécan, raisins secs, farine, levure chimique, cannelle, gingembre, muscade, beurre tendre, sucre en poudre, banane, oeuf, bourbon', '30 min', ['1) Préchauffez le four à 180°C (Th 6). ', '2) Dans un grand bol, mélangez les noix de pécan et les raisins secs avec 1 cuillère à soupe et demie de farine ; mettre de côté. ', '3) Fouettez ensemble le beurre réduit en pommade et le sucre, jusqu''à consistance mousseuse et homogène. Ecrasez la pulpe des bananes pelées et ajoutez-les au mélange beurre-sucre ; bien remuer. Incorporez ensuite les oeufs un par un, en mélangeant bien après chaque oeuf. ', '4) Ajoutez la farine (avec levure, cannelle, gingembre, et noix de muscade) et l''alcool alternativement. Ajoutez enfin les noix de pécan et les raisins secs. Versez la pâte dans un moule à cake. ', '5) Mettre au four 60 mn.'], ['Batteur électrique', 'Passoire', 'Tire-bouchon', 'Mixeur', 'Moule à tarte'], ['gingembre', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'beurre tendre', 'levure chimique', 'assez cher', 'noix de pécan', 'muscade', 'facile', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'autres cakes', 'CAKE à la BANANE et au BOURBON', 'dessert', 'plat de résistance', 'bourbon', 'raisins secs', 'cannelle', 'cocktail'], 'Dessert', 838b00ad-67b3-4ae8-8b45-4ddafe23617f, '2025-09-26T15:57:11.745719', [{'ingredient_id': '7d3ccbc9-59f0-4330-8bc6-2b126b0cad53', 'quantite': '170 g'}, {'ingredient_id': '55064de8-2180-434d-a6cb-0f52b2f02604', 'quantite': '170 g'}, {'ingredient_id': 'a729b981-b180-4960-97a7-8727701b7445', 'quantite': '320 g'}, {'ingredient_id': 'c67ea550-d880-4de1-8815-eae42cea38e1', 'quantite': '2 cuillères'}, {'ingredient_id': 'fe14961e-aa87-4a61-9299-5e18a8668f3b', 'quantite': '1 cuillères'}, {'ingredient_id': '145b30f0-9b07-454a-a150-6bca0d324a90', 'quantite': '1 cuillères'}, {'ingredient_id': 'abb989cf-4de7-4485-b3c8-50493ef782be', 'quantite': '1 cuillères'}, {'ingredient_id': 'd588be49-c11e-44e9-bff2-2f41c5d7e932', 'quantite': '115 g'}, {'ingredient_id': 'd10e6d6d-b669-41c7-8e12-b7d5ea7fec1b', 'quantite': '220 g'}, {'ingredient_id': '26905f3c-d0b8-4501-b994-822c829c4760', 'quantite': '2'}, {'ingredient_id': '66c6611f-a12c-45cd-83f6-404c217a6775', 'quantite': '2'}, {'ingredient_id': '8c3be6b6-a41c-4e9c-8e0d-4be395f424d9', 'quantite': '6 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (533935, 'Sucette à la banane', 'banane, caramel au beurre salé, beurre de cacahuètes, chocolat noir', '10 min', ['Couper un morceau de banane.', 'Le piquer dans une pic / brochette dans le sens de la longueur.', 'Tremper la banane dans un verre rempli de peanut butter et de caramel beurre salé (un peu chauffé pour qu''il soit bien liquide).', 'Recouvrir de cacahuètes grillées et salées un peu concassées', 'Tremper le tout dans du chocolat fondu.', 'Mettre au froid 15 minutes pour que ça fige.'], ['Ouvre-boîte', 'Tire-bouchon'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'beurre de cacahuètes', 'rapide', 'plat', 'caramel au beurre salé', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat noir', 'Sucette à la banane', 'cocktail'], 'Amuse-gueule', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T15:57:16.350415', [{'ingredient_id': '0b89b02f-6005-4f2e-b32d-af76f27fdd78', 'quantite': ''}, {'ingredient_id': '0bba9a48-5f84-41ac-abcf-242651103561', 'quantite': ''}, {'ingredient_id': 'f91bace4-03e8-4433-82ea-fa5786b8f77d', 'quantite': ''}, {'ingredient_id': '3d284fe4-4203-45d4-b635-d656485f68dd', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (30671, 'Gratins de fruits', 'banane, fraises, cerises, abricot, nectarine, poire, pomme, fromage blanc, sucre, sucre vanillé', '15 min', ['Tout d''abord, préchauffez votre four à 200°C.', 'Pelez les fruits et coupez-les en morceaux: les bananes en rondelles, les pommes en dés, etc. Mettez-les dans un moule à gratin.', 'Dans un saladier, préparez la ''sauce'' en versant les 300g de fromage blanc et le sucre (dosez selon vos goûts). Mélangez, puis versez ce mélange sur les fruits.', 'Pour la dernière ''petite touche'', versez le(s) sachet(s) de sucre vanillé sur le dessus, placez au four et laissez réchauffer pendant 5 minutes.', 'Vous pouvez déguster ce délicieux gratin de fruits tiède.'], ['Mixeur', 'Passoire', 'Rouleau à pâtisserie', 'Économe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'abricot', 'Gratins de fruits', 'poire', 'très facile', 'nectarine', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'fromage blanc', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'moyen', 'sucre', 'cocktail', 'cerises'], 'Dessert', 0f6ba5a7-434d-460a-a444-f36ac3a9db12, '2025-09-26T15:57:20.086621', [{'ingredient_id': '87c88c40-14c3-4c03-8904-0be3433e7dde', 'quantite': '4'}, {'ingredient_id': '254d6d50-1204-4bcf-bc33-ec918a9aac92', 'quantite': '1'}, {'ingredient_id': '2db8c69e-3765-41a0-b1c9-ae9d8d1365b2', 'quantite': '2'}, {'ingredient_id': '52415a7f-d4eb-4e6c-9745-568064bb6509', 'quantite': '6'}, {'ingredient_id': 'f90a453d-ebe2-4581-a4ff-8f07120f19f7', 'quantite': '3'}, {'ingredient_id': 'f6d4a627-abb5-47a3-acf9-f068a6473d4d', 'quantite': '2'}, {'ingredient_id': '92d54be3-3135-4e54-968b-88b11963a56c', 'quantite': '2'}, {'ingredient_id': 'cb40c01a-3178-4649-a03b-a660e3805b8f', 'quantite': '300 g'}, {'ingredient_id': '663d6e7b-2d33-4976-94fc-6242f374487a', 'quantite': ''}, {'ingredient_id': 'd4f4d0ee-801c-4a4b-821a-0dbc5ff0926e', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (62462, 'Milk-shake aux fruits spécial goûter', 'yaourt brassé, banane, pêche, Coulis de cerise, lait, sucre vanillé', '10 min', ['Eplucher les fruits. Mixer ensemble le yaourt et les fruits. ', 'Ajouter le lait en fonction de l''aspect liquide de la préparation. Il faut que ce soit suffisamment liquide pour passer dans la paille !', 'Selon les goûts, ajouter de la vanille ou du coulis de fruits (pour la couleur).', 'Servir frais avec une paille.'], ['Balance de cuisine', 'Planche à découper', 'Pince de cuisine', 'Râpe', 'Moule à tarte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'yaourt brassé', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Coulis de cerise', 'sucre vanillé', 'Milk-shake aux fruits spécial goûter', 'pêche', 'lait', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:57:24.876658', [{'ingredient_id': '5f8f7f5e-f515-42d5-b0c0-fdc57228429c', 'quantite': '1'}, {'ingredient_id': 'c53b4e73-6cdb-4ff8-90fb-9fa21e86a05c', 'quantite': '1'}, {'ingredient_id': '3e9d950d-3f31-49f2-91d1-0a11a0b10fec', 'quantite': '1'}, {'ingredient_id': '93e131af-2ea2-448b-a1ee-5b7aa843928b', 'quantite': '5 cl'}, {'ingredient_id': 'da23fb18-b1de-4d0c-867d-1d856c3fa873', 'quantite': '20 cl'}, {'ingredient_id': '07e4888e-dc99-43ba-a70d-55f640419638', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (23895, 'Jus de bouye (Sénégal)', 'jus d''ananas, fruits, sucre de canne, banane, sucre vanillé, lait en poudre, eau', '20 min', ['Laver le pain de singe (rapidement car sinon, il fond).', 'Faire bouillir de l’eau (4l) puis ajouter le pain de singe (fruit du baobab). ', 'Quelques minutes après, le pain de singe se dissout, puis il ne reste plus que les graines. ', 'Bien remuer pour détacher le reste de pain de singe sur les graines.', 'Retirer les graines, puis filtrer l''eau.', 'Ajouter les 300 g de lait en poudre. Bien mélanger. Rajouter le sucre de canne, le nectar de banane, le jus d''ananas et enfin le sucre vanillé, toujours en mélangeant.', 'Une fois cette opération réalisée, votre jus est prêt!', 'L''embouteiller puis le mettre au frais.', 'Petit conseil : avec les graines, vous pouvez composer de jolis colliers ou bien les planter après les avoir fait chauffer dans l’eau'], ['Louche', 'Fouet'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'très facile', 'Jus de bouye (Sénégal)', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'sucre de canne', 'dessert', 'plat de résistance', 'jus d''ananas', 'sucre vanillé', 'fruits', 'lait en poudre', 'cocktail'], 'Boisson', 1acfb01c-e6b4-43a2-8722-e47a51d4d9f8, '2025-09-26T15:57:28.512792', [{'ingredient_id': '68c55a04-fbb7-430f-9f87-a199a7b43ef4', 'quantite': '1.5 l'}, {'ingredient_id': '0dfdc217-dbee-4245-af78-cf2d9330c9c3', 'quantite': '1 kg'}, {'ingredient_id': '4c8412eb-6951-46a5-9b97-f196b3a330d0', 'quantite': '1 kg'}, {'ingredient_id': 'e9ce6490-6e2d-4364-a664-51b261143e10', 'quantite': '15 cl'}, {'ingredient_id': 'c5919f7d-5df5-478c-93f8-30c4390bce74', 'quantite': '8'}, {'ingredient_id': 'e7da9427-81b8-4f57-b58c-ff5cc9da1cb0', 'quantite': '300 g'}, {'ingredient_id': '25db05f8-3a14-4fed-8e17-7d72eed0c592', 'quantite': '4 l'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (531114, 'Ananas rôti, banane, fruit de la passion, chantilly', 'beurre, farine, sucre, blanc d''oeuf, ananas, sucre, jus d''ananas, vanille, huile d''olive, ananas, banane, fruit de la passion, citron vert, crème, mascarpone, sucre glace, vanille, noix de coco', '40 min', ['Pour la tuile cigarette : réaliser un beurre pommade, ajouter le sucre, la farine et finir par les blancs.', 'Mettre en forme, cuire et rouler.', 'Pour l''ananas rôti : couper l’ananas en tronçons.', 'Réaliser un caramel à sec avec le sucre.', 'Caraméliser les tronçons dans le caramel.', 'Décuire avec le jus d’ananas et le sucre, napper les ananas régulièrement.', 'Une fois cuit, les retirer, garder le jus et le perler à l’huile d’olive.', 'Pour la brunoise : réaliser une belle brunoise avec les fruits. Assaisonner avec le jus du citron vert.', 'Pour la chantilly : mélanger la crème, le mascarpone, le sucre glace et les graines de la gousse de vanille. Mettre en siphon.', 'Pour les lamelles de coco : casser la noix de coco, la couper en deux. Réaliser des lamelles avec un économe.'], ['Spatule', 'Presse-agrumes', 'Poêle'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'Ananas rôti', 'recettes', 'boisson', 'farine', 'fruit de la passion', 'dessert', 'plat de résistance', 'chantilly', 'beurre', 'sucre', 'blanc d''oeuf', 'cocktail'], 'Dessert', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T15:57:33.042481', [{'ingredient_id': '08721782-981a-4db0-a115-8447cd8327af', 'quantite': '50 g'}, {'ingredient_id': 'a21b916f-07c4-4b8b-820f-7d0a76b7ed64', 'quantite': '50 g'}, {'ingredient_id': '49fbe0f9-801f-4a6f-888c-b0a7b4cb0528', 'quantite': '50 g'}, {'ingredient_id': '0fa51dba-3e8a-4d7e-ad9d-d71e224d6e49', 'quantite': '50 g'}, {'ingredient_id': 'cc7e3a41-b074-4c1f-b8c5-19ef4b838826', 'quantite': '2'}, {'ingredient_id': '00c8e774-c1e9-4de4-a467-af3d9a55f393', 'quantite': ''}, {'ingredient_id': 'bd6beeaa-62b0-44a6-ad31-fce49e679a64', 'quantite': ''}, {'ingredient_id': '8b70ee73-df27-4fff-af3f-47dcd5e29bbb', 'quantite': ''}, {'ingredient_id': 'a7729da4-7600-4a9d-8926-76e618d5e204', 'quantite': ''}, {'ingredient_id': '32ad464d-7db9-48ee-a063-89beb3d88333', 'quantite': '50 g'}, {'ingredient_id': 'e48499c0-a09d-4ede-9c16-9901b0bf0eb7', 'quantite': '50 g'}, {'ingredient_id': '249bfb49-447a-46b1-8c1c-6e3e09930afe', 'quantite': '1'}, {'ingredient_id': 'f5a93f1c-2e46-439c-acb8-5e4f4b6b1c82', 'quantite': ''}, {'ingredient_id': '173faf5d-9611-4df4-b48e-4e562338b1d0', 'quantite': '150 g'}, {'ingredient_id': 'b8390b3d-c600-41dc-b4aa-79aa8ffe3d81', 'quantite': '20 g'}, {'ingredient_id': '9ca0cfa2-59fd-4af6-a554-ab49c930df3e', 'quantite': '20 g'}, {'ingredient_id': 'f307a4d0-21bd-43c1-b2e9-eb6cfe46010e', 'quantite': '1'}, {'ingredient_id': '2e8b74ee-ed04-48cc-af00-932ff6b2131f', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (38703, 'Tarte Tatin banane chocolat', 'pâte brisée, banane, jus de citron, beurre, sucre vanillé, chocolat pâtissier', '20 min', ['Préchauffez le four à 180°C (thermostat 6). ', 'Epluchez les bananes, coupez-les en rondelles et citronnez-les pour qu''elles ne noircissent pas.', 'Dans une grande poêle, faites fondre le beurre et le sucre vanillé puis faites soigneusement dorer les rondelles de bananes en veillant à ne pas les écraser.', 'Disposez au fond d''un moule à tarte beurré les pastilles de chocolat et les rondelles de bananes dessus sur deux épaisseurs.', 'Posez la pâte et enfournez pendant 25 min.'], ['Fouet', 'Casserole'], ['entrée', 'tarte au chocolat', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'plat', 'recette', 'chocolat pâtissier', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'Tarte Tatin banane chocolat', 'dessert', 'plat de résistance', 'sucre vanillé', 'jus de citron', 'beurre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:57:36.947538', [{'ingredient_id': '9b16130e-6e2a-42cb-8bd0-e3ca3418f0b5', 'quantite': '250 g'}, {'ingredient_id': '3b1a720d-bfdc-440d-886e-0971d7f21ce1', 'quantite': '4'}, {'ingredient_id': '03112022-7825-421a-9f5f-d00cb3c3c7b2', 'quantite': '1'}, {'ingredient_id': '2cbc9914-10da-46be-beef-43195f7f0153', 'quantite': '50 g'}, {'ingredient_id': 'f45b8860-5a98-425f-98db-7261c103ae8b', 'quantite': '2'}, {'ingredient_id': 'd4d850eb-6694-4391-8918-eaad90b084f9', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (214843, 'Crumble Bananes-Framboises et amandes effilées', 'farine, sucre roux, beurre, framboises, banane, sel', '10 min', ['Préchauffez votre four à 180°C (thermostat 6).', 'Sortez le beurre à l''avance de façon à se qu''il soit un peu ramolli.', 'Dans un saladier, mélangez la farine, le sucre et la pincée de sel.', 'Découpez le beurre en dés et ajoutez-les au mélange. Malaxez le tout jusqu''à obtenir une pâte friable entre les doigts.', 'Beurrez votre moule et déposez-y les framboises (sans le jus). Découpez les bananes en rondelles et disposez les sur les framboises.', 'Effritez la pâte préalablement préparée au dessus du moule.', 'Enfournez le tout au four pendant 25 minutes. 5 minutes avant la fin de cuisson, ajoutez les amandes effilées. ', 'MMMMM ! C''est prêt :)'], ['Mixeur', 'Râpe', 'Batteur électrique', 'Passoire', 'Balance de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'facile', 'framboises', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'autres crumbles', 'moyen', 'beurre', 'Crumble Bananes-Framboises et amandes effilées', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:57:40.483993', [{'ingredient_id': '36e0d825-873a-4cb6-baf1-9f3dc548da77', 'quantite': '150 g'}, {'ingredient_id': '15201ce0-ecc9-4974-9a7d-979a195a7943', 'quantite': '150 g'}, {'ingredient_id': '95f4c801-e9fd-4701-ae2c-faa2660ba31f', 'quantite': '125 g'}, {'ingredient_id': '677ddf1e-6d7c-4447-a720-70ea14f859f9', 'quantite': '150 g'}, {'ingredient_id': 'd5cc6901-c3bd-4e5e-8a33-6e9a1ab836ad', 'quantite': '2'}, {'ingredient_id': '567876fa-fa49-49f2-9943-5877af92697f', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (51263, 'Pina colada coco banane', 'banane, jus d''ananas, crème fraîche, citron, rhum, glaçons', '10 min', ['Mixer la banane avec le rhum coco, la crème fraîche et les glacons jusqu''à obtention d''une crème.', 'Incorporer le jus d''ananas, quelques gouttes de citron et fouetter pour incorporer.', 'Servir glacé.'], ['Poêle', 'Planche à découper', 'Batteur électrique', 'Presse-agrumes', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'rhum', 'confiserie', 'testées', 'Piña colada', 'très facile', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'jus d''ananas', 'glaçons', 'moyen', 'citron', 'Pina colada coco banane', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:57:44.839334', [{'ingredient_id': '8489cbfe-96c8-4a06-b742-b66e14cdef20', 'quantite': '1'}, {'ingredient_id': '00bdf5bc-5eb7-4b6f-b060-1060cfc26edf', 'quantite': '25 cl'}, {'ingredient_id': 'b2dad830-03e7-4e0f-a825-0d6ceae9bc21', 'quantite': '1 cuillères'}, {'ingredient_id': 'c6359452-24be-4a0d-a988-1c26239e4eca', 'quantite': ''}, {'ingredient_id': 'a18f3d6c-3f09-4c97-8fd2-b77db0c835b8', 'quantite': '10 cl'}, {'ingredient_id': '6be46bd8-458c-427f-9405-5ea7db4423aa', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (50604, 'Cocktail de fruits', 'banane, pomme, kiwi, eau, sucre vanillé, cassonade', '10 min', ['Peler et couper les fruits en morceaux.', 'Les mettre dans le blender (ou tout autre récipient à cocktail), puis mixer le tout, en rajoutant peu à peu l''eau, jusqu''à obtention de la consistance voulue (moi j''aime bien quand c''est un peu épais).', 'Rajouter ensuite le sucre vanillé et la cassonade, selon le goût. ', 'Mixer une dernière fois pour que le sucre s''intègre bien au mélange.', 'Mettre au frais pendant une petite heure et déguster !'], ['Poêle', 'Ouvre-boîte'], ['', 'Cocktail de fruits', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'cassonade', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'cocktail'], 'Boisson', c5349ae6-0af7-4fe1-87f6-26a7246265e9, '2025-09-26T15:57:48.431209', [{'ingredient_id': 'db965038-32cb-4a9a-b6b8-f40ed2336c58', 'quantite': '1'}, {'ingredient_id': 'a71f9bf1-ea6e-4217-a679-6ff3ef6095a6', 'quantite': '1'}, {'ingredient_id': '4a2b8883-ef6b-4748-bf9b-9d5f5394127e', 'quantite': '2'}, {'ingredient_id': '5b508119-8309-4252-b713-575946195827', 'quantite': '1'}, {'ingredient_id': 'd6ab53cc-1e7f-42dc-9030-45d88d1906e6', 'quantite': '1'}, {'ingredient_id': '83e18490-a140-407c-b6b3-ea2a42e94ed9', 'quantite': '3 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (43066, 'Crumble banane / kiwi', 'banane, kiwi, farine, sucre roux, beurre', '15 min', ['Au fond de votre plat : disposez les rondelles de kiwis, puis ajoutez les rondelles de bananes par dessus, et enfin saupoudrez légèrement de sucre roux.', 'Dans un autre récipient, mettez le beurre un peu ramolli (passez 5 à 10 secondes au micro-ondes si nécessaire), la farine et le sucre roux.', 'Servez-vous de vos mains, propres bien sûr, et mélangez le tout jusqu''à ce que la farine soit bien absorbée par le reste des ingrédients. ', 'Vous obtenez alors une pâte très compacte qui s''émiettera un peu.', 'Ensuite, vous répandrez la pâte sur les fruits.', 'Passez votre plat au four, surveillez de temps en temps... jusqu''à ce que le crumble soit légèrement doré. Et voilà!'], ['Verre doseur', 'Batteur électrique', 'Spatule'], ['entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'crumble banane', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'beurre', 'cocktail', 'sucre roux', 'Crumble banane / kiwi'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:57:55.205335', [{'ingredient_id': '14b03291-102b-4561-bab4-30c707b6ac77', 'quantite': '3'}, {'ingredient_id': 'dd84f0ea-4d9c-4655-b73a-b1cebe607b49', 'quantite': '4'}, {'ingredient_id': '7e922c73-a972-4cee-b0cd-11293e2454b3', 'quantite': '150 g'}, {'ingredient_id': '4b56e398-c2a0-4c12-b1da-b3fe1fca7ee2', 'quantite': '150 g'}, {'ingredient_id': '84d997ca-848f-459f-a8ac-7d7ee9bbfde8', 'quantite': '150 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (535003, 'Salade de fruits d''hiver de Gigi', 'litchi, fruit de la passion, citron vert, banane, kiwi, feuille de menthe, sucre, kaki', '15 min', ['Découper les fruits en tout petits morceaux.', 'Ajouter le fruit de la passion, le jus d''un citron vert et la menthe ciselée. ', 'Ajouter une cuillère à soupe de sucre (c''est encore meilleur avec un sucre aromatisé aux zestes d''agrumes !)', 'Il suffit de bien mélanger le tout et de laisser quelques minutes tous les goûts s''infuser. ', 'Utiliser un emporte-pièce pour faire des petites fleurs avec la banane. Cela donne beaucoup d''originalité à cette salade !'], ['Mixeur', 'Pince de cuisine', 'Tire-bouchon', 'Batteur électrique'], ['entrée', 'banane', 'kiwi', 'salade de fruits', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'rapide', 'plat', 'recette', 'cuisine', 'kaki', 'recettes', 'boisson', 'fruit de la passion', 'dessert', 'plat de résistance', 'moyen', 'feuille de menthe', 'citron vert', 'sucre', 'litchi', 'Salade de fruits d''hiver de Gigi', 'cocktail'], 'Dessert', a552a391-dc84-4f86-9818-933285752b21, '2025-09-26T15:57:59.710343', [{'ingredient_id': 'de122a37-f3cb-417a-846d-da0f3f1cc0ce', 'quantite': '1'}, {'ingredient_id': 'f9a0e9c4-4618-45db-abb9-1ab2c483642c', 'quantite': '1'}, {'ingredient_id': '2aa9bc7c-50a0-46d3-b8da-52c82cc1081b', 'quantite': '1'}, {'ingredient_id': '3db4a129-252a-499e-b940-b1ae407d0ab5', 'quantite': '1'}, {'ingredient_id': '2216a23d-e247-4d90-9029-6d426a042cde', 'quantite': '1'}, {'ingredient_id': '97825ab0-6f47-4535-9e27-9ddabc583e4f', 'quantite': '1'}, {'ingredient_id': '6403db87-6dea-41c1-9b35-335674848aa1', 'quantite': '1 cuillères'}, {'ingredient_id': '5ca79caf-f79d-4063-93fc-e6480a4f31f5', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (172383, 'Gâteau quinoa-banane (sans oeufs et sans beurre)', 'quinoa, farine de riz, lait de soja, maïzena, banane, sucre, levure', '20 min', ['Préchauffer le four à 200°C (thermostat 7).', 'Faire bouillir de l''eau puis faire cuire le quinoa le temps indiqué sur le paquet.', 'Dans un saladier, mélanger le lait de soja, la maïzena, la farine de riz, le sucre et la levure.', 'Ensuite, écraser les bananes et les ajouter à la préparation. Mélanger le tout.', 'Une fois le quinoa cuit, l''égoutter et l''ajouter à la préparation, bien mélanger à nouveau.', 'Verser le tout dans un moule à cake en silicone et enfourner pendant environ 35 min dans un four à 200°C.', 'Un fois cuit, laisser refroidir et déguster.', 'Bon appétit !'], ['Rouleau à pâtisserie', 'Moule à tarte', 'Mixeur', 'Verre doseur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'farine de riz', 'testées', 'très facile', 'maïzena', 'bon marché', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'gâteau à la banane', 'quinoa', 'lait de soja', 'Gâteau quinoa-banane (sans oeufs et sans beurre)', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:58:03.322776', [{'ingredient_id': '7dcada19-a20c-4e24-a4f2-97eeb9e28c87', 'quantite': '120 g'}, {'ingredient_id': '87586665-962c-4189-ab72-357f3fd24a0e', 'quantite': '100 g'}, {'ingredient_id': '682f17a7-a20c-4bef-b4af-56c1548f7e02', 'quantite': '15 cl'}, {'ingredient_id': 'e8b8cfa9-a021-4fb2-8b00-d65841f5b07a', 'quantite': '2 cuillères'}, {'ingredient_id': '51d9fbd9-8254-48fe-8aea-b41787ec1200', 'quantite': '2'}, {'ingredient_id': '4719c7d6-f77c-4514-90a9-b31f178087f4', 'quantite': '50 g'}, {'ingredient_id': 'e7d39dde-87ca-4c56-94dd-efa4ee5a1ae2', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (72189, 'Smoothie Fraises', 'fraises, banane, glaçons, sucre', '5 min', ['- Mixer les fraises et la banane.', '- Rajouter éventuellement un peu de sucre si les fraises ne sont pas assez sucrées.', '- Ajouter les glaçons et les broyer en glace pilée pour obtenir un jus glacé.'], ['Mixeur', 'Presse-agrumes', 'Fouet'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'Smoothie Fraises', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'glaçons', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:58:09.330470', [{'ingredient_id': '08651401-dadc-4e64-86c9-b230cf35950b', 'quantite': '300 g'}, {'ingredient_id': '255671e8-f011-4e27-ab9c-10110dc5b68a', 'quantite': '1'}, {'ingredient_id': '0b4fe86f-40b5-4e4f-b40f-6644f181fa93', 'quantite': ''}, {'ingredient_id': '015c409a-5a3b-4061-b3d3-bd3db30a85cf', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (312184, 'Salade exotique aux fruits', 'kiwi, orange, citron, raisin, poire, fraises, mangue, banane, sirop de sucre de canne, menthe, fleur d''oranger', '20 min', ['Éplucher les fruits en prenant bien soin de vider les grains noirs à l''intérieur de la papaye, les couper finement puis ajouter le sucre liquide et la fleur d oranger et enfin la menthe. ', 'Réserver au moins 2 heures au frais.'], ['Pince de cuisine', 'Fouet', 'Tire-bouchon', 'Ouvre-boîte', 'Louche'], ['raisin', 'sirop de sucre de canne', 'banane', 'entrée', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'menthe', 'facile', 'rapide', 'Salade exotique aux fruits', 'plat', 'mangue', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'citron', 'fleur d''oranger', 'orange', 'salade de fruits exotiques', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:58:13.808547', [{'ingredient_id': 'f9fe9b7b-c899-4e5f-ad89-b300774efce7', 'quantite': '2'}, {'ingredient_id': '3be46adc-2b90-4ffb-a5d7-fbedd024ef8f', 'quantite': '2'}, {'ingredient_id': 'f1aadbcd-dd25-47b5-94eb-051de715d53d', 'quantite': ''}, {'ingredient_id': 'e2823e58-86b7-4309-9d46-1cdd620f7d8d', 'quantite': '1'}, {'ingredient_id': '0caa9589-e764-4149-bee4-44c9ef7b961a', 'quantite': '1'}, {'ingredient_id': '17676504-9121-444e-bb11-91c967047452', 'quantite': '250 g'}, {'ingredient_id': 'e12d5b1a-2ef0-41e5-8a58-d658c7822246', 'quantite': '3'}, {'ingredient_id': 'b11bb425-c309-48ac-b618-14db9e414428', 'quantite': '3'}, {'ingredient_id': 'b2de1714-c41a-4f91-a7d2-ae8c82a9361c', 'quantite': '20 cl'}, {'ingredient_id': '5f994e80-f588-45a3-862e-88f8d55db551', 'quantite': '1'}, {'ingredient_id': '7cbbb741-84b6-4b21-80e3-046c42fd64ed', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (51116, 'Papillotes bananes caramel coco', 'banane, caramel, noix de coco rapée, papier sulfurisé', '5 min', ['Découper 4 feuilles rectangulaires de papier sulfurisé pour en faire des papillotes.', 'Sur chacune d''elles, déposer une banane épluchée.', 'Recouvrir chaque banane de caramel à l''envie et saupoudrer d''1 cuillère à soupe de noix de coco râpée.', 'Fermer les papillotes.', 'Cuire au four à micro-ondes, puissance maximale, 50 secondes à 1 minute selon la puissance du four.'], ['Rouleau à pâtisserie', 'Verre doseur', 'Balance de cuisine', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'caramel', 'bon marché', 'rapide', 'plat', 'recette', 'papier sulfurisé', 'cuisine', 'recettes', 'boisson', 'noix de coco rapée', 'dessert', 'plat de résistance', 'cocktail', 'Papillotes bananes caramel coco'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:58:17.400818', [{'ingredient_id': 'a0fb108e-9504-4f78-86ed-1115e6ed0f6f', 'quantite': '4'}, {'ingredient_id': 'e4702d7f-189c-43a6-85e3-1741824a33cb', 'quantite': '1'}, {'ingredient_id': '4aa9882f-6229-47fa-abab-e399bb5fa2a1', 'quantite': '4 cuillères'}, {'ingredient_id': 'b42658b7-273c-411b-846b-d1a004198cd1', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (68346, 'gâteau retour de l''école', 'beurre, sucre blond, oeuf, farine, levure chimique, banane, cacao, noix de coco rapée, babeurre', '20 min', ['Battre le beurre mou, le sucre blond et les oeufs ensemble, au batteur c''est facile et rapide.', 'Ajouter les bananes écrasées, le cacao et la noix de coco. Bien mélanger.', 'Mélanger la farine avec la levure et les incorporer au mélange précédent ainsi que le babeurre.', 'Verser la pâte dans un moule à manqué beurré et légèrement fariné. ', 'Cuire le gâteau environ 45 min à 180°C (thermostat 6)'], ['Râpe', 'Verre doseur', 'Batteur électrique', 'Spatule'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'sucre blond', 'très facile', 'bon marché', 'cacao', 'babeurre', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'noix de coco rapée', 'dessert', 'plat de résistance', 'beurre', 'gâteau retour de l''école', 'cocktail'], 'Dessert', 02709916-149f-45f1-8d0b-29a3f89ccaa0, '2025-09-26T15:58:21.861373', [{'ingredient_id': '6625efc8-3573-4d68-8e2f-ebdb28afc8ae', 'quantite': '120 g'}, {'ingredient_id': '6f1c258b-c8d1-4ffe-9dd8-6e97a554ce24', 'quantite': '200 g'}, {'ingredient_id': '0d7fe1c2-20e4-418c-a023-05413517bb80', 'quantite': '2'}, {'ingredient_id': 'b0be5fe8-66f6-4323-9db2-eec12094fc3b', 'quantite': '200 g'}, {'ingredient_id': '424116da-f265-4275-a04b-deb671d25a24', 'quantite': '3 cuillères'}, {'ingredient_id': 'bf3705e5-904b-4822-9667-4e9f35faae64', 'quantite': '2'}, {'ingredient_id': 'cef6c7a6-dca2-4403-8df2-f8dbc3df6bf2', 'quantite': '50 g'}, {'ingredient_id': '4eec72a5-41de-4733-a735-d1918a85e29f', 'quantite': '50 g'}, {'ingredient_id': '17d6446f-8631-40fa-95a8-a11fbbd7a45a', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (46598, 'Gâteau marbré citron/chocolat', 'oeuf, farine, sucre, lait, huile, levure, citron, Banania, rhum', '10 min', ['Préchauffer le four à 150-160°C (thermostat 5).', 'Dans un saladier, verser la farine avec la levure. Ajouter le sucre et les oeufs. ', 'Délayer peu à peu avec le lait puis avec l''huile. Bien mélanger.', 'Séparer la pâte en deux parties égales (2 saladiers). Dans le premier saladier, ajouter à la pâte le jus des 2 citrons. Dans le deuxième, ajouter le Banania et 1 cuillère à soupe de rhum.', 'Dans un grand moule à cake beurré, alterner les couches jaunes et les couches brunes (commencer et terminer par une couche au citron).', 'Faire cuire à 160°C pendant 50 min.'], ['Planche à découper', 'Batteur électrique'], ['entrée', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'Banania', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'huile', 'farine', 'dessert', 'plat de résistance', 'citron', 'Gâteau marbré citron/chocolat', 'gâteau au chocolat', 'sucre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:58:26.715060', [{'ingredient_id': 'bbb2b7c6-3c8e-4e5d-b4df-aa2406850008', 'quantite': '3'}, {'ingredient_id': 'bb6d77db-59ab-429e-9bb3-081ac66a11a7', 'quantite': '300 g'}, {'ingredient_id': '6cc558f0-37bb-474b-83cd-183be5301aba', 'quantite': '200 g'}, {'ingredient_id': '25e73e13-d97e-47a5-8657-b04cf4965c1d', 'quantite': '10 cl'}, {'ingredient_id': 'a947d641-c154-4583-b296-b9ec6d75ac7e', 'quantite': '10 cl'}, {'ingredient_id': 'dc664a0b-3217-4b39-b46e-27f5de469692', 'quantite': ''}, {'ingredient_id': '89b419fe-a7d2-4d7a-8667-739c4c61e7e6', 'quantite': '2'}, {'ingredient_id': '8295b5ef-8f51-4b2b-a9ec-981ec1a047d8', 'quantite': '40 g'}, {'ingredient_id': '745709fe-56da-4891-b743-faa823a6f414', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (72513, 'Smoothie Banane Chocolat', 'banane, glaçons, lait, chocolat en poudre', '5 min', ['Mixer le tout au blender environ 30 sec.'], ['Casserole', 'Fouet', 'Louche', 'Couteau de chef', 'Poêle'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'Smoothie Banane Chocolat', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'glaçons', 'lait', 'chocolat en poudre', 'smoothies', 'cocktail'], 'Boisson', 1bbf76fc-dec1-4652-bcab-1659df9f0cf5, '2025-09-26T15:58:31.353769', [{'ingredient_id': '9e64beab-cb9a-4f37-814f-7cf83c03c57e', 'quantite': '1'}, {'ingredient_id': 'd5c32b86-b160-4ec3-8c6d-8ad26a0af4ab', 'quantite': '1'}, {'ingredient_id': 'ab2d1e1c-6363-46d2-b136-3290137baff8', 'quantite': '1'}, {'ingredient_id': '518a7fe9-dd92-4d80-83d4-28936284441d', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (530543, 'Cake banane, poire et pomme', 'banane, poire, pomme, farine, oeuf, sel, levure chimique, lait, sucre', '20 min', ['Lave et épluche les fruits.', 'Ensuite, coupe la banane en rondelles, puis coupe la poire et la pomme en cube.', 'Demande à un adulte de préchauffer le four au thermostat sur 6/7 (200°C).', 'Mélange les œufs et le sucre, ajoute la farine et la levure puis le lait, mélange le tout.', 'Ajoute les fruits et mélange le tout.', 'Beurre le moule à cake et verses-y la préparation.', 'Demande à un adulte de mettre au four pendant 20/25 min.', 'Vérifie la cuisson avec la pointe d''un couteau sans te brûler !'], ['Ouvre-boîte', 'Spatule', 'Verre doseur', 'Casserole'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'levure chimique', 'poire', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'poire et pomme', 'cuisine', 'recettes', 'boisson', 'farine', 'autres cakes', 'dessert', 'Cake banane', 'plat de résistance', 'pomme', 'lait', 'sucre', 'cocktail'], 'Dessert', 5b367c7c-67ed-44f7-b5e9-bee1bc6abb0e, '2025-09-26T15:58:34.883416', [{'ingredient_id': '938d6828-d603-4cff-bba7-50a817d65301', 'quantite': '2'}, {'ingredient_id': 'a1bded3e-51c8-4678-b7ba-3eed6865c2ab', 'quantite': '1'}, {'ingredient_id': '2af0c813-dea0-42b0-8812-7024af789002', 'quantite': '1'}, {'ingredient_id': '78571abf-2027-4e09-b70f-b815af3b5ef3', 'quantite': '150 g'}, {'ingredient_id': 'b79095f9-4d20-4df2-9282-3e6b3fa15b7a', 'quantite': '3'}, {'ingredient_id': 'f2a625ba-6060-4657-ad75-66d5221fa23c', 'quantite': '1'}, {'ingredient_id': 'cd13160f-630d-40b3-9262-3d8f4f56dbe6', 'quantite': '1'}, {'ingredient_id': '586493a3-2c70-4397-a17e-06b82b736265', 'quantite': '20 cl'}, {'ingredient_id': '794b7666-0469-4c54-8fe9-63ceb42e9f9c', 'quantite': '3 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (20129, 'Bananes au jambon rapides', 'banane, jambon, crème fraîche, gruyère râpé, sauce tomate', '5 min', ['Enrouler les bananes avec les tranches de jambon. ', 'Les disposer dans un plat allant au four.', 'Arroser de crème fraîche mélangée avec de la sauce tomates. ', 'Parsemer de gruyère râpé. ', 'Mettre à four chaud pendant 10 à 15 min.'], ['Passoire', 'Spatule', 'Ouvre-boîte', 'Louche', 'Tire-bouchon'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'jambon', 'confiserie', 'testées', 'sauce tomate', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'gruyère râpé', 'dessert', 'plat de résistance', 'Bananes au jambon rapides', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:58:38.497407', [{'ingredient_id': 'a728fb45-d5a3-482c-9bac-8bb08ec0e224', 'quantite': '2'}, {'ingredient_id': 'ba93eecf-cf58-4ba4-85de-d09010bcca5e', 'quantite': '2'}, {'ingredient_id': '94bb2f75-5f7a-4b68-81e1-5951b465c2bf', 'quantite': ''}, {'ingredient_id': 'ae1fdb3e-53b6-482e-95b9-76d0bdd8208a', 'quantite': ''}, {'ingredient_id': '8c8aacd7-2a44-43da-ba9a-0a16c377ad37', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (68524, 'Tarte pistache vanille chocolat banane meringuée', 'pâte brisée, chocolat noir, lait, crème, crème anglaise, banane, sucre, blanc d''oeuf, cerises', '60 min', ['Etalez votre pâte et placez-la dans un moule à tarte. A l''aide d''une fourchette, piquez le fond de votre pâte (sans toutefois en faire trop).', 'Faites-la cuire 15 à 25 min au four à 180°C (thermostat 6) puis laissez-la refroidir.', 'Pendant ce temps, faites fondre le chocolat au bain-marie avec le lait. Etalez-le ensuite sur la pâte refroidir.', 'Ouvrez la boîte de crème dessert à la pistache et versez-la proprement sur le chocolat. Versez doucement la crème anglaise dessus puis placez la tarte au réfrigérateur.', 'Dans un saladier, battez énergiquement avec un batteur à oeuf les blancs d''oeufs et le sucre. Une fois que le mélange est bien monté, mettez-le dans une poche à douille et placez-le dans un autre moule à tarte préalablement recouvert d''une feuille de papier sulfurisé en formant une spirale du milieu vers les bords.', 'Faites cuire la meringue 30 minutes au four à 80°C (thermostat 2-3).', 'Quand elle est cuite, laissez-la refroidir, démoulez-la sans la casser et placez-la sur votre tarte.', 'Ajoutez en décoration les cerises tout autour de la tarte.', 'Et voilà, vous pouvez vous régaler!!!'], ['Pince de cuisine', 'Batteur électrique', 'Planche à découper'], ['entrée', 'tarte au chocolat', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Tarte pistache vanille chocolat banane meringuée', 'plat', 'moyenne', 'crème', 'recette', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat noir', 'moyen', 'lait', 'sucre', 'blanc d''oeuf', 'cocktail', 'crème anglaise', 'cerises'], 'Dessert', 12983bc4-8329-483f-9050-066803c4e35b, '2025-09-26T15:58:43.053496', [{'ingredient_id': '820dc230-da15-4b19-aad4-bfe2865d4431', 'quantite': '1'}, {'ingredient_id': '7275d85e-9cd4-4701-88f1-1a16ac30f92d', 'quantite': '250 g'}, {'ingredient_id': 'd6210dc6-3e64-4aee-9e30-7df3da85443d', 'quantite': '3 cuillères'}, {'ingredient_id': '88ff6f68-e1dd-421d-a182-f9a3ede5acc3', 'quantite': '25 cl'}, {'ingredient_id': 'a79a87a3-0d6a-47be-9f46-561f9c0c2520', 'quantite': '25 cl'}, {'ingredient_id': '66e1b7e7-0761-4df8-a671-155e32a5bd84', 'quantite': '3'}, {'ingredient_id': '9a8e8c8d-e40e-4f3c-ad84-cfcbdbebaf4b', 'quantite': '100 g'}, {'ingredient_id': '30253369-0721-42ee-84b0-4a0b4c8535e6', 'quantite': '2'}, {'ingredient_id': '7b7b1877-f6ae-452a-946b-f375e9572b6b', 'quantite': '12'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (26941, 'Confiture de banane au rhum', 'banane, sucre roux, eau, citron vert, cannelle, vanille, gingembre, rhum', '10 min', ['Epluchez les bananes en rondelles fines. ', 'Mélangez l''eau, le jus des citrons, le sucre, la cannelle, les gousses de vanille fendues, et le gingembre. ', 'Mettez sur feu modéré et remuez sans cesse à la cuillère de bois jusqu''à ce que le sirop soit nappant. ', 'Mettez alors les rondelles de bananes. Laissez cuire 15 à 25 mn en remuant de temps en temps. ', 'Retirez du feu et ajoutez le rhum. ', 'Mettez en pots.'], ['Presse-agrumes', 'Planche à découper', 'Casserole', 'Mixeur', 'Verre doseur'], ['', 'gingembre', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'eau', 'testées', 'très facile', 'bon marché', 'Confiture de banane au rhum', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'vanille', 'dessert', 'plat de résistance', 'citron vert', 'cannelle', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:58:49.982737', [{'ingredient_id': 'b53c89c9-4e0f-4885-bf2d-9306de304df4', 'quantite': '1 kg'}, {'ingredient_id': '0e7f4b7c-84ed-4372-948f-9146ef684baf', 'quantite': '750 g'}, {'ingredient_id': 'fb2e1d86-f67d-4fb9-8513-a469c945dc28', 'quantite': '3'}, {'ingredient_id': 'bcde50be-50ec-462b-8347-82387d618fa8', 'quantite': '3'}, {'ingredient_id': '9e641b76-2d23-4712-94d4-076c3feb22ea', 'quantite': '1 cuillères'}, {'ingredient_id': '8223bd65-f710-4cf7-93b6-9cd9ebc00a21', 'quantite': '3'}, {'ingredient_id': '8686cbee-f8cc-415c-9346-b053bf6b5374', 'quantite': '1'}, {'ingredient_id': '9809f5e0-c949-4f7c-9ffe-24db5057a290', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (92462, 'Tarte fondante banane chocolat', 'pâte sablée, banane, oeuf, beurre, chocolat, sucre', '30 min', ['1/ Etaler la pâte sablée dans un moule à tarte. La faire cuire à blanc thermostat 8 pendant 10 à 15 minutes selon le four.', '2/ Faire fondre un morceau de beurre dans une poêle. ', 'Ajouter les bananes préalablement tranchées. Saupoudrer de sucre. ', 'Faire revenir à feu doux pendant 5 minutes.', 'Verser cette préparation sur la pâte sablée.', '3/ Faire fondre au bain-marie les 100 g de chocolat avec les 10 g de beurre.', 'Séparer les jaunes des blancs d''oeufs. Ajouter les jaunes d''oeufs dans le plat avec la préparation au chocolat. Ajouter le sucre à cette préparation.', 'Battre les blancs en neige (+ 1 pincée de sel). Les ajouter en soulevant à la préparation au chocolat.', 'Verser cette préparation sur les bananes dans le plat à tarte.', '4/ Mettre au frais quelques heures avant de se régaler.'], ['Économe', 'Fouet', 'Mixeur', 'Casserole', 'Tire-bouchon'], ['entrée', 'tarte au chocolat', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'très facile', 'bon marché', 'pâte sablée', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'Tarte fondante banane chocolat', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'sucre', 'cocktail'], 'Dessert', 2e9b0411-b5f0-48bb-a9f4-1f7ba98fb60e, '2025-09-26T15:58:54.668797', [{'ingredient_id': 'e67ba40c-496b-4739-947a-afc95327290c', 'quantite': '1'}, {'ingredient_id': '8c113df9-8348-4d71-880f-d98e0ee1c6db', 'quantite': '4'}, {'ingredient_id': 'ace83101-9c1a-44e9-98e8-4069c3ae2924', 'quantite': '2'}, {'ingredient_id': '96e86dd4-9d3a-44b4-b120-4cb426e7b161', 'quantite': '10 g'}, {'ingredient_id': '6f2f4a64-0404-4061-849b-e6bdfe297c31', 'quantite': '100 g'}, {'ingredient_id': '10bcc43c-87c6-42ba-b1b3-1d4afeafad1b', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (43911, 'Tarte poires, bananes, et chocolat ultra-simple', 'pâte feuilletée, poire, banane, chocolat noir, crème liquide', '10 min', ['Préchauffer le four à 210°C (th 7).', 'Déposer la pâte feuilletée dans un moule, avec du papier sulfurisé, puis la piquer.', 'Peler, et couper les poires en très fines lamelles, et les éparpiller sur le fond de tarte.', 'Couper les bananes en fines rondelles, et les disposer sur les poires.', 'Enfourner à 210°C (th 7), pendant environ 30 à 40 min (les bananes doivent être bien cuites et dorées. ', 'Terminer la cuisson (environ 5 min), directement dans le bas du four, en baissant le four à 30°C (th 1), pour bien sécher la pâte.', 'Attention, il faut surveiller que la pâte ne brûle pas (c''est plus facile avec un moule en pirex, on peut regarder par en dessous).', 'Laisser tiédir la tarte.', 'Faire fondre le chocolat au micro-ondes, avec quelques gouttes de lait, puis y incorporer la crème. ', 'Etaler ce mélange sur la tarte. Laisser refroidir et déguster...'], ['Mixeur', 'Balance de cuisine', 'Batteur électrique', 'Rouleau à pâtisserie'], ['et chocolat ultra-simple', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'très facile', 'bon marché', 'bananes', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'dessert', 'plat de résistance', 'pâte feuilletée', 'chocolat noir', 'Tarte poires', 'tarte poire chocolat', 'cocktail'], 'Dessert', 4707932c-7674-4b36-992a-008626eaf69c, '2025-09-26T15:58:58.075096', [{'ingredient_id': 'c8e8c37a-242c-4362-be4e-526184dfc9aa', 'quantite': '1'}, {'ingredient_id': '69b15e52-0029-4c01-b494-7a87e2a9da85', 'quantite': '3'}, {'ingredient_id': 'ec293d4a-642e-44f7-8a10-c51e66807f96', 'quantite': '3'}, {'ingredient_id': '0bd706d3-cb9a-458c-8d12-b4ceedf8b5be', 'quantite': '100 g'}, {'ingredient_id': '1cdc8e8c-4220-4b3a-9ae0-10e10be9ee0d', 'quantite': '10 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (169143, 'Le bougna (Malaisie - Nouvelle Calédonie)', 'poulet entier, patate douce, patate douce, manioc, banane, igname, tomate, lait de coco, céleri, oignon, sel, poivre, persil', '30 min', ['Eplucher les patates,maniocs,les ignames et les bananes.', 'Couper les en rondelles de 4 à 5cm sauf les bananes.', 'Couper les bananes en trois morceaux.', 'Mettez les dans une grande marmite.', 'Mettre le poulet dans la marmitte.', 'couper les celeris en rondelles ainsi que les tomates,et les oignons.', 'les rajouter dans la marmitte.', 'Ensuite les baigner avec le lait de coco.', '(si pas assez de lait de coco,vous pouvez rajouter un peu d''eau ou du lait)', 'Salé et poivré,mettre le persil coupé!', 'laissez mijoter pendant 1h30 a feu moyen.', 'Surveillez de temps en temps que les légumes sont cuits comme pour des patates.', 'Sortez la marmitte du feu et laissez un peu refroidir.', 'Et maintenant servez vous!'], ['Mixeur', 'Planche à découper'], ['', 'lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'patate douce', 'facile', 'igname', 'bon marché', 'tomate', 'plat', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'manioc', 'Le bougna (Malaisie - Nouvelle Calédonie)', 'dessert', 'persil', 'plat de résistance', 'poulet entier', 'poivre', 'cocktail', 'céleri'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:59:01.720309', [{'ingredient_id': 'def5a8fd-14a5-4505-b554-ae893824a2eb', 'quantite': '1'}, {'ingredient_id': '0e9d9cb0-8306-4a16-8e0d-a66ddcc84a45', 'quantite': '2'}, {'ingredient_id': '524eb8ed-5664-49a3-9436-d1ccd32e75cb', 'quantite': '2'}, {'ingredient_id': '3bb3f499-8c63-4a5c-8343-6e9c62950c9c', 'quantite': '4'}, {'ingredient_id': 'ca047504-a03b-480b-9fc7-de5a83036b76', 'quantite': '4'}, {'ingredient_id': '89ea9ff4-518a-45df-8232-e7e26df4041e', 'quantite': '4'}, {'ingredient_id': '24d34f0a-c265-4cc3-abb3-5f86717b8950', 'quantite': '4'}, {'ingredient_id': 'a5abe7a7-ad21-42d3-bbb8-9f60dcc53dfb', 'quantite': '4'}, {'ingredient_id': '7acdfbb5-c9aa-4815-a446-5ee42133c901', 'quantite': '2'}, {'ingredient_id': 'd8b4e48d-c63a-4524-8c66-796d633e3eef', 'quantite': '2'}, {'ingredient_id': '8621bc80-f370-40cb-b50e-c39a463db343', 'quantite': ''}, {'ingredient_id': 'd471d325-ea87-4561-ab19-0e55a1b240a5', 'quantite': ''}, {'ingredient_id': '511dc0e7-9dc9-400d-9fbc-41fe5c8bf080', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (46230, 'Glace minute bananes - framboises', 'banane, framboises, sucre vanillé', '5 min', ['Couper les bananes en rondelles, les mettre dans un sachet congélation, rajouter les framboises et le sucre vanillé.', 'Fermer le sachet de congélation et laisser prendre au congélateur le temps nécessaire.', 'Une fois tout les fruits congelés, les mettre dans un mixer.', 'Laisser tourner un moment, jusqu''à l''obtention d''un oncteuse crème glacé...', 'Vous pouvez dégustez!!!'], ['Batteur électrique', 'Mixeur', 'Presse-agrumes', 'Louche', 'Ouvre-boîte'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'Glace minute bananes - framboises', 'testées', 'très facile', 'framboises', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'glace à l''italienne', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:59:05.300318', [{'ingredient_id': 'bd6d8911-2162-46ea-83cd-87dde636cb14', 'quantite': '4'}, {'ingredient_id': 'ade96a66-1027-4ba1-bec7-fdce907a1d6d', 'quantite': '1'}, {'ingredient_id': '2692bfd2-cff5-45c3-b98d-1a2c37251c90', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (531395, 'Gruau aux bananes', 'lait, flocons d''avoine, banane, extrait de vanille, cannelle, sirop d''agave', '10 min', ['Faire cuire les flocons d''avoine avec le lait dans une casserole jusqu''à ce qu''ils soient fondants.', 'Couper la banane en rondelles et réserver.', 'En attendant que le porridge soit cuit, verser le sirop d''agave, l''extrait de vanille et la cannelle dans une poêle, et laisser cuire à feu doux jusqu''à ce que le mélange devienne "mousseux"', 'Ajouter la moitié de la banane coupée dans le mélange sirop d''agave, vanille, cannelle : et faire cuire quelques minutes pour bien les caramélisées ', 'Lorsque les bananes sont prêtes, les retirer du feu et en verser la moitié dans le porridge. Ensuite, mélanger et verser dans un bol.', 'Ajouter le reste des bananes caramélisées sur le dessus de votre porridge et agrémenter avec les toppings de votre choix. Pour ma part j''ai rajouté quelques amandes et des pépites de chocolat noir'], ['Batteur électrique', 'Pince de cuisine', 'Planche à découper', 'Casserole', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'Porridge', 'confiserie', 'testées', 'extrait de vanille', 'très facile', 'bon marché', 'rapide', 'sirop d''agave', 'plat', 'recette', 'cuisine', 'Gruau aux bananes', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cannelle', 'lait', 'flocons d''avoine', 'cocktail'], 'Dessert', 7f5b0da7-772a-45c8-819e-8786e818d937, '2025-09-26T15:59:09.787351', [{'ingredient_id': '97eefb21-83a8-4180-909c-fb1785ce2fa7', 'quantite': '200 ml'}, {'ingredient_id': '32a38906-18a7-495e-93e8-13fc3ef36df9', 'quantite': '50 g'}, {'ingredient_id': '8ae1bec8-dfe0-4a4e-8742-df13ab26e891', 'quantite': '1'}, {'ingredient_id': '9109a795-b178-4bc3-bb90-3461cdc4cdc3', 'quantite': '1 cuillères'}, {'ingredient_id': '7015fc91-5810-40bc-9af0-b852f6994045', 'quantite': ''}, {'ingredient_id': 'fa42d429-2a22-4364-81e1-c01529e76f7b', 'quantite': '3 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (230819, 'Verrine banane nutella et oréos', 'Oréo, banane, Nutella, cannelle', '10 min', ['Émiettez les Oréos et disposez-en la moitié au fond d''un verre ou d''une verrine. ', 'Coupez la banane en rondelles et ajoutez-les à la verrine. ', 'Puis, prenez une bonne cuillerée de Nutella, et parsemez-en les rondelles de bananes. ', 'Enfin, versez le reste d''Oréos en miettes et saupoudrez de cannelle.', 'A déguster tel-quel ou chaud.', 'BON APPÉTIT !!!'], ['Passoire', 'Râpe', 'Louche', 'Ouvre-boîte'], ['', 'Oréo', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Verrine banane nutella et oréos', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Nutella', 'dessert', 'plat de résistance', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:59:14.184603', [{'ingredient_id': '42ab5638-3fa3-4521-b5a8-e7ccaa261b4c', 'quantite': '2'}, {'ingredient_id': '37369f43-0593-4345-95b4-7271269633a7', 'quantite': '1'}, {'ingredient_id': 'f9ceca1c-e78b-45bf-9a0a-bad851293c64', 'quantite': '1 cuillères'}, {'ingredient_id': 'a4a1d14d-1b9b-4760-a2c6-58a38598c5f0', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (19908, 'Sangria des Iles', 'vin rouge, fruits, rhum, fruits, banane, vanille', '10 min', ['Mélanger tous les ingrédients, ne pas oublier la cannelle (en écorce ou en poudre sinon). ', 'Au moment de servir, rajouter 2 ou 3 poignées de glaçon dans le bol à Sangria directement. ', 'On peut aussi rajouter soit de la limonade ou de l''eau pétillante en même temps que les glaçons (vérifier le sucrage si c''est de l''eau pétillante. ', 'Voilà, bon apéritif !!!'], ['Planche à découper', 'Pince de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'Sangria des Iles', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'sangria', 'boisson', 'vanille', 'vin rouge', 'dessert', 'plat de résistance', 'fruits', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:59:18.848171', [{'ingredient_id': '3a49d55d-bd1f-4080-a0ee-14976f1257e0', 'quantite': '3 l'}, {'ingredient_id': '24cad8c6-c7c0-4bba-ac82-c23b5775ad67', 'quantite': '2 l'}, {'ingredient_id': 'e5e87bd0-226c-4efc-8c05-d0a5154c3b6b', 'quantite': ''}, {'ingredient_id': 'dd1aa495-e707-43c9-b825-4dec65c5f1c8', 'quantite': ''}, {'ingredient_id': 'ce1a866c-88b7-4a39-80d5-1dcea7167935', 'quantite': '2'}, {'ingredient_id': 'cf370e5d-253a-456d-b838-fd6203eb572a', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (222925, 'Tarte exotique à la confiture de lait', 'pâte brisée, confiture de lait, noix de pécan, kiwi, banane, ananas, cookie, citron', '25 min', ['Étaler la pâte dans un moule à tarte.', 'Faire ramollir la confiture de lait au bain-marie si elle est trop épaisse.', 'Peler les kiwis et les bananes et les couper en rondelles. Couper les anneaux d''ananas en petite tranche (arrondies à la forme de boomerang).', 'Citronner les fruits.', 'Hacher grossièrement les noix de pécan avec les cookies.', 'Étaler la confiture de lait sur la pâte et bien répartir. ', 'Recouvrir des tranches de fruits en les alternant puis parsemer du mélange cookie/noix de pécan.', 'Enfourner la tarte au four, à 210°C (thermostat 7) pendant environ 25 min (surveiller la cuisson: la pâte et les fruits doivent être dorés et la croute croustillante).', 'Laisser refroidir sur la grille du four puis déguster !'], ['Casserole', 'Économe', 'Planche à découper', 'Pince de cuisine', 'Passoire'], ['entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'noix de pécan', 'facile', 'bon marché', 'cookie', 'plat', 'recette', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'confiture de lait', 'dessert', 'plat de résistance', 'citron', 'ananas', 'cocktail', 'Tarte exotique à la confiture de lait'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:59:22.440199', [{'ingredient_id': '9d73409a-2525-42c1-ac4d-610279abb345', 'quantite': '1'}, {'ingredient_id': '7e2f084b-2ea9-49e1-aa9e-b487aee4b04c', 'quantite': '6 cuillères'}, {'ingredient_id': 'dd2c7c98-aa40-46cf-af9e-432e34f29ade', 'quantite': '80 g'}, {'ingredient_id': '7301b395-aae4-4b07-a287-415af4f4397f', 'quantite': '4'}, {'ingredient_id': '46fb68d1-60e9-4408-ae7f-55cd48363505', 'quantite': '2'}, {'ingredient_id': '9bd05c61-9a45-45b9-8311-dafc730d00ce', 'quantite': '200 g'}, {'ingredient_id': '374db169-73ae-4490-8fb0-3088a5fd8537', 'quantite': '100 g'}, {'ingredient_id': '72e53a75-8e6f-4448-b73d-02e3e16f020f', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (28649, 'confiture bananes fraises (micro-ondes)', 'fraises, banane, fructose, orange', '30 min', ['Laver et équeuter les fraises. Les couper en quatre. ', 'Eplucher et couper les bananes en rondelles. ', 'Presser l''orange et le citron. ', 'Mettre dans un grand plat profond pour micro-ondes les fruits et le jus. ', 'Faire cuire 5 mn sur FORT sans couvrir. ', 'Remuer, ajouter le fructose. ', 'Couvrir et mettre à cuire 3 fois 5 mn sur MOYEN en remuer à chaque fois. ', 'Bien surveiller pour ne pas que ça déborde. ', 'Mettre tout de suite en pots stérilisés.'], ['Râpe', 'Verre doseur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'confiture de fraise', 'testées', 'très facile', 'bon marché', 'plat', 'fraises', 'recette', 'confiture bananes fraises (micro-ondes)', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'orange', 'fructose', 'cocktail'], 'Confiserie', 82562d51-9755-4096-89d4-79bb34c76a52, '2025-09-26T15:59:25.989361', [{'ingredient_id': '8dde75c6-3c6b-4d3b-af3e-1ad974442710', 'quantite': '200 g'}, {'ingredient_id': '830a0ea1-b282-4ac2-80f4-2260c04d421f', 'quantite': '300 g'}, {'ingredient_id': 'a534adc7-55dd-46ee-8ae3-dfe1cc5e56c7', 'quantite': '120 g'}, {'ingredient_id': '08a16afd-8950-4163-a233-6c4671a733a0', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (174836, 'Petits chaussons banane-chocolat', 'farine, beurre tendre, eau, miel, crème fraîche, sel, banane, beurre tendre, sucre en poudre, amandes, cacao, jaune d''oeuf, sucre en grain', '20 min', ['La pâte :', 'Dans un saladier, je mélange la farine, le beurre et le sel en émiettant la préparation jusqu''à obtenir une pâte friable.', 'Je fais chauffer l''eau avec le miel pour le diluer.', 'Je verse délicatement cette préparation sur le mélange farine/beurre/sel.', 'J''ajoute la crème épaisse et travailler le tout avec une fourchette jusqu''à obtenir une boule.', 'La garniture :', 'J''incorpore les bananes épluchées et coupées en petits morceaux au mélange beurre ramolli, sucre, amandes et cacao en poudre.', 'Je préchauffe mon four à 200°C (thermostat 6).', 'Je divise ma boule de pâte en 8, je l''étale en carré, je dépose délicatement une cuillère à café de garniture au centre de chaque carré et je les plies en triangle. ', 'J''écrase les bords avec une fourchette de façon à les souder. Je laisse lever 15 min. Je badigeonne avec le mélange jaune d''oeuf et eau, je saupoudre de sucre en grains et je fais cuire 10 min à 200°.', 'Bon appétit !'], ['Économe', 'Rouleau à pâtisserie', 'Batteur électrique', 'Planche à découper'], ['', 'entrée', 'recettes de cuisine', 'crème fraîche', 'sel', 'confiserie', 'eau', 'Petits chaussons banane-chocolat', 'beurre tendre', 'testées', 'rapide', 'plat', 'moyenne', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'moyen', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:59:29.623569', [{'ingredient_id': 'bf609770-aa9f-42ea-9b1f-1178a6934240', 'quantite': '300 g'}, {'ingredient_id': '42900db5-4b45-46f0-ae42-f48363fe8cc5', 'quantite': '200 g'}, {'ingredient_id': 'f915c8e2-3ecc-46c6-abd6-abc57c10572c', 'quantite': '50 ml'}, {'ingredient_id': '303422bd-8896-4f01-8400-dbcbce8eeb4f', 'quantite': '1 cuillères'}, {'ingredient_id': '688841ad-03bd-4c37-a21a-81a9d04bf37a', 'quantite': '1 cuillères'}, {'ingredient_id': '9cbbb802-f5b3-4ac6-98b9-7fb7324bffea', 'quantite': '1'}, {'ingredient_id': '07ee7f69-8543-4554-9af0-360188ebe2e5', 'quantite': '2'}, {'ingredient_id': '15d60f9e-dd25-4814-9724-2ebeb811423f', 'quantite': '25 g'}, {'ingredient_id': '30d7a424-0e55-4519-81fc-f115f19deaed', 'quantite': '4 cuillères'}, {'ingredient_id': 'd4e6c376-65fe-4eb4-8d9d-be2aea29929b', 'quantite': '40 g'}, {'ingredient_id': 'bb198051-4adc-4ce3-92b4-52b91d2665da', 'quantite': '4 cuillères'}, {'ingredient_id': '5fbb9cc8-ca4b-4a0b-a9c2-566d7c104254', 'quantite': '1'}, {'ingredient_id': 'f10c7f43-2ea0-4f98-a9aa-a1c98a4ab18c', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (341878, 'Cookies crousti moelleux chocolat/banane sans matière grasse', 'farine, sucre, sucre vanillé, avoine, cacao, banane, riz soufflé, oeuf, cannelle, sel', '15 min', ['Écraser les bananes dans un saladier ', 'Dans un autre saladier, mélanger la farine, le son d''avoine, le sucre, la cannelle, le cacao en poudre et la pincée de sel.', 'Mélanger les bananes écrasées et l’oeuf énergiquement puis incorporer doucement le mélange de l''autre saladier à celui-ci. ', 'Une fois la pâte bien homogène, ajouter délicatement les céréales soufflées.', 'Sur une plaque de cuisson recouverte d''un papier cuisson, former des petits tas aplatis avec une cuillère. ', 'Enfourner 17 minutes à 180°C (thermostat 6). Lorsque les cookies ont une couleur caramel, c''est prêt !'], ['Balance de cuisine', 'Louche', 'Verre doseur', 'Couteau de chef'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'riz soufflé', 'très facile', 'bon marché', 'cacao', 'Cookies crousti moelleux chocolat/banane sans matière grasse', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'avoine', 'dessert', 'plat de résistance', 'sucre vanillé', 'gâteau au chocolat', 'cannelle', 'sucre', 'cocktail'], 'Dessert', f6782b98-4ed5-487f-9e27-4a11055d9ca8, '2025-09-26T15:59:33.254801', [{'ingredient_id': 'cdcb59cf-33f8-4296-8db1-f36727e9ff76', 'quantite': '200 g'}, {'ingredient_id': '29c8ff49-c876-4342-9061-9fd7ea43e4da', 'quantite': '100 g'}, {'ingredient_id': '28f03945-7264-4cca-a962-9eb82fb06f7f', 'quantite': '2'}, {'ingredient_id': 'e6b39a20-cb8d-4d1d-b377-984e7e6ac001', 'quantite': '2 cuillères'}, {'ingredient_id': 'f179ecf5-da1b-44a9-9c7f-978f183ddf8f', 'quantite': '1 cuillères'}, {'ingredient_id': 'ed0e2533-b0b7-4f2d-a7b5-a775f31ad7d9', 'quantite': '2'}, {'ingredient_id': 'c95d5641-6fe2-49c1-bf4f-978e78bfc769', 'quantite': '1'}, {'ingredient_id': '55f1f52d-3627-46db-976e-7e27632080ac', 'quantite': '1'}, {'ingredient_id': 'bd241f6c-6c02-4b69-b8bf-ae02beeda48e', 'quantite': '1'}, {'ingredient_id': '0a36256a-d597-41b1-a2f9-aeb1e2908e5e', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (166733, 'Boeuf DG  (Cameroun)', 'boeuf, banane plantain, poivron, carotte, poireau, poivre blanc, curry, cube Maggi, sel, huile, ail, échalote, pèpè, djansan, gingembre, persil, huile de tournesol', '20 min', ['- Préparer la marinade : éplucher l’échalote, les gousses d’ail et le gingembre. Laver le persil. Enlever la coque des graines de pépé. Mettre tous les ingrédients de la marinade dans un mixer en ajoutant 1 cuiller à soupe d’huile. Réserver la marinade. ', '- Faire frire les bananes : éplucher les bananes, couper des rondelles en biais assez épaisses et faire frire pendant environ 10 min soit dans une friteuse, soit dans un faitout avec suffisemment d’huile.', '-Préparer la viande : couper la viande de boeuf en morceaux, la laver dans de l’eau vinaigrée. La saisir dans une cocotte avec un peu d’huile pendant environ 10 min. ', '- Pendant ce temps, préparer les légumes : éplucher la carotte, laver le poivron et le poireau et détailler le tout en petits morceaux. Mettre un fond d’eau dans une cocotte ainsi que la marinade et y plonger les légumes pendant 5 min. Bien remuer. Ajouter les morceaux de viande et les bananes, le curry, les cubes émiétés, les graines de poivre pilées et du sel (selon votre goût). Laisser mijoter le tout à couvert sur feu doux pendant environ 20 min. Il faut que la viande soit bien cuite et tendre.'], ['Balance de cuisine', 'Économe'], ['entrée', 'recettes de cuisine', 'boeuf', 'sel', 'confiserie', 'testées', 'carotte', 'cube Maggi', 'facile', 'plats africains', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'Boeuf DG  (Cameroun)', 'poivron', 'poireau', 'dessert', 'plat de résistance', 'banane plantain', 'moyen', 'poivre blanc', 'curry', 'cocktail'], 'Plat principal', a204acb7-358e-480f-9dd5-d042cc39590f, '2025-09-26T15:59:37.008739', [{'ingredient_id': '6d286c29-8ab6-434c-b0eb-ab246dfbfc73', 'quantite': '800 g'}, {'ingredient_id': 'b2e12c5e-962e-412a-9dd7-652d8cdb343b', 'quantite': '8'}, {'ingredient_id': '77e27aa0-a8d0-4c34-bc3f-2f26264b9b34', 'quantite': '1'}, {'ingredient_id': '6432f842-f23f-45cb-8a70-cddff2ff44b3', 'quantite': '1'}, {'ingredient_id': '67b2f4f0-7cfb-42cf-95e3-86d82df95bd4', 'quantite': '1'}, {'ingredient_id': 'de7171f7-f49f-41a7-9645-40fd87ccd165', 'quantite': ''}, {'ingredient_id': 'fca7b6f7-c98c-4557-958a-a6cb56692528', 'quantite': '1 cuillères'}, {'ingredient_id': 'c57fc34f-f371-4adb-a31e-a9f44ea40a91', 'quantite': '2'}, {'ingredient_id': '530c03de-c6f2-45fa-b4de-ceab2d270599', 'quantite': ''}, {'ingredient_id': '8a48e8aa-ea9f-49fc-90a8-5e75e325cf9a', 'quantite': ''}, {'ingredient_id': 'a33a6033-5aba-4787-aa9f-d557d08891d5', 'quantite': '4'}, {'ingredient_id': '9a7e9b6a-98ee-45a7-a3ce-8af80505a40f', 'quantite': '1'}, {'ingredient_id': 'a42e171c-36e8-46d3-970e-3b808dd6871d', 'quantite': '4'}, {'ingredient_id': '316b1f65-1255-4066-bf48-a2cbd1b400d1', 'quantite': '4'}, {'ingredient_id': '6b39c16c-a935-4ba1-9cd3-dbef4ef90821', 'quantite': '1'}, {'ingredient_id': '798f60bf-3069-4c7f-8c62-81e8926aaee9', 'quantite': '1'}, {'ingredient_id': 'a442281e-a53c-479d-9eb5-1bfc4f795b11', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (95509, 'Moelleux bananes et noisettes sans gluten ni lactose', 'banane, oeuf, cassonade, sel, poudre de noisette, bicarbonate, fécule de pomme de terre', '15 min', ['- préchauffer le four à 180 ° (TH6)', '- éplucher puis écraser les bananes dans un saladier', '- ajouter le sucre, le sel et le poivre, bien mélanger', '-  ajouter un à un les oeufs en battant le mélange vigouresement (la pâte prend un aspect crémeux)', '- incorporer la poudre de noisettes, le bicarbonate et la fécule de pomme de terre', '- bien mélanger', '- verser dans un moule à manqué recouvert de papier sulfurisé', '- mettre au four pendant 20 minutes environ', 'bon appétit!'], ['Poêle', 'Planche à découper'], ['', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'cassonade', 'très facile', 'oeuf', 'plat', 'poudre de noisette', 'recette', 'cuisine', 'recettes', 'boisson', 'Moelleux bananes et noisettes sans gluten ni lactose', 'dessert', 'fécule de pomme de terre', 'plat de résistance', 'moyen', 'cocktail', 'bicarbonate'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:59:40.540770', [{'ingredient_id': '3748d831-fca6-4bd9-a9ff-7ef589ee1db0', 'quantite': '3'}, {'ingredient_id': '8d4d3641-73ba-4311-8b90-b6046078f363', 'quantite': '3'}, {'ingredient_id': '1bca6801-adee-46a1-82a4-8a0fcad95308', 'quantite': '100 g'}, {'ingredient_id': '2e2f91ef-4795-459d-bcce-26350ffc6cc9', 'quantite': '1'}, {'ingredient_id': '860d9b04-8bbb-4833-91e6-df8597ee2bf2', 'quantite': '125 g'}, {'ingredient_id': '553d9ab3-84ba-46fb-b397-bf15e58ec5df', 'quantite': ''}, {'ingredient_id': 'e9addb07-9d1f-48d3-8293-1f111c92a783', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (346964, 'Tarte choco bananes Saint-Valentin', 'pâte sablée, banane, oeuf, beurre, chocolat, sucre', '30 min', ['Préchauffer le four à 180°C (thermostat 6). ', 'Faire fondre le chocolat au bain-marie avec le beurre. ', 'Séparer les blancs des jaunes. ', 'Battre les blancs en neige. ', 'Travaille les jaunes avec 2 cuillères à soupe de sucre. Ajouter le chocolat fondu et bien mélanger. ', 'Incorporer délicatement les blancs en neige. ', 'Dérouler la pâte sablée dans un moule à tarte. ', 'Déposer des rondelles de bananes sur le fond de la tarte et parsemer du sucre restant. ', 'Verser la préparation au chocolat sur la tarte de sorte à recouvrir les rondelles de bananes. ', 'Dérouler la seconde pâte feuilletée et y découper, à l''aide d''un emporte-pièces, plusieurs coeurs. ', 'Déposer les coeurs sur le centre de la tarte, en les faisant se chevaucher. ', 'Enfourner 30 minutes.'], ['Moule à tarte', 'Batteur électrique', 'Économe', 'Râpe', 'Tire-bouchon'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'très facile', 'bon marché', 'pâte sablée', 'oeuf', 'plat', 'tarte à la banane', 'recette', 'cuisine', 'recettes', 'boisson', 'Tarte choco bananes Saint-Valentin', 'dessert', 'plat de résistance', 'beurre', 'sucre', 'cocktail'], 'Dessert', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T15:59:44.145587', [{'ingredient_id': 'de762d3a-9be3-4d53-b746-491e81fa5e58', 'quantite': '2'}, {'ingredient_id': '1ca9cbee-8855-4fcb-b6a4-918d8ee0a052', 'quantite': '4'}, {'ingredient_id': 'bb86d92d-1092-4555-a731-b8d47cf1c3d4', 'quantite': '2'}, {'ingredient_id': '26230ba8-1046-444e-8e61-15cda7116cdc', 'quantite': '10 g'}, {'ingredient_id': 'de520b90-a692-49bd-a53a-d7250a2fea48', 'quantite': '200 g'}, {'ingredient_id': '8892de6c-0814-47e8-945d-883b9b260c14', 'quantite': '3 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (36648, 'Cuire des bananes au four', 'banane', '1 min', ['Faire préchauffer le four à 180°C (thermostat 6).', 'Poser les bananes non épluchées dans un plat et mettre au four environ 15 min.', 'La peau doit devenir complètement noire.'], ['Rouleau à pâtisserie', 'Moule à tarte', 'Verre doseur', 'Planche à découper', 'Batteur électrique'], ['', 'bon marché', 'boisson', 'recettes', 'banane', 'entrée', 'recettes de cuisine', 'plat', 'dessert', 'confiserie', 'Cuire des bananes au four', 'recette', 'testées', 'plat de résistance', 'cocktail', 'cuisine', 'très facile'], 'Dessert', 1b98be0d-50fb-4921-8d0b-6d3eb764e4c3, '2025-09-26T15:59:47.744166', [{'ingredient_id': '2f1d76bd-b8f8-4cad-9204-3f525aaaffc0', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (28873, 'Fleur de banane fondante (4ème rencontre Marmiton)', 'banane, citron, chocolat noir, beurre, oeuf, sel, sucre, sucre vanillé, amandes, farine, eau de fleur d''oranger, rhum', '30 min', ['Préchauffer le four électrique à chaleur tournante, à 180°C et prévoir un moule à tarte (30 cm). ', 'Couper les bananes en deux, dans le sens de la longueur et les asperger de jus de citron. Beurrer le moule légèrement. Installer les bananes au fond du moule, sur la face plate. Former 5 pétales de fleur en utilisant deux moitiés de banane pour chaque pétale. Tailler les extrémités des fruits de manière à ce que les moitiés s''assemblent. Veiller à ce que les pétales de fleur soient à 2 cm environ du bord. Avec une lame tranchante, reformer l''arrondi de chaque pétale. ', 'Si les bananes sont petites, mixer la sixième avec un peu de jus de citron. Si les bananes sont grandes, mixer les morceaux, en surplus, découpés pour former la fleur (l''équivalent d''une moitié de banane), de la même façon. ', 'Séparer les blancs de jaunes et battre les blancs en neige ferme avec la pincée de sel. ', 'Faire fondre le chocolat et le beurre au bain-marie ou sur la plaque électrique à chaleur douce. ', 'Par ailleurs, mélanger les jaunes d''oeufs, la banane mixée, la poudre d''amandes, le sucre en poudre, le demi-sachet de sucre vanillé, la farine, l''eau de fleur d''oranger, le rhum. Ajouter chocolat et beurre fondus. Ajouter délicatement les blancs en neige. ', 'Verser le tout sur les bananes, puis entre les bananes et le bord, puis remplir les espaces vides. Lisser avec précaution, sans bouger les bananes, pour répartir la préparation. ', 'Mettre au four, sur la grille placée au milieu, à 180°C pendant 20 mn. Normalement, à ce stade, la pointe de la lame de couteau, plantée dans la préparation au chocolat, ressort sèche. Les bananes doivent rester couleur ivoire, au-delà, elles seront couleur vanille et seront moins présentables. Arrêter le four et sortir le moule. Laisser refroidir. ', 'Juste avant de servir, passer la lame du couteau entre le gâteau et le bord du moule, puis soulever délicatement tout le tour du gâteau avec une spatule en plastique. Poser le plat à tarte sur le moule puis retourner le tout en même temps. Faire alors un léger mouvement pour secouer. Les bananes vont se décoller du moule et reprendre leur place dans le gâteau. ', 'Prenez le temps d''admirer... et déguster.'], ['Balance de cuisine', 'Économe', 'Râpe', 'Spatule'], ['', 'amandes', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'chocolat noir', 'sucre vanillé', 'beurre', 'citron', 'Fleur de banane fondante (4ème rencontre Marmiton)', 'eau de fleur d''oranger', 'sucre', 'cocktail'], 'Dessert', 0e86ede7-ddac-49f3-b8e5-c8b8b1d7c1fe, '2025-09-26T15:59:51.431809', [{'ingredient_id': '24695fec-e469-4448-9c9b-2749808b401c', 'quantite': '6'}, {'ingredient_id': 'c528c6fd-7c2e-4da2-b73b-c6d33f4e2608', 'quantite': '1'}, {'ingredient_id': '5fd4e4f4-e96a-42d6-a024-9608d593b3d7', 'quantite': '150 g'}, {'ingredient_id': 'e85aab1d-c50f-4f32-8d1e-41f5d84e4377', 'quantite': '50 g'}, {'ingredient_id': '8680f04e-881e-46b1-a8e1-485004e18ea2', 'quantite': '3'}, {'ingredient_id': 'c69febfd-ca81-4498-9c2c-b31a987dc1c7', 'quantite': '1'}, {'ingredient_id': 'ce352335-c207-4fce-8b9d-15d5f58bcbf9', 'quantite': '70 g'}, {'ingredient_id': 'adfcb2da-a745-4f9c-af19-cb00c5290cf8', 'quantite': ''}, {'ingredient_id': '54820e37-6e55-4ab3-a1f7-298f356f6e09', 'quantite': '30 g'}, {'ingredient_id': 'c07e96a2-937e-4963-9bc9-986f9ba7b800', 'quantite': '60 g'}, {'ingredient_id': '3975f475-87fb-4fd4-ba2b-944383dc979b', 'quantite': '1 cuillères'}, {'ingredient_id': '013ac688-4e7d-4db9-8690-85f970ad226e', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (372884, 'Cookies à la banane - Sans gluten, sans sucre et sans beurre', 'banane, farine de châtaigne, farine de riz, amandes en poudre, bicarbonate, flocons d''avoine, sel, café, oeuf, café, chocolat, huile de coco', '80 min', ['Réduire en purée les bananes en les écrasant avec une fourchette. ', 'Ajouter les oeufs, et bien battre jusqu''à l''obtention d''une crème.', 'Ajouter 1 cuillère à café d''extrait de vanille. Puis le beurre de coco. ', 'Bien mélanger.', 'Tamiser les farines, la poudre d''amande, la levure et une pincée de sel. ', 'Ajouter au mélange précédent.', 'Incorporer les pépites de chocolat au mélange.', 'Placer de petits morceaux de pâtes sur une plaque de cuisson couverte de papier sulfurisé. ', 'Cuire au four à 180 °C pendant 12 minutes (les cookies sont cuits lorsqu''ils sont dorés). ', 'Savourer les tout chauds ou conserver les dans une boite pour quelques jours.'], ['Moule à tarte', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'sans sucre et sans beurre', 'recettes de cuisine', 'sel', 'farine de riz', 'confiserie', 'testées', 'chocolat', 'facile', 'amandes en poudre', 'cookie', 'rapide', 'oeuf', 'plat', 'recette', 'café', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'farine de châtaigne', 'Cookies à la banane - Sans gluten', 'moyen', 'huile de coco', 'flocons d''avoine', 'cocktail', 'bicarbonate'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T15:59:56.530600', [{'ingredient_id': 'a5b7de18-b36f-4c6b-a349-502315ff7668', 'quantite': '2'}, {'ingredient_id': 'e9e6cb80-a9e6-4998-a626-9d8118ca1d4c', 'quantite': '100 g'}, {'ingredient_id': '2f7c417e-3513-46e6-8e2d-bca0bae1f090', 'quantite': '120 g'}, {'ingredient_id': 'ff695783-e0cd-4028-b2d8-b2b9e944eb6b', 'quantite': '20 g'}, {'ingredient_id': '1892acfb-62c4-4a28-b979-1321dd608df6', 'quantite': '8 g'}, {'ingredient_id': 'e7cbe10a-7a5d-4002-bfe1-7a3b314af01c', 'quantite': '100 g'}, {'ingredient_id': '0ef5ee94-dc9d-4247-855d-c9f4bec1a576', 'quantite': '1'}, {'ingredient_id': '6809ce00-73ae-400b-b8db-6b5253a862df', 'quantite': '1 cuillères'}, {'ingredient_id': '6e159b2b-5abc-4ad6-bd9c-eff0289f271f', 'quantite': '2'}, {'ingredient_id': '984c4ce6-e37c-4fec-9902-43e40ed4cfc2', 'quantite': '1 cuillères'}, {'ingredient_id': 'f30d7acb-bdfc-4a62-baf1-9035354c94ed', 'quantite': '150 g'}, {'ingredient_id': '644b8566-db92-4f8a-ad52-ea7354d92b98', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (32749, 'Gratin de bananes jaunes (bananes plantain)', 'banane plantain, oignon, ail, pieds, lait, farine, beurre, fromage râpé', '40 min', ['Couper les bananes en deux dans le sens de la largeur et les faire bouillir dans de l''eau salée pendant 5 mn (les bananes doivent être fermes mais tendres). ', 'Faire revenir l''oignon haché fin et l''ail écrasé dans le beurre jusqu''à la couleur blonde, saler et poivrer. Rajouter la farine en pluie et mélanger aussitôt. ', 'Hors du feu, ajouter le lait petit à petit. Porter à ébullition sans cesser de remuer. La sauce va s''épaissir. Rajouter la moitié du fromage râpé en fin de cuisson. Beurrer un plat à four, étaler une couche de sauce, disposer une couche de bananes préalablement coupées en rondelles et remplir ainsi le plat en terminant par la sauce. ', 'Saupoudrer avec le reste de fromage, faire dorer au four.'], ['Râpe', 'Louche', 'Verre doseur'], ['', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'Gratin de bananes jaunes (bananes plantain)', 'très facile', 'bon marché', 'ail', 'plat', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'dessert', 'plat de résistance', 'banane plantain', 'cocktail', 'pieds'], 'Accompagnement', 9f9b17fc-ddff-4b56-8976-3a8fb2420a01, '2025-09-26T16:00:01.389074', [{'ingredient_id': '140cde31-055f-49c3-92ee-db311e0f57d0', 'quantite': '7'}, {'ingredient_id': '28950d4a-d4c2-4561-9696-486af281465e', 'quantite': '1'}, {'ingredient_id': 'af8b0806-3421-41e4-8a64-9d14ce901166', 'quantite': '2'}, {'ingredient_id': 'ab84b1f5-9fec-4749-91be-10c81bc897ee', 'quantite': ''}, {'ingredient_id': '946edb9c-8aca-4f6d-8f40-471c2733e1aa', 'quantite': ''}, {'ingredient_id': 'be846353-9f79-4545-8204-5fb7ef796329', 'quantite': '3 cuillères'}, {'ingredient_id': 'f83aa721-74ee-4779-b1cf-4301103243ce', 'quantite': '50 g'}, {'ingredient_id': '09e8aa94-af49-4e17-a2a8-06ff33762179', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (84439, 'Muffins pomme, banane, chocolat...', 'sucre, oeuf, levure, farine, beurre demi-sel, rhum, pomme, banane, chocolat, cannelle', '20 min', ['Battre les œufs et le sucre ensemble.', 'Une fois le mélange bien homogène, rajouter le beurre fondu.', 'Intégrer la levure tamisée et la farine. ', 'Bien mélanger jusqu''à obtention d''une pâte lisse.', 'Verser 2 bouchons de Rhum pour l''arôme.', 'Séparer la pâte en 3 doses égales.', 'Couper la pomme en tout petits morceaux. Les intégrer au premier tiers de pâte avec une bonne dose de cannelle (en fonction du goût de chacun).', 'Couper la banane en tout petits morceaux.', 'Prendre 1/3 de la tablette de chocolat et, à l''aide d''un couteau, en faire des pépites. Intégrer le tout au deuxième tiers de pâte.', 'Prendre 1/3 de la tablette de chocolat et la faire fondre avec un peu de beurre. Mélanger le chocolat fondu au reste de pâte. Faire des pépites avec la dernière part de la tablette et les intégrer au troisième tiers de pâte.', 'Il ne reste plus qu''à enfourner à four chaud dans des moules à muffins.', 'Comme pour tout gâteau, vérifier en cours de cuisson avec la pointe d''un couteau pour avoir la consistance que vous désirez.'], ['Fouet', 'Couteau de chef'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'chocolat', 'très facile', 'bon marché', 'oeuf', 'plat', 'chocolat...', 'recette', 'cuisine', 'levure', 'recettes', 'Muffins pomme', 'beurre demi-sel', 'boisson', 'farine', 'dessert', 'plat de résistance', 'pomme', 'muffin', 'cannelle', 'sucre', 'cocktail'], 'Dessert', 9eff8299-6be8-42c1-8b41-9cd9e541ee53, '2025-09-26T16:00:05.686610', [{'ingredient_id': 'e76bd091-3b2b-4e9e-821b-1fde8e026041', 'quantite': '200 g'}, {'ingredient_id': '30662a1d-d954-4846-ac4f-bb261177ec4c', 'quantite': '3'}, {'ingredient_id': 'ca713874-2103-410b-827f-fec3f5b080f3', 'quantite': '1'}, {'ingredient_id': '85d0d392-cc6d-48a6-b768-eae472b62766', 'quantite': '450 g'}, {'ingredient_id': '76f9b290-0ff7-43a4-83ae-48f54b41b0e2', 'quantite': '210 g'}, {'ingredient_id': '9db7c9be-6f66-4a8e-85ff-2729c5fa86b5', 'quantite': ''}, {'ingredient_id': 'bb74c083-9e5e-4c40-b106-fe8d1582e5c1', 'quantite': '1'}, {'ingredient_id': '7c949208-6e73-49aa-9165-91d3473ab998', 'quantite': '1'}, {'ingredient_id': 'e0ba0b75-e98d-4d05-a72d-2a95f024d68a', 'quantite': '1'}, {'ingredient_id': 'acdd154c-3515-46e4-8a30-619e154bb097', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (195019, 'Beignets bananes raisins', 'banane, raisins secs, sucre en poudre, farine, eau, huile, levure chimique', '15 min', ['Éplucher les bananes et les écraser à la fourchette.', 'Ajouter le sucre puis les raisins. Verser dessus la farine mélangée à la levure et l''incorporer à la purée de bananes.', 'Verser dessus l''eau petit à petit en remuant constamment.', 'La pâte doit être bien lisse, sans être trop épaisse ni trop liquide.', 'Faire chauffer l''huile dans une poêle et verser la valeur d''une cuillère à soupe de pâte pour former un beignet. ', 'Former autant de beignets que votre poêle vous le permet mais attention à ne pas trop les serrer.', 'Faire cuire des deux côtés jusqu''à l''obtention d''une belle couleur brune. ', 'Attention toutefois à ce que la cuisson ne soit pas trop rapide au risque d''avoir l''intérieur du beignet encore un peu cru.', 'Bon appétit !'], ['Planche à découper', 'Tire-bouchon'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'levure chimique', 'bon marché', 'plat', 'moyenne', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'beignets sucrés', 'farine', 'Beignets bananes raisins', 'dessert', 'plat de résistance', 'raisins secs', 'cocktail'], 'Dessert', 9cfb1177-7f22-4f30-870d-8e0750d0c5e2, '2025-09-26T16:00:10.195412', [{'ingredient_id': 'bed8ec9c-24ad-4d07-9552-42de3846b549', 'quantite': '8'}, {'ingredient_id': '59393069-e461-4fde-904f-2439aa90d9e7', 'quantite': '100 g'}, {'ingredient_id': 'f787a5ca-e80e-40f2-83db-5593f11f2f03', 'quantite': '250 g'}, {'ingredient_id': '0192eb49-2828-42af-916f-9e353261bf19', 'quantite': '250 g'}, {'ingredient_id': '09d3c6fb-1e41-49a7-8c50-04a18d60d151', 'quantite': '75 cl'}, {'ingredient_id': '71c69370-240e-4480-af10-fe73c5c1ece4', 'quantite': '4 cuillères'}, {'ingredient_id': 'd5287cb3-9e66-4559-99ef-f040925014bb', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (254001, 'Tarte chocolat banane ultra simple', 'pâte feuilletée, chocolat, banane, lait, sucre vanillé, beurre, oeuf, sucre', '15 min', ['Préchauffer le four à 200°C (thermostat 6-7).', 'Mettre la pâte feuilletée dans un moule à tarte. ', 'Faire fondre le chocolat dans un bol au micro-ondes avec 5 cl de lait puis mettre cette préparation sur la pâte.', 'Faire revenir les 4 bananes dans une poêle avec 10 g de beurre et y ajouter les 2 sachets de sucre vanillé.', 'Ajouter les bananes sur le chocolat, battre les œufs  avec 10 cl de lait et les 40 g de sucre. Puis le verser sur les bananes.', 'Enfourner à four chaud pendant 20 minutes à 200°C (thermostat 6-7) puis déguster.'], ['Batteur électrique', 'Pince de cuisine', 'Économe'], ['entrée', 'tarte au chocolat', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pâte feuilletée', 'sucre vanillé', 'beurre', 'lait', 'sucre', 'Tarte chocolat banane ultra simple', 'cocktail'], 'Dessert', f474c9c9-ddbb-4f27-a356-6adbc32479f4, '2025-09-26T16:00:13.760086', [{'ingredient_id': '5473f3a7-517c-4935-9b2a-0c071508cc14', 'quantite': '1'}, {'ingredient_id': '9f24c9b9-107a-48b0-a1b7-cc0e8ed390e1', 'quantite': '100 g'}, {'ingredient_id': '85106834-fb2b-46ce-92c3-64efc15ef7cc', 'quantite': '4'}, {'ingredient_id': 'd3157734-b524-4a63-94f6-2c8ba64ada42', 'quantite': '15 cl'}, {'ingredient_id': '21d85f0d-ea41-4681-a68b-d0f87ba237e1', 'quantite': '2'}, {'ingredient_id': 'f4ca9f82-1ea9-4a3e-b8a3-744f3400568e', 'quantite': '10 g'}, {'ingredient_id': '1ba1882d-caa4-4b13-9f50-1ae1102063b6', 'quantite': '2'}, {'ingredient_id': '2be2b85a-6184-492c-9f42-68652b5e69d2', 'quantite': '40 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (168090, 'Verrine banane-chocolat version diplomate', 'biscuit sablé, banane, crème liquide, chocolat pâtissier, crème chantilly, amandes', '20 min', ['Broyez les biscuits et déposez-les au fond des verrines (1 biscuit par verrine). Moi j''utilise des biscuits de la marque "Sprits".', 'Coupez la banane en rondelles fines et répartissez-la dans les verrines.', 'Dans une petite casserole, faites chauffer la crème. Lorsqu''elle commence à bouillir, sortez-la du feu et faites-y fondre le chocolat. Moi j''utilise du chocolat corsé.', 'Si vous manquez de temps vous pouvez aussi faire chauffer la crème au micro-ondes avec le chocolat, c''est plus rapide mais il y a un peu moins de gout.', 'Lorsque le chocolat est fondu, recouvrez de crème la banane dans les verrines.', 'Placez vos verrines dans le réfrigérateur pendant 2h.', 'Au moment de servir, recouvrez le chocolat de crème chantilly (j''utilise de la chantilly toute prete en bombe) et parsemez d''amandes concassées.'], ['Batteur électrique', 'Fouet'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'biscuit sablé', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'chocolat pâtissier', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'Verrine banane-chocolat version diplomate', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', 48da0070-e547-469e-9c7a-6cab1c0009a0, '2025-09-26T16:00:17.357325', [{'ingredient_id': '42058d63-7508-4d13-ae26-59f3159f0f08', 'quantite': '4'}, {'ingredient_id': '13835f09-707b-4b8e-81da-a1b422c723e1', 'quantite': '1'}, {'ingredient_id': 'a75ce2b7-9aa6-4790-a5ea-c219d15878e0', 'quantite': '20 cl'}, {'ingredient_id': '74873b52-7127-4633-bb39-15857d9190d3', 'quantite': '50 g'}, {'ingredient_id': 'bcb8607c-1432-4323-81bb-4ac9df5e12a5', 'quantite': ''}, {'ingredient_id': 'd7772e6a-fbef-4d79-a4ad-7e4d1e7fbfe8', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (39397, 'Glace à la banane pour les bébés', 'petit suisse, banane, citron', '10 min', ['Eplucher la banane, la couper en rondelles, et presser le jus de citron dessus.', 'Passer le tout, 2 min au micro-ondes.', 'Mixer avec les petits suisses, jusqu''à ce que soit bien lisse.', 'Placer 1 h 30 au congélateur (pas plus, sinon c''est trop dur)'], ['Balance de cuisine', 'Moule à tarte', 'Casserole', 'Couteau de chef', 'Économe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'petit suisse', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'citron', 'Glace à la banane pour les bébés', 'glace à l''italienne', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:00:21.991620', [{'ingredient_id': '3669922c-df0b-4adf-9934-c61e525060b4', 'quantite': '2'}, {'ingredient_id': '89e9a1ef-c390-4ef1-8f16-a8dbb915b759', 'quantite': '1'}, {'ingredient_id': 'a3f32521-7369-40b8-99d1-3bdd755e726b', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (29924, 'Soupe aux tomates et aux bananes', 'eau, tomates pelées, banane, curry, cube de bouillon, farine, beurre, crème fraîche, poivre, sel', '5 min', ['Faire fondre le beurre dans une casserole at ajouter la farine en pluie. Mélanger au fouet. Laisser blondir et ajouter le litre d''eau au fouet pour éviter les grumeaux. ', 'Ajouter le cube de bouillon, les tomates pelées, les bananes coupées en rondelles et le curry. Saler et poivrer.', 'Laisser bouillir 15 à 20 minutes et passer au mixer.', 'Ajouter la crème fraîche au moment de servir.'], ['Couteau de chef', 'Pince de cuisine', 'Presse-agrumes'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'sel', 'confiserie', 'eau', 'Soupe aux tomates et aux bananes', 'tomates pelées', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'cube de bouillon', 'cuisine', 'recettes', 'boisson', 'farine', 'soupe', 'dessert', 'plat de résistance', 'beurre', 'poivre', 'curry', 'cocktail'], 'Entrée', ecb35691-b2c2-4e6f-b2b0-057e2d500fba, '2025-09-26T16:00:26.660898', [{'ingredient_id': 'c05c049e-49dc-4a83-bbe6-fd770cbae77f', 'quantite': '1 l'}, {'ingredient_id': '17fe0fe3-f7be-48fc-8809-244c60114d9c', 'quantite': '1'}, {'ingredient_id': '4c6967fe-5438-43ee-ade3-dc41776235da', 'quantite': '2'}, {'ingredient_id': '815a9230-bf46-419f-9ef0-abc16201ac77', 'quantite': '1'}, {'ingredient_id': '1e7b8d27-9af1-4dd4-80da-97bf73ee3b1d', 'quantite': '1'}, {'ingredient_id': '1106488a-80a9-46e6-8269-b309c5c8dff6', 'quantite': '30 g'}, {'ingredient_id': 'cf3b68cd-bdc9-4ec2-8e17-a7765d65fee2', 'quantite': '50 g'}, {'ingredient_id': '80d91de4-ee25-4056-a6d5-cf598be9bc98', 'quantite': '20 cl'}, {'ingredient_id': '7ad9b7f2-3756-44d9-9958-1a0c76a6d401', 'quantite': ''}, {'ingredient_id': '7dc05f97-46d5-4b64-9b16-9821d65a0906', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (17267, 'Salade argentine', 'salade, thon, avocat, banane, moutarde, huile, vinaigre, poivre, sel', '5 min', ['Disposer dans des assiettes individuelles les feuilles de salade.', 'Ajouter par assiette 1/2 boîte de thon en miettes, le 1/2 avocat en morceaux et la 1/2 banane en rondelles.', 'Préparer une vinaigrette et verser sur la salade.', 'Attention à remuer délicatement pour éviter un effet "bouillie" (banane et avocat!).'], ['Couteau de chef', 'Pince de cuisine', 'Casserole'], ['entrée', 'banane', 'salade', 'recettes de cuisine', 'Salade argentine', 'sel', 'confiserie', 'testées', 'avocat', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'salade avocat', 'cuisine', 'recettes', 'boisson', 'huile', 'dessert', 'plat de résistance', 'moutarde', 'poivre', 'thon', 'vinaigre', 'cocktail'], 'Entrée', 42e6a449-e4da-4cdb-b4e0-9d2cc040ab8a, '2025-09-26T16:00:31.120392', [{'ingredient_id': 'd96bd2b3-fa2c-4d39-8bcc-9a02aa3f89ca', 'quantite': '1'}, {'ingredient_id': '570c068a-0dbd-47a6-8e14-f946b43b5ce3', 'quantite': '93 g'}, {'ingredient_id': '6b33364e-b3e8-4348-a9e7-a350241b8f72', 'quantite': '1'}, {'ingredient_id': 'a4778ba9-fe93-417a-a691-b1958ef27b19', 'quantite': '1'}, {'ingredient_id': 'a44a30fb-3586-43f5-8b98-0e4b5b4b339f', 'quantite': ''}, {'ingredient_id': '3242e6ff-09f7-4135-a7db-8090e7f14d35', 'quantite': ''}, {'ingredient_id': '17067b62-bd0a-4134-a824-831cbde47e44', 'quantite': ''}, {'ingredient_id': '674ac844-9172-4b71-b9b2-405633005646', 'quantite': ''}, {'ingredient_id': 'c0a2dda1-39dd-4d77-836d-5c25210b31f4', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (528431, 'Mousse au chocolat banane sans œuf', 'banane, eau, chocolat noir', '30 min', ['Écraser la banane dans un saladier pouvant aller au bain marie.', 'Ajouter le chocolat et faire fondre le tout au bain marie en mélangeant.', 'Battre au batteur électrique le jus de pois chiche dans un autre saladier (attention c''est beaucoup plus long que des blancs d’œufs) .', 'Une fois bien ferme, incorporer délicatement et progressivement le jus de pois chiche monté au premier mélange.', 'Mettre le mélange dans les ramequins et laisser au frais minimum 4 heures.'], ['Poêle', 'Économe', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'facile', 'bon marché', 'mousse au chocolat', 'Mousse au chocolat banane sans œuf', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat noir', 'cocktail'], 'Dessert', 8c1c9b82-0514-4da8-b0a2-839f02da5a89, '2025-09-26T16:00:35.818870', [{'ingredient_id': '36cfc3f2-b951-4386-993a-752fa9442811', 'quantite': '1'}, {'ingredient_id': '084a5b67-bdd8-4e8d-9fff-73a1fa4f1a76', 'quantite': '135'}, {'ingredient_id': 'b885416e-c4e1-4a08-b077-7b817922113c', 'quantite': '135 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (73192, 'Smoothie à la banane', 'banane, lait', '10 min', ['Ustensiles:', '- 1 mixer (ou une fourchette, mais c''est moins bien)', '- 1 saladier', '- 1 verre', '- 1 cuillère', 'Mixez (ou écrasez) la banane dans un saladier avec un mixeur (ou une fourchette) jusqu''à ce qu''il ne reste plus de morceaux.', 'Versez ensuite le mélange dans votre verre et ajoutez du lait jusqu''à remplir votre verre.', 'Mélangez enfin avec la cuillère.', 'ID+:', 'Ajoutez de la poudre de noix de coco à la surface et un peu de miel.', 'Mettez une paille pour la déco.'], ['Couteau de chef', 'Tire-bouchon', 'Casserole', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'Smoothie à la banane', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'lait', 'smoothies', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:00:39.319470', [{'ingredient_id': 'f5490484-a1c7-43f5-800a-13236d5d01ad', 'quantite': '1'}, {'ingredient_id': 'ebedaf50-e9ee-4b58-a555-482289f22a4c', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (31575, 'Milk-shake banane et chocolat', 'lait, yaourt, sucre vanillé, banane, chocolat en poudre', '2 min', ['Mettre le lait, le yaourt, le sucre, le chocolat et la banane coupée dans le mixer. ', 'Mixer et servir.'], ['Mixeur', 'Casserole'], ['entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Milk-shake banane et chocolat', 'dessert', 'plat de résistance', 'sucre vanillé', 'chocolat chaud', 'lait', 'chocolat en poudre', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:00:43.939586', [{'ingredient_id': '8ec06017-731d-4777-bae3-683082677640', 'quantite': '350 ml'}, {'ingredient_id': 'cce6c6ac-c28e-4e80-a32b-ac9f1eb621fe', 'quantite': '1'}, {'ingredient_id': 'e28c387b-6058-49b5-8a68-8028cc1753a2', 'quantite': '1'}, {'ingredient_id': '1c22d0dd-aede-4cdd-84e8-2424a77c123f', 'quantite': '1'}, {'ingredient_id': '52f68dfe-e1db-4a95-aea5-613e9e0e1382', 'quantite': '3 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (44348, 'Tourte d''hiver aux 4 fruits', 'farine, beurre, eau, sel, sucre, banane, abricot, pruneau, ananas, rhum, oeuf, sucre, lait entier, sucre vanillé', '45 min', ['Prévoir un moule à biscuit à fond amovible, de 28 cm.', 'Faire tremper les abricots 6 h pour les regonfler.', 'Faire tremper les pruneaux 1 h.', 'L’idéal est de tremper les fruits la veille.', 'Préparer la pâte brisée (mélanger la farine et le beurre, le sel, le sucre et amalgamer petit à petit avec l''eau tiède), la laisser reposer 30 min.', 'Pendant ce temps préparer les fruits : faire cuire les abricots 30 min, faire cuire les pruneaux 15 min.', 'Tout ceci peut se faire la veille.', 'Dénoyauter les pruneaux et les faire macérer dans le rhum.', 'Garnir le moule à manqué de la pâte brisée, puis mettre un bourrelet de papier alu pour empêcher la pâte de retomber des bords. ', 'Mettre au four préchauffé à 230°C (thermostat 7-8), 10 à 15 min pour sécher la pâte.', 'Sortir du four.', 'Sur le fond de tarte mettre les abricots ouverts en deux puis une couche de rondelles de bananes, puis une couche de pruneaux ouverts en deux, puis les morceaux d’ananas. ', 'Ou dans le sens où vous voudrez.', 'Préparer la crème : battre les œufs avec le sucre et le rhum  (on prend le rhum de la macération des pruneaux que l''on a égouttés) le lait chaud et la vanille.', 'Verser doucement dans la tourtière puis terminez  par  une couche de fruits alternés sans ouvrir les abricots et les pruneaux, déposer au centre des rondelles de bananes pour faire joli.', 'Enfournez à 240°C (thermostat 8) pendant 15 min, puis baisser à 180°C (thermostat 6) et laisser cuire 45 min environ.', 'Démouler froid ou servir dans le plat de cuisson s’il est en verre,', 'saupoudrer de sucre glace.'], ['Passoire', 'Balance de cuisine', 'Verre doseur', 'Économe'], ['', 'Tourte d''hiver aux 4 fruits', 'entrée', 'recettes de cuisine', 'sel', 'confiserie', 'eau', 'testées', 'plat', 'moyenne', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'moyen', 'beurre', 'sucre', 'cocktail'], 'Dessert', 282965b8-0800-430f-85d8-73ed737a9e9b, '2025-09-26T16:00:47.584181', [{'ingredient_id': '8b2db829-b03b-4eaa-a947-cbb08062df45', 'quantite': '250 g'}, {'ingredient_id': '58299112-4278-4e85-a4ce-ddbbea62489c', 'quantite': '125 g'}, {'ingredient_id': 'b87424de-3690-4aab-8f3f-5115bb899c9e', 'quantite': '1'}, {'ingredient_id': '23ab4697-4190-4e7b-b401-be2cd386a827', 'quantite': '1'}, {'ingredient_id': '9dba33a3-211a-4e01-a672-e257c4f3bda8', 'quantite': '1 cuillères'}, {'ingredient_id': '2d3bcef1-dbdd-4cf0-b9fd-3cf67e8fb83a', 'quantite': '3'}, {'ingredient_id': '8ea6768e-9fc9-469c-bc9a-66f1c6b4dc2e', 'quantite': '250 g'}, {'ingredient_id': '6179cf20-a8ba-428d-bbe8-57ac2b7454f1', 'quantite': '500 g'}, {'ingredient_id': 'c8b54e4d-85a3-421f-ad0b-7fb52c047f70', 'quantite': '1'}, {'ingredient_id': '5ba04a40-0a6b-4e0b-bf37-36e16b9096e1', 'quantite': '1'}, {'ingredient_id': '61ca5428-a82c-4a40-a5d5-40c17dc7f6e5', 'quantite': '2'}, {'ingredient_id': 'cc6fc55d-0b57-40c8-b417-4789ef87ba99', 'quantite': '125 g'}, {'ingredient_id': 'af47b67b-eca0-4190-bd8b-bc65201701a9', 'quantite': '25 cl'}, {'ingredient_id': '2e9a5af1-c626-463d-8b72-495e7d11282b', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (90533, 'Moelleux banane citron', 'oeuf, farine, sucre, beurre, levure, citron, banane', '10 min', ['Préchauffez votre four à 180°C (thermostat 6).', 'Mélangez les œufs et le sucre en les battant énergiquement. Incorporez le beurre fondu.', 'Ajoutez la farine, la levure, le zeste et le jus d''un citron.', 'Bien mélanger.', 'Écrasez la banane et ajoutez-la à la préparation.', 'Beurrez un moule à manqué, versez la préparation.', 'Enfournez 30 minutes à 180°C (thermostat 6).'], ['Pince de cuisine', 'Verre doseur', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'Moelleux banane citron', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'gâteau à la banane', 'citron', 'beurre', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:00:51.356344', [{'ingredient_id': '13d7b66a-18a3-4f2b-9078-f30197569b69', 'quantite': '4'}, {'ingredient_id': '9261f57d-f4d2-4f42-96fd-201ee88d93d1', 'quantite': '100 g'}, {'ingredient_id': '8764e4ec-4587-4038-b615-9d3f0e92d78c', 'quantite': '75 g'}, {'ingredient_id': '8a733a6b-5a2c-4469-85d4-35026ddcb261', 'quantite': '40 g'}, {'ingredient_id': 'f2918f67-980c-401a-9ed5-f2a66b4163c6', 'quantite': ''}, {'ingredient_id': 'bece82d2-d3d7-471e-bfe3-5e1561123467', 'quantite': '1'}, {'ingredient_id': 'f2b3c161-f4bc-4e12-8400-38576aa591e4', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (37618, 'Fondant chocolat et bananes sans cuisson', 'chocolat noir, chocolat blanc, banane, citron, orange, beurre tendre, crème liquide, cacao, sucre en poudre, sucre glace, gélatine en feuilles, huile, jaune d''oeuf, miel, rhum', '60 min', ['Repos : 6 h', 'Faites fondre le chocolat noir au bain marie. Fouettez en chantilly la crème liquide très froide, en ajoutant 25 g de sucre glace à la fin.', 'Fouettez le beurre avec le cacao. Battez les jaunes d''oeufs avec 80 g de sucre en poudre. Ajoutez le chocolat fondu, le beurre au cacao et les 3/4 de la chantilly.', 'Versez dans un moule à cake tapissé de film alimentaire et placez au réfrigérateur.', 'Faites fondre au bain marie le chocolat blanc avec l''huile. Chauffer le miel et le rhum et faites y dissoudre la gélatine.', 'Mixez 3 bananes avec le jus d''un demi citron et 20 g de sucre glace. Incorporez au mélange chocolat/miel/gélatine. ', 'Laissez refroidir puis incorporez le reste de chantilly et versez le tout dans le moule.', 'Placez le moule 6 h au réfrigérateur. ', 'Démoulez-le délicatement en tirant le film alimentaire. C''est prêt!'], ['Planche à découper', 'Passoire'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'beurre tendre', 'cacao', 'Fondant chocolat et bananes sans cuisson', 'rapide', 'plat', 'moyenne', 'jaune d''oeuf', 'sucre en poudre', 'recette', 'cuisine', 'miel', 'recettes', 'gélatine en feuilles', 'boisson', 'huile', 'crème liquide', 'dessert', 'fondant au chocolat', 'plat de résistance', 'chocolat noir', 'moyen', 'citron', 'orange', 'chocolat blanc', 'sucre glace', 'cocktail'], 'Dessert', 76d9105a-accb-424b-becd-d6ac24ee18a1, '2025-09-26T16:00:56.143512', [{'ingredient_id': '50318dce-7467-4d53-8735-d33d91f08d3f', 'quantite': '125 g'}, {'ingredient_id': 'b6f18e7d-8006-47ff-bb62-d3738ffec8d8', 'quantite': '50 g'}, {'ingredient_id': 'b643dd44-9a9b-4925-b215-8a4335a408b5', 'quantite': '3'}, {'ingredient_id': '0bf2ddcb-4651-4f63-98fc-6c366a01ec1a', 'quantite': '1'}, {'ingredient_id': 'a357c35c-5640-41e1-80c6-c3ad214cc467', 'quantite': '1'}, {'ingredient_id': '9a160ce7-b2af-4f76-9d36-a6bf4e15f991', 'quantite': '100 g'}, {'ingredient_id': 'baa824f4-de29-430d-a8f6-ae612dc973e1', 'quantite': '25 cl'}, {'ingredient_id': 'a796d71f-f762-484a-86de-c494ff45b783', 'quantite': '50 g'}, {'ingredient_id': '22683a50-f2a6-4078-be7a-ded204e8f291', 'quantite': '120 g'}, {'ingredient_id': 'bf245aa4-204d-468a-9963-3beb6af3a788', 'quantite': '45 g'}, {'ingredient_id': 'eefa4f92-2482-4c9f-bd27-4efd3c0eea76', 'quantite': '5 g'}, {'ingredient_id': '8a1c9e07-f099-4174-a750-1c469c09a758', 'quantite': ''}, {'ingredient_id': '0a8e8a1d-a4f8-4660-9aca-bd8ce4903d9e', 'quantite': '3'}, {'ingredient_id': '0204c1dc-3580-4d25-b049-104835761cf0', 'quantite': '1 cuillères'}, {'ingredient_id': '62208713-f97e-4480-8f53-7c15d72b6d8e', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (11015, 'Tarte à la banane et au rhum', 'pâte brisée, crème fraîche liquide, oeuf, banane, rhum, sucre roux', '15 min', ['Etalez la pâte dans un moule à tarte, piquez avec une fourchette et réservez au frais.', 'Mélangez la crème fraîche liquide aux oeufs battus. Ajoutez à ce mélange 3 bananes écrasées.', 'Coupez les 2 autres bananes en rondelles et disposez les sur la pâte puis versez le mélange crème-oeufs-bananes, éventuellement corsé avec un petit peu de rhum.', 'Saupoudrez de sucre roux.', 'Mettre au four (préchauffé) à 200°C pendant 25 à 30 minutes : la tarte doit être bien dorée (caramélisée) et la crème doit avoir pris.', 'Servir tiède ou froid. Bon appétit !'], ['Râpe', 'Batteur électrique', 'Verre doseur', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'oeuf', 'plat', 'moyenne', 'tarte à la banane', 'recette', 'crème fraîche liquide', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'Tarte à la banane et au rhum', 'cocktail', 'sucre roux'], 'Dessert', eb7f69a0-23ad-41be-b988-51cc588b1e2a, '2025-09-26T16:00:59.747765', [{'ingredient_id': 'bd809c0b-ac0f-4b8e-b392-a7376437b21f', 'quantite': '1'}, {'ingredient_id': 'b2c14cfe-40f8-43cd-b64d-fa36735a3172', 'quantite': '25 cl'}, {'ingredient_id': '49441230-ccf4-4730-9592-12948d96487c', 'quantite': '2'}, {'ingredient_id': 'b7ac8bca-80fd-48a2-810f-5a50a154e2a3', 'quantite': '5'}, {'ingredient_id': 'a9e45ba5-c046-496f-8327-a5eea784e838', 'quantite': '2 cl'}, {'ingredient_id': 'e784927b-ade1-4560-b94a-0f7c64bb933f', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (32673, 'Pabellon criollo (Venezuela)', 'boeuf, oignon, poivron, poireau, tomates pelées, haricots noirs, banane plantain, riz, ail, câpres, bouillon de boeuf, poivre, sel, safran, cumin en poudre, herbes de Provence, laurier, huile, beurre', '2 min', ['PRÉPARATION DES LÉGUMES : ', 'Eplucher les gousses d''ail. Eplucher les oignons et les émincer finement. Couper les poivrons en petits morceaux. Détailler le poireau en petits morceaux. ', 'PRÉPARATION DE LA VIANDE : ', 'Couper la viande en morceaux. Mettre un peu d''eau (2 cm) au fond de la cocotte-minute, y déposer la viande, saler. Faire cuire pendant 1/2 heure environ. A la fin de la cuisson, sortir la viande et conserver le bouillon. ', 'Lorsque la viande est refroidie, séparer les fibres manuellement (c''est un travail assez long mais c''est essentiel pour la réussite du plat !). ', 'CUISSON DES HARICOTS : ', 'Dans le bouillon restant, faire cuire les haricots noirs avec un bouillon-cube dans la cocotte-minute pendant au moins 1/4 d''heure. Vérifier la cuisson : la prolonger si nécessaire. Garder le bouillon (il n''en reste pas beaucoup). ', 'CUISSON DU RIZ : ', 'Mettre un peu d''huile dans une poêle. Faire revenir quelques gousses d''ail, 1/3 des oignons, 1/3 des poivrons, 1/3 des poireaux. Ajouter le riz. Le faire rissoler quelques instants. Ajouter de l''eau (environ 5 ou 6 verres). Saler et rajouter un bouillon-cube. ', 'SAUCE POUR LA VIANDE :  ', 'Mettre un peu d''huile dans une cocotte. Ajouter un peu de safran puis 1/3 des oignons. Faire revenir quelques minutes. Ajouter ensuite 1/3 des poivrons, une ou deux gousses d''ail, 1/3 du poireau. Laisser cuire. Quand le mélange commence à être un peu cuit, ajouter les tomates. Faire cuire 5 mn environ. Ajouter la viande défibrée. Epicer, saler, poivrer. Rajouter quelques câpres et une tasse de bouillon de cuisson. Laisser cuire jusqu''à ce que l''eau soit évaporée. ', 'SAUCE POUR LES HARICOTS : ', 'Mettre un peu d''huile dans une poêle ainsi qu''un peu de safran. Faire revenir les légumes restants (oignons, poivrons, poireau, gousses d''ail). Quand le mélange est cuit, rajouter les épices et les haricots. Mélanger. Laisser cuire 5 mn environ jusqu''à ce que l''eau soit évaporée. ', 'CUISSON DES BANANES : ', 'Couper les bananes en deux dans le sens de la longueur et les frire à la poêle. ', 'PRÉSENTATION : ', 'Chaque convive disposera dans son assiette, un peu de viande, un peu de haricots, un peu de riz et une banane.'], ['Balance de cuisine', 'Râpe', 'Presse-agrumes', 'Verre doseur'], ['', 'laurier', 'entrée', 'cumin en poudre', 'recettes de cuisine', 'boeuf', 'sel', 'confiserie', 'testées', 'tomates pelées', 'ail', 'plat', 'moyenne', 'recette', 'cuisine', 'herbes de Provence', 'bouillon de boeuf', 'oignon', 'recettes', 'huile', 'boisson', 'poivron', 'poireau', 'dessert', 'haricots noirs', 'plat de résistance', 'riz', 'banane plantain', 'moyen', 'beurre', 'câpres', 'poivre', 'Pabellon criollo (Venezuela)', 'cocktail', 'safran'], 'Plat principal', ff329678-ced6-4d66-83cc-66ba7f1bfa09, '2025-09-26T16:01:03.496491', [{'ingredient_id': '3807a328-2e07-4255-b234-c1daf04cf1ce', 'quantite': '1 kg'}, {'ingredient_id': '64a6fa05-f52a-49fe-8ad1-1f9c49323584', 'quantite': '5'}, {'ingredient_id': '9655af76-74bb-469f-adeb-886c185674be', 'quantite': '2'}, {'ingredient_id': '67a1a15b-0962-4d83-80e5-20bde62d690a', 'quantite': '1'}, {'ingredient_id': '910b48ba-bf40-42e8-a246-dea4eda41f5a', 'quantite': '750 g'}, {'ingredient_id': 'bdf1a51a-a788-445d-959d-0d80dfb285d4', 'quantite': '500 g'}, {'ingredient_id': 'f0c16e5a-a1dd-4d2f-9353-a903916b23ba', 'quantite': '6'}, {'ingredient_id': 'cbd2cf31-2040-4d67-bb7a-86a46982a44a', 'quantite': '2'}, {'ingredient_id': 'e014da82-a8ed-4e85-9624-c3840fa91eda', 'quantite': '10'}, {'ingredient_id': '98f66704-7585-4a7f-901e-f9b8a397fc3b', 'quantite': ''}, {'ingredient_id': '281b7a6b-bd29-4176-91bb-eb6bf584debf', 'quantite': '2'}, {'ingredient_id': '67a4f3e2-d518-4e27-95c8-b003680eee3b', 'quantite': ''}, {'ingredient_id': '8979ee76-0251-4a31-8ff8-c8d3708ed212', 'quantite': ''}, {'ingredient_id': '14cfc36a-0c7f-441a-837b-8eee3ec4d4b5', 'quantite': ''}, {'ingredient_id': '0bfd9d58-f2f0-4236-8f4f-ed0f025a93da', 'quantite': ''}, {'ingredient_id': '835b5ac4-2769-4be1-8e7e-94f48013d5dd', 'quantite': ''}, {'ingredient_id': '1e81710a-d14d-4ca6-ba7f-f4edf960a757', 'quantite': ''}, {'ingredient_id': '0f33d770-7957-47e1-80db-90c97d15f9c6', 'quantite': ''}, {'ingredient_id': 'd31b5d1d-0f5c-4b68-acf5-7e1adf5a6034', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (31004, 'Confiture de kiwi et banane', 'kiwi, kiwi, banane, sucre', '20 min', ['Pelez les kiwis et les bananes et coupez- les en petits morceaux. mettez-les dans un grand récipiant en pyrex. Ajoutez le sucre en remuant bien. Laissez reposer une nuit. ', 'Mettre au micro-ondes sur puissance maximale pendant 6 mn. remuer. Remettre 6 mn sur puissance maximale. Ajoutez 1 cuillère à café de beurre. Bien remuer et mettre en pot.'], ['Batteur électrique', 'Verre doseur', 'Planche à découper', 'Râpe'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Confiture de kiwi et banane', 'dessert', 'plat de résistance', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:01:07.104106', [{'ingredient_id': 'a8e65988-d04a-4183-b182-84ceada3eee6', 'quantite': '2'}, {'ingredient_id': 'b570612c-b24c-418f-a983-e42c0e524731', 'quantite': '2'}, {'ingredient_id': '2c7bf07f-d41f-4501-a4c9-2a9af044ad21', 'quantite': '2'}, {'ingredient_id': 'fb340f5d-09f1-4dde-818d-f0f0ee5003ac', 'quantite': '475 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (531859, 'Cocktail Halloween', 'orange, pomme, citron, poire, fraises, banane', '10 min', ['Presse les 2 oranges, puis verse le jus dans le mixeur.', 'Coupe les 3 pommes en cubes puis mets-les dans le mixeur, pareil pour le citron, les fraises, les bananes et les poires.', 'Demande à un adulte de mixer tous les ingrédients, puis verse le mélange obtenu dans des verres.', 'Place le tout au frigo pendant 1h avant de déguster.'], ['Mixeur', 'Râpe', 'Planche à découper'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'facile', 'bon marché', 'boissons froides', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'citron', 'orange', 'Cocktail Halloween', 'cocktail'], 'Boisson', 5b367c7c-67ed-44f7-b5e9-bee1bc6abb0e, '2025-09-26T16:01:11.469183', [{'ingredient_id': '19bd3a9f-a811-4f64-b4fb-0fbae51217f7', 'quantite': '2'}, {'ingredient_id': '08cbd90a-3d11-4e9f-ba7f-39bd28d0cabc', 'quantite': '3'}, {'ingredient_id': '038f8cef-0afc-41d6-95a8-8fca8de641c2', 'quantite': '1'}, {'ingredient_id': '59831a91-022b-4d4a-a2c3-2f09e4e75833', 'quantite': '1'}, {'ingredient_id': 'bd1b5250-7db9-494c-aa16-cf5a0b548e3c', 'quantite': '5'}, {'ingredient_id': '21d353b6-ddd2-45dd-8434-7705549d3190', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (220003, 'Crème de yaourt pomme-banane pour bébé', 'banane, pomme, yaourt, crème fraîche', '15 min', ['Éplucher les bananes et la pomme, les couper en petits morceaux.', 'Cuire ces fruits à la vapeur (10-15 min). Laisser refroidir.', 'Mixer avec 2 grosses cuillères à soupe de yaourt et la cuillère de crème.', 'Servir bien frais.'], ['Planche à découper', 'Rouleau à pâtisserie', 'Moule à tarte', 'Verre doseur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'yaourt', 'confiserie', 'testées', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'Crème de yaourt pomme-banane pour bébé', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:01:15.936003', [{'ingredient_id': '0f7d6934-70da-4c80-be48-f5e0158fca0a', 'quantite': '2'}, {'ingredient_id': 'e8ecfe6c-aafd-41be-ad5a-bf2959c2a434', 'quantite': '1'}, {'ingredient_id': '4f3b1509-8825-465a-98fb-15e2836daa27', 'quantite': '1'}, {'ingredient_id': 'c51f8a54-8dff-413e-8306-09ef616e424c', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (64248, 'Banane gourmande au chocolat', 'banane, chocolat noir, noix de coco, sucre, crème fraîche', '2 min', ['Eplucher la banane, la couper dans la largeur et disposer les morceaux de chocolat noir au dessus.', 'Etaler la crème fraîche et soupoudrer de sucre et de noix de coco.', 'Cuire 2 min au four à micro-ondes à forte température, sinon faire revenir à la poêle.', 'Bon appétit !'], ['Râpe', 'Ouvre-boîte', 'Passoire', 'Presse-agrumes'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'Banane gourmande au chocolat', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat noir', 'noix de coco', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:01:19.530519', [{'ingredient_id': '65a4780a-1421-4860-8c82-a99b2892c79a', 'quantite': '1'}, {'ingredient_id': 'dd4f14bb-fecd-4a3d-9261-9f13fa6a2562', 'quantite': '30 g'}, {'ingredient_id': 'af20c8f4-bb2d-4dc1-a3c9-4b324895c005', 'quantite': '1'}, {'ingredient_id': 'c65892f2-0984-47c3-bbc6-845f46720a7e', 'quantite': '1'}, {'ingredient_id': '60fa2a9e-03a9-4d1f-a2e0-a31327f0397f', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (49170, 'Muffins Banane, Abricot et Chocolat', 'banane, abricot, sucre, oeuf, levure, farine, beurre, copeaux de chocolat, cannelle', '15 min', ['Préchauffez votre four à 190°C (thermostat 6/7).', 'Faites fondre le beurre dans une casserole, sur feu doux.', 'Pelez et coupez les bananes en petits morceaux.', 'Lavez, essuyez et coupez les abricots en petits dés.', 'Dans un saladier, mélangez les morceaux de banane et les dés d''abricot. Ajoutez le sucre et l''œuf légèrement battu, puis le beurre fondu.', 'Dans un second saladier, mélangez les ingrédients secs (farine, levure, copeaux de chocolat et cannelle).', 'Incorporez le mélange humide dans le mélange sec, délicatement, de façon à ne plus voir la farine (mélanger très peu).', 'Mettez la préparation dans 12 moules à muffins beurrées et faites cuire à four chaud pendant 25 min.', 'Démoulez et  dégustez.'], ['Presse-agrumes', 'Verre doseur', 'Moule à tarte'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'abricot', 'très facile', 'bon marché', 'oeuf', 'plat', 'Muffins Banane', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'muffin', 'beurre', 'copeaux de chocolat', 'cannelle', 'sucre', 'cocktail', 'Abricot et Chocolat'], 'Dessert', be48ffa6-246e-4c45-8f1e-b29fc2641231, '2025-09-26T16:01:24.332967', [{'ingredient_id': '58beec1a-647d-4a4a-9258-1dee70f42519', 'quantite': '2'}, {'ingredient_id': '14844817-77bf-44e6-bb66-8631ec661cd1', 'quantite': '2'}, {'ingredient_id': 'e979d7a3-ee34-462b-8325-dafd14cadf47', 'quantite': '75 g'}, {'ingredient_id': '1265f06d-b148-4823-a576-6127d321c7e3', 'quantite': '1'}, {'ingredient_id': 'b755ff6f-2ff2-491f-8a00-87af1b64ecea', 'quantite': '1'}, {'ingredient_id': '131d31eb-a198-4057-ad69-889a958abbf9', 'quantite': '150 g'}, {'ingredient_id': '260606af-b05a-4f3e-a618-c217d77c0a31', 'quantite': '75 g'}, {'ingredient_id': 'b186fb91-7e34-42a4-a7a6-ee961eb94617', 'quantite': '50 g'}, {'ingredient_id': 'c7617767-6467-4ff2-8bb3-0828573d223d', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (66263, 'Bananes grillées', 'banane, sucre, beurre', '2 min', ['Eplucher les bananes et les couper dans le sens de la longeur.', 'Faire fondre une noisette de beurre dans la poêle.', 'Y placer les bananes, saupoudrer légèrement avec le sucre.', 'Faire dorer chaque côté de la banane.', 'La quantité de sucre et la cuisson sont à modeler en fonction des goûts !!'], ['Louche', 'Presse-agrumes', 'Passoire'], ['Bananes grillées', '', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:01:28.033985', [{'ingredient_id': '221de7e0-9ebf-4758-b0d5-a8ef21d0c488', 'quantite': '2'}, {'ingredient_id': 'd0a5b58e-9321-46e5-bc8d-5bd80de6e433', 'quantite': '1 cuillères'}, {'ingredient_id': 'f4b7f891-b52e-41a9-b161-a305867d68d4', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (13022, 'Confiture de banane au chocolat amer', 'banane, sucre, chocolat noir, eau, citron', '30 min', ['Coupez les bananes en rondelles de 1 cm environ.', 'Dans un faitout, mélangez les rondelles, l''eau, le sucre et le jus de citron.', 'Faites chauffer jusqu''à frémissement. Ajouter le chocolat en copeaux jusqu''à ce qu''il soit fondu.', 'Couvrez et gardez au frais une nuit.', 'Le lendemain, portez à ébulition en remuant, mixez très finement, maintenez la cuisson à feu doux pendant cinq minutes en remuant, écumez soigneusement.', 'Redonnez un bouillon. Vérifiez la nappe.'], ['Râpe', 'Passoire'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'très facile', 'bon marché', 'Confiture de banane au chocolat amer', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat noir', 'citron', 'sucre', 'cocktail'], 'Confiserie', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:01:31.654857', [{'ingredient_id': 'aa950192-73fb-48e9-a816-5c85ffc696f6', 'quantite': '1 kg'}, {'ingredient_id': '5e18e611-7028-4d3e-8e62-a420eca8566b', 'quantite': '750 g'}, {'ingredient_id': '6f788b87-ef2e-49df-b86b-2f4595b85f3a', 'quantite': '250 g'}, {'ingredient_id': '45e0c3ed-b8df-40d1-8237-58df399c43d8', 'quantite': '3'}, {'ingredient_id': 'b3e72f43-43cb-474b-911e-9740512abb14', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (232280, 'Pommes au four sur pain d''épices', 'pomme, pain d''épices, banane, beurre, miel, lait, cannelle', '15 min', ['Beurrer légèrement les tranches de pain d''épices pour tapisser le fond du plat allant au four.', 'Humecter chaque tranche de pain d''épices avec 1 cuillère à soupe de lait (pas plus).', 'Préparer les pommes : les évider et inciser légèrement la peau des pommes par quartier puis en tournant au milieu de pommes (cela évite l''éclatement des pommes et permet de les déguster plus facilement). Poser les pommes sur le pain d''épices.', 'Couper la banane en tronçon de la hauteur des pommes, puis enfiler 1/3 de chaque tronçon de banane dans le centre des pommes.', 'Mettre un peu de miel, de sucre ou de confiture, au goût de chacun, dans le centre de la pomme.', 'Ajouter un peu de beurre (1/2 cuillère à café) sur chaque pomme, ajouter de la cannelle si on l''apprécie.', 'Cuire à four chaud (180°C) 30 min environ.'], ['Casserole', 'Presse-agrumes'], ['entrée', 'banane', 'recettes de cuisine', 'pain d''épices', 'confiserie', 'testées', 'facile', 'bon marché', 'pomme au four', 'plat', 'Pommes au four sur pain d''épices', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'beurre', 'cannelle', 'lait', 'cocktail'], 'Dessert', aa430041-f947-498b-b5dd-64e1c9f161c5, '2025-09-26T16:01:35.564112', [{'ingredient_id': 'bb083148-088c-47cb-bfbd-dee4f4f3a781', 'quantite': '4'}, {'ingredient_id': '35c003eb-ca69-4c78-8be9-ff403f81cb46', 'quantite': '4'}, {'ingredient_id': 'c9e43192-3bff-4492-a55c-c06fec80c422', 'quantite': '1'}, {'ingredient_id': '30d925bd-9dcc-4477-a46f-249d27403ad5', 'quantite': '20 g'}, {'ingredient_id': '37219aec-9c18-4d7e-be1e-cc55b44d1227', 'quantite': ''}, {'ingredient_id': 'f4f12ac4-b464-41ce-a487-d4d04b3ddc3a', 'quantite': '4 cuillères'}, {'ingredient_id': '99a5764f-1f6f-4e36-8783-70fa7f8e9100', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (225249, 'Gratin de bananes vertes de ma maman', 'banane, crème fraîche, lardons, oignon, ail, poivre, sel, fromage râpé, beurre', '25 min', ['Préchauffez votre four 180-200°C selon puissance.', 'Cuire les bananes à l''eau environ 15 minutes. Les retirer quant la fourchette s''enfonce sans difficulté.', 'Laisser refroidir puis les éplucher.', 'Les passer à la râpe à légumes.', 'Dans une marmite faire revenir les lardons ou la chair à saucisse, rajouter l''oignon, puis l''ail écraser et laisser rissoler quelques instants.', 'Ajouter les bananes et bien mélanger.', 'Incorporé la crème fraîche jusqu''à obtenir une bonne consistance (si trop épais ajouter encore de la crème ou du lait).', 'Vérifier l''assaisonnement.', 'Mettre la préparation dans un plat à gratin beurré.', 'Parsemer de fromage râpé et de quelques noisettes de beurre.', 'Passer à four chaud à 200°C jusqu’à ce que votre gratin soit bien doré. ', 'Régalez vous !'], ['Batteur électrique', 'Passoire', 'Planche à découper', 'Tire-bouchon', 'Moule à tarte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'sel', 'confiserie', 'testées', 'facile', 'lardons', 'bon marché', 'Gratin de bananes vertes de ma maman', 'ail', 'plat', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'poivre', 'cocktail', 'fromage râpé'], 'Plat principal', af3f589d-3ba5-43c4-b23e-9b178f63d54f, '2025-09-26T16:01:39.296547', [{'ingredient_id': 'f911e3ee-2ba2-49ba-b7e8-29ff414e9422', 'quantite': '12'}, {'ingredient_id': 'c462926c-a519-4c46-b71b-45c5ebaa6365', 'quantite': '50 cl'}, {'ingredient_id': 'c60aca4a-e6d8-401b-bb6c-d35f8a89d1a5', 'quantite': '100 g'}, {'ingredient_id': 'b53bc3f4-d270-4463-a006-ec781becbf04', 'quantite': '1'}, {'ingredient_id': '611564a2-bcf7-448b-8d05-6b61870b6017', 'quantite': '5'}, {'ingredient_id': '42c0402c-9072-49b8-8379-65efaabcb8ce', 'quantite': ''}, {'ingredient_id': 'b64f174d-2670-4d72-8578-ecd001908ac3', 'quantite': ''}, {'ingredient_id': 'cf8ab03f-6deb-4363-b255-051052b3709a', 'quantite': '50 g'}, {'ingredient_id': 'be4da65b-a601-43fd-b7ce-c4c85c178027', 'quantite': '25 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (65181, 'Trio de fruits (grenade, banane et pomme) au fromage blanc', 'grenade, banane, pomme, citron vert, fromage blanc, cassonade', '30 min', ['Couper la grenade en quatre et l''égrainer dans un bol (15 min).', 'Peler la pomme, la banane et les couper en dés.', 'Zester le citron vert dans une coupelle.', 'Dans un verre (style verre à sangria), incorporer jusqu''à la moitié du fromage blanc. Disposer les morceaux de pomme et de banane sur le fromage blanc.', 'Saupoudrer de graines de grenade jusqu''à vider le bol.', 'Saupoudrer à convenance de cassonnade, presser le citron vert sur la cassonnade et décorer avec le zeste.'], ['Ouvre-boîte', 'Économe', 'Casserole'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'cassonade', 'très facile', 'bon marché', 'Trio de fruits (grenade', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'fromage blanc', 'banane et pomme) au fromage blanc', 'dessert', 'plat de résistance', 'pomme', 'citron vert', 'cocktail', 'grenade'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:01:42.945053', [{'ingredient_id': '4d27f516-4c11-4ba9-8604-8bd66c19830c', 'quantite': '1'}, {'ingredient_id': 'f6487cee-31eb-4e62-9ba0-59d311ea43af', 'quantite': '1'}, {'ingredient_id': 'df977eb2-2e07-44e2-903e-6f9a0c6d245b', 'quantite': '1'}, {'ingredient_id': 'fd0dea1d-5314-491f-8152-cd449424a608', 'quantite': '1'}, {'ingredient_id': '3aa44331-7218-4d5b-bad1-579261fbdd98', 'quantite': '350 g'}, {'ingredient_id': 'a20471c9-4951-4282-b1db-24d2a02eb790', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (329340, 'Crumble pomme, banane, poire, chocolat et fantaisie', 'farine, sucre, amandes, poudre de noisette, beurre, cannelle, pomme, pomme, poire, banane, cannelle, muscade, girofle, sucre, citron, chocolat, beurre', '60 min', ['Pour la pâte, mélanger les ingrédients de façon à obtenir un mélange granuleux homogène (pas de grumeaux).', 'Garniture :', 'Le citron sert à conserver les fruits coupés en attendant qu’ils soient tous prêts à être dorés. Il donne également une pointe d’arôme agréable.', 'Peler et couper séparément en tranches :', '- les pommes pink lady (couper la pomme en 16 par exemple)', '- les pommes canada (idem que ci-dessus)', '- la poire (couper en 8 par exemple)', 'et détailler la banane en rondelles.', 'Afin de savoir s’il y en a assez pour votre plat, disposer les fruits sur ce dernier et compléter si c''es  insuffisant.', 'Note : les pommes (chanteclair, bletrane, canada) réduiront légèrement de taille (si pas trop cuites).', 'Dans une coupelle mélanger les cannelle, noix de muscade et clou de girofle  ou autre combinaison de proportions en fonction de votre goût.', 'Pour l''utilisation des épices, choisir entre ces 3 possibilités :', '1/ Saupoudrer les fruits du mélange d’épices avant de les recouvrir de pâte', '2/ Saupoudrer les fruits du mélange d’épices lors de leur passage en poêle', '3/ Recouvrir les fruits de la pâte puis du mélange d’épices', 'Faire fondre le chocolat au bain-marie.', 'Avec du beurre, dorer dans une poêle d’abord les pommes pink lady puis lorsque celles-ci commencent à dorer ajouter les autres pommes. Lorsqu’elles sont presque dorées, saupoudrer d’un peu de sucre pour caraméliser.', 'Note : vous pouvez laisser les pommes chanteclair/beltrane/canada fondre un peu si vous voulez. Si vous utilisez les épices à ce moment, elles s''en imprégnerons probablement mieux.', 'Préchauffer le four à 250°C (thermostat 8-9).', 'Retirer les pommes de la poêle et y dorer les tranches de poire. De même que pour les pommes, caraméliser légèrement les tranches de poire.', 'Optionnellement, dorer les bananes avec les tranches de poire ou séparément.', 'Beurrer le plat à tarte (ou plat à gratin), puis disposer les pommes, poires, bananes (n’hésitez pas à décorer en alternant les fruits, ça peut être utile pour l’étape suivante).', 'Disposer le chocolat fondu sur les fruits (de préférence où sont les tranches de poire et les rondelles de banane) puis recouvrir de pâte.', 'Enfourner le plat à 180°C (thermostat 6) dans la position la plus haute (pour que la pâte dore bien) pendant 30 minutes environ.', 'Retirer le plat une fois que la pâte est dorée.', 'Manger tiède ou froid.'], ['Râpe', 'Casserole', 'Rouleau à pâtisserie'], ['amandes', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'crumble banane', 'testées', 'poire', 'plat', 'moyenne', 'poudre de noisette', 'recette', 'cuisine', 'recettes', 'boisson', 'Crumble pomme', 'farine', 'dessert', 'plat de résistance', 'chocolat et fantaisie', 'moyen', 'beurre', 'cannelle', 'sucre', 'cocktail'], 'Dessert', 83ea42df-7636-4099-bfc8-2fc26513f834, '2025-09-26T16:01:47.588799', [{'ingredient_id': '4470cee1-8929-4400-bc73-642f8b0dbc25', 'quantite': '100 g'}, {'ingredient_id': 'ffe05a30-5d0d-4f9e-8dd2-b5e39bbf9f6c', 'quantite': '50 g'}, {'ingredient_id': '568006a1-5969-41fc-9f94-6e57e06b1b9d', 'quantite': '50 g'}, {'ingredient_id': '07825c7c-769d-4676-b220-fbd3e9911aed', 'quantite': '50 g'}, {'ingredient_id': '9365b28f-acb4-43e0-9023-8a51e0d73971', 'quantite': '75 g'}, {'ingredient_id': '20edb7a3-6793-4aa1-9fae-2fcc1ed9e043', 'quantite': ''}, {'ingredient_id': '5dc854f4-b67f-441d-a000-077b0fb432bf', 'quantite': '2'}, {'ingredient_id': 'ce271162-99fb-45a0-b7cb-53f57ec385d9', 'quantite': '2'}, {'ingredient_id': '93043e7b-2c12-44e6-8013-d4a42799c5ea', 'quantite': '1'}, {'ingredient_id': 'b3353440-e11c-4dec-a5ed-ed6380851ed5', 'quantite': '1'}, {'ingredient_id': 'a5010649-baa5-44d7-ac0f-7dd33b173a54', 'quantite': '3'}, {'ingredient_id': '9a8e4cbb-9f01-4367-abb0-fca0049e2059', 'quantite': '2'}, {'ingredient_id': 'a116a7ba-828b-4ec7-87bc-2fc944528fb8', 'quantite': '1'}, {'ingredient_id': '1e87c3fd-e718-40d1-b9e8-c992dd8d8fc9', 'quantite': '40 g'}, {'ingredient_id': 'ce676e18-0574-4d48-acf5-c1e286a72660', 'quantite': '1'}, {'ingredient_id': 'babe058d-3a28-4013-a246-3d5150a22d16', 'quantite': '60 g'}, {'ingredient_id': 'c217c1b8-d69f-4671-af8e-7739416f10c5', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (33735, 'gateau Lydinette à la banane', 'banane, farine, sel, beurre, sucre roux, oeuf, levure', '10 min', ['Mélanger le beurre fondu et le sucre, ajouter la farine et le sel. Battre les oeufs et les ajouter au mélange. Pour finir, ajouter les bananes écrasées sans oublier la levure. ', 'Beurrez légèrement votre moule. ', 'Mettre au four 1 h15 à 180°C. ', 'C''est prêt !'], ['Spatule', 'Louche', 'Planche à découper', 'Casserole'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'gâteau à la banane', 'gateau Lydinette à la banane', 'beurre', 'cocktail', 'sucre roux'], 'Dessert', c4fa739a-3141-4a05-ac9d-dd8019367a55, '2025-09-26T16:01:53.509007', [{'ingredient_id': 'bab18ec4-bdc3-4e98-a6b1-3348f9f2ce6e', 'quantite': '3'}, {'ingredient_id': '06e93f21-61e1-4d81-a8b6-44242fe28fad', 'quantite': '200 g'}, {'ingredient_id': 'be328d07-c046-435c-ba16-3ea8bff0973f', 'quantite': ''}, {'ingredient_id': 'b59264c6-9bef-497b-a4d9-66fb49225673', 'quantite': '50 g'}, {'ingredient_id': '0778d227-f369-4e31-a62b-8c1dea1eb6ae', 'quantite': '175 g'}, {'ingredient_id': '4bd7bb09-881d-41ba-85a3-f7374a0192f4', 'quantite': '2'}, {'ingredient_id': '6aadc760-0bdc-4c0d-adb0-dd265255e966', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (308808, 'Muffins chocolats bananes mascarpone', 'farine, sucre roux, beurre demi-sel, lait, oeuf, levure chimique, chocolat noir, orange, mascarpone, banane', '45 min', ['Mélanger dans un saladier la farine, la levure, le sel, et le sucre. ', 'Faire fondre le beurre, dans un bol, battre l’œuf et le lait. ', 'Ajouter le beurre fondu. Verser le tout dans le saladier progressivement puis mélanger jusqu’à obtenir un pâte lisse. ', 'Éplucher l''orange et garder les pelures. Remplir une casserole d''eau à moitié. Faire bouillir l''eau. Dès que l''eau bout, placer le chocolat coupé en carrés. ', 'Dans l''eau mettre un peu de zeste d''orange. Extraire le jus de l''orange pour le placer dans la casserole d''eau et de chocolat. ', 'Dès que le chocolat est bien fondu, le verser dans le saladier. Bien mélanger. ', 'Dans les moules, mettre une couche de pâte, après avoir coupé la banane en plusieurs morceaux, tartiner les morceaux de mascarpone. ', 'Placez celui-ci dans le moule. Puis recouvrir de pâte. ', 'Remplir les moules au 2/3. Cuire au four à 190°C (thermostat 6-7) pendant 25 minutes environ.'], ['Planche à découper', 'Casserole', 'Fouet', 'Tire-bouchon', 'Presse-agrumes'], ['entrée', 'banane', 'recettes de cuisine', 'mascarpone', 'confiserie', 'testées', 'levure chimique', 'facile', 'bon marché', 'oeuf', 'plat', 'Muffins chocolats bananes mascarpone', 'recette', 'cuisine', 'recettes', 'beurre demi-sel', 'boisson', 'farine', 'dessert', 'plat de résistance', 'chocolat noir', 'muffin', 'orange', 'lait', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:01:57.397655', [{'ingredient_id': 'be2d24ed-2212-4b48-b0d0-f6794c136bfc', 'quantite': '200 g'}, {'ingredient_id': '9c7c8dd4-2f1a-4ddc-93a2-0425a1287b9c', 'quantite': '100 g'}, {'ingredient_id': '4591d05f-5342-4289-8028-a6ab20d2db46', 'quantite': '50 g'}, {'ingredient_id': '40a0364f-f5a6-471f-8fba-b584eeac8596', 'quantite': '20 cl'}, {'ingredient_id': '5a543ca9-e69d-47fd-b9b1-ba49c0b9b5f1', 'quantite': '1'}, {'ingredient_id': 'c56cd8c5-03f4-4eab-8f7d-ca550ea01338', 'quantite': ''}, {'ingredient_id': '377a04f6-e2f3-4aff-a17c-37e04ba34650', 'quantite': '200 g'}, {'ingredient_id': '9975d049-94df-4e3f-a260-6d7a203b1e0e', 'quantite': '1'}, {'ingredient_id': '9c8b9056-d8c4-4135-a199-a1c200957a19', 'quantite': '250 g'}, {'ingredient_id': '11fd59c4-0258-4b45-a9b5-848f3673952d', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (36132, 'Croque Nutella banane', 'pain, Nutella, banane', '10 min', ['Prenez 1 tranche de pain et enduisez-la de nutella (pour les gourmands, je conseille d''en mettre une bonne couche, mais pas trop non plus, au risque de faire couler le nutella dans votre grille-pain).', 'Disposez ensuite des rondelles de banane sur le nutella (autant que vous voulez). Si vous mettez de la pomme ou de la poire disposez-les en fines couches. Vous pouvez aussi mettre les trois fruits.', 'Refermez votre sandwich et applatissez-le bien.', 'Mettez-le au grille-pain et faites-le cuire selon votre goût.'], ['Ouvre-boîte', 'Moule à tarte', 'Râpe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Nutella', 'dessert', 'plat de résistance', 'Croque Nutella banane', 'pain', 'cocktail'], 'Dessert', f7e76ed8-aa0e-408a-99d0-ad4482f8cc6a, '2025-09-26T16:02:00.903243', [{'ingredient_id': '30b19c98-981c-4f4f-a007-0cd8207aadf6', 'quantite': '2'}, {'ingredient_id': 'f728e1b2-535e-43a3-a4b6-b50bcc79daf3', 'quantite': '1 cuillères'}, {'ingredient_id': '48346960-1a6c-42b1-ab28-ae6adc3110a5', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (21619, 'Bananes malgaches', 'banane, jambon, crème fraîche, moutarde, gruyère, chapelure, beurre, poivre, sel', '10 min', ['Beurrez un plat étroit et long, allant au four (genre Pyrex). ', 'Coupez les bananes en deux, tartinez-les de moutarde, roulez-les dans l''Emmental râpé, enroulez-les dans une demi tranche de jambon, puis posez-les, les unes sur les autres, dans le plat beurré. ', 'Versez dessus le 1/4 de litre de crème fraîche, salez légèrement et poivrez selon votre goût. ', 'Terminez avec une couche de chapelure et de fromage râpé, surmontée de quelques morceaux de beurre. ', 'Enfournez 10 min dans un four très chaud, puis terminez par quelques minutes sous le grill.'], ['Économe', 'Rouleau à pâtisserie', 'Balance de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'jambon', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'chapelure', 'recette', 'cuisine', 'recettes', 'boisson', 'Bananes malgaches', 'dessert', 'plat de résistance', 'moutarde', 'beurre', 'gruyère', 'poivre', 'cocktail'], 'Entrée', 61d3c07b-9e12-4d1a-855d-0be77cc1f6d6, '2025-09-26T16:02:05.710214', [{'ingredient_id': 'd0bbc9f4-f52f-45d8-a812-b5957278e1c4', 'quantite': '4'}, {'ingredient_id': '7c5313a6-85d7-4121-a6dd-2dfef651187f', 'quantite': '4'}, {'ingredient_id': 'bccb46f5-593c-4b6d-937a-b7c2ad6aba6a', 'quantite': ''}, {'ingredient_id': '8ef04566-9281-4b59-964c-27d7abad1fc4', 'quantite': ''}, {'ingredient_id': 'a3786f21-07c3-4052-a2e6-404888e05a9f', 'quantite': '400 g'}, {'ingredient_id': '8bb3e03c-7827-4945-a8fa-a14bd6a13834', 'quantite': ''}, {'ingredient_id': '8329557e-a17a-4730-9d26-614502397fd8', 'quantite': ''}, {'ingredient_id': '063baf1d-926f-4033-b354-b229231ccec8', 'quantite': ''}, {'ingredient_id': '7a9bb53c-18c7-4e20-9b56-4d2e1ab9ea92', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (73861, 'alliance de la banane et du chocolat...', 'sucre, oeuf, beurre, farine, banane, chocolat, levure', '10 min', ['- Préchauffer le four à 180°, thermostat 6. ', '- Dans un saladier, mélanger le sucre, les oeufs, la farine et la levure. ', '- Faire ramolir le beurre et l''incorporer au mélange. ', 'Bien mélanger. ', '- Couper les bananes en cubes et les ajouter à la préparation. Mélanger.', '- Enfin ajouter les pépites ou couper la tablette en petits dés. Mélanger.', '- Beurrer un moule à cake, et verser la préparation dans le moule.', '- Faire cuire pendant 30 à 40 min.'], ['Louche', 'Couteau de chef'], ['alliance de la banane et du chocolat...', '', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'beurre', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:02:09.313542', [{'ingredient_id': 'ee8766fb-fba1-425d-80d0-56020f41fafd', 'quantite': '110 g'}, {'ingredient_id': 'c5ae4383-0a91-45b4-a723-4e75525f4423', 'quantite': '2'}, {'ingredient_id': '10aa3fcf-410b-4485-98f9-f263a661684f', 'quantite': '120 g'}, {'ingredient_id': '81f0a99f-2a0c-49a5-86ad-7e9e0e29f7bf', 'quantite': '150 g'}, {'ingredient_id': 'f73493d2-1028-422f-99dd-b70061a0d7c1', 'quantite': '2'}, {'ingredient_id': 'dd71f21b-42ad-4174-b3be-c68f2169cdfc', 'quantite': '1'}, {'ingredient_id': 'ffe316c1-2dfe-4785-a773-3338d844dcf8', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (92455, 'Figues sur coulis de banane miel-cannelle', 'figue, banane, noix de coco rapée, miel, cannelle, citron, eau, cannelle', '30 min', ['Faire bouillir l''eau avec le miel et la cannelle en poudre pendant 10 minutes. Découper les bananes en rondelles et les ajouter dans le sirop avec le jus de citron. Cuire 10 minutes. Mixer.', 'Réserver au frais pendant 2 heures.', 'Laver les figues. Couper la base des fruits. Les couper en quartiers.', 'Déposer du coulis de banane dans chaque assiette individuelle. Déposer au centre 8 quartiers de figues. Décorer avec un bâton de cannelle ainsi que la noix de coco râpée.'], ['Fouet', 'Planche à découper', 'Verre doseur', 'Mixeur', 'Tire-bouchon'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'Figues sur coulis de banane miel-cannelle', 'facile', 'bon marché', 'figue', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'noix de coco rapée', 'dessert', 'plat de résistance', 'citron', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:02:13.711284', [{'ingredient_id': '04bf7641-4945-4f04-b9c8-50aed37205a5', 'quantite': '8'}, {'ingredient_id': 'deb546e9-6f22-49fd-b68c-23a43f835e98', 'quantite': '2'}, {'ingredient_id': 'ad2bf9a4-54fb-46bb-b2ee-6b47edb84bb1', 'quantite': '50 g'}, {'ingredient_id': '1ba53cdc-0449-417d-bd00-e81b2a382667', 'quantite': '2 cuillères'}, {'ingredient_id': 'ca24720e-9eeb-42c6-b8d3-b65aae903b0e', 'quantite': '1 cuillères'}, {'ingredient_id': '26766165-3364-49cc-92ad-43250a7d2fd0', 'quantite': '1'}, {'ingredient_id': '40a3eaf7-ba43-4a48-8294-2865e4785dfb', 'quantite': '400 ml'}, {'ingredient_id': '88295d61-c0e2-4702-9acc-d5d088d848bc', 'quantite': '8'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (84460, 'Clafoutis de kiwi et banane au chocolat blanc', 'lait, kiwi, banane, beurre, farine, levure, oeuf, sucre, chocolat blanc', '20 min', ['Préchauffer le four à 180°C(thermostat 6).', 'Porter le lait à ébullition avec 75 g de chocolat blanc coupé en morceaux. Laisser tiédir.', 'Éplucher les fruits, les couper en rondelles, réserver.', 'Beurrer un moule à gâteaux et déposer les rondelles de fruits sur le fond.', 'Dans une terrine, battre les oeufs en omelette. Ajouter le sucre et mélanger. Ajouter la farine et la levure, puis mélanger.', 'Ajouter ensuite le beurre fondu, et enfin le lait progressivement tout en mélangeant. Verser sur les fruits.', 'Enfourner et laisser cuire 40 min. Vérifier la cuisson à l''aide d''un couteau. Pendant la cuisson, faire des copeaux de chocolat avec les 25 g restant.', 'A la sortie du four, déposer ces copeaux de chocolat blanc sur le clafoutis.'], ['Ouvre-boîte', 'Louche', 'Tire-bouchon', 'Mixeur'], ['entrée', 'Clafoutis de kiwi et banane au chocolat blanc', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'clafoutis', 'beurre', 'chocolat blanc', 'lait', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:02:18.560137', [{'ingredient_id': '3c93051a-f411-47f8-9332-f379feefd505', 'quantite': '30 cl'}, {'ingredient_id': '9bf7d00c-9aa6-4a6c-8ae8-dfe506c547dc', 'quantite': '4'}, {'ingredient_id': '6d3fb356-5dd0-4fa7-abd1-49249dd90cfa', 'quantite': '1'}, {'ingredient_id': '8810537e-6b84-47fe-9499-803ebb5979a6', 'quantite': '40 g'}, {'ingredient_id': '8e4d6825-8dbe-4513-ac16-b42af6de9533', 'quantite': '100 g'}, {'ingredient_id': 'ab662348-448c-4d42-bc4f-92f6a2b5e2d9', 'quantite': ''}, {'ingredient_id': 'ec6c6c69-4aa9-4a7d-9930-7479c25d2631', 'quantite': '4'}, {'ingredient_id': 'a1e201d2-c546-4d32-9799-2097c354b372', 'quantite': '130 g'}, {'ingredient_id': '500fd7a0-e666-452c-8d29-4a8dec72b538', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (223564, 'Pommes et bananes meringuées', 'blanc d''oeuf, sucre, banane, pomme, sel', '10 min', ['Préchauffez votre four à 180°C (thermostat 6).', 'Épluchez les pommes et les bananes puis coupez-les en morceaux.', 'Dans chaque ramequin, placez un étage de pommes puis un étage de bananes.', 'Mettez au four pendant 15 min à 180°C.', 'Montez les blancs en neige avec une pincée de sel.', 'Sortez les ramequins du four, repartir les blancs en neige dans les ramequins et saupoudrez de sucre. ', 'Enfournez à nouveau pendant 15 min à 180°C.', 'Bon appétit !'], ['Poêle', 'Ouvre-boîte', 'Râpe', 'Louche', 'Fouet'], ['', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Pommes et bananes meringuées', 'dessert', 'plat de résistance', 'pomme', 'sucre', 'blanc d''oeuf', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:02:22.226336', [{'ingredient_id': '1589d52b-98ff-4f84-b604-612b866b3b57', 'quantite': '3'}, {'ingredient_id': 'aaddba3a-a344-4d10-a55c-1911ed162688', 'quantite': '60 g'}, {'ingredient_id': 'df66113f-998c-4037-a9da-863e1bb7c6a9', 'quantite': '3'}, {'ingredient_id': '8d2e7f32-e24b-42df-aa05-9872be26a43a', 'quantite': '2'}, {'ingredient_id': 'c8c17ba4-be0a-4dd7-9577-2dd388765894', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (339904, 'Compote mûre banane', 'mûres, banane, sucre, jus de citron', '5 min', ['Epluchez les bananes et coupez-les en rondelles. Nettoyez les mûres sauvages.', 'Mettez tous les fruits dans une casserole et les cuire à feu moyen avec le sucre, le jus de citron et 10 cl d''eau pendant 40 minutes.'], ['Passoire', 'Spatule', 'Batteur électrique'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'Compote mûre banane', 'plat', 'recette', 'mûres', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'jus de citron', 'moyen', 'sucre', 'compote de banane', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:02:25.767255', [{'ingredient_id': '412f4f81-3251-40f9-97e7-d9cb737751ae', 'quantite': '500 g'}, {'ingredient_id': 'da88bd61-4090-4cc1-b07f-29512ea17f1d', 'quantite': '2'}, {'ingredient_id': 'cd0cb85e-9131-4455-8c47-0b35af1a3a9a', 'quantite': '50 g'}, {'ingredient_id': '1b08337e-219e-482d-80cf-35b682901ecd', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (231123, 'Mousse à la banane légère', 'banane, sucre vanillé, sucre en poudre, citron', '10 min', ['Éplucher les bananes, les découper en rondelles, les déposer dans le bol du mixeur. ', 'Ajouter le jus de citron, le sucre en poudre, le sucre vanillé.', 'Mixer finement, mettre au frigo 1 heure. Servir.'], ['Spatule', 'Verre doseur', 'Poêle', 'Mixeur', 'Planche à découper'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'Mousse à la banane légère', 'bon marché', 'rapide', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'citron', 'mousse fruits', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:02:29.502978', [{'ingredient_id': '96103bec-ea0b-43fc-974e-7c2b84065b42', 'quantite': '4'}, {'ingredient_id': '882e931c-7607-4ac6-ab25-53630f9fdaec', 'quantite': '2'}, {'ingredient_id': '734edc47-249f-4d63-9fd0-4b30c4d717bf', 'quantite': ''}, {'ingredient_id': '2c847452-ffe2-4248-8a99-7e684eebb704', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (60566, 'Papillote de fruits et épices', 'banane, pomme, poire, abricot, figue, miel, épices, cannelle, papier sulfurisé', '10 min', ['Préchauffer le four à 200°C (thermostat 6-7).', 'Couper les fruits en petits morceaux. Les répartir au centre des carrés de papier sulfurisé.', 'Rajouter les fruits secs coupés en 2.', 'Mettre 1 cuillère à soupe de miel par papillote (mettre sur les fruits) puis ajouter 1 pincée de 4 épices et 1 pincée de cannelle par papillote.', 'Mettre au four pendant 15 minutes environ. Servir aussitôt.'], ['Couteau de chef', 'Économe', 'Poêle', 'Fouet', 'Planche à découper'], ['', 'entrée', 'banane', 'recettes de cuisine', 'épices', 'confiserie', 'testées', 'abricot', 'poire', 'facile', 'bon marché', 'figue', 'plat', 'recette', 'papier sulfurisé', 'cuisine', 'miel', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'cannelle', 'cocktail', 'Papillote de fruits et épices'], 'Dessert', f344c9d5-d45a-4d6d-8fd9-7c0b564fd817, '2025-09-26T16:02:34.535843', [{'ingredient_id': 'a690d579-0075-496a-a6ad-4cf36550c538', 'quantite': '2'}, {'ingredient_id': 'c0728272-f170-4909-bb0d-d074608de265', 'quantite': '1'}, {'ingredient_id': 'b057e7a8-4636-496e-a383-9acac5c3b292', 'quantite': '1'}, {'ingredient_id': '1acfd409-eca6-40b6-b765-621a89694315', 'quantite': '8'}, {'ingredient_id': '4613cec6-866d-4d82-8b4d-ea0d5dabb385', 'quantite': '4'}, {'ingredient_id': 'f650b0d4-a442-4efd-88cb-3dfb69337459', 'quantite': '4 cuillères'}, {'ingredient_id': '3986090e-8574-4fa6-8b31-a91a796895cc', 'quantite': '4'}, {'ingredient_id': '444cccc7-c4a1-4e38-aa08-285673c23ad7', 'quantite': ''}, {'ingredient_id': 'cb9d17ba-e40a-4229-b411-494f3bb412b1', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (69618, 'Smoothie aux fruits (orange, kiwi, banane...)', 'orange, kiwi, banane, glace, fraises, fromage blanc, cannelle, jus d''orange', '7 min', ['Peler les fruits et les couper en morceaux dans le bol d''un mixeur. ', 'Ajouter la boule de glace, le fromage blanc, le pulco, la cannelle, un peu de jus d''orange et/ou de lait.', 'Mixer pendant 1 minute environ, jusqu''à ce que le mélange soit homogène.'], ['Économe', 'Rouleau à pâtisserie', 'Balance de cuisine', 'Râpe'], ['entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'Smoothie aux fruits (orange', 'testées', 'banane...)', 'très facile', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'glace', 'fromage blanc', 'dessert', 'plat de résistance', 'orange', 'jus d''orange', 'cannelle', 'smoothies', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:02:39.096975', [{'ingredient_id': 'bc853343-2a55-435d-ac48-97fa82d023aa', 'quantite': '1'}, {'ingredient_id': 'b4ba3969-1485-46ca-85c7-5d52f3d9d80f', 'quantite': '1'}, {'ingredient_id': '9490bfad-68dc-4e11-865d-0cba37e65792', 'quantite': '1'}, {'ingredient_id': 'f4c164c1-8d24-4529-92ba-135041671e46', 'quantite': '1'}, {'ingredient_id': '3e57af93-02f8-430e-b9cd-cb14dcacaa52', 'quantite': '3 cuillères'}, {'ingredient_id': '9221a6bf-b019-4a9b-8082-17f2e2bed3c3', 'quantite': '2 cuillères'}, {'ingredient_id': '327b9c4e-18e8-413c-8e06-041c2780fc44', 'quantite': '2 cuillères'}, {'ingredient_id': 'd297b697-e63b-436f-b429-93bb28d0683e', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (25327, 'Bananes et Fraises au Sabayon', 'fraises, banane, jaune d''oeuf, sucre en poudre, sucre vanillé, crème fraîche épaisse, lait', '20 min', ['Rincer les fraises sous un filet d''eau, les égoutter et les éponger sur du papier absorbant. Les équeuter, puis les fendre en 2 ou en 4 selon leur taille. ', 'Peler les bananes et les couper en rondelles. Répartir ces fruits dans 4 assiettes pouvant passer au four. ', 'Préparer le sabayon : mélanger dans un saladier à fond rond les jaunes d''oeufs avec le sucre en poudre et le sucre vanillé, fouetter jusqu''à ce que le mélange blanchisse. ', 'Poser le saladier dans une grande casserole d''eau chaude, et verser le lait peu à peu, tout en continuant à battre énergiquement. ', 'Quand la préparation est bien mousseuse, retirer du feu, poser le fond du saladier dans une bassine d''eau très froide. Tout en fouettant, ajouter la crème épaisse. ', 'Préchauffer le gril du four. Répartir ce sabayon sur les fruits et glisser les assiettes sous le gril du four 1 à 2 mn, juste pour faire colorer. ', 'Régalez-vous sans tarder!'], ['Spatule', 'Passoire', 'Économe', 'Presse-agrumes'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'rapide', 'plat', 'moyenne', 'fraises', 'recette', 'cuisine', 'Bananes et Fraises au Sabayon', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'sabayon', 'cocktail'], 'Dessert', 27421fc6-be81-403c-907c-8dd0e9817120, '2025-09-26T16:02:42.712498', [{'ingredient_id': 'c0bae4b2-73a2-4888-9a65-52f69e61862f', 'quantite': '250 g'}, {'ingredient_id': 'c97646bd-fd7c-43fa-bdf1-8514ea55df18', 'quantite': '2'}, {'ingredient_id': '4e06c809-63d9-4483-a9bc-30cfa98a636d', 'quantite': '4'}, {'ingredient_id': '4f12134a-363e-482a-928f-2b593f76c8fd', 'quantite': '100 g'}, {'ingredient_id': '381a2b82-32e3-4240-948f-3a6a714f3df1', 'quantite': '2'}, {'ingredient_id': '78217178-d1c5-411a-a37a-a4da5c6d444e', 'quantite': '10 cl'}, {'ingredient_id': 'c08d94d0-a5c7-4cbd-a88d-12256ad8ff1c', 'quantite': '20 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (51547, 'La crème Budwig du bonheur', 'citron, fromage blanc, pomme, banane, sarrasin, amandes, huile, huile de tournesol', '5 min', ['Dans une assiette creuse, mettez le fromage blanc.', 'Ajoutez dessus le jus de citron et mélangez à l''aide d''une fourchette comme pour de la mayonnaise.', 'Rajoutez les huiles et mélangez énergiquement.', 'Ecrasez une banane dans l''assiette.', 'Epluchez les amandes, coupez-les et ajoutez-les dans l''assiette. Déposez le sarrasin.', 'Râpez la pomme et mélangez le tout.', 'Bon appétit, vous êtes parés pour une bonne journée, vous avez fait le plein de pleins de bonne choses pour votre corps !'], ['Tire-bouchon', 'Mixeur', 'Balance de cuisine', 'Économe', 'Fouet'], ['', 'amandes', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'rapide', 'plat', 'moyenne', 'recette', 'La crème Budwig du bonheur', 'cuisine', 'recettes', 'boisson', 'huile', 'fromage blanc', 'huile de tournesol', 'dessert', 'plat de résistance', 'pomme', 'moyen', 'citron', 'sarrasin', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:02:46.284780', [{'ingredient_id': '904058e7-5bc9-4078-b7fb-138c8d19681f', 'quantite': ''}, {'ingredient_id': '1ba2fd5a-586e-44d0-b1e6-694c08e4f6ed', 'quantite': '1 cuillères'}, {'ingredient_id': '8e1fccd5-664e-4057-a921-021a915972cc', 'quantite': '1'}, {'ingredient_id': '63bb4862-1fe8-4129-b3d9-b16b7dee705a', 'quantite': '1'}, {'ingredient_id': 'ce2aa0f4-cf4e-471d-b52b-c576ee08dd65', 'quantite': '1'}, {'ingredient_id': '58788b54-e386-45e2-8303-58a7a78a571e', 'quantite': '7'}, {'ingredient_id': '45d05af8-ae7b-46f0-a9a5-454f81cd1e5c', 'quantite': '1 cuillères'}, {'ingredient_id': '0dc22a40-c2e0-456b-bb4d-8524cd43e04e', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (310850, 'Smoothie banane et lait d''avoine', 'banane, lait d''avoine, miel', '10 min', ['Dans un blender, mettre la banane coupée en morceaux, le lait d''avoine et le miel, puis tout mixer. ', 'Vous n''avez plus qu''à servir et à déguster.'], ['Louche', 'Planche à découper', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'rapide', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'lait d''avoine', 'Smoothie banane et lait d''avoine', 'smoothies', 'cocktail'], 'Boisson', 139101a7-816a-4caf-a4f3-8fc05fc9bf98, '2025-09-26T16:02:49.878711', [{'ingredient_id': 'd22968b0-e97d-4a71-899e-9fab44ecdbec', 'quantite': '1'}, {'ingredient_id': '7e1b34fe-942a-41d1-ad3a-2c47624ebe38', 'quantite': '4'}, {'ingredient_id': 'd90bf6e4-61c7-4820-a190-99108fca3f0a', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (330245, 'Smoothie vitaminé carotte-orange-banane', 'jus d''orange, carotte, banane, pousses d''épinards, yaourt à la grecque', '10 min', ['Dans un blender, versez d''abord le jus d''orange, puis ajouter les fruits et légumes, et les yaourts.', 'Mixez à pleine puissance jusqu''à l''obtention d''un jus bien lisse.', 'Servez !'], ['Balance de cuisine', 'Passoire', 'Poêle'], ['yaourt à la grecque', 'banane', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'carotte', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Smoothie vitaminé carotte-orange-banane', 'jus d''orange', 'pousses d''épinards', 'smoothies', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:02:53.434015', [{'ingredient_id': '05955608-539b-47bb-8bd6-34679e98e44f', 'quantite': '50 cl'}, {'ingredient_id': 'b32041fe-5a80-4659-aeb8-8fb97527e151', 'quantite': '2'}, {'ingredient_id': '168113f3-edcd-4e43-beec-6b00f63696ad', 'quantite': '2'}, {'ingredient_id': '9d41374b-bf6d-46c8-9a64-6209e9964872', 'quantite': '2'}, {'ingredient_id': '12ebc906-7477-4566-99f5-b2727111ff3d', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (68952, 'Smoothie des îles Canaries', 'lait écrémé, jus d''ananas, banane, framboises, groseilles, sucre, gingembre, crème fraîche, citron vert, girofle', '10 min', ['Afin d''avoir une préparation déjà fraîche, utilisez des fruits rouges surgelés.', 'Mettre les fruits rouges dans un bol mixer avec le sucre. Ajouter le lait, la crème, le jus d''ananas (ou tranches et sirop), les deux petites bananes et la cuillère de gingembre.', 'Mixer le tout.', 'Servir dans deux verres "long drink" et décorer d''une rondelle de citron vert piquée d''un clou de girofle !'], ['Pince de cuisine', 'Fouet'], ['gingembre', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'lait écrémé', 'testées', 'très facile', 'framboises', 'girofle', 'bon marché', 'rapide', 'plat', 'Smoothie des îles Canaries', 'recette', 'cuisine', 'recettes', 'boisson', 'groseilles', 'dessert', 'plat de résistance', 'jus d''ananas', 'citron vert', 'sucre', 'smoothies', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:02:58.001075', [{'ingredient_id': '83abdf93-4f3e-4699-90ea-7446dad305e3', 'quantite': '50 cl'}, {'ingredient_id': '60c61a78-bd91-42f1-92be-a4b195c8ff66', 'quantite': '12 cl'}, {'ingredient_id': '3038abd8-e04f-4026-bec8-34e1130316dd', 'quantite': '2'}, {'ingredient_id': 'fb270b54-40a6-4996-8cec-c89c99cf3d09', 'quantite': '2'}, {'ingredient_id': '457c9f93-5a8c-4288-977a-7fdc352a8aab', 'quantite': '2'}, {'ingredient_id': '6613057e-7cea-44bf-976b-0667d2570ce3', 'quantite': '20 g'}, {'ingredient_id': '7008d880-7501-4879-9596-8bc3272c5fcc', 'quantite': '1 cuillères'}, {'ingredient_id': '5698bbd3-ad90-4825-b29f-39c7dda6c60c', 'quantite': '2 cuillères'}, {'ingredient_id': 'b286d2f7-8864-46eb-8495-ef9920cc3b0e', 'quantite': '2'}, {'ingredient_id': '6f7e0525-7dcc-4f20-be11-afccfefd1332', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (31434, 'Cake pomme - banane moelleux', 'beurre, sucre, farine, oeuf, levure chimique, pomme, banane', '15 min', ['Mélanger tous les ingrédients dans l''ordre : beurre (fondu), sucre, oeufs, farine, levure, fruits (coupés en petits morceaux). ', 'Mettre dans un moule à cake, cuire à Th 6 (180°C), entre 40 min et 1 h selon le four. ', 'Variante : ', 'Pour un cake croquant, remplacer les fruits par 3 bananes et 100 g de noix concassées (en gros morceaux). ', 'Ou encore par pommes + bananes + noix, dans les quantités que l''on veut.'], ['Verre doseur', 'Rouleau à pâtisserie', 'Couteau de chef', 'Tire-bouchon', 'Râpe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'très facile', 'bon marché', 'oeuf', 'plat', 'Cake pomme - banane moelleux', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'autres cakes', 'dessert', 'plat de résistance', 'pomme', 'beurre', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:03:05.153912', [{'ingredient_id': '6a610ba9-9093-4580-a1e9-665ff8a83982', 'quantite': '75 g'}, {'ingredient_id': '36925d82-c12c-434d-911d-ca8731318861', 'quantite': '125 g'}, {'ingredient_id': '746d4f6e-cd82-4445-afd8-41494ef9e06b', 'quantite': '250 g'}, {'ingredient_id': '8fb432f8-aa1c-4c60-82c5-fbe2a6eba115', 'quantite': '2'}, {'ingredient_id': '3715a277-3bf0-4751-b8e8-f564e0506d48', 'quantite': '1'}, {'ingredient_id': '9980b906-bef2-48db-b51f-54f0b185cd1b', 'quantite': '2'}, {'ingredient_id': '31f93a91-9344-41bf-a4c3-c1f27bd0dfaa', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (532039, 'Bol de yaourt, bananes et pommes à partager (spécial enfant)', 'yaourt nature, raisins secs, banane, pomme', '5 min', ['Verse les yaourts dans un grand saladier et ajoute-y les raisins secs, les bananes coupées en rondelles et les pommes coupées en petits dés. Demande à l''un de tes parents de t''aider pour couper les fruits !'], ['Pince de cuisine', 'Ouvre-boîte', 'Fouet', 'Balance de cuisine', 'Tire-bouchon'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'yaourt nature', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Bol de yaourt', 'pomme', 'raisins secs', 'cocktail', 'bananes et pommes à partager (spécial enfant)'], 'Dessert', 5b367c7c-67ed-44f7-b5e9-bee1bc6abb0e, '2025-09-26T16:03:10.634707', [{'ingredient_id': 'c1993f7f-53f5-45a5-8a87-07145c4e56e5', 'quantite': '8'}, {'ingredient_id': '8eeedba0-bbf3-44ea-a54a-3d2eba4f52ba', 'quantite': '2'}, {'ingredient_id': '28fc1112-24ec-4f5d-9d5a-ddbc4130f4a7', 'quantite': '2'}, {'ingredient_id': '504931f4-9acc-436b-8beb-bf9f4e3703f5', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (30411, 'Fondant à la banane', 'banane, oeuf, farine, levure chimique, lait, cassonade, beurre, cannelle', '10 min', ['Préchauffer le four à 200°C (thermostat 6/7).', 'Faire ramollir le beurre, puis y  incorporer le sucre en fouettant jusqu''à ce que le mélange blanchisse.', 'Ajouter les oeufs, bien mélanger, puis verser le lait. Saupoudrer de cannelle à votre convenance (1/2 cuillère à café à peu près). Ajouter la farine et la levure et fouetter vigoureusement pour éviter les grumeaux.', 'Verser l''appareil dans un moule à manqué beurré et fariné.', 'Eplucher les 3 bananes et les couper en rondelles, les disposer à plat sur la préparation, de façon à recouvrir la surface.', 'Enfourner et laisser cuire 10 mn, puis baisser la température à 180°C et laisser cuire encore 20 mn.'], ['Passoire', 'Râpe', 'Casserole'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'cassonade', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'beurre', 'Fondant à la banane', 'cannelle', 'lait', 'cocktail'], 'Dessert', 068c66e2-e5b7-4b49-994e-3a3d03bd2e89, '2025-09-26T16:03:14.483891', [{'ingredient_id': 'f70c1dbc-03c1-40c9-8c31-05047a4038e6', 'quantite': '3'}, {'ingredient_id': '79f985e2-3af1-403a-b1af-88be745e20d9', 'quantite': '2'}, {'ingredient_id': '92eb4cc9-63b6-4e71-a673-531f35ab93e6', 'quantite': '100 g'}, {'ingredient_id': 'c2150f3f-b6c6-4699-ad0e-0e8a74296817', 'quantite': '1'}, {'ingredient_id': '96a8df55-55a7-4559-a5de-ed810c6d6e6a', 'quantite': '15 cl'}, {'ingredient_id': '757af712-4f1e-4cd1-b2be-6109df0c5945', 'quantite': '90 g'}, {'ingredient_id': 'c10fc765-d6a0-4cd7-aa3d-2d1370c5504d', 'quantite': '75 g'}, {'ingredient_id': '29fb01bc-9e68-4c34-aad4-2d3c624cd131', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (21708, 'Soufflé à la banane', 'banane, lait, sucre, farine, beurre, jaune d''oeuf, rhum', '20 min', ['Couper les bananes en rondelles, les arroser de rhum et laisser mariner.', 'Préchauffer le four à 180°C (thermostat 6).', 'Délayer la farine dans 2 cuillères à soupe de lait froid. Amener le reste du lait à ébullition avec le sucre et verser d''un seul coup le mélange farine-lait tout en remuant. Laisser épaissir 2 minutes puis, hors du feu, ajouter le beurre et les jaunes d''oeufs.', 'Ajouter les bananes et les blancs d''oeufs montés en neige. Verser dans un moule beurré.', 'Cuire 20 minutes, servir dès la sortie du four.'], ['Moule à tarte', 'Casserole'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'facile', 'plat', 'jaune d''oeuf', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'moyen', 'beurre', 'Soufflé à la banane', 'soufflé sucré', 'lait', 'sucre', 'cocktail'], 'Dessert', 665bbb3b-6f2b-4e58-ad00-ab87a8d6c6e9, '2025-09-26T16:03:18.127706', [{'ingredient_id': '4114e18b-dc75-4bca-879e-b9f41ac3577f', 'quantite': '2'}, {'ingredient_id': 'a6727116-4ad0-4e9a-b286-f416d2b4025f', 'quantite': '20 cl'}, {'ingredient_id': '326f8358-c62d-4f8b-9aac-4fd790523af5', 'quantite': '70 g'}, {'ingredient_id': 'f88174c3-dd93-4c85-9e09-940f79275860', 'quantite': '2 cuillères'}, {'ingredient_id': 'd0fbef92-fa05-4036-a721-1088c73b4155', 'quantite': '30 g'}, {'ingredient_id': '87188399-3640-4571-ad75-8fdc887142ca', 'quantite': '3'}, {'ingredient_id': 'cad003bc-77e9-4c53-aae9-458cf9f134e4', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (95285, 'Tarte pommes, raisins, noix', 'pâte feuilletée, cerneau de noix, banane, pomme, sucre en poudre, eau, raisin blanc', '15 min', ['Ecraser la banane jusqu''à ce qu''elle devienne une purée.', 'Dans un moule à tarte, déposer la pâte feuilletée.', 'Etaler alors la banane écrasée sur la pâte et y incorporer les demi-cerneaux de noix.', 'Eplucher et épépiner les pommes puis les couper en fines tranches. Les disposer sur toute la compote en 2 ou 3 couches.', 'Couper alors les grains de raisin en deux en prenant le soin de les épépiner. Les déposer de facon régulière sur les pommes. ', 'Dans une casserole, mettre l''eau et le sucre afin de faire un caramel. Une fois roussi, le verser sur la préparation.', 'Enfournez alors pour 30 minutes à 190°C (thermostat 6-7).', 'Laisser alors refroidir puis déguster !!'], ['Pince de cuisine', 'Rouleau à pâtisserie', 'Économe', 'Planche à découper'], ['entrée', 'banane', 'recettes de cuisine', 'cerneau de noix', 'confiserie', 'eau', 'testées', 'très facile', 'bon marché', 'Tarte pommes', 'plat', 'tarte aux pommes', 'sucre en poudre', 'recette', 'raisin blanc', 'cuisine', 'noix', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pâte feuilletée', 'pomme', 'raisins', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:03:23.135536', [{'ingredient_id': 'f4b17cf4-3175-4034-8366-72bb518fcd0a', 'quantite': '1'}, {'ingredient_id': '041fc7a2-3d44-46e3-a1e8-0ea52bbf9adb', 'quantite': '50 g'}, {'ingredient_id': '7be78eea-45cf-40fd-96eb-aab627ca732b', 'quantite': '1'}, {'ingredient_id': '7d0c8824-beee-4dd4-806b-d6748f0ea0e0', 'quantite': '4'}, {'ingredient_id': '604fb95a-c9b4-4218-8db6-d0f565c57ba2', 'quantite': '50 g'}, {'ingredient_id': 'db5b8abe-9e63-4e49-91ba-b5ae57bec88c', 'quantite': '1 cuillères'}, {'ingredient_id': 'a3e51a9a-2ef1-43f5-9910-ace429cf2d08', 'quantite': '10'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (49263, 'Cocktail vitaminé aux fruits', 'jus d''orange, banane, pomme, fraises', '10 min', ['Verser tous les ingrédients dans un mixer.', 'Servir frais.'], ['Couteau de chef', 'Louche', 'Fouet', 'Tire-bouchon', 'Râpe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'Cocktail vitaminé aux fruits', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'jus d''orange', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:03:26.781698', [{'ingredient_id': 'a72919a5-b85d-4fb3-8e54-a4511ee30977', 'quantite': '50 cl'}, {'ingredient_id': 'c04e36f9-de87-449a-8f09-ca183829063e', 'quantite': '2'}, {'ingredient_id': 'be0dbb27-d094-44c0-b514-25a6077e4f6a', 'quantite': '3'}, {'ingredient_id': '7a2f185e-b717-4db3-b137-3781fdc5cb41', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (232032, 'Porc au curry et à la bière', 'échine de porc, oignon, tomate, ail, concentré de tomates, raisin, noix de coco, banane, curry, bière brune', '60 min', ['Faire revenir le porc coupé en cubes dans de l''huile d''olive (pimentée à votre convenance).', 'Ajouter les oignons émincés et l''ail', 'Ajouter les tomates en quartiers et le concentré de tomates.', 'Ajouter de la noix de coco rapée, des raisins de corinthe puis la banane coupée en rondelle.', 'Ajouter le demi litre de bière brune.', 'Mettre ensuite  les 4 cuillères à café de curry.', 'Mélangez un petit peu et faire cuire une bonne heure et demi (la viande doit être bien tendre).'], ['Tire-bouchon', 'Passoire'], ['raisin', 'entrée', 'banane', 'recettes de cuisine', 'échine de porc', 'confiserie', 'testées', 'concentré de tomates', 'Porc au curry et à la bière', 'facile', 'bon marché', 'tomate', 'ail', 'plat', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'dessert', 'plat de résistance', 'noix de coco', 'curry', 'bière brune', 'viande à l''indienne', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:03:31.904827', [{'ingredient_id': 'ad389c6e-6113-4472-9ff3-812296c09992', 'quantite': '1.5 kg'}, {'ingredient_id': '44eead22-8103-4dee-8ce9-779167f749b1', 'quantite': '2'}, {'ingredient_id': '79834956-f95e-491e-bd2d-797d68070319', 'quantite': '2'}, {'ingredient_id': '375516cc-8a18-4b7d-89af-273113bb2b81', 'quantite': '1'}, {'ingredient_id': 'a54915cf-2bee-48aa-bd85-9a864a1bc19b', 'quantite': '1'}, {'ingredient_id': 'ac0cf002-bec0-4984-942b-de5013342992', 'quantite': ''}, {'ingredient_id': '99610a8a-8212-4fbc-935f-1219bc3d0ac4', 'quantite': ''}, {'ingredient_id': 'aa1d952d-a85f-4228-8f37-5decfe3f447c', 'quantite': '1'}, {'ingredient_id': '9819fc67-c213-4989-a165-5b52a94ae9d8', 'quantite': '4 cuillères'}, {'ingredient_id': '4ad81787-1d71-4a3c-b481-eec6bdc8eeee', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (29728, 'Salade de fruits exotiques au rhum', 'ananas, banane, orange, noix de coco, sucre, citron, rhum, vanille', '15 min', ['Ouvrir la noix de coco, récupérer la chair et la concasser.', 'Détailler les oranges et les bananes en rondelles, couper l''ananas en morceaux.', 'Réunir les fruits dans un saladier, les saupoudrer de sucre et de vanille.', 'Arroser de rhum et de jus de citron puis laisser macérer 1 heure avant de servir.'], ['Passoire', 'Louche', 'Balance de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'assez cher', 'très facile', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'vanille', 'dessert', 'plat de résistance', 'citron', 'orange', 'ananas', 'Salade de fruits exotiques au rhum', 'noix de coco', 'sucre', 'salade de fruits exotiques', 'cocktail'], 'Dessert', 1e143b2b-93a7-46ff-9da5-5f33b34966e3, '2025-09-26T16:03:38.087567', [{'ingredient_id': '7d7d5d02-902a-44ef-a708-16bcb8f0b9ab', 'quantite': '6'}, {'ingredient_id': '7b3ef810-874b-4e80-ae44-d43ed5817277', 'quantite': '3'}, {'ingredient_id': '6f8403e8-dfb0-4660-b6cc-1a20ee2c3e60', 'quantite': '3'}, {'ingredient_id': '11f0476e-d8ad-4b9d-ba73-439dc53873cf', 'quantite': '1'}, {'ingredient_id': '1a7785a9-3427-4887-9ec8-e6666cfdad1c', 'quantite': '8 cuillères'}, {'ingredient_id': 'afd33d62-5430-478b-a325-93d6609553b3', 'quantite': ''}, {'ingredient_id': '5a1d5545-4bdd-4f06-a22c-2aee3271a4a2', 'quantite': '10 cl'}, {'ingredient_id': 'c5092405-af26-470d-a06d-8da25db615ce', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (65001, 'Verrine banane chocolat', 'banane, crème dessert au chocolat, gélatine, crème fraîche liquide, cannelle, sucre vanillé', '15 min', ['Mélanger les 4 bananes préalablement écrasées à la crème fraîche et au sucre vanillé.', 'Rajouter la pointe de cannelle.', 'A part, faire tremper les feuilles de gélatine dans de l''eau froide pendant 5 min.', 'Faire fondre la tablette de chocolat avec un peu d''eau au bain-marie.', 'Une fois les feuilles de gélatine bien molles, les incorporer à la préparation de bananes.', 'Bien mélanger et disposer dans 4 ou 5 verrines, réserver au frais (ne pas mettre le chocolat tout de suite).', 'Une fois la crème de bananes plus ou moins solide (environ 15 min au frais), disposer le chocolat encore liquide.', 'Servir agrémenté de quelques décorations.'], ['Tire-bouchon', 'Poêle', 'Râpe', 'Planche à découper', 'Couteau de chef'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'crème fraîche liquide', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'gélatine', 'Verrine banane chocolat', 'crème dessert au chocolat', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:03:41.845598', [{'ingredient_id': '8ac6ca1e-ed8c-4d72-9bf3-572933786b2b', 'quantite': '4'}, {'ingredient_id': 'a6443c7e-5b5b-46a3-b83a-f7ccf284f24d', 'quantite': '1'}, {'ingredient_id': 'd05f633e-0169-48f8-a8ba-6239ad8f8593', 'quantite': '4'}, {'ingredient_id': 'b7242a10-b1ef-4e2d-ae27-ec2b753edd74', 'quantite': '75 cl'}, {'ingredient_id': '76c827ec-c92c-4b00-a11e-8221daee4134', 'quantite': '1'}, {'ingredient_id': '4eed4605-3e83-4ada-b460-15268690229a', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (168110, 'Smoothie trop fastoche', 'banane, litchi au sirop', '5 min', ['Ouvrir la boite de litchi,enlever 3 cuilléres a soupe de sirop, mettre tout le reste dans un blender.', 'Eplucher la banane couper la en 3 et mettre dans le blender.', 'Mixer, c'' est prêt!'], ['Mixeur', 'Économe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'Smoothie trop fastoche', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cocktail', 'litchi au sirop'], 'Dessert', 79e7473f-3318-4ace-adae-980b478831c0, '2025-09-26T16:03:47.325347', [{'ingredient_id': '8a866d3c-6978-4cf5-9586-642973f7c8b5', 'quantite': '1'}, {'ingredient_id': '6767326b-f330-48f4-b0ef-0a7010d74767', 'quantite': '560 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (173932, 'Bolon de verde (Equateur)', 'banane, fromage frais, beurre, huile, eau, sel', '30 min', ['Tout d’abord éplucher la peau des bananes. Ensuite couper chaque banane en 4 morceaux. Dans une marmite mettre 6 verres d’eau et les morceaux de la banane. Puis cuire à feu doux. Laisser faire bouillir les bananes pendant 30 min. ', 'Tout de suite, sortir les bananes de l’eau, et commencer à moudre les bananes jusqu’à ce qu’une pâte douce soit formée. Ajouter la moitié des petits morceaux de fromage et la cuillère à café de beurre et mélanger très bien avec cette pâte de banane. Pendant ce processus petit à petit ajouter le sel. ', 'Former ensuite avec les mains des boules de la taille d’une balle de tennis, faire un petit trou avec le doigt et avec l’autre moitié de morceaux de fromage vous devez les insérer dans les trous et après refermer soigneusement la boule avec le fromage au milieu.', 'Enfin, dans une poêle profonde verser l’huile et faire chauffer. Lorsque l’huile est chaude mettre “les bolones” à frire jusqu’à ce qu’ils soient dorés. ', 'Sortir les “bolones” de la poêle, et les servir dans une assiette. ', 'En Équateur, on mange les “bolones” avec une tasse de café.'], ['Planche à découper', 'Mixeur', 'Tire-bouchon', 'Poêle', 'Fouet'], ['', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'eau', 'testées', 'très facile', 'bon marché', 'plat', 'fromage frais', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'Bolon de verde (Equateur)', 'dessert', 'plat de résistance', 'beurre', 'cocktail'], 'Entrée', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:03:52.265809', [{'ingredient_id': 'd8f68da4-cccd-42f2-9801-7f5eeef78eb8', 'quantite': '3'}, {'ingredient_id': '668c6230-7ce6-42e4-8619-6fb5b94c94c4', 'quantite': '250 g'}, {'ingredient_id': 'e8bc9bea-c2d9-4688-b372-3736966eed1f', 'quantite': '1 cuillères'}, {'ingredient_id': '334c42bb-a113-4c64-9a06-8268788c32ae', 'quantite': ''}, {'ingredient_id': '1b85508a-cd27-4fc0-892f-e6be6c01fc34', 'quantite': '6'}, {'ingredient_id': 'f18fe887-a8be-4096-ac9b-65c8a64de4ad', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (232284, 'Crêpe de bananes (Tahiti)', 'banane, maïzena, sucre brun, huile', '5 min', ['Mixer les bananes épluchées avec la maïzena et le sucre jusqu''à obtention d''une pâte homogène.', 'Faire chauffer une cuillère à soupe d''huile dans une poêle et y verser de la pâte comme pour cuire un pancake.', 'Compte tenu de la composition de la pâte, il sera presque impossible de retourner la crêpe cuite à part en la faisant sauter.', 'Elle doit prendre une coloration très brune, comme une grillade.', 'Une fois qu''elle est cuite, la rouler sur elle-même  à l''aide d''une spatule (comme un rouleau de sushi) et la laisser refroidir dans une assiette (surtout pas de papier absorbant pour retirer l''excès éventuel d''huile car la crêpe collera dessus !).', 'Servir tiède. Délicieuse aussi avec une boule de glace à la vanille.'], ['Pince de cuisine', 'Verre doseur', 'Mixeur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'maïzena', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'sucre brun', 'dessert', 'plat de résistance', 'Crêpe de bananes (Tahiti)', 'cocktail'], 'Entrée', abcacb64-4f57-445a-9f1c-908e9e8d42cb, '2025-09-26T16:03:55.804146', [{'ingredient_id': 'aa6c4ec0-ce55-43c2-9681-871d8627297a', 'quantite': '8'}, {'ingredient_id': '9807c5c4-7702-42b1-be35-39424ceb2434', 'quantite': '4 cuillères'}, {'ingredient_id': '96a7ae4d-7175-4bab-8299-84cd001529e7', 'quantite': '2 cuillères'}, {'ingredient_id': '68e418a5-9e32-4d5b-85e5-31b876095eb5', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (326709, 'Confiture Abricots-Bananes', 'abricot, banane, citron, sucre', '45 min', ['Laver les abricots et les couper en morceaux dans une marmite.', 'Couper les bananes en rondelles fines (si l''on trouve les rondelles trop épaisses, les couper en 2 ou en morceaux).', 'Ajouter le jus de citron pour éviter les bananes de noircir et remuer.', 'Ajouter le sucre et remuer.', 'Laisser reposer 3 à 4 heures ou une nuit suivant disponibilité.', 'Cuire la confiture à feu moyen.', 'Retirer la mousse au fur et à mesure et remuer pour éviter d''attacher au fond de la marmite. ', 'Cuire pendant environ 55 min.', 'Une fois cuite, verser la confiture dans les pots à l''aide d''une louche et d''un entonnoir posé sur le pot pour éviter de se brûler.', 'Visser bien les couvercles et retournez les pots immédiatement sur un torchon. Laisser refroidir les pots pendant plusieurs heures avant de les ranger.'], ['Batteur électrique', 'Couteau de chef', 'Râpe', 'Planche à découper'], ['Confiture Abricots-Bananes', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'abricot', 'facile', 'bon marché', 'plat', 'recette', 'confiture d''abricot', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'citron', 'sucre', 'cocktail'], 'Confiserie', 932eb90a-0730-4cce-abc4-1d167afbf919, '2025-09-26T16:03:59.423594', [{'ingredient_id': 'bc3323c6-6c78-45e5-b46b-2adc00b80767', 'quantite': '3 kg'}, {'ingredient_id': 'ed99375b-3518-48cc-8da1-383c1c389fa7', 'quantite': '900 g'}, {'ingredient_id': '07c92545-cc72-4f29-9287-2831ed7858ba', 'quantite': '2'}, {'ingredient_id': '95677dda-93eb-4fc4-a99c-203a93d7e775', 'quantite': '1.7 kg'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (230172, 'Crumble BFS : Banane, Framboise & Spéculoos', 'banane, framboises, farine, sucre roux, beurre, amandes en poudre, sel, citron, spéculoos', '15 min', ['Pour la pâte à crumble : ', 'Dans un grand récipient, mettre le beurre, y ajouter le sucre roux et touiller avec une spatule pour ramollir le beurre. Y ajouter le sel. Arrêter de touiller avec la spatule et continuez à la main en ajoutant la farine dans sa totalité.', 'Personnellement, je ne conseille pas de faire une boule compacte, mais plutôt de modeler peu à peu le mélange en l''effritant entre les mains, afin d''obtenir une pluie de grumeaux.', 'Pour la préparation elle-même :', 'Commencer par préparer un bain marie, dans lequel vous disposerez le pot en verre de spéculoos. Faire mijoter à feu doux jusqu''à ce que la crème se liquéfie.', 'Pendant ce temps, couper en rondelles les bananes et les faire revenir à feu doux dans une poêle avec un petit peu de beurre de manière à légèrement les caraméliser. ', 'Les disposer dans un plat (au-préalablement beurré) et ce, de façon homogène avec les framboises.', 'Asperger le tout avec un peu de jus de citron. ', 'Lorsque la crème spéculoos est prête (assez fluide pour couler seule du pot), la verser sur les bananes et les framboises. Attention car le pot une fois sorti du bain marie est encore chaud.', 'Recouvrir ensuite le tout par la pâte crumble.', 'Mettre au four pendant 25 min à 180°C (thermostat 6).'], ['Économe', 'Batteur électrique', 'Fouet'], ['entrée', 'banane', 'Crumble BFS : Banane', 'recettes de cuisine', 'sel', 'confiserie', 'crumble banane', 'testées', 'facile', 'framboises', 'amandes en poudre', 'plat', 'Framboise & Spéculoos', 'recette', 'spéculoos', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'moyen', 'citron', 'beurre', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:04:03.388993', [{'ingredient_id': '82428ac2-53ac-4ddc-a41f-046c6558815d', 'quantite': '4'}, {'ingredient_id': '38232a22-d7dc-441a-a708-41eda7dda53d', 'quantite': '125 g'}, {'ingredient_id': '3be96462-ee1a-4b03-b604-2005bca2048b', 'quantite': '125 g'}, {'ingredient_id': '21cf6a05-b393-48d8-bc49-8a3829584ec3', 'quantite': '125 g'}, {'ingredient_id': '9b9cd424-4d16-4cea-82f5-c22b89994c35', 'quantite': '125 g'}, {'ingredient_id': 'd83550dd-fe70-4b99-a2ae-d5deec615c6b', 'quantite': '125 g'}, {'ingredient_id': '47c97643-26f5-4b40-845d-30b957afdd36', 'quantite': '2 g'}, {'ingredient_id': '3788677b-d86a-4b46-8284-6e1c8c882518', 'quantite': '1'}, {'ingredient_id': 'fb988de9-9b25-4916-86a2-5daabbfb4003', 'quantite': '400 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (60762, 'Banane au roquefort', 'banane, roquefort', '5 min', ['Préchauffer le four à 220°C (thermostat 7-8).', 'Laisser les bananes dans leur peau.', 'Entailler la peau sur toute la longueur sur le dessus puis retirer un peu de chair sur toute la longueur.', 'Farcir les bananes de roquefort, les disposer dans un plat et enfourner pour 10 minutes de cuisson.', 'Servir avec la peau.'], ['Mixeur', 'Casserole', 'Spatule', 'Fouet'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Banane au roquefort', 'dessert', 'plat de résistance', 'roquefort', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:04:07.248164', [{'ingredient_id': '8b0b8473-d208-43cb-9a2e-a1fe57413594', 'quantite': '4'}, {'ingredient_id': 'd6e9509e-9a13-44c1-bd8c-7b9e8c5d7e76', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (71981, 'Petit fondant au chocolat surprise', 'chocolat pâtissier, banane, crème fraîche liquide, Nutella, oeuf, beurre, farine, sucre', '25 min', ['Pour 6 ramequins', 'Préchauffez le four à 250°, thermostat 8. ', 'Faites fondre les 120 g de chocolat avec 2 cuillères à soupe de crème fraîche liquide et les 40 gr de beurre. Mélangez bien pour éviter les grumeaux. Une fois le mélangé liquide, ajoutez la banane coupée en fines tranches. Laissez cuire plus ou moins longtemps pour que la banane soit confite ou en morceaux.', 'Dans un saladier, mélangez les jaunes d’oeufs, le sucre et la farine. Incorporez-y le chocolat et mélangez à l’aide d’un fouet. ', 'Faites monter les blancs en neige avec un peu de sel. Une fois bien fermes, incorporez-les délicatement au mélange chocolaté.', 'Beurrez et farinez les ramequins. Versez-y la pâte au 3/4 , puis déposez une cuillère à café de Nutella, plus ou moins pleine selon l’envie .', 'Placez les ramequins au four 10 à 15 min. ', 'Dégustez les ramequins tièdes, démoulés ou non.'], ['Passoire', 'Mixeur', 'Balance de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Petit fondant au chocolat surprise', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'crème fraîche liquide', 'chocolat pâtissier', 'cuisine', 'recettes', 'boisson', 'farine', 'Nutella', 'dessert', 'fondant au chocolat', 'plat de résistance', 'beurre', 'sucre', 'cocktail'], 'Dessert', b2f92896-c875-459d-909e-7e644ca4e9be, '2025-09-26T16:04:10.903930', [{'ingredient_id': '92af811e-59ec-438e-98b9-1036d8a961f5', 'quantite': '120 g'}, {'ingredient_id': '19257301-6925-4f0f-86df-2d03f933a5c5', 'quantite': '1'}, {'ingredient_id': 'a0e671ca-d722-4afb-b1d3-461d855ecdb4', 'quantite': '1'}, {'ingredient_id': '855ea2d8-0eac-4077-9879-8569f377b9f5', 'quantite': '1'}, {'ingredient_id': '186b9fbc-5ba3-40f5-ae8a-7016b6604fb3', 'quantite': '3'}, {'ingredient_id': 'b5098c59-9cf9-4548-95bb-6c76d7320892', 'quantite': '40 g'}, {'ingredient_id': '3d7898bc-1aff-4459-94e9-9e8551371b0f', 'quantite': '20 g'}, {'ingredient_id': '9aa364dc-fbbf-402c-bae3-5b43d8fb3686', 'quantite': '60 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (70114, 'Tarte banane chocopépites', 'pâte sablée, compote, sucre en poudre, crème, oeuf, banane, cannelle, chocolat', '15 min', ['Préchauffez le four à 180°C (thermostat 6).', 'Mettez votre pâte sablée dans un moule à tarte après l''avoir préalablement graissé (beurre ou huile), ou utilisez la feuille de cuisson si c''est une pâte achetée. Piquez le fond de pâte à l''aide d''une fourchette.', 'Etalez la compote au fond de la tarte.', 'Fouettez la crème, l''oeuf et le sucre et verser sur la compote. ', 'Coupez les bananes en rondelles et déposez-les délicatement sur le mélange.', 'Saupoudrez de cannelle. Parsemez le tout de pépites de chocolat.', 'Mettez la tarte au four et laissez cuire pendant 25-30 min  (cela dépend des fours).'], ['Rouleau à pâtisserie', 'Râpe', 'Économe', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'facile', 'bon marché', 'pâte sablée', 'oeuf', 'plat', 'tarte à la banane', 'sucre en poudre', 'crème', 'recette', 'compote', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cannelle', 'Tarte banane chocopépites', 'cocktail'], 'Dessert', 88e40517-f88f-415d-b15d-4c4df553e470, '2025-09-26T16:04:14.702105', [{'ingredient_id': '3cca209e-8fbe-4a42-a5d0-ba0a207ade18', 'quantite': '1'}, {'ingredient_id': 'c6cdeec7-2774-4a47-a871-9a829695d432', 'quantite': '4 cuillères'}, {'ingredient_id': '13029b32-fc39-4f51-9002-d50b3272002d', 'quantite': '1 cuillères'}, {'ingredient_id': 'eed88371-e415-4fb2-bad5-efe16aae9972', 'quantite': '5 cuillères'}, {'ingredient_id': 'fa03eaba-0ec0-4eb4-a48f-2a811cf362a5', 'quantite': '1'}, {'ingredient_id': 'd9102049-fb01-4dc1-a170-5c9a6850a8ba', 'quantite': '2'}, {'ingredient_id': '9ad4cdd5-d2a3-4e89-b848-44405367cf57', 'quantite': ''}, {'ingredient_id': 'd40af69f-7877-45cd-b023-90d3dd672e7d', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (217623, 'Glace à la banane et au chocolat blanc', 'banane, chocolat blanc, sucre, lait entier, crème liquide', '20 min', ['Faire frémir le lait dans une casserole. ', 'Ajouter le chocolat blanc et le sucre puis bien battre au fouet afin d''homogénéiser le mélange. ', 'Laisser la préparation à feu moyen pendant 15 min tout en remuant régulièrement.', 'Pendant ce temps, mixer les bananes avec la crème liquide et ajouter cette préparation au mélange initial. ', 'Mélanger 2 min au fouet et laisser refroidir. ', 'Verser la préparation dans un moule et mettre au congélateur au moins 4h ou laisser prendre en sorbetière.'], ['Presse-agrumes', 'Casserole', 'Verre doseur', 'Moule à tarte', 'Pince de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'lait entier', 'rapide', 'plat', 'Glace à la banane et au chocolat blanc', 'recette', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'dessert', 'plat de résistance', 'chocolat blanc', 'sucre', 'glace à l''italienne', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:04:18.279908', [{'ingredient_id': 'cd017a14-cbac-4ef8-b852-81346e1d02a3', 'quantite': '3'}, {'ingredient_id': '8d7bf71a-99c4-48dd-b73f-cc3f03df11a7', 'quantite': '200 g'}, {'ingredient_id': '38bfb66c-efe9-4214-860d-5f405b8b1026', 'quantite': '150 g'}, {'ingredient_id': 'c2346ad4-f95b-432c-9793-81dac823ed21', 'quantite': '20 cl'}, {'ingredient_id': '54bc323f-6110-4785-8e19-ca590afcdffd', 'quantite': '30 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (48469, 'Coupe ananas', 'ananas, kiwi, clémentine, banane, coulis de fruits rouges, glace vanille, crème chantilly', '20 min', ['Couper l''ananas en deux dans le sens de la longueur (laisser les feuilles, c''est plus joli !).', 'Evider les demi-ananas.', 'Garder la chaire et la couper en petits dés.', 'Remettre les dés dans les coupes d''ananas.', 'Eplucher, couper les autres fruits et les mettre dans les coupes.', 'Faire des boules de glace et les poser sur les fruits.', 'Décorer de chantilly et napper de coulis aux fruits rouges.', 'Déguster.'], ['Balance de cuisine', 'Pince de cuisine', 'Louche'], ['', 'coulis de fruits rouges', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'Coupe ananas', 'boisson', 'crème chantilly', 'glace vanille', 'clémentine', 'dessert', 'plat de résistance', 'moyen', 'ananas', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:04:21.845694', [{'ingredient_id': '9bb44449-4de8-4a04-8e5e-e54489644a53', 'quantite': '1'}, {'ingredient_id': '48984763-2474-4e35-980d-34a7102087f7', 'quantite': '1'}, {'ingredient_id': '9d257707-452e-46ee-8dd6-d88afdd38ffc', 'quantite': '1'}, {'ingredient_id': '5484cfa8-f86f-4bfd-b0f7-37a74af0ade7', 'quantite': '1'}, {'ingredient_id': 'c8091e92-824c-4a4e-affe-f7c147836b07', 'quantite': ''}, {'ingredient_id': 'accb4765-f107-4804-8be4-0d19d9abb1ed', 'quantite': ''}, {'ingredient_id': 'e3ed3aeb-0074-42d8-8924-25cbc758c08f', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (38369, 'Compote de rhubarbe gourmande au four', 'rhubarbe, sucre semoule, sucre vanillé, banane, orange, Confiture de figue', '15 min', ['Laver les tiges de rhubarbe, les essuyer , ôter les fils et les couper en petits tronçons.', 'Verser la rhubarbe dans une terrine ou une cocotte allant au four. ', 'Ajouter le sucre, le sucre vanillé et le jus de l''orange (pour ceux qui adorent le côté acide de la rhubarbe, vous pouvez également ajouter le zeste de l''orange). Mélanger.', 'Refermer la terrine et la placer dans le four à 180°C (thermostat 6) pendant 30 minutes.', 'Au bout de 30 minutes, ajouter la banane coupée en tout petits bouts et la confiture de figue.', 'Replacer au four pour 10 minutes encore.', 'Sortir du four et laisser refroidir à découvert.'], ['Ouvre-boîte', 'Rouleau à pâtisserie', 'Presse-agrumes', 'Poêle'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'rhubarbe', 'bon marché', 'plat', 'recette', 'compote', 'cuisine', 'recettes', 'sucre semoule', 'boisson', 'Compote de rhubarbe gourmande au four', 'dessert', 'plat de résistance', 'sucre vanillé', 'orange', 'Confiture de figue', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:04:25.558160', [{'ingredient_id': '4fa14b2e-c0ca-432b-8da1-96e84d6d3768', 'quantite': '1 kg'}, {'ingredient_id': '38ab74bc-da20-4860-a8cd-c8e421929443', 'quantite': '150 g'}, {'ingredient_id': '45a2d636-9eaa-45f3-a0f7-c50224c99694', 'quantite': '1'}, {'ingredient_id': '8286574d-eaa5-4eab-876d-9b6573515500', 'quantite': '1'}, {'ingredient_id': '4af1b5f0-3e92-47ed-be50-b02797b5210f', 'quantite': '1'}, {'ingredient_id': '0a0079a9-da0c-4fec-9c05-922fec50730c', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (46918, 'Crumble de fruits à ma façon', 'pomme, poire, banane, coulis de framboise, farine, beurre, sucre', '10 min', ['Préchauffer votre four à 180°C (thermostat 6). ', 'Eplucher les fruits et les couper en morceaux dans un plat beurré. Verser le coulis de framboise dessus.', 'Préparer la pâte : dans un saladier, mélanger le sucre et la farine, puis ajouter le beurre ramolli. Malaxer du bout des doigts jusqu’à obtenir une pâte sableuse.', 'Disposer la pâte sur les fruits, et enfourner pendant 40 min en augmentant la température du four à 200°C (th 6-7).'], ['Presse-agrumes', 'Économe'], ['entrée', 'Crumble de fruits à ma façon', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'pomme', 'autres crumbles', 'beurre', 'sucre', 'cocktail', 'coulis de framboise'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:04:30.926609', [{'ingredient_id': '9972f332-12db-4185-a493-3843d38b1381', 'quantite': '3'}, {'ingredient_id': '841c8f0c-cfa1-4369-b44b-a15233a294b9', 'quantite': '3'}, {'ingredient_id': 'f59a0ac3-de3c-4249-a9c8-5ebbca10b718', 'quantite': '1'}, {'ingredient_id': 'd5118b3e-26d7-42e5-9e70-0f6eaff2a974', 'quantite': '1'}, {'ingredient_id': '01048959-368b-4ed7-a82c-541124b53a86', 'quantite': '150 g'}, {'ingredient_id': '4aa416f5-0d1a-4159-8d9d-57e4252f9a2a', 'quantite': '75 g'}, {'ingredient_id': 'fd1f4421-0a16-4af1-818f-afd7a700ce66', 'quantite': '120 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (83549, 'Cake chocolat et bonbons banane', 'farine, sucre, huile, levure, chocolat, sirop, bonbon, oeuf, sucre vanillé', '10 min', ['Chauffer le four à 160 °(thermostat 5)', 'Battre les oeufs entiers, ajouter le sucre, le sucre vanillé, la farine, l''huile, le demi sachet de levure et le sirop.', 'Faire fondre le chocolat au micro ondes et ajouter à la préparation.', 'Couper les bananes en deux et ajouter à la pâte.', 'Mettre du papier sulfurisé au fond du moule et laisser cuire environ 45 minutes.', 'La pointe du couteau doit sortir sèche.'], ['Fouet', 'Passoire', 'Batteur électrique', 'Presse-agrumes'], ['entrée', 'recettes de cuisine', 'bonbon', 'confiserie', 'testées', 'chocolat', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'huile', 'farine', 'autres cakes', 'dessert', 'plat de résistance', 'sucre vanillé', 'Cake chocolat et bonbons banane', 'sirop', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:04:35.902442', [{'ingredient_id': '2abc556f-e941-4103-be66-4cd0e029f9ec', 'quantite': '150 g'}, {'ingredient_id': 'cd255f67-6fb1-49a1-9ee6-ec170f30867a', 'quantite': '100 g'}, {'ingredient_id': '4dd3cd3b-6db7-4289-b448-c60884dec8b3', 'quantite': '10 cl'}, {'ingredient_id': '22e2fa8c-bf57-4e56-afb9-50d5e5535ff7', 'quantite': ''}, {'ingredient_id': '3f15fd7c-dc3f-4440-bc8c-93ec3a2d5d36', 'quantite': '100 g'}, {'ingredient_id': '2f428e8f-7f0b-4a36-92a2-877c86d93399', 'quantite': '2 cuillères'}, {'ingredient_id': '762c5f6f-d41f-4c5c-bb6b-2d88d6ed7441', 'quantite': '25'}, {'ingredient_id': '3892bacb-b138-4bb9-ac3c-14fdbcecad2b', 'quantite': '3'}, {'ingredient_id': 'b3504638-325a-4ede-986b-1cf51013cc78', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (58351, 'Banaourt', 'yaourt, banane, miel, fruits secs', '10 min', ['Mélanger les 4 yaourts et les deux bananes coupées en tranches dans un saladier.', 'Ajouter 4 cuillères à soupe de miel.', 'Bien mélanger.', 'Verser le tout dans un mixer.', 'Il faut que la préparation devienne homogène.', 'Répartir le mélange dans 4 bols, et ajouter des fruits secs selon le goût.'], ['Pince de cuisine', 'Ouvre-boîte', 'Verre doseur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'Banaourt', 'plat', 'fruits secs', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:04:41.877429', [{'ingredient_id': '6b6452ea-40a8-4590-993e-8b946d340eef', 'quantite': '4'}, {'ingredient_id': '1977ea42-a6fd-4ccc-ba62-ac855a2ac091', 'quantite': '2'}, {'ingredient_id': '75987f8c-34aa-4f18-8519-aeff9f791fcf', 'quantite': ''}, {'ingredient_id': 'abd79994-3ee3-40fa-839a-8d1a4ee8684f', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (309367, 'Cake au yaourt fraise banane', 'banane, yaourt, farine, sucre en poudre, oeuf, levure chimique', '20 min', ['Préchauffer le four à 180°C.', 'Battre les oeufs avec le sucre. ', 'Ajouter progressivement la farine, la levure et les deux yaourts. ', 'Écraser les bananes et les incorporer au mélange.', 'Verser le tout dans un moule (de préférence en silicone) et enfourner pendant 45 min à 180°C.'], ['Couteau de chef', 'Casserole', 'Rouleau à pâtisserie', 'Presse-agrumes', 'Planche à découper'], ['entrée', 'banane', 'Cake au yaourt fraise banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'levure chimique', 'facile', 'bon marché', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'autres cakes', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:04:45.583505', [{'ingredient_id': 'a038530f-8227-4770-93a3-6c54b335ccec', 'quantite': '2'}, {'ingredient_id': 'c9eda8db-71bd-4873-97a0-4ac83161f618', 'quantite': '2'}, {'ingredient_id': 'f98fd47e-0d61-4ba0-ba40-657ec5117d3c', 'quantite': '250 g'}, {'ingredient_id': '1c737e27-4cc8-49d9-b6bf-c3adcd9d0c9c', 'quantite': '125 g'}, {'ingredient_id': '0f55d705-8ef6-47a3-a61e-425f2ea8186f', 'quantite': '3'}, {'ingredient_id': '90ac3756-7586-46f1-ba0c-b69428a23fc9', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (54409, 'Bananes au citron vert', 'banane, eau, sucre, orange, citron vert', '30 min', ['Porter l''eau et le sucre à ébullition, laisser légèrement réduire. ', 'Retirer de la plaque, attendre que le liquide soit tiède. ', 'Râper finement le zeste d''orange et des citrons verts, presser leur jus.', 'Ajouter au sirop de sucre. ', 'Mettre au frais.', 'Quand le jus est froid, couper finement des rondelles de bananes dedans. ', 'Remettre au frais quelques heures.'], ['Louche', 'Verre doseur', 'Mixeur', 'Batteur électrique', 'Couteau de chef'], ['', 'entrée', 'banane', 'recettes de cuisine', 'Bananes au citron vert', 'confiserie', 'eau', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'orange', 'citron vert', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:04:49.172120', [{'ingredient_id': 'ea3161bf-4fbf-404a-ac38-ca3d394f1566', 'quantite': '4'}, {'ingredient_id': '3ade4ba1-59b0-4c26-8b19-5fdd19456709', 'quantite': '30 cl'}, {'ingredient_id': '4b262189-9507-4a62-8431-ace52c4506fe', 'quantite': '120 g'}, {'ingredient_id': '5c2033e8-7ed1-4a46-b297-7d8b32ef1e07', 'quantite': '1'}, {'ingredient_id': 'd80076e3-b26f-4913-8d4a-8ecbd36ead27', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (58439, 'Tiramisu saveur exotique', 'mangue, banane, ananas, framboises, sucre, boudoir, fruits exotiques, oeuf, mascarpone, yaourt nature, rhum', '30 min', ['Commencer par mettre de côté quelques framboises pour la décoration à la fin.', 'Eplucher et couper les fruits en petits cubes : la mangue, l''ananas et les bananes.', 'Mélanger avec la cuillère à soupe de rhum.', 'Pour le coulis :', 'Ecraser 150 g (c''est-à-dire une barquette et demie) de framboises avec 20 g de sucre pour obtenir un coulis.', 'Pour la crème :', 'Séparer les blancs des jaunes.', 'Battre au fouet les 2 jaunes d''oeufs avec 50 g de sucre.', 'Monter les blancs en neige.', 'Mélanger ensemble les jaunes, les blancs, le mascarpone, le yaourt.', 'Pour chaque verre :', 'Tremper – pas longtemps ! – les biscuits dans le jus de fruits en s''aidant de cuillères et spatules pour ne pas qu''ils partent en miettes.', 'Verser dans le fond du verre le coulis de framboises.', 'Alterner une couche de crème, 2 biscuits coupés en 2 ou 3 morceaux (pour adapter à la forme du verre), couche de crème, couche de fruits, couche de crème.', 'Mettre au frigo pendant au moins 24 heures.', 'Au dernier moment, décorer de quelques framboises que vous aurez gardé.'], ['Poêle', 'Presse-agrumes', 'Rouleau à pâtisserie', 'Couteau de chef', 'Planche à découper'], ['entrée', 'banane', 'recettes de cuisine', 'mascarpone', 'rhum', 'confiserie', 'testées', 'yaourt nature', 'framboises', 'bon marché', 'rapide', 'oeuf', 'plat', 'mangue', 'moyenne', 'fruits exotiques', 'recette', 'cuisine', 'recettes', 'boisson', 'Tiramisu saveur exotique', 'dessert', 'plat de résistance', 'tiramisu', 'ananas', 'boudoir', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:04:52.811162', [{'ingredient_id': '41dcd858-f350-4687-ba8b-5ebef96b9259', 'quantite': '1'}, {'ingredient_id': '87c20cf7-c2bd-49cb-9a3b-71a24b5decf2', 'quantite': '2'}, {'ingredient_id': '5e9866f0-6844-4e55-9991-da66a8607bcf', 'quantite': '1'}, {'ingredient_id': 'f6677510-6294-498b-92c2-761ee1b6be54', 'quantite': '200 g'}, {'ingredient_id': '1aab0706-c523-404c-941d-5432c7512240', 'quantite': '70 g'}, {'ingredient_id': 'bac48a0a-e09c-40ec-a5b9-6a7f7f1079d5', 'quantite': '12'}, {'ingredient_id': 'b70370dd-ff3a-4367-a8b9-1ae7527cbdea', 'quantite': '60 cl'}, {'ingredient_id': 'b4449aa8-f922-4b3f-86b7-6acae17d2c3c', 'quantite': '2'}, {'ingredient_id': '01e9ecbe-345c-4f9f-81cb-7bfa3ef7d2c0', 'quantite': '200 g'}, {'ingredient_id': '4735f177-7082-4cb1-bc71-bf39562c9bf4', 'quantite': '125 g'}, {'ingredient_id': '7b2fd9f9-0715-4741-92ae-e1c19e5b8596', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (308800, 'Ma tarte trois chocolats et banane', 'chocolat noir, chocolat au lait, chocolat blanc, farine, oeuf, banane, beurre, sucre glace, crème liquide, mascarpone, sucre en poudre, cacao, sel', '30 min', ['Dans un saladier, réaliser la pâte à tarte au chocolat. Mélanger le chocolat fondu, le beurre mou, le sucre glace, les 2 jaunes d’œufs, la farine, le sel. ', 'Bien malaxer et mettre au frais 30 min. L''étaler dans un moule à tarte.', 'Cuire 12 à 15 minutes au four. Vérifier que la pâte est cuite avant de la sortir.', 'Dans deux petits saladiers, faire fondre le chocolat blanc et le chocolat au lait avec dans chacun 7,5 cl de crème. Mélanger et mettre au frais 30 minutes.', 'Mélanger le mascarpone, le sucre en poudre et les blancs battus en neige. ', 'Sur le fond de tarte, disposer la ganache au chocolat blanc, des rondelles de bananes, la ganache au chocolat au lait, un chou de crème au mascarpone et saupoudrer de cacao en poudre.'], ['Balance de cuisine', 'Batteur électrique', 'Verre doseur', 'Poêle', 'Couteau de chef'], ['chocolat au lait', 'entrée', 'banane', 'recettes de cuisine', 'mascarpone', 'sel', 'confiserie', 'testées', 'Ma tarte trois chocolats et banane', 'facile', 'bon marché', 'cacao', 'oeuf', 'plat', 'tarte à la banane', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'farine', 'dessert', 'plat de résistance', 'chocolat noir', 'beurre', 'chocolat blanc', 'sucre glace', 'cocktail'], 'Dessert', d1d5a164-b0cb-41e0-a1b7-68a061ef425c, '2025-09-26T16:04:56.591172', [{'ingredient_id': '6c67f531-e041-44c4-8a7b-49fd4530c4f5', 'quantite': '100 g'}, {'ingredient_id': 'cda31494-06d3-4007-8d4e-2da4e01f6b0e', 'quantite': '100 g'}, {'ingredient_id': '734196fa-84df-4c10-b231-ebec4b7a4829', 'quantite': '100 g'}, {'ingredient_id': 'e6ddfa62-683a-4824-a9a5-94731222c26b', 'quantite': '300 g'}, {'ingredient_id': 'dbbd40f0-6959-4c24-bdac-88f43fdbd9c0', 'quantite': '2'}, {'ingredient_id': '1bc30558-2938-4a59-bab7-1e76f9b374fd', 'quantite': '2'}, {'ingredient_id': 'be0be457-b778-4597-9f90-04dafbde5b50', 'quantite': '100 g'}, {'ingredient_id': '86c6d90f-d685-4a8d-9322-32e28e74d99d', 'quantite': '50 g'}, {'ingredient_id': 'dd5930ca-1b5a-4190-9849-c868fdd1ef7e', 'quantite': '15 cl'}, {'ingredient_id': '4f476b5a-b596-44f3-a736-79cb36aa4f24', 'quantite': '100 g'}, {'ingredient_id': 'a13f0433-8c0c-4b06-89c2-49cf5729aab1', 'quantite': '2 cuillères'}, {'ingredient_id': '77732a9d-4a73-4a30-b5d1-09201bd9f229', 'quantite': '1 cuillères'}, {'ingredient_id': '7b0b0ba6-39bf-4b14-98be-f16f25e1e780', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (14953, 'Smoothie (USA)', 'fruits, banane, jus de pomme, kiwi', '5 min', ['Peler les fruits. Les couper en morceaux', 'Mixer le tout. Voilà. C''est prêt.', 'Cet épais jus de fruit est parfait au petit déjeuner ou fait un excellent goûter, peu calorique et plein de vitamines.'], ['Casserole', 'Fouet'], ['entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'Smoothie (USA)', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'jus de pomme', 'plat de résistance', 'fruits', 'smoothies', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:05:00.269887', [{'ingredient_id': 'bc1f42a4-964a-40cb-a457-b859e2b6075e', 'quantite': '300 g'}, {'ingredient_id': '606c03e4-a060-4a75-a0d1-42e861ce6fab', 'quantite': '4'}, {'ingredient_id': 'c8dab63f-183d-4046-90d7-6ddf381a19ee', 'quantite': ''}, {'ingredient_id': 'b8f51d05-c63a-42e1-acdd-eeafe3bd2db9', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (12825, 'Véritable moelleux au chocolat', 'farine, beurre doux, sucre semoule, chocolat noir, oeuf, levure', '10 min', ['Préchauffer le four à 180°C (thermostat 6).

Faire fondre le chocolat dans une casserole.', 'Hors du feu, ajouter le beurre, ', 'la farine et la levure.', 'Fouetter les jaunes d’oeuf avec le sucre', 'et un peu d''eau pour faire mousser', 'puis l''ajouter à la préparation chocolatée.', 'Battre les blancs en neige et les incorporer dans la casserole tout doucement.', 'Verser le tout dans un moule beurré à bords hauts', 'et enfourner pendant environ 35 minutes.', 'On peut ajouter du sucre glace ou du chocolat fondu, pour décorer le dessus du gâteau.', 'Déguster'], ['Poêle', 'Fouet'], ['entrée', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'Véritable moelleux au chocolat', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'sucre semoule', 'boisson', 'farine', 'dessert', 'plat de résistance', 'chocolat noir', 'beurre doux', 'gâteau au chocolat', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:05:07.243989', [{'ingredient_id': '28f65a5d-658d-4f83-b885-1c8e5f2874b9', 'quantite': '125 g'}, {'ingredient_id': 'd58666f3-fb17-416e-be2e-f008e414d13e', 'quantite': '125 g'}, {'ingredient_id': 'c8a16d53-42cc-4d8c-ab85-cf34359437c8', 'quantite': '250 g'}, {'ingredient_id': 'edead0f0-a8cf-443c-a794-dc912f741ac0', 'quantite': '200 g'}, {'ingredient_id': 'd87776b8-7fc3-4d4c-a0b0-6d060c23c9cf', 'quantite': '4'}, {'ingredient_id': '56575f3c-1660-4a59-b40c-15ee71f39a3a', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (26776, 'gratin de pâtes au petit suisse', 'macaroni, petit suisse, banane, tomate, jambon, gruyère râpé, persil', '10 min', ['Pendant que vous faites cuire les pâtes, tranchez les tomates et les bananes et coupez le jambon en carrés. ', 'Une fois les pâtes cuites, versez-en la moitié dans un plat à gratin préalablement beurré ; disposez les tranches de banane et de tomate, les carrés de jambon les petit suisse en couche. Recouvrez avec le reste de pâtes. Parsemez de gruyère râpé et de persil haché. ', 'Enfournez 20 mn à thermostat 6 (180°C).'], ['Passoire', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'jambon', 'gratin de pâtes au petit suisse', 'confiserie', 'petit suisse', 'testées', 'très facile', 'bon marché', 'tomate', 'plat', 'recette', 'macaroni', 'cuisine', 'recettes', 'boisson', 'gruyère râpé', 'dessert', 'persil', 'plat de résistance', 'gratin de pâtes', 'cocktail'], 'Plat principal', 461691bb-468d-4347-bedc-85ba3635b0f9, '2025-09-26T16:05:10.854840', [{'ingredient_id': 'feeeb43d-47f7-452e-8c72-b19b9f88b700', 'quantite': '400 g'}, {'ingredient_id': 'ae7edd86-b416-4e26-a2a7-a0bef594823e', 'quantite': '4'}, {'ingredient_id': 'e6fe437b-46cb-498f-8ebc-321ab4b064e3', 'quantite': '2'}, {'ingredient_id': '6e346596-f4f6-4752-9c38-67b070674ab4', 'quantite': '2'}, {'ingredient_id': '319ca7b9-8a50-4b3e-9a5f-2447cc06aada', 'quantite': '4'}, {'ingredient_id': '1ca94ec8-4f2f-4aa1-be5a-1e47028ee3b8', 'quantite': ''}, {'ingredient_id': '1925ce02-206d-4867-bd94-cb85fa8804fc', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (528995, 'Smoothie bowl banane chocolat', 'banane, cacao en poudre, lait d''amande, granola, cacahuètes, pépites de chocolat', '5 min', ['La veille, couper une banane en morceaux et la laisser 1 nuit au congélateur.', 'Placez les rondelles de banane dans le bol d''un robot mixeur puis ajoutez le lait d''amande, le cacao.', 'Mixer jusqu''à obtenir un smoothie lisse et homogène', 'Verser le smoothie dans un bol, couper la deuxième banane en rondelles. La disposer au milieux du bol.', 'Ajouter le granola, les pépites de chocolat, les cacahuètes.', 'C''est prêt !'], ['Fouet', 'Balance de cuisine', 'Râpe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'Smoothie bowl banane chocolat', 'cacao en poudre', 'testées', 'lait d''amande', 'cacahuètes', 'Granola', 'très facile', 'granola', 'bon marché', 'rapide', 'plat', 'pépites de chocolat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T16:05:14.472872', [{'ingredient_id': '24c265d2-ce24-4a98-8912-1362cd8e6b78', 'quantite': '2'}, {'ingredient_id': '5b20e2ea-b21b-416c-9f59-09e3331ac10b', 'quantite': '2 cuillères'}, {'ingredient_id': '89f46578-6c35-48ec-80ea-a93b7e2e4756', 'quantite': '75 ml'}, {'ingredient_id': '17569508-dbff-41f1-9131-6edfa4a4c29c', 'quantite': '1'}, {'ingredient_id': '029a82f2-049e-4024-9a09-fb7072ea5ff6', 'quantite': '1'}, {'ingredient_id': '0cc1364b-0606-45fd-be7c-e8332b42c1a3', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (169123, 'Tarte chocolat banane', 'pâte brisée, banane, beurre, chocolat noir, crème liquide, sucre glace, jaune d''oeuf', '20 min', ['Déposer la pâte sur le moule, à l''aide du fourchette faire quelques petits trous.', 'Réduire 2ou 3 bananes (en fonction de leurs tailles) en purée, et disposer ''''cette purée" dans le moule.', 'Ensuite faire fondre le chocolat avec le beurre en incorporant 5cl de crème liquide, et laisser refroidir.', 'Pendant ce temps dans un bol fouetter le jaune d''œuf avec la crème liquide et le sucre glacé.', 'Disposer le chocolat sur la purée de banane, et pour terminer verser la crème liquide  sur le chocolat avant d''enfourner.', 'Vérifier la cuisson a peu prés 20 minutes en fonction de la puissance de votre four.', 'Servir Froid.'], ['Balance de cuisine', 'Rouleau à pâtisserie', 'Planche à découper', 'Louche', 'Presse-agrumes'], ['entrée', 'tarte au chocolat', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'plat', 'jaune d''oeuf', 'recette', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'crème liquide', 'dessert', 'plat de résistance', 'chocolat noir', 'beurre', 'sucre glace', 'cocktail', 'Tarte chocolat banane'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:05:18.144008', [{'ingredient_id': '982c102b-8710-4fd6-b77b-80e5c44a56b0', 'quantite': '1'}, {'ingredient_id': '882df9a7-92e9-49e0-86ff-71578ea7a405', 'quantite': '5'}, {'ingredient_id': 'a394a398-25f5-45c0-bd98-cb49fc2281b1', 'quantite': '30 g'}, {'ingredient_id': 'cf1a4488-370b-4a63-81b0-9c67324e0c44', 'quantite': '65 g'}, {'ingredient_id': 'b8ea0fc0-25e2-406e-a81e-eb08760f94b4', 'quantite': '10 cl'}, {'ingredient_id': 'f704debc-ca34-4aff-a000-47b0457b6ef7', 'quantite': '30 g'}, {'ingredient_id': '54f328a6-a9b7-4896-b3ce-9c3eae3b82af', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (12042, 'Cake à la banane / banana bread (USA)', 'farine, sucre, levure chimique, bicarbonate, sel, banane, beurre, lait, oeuf', '30 min', ['Préchauffer le four à 165° C (thermostat 5-6). 
Mélanger 150 g de la farine avec le sucre, la levure chimique, le bicarbonate et le sel. ', 'Ajouter les bananes écrasées, ainsi que le beurre et le lait. ', 'Battre (de préférence avec un mixeur) doucement, jusqu''à l''obtention d''une pâte homogène, puis vigoureusement 2 min.', 'Ajouter les oeufs et le reste de la farine,', 'et bien mélanger.', 'Graisser le fond d''une moule à cake, et y verser la pâte.', 'Faire cuire au four à 165°C pendant 55 à 60 min (vérifier la cuisson).', 'Peut être glacé avec un glaçage à base de fromage blanc ou de crème fraîche.'], ['Tire-bouchon', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'levure chimique', 'Cake à la banane / banana bread (USA)', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'autres cakes', 'dessert', 'plat de résistance', 'beurre', 'sucre', 'lait', 'cocktail', 'bicarbonate'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:05:24.897154', [{'ingredient_id': 'bc6df148-fca7-4343-92e8-fecb46c1397a', 'quantite': '250 g'}, {'ingredient_id': '69e72087-7b9b-4607-bdfa-ee068043343f', 'quantite': '160 g'}, {'ingredient_id': '0398dc9d-a161-45e8-a05c-c7db1df1576f', 'quantite': '2 cuillères'}, {'ingredient_id': '9d48a9fe-76de-4c49-b9d5-3f629ef2626a', 'quantite': ''}, {'ingredient_id': '9c0ce4f3-79c2-416c-ad47-82f27abed0da', 'quantite': '1'}, {'ingredient_id': 'ce42e89d-78f9-4120-85ad-42a9f642847a', 'quantite': '2'}, {'ingredient_id': 'dd2dcf53-dbc5-4cd2-8b4b-0e8f22b2de7b', 'quantite': '85 g'}, {'ingredient_id': '61c6e532-fa47-41d4-ad2d-bf3f89bb9b05', 'quantite': '2 cuillères'}, {'ingredient_id': '1ccb2272-dc22-4b7c-9e8a-7e2b47471522', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (309781, 'Smoothie Mango Tango', 'mangue, banane, yaourt nature, fruits, glaçons', '5 min', ['Mélanger le tout en coupant les mangues en gros dés et la banane en rondelles. ', 'Ajouter les yaourts, les glaçons et le jus de fruits (à voir selon l''onctuosité que l''on désirée).'], ['Passoire', 'Poêle'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'yaourt nature', 'facile', 'bon marché', 'rapide', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'Smoothie Mango Tango', 'boisson', 'dessert', 'plat de résistance', 'glaçons', 'fruits', 'smoothies', 'cocktail'], 'Boisson', c793f55f-04fd-4969-b96a-49bd7ce4aad3, '2025-09-26T16:05:29.315552', [{'ingredient_id': 'eeeff8cd-27b8-46a0-8cee-54307684efe2', 'quantite': ''}, {'ingredient_id': '8097dbf3-401b-423a-80fc-6fee188925a8', 'quantite': '1'}, {'ingredient_id': 'b749067f-8422-4dca-8cd7-96a56053901e', 'quantite': '2'}, {'ingredient_id': 'f0b74b0e-5669-4989-9483-aa0cfdb8989d', 'quantite': '15 cl'}, {'ingredient_id': 'c7390ab6-1b50-453f-a0b3-7abab80a1ea9', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (16482, 'Crème à la banane', 'crème fraîche, banane, citron, sucre vanillé', '10 min', ['Passez les bananes au mixer. Battez ensuite la crème fraîche avec le sucre vanillé, ajoutez-la aux bananes.', 'Arrosez le tout du jus de citron. Mettez au frais 1 à 2 heures.'], ['Spatule', 'Poêle', 'Rouleau à pâtisserie', 'Économe'], ['', 'Crème à la banane', 'banane', 'entrée', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'citron', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:05:32.924685', [{'ingredient_id': '6e921286-be4b-402d-8fb5-b3af5f1240e5', 'quantite': '25 cl'}, {'ingredient_id': 'b29f39b4-dd9a-466e-8ce4-6e1c479484da', 'quantite': '1'}, {'ingredient_id': 'f26c9355-c7ce-4fac-a4a0-289f8d50e1de', 'quantite': ''}, {'ingredient_id': '7fd30685-147e-44f4-ab44-8136e9d43a9a', 'quantite': '7.5 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (29057, 'omelette flambée aux bananes et aux rhum.', 'oeuf, banane, rhum, sucre', '5 min', ['Dans une assiette coupez les bananes en lamelles, versez le sucre et un demi-bouchon de rhum dessus et laissez bien pénétrer 3 mn. ', 'Mélangez-les un peu et faites chauffer une poêle avec un filet d''huile. Mettez les bananes dedans et faites-les cuire à feu doux jusqu''à qu''elles prennent une teinte légèrement dorée. ', 'Dans un saladier battez les oeufs et versez-les dans la poêle. Faites chauffer 3 à 5 mn jusqu''à ce qu''il n''y ait plus de résidu liquide sur le dessus de l''omelette. ', 'Prenez une assiette et à l''aide de celle-ci retournez l''omelette. Faites encore chaufer 1 à 2 mn. ', 'Versez le reste du rhum sur l''omelette et faites-la flamber à l''aide d''une alumette, attendez que la flamme soit éteinte, et dégustez lorsque c''est encore chaud.'], ['Économe', 'Louche', 'Mixeur', 'Couteau de chef'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'omelette flambée aux bananes et aux rhum.', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:05:36.445782', [{'ingredient_id': '6b8ac05a-ae07-404d-98d6-5e0941eb4743', 'quantite': '4'}, {'ingredient_id': 'd431a73f-281a-4eaa-a007-1720a74d8511', 'quantite': '2'}, {'ingredient_id': 'b73382d4-f1bf-4056-97e6-9a01b64368e1', 'quantite': '2'}, {'ingredient_id': '9fb252e3-bc5c-42b6-9a1f-ff0febfa4318', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (315720, 'Nems à la banane et au Nutella', 'banane, guimauve, Nutella, brick, sucre glace, beurre', '15 min', ['Préchauffer le four à 210°C (thermostat 7)', 'Éplucher les bananes et les couper en deux, puis les recouper en deux dans le sens de la longueur.', 'Faire fondre le Nutella au bain-marie pendant quelques minutes pour le détendre.', 'Disposer la feuille de brick à plat sur le plan de travail, la tartiner d''un peu de Nutella fondu aux extrémités, ajouter deux morceaux de banane et un nounours, puis la rouler en rabattant les bords, comme pour faire un nem.', 'Répéter l''opération avec le reste des ingrédients.', 'Badigeonner les petits rouleaux de beurre fondu, les placer sur la plaque du four tapissée de papier cuisson et enfourner pour 10 à 12 min : ils doivent être bien dorés.', 'Saupoudrer de sucre glace et déguster aussitôt.'], ['Moule à tarte', 'Balance de cuisine', 'Fouet', 'Poêle'], ['guimauve', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'Nems à la banane et au Nutella', 'rapide', 'plat', 'nems', 'recette', 'cuisine', 'brick', 'recettes', 'boisson', 'Nutella', 'dessert', 'plat de résistance', 'moyen', 'beurre', 'sucre glace', 'cocktail'], 'Amuse-gueule', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:05:40.079425', [{'ingredient_id': '1218e85b-9893-4558-a299-33b3b2374b00', 'quantite': '2'}, {'ingredient_id': '59abae1b-a74b-4930-b201-a9e9d9ec4d09', 'quantite': '4'}, {'ingredient_id': '1493f2ab-9a7a-46bd-82d5-24e5db965382', 'quantite': '4 cuillères'}, {'ingredient_id': '6a01f193-82da-46d8-aa6b-291de028c729', 'quantite': '4'}, {'ingredient_id': '8f4dbb66-8c16-4f63-bc40-5466bd887b88', 'quantite': '2 cuillères'}, {'ingredient_id': 'ba859eb2-f09a-431f-bc8a-521275e61fc4', 'quantite': '10 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (334872, 'Gâteau roulé cacao à la crème de banane', 'oeuf, sucre en poudre, sucre vanillé, farine, cacao, beurre, levure chimique, banane, gélatine, mascarpone', '40 min', ['Préchauffer le four à 200°C (thermostat 6-7). ', 'Battre les oeufs dans un grand saladier avec un fouet électrique. Ajouter le sucre et le sucre vanillé et continuer à battre pendant 3 à 4 minutes jusqu’à obtention d’un mélange mousseux et blanchi.', 'Incorporer la farine, la levure et le cacao et mélanger avec une spatule, délicatement. Ajouter le beurre fondu (mais pas chaud), verser la préparation sur le tapis préalablement placé sur la grille du four et bien étendre la pâte avec une corne de pâtissier (ou une spatule souple).', 'Introduire la grille avec le tapis dans le four et faire cuire pendant 12 minutes, jusqu’à ce que les bords du biscuit se détachent des bords du moule. Retirer du four et laisser refroidir.', 'Pendant ce temps mettre la gélatine à tremper dans de l’eau froide. Mixer 6 bananes et les faire chauffer à feu doux. Quand son contenu est chaud, essorer la gélatine avec ses mains et l’incorporer dans les bananes en mélangeant pour la faire fondre.', 'Laisser refroidir jusqu’à température ambiante tout en faisant attention que la gélatine ne prenne pas, donc en remuant.', 'Couper les deux bananes restantes en dés et les réserver.', 'Battre le mascarpone au fouet électrique dans un saladier. Ajouter la purée de bananes froide et continuer à battre jusqu’à obtenir un mélange homogène. Réserver (à température ambiante) environ deux grosses cuillères à soupe de ce mélange.', 'Ajouter les dés de bananes et mélanger délicatement avec une spatule. ', 'Couvrir le biscuit avec la crème de banane préparée. L’enrouler avec l’aide du tapis (ou du papier cuisson), couper les entames et le placer sur un plat de service.', 'Étaler le reste de crème réservée dessus, décorer et laisser refroidir au réfrigérateur.'], ['Tire-bouchon', 'Couteau de chef', 'Rouleau à pâtisserie'], ['entrée', 'recettes de cuisine', 'Gâteau roulé cacao à la crème de banane', 'confiserie', 'testées', 'levure chimique', 'facile', 'bon marché', 'cacao', 'rapide', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'gâteau à la banane', 'beurre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:05:43.849402', [{'ingredient_id': 'baa4710b-42ab-47bb-95ad-61869264dc17', 'quantite': '4'}, {'ingredient_id': '1c10c624-8f44-4921-aadb-6a00436a0301', 'quantite': '95 g'}, {'ingredient_id': '8df6da12-774c-4759-b2b7-56439fa79530', 'quantite': '1 cuillères'}, {'ingredient_id': 'e765b1e7-8197-49a6-8416-56f1fc2f36c5', 'quantite': '80 g'}, {'ingredient_id': '5f510a82-2985-4e29-a0a1-aa1d4eac037a', 'quantite': '15 g'}, {'ingredient_id': '2e5673e5-6750-4f4f-a0de-7378ee2dc8f6', 'quantite': '45 g'}, {'ingredient_id': '222063aa-8039-42aa-acdc-68b386a5fef1', 'quantite': ''}, {'ingredient_id': '96987cd7-181e-4452-827b-2bf5362a33e3', 'quantite': '8'}, {'ingredient_id': '45b418b9-eb02-442f-bb4d-08927e8ecf31', 'quantite': '3'}, {'ingredient_id': '3c43a54f-7894-48ee-9f9a-4c3731add08e', 'quantite': '500 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (337957, 'Porc au poisson et à la banane', 'haddock, échine de porc, banane, purée de piment, poivre, épinards, beurre salé', '5 min', ['Faites d''abord cuire une face des côtes de porc dans une poêle avec du beurre.', 'Retournez la côte, ajoutez les filets de poisson, les bananes en fines lamelles, le poivre et encore du beurre.', 'Retournez tout, ajoutez la purée de piment et du beurre.', 'En fin de cuisson, ajoutez les épinards et du beurre', 'Le secret du chef : faites bien revenir les bananes dans le gras du porc et le beurre, et réservez-les sans les mélanger aux épinards.'], ['Ouvre-boîte', 'Tire-bouchon', 'Passoire', 'Spatule', 'Casserole'], ['', 'entrée', 'banane', 'recettes de cuisine', 'échine de porc', 'confiserie', 'testées', 'facile', 'beurre salé', 'bon marché', 'Porc au poisson et à la banane', 'plat', 'épinards', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'purée de piment', 'haddock', 'poivre', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:05:47.604093', [{'ingredient_id': 'dd91585e-aa00-4814-8ede-e4ec5601333e', 'quantite': '4'}, {'ingredient_id': 'd0aa957e-ac3b-4f60-a513-4393385da84e', 'quantite': '2'}, {'ingredient_id': '9a750a3f-77e1-425b-8803-a369fc06d2c6', 'quantite': '4'}, {'ingredient_id': '80ee5eac-7a73-4730-8784-b528d9f8ff2e', 'quantite': ''}, {'ingredient_id': '4b70f736-1a33-4355-88cc-315861f4db9c', 'quantite': ''}, {'ingredient_id': 'fe891067-1374-4e19-ac15-d5d1d49a7ecd', 'quantite': '1'}, {'ingredient_id': '4155e59d-303b-4b25-9b96-53f984d31da3', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (228620, 'Banana Split aux Carambars', 'banane, crème liquide, glace vanille, glace, carambar©, miel, crème chantilly, noisettes, cacao, citron', '5 min', ['Éplucher les bananes. Dans un récipient, les couper en rondelles et les citronner. Les réserver au frais.', 'Dans une petite casserole, verser la crème fraîche, ajouter les carambars et faire fondre à feu moyen. Ajouter le miel et bien mélanger. Garder la sauce caramel au chaud.', 'Verser 2 cuillères à soupe de sauce caramel au fond de 4 grandes verrines, déposer les rondelles de bananes, ajouter 1 boule de glace vanille et 1 de caramel.', 'Verser une nouvelle fois de la sauce caramel, remplir de chantilly et saupoudrer de noisettes hachées.'], ['Économe', 'Planche à découper', 'Batteur électrique'], ['entrée', 'banane', 'recettes de cuisine', 'Banana Split aux Carambars', 'confiserie', 'testées', 'banana split', 'facile', 'bon marché', 'cacao', 'rapide', 'plat', 'recette', 'noisettes', 'cuisine', 'miel', 'recettes', 'boisson', 'crème chantilly', 'crème liquide', 'glace vanille', 'glace', 'carambar©', 'dessert', 'plat de résistance', 'citron', 'cocktail'], 'Dessert', 371bb551-3d61-4777-a9d8-a445befdc6ec, '2025-09-26T16:05:52.071221', [{'ingredient_id': 'a5028cdc-7e69-48d0-90f3-53d4d00e220c', 'quantite': '4'}, {'ingredient_id': 'e6616825-6f04-4a02-99a0-b05e0532497e', 'quantite': '20 cl'}, {'ingredient_id': '7d28730a-9917-4ebe-8363-950bf6b3e7ec', 'quantite': '4'}, {'ingredient_id': 'e20d4ad8-cec5-4a45-b927-cfa3e03be220', 'quantite': '4'}, {'ingredient_id': 'fa601979-9cb2-42c6-a00b-32bad31b7340', 'quantite': '16'}, {'ingredient_id': '1f2783ff-ac07-4126-abd3-ca57ea9d6930', 'quantite': '2 cuillères'}, {'ingredient_id': 'd9b493ae-2bdd-40b4-86b4-9d32f691fb92', 'quantite': '1'}, {'ingredient_id': 'c9a9d492-5e6d-46ea-8511-addbe472bc94', 'quantite': '20 g'}, {'ingredient_id': '9623f3e5-b5de-4914-844a-72f40e6e188a', 'quantite': '1 cuillères'}, {'ingredient_id': '616c30f0-7fe4-474e-b637-21d7334b3379', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (83725, 'Beignets de banane miélés aux pistaches', 'banane, pistaches, brique, jaune d''oeuf, miel', '10 min', ['Coupez les bananes en 2 ainsi que les feuilles de briques,', 'enroulez les bananes dans la feuille de brique, collez grâce au jaune d''oeuf.', 'Mettrez du miel à chaque extrémité de la feuille de brique', 'puis trempez dans les pistaches mises dans un bol.', 'Enfournez pendant 25 min dans un four chaud a 180°(thermostat 6)'], ['Passoire', 'Couteau de chef'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Beignets de banane miélés aux pistaches', 'facile', 'bon marché', 'plat', 'jaune d''oeuf', 'pistaches', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'beignets sucrés', 'dessert', 'plat de résistance', 'brique', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:05:56.932382', [{'ingredient_id': 'ada64911-dd4d-42f8-9105-2622e0ade9e6', 'quantite': '2'}, {'ingredient_id': 'eaaad39f-5eb4-4c50-b5d1-80d8059d7dff', 'quantite': '50 g'}, {'ingredient_id': '3839799a-9fe3-493c-8a82-3c4164cbb87d', 'quantite': '2'}, {'ingredient_id': 'df58b2e5-b8cf-4109-9c9c-b471ae6fbfa3', 'quantite': '1'}, {'ingredient_id': '673e0746-ecde-4198-891b-59939ac8870d', 'quantite': '10 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (313158, 'Pop cake facile à la banane et chocolat', 'gâteaux, fromage frais, banane, chocolat blanc, lait, sucre', '15 min', ['Penser à vous munir de pics en bois. ', 'Écraser le gâteau que vous avez acheté ou cuisiné avec une spatule et ajouter le fromage frais, bien mélanger.', 'Incorporer à la préparation la demi banane coupée grossièrement.', 'Malaxer à la main jusqu''à obtenir une pâte ferme.', 'Former de petites boules d''environ 3 cm en roulant la pâte dans le creux de la main.', 'Tremper un bâtonnet dans un peu de chocolat fondu et le piquer dans les boules au 3/4. Mettre les boules 30 min au réfrigérateur.', 'Pour la décoration :', 'Faire fondre le chocolat au bain marie et tremper délicatement la sucette.', 'Décorer avec du sucre et paillettes selon vos envies.'], ['Mixeur', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'fromage frais', 'recette', 'cuisine', 'recettes', 'boisson', 'autres cakes', 'dessert', 'plat de résistance', 'gâteaux', 'cocktail', 'Pop cake facile à la banane et chocolat'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:06:00.509929', [{'ingredient_id': 'be79378c-2421-49d2-8e2e-4e8a903b13d5', 'quantite': '250 g'}, {'ingredient_id': '411645a3-02a5-42b9-a3cf-3c4831c531cd', 'quantite': '80 g'}, {'ingredient_id': '15ac01c4-0fce-4b6e-8a3e-da6db4028b9b', 'quantite': ''}, {'ingredient_id': 'aa25a276-a550-4b7c-8ada-2e1e9cff0b65', 'quantite': '1'}, {'ingredient_id': '870d9108-efa2-468e-a67c-3fa90e1ae747', 'quantite': ''}, {'ingredient_id': '477a864b-ff03-4a5b-9293-28c17cf65a31', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (28658, 'Pot-au-feu du Vénézuéla', 'poulet, jarret de veau, carotte, oignon, ail, banane, pomme de terre, céleri-rave, potiron, tomates pelées, petit piment, huile, bouillon, poivre, sel', '40 min', ['Faire cuire dans une marmite, le poulet, le jarret de veau, les carottes, 3 oignons et l''ail pendant 30 min. Assaisonner et incorporer les bananes et les choux caraïbes. Laisser mijoter 20 min. Ajouter les pommes de terre puis, après 15 min de cuisson, le potiron en morceaux.', 'Finir la cuisson pendant 15 min.', 'Faire une fondue d’oignon dans une poêle avec le reste d’oignons ciselés et un peu d’huile. Incorporer les tomates mondées et découpées, et les piments. Laisser mijoter quelques instants à feu doux. Verser le bouillon et laisser réduire 10 min.', 'Servir la viande avec les légumes, et la sauce à part.'], ['Pince de cuisine', 'Râpe', 'Passoire', 'Rouleau à pâtisserie'], ['poulet', 'banane', 'entrée', 'recettes de cuisine', 'sel', 'confiserie', 'petit piment', 'testées', 'tomates pelées', 'carotte', 'ail', 'Pot-au-feu du Vénézuéla', 'plat', 'moyenne', 'bouillon', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'huile', 'jarret de veau', 'dessert', 'plat de résistance', 'potiron', 'moyen', 'pot-au-feu', 'poivre', 'pomme de terre', 'céleri-rave', 'cocktail'], 'Plat principal', c68353e5-fe4b-4759-9775-96d3d5bed714, '2025-09-26T16:06:05.189464', [{'ingredient_id': 'a7b630d7-7447-4e30-b8eb-75109c951d93', 'quantite': '1'}, {'ingredient_id': '36cd66a5-c6db-4f80-bc28-41294729d9d8', 'quantite': '1 kg'}, {'ingredient_id': 'd1e5d0bf-6181-4e6f-b227-11a2e4ea83e8', 'quantite': '500 g'}, {'ingredient_id': '6cb44b61-0fce-4412-87ed-6b74da31f5ea', 'quantite': '6'}, {'ingredient_id': '16b99e3e-4c78-410e-ab72-1bdcb98005e0', 'quantite': '2'}, {'ingredient_id': '3ddc10fe-ff90-45ab-892e-3285a6111e71', 'quantite': '1 kg'}, {'ingredient_id': '2a35320e-d0b1-4610-b4be-c439dbe33fcc', 'quantite': '500 g'}, {'ingredient_id': '82503ac6-a946-4af8-9a7e-5ba9bb1979d3', 'quantite': '500 g'}, {'ingredient_id': '883cf364-200e-48a7-972e-844784d82f75', 'quantite': '500 g'}, {'ingredient_id': 'dfd9ee20-2716-4d3d-b73e-abba6dab8ee2', 'quantite': '500 g'}, {'ingredient_id': '6e3b0529-0bbc-4dda-a140-dab74bdf8800', 'quantite': '2'}, {'ingredient_id': '2bbb4922-9009-4465-addd-1b4189e62945', 'quantite': '2 cuillères'}, {'ingredient_id': 'a920d208-3beb-4421-a965-bfc71a46a0a0', 'quantite': '50 cl'}, {'ingredient_id': 'bd591877-9f7c-412d-808f-183ac0e80cdd', 'quantite': ''}, {'ingredient_id': '8e9939dc-e572-44e1-aa34-27b6c4a5bf64', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (19477, 'Salade Sofia', 'yaourt, orange, banane, pomme, litchi au sirop, sucre en poudre, sucre vanillé', '10 min', ['Dans un saladier, battre les yourts avec le sucre et le sucre vanillé. ', 'Ajouter les fruits coupé en petits cubes. ', 'Bien mélanger et servir très frais. '], ['Couteau de chef', 'Casserole'], ['', 'Salade Sofia', 'entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'orange', 'cocktail', 'litchi au sirop'], 'Dessert', 2a6581ad-4b5e-4994-820d-e7893ce01757, '2025-09-26T16:06:08.775255', [{'ingredient_id': '1899546c-7c92-4aa0-9cd8-c589676bfd23', 'quantite': '4'}, {'ingredient_id': '30fd0b02-39a7-498e-a3b4-052fe07531fd', 'quantite': '1'}, {'ingredient_id': '20fd8e82-f966-4710-ad4d-d2ae301c0884', 'quantite': '1'}, {'ingredient_id': '831eef6a-63c5-45ed-b579-f6cd8b7ded3a', 'quantite': '1'}, {'ingredient_id': 'eb336ae2-c20f-4b2c-a7de-64840484d3db', 'quantite': '1'}, {'ingredient_id': '669f4925-7698-4eed-a7b4-e081a83eebdb', 'quantite': ''}, {'ingredient_id': '5ddf2162-d8a5-450a-9a1e-537e511f2f89', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (529289, 'Banana Bread 100% antigaspi', 'farine, fécule, levure, sucre, huile d''olive, yaourt de soja, vinaigre de cidre, banane, fécule, eau, sucre, lait végétal', '30 min', ['Laver les peaux de banane, les découper en petits morceaux et les mixer avec le yaourt.', 'Verser tous les ingrédients secs dans un grand saladier.
Ajouter l''huile, et mélanger.', 'Ajouter les peaux de banane, mélanger, puis le vinaigre, mélanger.', 'Huiler un moule à cake, verser la pâte dedans.', 'Faire cuire 40 minutes à 180°C (thermostat 6).', 'Découper la chair d''une banane en fines rondelles, les déposer sur une feuille de papier cuisson, et faire cuire 30 minutes à 180°C.', 'Pendant ce temps, préparer la crème : découper en morceaux la chair des trois bananes restantes, et les mixer.', 'Délayer la fécule dans une casserole avec l''eau et le lait végétal, et mettre à chauffer à feu doux.
Lorsque le mélange commence à épaissir, rajouter la purée de banane, et mélanger encore 2-3 minutes.', 'Verser la crème dans un saladier et laisser refroidir au frigo.', 'Bien laisser refroidir le gâteau, puis le découper en deux horizontalement, et garnir de crème.', 'Décorer avec les rondelles de bananes séchées.'], ['Mixeur', 'Rouleau à pâtisserie', 'Poêle'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'plat', 'Banana Bread 100% antigaspi', 'recette', 'vinaigre de cidre', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'huile d''olive', 'yaourt de soja', 'dessert', 'plat de résistance', 'fécule', 'sucre', 'cocktail'], 'Dessert', 0c4435fa-724e-4942-b7c4-72ed9adb14d0, '2025-09-26T16:06:13.206542', [{'ingredient_id': 'bcbbfa58-91e4-495f-86a8-1cf9031338c1', 'quantite': '240 g'}, {'ingredient_id': 'baa56848-21e5-46dd-b500-ddd9cb376f61', 'quantite': '60 g'}, {'ingredient_id': 'a6ced72e-8425-404b-8dfc-f2453c7f386f', 'quantite': '12 g'}, {'ingredient_id': '070cd55f-1044-4361-881a-2085494d90b1', 'quantite': '100 g'}, {'ingredient_id': 'd4aced63-40a8-4948-a32a-b65a81f7f018', 'quantite': '100 g'}, {'ingredient_id': 'e560d88d-be23-4572-8242-b2179b3f4460', 'quantite': '200 g'}, {'ingredient_id': 'fc7f0c46-e06e-4246-9a77-e2e2913d9ba9', 'quantite': '2 cuillères'}, {'ingredient_id': 'a1577192-960f-4f80-9e28-399e5b57f340', 'quantite': '4'}, {'ingredient_id': 'dc706dd8-3197-43eb-ad55-9d0d42df3624', 'quantite': '2 cuillères'}, {'ingredient_id': '3dba2b6d-a587-49fe-a4e0-ad421207516b', 'quantite': '2 cuillères'}, {'ingredient_id': '58b8e637-037c-4d7e-b5c3-225c62d3d78d', 'quantite': '30 g'}, {'ingredient_id': '6ba4fa31-f4e2-457a-8011-e4e2c7df5e45', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (56426, 'Poulet au curry et à la banane', 'blanc de poulet, oignon, crème fraîche, farine, curry, beurre, riz, banane, chutney, sel', '45 min', ['Couper le poulet en morceaux et hacher l’oignon.', 'Faire fondre le beurre dans une casserole.', 'Y faire dorer l’oignon et le poulet.', 'Cuire le riz à part.', 'Pour cela, faire fondre un peu de beurre dans une petite casserole, ajouter un bouillon de poule émietté et verser 3 fois l’équivalent du riz en eau (3 tasses).', 'Cuire 20 min sans couvrir la casserole.', 'Saler et saupoudrer de curry le poulet (à présent blanc) et les oignons.', 'Ajouter 2 petites poignées de farine (attention à sans cesse remuer sinon la farine accroche).', 'Ajouter un petit verre d''eau et mélanger.', 'Couvrir la cocotte et laisser mijoter 12 min.', 'Dans un bol, mettre 2 cuillères à café de farine et ajouter la crème.', 'Mélanger la sauce à la préparation une fois celle-ci prête et cuire encore 2 min.', 'Servir avec le riz, un bol rempli de rondelles de bananes et du Chutney.'], ['Spatule', 'Économe', 'Planche à découper', 'Casserole'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'curry de poulet', 'plat', 'blanc de poulet', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'Poulet au curry et à la banane', 'farine', 'dessert', 'plat de résistance', 'riz', 'beurre', 'curry', 'cocktail', 'chutney'], 'Plat principal', 1a4f8552-7d88-4977-8eb5-60a7a890c67b, '2025-09-26T16:06:17.852255', [{'ingredient_id': '70980528-68bb-4554-ad19-4b809a3d131e', 'quantite': '4'}, {'ingredient_id': '6d7cae8f-e974-420a-aca5-b0ecc9aa2931', 'quantite': '1'}, {'ingredient_id': '6cb9a28a-9360-42d5-b118-27e5c5466ad5', 'quantite': '125 g'}, {'ingredient_id': '43632172-d189-40c9-ba9e-f8b165e29308', 'quantite': ''}, {'ingredient_id': 'a958c3cf-7855-48db-b9b7-3eb18b5b1e0c', 'quantite': '2 cuillères'}, {'ingredient_id': '5b1b7d1c-a00e-44d2-8f04-bd8a7a0f41e9', 'quantite': '50 g'}, {'ingredient_id': 'ce26e213-ad9c-4e5c-beab-2197d0183022', 'quantite': '1'}, {'ingredient_id': 'cbce16ed-b1fc-4a28-8cd0-577e1d9e4ff8', 'quantite': '4'}, {'ingredient_id': 'd391e122-c7d9-4de3-9805-a0c5684af0a1', 'quantite': ''}, {'ingredient_id': '03fc612f-0527-4d99-8b26-2cbedfd53c06', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (16362, 'Bavarois a la banane facile', 'banane, crème fraîche épaisse, biscuits à la cuillère', '10 min', ['Tremper rapidement le biscuit dans du lait et les disposer cote sucre dans les alvéoles du moule. tapisser également le fond n cassant les biscuits si nécessaire.', 'Mettre une couche de banane coupée en rondelles, une couche de crème, puis une couche de biscuits trempés, et ainsi de suite, de façon à terminer par une couche de biscuit.', 'Fermer le couvercle en chassant tout l''air (le moule doit être rempli à ras bord).', 'Mettre 24 h au réfrigérateur avec un poids dessus.', 'Démouler avant de servir avec un coulis de fruit rouge ou mieux des fruits rouges frais.'], ['Râpe', 'Tire-bouchon'], ['Bavarois a la banane facile', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche épaisse', 'confiserie', 'testées', 'biscuits à la cuillère', 'très facile', 'bon marché', 'rapide', 'plat', 'bavarois', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:06:21.386764', [{'ingredient_id': '0989fa82-fccb-4759-b78e-e6d7cb283c47', 'quantite': '4'}, {'ingredient_id': '51b58b4b-1ee3-4c62-ad76-dfa4efd40799', 'quantite': '50 cl'}, {'ingredient_id': 'e3ab4e21-91f2-4349-8eed-bab5b9b17b03', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (166076, 'Verrines rapides et pas chères', 'pomme, banane, biscuit sablé, jus de citron, café', '5 min', ['Prendre 4 verres ou verrines , couper la pomme en dès et tapisser le fond de la verrine.', 'Couper la banane en rondelles et les disposer sur la pomme.Rajouter le jus de citron et la cuillère a café de cannelle.', 'Mixer les granolas et disposer sur la banane.'], ['Tire-bouchon', 'Passoire', 'Casserole', 'Pince de cuisine', 'Rouleau à pâtisserie'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'biscuit sablé', 'très facile', 'bon marché', 'rapide', 'plat', 'Verrines rapides et pas chères', 'recette', 'café', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'jus de citron', 'pomme', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:06:24.958419', [{'ingredient_id': 'fecad924-53b6-4777-97f0-4fef41ee846e', 'quantite': '1'}, {'ingredient_id': '992ada8f-6fbf-41b4-8ce3-46723f7d5f49', 'quantite': '1'}, {'ingredient_id': 'ca6c021c-2908-43c7-865d-79a604f070e6', 'quantite': '8'}, {'ingredient_id': '871a909b-76d5-4bdf-983c-e4edfd83e9f8', 'quantite': '1'}, {'ingredient_id': '61aee999-aeef-4f6f-841b-77798acb24ad', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (14727, 'Bananes au lard', 'banane, menthe, moutarde, lard', '15 min', ['Moutarder très légèrement la courbe intérieure de la banane, y placer 2 feuilles de menthe et enrober la banane de 3/4 tranches de lard.', 'Déposer sur la grille du barbecue jusqu''à ce que le lard soit grillé (compter 7 mn environ).'], ['Balance de cuisine', 'Ouvre-boîte', 'Planche à découper'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'menthe', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'lard', 'Bananes au lard', 'dessert', 'plat de résistance', 'moutarde', 'cocktail'], 'Entrée', 1f91f0f0-d3be-452e-8b0a-700dca265703, '2025-09-26T16:06:29.631281', [{'ingredient_id': '5c963572-5360-4397-bc69-c1cf1d455647', 'quantite': '4'}, {'ingredient_id': '8d16128e-7d4e-42f0-85c8-5ac4ea3da865', 'quantite': '8'}, {'ingredient_id': '538adc00-0339-4527-9006-5d94146d35b4', 'quantite': ''}, {'ingredient_id': '77170fa5-4be4-4d94-b7ab-3f5532e38c2b', 'quantite': '12'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (339559, 'Clafoutis aux prunes jaunes et bananes', 'prune, banane, farine, sucre, beurre, lait, oeuf, sucre vanillé, sel', '10 min', ['Préchauffez le four à 210°C. ', 'Placez une feuille de papier cuisson dans un moule à gâteau et mettez-y les prunes puis les bananes, réservez.', 'Faites fondre le beurre.', 'Mélangez la farine, le sucre et le sucre vanillé.', 'Ajoutez les oeufsun à un en les mélangeant à chaque fois. ', 'Puis ajoutez le lait et le beurre, mélangez une dernière fois. ', 'Versez la préparation sur les fruits et enfournez pendant 10 à 12 minutes à 210°C puis abaisser à 180°C pour le reste de la cuisson.'], ['Tire-bouchon', 'Mixeur', 'Passoire'], ['Clafoutis aux prunes jaunes et bananes', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'prune', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'clafoutis', 'beurre', 'sucre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:06:33.565567', [{'ingredient_id': 'd160a1ee-dbd2-4320-8f6e-3b603bc5d9d9', 'quantite': '400 g'}, {'ingredient_id': '392e2348-1c15-46f8-bd1e-bfab61a60113', 'quantite': '1'}, {'ingredient_id': '0684036b-87b4-4394-88fa-ef4036b1e9b9', 'quantite': '100 g'}, {'ingredient_id': '9dbda53c-4bc8-434a-8f65-d48c71f260ee', 'quantite': '50 g'}, {'ingredient_id': 'cb4868f2-573b-446c-a27c-f575b44eb9ce', 'quantite': '35 g'}, {'ingredient_id': '9d641dea-f8c7-4bf8-bc17-0e4852abaf86', 'quantite': '20 cl'}, {'ingredient_id': 'f934da1c-3934-4cdf-8ef2-cdf3b48f8df8', 'quantite': '4'}, {'ingredient_id': '84ffb275-00d2-4797-aad4-6821c4e2a338', 'quantite': '1'}, {'ingredient_id': '1b0c2e56-11d3-4850-aa0d-37969cd04695', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (73588, 'Glace à la nectarine et à la banane', 'nectarine, banane, citron, yaourt, lait, sucre, miel', '20 min', ['Peler les nectarines, les couper en morceaux, puis faire de même avec la banane.', 'Mettre les morceaux de nectarines et de banane dans le mixeur. Les mixer. ', 'Rajouter les 2 yaourts et le jus de citron. Mixer à nouveau, en rajoutant le lait peu à peu, puis le sucre et le miel.', 'Verser le mélange dans une sorbetière pendant 30 min. ', 'La recette peut également se faire sans sorbetière, même si celle-ci est vivement conseillée.'], ['Pince de cuisine', 'Râpe', 'Balance de cuisine', 'Passoire'], ['entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'très facile', 'nectarine', 'bon marché', 'rapide', 'plat', 'recette', 'Glace à la nectarine et à la banane', 'cuisine', 'miel', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'citron', 'lait', 'glace à l''italienne', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:06:37.205470', [{'ingredient_id': '532d9322-fbcd-4420-a2f8-c7b23454b209', 'quantite': '2'}, {'ingredient_id': 'cf509125-5d97-42d2-ae06-af785d754045', 'quantite': '1'}, {'ingredient_id': 'e3edf3df-0560-4b5a-9e7d-4350692e502c', 'quantite': '1'}, {'ingredient_id': '6b4d606e-c476-4ea3-bdc1-5a5caa13d7f9', 'quantite': '2'}, {'ingredient_id': 'bbccb6e8-2caf-4b61-9ec2-3c575d529cb7', 'quantite': '25 cl'}, {'ingredient_id': 'd19c1cf0-4017-439b-819e-68f4b178caa6', 'quantite': '90 g'}, {'ingredient_id': '988cefee-93bf-463a-bb1f-82b923c84233', 'quantite': '3 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (24316, 'Beignets de bananes épicés', 'banane, farine, sel, oeuf, huile, lait, sucre, cannelle, vanille, rhum, huile de friture', '20 min', ['Pelez et coupez les bananes en 4 ou 5 tronçons. Déposez-les dans un saladier, saupoudrez de sucre semoule, ajoutez la cannelle, la vanille et le rhum. Laissez mariner 1 heure au moins.', 'Mélangez la farine, le sel, les deux jaunes d''oeufs, l''huile, le lait et une cuillère à café de rhum.', 'Laissez reposer la pâte une heure.', 'Battez les blancs en neige, incorporez-les à la pâte.', 'Egouttez les moorceaux de bananes, plongez-les dans la pâte, puis faites-les frire dans l''huile.'], ['Balance de cuisine', 'Économe'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'sel', 'confiserie', 'Beignets de bananes épicés', 'testées', 'huile de friture', 'facile', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'beignets sucrés', 'farine', 'vanille', 'dessert', 'plat de résistance', 'moyen', 'cannelle', 'lait', 'sucre', 'cocktail'], 'Dessert', 829e39ff-2b49-492f-9ebd-f7f9892d1bcf, '2025-09-26T16:06:40.773914', [{'ingredient_id': '0ebcae47-d39e-42aa-841b-15e5c36459e6', 'quantite': '4'}, {'ingredient_id': '5b9656f1-7f65-423f-92b2-4175bf3b0797', 'quantite': '100 g'}, {'ingredient_id': 'b82b3257-a9e2-4a6c-8228-a93c5530f936', 'quantite': '1'}, {'ingredient_id': '17bce3d7-2951-47ae-a29d-2f8d54c7fa77', 'quantite': '2'}, {'ingredient_id': '7b22e7bf-f60c-47ef-9a31-aefed80bfb1e', 'quantite': '2 cuillères'}, {'ingredient_id': '9cc3454e-f86d-42f0-ad10-6cf40ed8a6b6', 'quantite': '30 cl'}, {'ingredient_id': '74202727-f27c-43c2-801e-02b212494550', 'quantite': '2 cuillères'}, {'ingredient_id': 'c715c358-4fe9-474a-bbb2-e9e3bab288e1', 'quantite': '1'}, {'ingredient_id': '6c891cf6-9114-457e-87d3-74f0e1327ee5', 'quantite': '1'}, {'ingredient_id': 'af2096c0-14ab-4fff-8358-7bfc345b5089', 'quantite': '3 cuillères'}, {'ingredient_id': '4a2b36ff-26a2-4690-9c23-b53fbceb083a', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (57276, 'Fricassée banane kiwi', 'kiwi, banane, sucre roux, poivre, vinaigre balsamique, crème fraîche liquide', '15 min', ['Eplucher et couper en morceaux les fruits.', 'Les faire légèrement revenir dans du beurre à la poêle, puis les écraser à la fourchette en bois pour ne pas rayer la poêle.', 'Poivrez légèrement, puis ajouter le sucre roux et une cuillère à soupe d''eau, mélanger et laisser caraméliser légèrement.', 'Retirez du feu et ajouter un filet de vinaigre balsamique, mélanger.', 'Disposer sur une petite assiette plate, servir tiède avec un filet de crème fraîche liquide dessus et autour de la préparation pour adoucir et pour la déco.', 'Bon appétit.'], ['Spatule', 'Pince de cuisine', 'Louche', 'Poêle'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'Fricassée banane kiwi', 'rapide', 'plat', 'recette', 'crème fraîche liquide', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'vinaigre balsamique', 'poivre', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:06:45.404942', [{'ingredient_id': 'c47a6429-0b00-4b49-a1fe-d8f10bf6f8ee', 'quantite': '4'}, {'ingredient_id': '19e10ddb-0446-4708-8c3e-64b741abe627', 'quantite': '4'}, {'ingredient_id': '4ef6b8bf-bdc3-4066-bd38-8b04bdb0fe9e', 'quantite': '40 g'}, {'ingredient_id': '062b0979-f0de-438b-b46c-8ea5cf314a30', 'quantite': ''}, {'ingredient_id': 'a4c544f0-45a4-4ada-9d3e-2f2a509d8fd0', 'quantite': '3 cl'}, {'ingredient_id': '9012a804-7581-47ad-a52b-79be0664a679', 'quantite': '10 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (194311, 'Bricks pomme banane', 'pomme, banane, sucre, citron, brick, menthe', '20 min', ['Préchauffer le four à 220°C (thermostat 7).', 'Couper les pommes et bananes en petits dés, les placer dans un saladier, les arroser du jus du demi citron ainsi que la menthe ciselée.', 'Répartisser le tout sur les 2 feuilles de brick.', 'Saupoudrer de sucre et refermer les papillotes à l''aide de cure-dents.', 'Laisser cuire environ 15 min.', 'Laisser tiédir à température ambiante pendant environ une demi heure.'], ['Mixeur', 'Spatule', 'Fouet', 'Batteur électrique', 'Ouvre-boîte'], ['', 'entrée', 'Bricks pomme banane', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'menthe', 'bon marché', 'plat', 'recette', 'brick', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'citron', 'sucre', 'cocktail'], 'Dessert', 1cf9c8eb-7a83-4cbe-b04d-e2d75505744b, '2025-09-26T16:06:48.984711', [{'ingredient_id': 'beb2730a-f896-457e-9b43-6c321cb31dcd', 'quantite': '2'}, {'ingredient_id': '4dbef65b-5e4f-4b2a-8308-33432d5f0c52', 'quantite': '2'}, {'ingredient_id': 'f240acec-fee2-4996-b23a-92f454e34dea', 'quantite': '3 cuillères'}, {'ingredient_id': '03e0a89d-9eca-4e06-926f-81dee71b88ea', 'quantite': ''}, {'ingredient_id': '80acc2e8-613a-4f23-8b0b-ed90a68c5582', 'quantite': '2'}, {'ingredient_id': '34d7d880-096b-4e4d-ac1d-5a4266e18e04', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (527856, 'Bircher pommes - bananes Diététique', 'flocons d''avoine, pomme, banane, fromage blanc, sirop d''érable', '10 min', ['Couper la pomme en quartiers, enlever les pépins puis la couper en tranches.', 'Couper également la banane en tranches.', 'Déposer dans le fond d''un bol le fromage blanc.', 'Poser les flocons d''avoine dessus. Disposer les tranches de pommes et de bananes selon vos envies.', 'Couler un filet de sirop d''érable sur les fruits coupés (optionnel).'], ['Passoire', 'Batteur électrique', 'Planche à découper', 'Râpe', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'sirop d''érable', 'facile', 'Bircher pommes - bananes Diététique', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'fromage blanc', 'dessert', 'plat de résistance', 'pomme', 'flocons d''avoine', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:06:53.515550', [{'ingredient_id': '9011f1db-477b-4628-b1e8-8ed6653f4937', 'quantite': '50 g'}, {'ingredient_id': '4dcfea94-ee6e-4ba9-b948-36f351845768', 'quantite': '50 g'}, {'ingredient_id': '5391c15a-6e8b-4385-bbf8-aac6d845b14d', 'quantite': '50 g'}, {'ingredient_id': '78039369-db5d-4217-9ef0-8daf5bcd7682', 'quantite': '1'}, {'ingredient_id': 'd6b92b6b-d9ac-49b8-8a63-b14804998951', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (530525, 'Milk-shake aux 4 fruits', 'banane, nectarine, pêche, abricot, lait', '20 min', ['Coupe tous les fruits sous la surveillance d''un adulte en petits morceaux, et verse-les dans le mixer.', 'Ajoute le lait et mixe le tout !'], ['Ouvre-boîte', 'Pince de cuisine'], ['entrée', 'banane', 'Milk-shake', 'recettes de cuisine', 'confiserie', 'testées', 'abricot', 'très facile', 'nectarine', 'bon marché', 'rapide', 'plat', 'Milk-shake aux 4 fruits', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pêche', 'lait', 'cocktail'], 'Boisson', 5b367c7c-67ed-44f7-b5e9-bee1bc6abb0e, '2025-09-26T16:06:57.978559', [{'ingredient_id': 'db350c04-93fc-4a09-9059-6cbb33d6c6f0', 'quantite': '2'}, {'ingredient_id': '4f4d0995-dbfe-4ed7-b436-e1c499b7871e', 'quantite': '1'}, {'ingredient_id': '4b5da73f-4eff-46db-8404-d4362c9b7695', 'quantite': '1'}, {'ingredient_id': '34379eb1-5a29-4c1f-8304-856b2a089bb3', 'quantite': '2'}, {'ingredient_id': '7c707fdc-b463-4e13-befd-84d00c69b519', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (13452, 'Gloubiboulga', 'banane, crème fraîche, yaourt, sucre, arôme vanille', '5 min', ['Mixer tous les ingrédients. Goûter et assaisonner au goût.', 'Contrairement à la fameuse recette de Casimir, on evitera soigneusement la moutarde de dijon et les saucisses.', 'Servir frais.'], ['Râpe', 'Économe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'yaourt', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'arôme vanille', 'Gloubiboulga', 'sucre', 'cocktail'], 'Boisson', 61157f21-20d3-4267-9e62-7153772e916d, '2025-09-26T16:07:01.677736', [{'ingredient_id': '045f8050-aeb2-4af5-880a-5573d9e305fd', 'quantite': '2'}, {'ingredient_id': '2a5eeca9-73ff-4243-a6d6-211f77f74ed1', 'quantite': '2 cuillères'}, {'ingredient_id': '7a6f16c0-622e-4c6e-b796-acbaf4adf433', 'quantite': '1'}, {'ingredient_id': 'fdfbafa0-5cda-42bd-a37e-7bf7a696173b', 'quantite': ''}, {'ingredient_id': '979460c9-eae6-4dcb-a787-27b77d2f5621', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (348234, 'Framboise pistache banana bread balls', 'banane, framboises, farine, cassonade, beurre, oeuf, pistaches, arôme vanille, levure, sel', '20 min', ['Préchauffer le four à 180°C (thermostat 6).
Travailler le beurre et le sucre jusqu''à ce que le mélange blanchisse.', 'Ajouter l''oeuf et battre jusqu''à l''obtention d''un mélange homogène et mousseux.', 'Ajouter la vanille.', 'Eplucher puis écraser les bananes et les ajouter au mélange. 
Bien mélanger.', 'Dans un autre récipient, mélanger la farine, les pistaches, la levure et le sel.', 'Incorporer à la préparation liquide et bien mélanger.', 'Incorporer délicatement les framboises.', 'Former des petites boules de pâtes et les disposes sur une plaque recouverte de papier cuisson.', 'Enfourner 40 minutes.'], ['Poêle', 'Planche à découper', 'Ouvre-boîte', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'cassonade', 'Framboise pistache banana bread balls', 'autres gâteaux', 'très facile', 'framboises', 'bon marché', 'oeuf', 'plat', 'pistaches', 'recette', 'levure', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'arôme vanille', 'beurre', 'cocktail'], 'Dessert', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T16:07:05.342604', [{'ingredient_id': 'd54ea02b-17af-4298-8009-0b790445a876', 'quantite': '2'}, {'ingredient_id': 'a21da673-4e3d-4ca0-86d3-0425c612eef5', 'quantite': '75 g'}, {'ingredient_id': 'cbc120a0-42f4-4971-84f6-b1cb450e89ba', 'quantite': '250 g'}, {'ingredient_id': 'ad0726d8-7639-4327-9330-034cb7826129', 'quantite': '60 g'}, {'ingredient_id': 'c515c154-a016-428a-938f-a736e4fe740f', 'quantite': '60 g'}, {'ingredient_id': '3715a75e-7458-4250-917e-347e8c8c919f', 'quantite': '1'}, {'ingredient_id': '2578051e-41ba-412c-b18b-d13124d5f01b', 'quantite': '30 g'}, {'ingredient_id': 'e0058d13-aea5-424d-bd51-e4dd83d1da38', 'quantite': ''}, {'ingredient_id': '6d45dd24-fc45-48d7-bba8-2f23f55e5d30', 'quantite': '1 cuillères'}, {'ingredient_id': 'c44d9feb-7a66-4e8b-8ea8-b050407bd025', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (57083, 'Tarte Choco Fruits', 'pâte sablée, chocolat pâtissier, beurre, banane, kiwi, crème fraîche', '15 min', ['Préchauffer le four thermostat 6-7 à 200°C, mettre de l''eau à chauffer pour le bain marie.', 'Mettre la chocolat en morceaux dans une casserole sur le bain marie ajouter le beurre, faire précuire à blanc la pâte pendant 10 minutes.', 'Verser la crème fraîche dans le chocolat fondu.', 'Découper les bananes en rondelles, les kiwis en quarts de rondelle, les mettre asur la pâte et verser le chocolat dessus.', 'Enfourner encore 20 minutes, le temps que la pâte soit cuite.'], ['Mixeur', 'Couteau de chef'], ['', 'Tarte Choco Fruits', 'entrée', 'banane', 'kiwi', 'crème fraîche', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'pâte sablée', 'plat', 'recette', 'chocolat pâtissier', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'cocktail'], 'Dessert', 8314d702-ef68-4aa5-b815-dd3f86719be9, '2025-09-26T16:07:08.913181', [{'ingredient_id': '23ed9d3b-ee60-4580-81aa-9f0c15ac555f', 'quantite': '1'}, {'ingredient_id': '0d5232b6-c203-48a5-941e-b51ad35c8f56', 'quantite': '200 g'}, {'ingredient_id': '396c3d07-4eaf-422e-94bd-bc03d9483c65', 'quantite': '75 g'}, {'ingredient_id': '73463aa0-8c5d-4de6-9832-b47e96a617d9', 'quantite': '1'}, {'ingredient_id': '1d0f27a2-1a73-44cb-9d82-7c93057810fc', 'quantite': '2'}, {'ingredient_id': 'be0e934a-685b-43b2-9453-1d427cb79abc', 'quantite': '20 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (344412, 'Gâteau chocolat fitness', 'oeuf, fromage blanc, sucre roux, flocons d''avoine, chocolat noir, farine, levure, banane', '45 min', ['Pour la pâte :', 'Mélanger les flocons d''avoine, 10 g de sucre et 1 fromage blanc de chèvre dans un saladier', 'Étaler la pâte dans des petits ramequins en silicone, bien écraser pour obtenir une surface lisse.', 'Faire cuire au four 10 min à 210°C.', 'Pour la garniture :', 'Dans un saladier, verser 2 fromages blanc de chèvre, 10 g de sucre et une demi banane écrasée puis le faire chauffer au micro-ondes jusqu’à ce que le mélange commence à bouillir.', 'Faire fondre le chocolat dans le mélange sorti du micro-ondes.', 'Verser la farine et la levure puis mélanger.', 'Verser dans les petits ramequins au dessus de la pâte et faire cuire 17 min à 210°C.'], ['Balance de cuisine', 'Presse-agrumes', 'Louche', 'Planche à découper', 'Économe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'Gâteau chocolat fitness', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'fromage blanc', 'dessert', 'plat de résistance', 'chocolat noir', 'gâteau au chocolat', 'flocons d''avoine', 'cocktail', 'sucre roux'], 'Dessert', 9e63972b-4be2-4ad3-bddf-219162022170, '2025-09-26T16:07:13.360047', [{'ingredient_id': '7bf61697-0d83-4205-9089-2c3387d00a64', 'quantite': '3'}, {'ingredient_id': '0ee31ef2-a941-4f64-bf18-b146f054fdda', 'quantite': '3'}, {'ingredient_id': '26d3ce39-c796-49a8-89b6-e874f32eb44a', 'quantite': '20 g'}, {'ingredient_id': 'eff2a9b5-b41d-4785-9c6c-b5ea5250cc86', 'quantite': '375 g'}, {'ingredient_id': '1349bac4-b440-465a-a000-1340e004866d', 'quantite': '200 g'}, {'ingredient_id': 'd2bc6fe2-1853-413b-8884-f6c684fee6a8', 'quantite': '20 g'}, {'ingredient_id': '97b85408-8bd5-48ce-b273-c7b9205cc96d', 'quantite': ''}, {'ingredient_id': 'c70fee54-b8c0-46bb-bcaa-7e6d510ed86b', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (48940, 'Muffins Rhubarbe Banane', 'farine, sucre, levure chimique, sel, cannelle, oeuf, huile, banane, rhubarbe', '15 min', ['Dans un premier saladier, mélanger les ingrédients "secs" : farine, sucre, levure, sel et cannelle.', 'Dans un deuxième récipient, fouetter l''œuf, l''huile et les bananes réduites en purée.', 'Mêler rapidement les deux préparations et ajouter la rhubarbe.', 'Il faut se contenter de réduire les grumeaux et ne pas chercher à avoir une pâte bien lisse (c''est le secret des muffins gonflés !).', 'Verser immédiatement dans un moule à muffins beurré et fariné.', 'Cuire 20 à 25 minutes à 180°C (thermostat 6).'], ['Fouet', 'Planche à découper', 'Mixeur', 'Louche', 'Râpe'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'levure chimique', 'rhubarbe', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'farine', 'Muffins Rhubarbe Banane', 'dessert', 'plat de résistance', 'muffin', 'cannelle', 'sucre', 'cocktail'], 'Dessert', fb544653-3637-4429-ba96-cce6a1c12dea, '2025-09-26T16:07:18.121213', [{'ingredient_id': 'a7d88563-be00-47d3-8e03-9c0b8defcb84', 'quantite': '220 g'}, {'ingredient_id': '4630ba7c-14fa-4254-b8ea-0ffafc597274', 'quantite': '130 g'}, {'ingredient_id': '980e1ef5-e10b-4d94-99d3-8458da1a1c0e', 'quantite': '2 cuillères'}, {'ingredient_id': '818c632b-409c-4caf-b608-e63e84beed74', 'quantite': '1 cuillères'}, {'ingredient_id': 'dd8de4c9-865a-45b9-9fd3-5c6c5ecc7a6c', 'quantite': '1'}, {'ingredient_id': '3a615e91-91b0-49ee-bb95-4b71ca0708e7', 'quantite': '1'}, {'ingredient_id': '691efc42-4e36-4b72-bc62-7a11510c2a64', 'quantite': '5 cl'}, {'ingredient_id': 'ff760ca9-3f60-4ecc-b5b4-03f0168ca7cc', 'quantite': '2'}, {'ingredient_id': 'b0ab1ff3-1f7f-4cd5-9a8c-bc956ad3af76', 'quantite': '180 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (27615, 'Omelette tropicale flambée, aux ananas et aux bananes', 'oeuf, banane, ananas, noix de coco rapée, sucre de canne, rhum, huile', '10 min', ['Couper les bananes en rondelles et l''ananas en morceaux. Chauffer le rhum.', 'Battre les oeufs et cuire une omelette baveuse à la poêle avec un peu d''huile.', 'Garnir l''omelette des fruits, saupoudrer d''un peu de noix de coco et de sucre. Plier l''omelette et saupoudrer à nouveau du reste de sucre et de noix de coco.', 'Verser le rhum, flamber et servir immédiatement.'], ['Verre doseur', 'Moule à tarte', 'Couteau de chef', 'Spatule', 'Batteur électrique'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'facile', 'rapide', 'Omelette tropicale flambée', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'sucre de canne', 'noix de coco rapée', 'dessert', 'plat de résistance', 'moyen', 'ananas', 'aux ananas et aux bananes', 'cocktail'], 'Dessert', d6308e2f-d0f2-44ab-9ad1-fa7b1063f2fb, '2025-09-26T16:07:21.733262', [{'ingredient_id': '4d18de9a-4767-478e-a207-51813ad05205', 'quantite': '4'}, {'ingredient_id': '56e314b9-1acc-4838-b46c-dc9d1ebbb1f3', 'quantite': '1'}, {'ingredient_id': 'fb23a34a-65ca-4ee5-afb1-21e61f51ab07', 'quantite': '2'}, {'ingredient_id': '4bc6aa4c-f173-44dc-901c-38fc36af08b1', 'quantite': '3 cuillères'}, {'ingredient_id': '5c98836b-b85e-4e76-a68b-89e80fba1988', 'quantite': '4 cuillères'}, {'ingredient_id': 'fe6a90c1-11c3-41e5-981a-1f8c4a837ec8', 'quantite': '5 cl'}, {'ingredient_id': '6460432d-9445-48f4-8653-60410d401479', 'quantite': '3 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (21008, 'Crêpes fourrées banane-coco', 'sucre, beurre, noix de coco rapée, crème fraîche, farine, oeuf, crêpe, banane, lait, rhum, vanille', '45 min', ['Faire infuser la noix de coco râpée dans le lait pendant 2 h et tamiser le lait.', 'Dans un saladier, blanchir 2 jaunes d''œufs avec 100 g de sucre et ajouter la farine et un oeuf. ', 'Porter le lait à ébullition avec le sel et le verser dans la préparation, tout en remuant.', 'Remettre le tout dans la casserole et porter à ébullition sans cesser de remuer, jusqu’à épaississement. Parfumer de quelques gouttes de vanille et laisser refroidir. ', 'Couper les bananes dans le sens de la longueur et les faire revenir dans une poêle avec 20 g de beurre.', 'Dans un saladier, mélanger 6 jaunes d''œufs, 100 g de beurre en pommade, la crème fraîche, le reste de sucre et le rhum.  Faire cuire au bain-maie en fouettant sans cesse.', 'Beurrez un plat à four.', 'Recouvrir les crêpes de crème pâtissière et y déposer un morceaux de banane. Rouler les crêpes et les placer dans un plat beurré.', 'Napper de crème et enfourner à 210° (thermostat 7) pendant 10 min, puis 2 min position grill.'], ['Moule à tarte', 'Passoire'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'rhum', 'confiserie', 'testées', 'facile', 'Crêpes fourrées banane-coco', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'vanille', 'crêpe', 'noix de coco rapée', 'dessert', 'plat de résistance', 'crêpes sucrées', 'moyen', 'beurre', 'sucre', 'lait', 'cocktail'], 'Dessert', a48f7ada-505c-4759-b51c-3fc1ea8c8228, '2025-09-26T16:07:26.602745', [{'ingredient_id': '78f61530-18ad-42b1-aebe-808b59ef0a71', 'quantite': '200 g'}, {'ingredient_id': 'cdcb5863-a602-42d8-ae7a-71f36921a931', 'quantite': '130 g'}, {'ingredient_id': '71859adb-4035-457c-8239-12cccf14112c', 'quantite': '100 g'}, {'ingredient_id': '4f14f8fe-f5ce-413a-a68e-e88e8b9980c4', 'quantite': '100 g'}, {'ingredient_id': 'cf87823e-d9d8-4b66-b5a8-2bd99b3808bb', 'quantite': '50 g'}, {'ingredient_id': '60d570fe-98ff-4ede-8746-d9a6fe98f573', 'quantite': '9'}, {'ingredient_id': 'cd4a9122-b5ad-40f6-b2a4-24aba8a54af5', 'quantite': '8'}, {'ingredient_id': 'fac3eb66-ebed-4c03-9fec-ecdb800fe941', 'quantite': '4'}, {'ingredient_id': '4fc4becb-6c97-494a-9ab0-89db4c5393a0', 'quantite': '50 cl'}, {'ingredient_id': '90b72333-635b-455b-930e-88a7c324aa3a', 'quantite': '5 cl'}, {'ingredient_id': 'b51253fc-1643-4c05-91c5-8ec65fc5d363', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (169138, 'Lait rose', 'banane, fraises, lait, sucre en poudre', '10 min', ['Eplucher les fruits et les couper en petits morceaux dans le bol du mixer. Ajouter le sucre et réduire en purée.', 'Verser le lait glacé. Mélanger de nouveau et servir de suite.'], ['Presse-agrumes', 'Fouet'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'fraises', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'Lait rose', 'plat de résistance', 'lait', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:07:31.138151', [{'ingredient_id': '975c92e7-9c4c-491e-82c5-dcf0d2deffcd', 'quantite': '2'}, {'ingredient_id': '0c786978-ea6d-4508-9b54-3b326761fbc3', 'quantite': '20'}, {'ingredient_id': 'e42376f1-9001-4eeb-b644-6b9d134638cc', 'quantite': '3'}, {'ingredient_id': 'fbae2c2b-0fe2-4c22-9f78-3ae7cd5d0ec2', 'quantite': '6 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (321270, 'Glace banane chocolat', 'banane, chocolat, crème liquide, noisettes', '15 min', ['Commencez par faire fondre le chocolat. ', 'Ajoutez-y les fruits secs concassés qui feront, dans la bouche, bien concurrence avec la douceur de la glace. ', 'Une fois ceci fait, écrasez les deux bananes pour en faire une purée. ', 'Montez la crème en chantilly (il vous faut des ustensiles biens froid pour mettre toutes les chances de votre côté.)', 'Séparez la chantilly en deux parts égales. ', 'L''une ira aux bananes, pour les rendre plus légères.', 'L''autre ira au chocolat, pour qu''il soit plus léger.', 'Dans un récipient, alternez les couches bananes et celles au chocolat pour une meilleure présentation. Sinon, mélangez le tout. ', 'Laissez prendre quelques heures au congélateur.', 'Bon appétit !'], ['Couteau de chef', 'Tire-bouchon', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'noisettes', 'Glace banane chocolat', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'dessert', 'plat de résistance', 'glace à l''italienne', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:07:36.168838', [{'ingredient_id': '4f07d71c-09bc-4062-955e-78d7227b808b', 'quantite': '2'}, {'ingredient_id': '3be536c6-2e53-4440-97f8-617b31a208c4', 'quantite': '1'}, {'ingredient_id': 'a22c2fc5-6b87-48e0-ac0f-1d6633daa3ab', 'quantite': '15 cl'}, {'ingredient_id': '33919edf-2dce-46de-a637-cbfdd0e8d838', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (335827, 'Brochettes d''iguane à la cubaine', 'viande, oignon blanc, citron vert, ail, tomate, poivron, tabasco, mangue, piment vert, thym, huile de friture, feuille de laurier, maïs, banane plantain', '134 min', ['Préparez la marinade pour la viande d''iguane, mélangez le jus de mangue et le jus des 2 citrons verts, ajoutez-y la viande et laissez mariner pendant 2 heures. ', 'Quand la viande a fini de mariner, découpez en petits cubes et piquez les sur des piques à brochettes.', 'Faites chauffer un peu d''huile, et faites cuire les brochettes pendant environ 3 minutes, en attendant préparer la sauce, dans une petite casserole mettez l''oignon haché, la gousse d''ail, le thym et la feuille de laurier. ', 'Coupez le piment vert, les poivrons et la tomate sans oublier d''enlever les graines et la peau de la tomate, rajoutez-les et laissez compoter le tout. ', 'Découpez la banane plantain en rondelles et faites les frire, faites cuire les épis de maïs et dresser le tout dans une assiette. Vous pouvez ajouter des haricots rouges.'], ['Casserole', 'Verre doseur', 'Tire-bouchon', 'Fouet'], ['', 'entrée', 'recettes de cuisine', 'feuille de laurier', 'confiserie', 'testées', 'huile de friture', 'viande', 'Brochettes d''iguane à la cubaine', 'ail', 'tomate', 'rapide', 'plat', 'mangue', 'moyenne', 'recette', 'cuisine', 'recettes', 'boisson', 'poivron', 'tabasco', 'dessert', 'oignon blanc', 'plat de résistance', 'banane plantain', 'moyen', 'maïs', 'piment vert', 'thym', 'citron vert', 'cocktail'], 'Plat principal', da6c283e-eb15-4f5e-92ee-73141491b186, '2025-09-26T16:07:41.714782', [{'ingredient_id': 'c5da0043-a1e1-4b55-abb1-52e8867a7f76', 'quantite': '150 g'}, {'ingredient_id': '4247f35e-f76c-4c2f-89f3-7d9326ac8304', 'quantite': '1'}, {'ingredient_id': 'c137244d-7da9-4955-95c9-9cade3944f1b', 'quantite': '2'}, {'ingredient_id': 'e402ae11-bc17-4b44-9315-c16d578aceba', 'quantite': '1'}, {'ingredient_id': '117e3cdd-eda6-4c53-bf4e-8d11cfd4c71f', 'quantite': '1'}, {'ingredient_id': '2c06f0b8-1f67-4406-9003-8f4b6bb41109', 'quantite': '2'}, {'ingredient_id': '9c1c3da8-9e25-4200-a2ee-e23d72772ee8', 'quantite': '1 cuillères'}, {'ingredient_id': 'cafd2996-c3c2-4a05-ba29-c1abc7a5cea2', 'quantite': ''}, {'ingredient_id': 'b7bd0551-b950-4a88-bf77-6feb557d33f5', 'quantite': '1'}, {'ingredient_id': 'd5a55d26-de67-4873-bd23-373f85c1d976', 'quantite': ''}, {'ingredient_id': 'c37ff673-924d-4314-8124-25c8d86ef776', 'quantite': '25 cl'}, {'ingredient_id': '5df8391b-35ee-4051-81d2-c8092bf7f4ac', 'quantite': '1'}, {'ingredient_id': '36b2e5cf-bd1f-432e-9123-00a7e437137b', 'quantite': '2'}, {'ingredient_id': 'd75d37d2-06f7-4e8f-bb70-e24dde500ede', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (62867, 'Poulet au curry et aux fruits', 'oignon, pomme, banane, blanc de poulet, riz thaï, eau, curry, cube de bouillon, raisins secs, huile d''olive, poivre, sel', '30 min', ['Tout d''abord, mettre de l''huile d''olive dans un faitout, couper les oignons en petits morceaux : faire un roux d''oignons.', 'Pendant ce temps, couper les pommes et les bananes en petits morceaux (ni trop gros ni trop petits), préparer le bouillon de volaille : cubes mélangés aux 25 cl d''eau chaude.', 'Bien nettoyer les blancs de poulet c''est à dire enlever les morceaux de gras ou de nerfs s''il y en a : c''est meilleur !!', 'Insérer, à plat, les blancs de poulet dans le roux d''oignons : les saupoudrer de curry (dose selon les goûts) et les faire revenir. Quand ils sont bien revenus d''un côté, les retourner et faire pareil : saupoudrer de curry et laisser revenir.', 'Quand les blancs sont bien pré-cuits, ajouterle bouillon de volaille et les fruits (bananes, pommes et raisins).', 'Laisser mijoter à couvert, à feux doux, pendant 30 minutes en remuant pour ne pas que ça attache.', 'Faire cuire le riz à part pour qu''il soit bien fondant.', 'Servir chaud !!!'], ['Fouet', 'Planche à découper'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'eau', 'testées', 'facile', 'bon marché', 'curry de poulet', 'plat', 'blanc de poulet', 'recette', 'cube de bouillon', 'cuisine', 'recettes', 'Poulet au curry et aux fruits', 'oignon', 'boisson', 'huile d''olive', 'dessert', 'plat de résistance', 'pomme', 'raisins secs', 'poivre', 'riz thaï', 'curry', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:07:45.461631', [{'ingredient_id': '7effcee3-a69d-405e-b3b8-6da155e67836', 'quantite': '3'}, {'ingredient_id': 'f79650f2-d386-43c2-9cfb-1979e66861a7', 'quantite': '3'}, {'ingredient_id': '56ed0cb5-5473-4db1-b714-7bba3d7b6807', 'quantite': '3'}, {'ingredient_id': '85158742-3199-40d1-906e-4fdb35c682d7', 'quantite': '6'}, {'ingredient_id': '0087d90c-3790-4384-aebc-54eb6989a56d', 'quantite': '300 g'}, {'ingredient_id': '9ecba77c-b6e9-49b8-a9b0-bb352ff3f352', 'quantite': '25 cl'}, {'ingredient_id': '40fac984-3f2f-4948-a085-3b79be45e714', 'quantite': ''}, {'ingredient_id': '3a4ac5aa-0029-4fa9-8981-92405c7467bd', 'quantite': '2'}, {'ingredient_id': '37679207-1c4f-47be-ad08-06032afafb91', 'quantite': '1'}, {'ingredient_id': '616fa4ba-0416-49b4-83dd-ad8caf506c59', 'quantite': ''}, {'ingredient_id': '1a99af8d-2205-4290-a00b-f5e79ef18ee0', 'quantite': ''}, {'ingredient_id': 'fa2a2ae9-c19b-4337-9be4-281783af8f28', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (42762, 'Crumble exotique aux litchis', 'litchi au sirop, kiwi, banane, pomme, compote, gingembre, cannelle, rhum, farine, noix de coco rapée, cassonade, margarine, oeuf, sel', '10 min', ['Peler et couper les fruits :', '- les bananes et les kiwis en rondelles ;', '- la pomme en petits dés ;', '- les litchis (égouttés et dénoyautés) en 2.', 'Mélanger les fruits, la compote avec le rhum et les épices.', 'Pour la pâte à crumble, il y a deux méthodes :', '- la plus rapide : mettre tous les ingrédients dans un mixeur et mixer par à-coup jusuq''à obtenir une pâte sableuse, mais pas homogène.', '- sinon : mélanger dans une terrine la farine,la noix de coco, l''oeuf, le beurre, la cassonade et le sel (avec les mains ou deux fourchettes) de facon à obtenir des grains comme du sable.', 'Préchauffer le four à 180°C (thermostat 6).', 'Mettre les fruits dans un moule à manqué (sur environ 2 cm d''épaisseur) puis parsemer le dessus de la pâte à crumble.', 'Cuire 20 min au four (air pulsé / chaleur tournante de préférence) puis finir de faire dorer 5 min sous le grill.', 'Déguster de préférence tiède, avec une boule de glace à la vanille ou 1 cuillère de crème épaisse (voire fromage blanc).'], ['Poêle', 'Mixeur'], ['entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'plat', 'recette', 'compote', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'autres crumbles', 'moyen', 'cocktail', 'litchi au sirop', 'Crumble exotique aux litchis'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:07:49.209894', [{'ingredient_id': '55cd0d59-9c44-4963-9d5a-3d17a5c28bf7', 'quantite': '1'}, {'ingredient_id': '10226c6c-2457-46d6-bce4-ecb1b03af52a', 'quantite': '2'}, {'ingredient_id': 'b693fd6f-bbfb-4a94-8cb5-4d7575e804d6', 'quantite': '1'}, {'ingredient_id': '345ed84b-5cdc-45a6-b0e5-11492ba0c648', 'quantite': '1'}, {'ingredient_id': '3aca1f5b-cf67-46e5-87ea-71bc5c7350ad', 'quantite': '100 g'}, {'ingredient_id': '5844ce54-2d1e-47a4-9eff-1d9e64ea7a39', 'quantite': ''}, {'ingredient_id': '34d7c4a6-cb3f-4683-a038-7b5553e1cf23', 'quantite': ''}, {'ingredient_id': 'c03af0ef-c982-4187-b6b2-78c94c15f963', 'quantite': ''}, {'ingredient_id': '9b22ea36-a154-432a-ad31-20e1d4f97146', 'quantite': '50 g'}, {'ingredient_id': '17367012-841e-44bd-89a4-9d82b4adf5b0', 'quantite': '30 g'}, {'ingredient_id': '24401275-826d-4ce1-a4e9-e90bb940fc5c', 'quantite': '30 g'}, {'ingredient_id': '7393ba9f-4835-447d-a274-8e0ad0e74dab', 'quantite': '40 g'}, {'ingredient_id': 'c36ddad9-a7e5-47c9-80e9-97ce73872fbe', 'quantite': ''}, {'ingredient_id': '709e9d54-2cbc-4889-865c-fb0c10df542e', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (45363, 'Bananes au jambon et béchamel au curry', 'banane, jambon, beurre, lait, lait, sel, poivre, curry, gruyère râpé', '10 min', ['Enrouler les bananes dans les tranches de jambon et les disposer dans un plat allant au four.', 'Préparer la béchamel au curry :', 'faire fondre le beurre, ajouter la farine ne pluis et remuer. Verser peu à peu le lait en touillant et laisser épaissir à feu doux. Saler et poivrer, ajouter du curry au goût.', 'En recouvrir les bananes. Parsemer de fromage râpé.', 'Mettre au grill pendant 10 min et servir aussitôt.'], ['Presse-agrumes', 'Moule à tarte', 'Ouvre-boîte'], ['entrée', 'banane', 'recettes de cuisine', 'jambon', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Bananes au jambon et béchamel au curry', 'viande à l''indienne', 'cocktail'], 'Plat principal', b24257b8-9881-42da-91f8-ee3e6070a3a9, '2025-09-26T16:07:52.833591', [{'ingredient_id': 'face9cc2-4ef1-4b72-8184-586558b36abe', 'quantite': '4'}, {'ingredient_id': 'a897ddfa-a7df-4f1e-94fc-2aa15d9c3855', 'quantite': '4'}, {'ingredient_id': 'e8f2a380-1157-479a-9ece-787f722f20dc', 'quantite': '40 g'}, {'ingredient_id': '457022a3-0d83-4a99-9c22-9f3d29e45a16', 'quantite': '40 g'}, {'ingredient_id': 'e3921bdb-12df-4fad-983b-60c85ae9051c', 'quantite': '2'}, {'ingredient_id': 'cd50f8cb-fc85-4cc5-9fc9-c30d3f54815f', 'quantite': ''}, {'ingredient_id': 'a3cb1cd4-1568-408d-a109-e68c1cab5e29', 'quantite': ''}, {'ingredient_id': 'd2fdb83e-37bc-4ddd-8e23-f7b82864d838', 'quantite': '2 cuillères'}, {'ingredient_id': '96a7bc5a-9daf-4b61-b7f7-e29321f72b4c', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (64958, 'Crumble bananes, citrons verts et noix de coco', 'banane, citron vert, beurre, sucre, noix de coco, amandes en poudre', '15 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Préparer la pâte en mélangeant le beurre ramolli, le sucre, la noix de coco et la poudre d''amandes, jusqu''à obtenir des miettes grossières.', 'Punir cette grossièreté en enfermant la pâte 10 min au réfrigérateur.', 'Détailler les bananes en rondelles.', 'Retirer les zestes des 2 citrons, couper en julienne.', 'Mélanger avec les bananes ainsi que le jus d''un des 2 citron.', 'Une fois les 10 minutes de réfrigération écoulés, recouvrir les fruits de la pâte à crumble.', 'Enfourner 22 min en réglant la sonnerie à 11 min pour retourner le plat car, comme 90% des fours, le vôtre ne cuit pas uniformément je parie.'], ['Verre doseur', 'Mixeur', 'Passoire', 'Moule à tarte', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'amandes en poudre', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Crumble bananes', 'citrons verts et noix de coco', 'autres crumbles', 'beurre', 'citron vert', 'noix de coco', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:07:56.480779', [{'ingredient_id': 'b9ee79fb-6842-4454-ab65-49e5bd14165c', 'quantite': '6'}, {'ingredient_id': '909c403b-d368-4560-ae0c-cb458c76eb2b', 'quantite': '2'}, {'ingredient_id': 'cb1ea0f7-8509-451b-a284-5b40c48f8a73', 'quantite': '120 g'}, {'ingredient_id': '442c9396-866b-4f28-9a9a-4c6585cad3e0', 'quantite': '80 g'}, {'ingredient_id': '78002bbc-cb0a-41f5-a203-1b904c3d821c', 'quantite': '80 g'}, {'ingredient_id': '00923f89-1e60-4092-8ea4-ec65414cae40', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (225515, 'Verrine de mousse au chocolat, compotée de banane façon crumble', 'chocolat, oeuf, crème liquide, banane, sucre vanillé, petit beurre, beurre, sucre glace', '40 min', ['Préparez la mousse au chocolat : faites fondre le chocolat au bain marie, puis mélangez-le à 5 cl de crème liquide bouillie. Après un léger refroidissement, incorporez 1 jaune d''oeuf. Monter les blancs des oeufs en neige avec une pincée de sel, puis incorporez-les délicatement au chocolat. Répartissez la mousse dans le fond de chaque verre. Disposez-les au réfrigérateur.', 'Pour le crumble, faites fondre le beurre, et ajoutez-le au paquet de petits beurre dans un robot-mixer. Broyez-les pour obtenir des morceaux de votre préférence. Si vous les préférez craquants, attendez 1h que la mousse au chocolat soient bien solidifiée pour en disposer une couche, si vous les souhaitez plus tendres, disposez-les tout de suite sur la mousse.', 'Préparez la compote de banane : pelez les bananes et coupez-les en rondelles d''1 cm environ. Ajoutez-y un sachet de sucre vanillé. Faites-les compoter dans une casserole, dans un fond d''eau, sur feu doux. Remuez de temps en temps pour que ça n''accroche pas. Arrêtez le feu lorsque cela a bien ramolli (15 minutes de cuisson environ). Si cela vous convient, laissez tel quel ou écrasez à la fourchette, sinon, passez-les au blender, pour obtenir une purée lisse. Quand la mousse est restée 2h au réfrigérateur, et que le crumble y a été disposé, ajoutez une couche de compote de banane, et remettez les verres au réfrigérateur.', 'Remplir le siphon du reste de crème liquide, du sucre glace et du reste de sucre vanillé. Bien remuer, et sucrez à votre convenance, si besoin. Appliquez le mode d''emploi du siphon, et laissez-le au réfrigérateur jusqu''au moment de servir. Si vous n''avez pas de siphon, laissez la crème liquide au réfrigérateur jusqu''au moment de servir, et montez-la en chantilly, au batteur électrique. Incorporez très délicatement les sucres. Avant de servir, disposez une couche de chantilly sur l''ensemble, et servez aussitôt.'], ['Louche', 'Mixeur', 'Casserole'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'crumble banane', 'testées', 'compotée de banane façon crumble', 'chocolat', 'facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'dessert', 'plat de résistance', 'sucre vanillé', 'beurre', 'petit beurre', 'sucre glace', 'cocktail', 'Verrine de mousse au chocolat'], 'Dessert', 354622d9-6f0b-4066-b603-9dfc09b8e530, '2025-09-26T16:08:00.193798', [{'ingredient_id': '8078348c-0f59-416e-a640-d353bb267595', 'quantite': '200 g'}, {'ingredient_id': '03f44465-0f13-48d5-996d-89e19cd0b2b9', 'quantite': '3'}, {'ingredient_id': 'bfdc8a96-52c5-4f4f-96a8-4a6f2c17d496', 'quantite': '25 cl'}, {'ingredient_id': '6ad25816-3fed-42e5-b07f-ebadeb7e53cc', 'quantite': '6'}, {'ingredient_id': 'bf62ac0d-b546-4c2e-a385-49145e2ef4d4', 'quantite': '2'}, {'ingredient_id': 'e60ff552-2753-4f25-bd8e-441de81bda40', 'quantite': ''}, {'ingredient_id': '98338a78-c509-425e-9ab6-8b789f0b723d', 'quantite': '30 g'}, {'ingredient_id': '09b6493a-d4cc-4d94-b7fd-454f9a2ab4f6', 'quantite': '40 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (318806, 'Compote mangue, banane & kiwi', 'mangue, banane, kiwi, cannelle, sucre roux', '10 min', ['Éplucher les kiwis puis les couper en dés.', 'Éplucher la mangue et détailler la chair en petits morceaux.', 'Éplucher la banane et la couper en rondelles.', 'Dans une casserole, mettre les fruits, la cannelle et le sucre roux.', 'Couvrir la casserole et laisser mijoter à feu doux pendant 10 / 15 min. Remuer régulièrement.', 'Mixer le tout et laisser refroidir à température ambiante.', 'Verser dans des coupelles et placer au réfrigérateur.'], ['Moule à tarte', 'Pince de cuisine', 'Mixeur'], ['entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'banane & kiwi', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cannelle', 'compote de banane', 'cocktail', 'sucre roux', 'Compote mangue'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:08:04.269449', [{'ingredient_id': '851f231d-87de-41dc-9fd3-0b4203abf3c2', 'quantite': '1'}, {'ingredient_id': 'ad84d2de-5f63-4ad1-8ba6-f596a3478200', 'quantite': '1'}, {'ingredient_id': 'e48f79b2-fd4e-4019-afc8-f71ef559c4dd', 'quantite': '2'}, {'ingredient_id': '7733601d-476e-44f1-806e-f000a18d3396', 'quantite': '1'}, {'ingredient_id': '4b8598c0-ac7a-4cc1-b320-acaec8de5155', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (347547, 'Smoothie aux baies', 'framboises, banane, orange, lait de soja, gingembre, extrait de vanille', '5 min', ['Eplucher la banane et l''orange et les couper en morceaux. ', 'Placer tous les fruits dans le blender, ajouter le lait de soja, la vanille et le gingembre et mixer le tout. ', 'Servir tout de suite dans un grand verre.'], ['Râpe', 'Poêle', 'Presse-agrumes', 'Économe', 'Batteur électrique'], ['gingembre', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'extrait de vanille', 'très facile', 'framboises', 'bon marché', 'rapide', 'plat', 'Smoothie aux baies', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'orange', 'lait de soja', 'smoothies', 'cocktail'], 'Boisson', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T16:08:07.979903', [{'ingredient_id': 'c64ec0c6-f25d-4f2a-a8ca-ce67e8d85163', 'quantite': '200 g'}, {'ingredient_id': 'dcf4b2d1-9fe3-4e4b-b3ca-c9335ea31774', 'quantite': '1'}, {'ingredient_id': '0968f8a5-8b83-4986-91e6-2094926afd60', 'quantite': '1'}, {'ingredient_id': 'd646955e-8b73-4aa9-90c7-aedcfc5fae77', 'quantite': '20 cl'}, {'ingredient_id': '16bfdeda-0eae-4289-97c1-3885bffb55df', 'quantite': '2'}, {'ingredient_id': 'd207c21f-15be-4649-8dbe-c30746e0fa25', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (15346, 'Banoffy / banoffee pie (Angleterre)', 'pâte brisée, banane, sucre, crème chantilly, amandes, lait concentré sucré, café en poudre', '180 min', ['Mettez la boite de lait au bain marie pendant deux heures minimum (le lait prend une couleur café). Laissez refroidir.', 'Placez la pâte brisée dans un moule à cake rond en métal puis faites cuire à blanc au four aveugle.', 'Après cuisson, laissez refroidir la pâte, puis mettez-y le lait de la boîte, les bananes en rondelles en couches, puis la crème fouettée avec le sucre (une bonne couche). Saupoudrer avec un peu de nescafé et les amandes rôties. Placez au réfrigérateur.'], ['Économe', 'Moule à tarte', 'Verre doseur', 'Batteur électrique', 'Spatule'], ['', 'amandes', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Banoffy / banoffee pie (Angleterre)', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'pâte brisée', 'recettes', 'lait concentré sucré', 'boisson', 'crème chantilly', 'café en poudre', 'dessert', 'plat de résistance', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:08:11.670603', [{'ingredient_id': '4a98cb36-4413-473c-b56f-f52686342c33', 'quantite': '1'}, {'ingredient_id': '44e0b3bc-e112-4fb7-ae3d-df14b47fcc73', 'quantite': '3'}, {'ingredient_id': 'f95e2fa4-64d9-4630-8b9f-d1c52f7daf2e', 'quantite': ''}, {'ingredient_id': '0e85dd0a-b2ca-4901-a9f4-f8cb81af726a', 'quantite': '20 cl'}, {'ingredient_id': 'bec64c49-1c2a-47c1-8369-841bb0bbfdfc', 'quantite': ''}, {'ingredient_id': 'dcc4a025-b6e0-4927-998e-fbe3e39e67ea', 'quantite': '1'}, {'ingredient_id': '351f7122-9d91-422e-9636-16b3d5a2ff5a', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (42688, 'fruits exotiques façon crumble', 'ananas, banane, litchi, mangue, pomme, sucre vanillé, rhum, cassonade, farine, mascarpone, noix de coco rapée', '20 min', ['Mélanger le sucre vanillé et les fruits, les laisser mariner à température ambiante.', 'Bien mélanger la farine, le sucre et la noix de coco, puis rajouter le mascarpone avec une fourchette jusqu''à obtention d''une pâte sablée.', 'Disposer le fruits dans le plat puis recouvrir de la pâte sablé émiettée.', 'Mettre au four à 180°C (thermostat 6) pendant 30 min environ.', 'Sortir quand la pâte est bien dorée.'], ['Pince de cuisine', 'Moule à tarte', 'Casserole', 'Râpe'], ['entrée', 'banane', 'recettes de cuisine', 'mascarpone', 'rhum', 'confiserie', 'testées', 'cassonade', 'très facile', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'noix de coco rapée', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'fruits exotiques façon crumble', 'autres crumbles', 'moyen', 'ananas', 'litchi', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:08:15.255156', [{'ingredient_id': '13d8ff57-712b-4a5a-ae23-3a3258eb088e', 'quantite': ''}, {'ingredient_id': 'cc5fc67c-16e1-472f-9a55-dc5cc9bded10', 'quantite': ''}, {'ingredient_id': '420c9536-b44a-4b89-89f2-12a910ffc8ad', 'quantite': ''}, {'ingredient_id': '5f2208aa-c1b6-4e96-aaff-8d0694f0c110', 'quantite': ''}, {'ingredient_id': '9f4350e7-5a31-4369-aaf4-201c38155d6c', 'quantite': '1'}, {'ingredient_id': '28fd6d3a-b9a0-4a6b-aff3-bbfb57ebbc2a', 'quantite': '1'}, {'ingredient_id': '1266b3a8-5254-4dd6-bfd6-c095cd970f12', 'quantite': '1 cuillères'}, {'ingredient_id': 'c3e94919-e8f6-40d9-ac3a-6c6402b0ce46', 'quantite': '150 g'}, {'ingredient_id': '75ef2fcc-debf-4581-a2b2-034c208ca859', 'quantite': '150 g'}, {'ingredient_id': 'd6c15820-b00c-4662-a71a-cc1fbbf8e5a3', 'quantite': '250 g'}, {'ingredient_id': '5bf2fd96-7d51-40d5-8e99-4bf02bb61ee2', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (29371, 'Cake des ïles', 'farine, sucre glace, beurre, oeuf, couteau, raisins secs, rhum, amandes en poudre, banane, ananas, chocolat amer, chocolat en poudre, arôme vanille', '30 min', ['Mettre le rhum et les raisins dans une petite casserole et porter à ébullition. ', 'Retirer du feu, couvrir et laisser infuser. ', 'Préchauffer le four à 240°C. ', 'Battre le beurre en pommade avec le sucre glace. ', 'Ajouter 1 oeuf. ', 'Mélanger mais ne pas trop travailler. ', 'Ajouter la poudre d''amandes. ', 'Incorporer peu à peu la moitié de la farine. ', 'Ajouter le 2ème oeuf. ', 'Puis le reste de la farine avec la levure et mélanger. ', 'Ajouter la vanille, tous les fruits secs, les raisins égouttés (réserver le rhum), les éclats de chocolat et le chocolat en poudre. ', 'Verser la préparation dans un moule à cake préalablement beurré. ', 'Mettre dans le four en mettant le Th sur 6 (180°C) pour 45 mn environ. ', 'Il faut vérifier la cuisson en plantant un petit pic en bois dans le cake. Il doit ressortir sec du gâteau. ', 'Sortir le gâteau du four et arroser immédiatement avec le rhum des raisins. ', 'Attendre 5 à 10 mn et démouler.'], ['Fouet', 'Tire-bouchon'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'facile', 'amandes en poudre', 'oeuf', 'plat', 'recette', 'Cake des ïles', 'cuisine', 'recettes', 'boisson', 'farine', 'couteau', 'dessert', 'plat de résistance', 'chocolat amer', 'arôme vanille', 'moyen', 'beurre', 'ananas', 'raisins secs', 'sucre glace', 'chocolat en poudre', 'cocktail'], 'Dessert', a4faa98f-e4ab-43e5-b739-7ef4a612a84b, '2025-09-26T16:08:18.975950', [{'ingredient_id': 'f135d72a-dfc9-4be1-8048-4d3042cbb30f', 'quantite': '100 g'}, {'ingredient_id': '20227d8f-d390-4398-b85a-a55ba616ffa3', 'quantite': '100 g'}, {'ingredient_id': 'eee2d020-210c-4878-b862-da207405910b', 'quantite': '100 g'}, {'ingredient_id': '9c77f5e5-2b88-4dc9-8f9e-5f90a405d896', 'quantite': '2'}, {'ingredient_id': '61b8e9f9-3d3f-4a6f-a6a7-13d98e99153a', 'quantite': '1'}, {'ingredient_id': 'c9082a75-ae98-417f-968d-fd1d873f7c5c', 'quantite': '25 g'}, {'ingredient_id': '947fe3ce-b2dd-4ccd-925c-42a6d0b2a68a', 'quantite': '25 g'}, {'ingredient_id': 'cd5912c0-03b7-4ee6-8306-ed7e38ad3047', 'quantite': '25 g'}, {'ingredient_id': 'e1b160fc-67d6-47d1-b93b-650d3176fffa', 'quantite': '30 g'}, {'ingredient_id': 'dc338ae8-d822-48ad-9a87-e07c89b32580', 'quantite': '30 g'}, {'ingredient_id': '82bf6570-8a04-4cbc-9b90-4a8f7582f502', 'quantite': '75 g'}, {'ingredient_id': '2738f471-e81b-47b5-bdd8-7a0819e8b4fc', 'quantite': '10 g'}, {'ingredient_id': '169d34a2-d93f-4eb9-a327-81d2845bab45', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (22437, 'Gratin de patates douces et bananes plantain', 'patate douce, crème fraîche épaisse, lait, ail, gruyère râpé, poivre, sel, muscade', '30 min', ['Plonger les patates et les bananes avec leur peau dans une casserole d`eau bouillante salée - retirer les bananes au bout de 5 min et finir la cuisson des patates (en général plus longues à cuire - tester avec la pointe d`un couteau) les légumes doivent être précuits seulement et rester fermes - Les égoutter, et les éplucher. ', 'Peler et dégermer la gousse d`ail. ', 'Dans un saladier mixer la crème, avec le lait, la gousse d`ail écrasée, sel, poivre, muscade. ', 'Couper les légumes en rondelles épaisses et disposer dans un plat à gratin, ajouter un peu de la préparation (crème + lait), recommencer l''opération jusqu''à remplir le plat.', 'Parsemer de gruyère et de muscade + quelques noix de beurre, puis enfourner environ 30 min à thermostat 7 (210°C) jusqu''à ce que le gratin soit doré. ', 'Servir avec un rôti de porc ou un gigot d''agneau, ou mieux encore un rôti de cerf.... Exotisme assuré!'], ['Moule à tarte', 'Ouvre-boîte'], ['entrée', 'recettes de cuisine', 'crème fraîche épaisse', 'sel', 'confiserie', 'testées', 'autre gratin de pommes de terre', 'Gratin de patates douces et bananes plantain', 'muscade', 'patate douce', 'très facile', 'bon marché', 'ail', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'gruyère râpé', 'dessert', 'plat de résistance', 'poivre', 'lait', 'cocktail'], 'Accompagnement', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:08:22.690331', [{'ingredient_id': '41a9d040-4542-4af0-ab0c-eb97fd68f1f8', 'quantite': '3'}, {'ingredient_id': '9ea5d7a7-d76e-4c1d-bf66-78b4e0d48905', 'quantite': '1'}, {'ingredient_id': '254e0023-a8e7-4adc-a541-6d1765e5aa1b', 'quantite': '1'}, {'ingredient_id': '668b03aa-ca02-4478-bc29-f628b9ab1345', 'quantite': '1'}, {'ingredient_id': '25ceb257-f320-47bc-93a3-5a899b47256a', 'quantite': '50 g'}, {'ingredient_id': 'f70d7efe-c29c-4b20-a2fa-18721d87a0ea', 'quantite': ''}, {'ingredient_id': '93c646b0-4f3b-4d44-8fa7-71309827da11', 'quantite': ''}, {'ingredient_id': '902f82aa-c5b3-4462-a6db-61e43e511d24', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (164952, 'Gâteau de pain chocolat banane', 'pain, oeuf, lait, banane, chocolat noir, miel', '15 min', ['- faire chauffer le lait avec le miel', '- couper le pain rassis en morceaux, le mettre dans un grand saladier', '- verser le lait chaud sur la pain, l''écraser', '- ajouter les 5 oeufs battus', '- ajouter les bananes coupées en lamelles', '- bien mélanger', '- mettre le tout dans un plat préalablement beurré et fariné', '- couper le chocolat en cerré et les répartir en les piquant dans la préaparation', '- 30mn à 180°'], ['Pince de cuisine', 'Économe', 'Couteau de chef', 'Moule à tarte'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat noir', 'Gâteau de pain chocolat banane', 'gâteau au chocolat', 'lait', 'pain', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:08:26.288810', [{'ingredient_id': '0eae2dbc-be6e-440a-89db-39cf63152296', 'quantite': '400 g'}, {'ingredient_id': '8187f4e1-7617-4ae1-8fd8-39ff432dee95', 'quantite': '5'}, {'ingredient_id': 'ae8c05fd-96b5-4237-bf0f-f18cca0c1ef6', 'quantite': '1 l'}, {'ingredient_id': 'dd4cf3a6-685d-4438-a48b-939f6fbbc129', 'quantite': '3'}, {'ingredient_id': '58d4d22a-f9aa-475b-b1af-7b5f9ef0c13d', 'quantite': ''}, {'ingredient_id': 'f222aa42-432f-4d5a-aecd-14c2deb833d5', 'quantite': '4 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (344335, 'Rouleaux de pain perdu à la banane', 'pain, oeuf, lait, sucre vanillé, banane, sucre', '6 min', ['Aplatir les 4 tranches le plus fin possible au rouleau à pâtisserie.', 'Mélanger au fouet le lait, l''oeuf et le sucre.', 'Repartir la banane sur une moitié de chaque tranche, en écrasant.', 'Rouler les tranches sur elles-mêmes et les placer dans un récipient plat.', 'Verser le mélange dessus et faire imbiber, pas trop longtemps, les rouleaux, puis disposer sur une poêle assez chaude.', 'Faire cuire 1 min sur les quatre faces.', 'Retirer du feu et saupoudrer l''ensemble avec le sucre (ne pas trop en mettre sauf si vous raffolez du sucré...).', 'Manger aussitôt.'], ['Batteur électrique', 'Pince de cuisine', 'Casserole'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'Rouleaux de pain perdu à la banane', 'testées', 'très facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Pain perdu', 'dessert', 'plat de résistance', 'sucre vanillé', 'lait', 'pain', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:08:29.898565', [{'ingredient_id': 'c2aa6169-98dd-42fc-961a-dea882865a0a', 'quantite': '4'}, {'ingredient_id': '71426fb8-a7da-4228-8beb-5f66065f4901', 'quantite': '1'}, {'ingredient_id': 'c13e889d-e833-4111-8d76-2ae50ee7e88c', 'quantite': '3 cuillères'}, {'ingredient_id': '9896bf33-416d-4d44-939f-8a506a56b042', 'quantite': '1'}, {'ingredient_id': 'c6d9d284-7d71-43ec-b2ff-50e578a5b77e', 'quantite': '1'}, {'ingredient_id': '9fa8af7b-951b-4fbc-beea-da67804998fc', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (69529, 'Sauce au concombre et à la banane', 'ail, concombre, fromage blanc, huile d''olive, piment, banane, poivre, sel', '10 min', ['Mixez tous les ingrédients ensemble. Ajustez l''huile, le piment, le sel et le poivre selon vos goûts. La texture doit être douce, mais pas liquide. N''hésitez pas à mettre beaucoup d''huile.', 'Mélangez aux pâtes, riz...'], ['Tire-bouchon', 'Poêle', 'Spatule', 'Ouvre-boîte', 'Batteur électrique'], ['', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'ail', 'rapide', 'plat', 'recette', 'piment', 'cuisine', 'recettes', 'boisson', 'fromage blanc', 'huile d''olive', 'Sauce au concombre et à la banane', 'dessert', 'plat de résistance', 'concombre', 'poivre', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:08:33.558737', [{'ingredient_id': '3ad55064-de7d-425a-8ce9-a62262d8d9a9', 'quantite': '1'}, {'ingredient_id': '34848dc3-c1da-441b-a58a-d203a9c98333', 'quantite': '1'}, {'ingredient_id': '7641e1c3-e920-4418-b43d-7e650d7d6469', 'quantite': '2 cuillères'}, {'ingredient_id': '828aeb35-5228-4434-8157-3dd8eee3ba23', 'quantite': '2 cuillères'}, {'ingredient_id': '4f1f79cd-b34a-4b1a-92dc-b83edc65bdb9', 'quantite': '1'}, {'ingredient_id': '668180fd-d406-47b1-ad42-c2f6e30bcaad', 'quantite': ''}, {'ingredient_id': 'b7a87518-e456-40fb-8608-445fa8777108', 'quantite': ''}, {'ingredient_id': '6b3276ce-947f-490b-a645-b5d9d9298b13', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (86806, 'Bricks gourmande à la banane', 'banane, brick, chocolat pâtissier, crème chantilly, rhum, beurre', '20 min', ['Eplucher et couper les bananes en rondelles. Dans une poêle, les faire cuire jusqu''à ce qu''elles commencent à se réduire en compote. Les flamber au rhum. Laisser refroidir.', 'Casser la tablette de chocolat dans un bol, puis faire fondre au micro-onde sans rien ajouter.', 'Partager les bananes en 6 parts à disposer au centre de chaque feuille de brick. Ajouter du chocolat fondu sur les bananes (selon votre gourmandise).', 'Fermer les feuilles de brick en pyramides (vous pouvez attacher la pointe avec de la ficelle de cuisine pour qu''elles gardent leur forme).', 'Les passer au four 5 minutes le temps que les feuilles de brick durcissent.', 'Rajouter pour la déco (ou la gourmandise) un filet de chocolat fondu sur les feuilles brick et de la chantilly à volonté !', 'C''est prêt !'], ['Pince de cuisine', 'Verre doseur', 'Passoire', 'Tire-bouchon'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'assez cher', 'très facile', 'plat', 'recette', 'chocolat pâtissier', 'cuisine', 'brick', 'recettes', 'boisson', 'crème chantilly', 'dessert', 'plat de résistance', 'beurre', 'Bricks gourmande à la banane', 'cocktail'], 'Dessert', 56d64361-bef1-483b-9b9d-bf6f9a0e3963, '2025-09-26T16:08:37.331918', [{'ingredient_id': '7bce099f-52d0-4425-b1a6-d6067aa6c4ec', 'quantite': '6'}, {'ingredient_id': '11c425d7-2101-40af-a252-67cd950ef193', 'quantite': '6'}, {'ingredient_id': '190f68b3-635d-46a8-8889-47c317ceb1ae', 'quantite': '1'}, {'ingredient_id': '8da698cd-6d57-41e8-9c0c-69147571643c', 'quantite': '1'}, {'ingredient_id': 'e39a47e3-d4ee-4e3b-a8b1-e1506c2bdabb', 'quantite': '1'}, {'ingredient_id': '35a4e8dc-b5bd-4698-9739-a8a591fb744b', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (225196, 'Bûche flambée au citron meringuée', 'oeuf, sucre, maïzena, farine, citron, citron vert, pêche, banane, pamplemousse, limoncello, manzana, extrait de vanille, sucre vanillé, gélatine, beurre tendre, combava, framboises', '180 min', ['Matériel nécessaire :', 'papier sulfurisé', 'film alimentaire', 'plaque de patisserie', 'robot', 'chinois', 'fouet', 'thermomètre de cuisson', 'balance', 'La liste des ingrédients étant longue, ils sont redistribués en fonction des différentes étapes.', '1ère étape, sirop à 30°', '- 350 g de sucre', '- 26 cl d''eau', 'Mettre dans une casserole puis amener à ébullition. Arrêter dès le premier bouillon.', '2ème étape, le punch aux fruits', '- les oreillons de pêche', '- 1/2 banane', '- le jus du pamplemousse', '- le limoncello', '- la manzana', '- sirop à 30° réalisé juste avant', 'Découper les fruits en morceaux, mettre le tout dans une casserole. Porter le tout à ébullition et mixer. Passer au chinois pour retirer les petits morceaux non mixés.', '3ème étape, le biscuit de Savoie', '- 4 jaunes d''oeuf', '- 4 blancs d''oeuf', '- 125 g sucre', '- 30 g maïzena', '- 60 g farine', '- zeste de citron jaune', 'Blanchir les jaunes oeufs avec une partie du sucre (1/3) en fouettant. Ajouter les zestes de citron jaune et fouetter. Monter les blancs d''oeufs avec une partie du sucre (2/3). Verser la dernière partie du sucre (3/3) en pluie sur les blancs à la fin du montage. Incorporer une partie des blancs montés dans le mélange jaune et mélanger délicatement à l''aide d''une Maryse. Tamiser la farine et la maïzena. Incorporer les farines au mélange. Mélanger délicatement à la Maryse. Ajouter la seconde partie des blancs montés dans le mélange jaune et mélanger délicatement à la Maryse. Etaler sur la plaque chemisée, mettre au four à 180°C (thermostat 6) pendant 7 min. Filmer le biscuit dès la sortie du four.', '4ème étape, la crème au citron', '- 15 cl de jus de citron jaune (2 ou 3 citrons)', '- extrait de vanille', '- zeste de citron jaune (1 citron)', '- zeste de citron vert (1 citron)', '- 1 sachet de sucre vanillé', '- la gélatine', '- 2 oeufs + 1 jaune', '- 90 g sucre', '- 80 g de beurre mou', '- 10 g de maïzena', 'Hydrater la gélatine. Laver les citrons. Récupérer les zestes d''1 citron jaune et d''1 citron vert avec une râpe fine (attention à ne pas prendre la partie blanche du citron qui est amère). Dans une casserole, porter à ébullition le jus de citron avec les zestes, l''extrait de vanille et sucre vanillé et le beurre. Laisser infuser 5 minutes,', 'mélanger rapidement au fouet les oeufs, le sucre et la maïzena (préalablement mélangée à un peu d''eau pour éviter les grumeaux).', 'Incorporer une moitié du mélange chauffé (en le passant au chinois) et mélanger. Incorporer le reste du mélange chauffé (en le passant au chinois) et mélanger.', 'Reverser le tout dans la casserole. Recuire le tout à ébullition en fouettant à feu moyen. Arrêter la cuisson dès l''ébullition, incorporer la gélatine égouttée et mélanger. Mixer (pour plus d''homogénéité), débarrasser dans un récipient en plastique et filmer.', '5ème étape : la meringue italienne au combava', '- 100 g de blanc d''oeufs', '- 50 g eau', '- 180 g sucre', '- poudre de combava', 'Chauffer l''eau et le sucre (et le glucose) à 118°C. Monter les blancs d''oeufs en neige. Lorsqu''ils sont presque prêts, ajouter en filet le sirop chaud puis la poudre de combava. Réserver au frais.', '6ème étape : le montage ', 'Démouler le biscuit sur une feuille de papier sulfurisé. Imbiber au pinceau le biscuit de punch aux fruits. Etaler la crème au citron dessus puis mettre au réfrigérateur pendant 20 minutes.', 'Parsemer de brisures de framboises.', 'Rouler la buche à l''aide du papier sulfurisé puis replacer au réfrigérateur pendant 20 minutes.', 'Etaler la meringue, flamber et décorer.'], ['Pince de cuisine', 'Louche', 'Passoire'], ['entrée', 'banane', 'recettes de cuisine', 'manzana', 'confiserie', 'testées', 'beurre tendre', 'extrait de vanille', 'framboises', 'maïzena', 'oeuf', 'limoncello', 'plat', 'recette', 'Bûche flambée au citron meringuée', 'autres bûches', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'pamplemousse', 'sucre vanillé', 'combava', 'difficile', 'moyen', 'gélatine', 'citron', 'citron vert', 'pêche', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:08:42.461696', [{'ingredient_id': '88e6ea45-20ea-434b-b7ce-89241cb56107', 'quantite': '12'}, {'ingredient_id': '64dfced7-d680-43af-b62c-9267b347ad31', 'quantite': '465 g'}, {'ingredient_id': '59f99bae-b1ba-4f5b-9052-ed71538f1766', 'quantite': '40 g'}, {'ingredient_id': '9507d072-7055-495a-b7f1-bc76358bd9db', 'quantite': '60 g'}, {'ingredient_id': '53ece25f-b6d1-45b1-a932-027bb25b3970', 'quantite': '4'}, {'ingredient_id': '9d091759-50f0-4d03-b6ca-3031fbe7a115', 'quantite': '1'}, {'ingredient_id': 'fa2eceed-8ef4-4928-be87-16ae17472364', 'quantite': '1'}, {'ingredient_id': '3d017726-7599-4650-a401-eabfe130d994', 'quantite': '1'}, {'ingredient_id': 'bae75268-d4eb-41c3-8d99-09c9251f35f0', 'quantite': '1'}, {'ingredient_id': '6bf4a55a-a92e-4fc3-afa5-4d3fdf393531', 'quantite': '1 cuillères'}, {'ingredient_id': '5c18c53e-ca7c-418a-be0c-5c6b59cf38c2', 'quantite': '1 cuillères'}, {'ingredient_id': 'e003b5ca-4438-4e61-b8b7-51b87a415e72', 'quantite': ''}, {'ingredient_id': '6f6be071-2794-42b3-b7bb-187303845651', 'quantite': ''}, {'ingredient_id': '254a7911-3ddf-4d1b-9537-caa1ba579749', 'quantite': '2'}, {'ingredient_id': '912ecc7b-42dc-4df2-9ef9-480bed67eaff', 'quantite': '80 g'}, {'ingredient_id': '30ca0a51-8435-4ead-8ba7-70b60e011267', 'quantite': ''}, {'ingredient_id': 'c2e9fe0b-d9be-46de-a20d-db6c67f819f3', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (90116, 'Muffins à la banane version light', 'farine complète, farine, maïs, levure chimique, cannelle, cerneau de noix, banane, compote, lait écrémé, oeuf, édulcorant', '20 min', ['Préchauffez le four à 180°C (thermostat 6). ', 'Dans un récipient, mélangez les ingrédients secs : les trois farines, la levure, la cannelle, les cerneaux de noix et le sel. ', 'Dans un autre récipient, écrasez les bananes grossièrement, et ajoutez à fur et à mesure les autres ingrédients liquides.', 'Ajoutez les ingrédients secs aux ingrédients liquides et mélangez rapidement. Ne travaillez pas trop la pâte, elle risque de moins monter une fois dans le four : quelques coups de fouet suffisent pour avoir une base relativement homogène.', 'Beurrez votre moule à muffins (inutile si vous utilisez ces petites formes en papier de cuisson) et remplissez-le à 3/4 de la hauteur avec la pâte. Mettez au four pendant 25 minutes à 180°C (thermostat 6). '], ['Pince de cuisine', 'Mixeur', 'Tire-bouchon'], ['entrée', 'banane', 'recettes de cuisine', 'cerneau de noix', 'confiserie', 'lait écrémé', 'testées', 'levure chimique', 'très facile', 'bon marché', 'oeuf', 'plat', 'édulcorant', 'recette', 'compote', 'cuisine', 'recettes', 'boisson', 'farine', 'Muffins à la banane version light', 'dessert', 'plat de résistance', 'muffin', 'maïs', 'farine complète', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:08:47.171376', [{'ingredient_id': 'dc139e04-86f5-49f9-8ffd-48fef29d7578', 'quantite': '170 g'}, {'ingredient_id': '2c8ab55b-d4ef-4274-a101-b1548e946888', 'quantite': '50 g'}, {'ingredient_id': 'eea14125-80f1-419b-9a6a-ee433285a19b', 'quantite': '30 g'}, {'ingredient_id': '735ecd13-da31-40eb-bbb0-9a2a6b7c462b', 'quantite': '3 cuillères'}, {'ingredient_id': '3adb8945-6ee1-4280-9f9c-45c990e11dfd', 'quantite': '1 cuillères'}, {'ingredient_id': '8c9112d9-f438-4f89-9100-d62fbd5bceeb', 'quantite': '50 g'}, {'ingredient_id': '59b64bae-7f7d-4ce8-b6b1-a06e9de05edc', 'quantite': '2'}, {'ingredient_id': '2ebf5bc1-b4cd-4fb4-859a-93e4ad5dd55d', 'quantite': '1'}, {'ingredient_id': '69add612-bc35-4ed7-a0ff-19ca84b746d8', 'quantite': '100 ml'}, {'ingredient_id': '64f5614a-3087-4a2a-875d-63b57bbe5b2c', 'quantite': '2'}, {'ingredient_id': '58c14a3c-f0f9-4844-a560-369926a557ba', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (167158, 'Tarte à la banane au chocolat caché', 'pâte feuilletée, chocolat noir, oeuf, sucre, farine, amandes en poudre, cannelle, vanille, banane, citron', '20 min', ['Battre le blanc d''œuf en ligne.', ' Mélanger le jaune d''œuf avec le sucre,la cannelle,le zeste de citron,la poudre d''amande et l''essence de vanille.', ' Bien mélanger jusqu''à obtention d''une pâte uniforme.', ' Étaler la pâte feuilletée sur un moule à tarte.puis piquer légèrement.', ' Répandre le chocolat coupé en morceaux dessus.', ' Couper les bananes en rondelles et les disposer sur l''ensemble de la pâte pour couvrir entièrement le chocolat pour le cacher entièrement.', ' Verser la préparation liquide dessus', ' Mettre la tarte au four à 180°C durant 15 min jusqu''à coloration de la tarte.'], ['Casserole', 'Pince de cuisine', 'Râpe', 'Poêle'], ['entrée', 'tarte au chocolat', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'amandes en poudre', 'oeuf', 'plat', 'recette', 'cuisine', 'Tarte à la banane au chocolat caché', 'recettes', 'boisson', 'farine', 'vanille', 'dessert', 'plat de résistance', 'chocolat noir', 'pâte feuilletée', 'citron', 'cannelle', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:08:50.819372', [{'ingredient_id': '9e66d24d-db40-4b10-916f-1dbc4e0c8536', 'quantite': '1'}, {'ingredient_id': '59502165-ecca-4dfc-9535-a1f43ce56103', 'quantite': '100 g'}, {'ingredient_id': '82f42e83-699b-460e-8c81-b93c2cb1fdac', 'quantite': '1'}, {'ingredient_id': '0892bcf9-094e-4629-bac1-575798775589', 'quantite': '50 g'}, {'ingredient_id': '4619a713-f653-4a7d-8da0-3419c5fa2c68', 'quantite': '50 g'}, {'ingredient_id': 'd025e4bf-268b-4688-a011-a2dfe267feac', 'quantite': '25 g'}, {'ingredient_id': '27ceee88-0b7f-4adc-ba0e-58174df743a0', 'quantite': '1 cuillères'}, {'ingredient_id': 'e1c428b6-170c-4815-95b9-c7309df4f9c6', 'quantite': '1 cuillères'}, {'ingredient_id': 'c4212963-c44b-416e-8a2e-3a786da94e07', 'quantite': '2'}, {'ingredient_id': '08d4cb3f-da42-4d58-9c3f-0020755e48ee', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (93668, 'Cake banane coco choco', 'chocolat, noix de coco, levure, sel, sucre, beurre, farine, oeuf, banane', '20 min', ['-Préchauffez le four à th6 (180).', '-Travaillez le beurre et le sucre dans un saladier.', '-Mélanger dans un autre saladier la farine, la levure, le sel.', '-Ajoutez la farine, la levure et le sel en pluie dans la pâte.', '-Incorporez la banane écrasée, pépites de chocolat, et la noix de coco.', '-Mélanger et remplissez le moule.', 'Mettez à cuire 45mn à 1h environ.'], ['Planche à découper', 'Casserole', 'Mixeur'], ['Cake banane coco choco', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'chocolat', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'autres cakes', 'dessert', 'plat de résistance', 'beurre', 'noix de coco', 'sucre', 'cocktail'], 'Dessert', 0c362b0f-9cf3-4623-94e2-dac75b1296df, '2025-09-26T16:08:54.412606', [{'ingredient_id': '99990db1-a82f-416c-bff1-599b1ec83b58', 'quantite': '80 g'}, {'ingredient_id': 'd776a5ce-0ca9-435e-a122-35c26b1609c9', 'quantite': ''}, {'ingredient_id': 'fc81a7a9-e533-4172-aa8e-d759c6c2edca', 'quantite': ''}, {'ingredient_id': '3df570ca-d44d-429c-a19c-6be77c3f341a', 'quantite': ''}, {'ingredient_id': 'd90ef56f-fc94-419a-9733-37ff6f68fd84', 'quantite': '150 g'}, {'ingredient_id': '289d1494-f2b7-4b2d-91cb-89f95a6e0354', 'quantite': '150 g'}, {'ingredient_id': '129b94c6-88c2-4004-90a4-a91850245fe4', 'quantite': '200 g'}, {'ingredient_id': '15f909b8-136a-42a4-9652-239b3d6e2b92', 'quantite': '3'}, {'ingredient_id': '3417779b-11ae-4b2d-b6d7-ada9d113f907', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (319591, 'Tarte fraise banane crumble simple', 'pâte sablée, fraises, banane, farine, sucre roux, beurre, amandes en poudre, lait, oeuf, beurre, sucre vanillé', '20 min', ['Étaler la pâte dans un moule adapté. La cuire 10 min dans un four à 200°C (thermostat 6/7).', 'Couper les fraises et bananes en rondelles et les placer sur la pâte préalablement cuite.', 'En parallèle, préparer le crumble en mélangeant le beurre fondu, le sucre, la poudre d''amande, et la farine.', 'Pour le liant faire fondre les 15 g de beurre (pas obligatoire) et faire chauffer à feu doux avec le lait, la gousse de vanille et le sucre roux. Ajouter les oeufs un par un en mélangeant doucement avec un fouet. ', 'Ajouter une cuillère à soupe de farine et remuer en permanence.', 'Dès que la crème prend, verser le liant sur la tarte.', 'Finir en recouvrant de la préparation à crumble repartie de façon homogène.', 'Mettre 15 à 20 min au four à 220°C (thermostat 6/7) et sortir quand le crumble est doré.', 'Servir chaud ou froid, avec de la glace à la vanille pour les gros gourmands...'], ['Spatule', 'Verre doseur', 'Balance de cuisine', 'Planche à découper', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'pâte sablée', 'plat', 'fraises', 'recette', 'cuisine', 'tarte aux fraises', 'recettes', 'boisson', 'dessert', 'Tarte fraise banane crumble simple', 'plat de résistance', 'cocktail'], 'Dessert', 8c5da1c5-1448-4aa4-9020-3c55c8e4cb91, '2025-09-26T16:08:58.003034', [{'ingredient_id': '3735a065-37b6-4a97-a073-fc42ac1c10e2', 'quantite': '1'}, {'ingredient_id': '08be393d-4e5b-40c5-96f6-1f1f3cf8b3cc', 'quantite': '250 g'}, {'ingredient_id': '01b30dea-19c9-4921-ba0f-94e81241f99f', 'quantite': '3'}, {'ingredient_id': 'f903f701-42af-4343-b764-aa82e52d56cd', 'quantite': '90 g'}, {'ingredient_id': '0f485fdb-c42a-4770-be58-39dd6b8f6577', 'quantite': '50 g'}, {'ingredient_id': '611ce68e-227c-4355-82d0-9823cf1da23c', 'quantite': '50 g'}, {'ingredient_id': '3bce2438-88cd-4ade-8b5c-35bb84460608', 'quantite': '50 g'}, {'ingredient_id': '00fd847c-bcb4-4893-94d0-cba8a1374c90', 'quantite': '25 cl'}, {'ingredient_id': '648d6060-9952-482f-b174-efac98063870', 'quantite': '2'}, {'ingredient_id': '5585ad7a-15ae-4d7e-af51-82b00dca5717', 'quantite': '15 g'}, {'ingredient_id': '58c8f07f-ef0f-4ee5-baee-dae50f0c8f3a', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (212552, 'Muffins bananes au coeur biolette', 'sucre, oeuf, farine, levure, banane, beurre, bonbons à la violette', '25 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Faire fondre le beurre au micro-ondes, puis y ajouter le sucre et les œufs. Écraser les bananes et les incorporer à la préparation.', 'Mettre ensuite la levure et la farine dans le saladier.', 'Dans des petits moules à muffins, verser une cuillère de pâte, ajouter un bonbon à la violette, puis recouvrir d''une cuillère de pâte. ', 'Enfourner pour 20 minutes de cuisson.'], ['Pince de cuisine', 'Balance de cuisine', 'Moule à tarte'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'Muffins bananes au coeur biolette', 'bonbons à la violette', 'dessert', 'plat de résistance', 'muffin', 'beurre', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:09:02.728789', [{'ingredient_id': '03f9b7ad-ac6a-4afc-b980-f24a749d758f', 'quantite': '340 g'}, {'ingredient_id': '346f50fc-c83e-42dd-8c19-33b644edfd04', 'quantite': '3'}, {'ingredient_id': '1e98ab06-3bc3-4b95-94b7-608e781f9ce1', 'quantite': '290 g'}, {'ingredient_id': '148c43ca-2431-47c8-9e5f-a7151f9187e2', 'quantite': '1'}, {'ingredient_id': 'eb4deb48-435c-4693-b01c-ef1aeca2dde5', 'quantite': '4'}, {'ingredient_id': '441d8aca-2ee3-487a-a82a-e1ebc2ff3333', 'quantite': '170 g'}, {'ingredient_id': '5eb01755-b7c3-4d5e-b8af-792a7e81e2e4', 'quantite': '25'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (165463, 'Sauce froide à la banane et au curry', 'banane, citron vert, fromage blanc, curry, sel, poivre', '5 min', ['Eplucher les bananes et les écraser très finement.', 'Mélanger les bananes écrasées, le jus de citron vert, le fromage blanc et le curry.', 'Eventuellement mixer le tout.', 'Saler et poivrer.', 'Tenir au frais.'], ['Planche à découper', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'Autres sauces', 'recette', 'cuisine', 'recettes', 'boisson', 'fromage blanc', 'dessert', 'plat de résistance', 'citron vert', 'poivre', 'curry', 'Sauce froide à la banane et au curry', 'cocktail'], 'Sauce', efa21c65-2f56-493b-9736-d4795be507e6, '2025-09-26T16:09:06.328234', [{'ingredient_id': '6ff8e02a-fec8-4f51-8188-3d3f55517e20', 'quantite': '2'}, {'ingredient_id': 'cee05693-e8de-40c4-8aed-e7f272864e52', 'quantite': ''}, {'ingredient_id': '12b5f2e1-faeb-452f-9b3f-a36d6b9e9c44', 'quantite': '200 g'}, {'ingredient_id': 'febb501b-c160-48c1-811a-1fefc2702a40', 'quantite': '2 cuillères'}, {'ingredient_id': '9340e65b-58f3-459b-b212-b1b2d4c287f5', 'quantite': ''}, {'ingredient_id': 'ef3c45ef-5cc6-4891-94b9-d8b65f720a5b', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (30363, 'Panade pour bébé gourmand', 'banane, lait, cacao', '2 min', ['Coupez en rondelles les deux bananes et mettez-les dans un bol.', 'Ajoutez-y la cuillerée de lait et les trois de cacao.', 'Ensuite écrasez et mélangez. La panade est prête!'], ['Tire-bouchon', 'Économe', 'Presse-agrumes', 'Couteau de chef', 'Mixeur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'cacao', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Panade pour bébé gourmand', 'dessert', 'plat de résistance', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:09:09.858544', [{'ingredient_id': '58a265c4-135f-4ba4-a659-e8a3732c27a6', 'quantite': '2'}, {'ingredient_id': '41036ae0-d3e1-464d-8a1a-551c9146a3e3', 'quantite': '1 cuillères'}, {'ingredient_id': 'aa51c876-68f9-4844-a48c-77d45c473ed6', 'quantite': '3 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (382915, 'Mug cake vegan', 'farine, sucre, chocolat en poudre, lait végétal, huile d''olive, banane', '5 min', ['Mélanger les ingrédients secs dans une tasse.', 'Rajouter le lait et l''huile progressivement en continuant à mélanger.', 'Incorporer la moitié d''une banane préalablement écrasée à la préparation.', 'Mettre au four à micro-ondes pendant 3 minutes, puis laisser refroidir 5 minutes.'], ['Planche à découper', 'Mixeur', 'Tire-bouchon', 'Couteau de chef'], ['lait végétal', 'entrée', 'Mug cake vegan', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'amuse-bouche au saumon', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'huile d''olive', 'dessert', 'plat de résistance', 'chocolat en poudre', 'sucre', 'cocktail'], 'Dessert', 054b4441-b938-42d7-aebc-c9bcf674fa23, '2025-09-26T16:09:13.398134', [{'ingredient_id': '8574d903-416f-4fc0-bda9-8f193d619545', 'quantite': '4 cuillères'}, {'ingredient_id': '034b6469-4557-420e-86e6-68746d9af6ac', 'quantite': '3 cuillères'}, {'ingredient_id': '44ed023f-6855-41a8-ad8e-fae6e82604c1', 'quantite': '4 cuillères'}, {'ingredient_id': '18a9ebe3-5991-4c3e-9f6f-5e2ac119d6df', 'quantite': '3 cuillères'}, {'ingredient_id': '5141bf58-cde3-4d41-ae77-dc36ef816498', 'quantite': '1 cuillères'}, {'ingredient_id': '57e3d1d2-bb76-4aa0-ba91-551d41fc4772', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (45575, 'Pancakes à la banane', 'farine, lait, banane, oeuf, levure, sucre, beurre', '5 min', ['Dans un blender, mélanger rapidement les oeufs, la banane, la farine, 2 pincées de sel, la levure, le lait et le beurre fondu.', 'Laisser reposer 30 min.', 'Faites chauffer une poêle à crêpes. Verser des petites louches de pâte, dès que les bulles apparaissent, retourner le pancake et laisser le cuire quelques secondes.', 'Servir tiède, accompagné de sirop d''érable ou de beurre.'], ['Presse-agrumes', 'Économe', 'Planche à découper'], ['Pancakes à la banane', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'pancake', 'très facile', 'bon marché', 'rapide', 'oeuf', 'plat', 'recette', 'levure', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'beurre', 'lait', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:09:20.355699', [{'ingredient_id': 'c9a75cfa-f255-432d-9a20-c56392917d36', 'quantite': '250 g'}, {'ingredient_id': '0ef9bb11-c5a1-49fe-b418-16d8b76f81fb', 'quantite': '50 cl'}, {'ingredient_id': '854d039a-3ff3-418d-a3fa-8bc9ba83cc7e', 'quantite': '1'}, {'ingredient_id': 'f5efa726-485b-4ced-9e64-53ad29b24bde', 'quantite': '3'}, {'ingredient_id': 'bf3acf7f-d992-40f3-a72b-7d5d242e8d6a', 'quantite': '1 cuillères'}, {'ingredient_id': 'c9de0b44-6d95-43d7-ac14-0456e5d26e8e', 'quantite': '1'}, {'ingredient_id': '224ddbf4-26e6-4643-bb74-8f2515fa8799', 'quantite': '30 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (36076, 'Bananes flambées à la confiture de lait', 'banane, rhum, confiture de lait, glace à la noix de coco', '10 min', ['Couper les bananes en deux dans le sens de la longueur.', 'Les faire revenir à feu vif dans une poêle beurrée, puis rajouter un peu de rhum pour les flamber.', 'Baisser le feu et rajouter la confiture de lait. Quand la confiture est liquide, retirer du feu.', 'Présenter les bananes avec une boule de glace à la noix de coco (ou plusieurs!).'], ['Pince de cuisine', 'Rouleau à pâtisserie', 'Batteur électrique'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'Bananes flambées à la confiture de lait', 'recette', 'cuisine', 'recettes', 'boisson', 'confiture de lait', 'glace à la noix de coco', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:09:23.806561', [{'ingredient_id': 'dacbcc6b-82b9-4e49-b3e7-81bfe329a04f', 'quantite': '1'}, {'ingredient_id': '4d863a5a-0578-4a43-b285-e6da0c6e4a28', 'quantite': '1 cuillères'}, {'ingredient_id': '430de4f5-bd81-4b19-b365-cde227bbfcb5', 'quantite': '2 cuillères'}, {'ingredient_id': '7f090a07-83df-4f77-841d-d864ce6a0f5a', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (73317, 'milk shake banane-fraise sans fraises', 'banane, yaourt, glaçons, lait', '5 min', ['Couper la banane en rondelles et la mettre dans le mixeur avec tous les ingrédients.', 'Mixer, verser dans grand verre ou un mug et déguster.'], ['Pince de cuisine', 'Ouvre-boîte', 'Presse-agrumes'], ['', 'entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'glaçons', 'lait', 'milk shake banane-fraise sans fraises', 'cocktail'], 'Boisson', 06120184-9aaf-4583-8d8f-bef6fd2c2bfc, '2025-09-26T16:09:27.459301', [{'ingredient_id': 'bc2e80a0-4714-4ca7-b322-34b390207e2d', 'quantite': '1'}, {'ingredient_id': '22d2e7e3-abad-4c57-b909-def868b0dc92', 'quantite': '1'}, {'ingredient_id': 'fe5d51e4-68c7-4087-9739-a147d479ded8', 'quantite': '5'}, {'ingredient_id': 'f2e1a3ec-fd9e-449f-8dfc-fc4eb5c7a83e', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (308069, 'Poulet coco et ses fruits flambés au rhum', 'escalope de poulet, pomme, banane, oignon, Ras el Hanout, lait de coco, rhum, huile d''olive, poivre, sel', '15 min', ['Faire revenir des lamelles d''oignons dans l''huile d''olive. ', 'Découper des lamelles de poulet et de pommes puis les mettre avec les oignons. ', 'Faire bien dorer puis flamber au Rhum. ', 'Ajouter des rondelles de banane. ', 'Mélanger du lait de coco avec une cuillère à soupe de Ras El Hanout puis incorporez le mélange à la préparation de poulet. ', 'C''est prêt !'], ['Batteur électrique', 'Économe', 'Casserole'], ['poulet en sauce', 'lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'plat', 'escalope de poulet', 'recette', 'Poulet coco et ses fruits flambés au rhum', 'cuisine', 'recettes', 'oignon', 'boisson', 'huile d''olive', 'Ras el Hanout', 'dessert', 'plat de résistance', 'pomme', 'poivre', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:09:32.170454', [{'ingredient_id': '55d042cd-bd08-4bca-b0db-9f1fed439c1d', 'quantite': '4'}, {'ingredient_id': '64cf3270-699b-4e55-8bbc-254ccf78acbb', 'quantite': '3'}, {'ingredient_id': '6eec013d-ce83-44fe-a7c8-c2999d711f0d', 'quantite': '3'}, {'ingredient_id': 'fae4ab1f-bd3c-4b6b-8abe-3f7da057f9f5', 'quantite': '1'}, {'ingredient_id': 'a028cf39-b839-4f52-b407-1ff6ee94fbb6', 'quantite': '1 cuillères'}, {'ingredient_id': 'eb715ffc-c1f6-4cec-a96e-5574a5dd7d7a', 'quantite': '20 cl'}, {'ingredient_id': '16172cdc-0654-40b3-8a2f-2b1bdb6da59e', 'quantite': '10 cl'}, {'ingredient_id': 'b78ec029-395e-44eb-97af-d6682559dc8e', 'quantite': ''}, {'ingredient_id': '6e76a507-363a-42d0-93f9-997b5b75bb51', 'quantite': ''}, {'ingredient_id': '1b62e7f0-f488-418e-8ffa-2c3bd001b967', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (33485, 'Croque banane - chocolat', 'banane, chocolat, pain de mie', '5 min', ['Disposer des roudelles de banane sur une tranche. ', 'Casser un carreau de chocolat en quelques morceaux et les disposer sur la banane. ', 'Recouvrir le tout avec une deuxième tranche. ', 'Le passer quelques minutes à l''appareil pour croques-monsieur.'], ['Ouvre-boîte', 'Couteau de chef'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'Croque banane - chocolat', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cocktail', 'pain de mie'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:09:35.880262', [{'ingredient_id': '4f84d3db-1c3a-4054-ae3c-e826243d7054', 'quantite': '1'}, {'ingredient_id': 'dc12377a-578b-478e-ae93-44c9f1ec9485', 'quantite': ''}, {'ingredient_id': '486854f8-044a-4b61-a038-957498020dcd', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (315022, 'Cocktail Banana Coco Mango', 'jus de banane, Liqueur, malibu, rhum', '5 min', ['Frapper l''ensemble des ingrédients dans un shaker avec des glaçons.', 'Verser dans un tumbler avec de la glace pilée (ou glaçons).'], ['Presse-agrumes', 'Tire-bouchon'], ['', 'entrée', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'facile', 'rapide', 'plat', 'jus de banane', 'recette', 'cuisine', 'malibu', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'Cocktail Banana Coco Mango', 'Liqueur', 'cocktail'], 'Boisson', 9156d488-a1a4-4dd6-8728-0434c08ea5c7, '2025-09-26T16:09:39.524616', [{'ingredient_id': '5a12c08e-fbea-4e27-b24f-03194e8f2641', 'quantite': '8 cl'}, {'ingredient_id': 'b00370cb-648c-45ec-8773-1ec1f0beeac0', 'quantite': '3 cl'}, {'ingredient_id': '82d84da8-58ed-4301-a614-59c100cb4215', 'quantite': '3 cl'}, {'ingredient_id': 'abec3dc4-25ee-423f-b25f-f340bd6cafba', 'quantite': '1 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (225296, 'Crumble d''Aline au son et à la noix de coco', 'mangue, banane, son de blé, avoine, noix de coco rapée, beurre, sucre semoule', '15 min', ['Éplucher les fruits.', 'Couper la mangue en cube et les bananes en fines rondelles.', 'Garnir au 2/3 les ramequins de fruits.', 'Préchauffer le four à 200°C (thermostat 6-7).', 'Mélanger tous les ingrédients de la pâte. Ajouter le beurre. Sabler. Garnir les ramequins de crumble en l’émiettant. Cuire au four 25 min, jusqu''à coloration.', 'Servir tiède.', 'Bon appétit !'], ['Mixeur', 'Passoire', 'Balance de cuisine', 'Économe', 'Fouet'], ['boisson', 'bon marché', 'recettes', 'banane', 'entrée', 'recettes de cuisine', 'cuisine', 'mangue', 'plat', 'Crumble d''Aline au son et à la noix de coco', 'dessert', 'confiserie', 'recette', 'testées', 'plat de résistance', 'cocktail', 'autres crumbles', 'très facile'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:09:44.241751', [{'ingredient_id': '969264f0-f6f2-4bdf-85b8-9a3db959cbf2', 'quantite': '1'}, {'ingredient_id': 'a7d5db0e-8a63-4f0b-a990-47bb48ec7a74', 'quantite': '3'}, {'ingredient_id': 'e8b78845-2576-4513-8ebb-0f44aab4e257', 'quantite': '75 g'}, {'ingredient_id': '864962ba-fd75-41e0-9329-c4de4dac242d', 'quantite': '35 g'}, {'ingredient_id': '221161cf-1bba-436f-aec9-17a2e155ee6b', 'quantite': '35 g'}, {'ingredient_id': '115adabb-1aa9-4b90-ab1a-6be1d7532968', 'quantite': '100 g'}, {'ingredient_id': 'c8933cee-51b2-4713-b29e-a481a821ed3d', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (315383, 'Verrines bananes poêllées, caramel beurre salé', 'banane, beurre, sucre roux, beurre salé, crème, palets bretons, mascarpone, sucre, sucre vanillé, oeuf', '40 min', ['Dans une poêle, faire fondre la noisette de beurre.', 'Éplucher et couper les bananes en rondelles.', 'Poêler les bananes pour qu''elles aient une couleur dorée.', 'Tapisser le fond de chaque verrine avec les bananes.', 'Dans une casserole, faire fondre le sucre roux jusqu''à ce qu''il caramélise.', 'Ajouter le beurre salé.', 'Puis la crème petit à petit.', 'Verser le caramel sur les bananes.', 'Émietter 14 palets bretons et saupoudrer sur le caramel.', 'Montez les blancs en neige.', 'Faites blanchir les jaunes d''oeufs et le sucre.', 'Ajouter la mascarpone.', 'Incorporer délicatement les blancs en neige.', 'Déposer ce dernier mélange sur les palets bretons.', 'Avec les 2 palets restants, décorez le haut des verrines en déposant quelques miettes.'], ['Passoire', 'Casserole'], ['entrée', 'banane', 'recettes de cuisine', 'mascarpone', 'confiserie', 'testées', 'facile', 'caramel', 'beurre salé', 'bon marché', 'rapide', 'oeuf', 'plat', 'crème', 'recette', 'cuisine', 'recettes', 'boisson', 'palets bretons', 'caramel beurre salé', 'dessert', 'plat de résistance', 'sucre vanillé', 'beurre', 'Verrines bananes poêllées', 'sucre', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:09:48.069688', [{'ingredient_id': 'e6e3a121-e837-47f7-9ad6-77569e6e3b70', 'quantite': '4'}, {'ingredient_id': 'c53a2812-80c9-408a-8e7d-65fa0983b004', 'quantite': '10 g'}, {'ingredient_id': 'cd759f8b-e5be-40b0-a848-4fa46f9df3a6', 'quantite': '170 g'}, {'ingredient_id': '7bc4a2ea-794b-49e6-ae7a-2c8ca596a856', 'quantite': '70 g'}, {'ingredient_id': 'ac6d5202-f964-4ef8-8cf4-c878bb4fce1d', 'quantite': '10 cl'}, {'ingredient_id': '69dea999-5970-472a-8b63-77216cb1378d', 'quantite': '16'}, {'ingredient_id': 'c35d8e4f-ba63-4daa-9d03-02abf5863f9a', 'quantite': '250 g'}, {'ingredient_id': 'c245b7dc-688d-4c65-acab-ab816b8d3ea1', 'quantite': '100 g'}, {'ingredient_id': 'a4abf0ac-45a2-4966-84cf-992f74ee74fd', 'quantite': '2'}, {'ingredient_id': 'f38dddd7-b52c-4c66-8a2c-5c2fdebb8481', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (305289, 'Crêpes gourmandes banane-nutella-caramel', 'crêpe, sucre en poudre, banane, beurre demi-sel, Nutella', '20 min', ['Faire 6 crêpes.', 'Éplucher et couper les bananes.', 'Faire fondre le sucre dans la poêle doucement avec un demi verre d''eau.', 'Attendre qu''il soit fondu et coloré.', 'Remuer et ajouter le beurre en continuant à remuer.', 'Lorsque le caramel au beurre est bien coloré, ajouter les bananes. Les retourner dans le caramel.', 'Réchauffer les crêpes au micro-ondes.', 'Au centre, étaler de la pâte à tartiner type nutella, ajouter les bananes flambées, refermer la crêpe et napper de la sauce au caramel.', 'Bon appétit !'], ['Ouvre-boîte', 'Verre doseur', 'Casserole'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'Crêpes gourmandes banane-nutella-caramel', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'beurre demi-sel', 'boisson', 'crêpe', 'Nutella', 'dessert', 'plat de résistance', 'crêpes sucrées', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:09:53.321886', [{'ingredient_id': 'a0b337cc-b745-4a74-b749-9d71a6284432', 'quantite': '6'}, {'ingredient_id': '20b16cb0-bd7c-4972-85b5-aed0ad68136a', 'quantite': '30 g'}, {'ingredient_id': 'f2a50afc-7c7e-4212-9154-2a4a474f4e2c', 'quantite': '3'}, {'ingredient_id': 'f897ffe6-5c0e-4f42-863a-1fe237f3a056', 'quantite': '20 g'}, {'ingredient_id': '1176a1b5-dd38-449b-9608-699b85b35b2b', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (165499, 'Salades de légumes d''hiver', 'patate douce, carotte, céleri, banane, jus de citron, huile, persil', '15 min', ['Eplucher la patate ainsi que les carottes.', 'Les faire cuire dans une eau salée, en premier la carotte, puis la patate.', 'Egoutter et laisser refroidir.', 'Emincer finement le cèleri, le rajouter aus légumes cuits.', 'Ecraser la banane, en faire une sauce avec le jus de citron, l''huile, sel et poivre.', 'Mélanger aux légumes parsemer de piment d''espelette et de persil.'], ['Moule à tarte', 'Louche', 'Poêle'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'carotte', 'patate douce', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'Salades de légumes d''hiver', 'dessert', 'persil', 'plat de résistance', 'jus de citron', 'cocktail', 'céleri'], 'Entrée', 515dc9e8-e83f-4fd8-8d89-a2d6ef206df6, '2025-09-26T16:09:58.643325', [{'ingredient_id': '1bac3178-a824-4723-b2f2-5d53bd0d4c01', 'quantite': ''}, {'ingredient_id': '72eb5fdd-fe44-4661-b8c0-f666d2153b32', 'quantite': ''}, {'ingredient_id': 'b6528c9f-fb8a-4868-a343-611f8ddc024a', 'quantite': ''}, {'ingredient_id': 'addd5fa9-9e3d-415c-ab3a-c8f7e5e758bb', 'quantite': '1'}, {'ingredient_id': 'f8c1960c-9608-4069-96a5-4c9c0a6e2ea0', 'quantite': ''}, {'ingredient_id': '62ebd7a5-0474-4370-9912-15a5ad8d5188', 'quantite': ''}, {'ingredient_id': 'a5781a7d-d1a4-46c1-94c7-a4d27bb8af9d', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (530514, 'Banana choco', 'chocolat, banane, amandes', '2 min', ['Dans du papier cuisson, met la banane, puis de chaque côté 4 carreaux de chocolat de chaque côté de la banane.', 'Referme le papier cuisson et demande à un adulte de  mettre le tout au four, à 200°C (Th 6-7).', 'Une fois le chocolat fondu, saupoudre les bananes d''amandes concassées, il n''y a plus qu''à servir !'], ['Râpe', 'Pince de cuisine', 'Ouvre-boîte', 'Presse-agrumes', 'Casserole'], ['amandes', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Banana choco', 'dessert', 'plat de résistance', 'dessert au chocolat', 'cocktail'], 'Dessert', 5b367c7c-67ed-44f7-b5e9-bee1bc6abb0e, '2025-09-26T16:10:03.736408', [{'ingredient_id': '378bffd2-5467-4ce7-84a6-71c190de6d03', 'quantite': '1'}, {'ingredient_id': '45988b75-80a0-48af-a81b-979f6a994197', 'quantite': '4'}, {'ingredient_id': 'eff23219-2cbc-42e7-a48f-dac0ea4a071f', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (72862, 'Cocktail de l''été', 'banane, kiwi, abricot, pêche, Coulis de cerise, glaçons, thé', '10 min', ['Pelez la banane, le kiwi, les abricots, les pêches. ', 'Enlevez le noyau des abricots et des pêches.', 'Mettez tout dans le mixeur et ajoutez le coulis. Mixez.', 'Ajoutez les glaçons si les fruits n''étaient pas frais.', 'Ajoutez le thé glacé.', 'Prenez les deux verres et remplissez-les de ce jus. ', 'Alors? Bon ou pas?'], ['Passoire', 'Fouet', 'Ouvre-boîte', 'Presse-agrumes'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'abricot', 'très facile', 'bon marché', 'thé', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Coulis de cerise', 'glaçons', 'Cocktail de l''été', 'pêche', 'cocktail'], 'Boisson', 6447c319-603e-46ed-94ff-36dc8271ad13, '2025-09-26T16:10:07.515721', [{'ingredient_id': '0d46af22-6328-4c21-bfa8-e6ff565025a3', 'quantite': '1'}, {'ingredient_id': 'c2e83908-730d-4217-ad45-d5a81d9c2b6d', 'quantite': '1'}, {'ingredient_id': '6aa829cb-fee5-4a69-9a79-c6d95c13f652', 'quantite': '2'}, {'ingredient_id': '611f742e-3ee1-4e9e-b699-b14d3ce3bb7f', 'quantite': '2'}, {'ingredient_id': '04984338-2e24-4812-93b3-8ada111d7f9a', 'quantite': ''}, {'ingredient_id': '9690889f-5d54-41fe-87bb-de56c77b4e94', 'quantite': ''}, {'ingredient_id': '7637280f-55a9-45fa-bf29-b6a17ad73f0f', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (26637, 'Meringues et bananes en flan', 'banane, lait, beurre, sucre en poudre, oeuf, biscuits à la cuillère', '20 min', ['Chauffer le lait avec 100 g de sucre. Casser les 6 oeufs : réserver 3 blancs d''oeuf pour la meringue. Battez le reste des oeufs avec le lait, chaud mais pas bouillant.', 'Ecrasez les bananes avec les biscuits puis ajoutez-les au mélange précédent.', 'Préchauffez le four à 150°C (thermostat 5).', 'Beurrer généreusement un moule. Y verser la préparation. Couvrir de papier sulfurisé et enfourner pendant 1 heure.', 'Dix minutes avant la fin de la cuisson, faire la meringue : monter les blancs en neige en y incorporant progressivement les 50 g de sucre qui restent.', 'Sortez le flan du four et montez la meringue sur le dessus à l''aide d''une poche à douille ou d''une spatule. Remettez au four pendant 10 minutes.', 'Ce dessert se mange chaud ou froid.'], ['Poêle', 'Économe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'biscuits à la cuillère', 'facile', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'beurre', 'flan', 'lait', 'Meringues et bananes en flan', 'cocktail'], 'Dessert', f08fce9d-e064-45b0-8358-1a7394971b1d, '2025-09-26T16:10:12.276238', [{'ingredient_id': 'eafa021b-933e-4ef1-8a60-c2f323011e2c', 'quantite': '3'}, {'ingredient_id': '66df0fe2-1d8d-4b2f-afb6-199040e89f50', 'quantite': '50 cl'}, {'ingredient_id': 'b6a56cab-193d-4b44-b6f5-768f84f16e1a', 'quantite': '20 g'}, {'ingredient_id': '5a396cc1-eb74-4321-9ba0-9952ca663059', 'quantite': '150 g'}, {'ingredient_id': 'cee93ad6-6f72-48e1-82fc-ffe4a71fcbad', 'quantite': '6'}, {'ingredient_id': '7065fc89-0c68-42ab-812d-47dcc6b18429', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (336399, 'Milkshake gourmand à la fraise', 'fraises, banane, sucre, crème fraîche épaisse, lait', '10 min', ['Mettre les fraises et la demi-banane au frais pendant 10 à 15 minutes. ', 'Déposer gaiement le lait et le sucre dans votre mixeur. ', 'Découper la banane en petits morceaux. ', 'Ajouter celle-ci avec les fraises dans votre mélange de lait et de sucre (Si vos fraises sont trop grosses vous pouvez aussi les écraser avec une fourchette !) ', 'Mixer le tout. ', 'Quand le mélange est homogène, ajouter votre sucre d''agave et votre crème fraîche. ', 'Remixer et tout est prêt à être dégusté !'], ['Moule à tarte', 'Pince de cuisine', 'Spatule'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche épaisse', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'fraises', 'Milkshake gourmand à la fraise', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre', 'lait', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:10:16.030241', [{'ingredient_id': '05f99a16-6f2a-421a-a032-65d434c13106', 'quantite': '250 g'}, {'ingredient_id': 'a4cd5a5c-b29f-4f66-8431-5d2ee2949c27', 'quantite': '1'}, {'ingredient_id': '04388044-d3ea-4763-bdc6-d5ce74c9425a', 'quantite': '4 cuillères'}, {'ingredient_id': '6bb1b543-90c8-475d-8b0a-ca516cacb564', 'quantite': '4 cuillères'}, {'ingredient_id': '3182e4a0-32fa-4070-883b-5980dbff92ad', 'quantite': '80 ml'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (346953, 'Tarte tatin banane toffee', 'pâte feuilletée, farine, crème liquide, beurre, sucre, banane', '30 min', ['Préchauffer le four à 190°C (thermostat 6-7).', 'Dérouler la pâte feuilleté et la couper en un rond de 22 cm. Réserver au frais pendant 20 min.', 'Dans une poêle, mélanger la crème, le beurre et le sucre. La poêle doit être de la même taille que la pâte feuilleté. ', 'Faire fondre à feu moyen et mélanger pendant 3 min jusqu''à une sauce épaisse de couleur marron.', 'Mettre un tiers de la sauce de côté. ', 'Couper les bananes en lamelles de 2 cm et les placer dans la poêle. ', 'Remettre sur le feu moyen pendant 3-4 min.', 'Mettre la pâte sur la poêle. ', 'Enfourner pendant 25 à 30 min. ', 'Laisser refroidir 5 min et renverser sur un plat à tarte.'], ['Casserole', 'Pince de cuisine', 'Poêle', 'Verre doseur', 'Planche à découper'], ['Tarte tatin banane toffee', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'tarte Tatin', 'farine', 'dessert', 'plat de résistance', 'pâte feuilletée', 'beurre', 'sucre', 'cocktail'], 'Dessert', e947e75e-c8ed-46ab-9573-d4bfea424fd6, '2025-09-26T16:10:19.668234', [{'ingredient_id': '2a3633d1-9fe3-4ee9-baa9-729a397402d1', 'quantite': '1'}, {'ingredient_id': '080d62fd-b7c3-4cd5-9cf3-d3027765044a', 'quantite': '1 cuillères'}, {'ingredient_id': 'bc265bde-d333-4047-a63d-36828d78611c', 'quantite': '20 cl'}, {'ingredient_id': 'f3125f28-720e-4347-88a2-d65cb0c2f1a1', 'quantite': '60 g'}, {'ingredient_id': 'bf595c4f-5013-4cd9-8651-b6430561fb11', 'quantite': '65 g'}, {'ingredient_id': '59814a05-b48c-43b8-ab79-124c6587fc7b', 'quantite': '5'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (312650, 'Cupakes bananes chocolat', 'beurre tendre, sucre roux, farine, oeuf, banane, chocolat noir, bicarbonate', '20 min', ['Pour la pâte :', 'Préchauffer le four à 170°C (thermostat 5-6).', 'Dans un bol, mélanger le beurre, le sucre roux, le bicarbonate et la farine.', 'Incorporer les bananes coupés en morceaux puis écraser avec une fourchette. ', 'Mixer le chocolat pour obtenir du chocolat en poudre. Remplir à 1/4 les moules de pâte. ', 'Puis, mettre un peu de chocolat. Verser le reste de la pâte dans les moules. ', 'Enfourner au four pour 20 à 25 min à 170°C (thermostat 5-6).'], ['Râpe', 'Mixeur', 'Passoire'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'beurre tendre', 'facile', 'oeuf', 'plat', 'Cupakes bananes chocolat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'chocolat noir', 'moyen', 'cocktail', 'sucre roux', 'bicarbonate'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:10:24.703634', [{'ingredient_id': '44053f19-f4d5-46ac-8463-67d2c431a291', 'quantite': '150 g'}, {'ingredient_id': '48bed201-8e46-46d5-b8b4-5a36541985eb', 'quantite': '170 g'}, {'ingredient_id': '5c7392c5-bbd5-47ab-8b10-07c6b2dfc399', 'quantite': '250 g'}, {'ingredient_id': '0e0d39fd-0597-4400-a7cd-df0600070087', 'quantite': '4'}, {'ingredient_id': '42a1a9dd-762d-4e3d-a3d9-801cd46542ff', 'quantite': '2'}, {'ingredient_id': 'd660cbe9-be4e-4e73-b879-2d7ec48b6127', 'quantite': '80 g'}, {'ingredient_id': '54404e7e-ed1e-4059-bb42-784bcbf5806e', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (170233, 'Semoule de riz banane raisins', 'semoule, lait, sucre vanillé, raisins secs, banane', '10 min', ['Écraser la banane dans une assiette à part à l''aide d''une fourchette.', 'Verser le lait dans une casserole.', 'Y ajouter le sachet de sucre vanillé, la banane écrasée ainsi qu''une bonne poignée de raisins secs.', 'Porter le tout à ébullition en mélangeant bien.', 'Une fois le mélange bien chaud, rajouter, en pluie, la semoule de riz en continuant de remuer pour que le tout ne colle pas à la casserole.', 'Le mélange est cuit lorsque la préparation se décolle parfaitement des bords de la casserole.', 'Transférer immédiatement dans des ramequins ou un saladier.', 'Laisser refroidir à température ambiante puis placer au réfrigérateur.', 'Se déguste froid éventuellement accompagné d''un caramel.'], ['Économe', 'Couteau de chef'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'semoule', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Semoule de riz banane raisins', 'dessert', 'plat de résistance', 'sucre vanillé', 'raisins secs', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:10:28.486595', [{'ingredient_id': '7eab7fe9-f6d4-4927-8518-b34508d26752', 'quantite': '100 g'}, {'ingredient_id': 'a045df87-4519-4c13-9a7f-fa5f0f43a71f', 'quantite': '50 cl'}, {'ingredient_id': 'f232e323-8145-48b6-a4c3-498d0ddb0d52', 'quantite': '1'}, {'ingredient_id': '64391205-f136-49d4-85a0-b2df8a51c0e0', 'quantite': '50 g'}, {'ingredient_id': '5e4aa842-eda0-41fe-95f8-2639f1a4dc99', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (65211, 'Barres de céréales à la banane', 'banane, flocons d''avoine, blé, miel, fruits', '10 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Ecraser les bananes. Ajouter des flocons d''avoine et éventuellement un peu de germe de blé pour obtenir une bouillie consistante.', 'Ajouter les fruits frais, les fruits confits et les noix coupées en tous petits morceaux.', 'Quelques exemples : pomme + cannelle / orange confites + canneberge confites / raisins (préalablement gonfles dans du thé chaud) + noisettes / dates, figues, ananas confits, etc etc etc...  ', 'Etaler le tout sur une plaque recouverte de papier sulfurisé, cuire 30 min à 180°C (thermostat 6).', 'Une fois refroidi, couper en barres. '], ['Presse-agrumes', 'Casserole', 'Râpe', 'Pince de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'Barres de céréales à la banane', 'miel', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'blé', 'fruits', 'flocons d''avoine', 'cocktail'], 'Confiserie', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:10:31.999593', [{'ingredient_id': '9fa2ef41-c098-4378-bbc1-52ba503659b7', 'quantite': '3'}, {'ingredient_id': '3cc84f95-f3f5-4dcc-931d-e7def53f6843', 'quantite': '1'}, {'ingredient_id': 'c1ca9afd-9f1d-4263-8668-2ea2d98d751f', 'quantite': '1'}, {'ingredient_id': 'cb175794-a63f-4511-be6a-db68d64fc84d', 'quantite': '1'}, {'ingredient_id': '27b030d0-93ab-49d3-a594-8403bb16cc08', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (35960, 'Cake à la banane et aux noix', 'banane, Noix concassée, farine, sucre, beurre, oeuf, levure', '15 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Faire fondre le beurre au micro-onde.', 'Travailler à l''aide d''un batteur électrique le beurre fondu avec le sucre jusqu''à obtention d''une pâte lisse.', 'Incorporer les oeufs un par un, puis ajouter la farine tamisée et la levure.', 'Ajouter les bananes coupées en dés et enfin les noix concassées. Bien mélanger.', 'Mettre au four pendant 45 minutes.'], ['Ouvre-boîte', 'Moule à tarte', 'Passoire', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'levure', 'cuisine', 'recettes', 'boisson', 'farine', 'autres cakes', 'Cake à la banane et aux noix', 'dessert', 'plat de résistance', 'Noix concassée', 'beurre', 'sucre', 'cocktail'], 'Dessert', 8bbf29d1-90e5-4980-ae83-4b91db4b5666, '2025-09-26T16:10:36.675422', [{'ingredient_id': 'a29b6374-660c-42b9-a9db-2691a32a6e84', 'quantite': '2'}, {'ingredient_id': '85cac201-2351-4301-930f-961d4b13bdde', 'quantite': '100 g'}, {'ingredient_id': 'b8c8825d-32e8-406f-ac3e-13868135f8ba', 'quantite': '170 g'}, {'ingredient_id': 'f119024e-a679-4c7f-80f2-7cbd65fcb005', 'quantite': '80 g'}, {'ingredient_id': '61a02f73-5c4f-4837-a2e6-118eb4644488', 'quantite': '100 g'}, {'ingredient_id': 'd5e1f2ab-7395-4636-bbb7-66a796007272', 'quantite': '2'}, {'ingredient_id': 'd9e10324-b8f9-4b9c-a40c-092368174819', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (392194, 'Muffins façon banana bread', 'banane, beurre, jus de citron, farine, sucre roux, sucre vanillé, levure chimique, oeuf, chocolat noir', '20 min', ['Écraser le beurre et le mélanger vivement avec les deux sucres.', 'Ajouter les œufs au fur et à mesure en mélangeant bien.', 'Écraser la banane dans un bol et mettre un peu de jus de citron. Ajouter la banane à la préparation précédente.', 'Incorporer ensuite la farine et la levure et mélanger le tout.', 'Répartir la préparation dans des moules à muffins.', 'Faire fondre le chocolat au bain marie et en verser un peu sur chaque muffin. Former des marbrures avec la pointe d''un coûteau ou un pic à brochette.', 'Enfourner à 200°C pour 15 minutes (+ ou - en fonction du four) et vérifier la cuisson à l''aide de la pointe d''un couteau.'], ['Rouleau à pâtisserie', 'Moule à tarte', 'Poêle', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'Muffins façon banana bread', 'plat de résistance', 'chocolat noir', 'sucre vanillé', 'jus de citron', 'muffin', 'beurre', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:10:41.447967', [{'ingredient_id': 'a2ef4652-3d44-4f99-96cf-d0d0170bafdb', 'quantite': '3'}, {'ingredient_id': '20cfc8c2-29ca-4499-a4e8-cde7b1309470', 'quantite': '75 g'}, {'ingredient_id': '327d21f6-9063-4bda-b7b1-372901a21dfc', 'quantite': ''}, {'ingredient_id': '6afbf602-6694-44ba-9c10-3aaa27ba3083', 'quantite': '200 g'}, {'ingredient_id': '210d3f29-f5e5-4b10-8fbe-ce26a9512a33', 'quantite': '75 g'}, {'ingredient_id': 'e04690c9-3d1e-4f32-a3c6-b5cc3e8dba5f', 'quantite': '1'}, {'ingredient_id': 'f6a4334b-505f-4e26-9f95-ba4cbf42e204', 'quantite': '8 g'}, {'ingredient_id': '62b33485-9853-40fa-8ca6-bec889ba2cb9', 'quantite': '3'}, {'ingredient_id': '41c0dc37-ba6d-4300-925e-82e226a424e1', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (57012, 'Poulet aigre-doux au four', 'poulet entier, pomme de terre, ananas, banane, oignon, ail, lait de coco, noix de coco rapée, noix de cajou, amandes effilées, curry, sucre en poudre, eau, huile de tournesol, sauce soja', '30 min', ['Mettez votre four à préchauffer sur 180°C durant environ 10min.', 'Faites chauffer un peu d''huile de tournesol dans une poêle, et faites y dorer votre poulet sur chaque face, 2 à 3 minutes. Retirez-le et mettez dans un plat adapté au four.', 'Dans l''huile encore chaude, faites revenir les pommes de terre coupées en morceaux, avec les oignons et les gousses d''ail, pour les faire bien dorer également.', 'Arrosez d''un peu de sauce soja.', 'Dans un bol, mettez environ 100ml d''eau et les 200ml de lait de coco.', 'Remuez, et ajoutez la noix de coco râpée, ainsi que deux pincées de curry (suivant votre goût).', ' Ajoutez dans le plat les pommes de terres/oignons/gousses avec le poulet, et arrosez le poulet d''un peu de sauce préparée plus haut.', 'Mettez un peu d''eau dans votre plat afin que vos patates ne sèchent pas, et enfournez à 180°C, durant 30min.', 'Arrosez le poulet d''un peu de sauce au bout de 20min.', 'Durant ce temps, toujours dans votre poêle, versez un peu d''eau et du sucre, et faites chauffer doucement.', 'Découpez la moitié de l''ananas (environ de la grosseur des morceaux de pommes de terre), la banane, et 100gr de noix de cajou et faites les revenir dans votre poêle, en les faisant légèrement caraméliser. Réservez.', 'Au bout des 30 min de cuisson du poulet, ajoutez-y votre mélange de fruits, remuez bien afin que tous les éléments autour du poulet se mélangent.', 'Si le mélange est sec, ajoutez un peu d''eau et de sauce soja.', 'Enfournez pour 60 min, en n''oubliant pas d''arroser toutes les 20 min le poulet, et remuez le mélange afin que tous les légumes et fruits prennent la saveur de la sauce.', 'Après ces 60 min, sortez votre poulet, vérifiez sa cuisson, et ajoutez quelques amandes effilées sur le poulet (ainsi que sur le mélange pour les gourmand(e)s!), puis le reste de noix de cajou, et ré-enfournez pour environ 30 min.', 'Pas besoin de re-saucer le poulet, laissez-le acquérir un certain croustillant.'], ['Fouet', 'Tire-bouchon', 'Batteur électrique', 'Couteau de chef'], ['noix de cajou', 'lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'très facile', 'bon marché', 'ail', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'huile de tournesol', 'noix de coco rapée', 'dessert', 'Poulet aigre-doux au four', 'plat de résistance', 'poulet entier', 'ananas', 'amandes effilées', 'pomme de terre', 'poulet rôti', 'curry', 'cocktail', 'sauce soja'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:10:45.176643', [{'ingredient_id': '323041ec-43a6-4d06-b6e7-f5c7bfd69fb8', 'quantite': ''}, {'ingredient_id': 'de7a291a-3abc-4919-a142-f0974020a4dc', 'quantite': '6'}, {'ingredient_id': 'a558a7e4-beb0-4ce4-b324-17f2b8239b36', 'quantite': ''}, {'ingredient_id': '02709466-0c28-42c0-b32c-a087c45aa332', 'quantite': ''}, {'ingredient_id': 'b1217615-2516-45c1-876c-31b0fc67401b', 'quantite': ''}, {'ingredient_id': '63db0645-5394-4019-97ef-ce2286d71997', 'quantite': '3'}, {'ingredient_id': '6dfd242c-8d68-40e3-90a7-5b61d151a91d', 'quantite': '200 ml'}, {'ingredient_id': '44e915ab-5b21-417e-a867-f0447b08c55b', 'quantite': '50 g'}, {'ingredient_id': '250cc8f2-2fc8-4672-8d5f-8e2f95e4a794', 'quantite': '150 g'}, {'ingredient_id': 'dbf343a1-354b-49f3-8345-0ea2de57130c', 'quantite': ''}, {'ingredient_id': '5c4486b2-3451-4d2b-846b-91225dcf2219', 'quantite': ''}, {'ingredient_id': 'f7f7880e-09ea-4bc7-9a0e-cf9ed973735e', 'quantite': ''}, {'ingredient_id': 'b424c179-120b-4e49-b143-7c716b876ee2', 'quantite': ''}, {'ingredient_id': '93fef31c-8bd2-4bbe-afde-d9df3cbf0f2e', 'quantite': ''}, {'ingredient_id': 'a8457196-373d-40d6-a2d8-2dac9322b62f', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (41276, 'Colombo de mouton à la Mauricienne', 'épaule, oignon, ail, champignons de Paris, noix de cajou, lait de coco, noix de coco rapée, banane, piment fort, estragon, poudre de colombo, curry, cardamome, cube de bouillon, yaourt, persil, huile d''arachide', '20 min', ['Faire dorer le mouton, découpé en morceaux, dans l''huile.', 'Après 5 minutes, ajouter les oignons émincés. Saler, poivrer abondamment, ajouter le piment fort.', 'Mouiller avec un verre d''eau chaude. Ajouter l''ail écrasé et le bouillon de boeuf. ', 'Ajouter la poudre de colombo, le curry fort, les noix de cajou, et les champignons émincés.', 'Mouiller avec le lait de coco, et ajouter l''estragon. ', 'Laisser mijoter 90 min à feu doux, dans une cocotte en fonte avec couvercle.', 'Au moment de servir, ajouter les bananes coupées en rondelles, le persil plat ciselé, et le yaourt "grec". Délayer doucement.', 'Dresser dans un plat creux, et saupoudrer de la noix de coco râpée.'], ['Verre doseur', 'Casserole', 'Moule à tarte', 'Batteur électrique'], ['', 'noix de cajou', 'lait de coco', 'entrée', 'banane', 'huile d''arachide', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'cocktail', 'facile', 'ail', 'cardamome', 'plat', 'recette', 'cube de bouillon', 'cuisine', 'piment fort', 'estragon', 'recettes', 'oignon', 'boisson', 'noix de coco rapée', 'dessert', 'persil', 'plat de résistance', 'moyen', 'Colombo de mouton à la Mauricienne', 'champignons de Paris', 'épaule', 'curry', 'poudre de colombo'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:10:48.865535', [{'ingredient_id': 'd5c93cf9-aa3e-48e2-b0be-c775d2daaefc', 'quantite': '1 kg'}, {'ingredient_id': '520ce437-f165-4d79-9974-a6695df1f86d', 'quantite': '3'}, {'ingredient_id': 'f2ff9433-4b4f-4b9c-94e7-a88f364e60c0', 'quantite': '6'}, {'ingredient_id': 'fd4aa020-4a39-44ec-9b47-33cf8f5a5825', 'quantite': '500 g'}, {'ingredient_id': 'd53283ba-d407-41c1-ac38-32e875d1d33a', 'quantite': '150 g'}, {'ingredient_id': '47333a84-afe8-4e47-8d23-97eb6055411b', 'quantite': '500 ml'}, {'ingredient_id': '9e3f1fba-b091-49fa-bd1f-fc0c33e605f2', 'quantite': '100 g'}, {'ingredient_id': '13ab0abe-3b72-4ac1-8eb1-9f195cc3cfb5', 'quantite': '3'}, {'ingredient_id': '9dc083b7-da4b-4c24-a02b-e56d509c6ef6', 'quantite': ''}, {'ingredient_id': '8fe2d366-e872-4b10-9930-880d239c1b47', 'quantite': '1'}, {'ingredient_id': '103f6ac6-43a1-41e0-aaf1-d0ba0267a811', 'quantite': '1 cuillères'}, {'ingredient_id': 'e14e4c17-d330-4105-bf8d-9f5001a3e7dd', 'quantite': '1 cuillères'}, {'ingredient_id': 'b80623ce-6549-401c-9f81-c6f2f51f366f', 'quantite': '8'}, {'ingredient_id': '67a6863d-7fa0-43b0-b78e-655eb080fe7c', 'quantite': '2'}, {'ingredient_id': '5356a6b7-9f7a-4079-a533-d6fce70b0b8d', 'quantite': '1'}, {'ingredient_id': '4a9bd49b-c51e-4345-ba72-8f86bb6775d5', 'quantite': '1 cuillères'}, {'ingredient_id': 'c45ff077-7c7e-427e-996a-c74411509a8b', 'quantite': '10 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (195558, 'Gâteau onctueux banane fraise rhum', 'farine, maïzena, banane, fraises, lait, oeuf, sucre, vanille, rhum', '30 min', ['Préchauffer le four à 120°C (thermostat 4).', 'Mettre dans un saladier le lait, la farine, la maïzena et le sucre.', 'Mixer les bananes et les fraises puis les mettre dans le saladier en mélangeant.', 'Portez le contenue du saladier à ébullition dans une casserole.', 'Une fois bouilli, mettre la gousse de vanille dans le mélange.', 'Y ajoutez le rhum et les œufs.', 'Bien mélanger.', 'Mettre le tout au four 20 min à 120°C (thermostat 4).'], ['Planche à découper', 'Spatule', 'Mixeur', 'Passoire', 'Couteau de chef'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'Gâteau onctueux banane fraise rhum', 'facile', 'maïzena', 'bon marché', 'oeuf', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'vanille', 'dessert', 'plat de résistance', 'gâteau à la banane', 'lait', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:10:52.534533', [{'ingredient_id': 'f77c6bd5-d14a-40fe-a54f-a0750f4ffacc', 'quantite': '200 g'}, {'ingredient_id': 'faccb7d3-ec11-4484-a80c-a618245c17a9', 'quantite': '25 g'}, {'ingredient_id': 'f00e0d25-dae2-4737-a4d4-1c63e2024969', 'quantite': '3'}, {'ingredient_id': '69c3b99e-1995-435e-8476-364fc9efb341', 'quantite': '150 g'}, {'ingredient_id': '9f54ee43-e154-4d43-b5be-b6ea35be1497', 'quantite': '1.5 l'}, {'ingredient_id': 'b6b1cbac-068e-40ea-bce2-dac91d9c501a', 'quantite': '6'}, {'ingredient_id': '23e14058-9c93-4565-8095-34c4b17f9bd0', 'quantite': '250 g'}, {'ingredient_id': 'c12aa38d-c8c5-4c49-9fad-974b9f41a67a', 'quantite': '1'}, {'ingredient_id': '4400ed97-ffe6-40b1-9968-51812336e49d', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (344693, 'Pancakes banane façon vegane', 'farine de blé, maïzena, levure, sel, banane, huile de coco, lait d''avoine', '10 min', ['Mélanger tous les ingrédients secs (farine, maïzena, levure, sel).', 'Ajouter la banane écrasée, puis le lait et l''huile de coco.', 'Faire cuire des petites louches de pâte à feu moyen sur chaque face.', 'Bonne dégustation !'], ['Casserole', 'Pince de cuisine', 'Poêle'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'pancake', 'très facile', 'maïzena', 'bon marché', 'rapide', 'plat', 'recette', 'levure', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'farine de blé', 'Pancakes banane façon vegane', 'lait d''avoine', 'huile de coco', 'cocktail'], 'Dessert', 1e3a8fd4-55df-407a-bcd1-a747cd43f0d2, '2025-09-26T16:10:56.203249', [{'ingredient_id': '6ddff99c-4208-498b-beb9-ddc128aadef6', 'quantite': '100 g'}, {'ingredient_id': 'c960a4fe-ef68-4e04-809d-f4fc0262a0a2', 'quantite': '25 g'}, {'ingredient_id': 'ec1ef8ee-a5c1-4d26-b253-91b8b1d242a9', 'quantite': '1'}, {'ingredient_id': '88536875-595b-4346-b438-e262f2754c63', 'quantite': '1'}, {'ingredient_id': 'beea0c5a-6a86-45be-b552-94742da45c43', 'quantite': '1'}, {'ingredient_id': '8b44aa00-6a50-403c-8a42-8079732ecc28', 'quantite': '2 cuillères'}, {'ingredient_id': 'ece6e176-a401-4f0e-a703-636e5f45ae35', 'quantite': '20 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (94983, 'Cookies à la banane séchée et chocolat noir', 'beurre, cassonade, farine, oeuf, banane, chocolat noir, levure chimique', '15 min', ['Mélanger le sucre, l''oeuf et le beurre, faire blanchir le mélange, ajouter la farine et la levure.', 'Découper le chocolat noir et les bananes séchées en petits cubes (assez grossièrement). Les ajouter à la préparation.', 'Faire des tas à l''aide de 2 petites cuillères sur un plat en silicone, ou beurré/fariné. Puis enfourner th7 (210°) pendant 10 à 15 min.', 'Déguster tièdes s''ils ont le temps de refroidir !'], ['Moule à tarte', 'Ouvre-boîte', 'Batteur électrique', 'Râpe'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'cassonade', 'levure chimique', 'très facile', 'bon marché', 'cookie', 'oeuf', 'plat', 'Cookies à la banane séchée et chocolat noir', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'chocolat noir', 'beurre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:10:59.992591', [{'ingredient_id': '33451fb4-e5c6-4e48-b895-43fbf56e9ab7', 'quantite': '150 g'}, {'ingredient_id': '74c29080-0636-40e9-8849-36fef068e569', 'quantite': '150 g'}, {'ingredient_id': 'bc7e8edb-6858-4146-a0d2-bba5025cfe7a', 'quantite': '200 g'}, {'ingredient_id': 'aa031c6f-607a-4313-a344-551f02970fe6', 'quantite': '1'}, {'ingredient_id': 'a2b825f8-d411-4e9f-8cca-1e19d1ce3f2b', 'quantite': '3'}, {'ingredient_id': 'd79a8fb4-30a0-4111-8c29-11304f91bb17', 'quantite': '100 g'}, {'ingredient_id': '59164f87-8d73-46a8-9f3d-9173d085ac71', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (55779, 'Semba', 'banane, sucre, sirop d''érable', '5 min', ['Dans une poêle, coupez vos bananes en rondelles.', 'Mettez la poêle sur le feu (à feu fort).', 'Remuez vos bananes avec un couteau pour ne pas qu''elles accrochent à la poêle pendant 1 min.', 'Au bout de 1 min, rajoutez de l''eau dans la poêle (un tout petit peu), une fois l''eau évaporé, rajoutez encore plus d''eau.', 'Remuez sans cesse autour de l''eau.', 'Une fois l''eau évaporé, mettez toutes les bananes dans un ramequin. Mettez du sucre, puis du sirop d''érable! Et Bon appétit!'], ['Rouleau à pâtisserie', 'Planche à découper', 'Économe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'sirop d''érable', 'bon marché', 'rapide', 'plat', 'Semba', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:11:04.893361', [{'ingredient_id': '4641dc34-5fb7-47cf-ae4a-8f0cdda321e0', 'quantite': '4'}, {'ingredient_id': 'b083e1a5-c1f1-4f54-ae89-90485ee92358', 'quantite': ''}, {'ingredient_id': '3d6d310b-18fa-4eee-b7e7-d350be6f996f', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (12520, 'Potage à la banane (Brésil)', 'oignon, tomates pelées, cube de bouillon, banane, crème fraîche, poivre, sel', '15 min', ['Faire blondir les 2 oignons, ajouter les tomates, le cube, les bananes. Assaisonner de sel, poivre et curry.', 'Laisser cuire 20 minutes. Mixer, puis ajouter la crème fraîche.'], ['Économe', 'Poêle'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'sel', 'confiserie', 'testées', 'tomates pelées', 'très facile', 'bon marché', 'plat', 'recette', 'cube de bouillon', 'cuisine', 'recettes', 'oignon', 'boisson', 'soupe', 'dessert', 'Potage à la banane (Brésil)', 'plat de résistance', 'poivre', 'cocktail'], 'Entrée', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:11:11.790817', [{'ingredient_id': 'f21c96ce-3e04-4feb-a200-256cad04a72f', 'quantite': '2'}, {'ingredient_id': '04b46e98-6a95-4b4e-abb3-268973865226', 'quantite': '850 g'}, {'ingredient_id': '4de41a0d-a3e4-424d-84b6-af6ef9255515', 'quantite': '1'}, {'ingredient_id': 'd6ca64b5-0cf7-4ae7-a209-db5d9a18448d', 'quantite': '2'}, {'ingredient_id': '274c4f94-56e1-45f4-8d6d-c8c8cca071a9', 'quantite': '20 cl'}, {'ingredient_id': '69ba4afe-fd20-49c6-bf89-dcced28cb536', 'quantite': ''}, {'ingredient_id': '00d4f8f3-c61e-4fe8-95e6-edb1f4c7703c', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (58142, 'Fondue au chocolat et aux fruits', 'chocolat noir, crème fraîche, guimauve, fraises, banane, kiwi', '30 min', ['Mettre le chocolat et la crème dans une jatte résistant à la chaleur.', 'Faire chauffer doucement, en remuant pour obtenir une consistance lisse.', 'Servir dans la jatte avec les guimauves et les fruits frais.'], ['Casserole', 'Tire-bouchon', 'Planche à découper', 'Poêle'], ['', 'guimauve', 'entrée', 'Fondue au chocolat et aux fruits', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat noir', 'cocktail'], 'Confiserie', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:11:17.152114', [{'ingredient_id': '14a0e415-dcf2-46e0-870c-d6fd5ec9429f', 'quantite': '250 g'}, {'ingredient_id': '474c3619-9dd9-4bb9-a45a-f3547a1de3db', 'quantite': '12.5 cl'}, {'ingredient_id': '7439d727-5764-445a-b403-a24222a212f5', 'quantite': ''}, {'ingredient_id': '0051be9a-e4d0-4bcc-b3fe-c6778c35b3b3', 'quantite': ''}, {'ingredient_id': '84f50c19-a5d1-4790-ada5-6c473727dae3', 'quantite': ''}, {'ingredient_id': '9d669c9f-e11e-406c-af32-4a1afeaabd38', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (45946, 'Fricassée de fruits chauds', 'beurre, sucre roux, miel liquide, épices, citron vert, orange, pomme, banane, poire, kiwi, pêche', '15 min', ['Faire chauffer le beurre, ajouter le fruits épluchés et coupés en morceau, et les faire frire à feu vif.', 'Ajouter le sucre roux et le miel, en plusieurs fois pour le faire caraméliser.', 'Servir à l''assiette, avec une ou deux boules de glace vanille.'], ['Ouvre-boîte', 'Casserole', 'Mixeur'], ['', 'miel liquide', 'entrée', 'recettes de cuisine', 'épices', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'Fricassée de fruits chauds', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'citron vert', 'cocktail', 'sucre roux'], 'Dessert', 64a828fa-7f14-43d4-8102-de23cd5048c4, '2025-09-26T16:11:20.943711', [{'ingredient_id': '8429ca7b-f5e7-4b6e-bb67-661c08d772ac', 'quantite': ''}, {'ingredient_id': '882380f5-5614-467f-8f56-fc059497337a', 'quantite': ''}, {'ingredient_id': '0d282a02-b12c-4c40-83c6-0e141728be51', 'quantite': ''}, {'ingredient_id': 'dd12fa6c-7fad-4e6f-b32c-be7c63f8e4b0', 'quantite': ''}, {'ingredient_id': '6399086d-1b24-4534-8872-b910e142f2bd', 'quantite': '2'}, {'ingredient_id': '79989570-f7d5-4998-bdc8-1c125da378bf', 'quantite': ''}, {'ingredient_id': '6ffa3dff-9a6a-4a54-9dbf-281e6b6eb6c5', 'quantite': ''}, {'ingredient_id': '6eae0993-1280-4e3c-8e6f-98d4f2139a2a', 'quantite': ''}, {'ingredient_id': 'bcbbf0e8-1f7e-41b9-a73a-582da361aa12', 'quantite': ''}, {'ingredient_id': 'a57f65a9-6b2c-4911-acf5-2c50e05957fc', 'quantite': ''}, {'ingredient_id': '1c619018-5fe1-4fe1-a957-6044eeff26d4', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (88110, 'Tarte légère à la banane', 'banane, citron vert, vergeoise, fleur d''oranger, cannelle, pâte brisée', '40 min', ['Presser le citron vert. ', 'Mélanger l''eau de fleur d''oranger, la moitié de la vergeoise, et la cannelle en poudre.', 'Peler les bananes et les couper en rondelles de 5 mm d''épaisseur. Arroser les de jus de citron au fur et à mesure pour qu''elles ne noircissent pas.', 'Ajouter le mélange fleur d''oranger, cannelle et sucre.', 'Laisser mariner environ 30 min.', 'Beurrer et fariner un moule à tarte, ou mettre du papier sulfurisé au fond du moule.', 'Etaler la pâte brisée et la piquer à la fourchette. Placer le moule au frais le temps de la marinade.', 'Préchauffer le four à 180°C (thermostat 6).', 'Couvrir la pâte des bananes marinées, et de la marinade. Rabattre les bords de la pâte vers l''intérieur. Saupoudrer du sucre restant, et mettre au four jusqu''à ce qu''elle soit dorée (20 à 30 min).'], ['Tire-bouchon', 'Casserole', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'vergeoise', 'plat', 'tarte à la banane', 'recette', 'cuisine', 'pâte brisée', 'recettes', 'Tarte légère à la banane', 'boisson', 'dessert', 'plat de résistance', 'fleur d''oranger', 'citron vert', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:11:27.953457', [{'ingredient_id': '10f0ba1c-cc48-41d0-ad9c-9e4b1b6327fa', 'quantite': '5'}, {'ingredient_id': 'c7f3d50c-0991-42ea-97d2-fe5b7c09e100', 'quantite': '1'}, {'ingredient_id': 'ee8d92d3-2c41-476e-af4a-d9b266083a67', 'quantite': '60 g'}, {'ingredient_id': '705c331e-e17b-4643-aab5-859257d4320d', 'quantite': '10 cl'}, {'ingredient_id': 'cef6eab2-052b-4198-af91-96d959b27f9a', 'quantite': ''}, {'ingredient_id': 'a2d56693-1db7-40c7-b9ae-ff934afa3edd', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (227696, 'Mousse de bonbons à la banane', 'bonbon, crème fraîche liquide, blanc d''oeuf, gélatine', '15 min', ['Faire tremper la 1/2 feuille de gélatine dans un bol d''eau froide.', 'Faire fondre les bananes avec la crème fraîche dans une casserole. Bien mélanger avec un fouet afin que cela ne colle pas.', 'Retirer du feu dès que les bananes sont complètement fondues et y ajouter la gélatine. Bien mélanger.', 'Monter les blancs d''oeufs en neige puis les mélanger délicatement avec la préparation aux bananes.', 'Répartir la préparation dans 4 verres (j''utilise des verres à cocktail) et laisser reposer 2h au frigo.'], ['Planche à découper', 'Mixeur'], ['entrée', 'recettes de cuisine', 'bonbon', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'crème fraîche liquide', 'cuisine', 'recettes', 'boisson', 'Mousse de bonbons à la banane', 'dessert', 'plat de résistance', 'gélatine', 'mousse fruits', 'blanc d''oeuf', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:11:33.034374', [{'ingredient_id': '9d0351b0-688c-44e7-97ee-469d94182bad', 'quantite': '20'}, {'ingredient_id': 'e9d773cc-9f77-4f33-bcfb-04412012407b', 'quantite': '10 cl'}, {'ingredient_id': 'bc11f75e-68cc-409d-b867-1c8164a819b1', 'quantite': '2'}, {'ingredient_id': '2415fbe2-7452-4b50-bc5b-ecb9ce5e98f3', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (25974, 'Poulet à l''exotique (au pamplemousse)', 'poulet, beurre, pamplemousse, banane, Liqueur, poivre, sel', '30 min', ['Verser à l''intérieur du poulet le verre de liqueur en retournant le poulet afin que tout l''intérieur se parfume. Farcir le poulet avec un pamplemousse épluché puis recoudre ce dernier et laisser ainsi une heure au frais. ', 'Beurrer le poulet, saler et poivrer, cuire au four 1h environ à 200°C (thermostat 6-7).', 'Presser le jus d''un demi-pamplemousse, en cours de cuisson, arroser le poulet avec son jus de cuisson auquel on aura ajouté le jus de pamplemousse. ', 'Mettre dans le plat autour du poulet les autres pamplemousses épluchés et tranchés 5 minutes avant la fin de la cuisson. ', 'Eplucher et couper les pommes ou les bananes, les faire sauter quelques minutes, à part dans du beurre. ', 'Servir le poulet entouré des rondelles de pamplemousses et de pommes ou bananes.'], ['Planche à découper', 'Râpe'], ['', 'poulet', 'banane', 'entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pamplemousse', 'beurre', 'Liqueur', 'Poulet à l''exotique (au pamplemousse)', 'poivre', 'cocktail'], 'Plat principal', 59f2e147-7e24-4858-9f6d-2de5cf0464e3, '2025-09-26T16:11:37.717903', [{'ingredient_id': '47e8e283-e8eb-4950-8709-0223828fd685', 'quantite': '1'}, {'ingredient_id': 'db6d48b7-11aa-42f7-9a1f-d4be92f23d82', 'quantite': '100 g'}, {'ingredient_id': '89baebaa-f1df-4e71-ab17-09ff111a2fe2', 'quantite': '4'}, {'ingredient_id': 'dfda1253-bb1b-472e-a8eb-2f035afb5cc2', 'quantite': '4'}, {'ingredient_id': 'd4ea20dd-3a76-48d9-8b3b-a57d1b433f01', 'quantite': '1'}, {'ingredient_id': 'e7a06ef2-8d35-43ca-af4b-1c5fe7e2a7ff', 'quantite': ''}, {'ingredient_id': '227d663f-cf84-4226-bde5-0685458a1b72', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (21839, 'Milk shake à la banane (à la quick)', 'banane, lait concentré sucré, yaourt, lait, glace vanille', '5 min', ['C''est très simple : tout mélanger dans un mixeur.'], ['Fouet', 'Planche à découper', 'Rouleau à pâtisserie'], ['', 'entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'lait concentré sucré', 'boisson', 'glace vanille', 'dessert', 'plat de résistance', 'Milk shake à la banane (à la quick)', 'lait', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:11:41.338109', [{'ingredient_id': '676cba2c-da10-40b6-af45-6af72b1488bb', 'quantite': ''}, {'ingredient_id': '8664e8cd-4dd9-4c9f-8b10-d1d0d989062d', 'quantite': '8 g'}, {'ingredient_id': '0f356b23-422a-422a-97be-46aaebc8527f', 'quantite': '1'}, {'ingredient_id': 'd181a28f-9c52-4fe3-becd-32bd82f385a4', 'quantite': '14 cl'}, {'ingredient_id': '4a86c7c0-eadb-4417-8cc7-f0a45e75116d', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (33803, 'Nems dessert aux fruits', 'galette de riz, pomme, fruits rouges, banane, raisins secs, cassonade, vanille, cannelle, jus de citron, nappage chocolat, coulis de fruits rouges, crème chantilly', '60 min', ['Déballer les feuilles de riz surgelées et les poser dans une assiette, les recouvrir d''un torchon humide. ', 'Couper les pommes en petits cubes (c''est long!), les parsemer de cannelle et les arroser de jus de citron, puis les mettre au micro ondes au maximum pendant à peu près 10 min, elles doivent être assez molles. ', 'Nous allons préparer 3 sortes de farces : ', 'Pomme vanille : ', 'mettre la moitié des pommes dans une casserole avec du beurre, faire revenir, puis verser cassonade, vanille en poudre (au goût) et un peu de cannelle, jusqu''à ce que le tout soit un tout petit peu en bouillie. ', 'Pomme fruits rouges : ', 'même chose, sans la vanille et la cannelle mais en ajoutant les fruits rouges ; prenez la moitié des pommes restantes, et pas trop de fruits rouges car ça couvre le goût!. ', 'Pomme banane : ', 'même chose en remplaçant les fruits rouges par la banane et les raisins secs, et pas trop de banane car c''est un peu écœurant !', 'La préparation des nems : ', 'Asseyez-vous à table avec une assiette plate et un bol d''eau. ', 'Posez les différents mélanges à côté. ', 'Prenez une feuille de riz dans votre assiette (si elles ne sont pas surgelées, il faut les tremper dans l''eau) de façon à avoir un coin vers vous. ', 'Posez un tapon de mélange (gros comme un nem) au coin qui est vers vous. ', 'Enroulez votre feuille autour jusqu''à moitié. ', 'Rabattez les deux coins des côtés sur votre nem en serrant bien. ', 'Finissez d''enrouler. ', 'Pour que ça ferme bien, vous pouvez mouiller un peu le dernier coin. ', 'Idem pour les 39 autres nems. ', 'La cuisson : ', 'dans une poêle remplie d''huile frémissante, faites tremper les nems jusqu’à ce qu''ils soient dorés ; vous pouvez aussi le faire à la friteuse : ', 'Dans une poêle avec juste un peu d''huile au fond, c''est plus régime, mais il faut les retourner souvent!', 'Dégustation ! On pose les nems sur la table, chacun a trois petits pots de coulis chocolat, fruits rouges et de chantilly et peut tremper ses nems dedans !', 'Si vous aviez préparé les nems à l''avance, vous pouvez les remettre un peu au four avant de servir.'], ['Fouet', 'Mixeur', 'Planche à découper', 'Tire-bouchon', 'Ouvre-boîte'], ['', 'coulis de fruits rouges', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'cassonade', 'bon marché', 'plat', 'moyenne', 'fruits rouges', 'recette', 'Nems dessert aux fruits', 'cuisine', 'recettes', 'boisson', 'crème chantilly', 'vanille', 'dessert', 'plat de résistance', 'jus de citron', 'pomme', 'galette de riz', 'raisins secs', 'nappage chocolat', 'cannelle', 'cocktail'], 'Dessert', 70e4cee0-5170-4fb8-8a8d-dc461fb15fd5, '2025-09-26T16:11:45.157281', [{'ingredient_id': '89674fc8-b7e3-4ae7-a27a-86d2c2833814', 'quantite': '40'}, {'ingredient_id': 'dfeec16e-8174-4a20-9993-00ee7a3e5407', 'quantite': '10'}, {'ingredient_id': 'ed707748-7d9c-4c42-9afb-c857273eb74f', 'quantite': '300 g'}, {'ingredient_id': '4f366976-8f6f-46df-839b-1c009ffb402f', 'quantite': '2'}, {'ingredient_id': '32e5ac66-b920-41b4-aeef-f63919ffe557', 'quantite': ''}, {'ingredient_id': '8806432f-f226-4f8c-89bc-ac946484b628', 'quantite': ''}, {'ingredient_id': '36adc237-86e9-4a00-ad5e-5330a88eed9a', 'quantite': ''}, {'ingredient_id': '5fa3b391-0e1e-403d-b2bb-49fcfc421540', 'quantite': ''}, {'ingredient_id': 'c955d62b-df05-4a8d-a5df-82f41a74f5e6', 'quantite': ''}, {'ingredient_id': 'b45ba1a1-3c38-4c37-8880-da8ed5b08b63', 'quantite': ''}, {'ingredient_id': 'c2dcfeff-804c-4f71-81e8-4d60cf9262df', 'quantite': ''}, {'ingredient_id': '59c87fe7-c320-44d5-a3c6-7ddaafa55758', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (65642, 'Smoothie yaourt banane', 'yaourt brassé, banane, lait écrémé', '5 min', ['Couper les bananes en morceaux et les ajouter aux yaourts dans un blender ainsi que le lait. Mixer le tout et boire à la paille ou au verre !', 'Ajouter selon les goûts du miel ou du sucre roux !'], ['Passoire', 'Moule à tarte'], ['', 'entrée', 'Smoothie yaourt banane', 'banane', 'recettes de cuisine', 'yaourt brassé', 'confiserie', 'lait écrémé', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'cocktail'], 'Dessert', ba09b947-6083-482c-9970-b15570297702, '2025-09-26T16:11:48.685512', [{'ingredient_id': '4dfaf791-d3e7-4abf-b649-91d3dd2cadef', 'quantite': '2'}, {'ingredient_id': '534b432c-8a60-4c68-87be-18e99bc62fe2', 'quantite': '2'}, {'ingredient_id': '86a0e50c-dde3-40c3-b7b8-a570fd947a15', 'quantite': '15 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (62382, 'Beignets banane de la Réunion', 'banane, vanille, sucre roux, farine, beurre, rhum', '15 min', ['Écraser les bananes pour obtenir une sorte de purée.', 'Ouvrir la gousse de vanille pour en récupérer le coeur et mélanger à la purée. Ajouter le rhum ou l''anisette.', 'Ajouter le sucre (plus les bananes sont mûres, plus elles sont sucrées, donc goûtez quand même votre préparation). Ajouter la farine. ', 'Il ne faut pas que la pâte soit trop molle. ', 'Faire fondre le beurre dans une poêle.', 'Former un à un environ 20 beignets dans la poêle à l''aide d''une cuillère à soupe quand le beurre est bien chaud. Les beignets ne doivent pas être trop épais. ', 'Faire cuire de chaque côté pendant environ 3 minutes à feu moyen. Si besoin, retourner à nouveau vos beignets.', 'Changer le beurre toutes les 2 fournées, il risque de noircir.'], ['Fouet', 'Balance de cuisine', 'Rouleau à pâtisserie', 'Louche', 'Planche à découper'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'Beignets banane de la Réunion', 'recette', 'cuisine', 'recettes', 'boisson', 'beignets sucrés', 'farine', 'vanille', 'dessert', 'plat de résistance', 'beurre', 'cocktail', 'sucre roux'], 'Dessert', 28a944e4-3f66-4f9b-8d05-d06a0eb340e5, '2025-09-26T16:11:52.150080', [{'ingredient_id': 'f36642a6-93f5-4afa-a992-0b7732f25d61', 'quantite': '14'}, {'ingredient_id': 'be71e8de-0c7e-4e66-b788-79beb270cf24', 'quantite': '1'}, {'ingredient_id': '55c868aa-4a31-4f19-a9e6-74b1ef7c7967', 'quantite': '3 cuillères'}, {'ingredient_id': '6ab61224-e284-466d-a26c-feca94ac5bd8', 'quantite': '4 cuillères'}, {'ingredient_id': '8b15601b-3262-4572-98ee-d40efad62d6f', 'quantite': ''}, {'ingredient_id': 'ea4f02d2-37d8-4b82-9be8-e3302ef0fe71', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (13516, 'Glace à la banane', 'banane, sirop de sucre de canne, crème fraîche, citron', '15 min', ['Passer tout ça au mixer, et faire prendre en sorbetière, c''est délicieux !'], ['Batteur électrique', 'Mixeur', 'Rouleau à pâtisserie', 'Passoire'], ['sirop de sucre de canne', 'banane', 'entrée', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'très facile', 'bon marché', 'Glace à la banane', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'citron', 'glace à l''italienne', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:11:58.334025', [{'ingredient_id': '854a62ac-7c46-4c3e-9351-9ed32281e579', 'quantite': '4'}, {'ingredient_id': '331d3a4d-f432-4fe3-b256-00caf933a172', 'quantite': '25 cl'}, {'ingredient_id': '352f2614-6def-4c60-911b-15d2e5cfd7d6', 'quantite': '25 cl'}, {'ingredient_id': 'c0d386de-9e2b-431c-8c9b-8ab9e156e896', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (167436, 'Crumble pommes-bananes au sucre vanillé', 'pomme, banane, farine, sucre, beurre, sucre vanillé', '10 min', ['Préchauffez votre four à 220°C (thermostat 7) et sortir le beurre pour qu''il ramollisse, il sera ainsi plus facile à travailler.', 'Epluchez la banane, coupez la en lamelles, et répartir le fond de vos ramequins avec les rondelles de bananes.', 'Coupez la pomme en quatre, l''épépiner, l''éplucher, puis la couper en lamelles. Disposez ces dernières dans les ramequins, sur les rondelles de bananes.', 'Dans un saladier, mélangez la farine, le sucre et le beurre, préalablement coupé en petits dés. Disposez cette préparation sur les fruits. ', 'Enfin, saupoudrez les ramequins de sucre vanillé.', 'Enfourner le tout pour 10 min environ, les crumbles doivent être un peu colorés sur le dessus, quitte à ce qu''ils soient un peu gratinés.', 'Dégustez chaud, ou tiède, avec de la glace à la vanille et au chocolat. Bon appétit !'], ['Poêle', 'Presse-agrumes', 'Balance de cuisine'], ['Crumble pommes-bananes au sucre vanillé', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'crumble aux pommes', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'beurre', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:12:02.248601', [{'ingredient_id': '1ee4e5b5-d36c-4565-bcdb-bcba713ae606', 'quantite': '1'}, {'ingredient_id': 'f7032f8c-b956-4f0e-a9e2-267ec2409e3e', 'quantite': '1'}, {'ingredient_id': 'c8a75642-60c0-4951-b068-d6405c04f98b', 'quantite': '100 g'}, {'ingredient_id': '77ca08c6-519d-4ce0-af0d-acb93f57cd88', 'quantite': '60 g'}, {'ingredient_id': 'd471d9d4-e151-4dd9-a25e-85cbef6284ce', 'quantite': '45 g'}, {'ingredient_id': 'a372025b-e778-484d-821a-4da4edac715a', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (32532, 'Tarte vergeoise à la banane', 'farine, beurre, sucre glace, sel, lait, eau, banane, beurre, oeuf, vergeoise', '25 min', ['Préparez la pâte sablée : dans un saladier, versez la farine, le sucre glace et le sel ; ajouter le beurre en morceaux. Du bout des doigts, travaillez le tout pour obtenir comme du sable. Ajoutez l''eau et le lait, puis formez rapidement une boule de pâte sans trop la travailler. Mettez au frigo au moins 1/2 heure. ', 'Sortez la pâte du frigo et faites préchauffer le four à 210°C (thermostat 7). ', 'Etalez rapidement la pâte avec un rouleau ou du bout des doigts. Déposez-y dessus les bananes coupés en demi-rondelles un peu épaisses. ', 'Préparez la garniture : ', 'faites fondre le beurre. Quand il est bien liquide ajouter hors du feu les 3 oeufs et le sucre vergeoise. Bien mélanger. Versez sur la pâte et les bananes. ', 'Enfournez à Th 7 pendant 15 mn, Th 9 pendant 10 mn. ', 'Servez tiède ou froid, avec une glace à la vanille ou à la cannelle.'], ['Casserole', 'Passoire', 'Fouet', 'Économe'], ['entrée', 'recettes de cuisine', 'sel', 'confiserie', 'eau', 'testées', 'Tarte vergeoise à la banane', 'très facile', 'bon marché', 'plat', 'tarte à la banane', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'beurre', 'sucre glace', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:12:05.897870', [{'ingredient_id': '8093f90c-4ba4-403d-820c-d17036c8c34d', 'quantite': '200 g'}, {'ingredient_id': '4596d5d2-abd6-4c90-8312-fde1ed0107b3', 'quantite': '100 g'}, {'ingredient_id': '0a507e53-7ee0-4c27-b189-43be97979dd5', 'quantite': '80 g'}, {'ingredient_id': '7ed17a25-d526-4278-83a8-40006fe7d3ba', 'quantite': '1'}, {'ingredient_id': '48013764-558c-4ac6-85c6-f1b8b3e2afd1', 'quantite': '1 cuillères'}, {'ingredient_id': 'af8a2883-7423-42a0-aafa-1507f6bb474d', 'quantite': '3 cuillères'}, {'ingredient_id': '3ae15d9d-2b75-409e-8061-2ac7ba9e0d67', 'quantite': '3'}, {'ingredient_id': '7141718c-a45d-4c36-b489-f7ce0340812e', 'quantite': '120 g'}, {'ingredient_id': '21482457-0159-4358-a418-bb3f7c1f5c53', 'quantite': '3'}, {'ingredient_id': '11c01da1-0093-4291-b7ff-38e970c6cee6', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (48864, 'Crème de banane au tofu', 'tofu soyeux, sucre, banane, cannelle, huile', '10 min', ['Passer le tofu soyeux au mixeur, puis ajouter la banane écrasée, le sucre et éventuellement la cannelle et l''huile essentielle.', 'Mixer de nouveau jusqu''a l’obtention d''un mélange homogène.', 'Verser dans 4 ramequins et laisser prendre au réfrigérateur au moins une demi- journée.', 'Servir très frais.'], ['Ouvre-boîte', 'Râpe'], ['', 'Crème de banane au tofu', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'dessert', 'plat de résistance', 'moyen', 'cannelle', 'sucre', 'cocktail', 'tofu soyeux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:12:09.742649', [{'ingredient_id': 'ccce6e8c-b56b-426f-a9be-19feca7f8ff1', 'quantite': '1'}, {'ingredient_id': 'daee5c97-ba40-4c84-bc3e-339baeacdab2', 'quantite': '3 cuillères'}, {'ingredient_id': 'deaf4572-6e96-4843-9ae0-2fe611616a84', 'quantite': '1'}, {'ingredient_id': 'e4aa0b2b-be14-4548-a411-780cdd673a6a', 'quantite': '1'}, {'ingredient_id': '78d97a19-9631-4444-bc62-1bbfce913b96', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (69944, 'Foutou banane ou foufou banane (côte d''ivoire)', 'banane plantain, manioc, farine de manioc', '60 min', ['Faire cuire les bananes et le manioc épluchés à la vapeur, les piler au mortier (ou au robot).', 'Rajouter de la farine de manioc pour obtenir la consistance désirée. ', 'En général, on forme des grosses boules type pâton avec le foutou, qu''on sert ensuite en accompagnement d''une sauce. On peut le préparer d''avance et le réchauffer à la vapeur.'], ['Planche à découper', 'Râpe', 'Économe', 'Mixeur'], ['', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'manioc', 'farine de manioc', 'dessert', 'plat de résistance', 'banane plantain', 'cocktail', 'Foutou banane ou foufou banane (côte d''ivoire)'], 'Accompagnement', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:12:13.270876', [{'ingredient_id': '30341744-9876-4897-b858-b2a52b2c9b51', 'quantite': '6'}, {'ingredient_id': '0d2a838a-7aea-4eaa-b85a-02d87dd8b629', 'quantite': '1'}, {'ingredient_id': '1d913318-8a5d-4a7b-a2cf-ba5202e646e8', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (54164, 'Délicieux pudding banane', 'banane, farine, lait, beurre, sucre roux, levure, sel, eau, beurre, cassonade, cannelle', '10 min', ['Préchauffer le four à 180°C.', 'Couper les bananes en rondelles et les disposer au fond d''un moule à tarte.', 'Mélanger tous les ingrédients du gâteau et verser sur les bananes, bien étaler (c''est assez pâteux).', 'Faire chauffer les ingrédients du sirop jusqu''à dissolution du sucre, et verser sur la pâte.', 'Faire cuire 35 minutes, le gâteau va absorber une partie du sirop, qui restera dessous.', 'Laisser tiédir.', 'Recueillir le sirop superflu et démouler le pudding ou bien retourner le pudding sur un grand plat si vous souhaitez le déguster tout de suite.', 'Attention à la sauce!'], ['Râpe', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'Délicieux pudding banane', 'pudding', 'dessert', 'plat de résistance', 'beurre', 'lait', 'cocktail', 'sucre roux'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:12:17.439325', [{'ingredient_id': '16f1046a-d65f-41e4-a59c-c4c5d107df3b', 'quantite': '2'}, {'ingredient_id': '2d7dcd54-6f0f-475a-ac68-0277f6a6d111', 'quantite': '250 g'}, {'ingredient_id': 'f39c3dda-db8a-463f-bf0c-40e6b990164e', 'quantite': '12.5 cl'}, {'ingredient_id': 'fc94927d-8f53-4002-961d-334e8ee2035f', 'quantite': '20 g'}, {'ingredient_id': '703796d0-e368-46ed-83d4-b8b462904421', 'quantite': '65 g'}, {'ingredient_id': '81ee580b-eeaf-4796-bdcd-fab64a7eb912', 'quantite': '1'}, {'ingredient_id': '16813d8a-2096-4f72-9686-394d461aa32f', 'quantite': '1'}, {'ingredient_id': '9731a7cb-4af3-4996-8994-1ea54c3758b8', 'quantite': '25 cl'}, {'ingredient_id': 'c2e5ac4d-a887-4761-9e0d-a59d10e7fec4', 'quantite': '15 g'}, {'ingredient_id': 'b88acc6b-7cc1-463f-a31d-d0e4129e2cb3', 'quantite': '250 g'}, {'ingredient_id': '5bf17454-d7fb-4626-828b-f3f954304a57', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (331208, 'Milk-shake banane et pomme', 'pomme, banane, cannelle, sucre, sucre vanillé, lait', '10 min', ['Couper en petits morceaux pomme et banane.', 'Verser dans un mixeur tous les ingrédients.', 'Pour ne pas qu''il y ait trop de lait, ajouter le lait petit à petit : il ne faut pas que le lait submerge le reste.', 'Mixer, c''est prêt !'], ['Économe', 'Planche à découper'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'Milk-shake banane et pomme', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'cannelle', 'sucre', 'lait', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:12:21.068701', [{'ingredient_id': '031670bf-7d47-4e3d-b52e-76c92cb3e0b2', 'quantite': '1'}, {'ingredient_id': 'c052fe39-c2e8-4ee0-b441-47ae5759b87f', 'quantite': '1'}, {'ingredient_id': '591be25c-760e-4fc5-bc94-497770a371b1', 'quantite': '2 cuillères'}, {'ingredient_id': '085bdccc-0177-4833-89b5-c1a430655b4e', 'quantite': '1 cuillères'}, {'ingredient_id': 'c4d09bb3-c7fd-4b51-87ec-9606099c33bc', 'quantite': '1'}, {'ingredient_id': 'e1cb0ee9-664c-408d-887a-00f4b149b7de', 'quantite': '10 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (44641, 'Tarte pommes, bananes et clémentines', 'pâte feuilletée, clémentine, pomme, banane, compote, raisins secs, sucre vanillé, cannelle', '30 min', ['Disposez dans votre plat à tarte, le papier sulfurisé et la pâte feuilletée.', 'Découpez les bords de la pâte à l''aide de ciseaux, et réservez.', 'Etalez la portion de compotes de pommes sur l''ensemble de la pâte, à l''aide du dos d''une cuillère.', 'Epluchez les clémentines, séparez les quartiers; épluchez la banane, coupez-la en fines rondelles, et réservez-en quelques unes.', 'Disposez quartiers de clémentines et rondelles de bananes en rosace, en alternant (quartier, rondelle, quartier...).', 'Epluchez la pomme, dénoyautez-la, coupez-la en quartiers, et disposez-la en rosace sur la pâte.', 'Vous pouvez enfin mettre les dernières rondelles de bananes, au coeur de la pâte (et toujours en rosace).', 'Versez le sachet de sucre vanillé sur la préparation, puis mettez la cuillère de cannelle sur les pommes.', 'Disposez une poignée de raisins secs un peu partout...', 'Reprenez les lamelles de pâte réservées, et posez-les horizontalement et verticalement sur la tarte, comme une grille.', 'Préchauffez le four 10 min à 210°C (th 7), et enfournez 30 min...', 'Bon appétit!'], ['Moule à tarte', 'Râpe', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'Tarte pommes', 'plat', 'tarte aux pommes', 'recette', 'compote', 'cuisine', 'recettes', 'boisson', 'clémentine', 'dessert', 'plat de résistance', 'pâte feuilletée', 'sucre vanillé', 'pomme', 'bananes et clémentines', 'raisins secs', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:12:24.810338', [{'ingredient_id': '78662fec-1c9e-4a5a-bb61-20a26217fab7', 'quantite': '1'}, {'ingredient_id': '7afa86b5-104e-430c-a8af-b995f67e4b83', 'quantite': '3'}, {'ingredient_id': '7e96aee5-a163-4d42-9aea-fe68c3aced8f', 'quantite': '1'}, {'ingredient_id': '7e744a4e-d7e5-4666-867d-e924549fa020', 'quantite': '1'}, {'ingredient_id': '75b5f8f7-65ab-4382-a9ef-35840446c341', 'quantite': '1'}, {'ingredient_id': '602a7103-9cea-4ec2-a902-724b2bdd1db9', 'quantite': '1'}, {'ingredient_id': '5d930fdd-452a-4709-b02c-9736e899bebc', 'quantite': '1'}, {'ingredient_id': 'c54079a2-30c4-4db7-993e-8901af3953d2', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (30931, 'Gâteau aux bananes et pépites de chocolat', 'oeuf, sucre en poudre, sucre vanillé, cannelle, beurre, farine, levure, banane, chocolat', '10 min', ['Préchauffer le four à thermostat 8 (250°C), et beurrer un moule à gâteau. ', 'Mélanger les 2 oeufs entiers avec les 75 g de sucre, les 100 g de beurre fondu, les 100 g de farine et le 1/2 paquet de levure mélangé à la farine et la pincée de cannelle. ', 'Ajouter 1 banane coupée en rondelles, le paquet de pépites de chocolat. ', 'Verser dans le moule. Eparpiller sur le dessus de la pâte la 2ème banane coupée en rondelles fines, et saupoudrer de sucre vanillé. ', 'Enfourner dans le four chaud, et laisser cuire 15 à 20 min; le gâteau doit être moelleux et doré.'], ['Presse-agrumes', 'Moule à tarte', 'Couteau de chef', 'Pince de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'très facile', 'bon marché', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'beurre', 'Gâteau aux bananes et pépites de chocolat', 'gâteau au chocolat', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:12:31.907538', [{'ingredient_id': '109eeebb-46de-4126-9258-e77376dd0185', 'quantite': '2'}, {'ingredient_id': '3ef09eb9-7e11-4402-ac8f-e147aee26437', 'quantite': '75 g'}, {'ingredient_id': '94e551ca-2d81-4ca3-8e9d-e5430662107c', 'quantite': '1'}, {'ingredient_id': '439344fc-7d6e-4308-a4e3-af42240befa9', 'quantite': '1'}, {'ingredient_id': 'e18d1d55-c349-4b13-9f7d-95c68fd3e9c2', 'quantite': '100 g'}, {'ingredient_id': 'c4583cf1-6324-4a04-ba8c-bc594987ac93', 'quantite': '100 g'}, {'ingredient_id': '21604fa9-981d-4c64-85d1-3dc370a2a4c0', 'quantite': ''}, {'ingredient_id': '2451d360-475e-4674-892d-6c4ef2ed29cd', 'quantite': '2'}, {'ingredient_id': 'f0d17a99-3cbb-4593-8685-cc475814d534', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (82114, 'Cake banane choco', 'farine, sucre semoule, levure chimique, sucre vanillé, oeuf, beurre, banane, chocolat', '15 min', ['Dans un récipient écraser à l''aide d''une fourchette le beurre et le sucre ensemble (sans faire fondre le beurre).', 'Dans un autre récipient, écraser les bananes, puis l''ajouter à la préparation sucre+beurre.', 'Battre en omelette les oeufs puis les mélanger avec la précédente.', 'Rajouter la farine et levure ainsi que les pépites.', 'Faire cuire environ 50 minutes à 180°C (thermostat 6).'], ['Poêle', 'Verre doseur', 'Casserole'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'chocolat', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'sucre semoule', 'boisson', 'farine', 'Cake banane choco', 'autres cakes', 'dessert', 'plat de résistance', 'sucre vanillé', 'beurre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:12:37.694667', [{'ingredient_id': '4ddcdf20-e780-4ddc-8fdf-fe30e9a1ac71', 'quantite': '200 g'}, {'ingredient_id': '8fbdf18f-16ba-4708-9e0f-581c9cfe12fc', 'quantite': '100 g'}, {'ingredient_id': 'fced3e2f-3e92-49e5-a155-887c8a1b478b', 'quantite': '1'}, {'ingredient_id': '1ff6d454-a098-459a-a70c-47ddc0a66674', 'quantite': '2'}, {'ingredient_id': '183aa572-2381-48c1-9732-f320333d1b48', 'quantite': '3'}, {'ingredient_id': '16ea3f40-f542-44e8-b7d8-9bfbefa8b37a', 'quantite': '100 g'}, {'ingredient_id': '31105c7d-99fd-4d41-b2fb-8c97c9d5e881', 'quantite': '3'}, {'ingredient_id': 'eb51fa8d-41f2-4fe6-bc60-406c343f6168', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (22517, 'Curry à ma façon', 'blanc de poulet, oignon, ail, tomates concassées, banane, pomme, noix de coco rapée, lait de coco, curry, gingembre, piment', '20 min', ['La veille: ', 'découper les blancs de poulets en morceaux de 3 ou4 cm. ', 'Emmincer l''oignon très finement, sans le hacher. ', 'Emmincer la pomme en petits dés. ', 'Ecraser les gousses d''ail. ', 'Mettre l''ensemble dans un saladier et bien mélanger. Puis saupoudrer avec le curry, le gingembre, les piments oiseaux écrasés. ', 'Recouvrir d''un film plastique et mettre au frais. ', 'Le lendemain, sortir la préparation 1 h à l''avance, puis la faire revenir dans de l''huile d''olive juste pour colorer les morceaux. ', 'Ajouter les tomates concassées, bien mélanger, puis le sel et poivre. ', 'Enfin ajouter le lait de coco, ramener à ébullition, baisser le feu et laisser mijoter à feu doux 20 mn. ', 'Servir avec du riz basmati, les bananes coupées en dés et la noix de coco râpée. Chacun fera son petit mélange.'], ['Économe', 'Casserole', 'Rouleau à pâtisserie'], ['lait de coco', 'gingembre', 'entrée', 'tomates concassées', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'ail', 'plat', 'blanc de poulet', 'recette', 'piment', 'cuisine', 'recettes', 'oignon', 'boisson', 'noix de coco rapée', 'dessert', 'plat de résistance', 'pomme', 'Curry à ma façon', 'curry', 'viande à l''indienne', 'cocktail'], 'Plat principal', 01acb752-d237-496d-aac1-6231e7ab0ddc, '2025-09-26T16:12:41.578593', [{'ingredient_id': 'e0d8166b-bdcb-4fd1-b806-4ddd3070d979', 'quantite': '8'}, {'ingredient_id': 'c83ca0d0-618b-4abd-9c86-d4b3ed3173df', 'quantite': '2'}, {'ingredient_id': '93efdb18-abf0-4444-8593-4fcd586f1e69', 'quantite': '3'}, {'ingredient_id': '0acb20e0-332e-4b18-8fe4-f7fe03bb5e24', 'quantite': '1'}, {'ingredient_id': '8bfb87b4-405a-4b0d-84be-6d923b98859b', 'quantite': '2'}, {'ingredient_id': '6268ccc4-2045-4ab5-a429-40705acd6b96', 'quantite': '1'}, {'ingredient_id': 'b1817554-232b-468c-8849-0ca5db5b4e19', 'quantite': ''}, {'ingredient_id': '1f02b188-04d5-45fe-b229-15f9ba317085', 'quantite': '1'}, {'ingredient_id': '5fc77276-89de-4d7a-91e3-01870ac2f7bd', 'quantite': '4 cuillères'}, {'ingredient_id': 'fd4d604e-37f9-4e20-bea9-80bd25f59e7b', 'quantite': ''}, {'ingredient_id': 'b23d9ea8-19a6-49be-945b-21550281096e', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (33350, 'crumble énergétique', 'pomme, banane, pruneau, abricot, palets bretons, farine, beurre, cassonade, sucre vanillé, cannelle', '30 min', ['1) Préparer une compote avec les pommes, abricots et pruneaux pendant 10 mn (pas plus). ', '2) Beurrer le plat à gratin, couper les bananes en rondelles et les disposer au fond du plat. ', '3) Ajouter les pommes, abricots, pruneaux aux bananes. Couvrir de sucre vanillé et de cannelle. ', '4) Dans un saladier, émietter les palets bretons avec la farine, le beurre et le sucre. ', '5) Verser cette préparation sur les fruits et mettre au four à 200°C pendant 20 mn. Les 10 dernières minutes mettre en mode grill pour faire dorer le dessus de crumble.'], ['Ouvre-boîte', 'Passoire', 'Batteur électrique', 'Couteau de chef', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'cassonade', 'pruneau', 'abricot', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'palets bretons', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'autres crumbles', 'beurre', 'crumble énergétique', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:12:45.291214', [{'ingredient_id': '079f43bd-15c6-47ba-81e9-93131bb24ecd', 'quantite': '4'}, {'ingredient_id': '38a4a1f4-da60-4736-b81e-dc34b9d5125a', 'quantite': '3'}, {'ingredient_id': '8ca5df38-e3f8-41ec-87d8-637e4f505921', 'quantite': '10'}, {'ingredient_id': '15cda41a-4ce8-46c7-96df-6b01da2cb311', 'quantite': '10'}, {'ingredient_id': '23386d20-3902-4aba-be7f-e47dad70b7b6', 'quantite': '1'}, {'ingredient_id': '821b8fa3-6d64-4984-8bc9-e964a77a17f1', 'quantite': '100 g'}, {'ingredient_id': '62f3bf75-9134-4c20-962a-cf44e1403a2b', 'quantite': '100 g'}, {'ingredient_id': '0bb4b624-d987-4e11-8884-a3548f4e9a83', 'quantite': '100 g'}, {'ingredient_id': 'dacc4678-9fc1-4b85-933c-5758599e478c', 'quantite': '2'}, {'ingredient_id': 'a64e210c-d9fb-40d2-b67a-417b9eef4055', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (27432, 'Poulet curry fruité', 'blanc de poulet, oignon, ail, poivron jaune, pomme, pomme de terre, carotte, tomates pelées, lait de coco, banane, citron, curry, gingembre, cannelle, cube de bouillon, poivre, sel, huile de tournesol', '30 min', ['Faire revenir le poulet coupé en dés dans une poêle avec un peu d''huile et le curry sur feux vif, retirer dès qu''il est doré. ', 'Dans une cocotte, faire dorer les oignons avec un peu d''huile, rajouter les poivrons coupés en dés. Peler les pommes et la carotte, coupez-les en dés et ajoutez aux oignons. Passer les tomates en boîte à la passoire et garder le jus. Couper les tomates en dés et ajoutez au reste. ', 'Ajouter le poulet, l''ail haché, puis la boîte de lait de coco et le jus des tomates, dans lequel vous aurez dissout le cube de bouillon. Ajouter le gingembre râpé, une pincée de cannelle et le poivre, attendre la fin de la cuisson pour saler. Laisser cuire à feux doux, petits bouillons, couvert, pendant 1 h. ', 'Une fois cuit, passer le tout à la passoire, récupérer le jus dans une casserole et y ajouter la banane en purée et le jus de citron. Faire réduire de moitié environ, pour que la sauce épaississe et la remettre dans le poulet. ', 'Servir avec du riz collant, type japonnais pour sushi et noix de coco râpée.'], ['Planche à découper', 'Ouvre-boîte'], ['lait de coco', 'gingembre', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'tomates pelées', 'carotte', 'très facile', 'curry de poulet', 'ail', 'plat', 'blanc de poulet', 'recette', 'cube de bouillon', 'cuisine', 'recettes', 'oignon', 'Poulet curry fruité', 'boisson', 'huile de tournesol', 'dessert', 'plat de résistance', 'pomme', 'moyen', 'citron', 'cannelle', 'poivre', 'pomme de terre', 'poivron jaune', 'curry', 'cocktail'], 'Plat principal', 04d69d4a-f517-42a5-8201-8b631c44d235, '2025-09-26T16:12:50.284968', [{'ingredient_id': '7f8f9665-4821-4bcc-9f72-d4e6dd51af79', 'quantite': '600 g'}, {'ingredient_id': 'a58968eb-96c2-462a-afdb-72321692ecd0', 'quantite': '2'}, {'ingredient_id': '0941f30d-6d93-4e55-8149-c2f86d1d27d4', 'quantite': '2'}, {'ingredient_id': 'cb7e8ca2-2220-422a-9357-24ee0bda1f61', 'quantite': '1'}, {'ingredient_id': '8fbd2d27-889e-482f-b3be-f9a66af80d5c', 'quantite': '1'}, {'ingredient_id': '8a5bead8-e0cc-44d2-a73d-58d4543d4feb', 'quantite': '1'}, {'ingredient_id': '4a4285ee-3ed0-4d51-ab17-7fdcf8fa31b0', 'quantite': '1'}, {'ingredient_id': '2e623de0-91d4-4580-b597-be62950a489f', 'quantite': '1'}, {'ingredient_id': '9ab62b0f-8c05-4192-a09b-ec965a4f82eb', 'quantite': '1'}, {'ingredient_id': 'ad71613a-cd54-4649-b3d0-bf1108224186', 'quantite': '1'}, {'ingredient_id': 'eb106de6-f166-4b04-91f7-b42785165524', 'quantite': '1'}, {'ingredient_id': '37ea538d-058e-48e2-9bc9-b6a2c5121eef', 'quantite': '2 cuillères'}, {'ingredient_id': '00b8cd55-32f9-4983-a8ad-d49151cd4d39', 'quantite': '1'}, {'ingredient_id': '68e195b3-c9c4-4453-afc3-754cc92e5f03', 'quantite': ''}, {'ingredient_id': '533ea57b-d617-46a8-908c-aee5bf71def6', 'quantite': '1'}, {'ingredient_id': '810d1f07-3d6e-431d-a1e0-595dedfc9c48', 'quantite': ''}, {'ingredient_id': 'f7cef93a-d040-47cc-a968-a2e7ef21bdcf', 'quantite': ''}, {'ingredient_id': '4c09f920-d567-40a1-a2dd-d9d23dde0bb0', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (169823, 'Gâteau au yaourt chocolat banane', 'yaourt nature, sucre, farine, huile, oeuf, levure chimique, sucre vanillé, chocolat noir, miel, banane', '15 min', ['Préchauffez le four à 150°C (thermostat 5). ', 'Faites fondre le chocolat au bain marie.', 'Mélangez le yaourt nature avec le sucre et le sucre vanillé.', 'Ajoutez les 2 œufs, la farine et l''huile, mélangez et mettez le chocolat fondu dans la préparation et ajoutez la levure chimique au dernier moment.', 'Coupez la banane en rondelles, mettez-en la moitié au fond d''un moule à cake de préférence anti-adhésif et versez la moitié de la préparation, ajoutez le reste de la banane et le reste de la préparation.', 'Vous pouvez dessiner la forme que vous voulez sur le gâteau avec du miel avant cuisson, succès garanti.'], ['Moule à tarte', 'Économe', 'Batteur électrique', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'yaourt nature', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'huile', 'farine', 'dessert', 'plat de résistance', 'chocolat noir', 'sucre vanillé', 'Gâteau au yaourt chocolat banane', 'gâteau au chocolat', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:12:55.071218', [{'ingredient_id': 'e245fa04-b6b5-46f7-8a11-2430b7dde3c3', 'quantite': '1'}, {'ingredient_id': '707aba77-0bdd-4714-83c9-b55f63e8c725', 'quantite': '2'}, {'ingredient_id': 'bb734d8d-12aa-44fd-a829-31bbfad9ac46', 'quantite': '3'}, {'ingredient_id': '8f9f129d-a330-494b-bc45-2df0c762a098', 'quantite': ''}, {'ingredient_id': 'bb4c9687-c0ac-44f5-9992-1ec10eb3530f', 'quantite': '2'}, {'ingredient_id': '5142e65e-4ddd-49c4-b2cc-dee6ee6b5fd5', 'quantite': ''}, {'ingredient_id': '489990b5-29d9-4f12-a0d9-3e8830446fdb', 'quantite': '1'}, {'ingredient_id': 'cf16afa8-c66e-4d13-ba18-d1a4763c4bbc', 'quantite': '1 g'}, {'ingredient_id': 'e78ff9c7-8397-4b88-a5e6-c2a462284918', 'quantite': '1 cuillères'}, {'ingredient_id': '7b71bcfa-22e7-48a7-9f9c-1bffe9cd8712', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (28304, 'mousse de bananes au citron express', 'banane, citron, sucre, édulcorant, lait concentré non sucré, rhum, noix de coco rapée', '10 min', ['Mettre le lait concentré au congélateur une dizaine de minutes, ainsi que le fouet. Mettre un saladier au réfrigérateur. ', 'Râper le zeste du citron, et presser son jus. Mettre 1 cuiller à soupe de jus de citron à part. ', 'Garder 1/2 banane de côté. Mixer la banane et demi qui reste. Mélanger immédiatement avec le jus de citron (pour éviter que ça ne noircisse). Rajouter le sucre ou l''édulcorant (on peut sucrer un peu plus selon le goût), ainsi que l''alcool (selon le goût). ', 'Verser le lait concentré dans le saladier refroidi, et fouetter jusqu''à ce que ce soit bien mousseux. ', 'Mélanger délicatement les bananes mixées et le lait concentré mousseux. ', 'Verser dans des coupes. Saupoudrer de zeste de citron, et éventuellement de noix de coco râpée. ', 'Mettre au frais au moins 15 mn (on peut laisser au frais plus longtemps, mais pas trop parce que la mousse retombe un peu). ', 'Avant de servir, couper la demi-banane restante en rondelles, arroser avec la cuiller à soupe de jus de citron restante, et décorer les coupes avec les rondelles.'], ['Louche', 'Verre doseur'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'édulcorant', 'recette', 'cuisine', 'recettes', 'boisson', 'noix de coco rapée', 'mousse de bananes au citron express', 'dessert', 'plat de résistance', 'citron', 'lait concentré non sucré', 'sucre', 'cocktail', 'mousse citron'], 'Dessert', 4b373ca5-935d-438d-8cd5-3930fd82902c, '2025-09-26T16:12:58.838318', [{'ingredient_id': 'bd832566-4232-444e-866a-db6897093b69', 'quantite': '2'}, {'ingredient_id': 'fee89fd2-7fdb-4712-965b-fe9ea4b307ad', 'quantite': ''}, {'ingredient_id': '7a97db59-c379-440a-b2f7-f47c12e1e904', 'quantite': '2 cuillères'}, {'ingredient_id': '72d9bb14-9181-4499-b647-9b302bc90df0', 'quantite': ''}, {'ingredient_id': 'd22047d5-2ba8-4598-b393-226c17bdae85', 'quantite': '1'}, {'ingredient_id': '5bd30bd8-3a1d-4a4d-8b25-b70c18a0b3f9', 'quantite': ''}, {'ingredient_id': '44173cce-005b-41c1-8d5d-c00d419dbe30', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (392382, 'Carrot Cake aux noix, cranberries et quatre épices', 'carotte, banane, farine complète, amandes en poudre, mélange 4 épices, cannelle, cranberries, noix, sucre vanillé', '10 min', ['Râpez la carotte et réduisez la banane en purée.', 'Mélangez la banane et la carotte ensemble puis ajoutez les oeufs battus.', 'Mélangez dans un autre saladier la farine, la poudre d''amande, les épices, les cranberries et les noix (et le sucre vanillé si vous voulez)', 'Ajoutez ces poudres à la préparation précédente, bien mélanger.', 'Chemisez un moule et enfournez pour 50 minutes à 180°C (la pointe de votre couteau doit ressortir sèche). 10-15 minutes avant la fin de cuisson placez un papier aluminium pour éviter que votre cake ne brunisse trop.'], ['Casserole', 'Rouleau à pâtisserie', 'Presse-agrumes', 'Couteau de chef', 'Tire-bouchon'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'carotte', 'très facile', 'amandes en poudre', 'cranberries', 'plat', 'recette', 'mélange 4 épices', 'cuisine', 'noix', 'recettes', 'boisson', 'autres cakes', 'dessert', 'plat de résistance', 'sucre vanillé', 'moyen', 'Carrot Cake aux noix', 'farine complète', 'cranberries et quatre épices', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:13:02.550350', [{'ingredient_id': '2ec020a7-8722-4f75-a24c-fb76b43cbc47', 'quantite': '100 g'}, {'ingredient_id': '7e0b6df1-7c03-483a-acc9-c3613c38edd4', 'quantite': '100 g'}, {'ingredient_id': '5e253c93-f8c3-4bd3-bdef-9dd7b6f24a80', 'quantite': '120 g'}, {'ingredient_id': '62475f3b-766d-42ce-8c88-a48009fff7b2', 'quantite': '20 g'}, {'ingredient_id': '56ce274f-d4d1-4841-b445-e522c5045ada', 'quantite': '1 cuillères'}, {'ingredient_id': '61e6015e-ae8d-4a6e-b53e-c79609d69d87', 'quantite': '1 cuillères'}, {'ingredient_id': '5f94d8bd-9a10-4cb9-916c-9523a02b105f', 'quantite': '70 g'}, {'ingredient_id': 'c1b5c802-c0a4-4d44-8832-794073b529f0', 'quantite': '70 g'}, {'ingredient_id': '9d7a5c14-af7b-4550-b820-3fe007ab390e', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (72349, 'banane au chocolat chaud et glace vanille', 'banane, chocolat, glace vanille', '6 min', ['Faire fondre le chocolat au micro-ondes pendant environ 1 min 30 pour qu''il ne soit pas trop liquide et bien le mélanger.', 'Couper les bananes en petits morceaux et les mettre au fond de 2 ramequins.', 'Mettre ensuite la glace par dessus, et ajouter enfin le chocolat.'], ['Tire-bouchon', 'Verre doseur', 'Passoire'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'très facile', 'bon marché', 'banane au chocolat chaud et glace vanille', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'glace vanille', 'dessert', 'plat de résistance', 'glace à la vanille', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:13:06.140843', [{'ingredient_id': 'c103d627-ae28-4fab-b41c-28f2f3675145', 'quantite': '2'}, {'ingredient_id': 'e5190761-df0c-460f-a065-594411ae3070', 'quantite': '8'}, {'ingredient_id': '3fdd34ac-b199-4c45-ace6-499aed6cc93f', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (225924, 'Verrine chocolat fondu et salade de fruits au miel', 'fraises, orange, pomme, banane, miel, chocolat, crème liquide, beurre', '10 min', ['Laver, peler et couper les fruits et les mettre dans un saladier. Ajouter le miel et bien mélanger. Mettre la préparation au réfrigérateur.', 'Faire fondre le chocolat dans la crème liquide en tournant doucement avec une cuillère en bois environ 5 min. A la fin rajouter une noix de beurre.', 'Avant le service, disposer dans vos pots à verrines le chocolat au fond puis la salade de fruits. Pour la décoration ajouter une écorce d''orange à moitié trempée dans le chocolat.'], ['Balance de cuisine', 'Tire-bouchon'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'facile', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'crème liquide', 'dessert', 'plat de résistance', 'pomme', 'Verrine chocolat fondu et salade de fruits au miel', 'beurre', 'orange', 'cocktail'], 'Dessert', 1f69aed1-d570-40db-a5d7-0b2b3418363a, '2025-09-26T16:13:09.742546', [{'ingredient_id': 'cba2c15a-c1dd-4730-a36b-a11a06976559', 'quantite': '250 g'}, {'ingredient_id': '4b5f1bb8-0989-4305-ac7a-50c098f4087c', 'quantite': '2'}, {'ingredient_id': '315b226c-9838-490a-bf0c-6e00a3a25cc9', 'quantite': '2'}, {'ingredient_id': 'c8499cd7-d230-4f6c-bd80-7448cf1354de', 'quantite': '2'}, {'ingredient_id': '4508f2d7-11b1-4269-9d94-5b7042f04982', 'quantite': '2 cuillères'}, {'ingredient_id': 'bbbfddaa-1bf3-4588-8745-4d58d3788a47', 'quantite': '200 g'}, {'ingredient_id': 'f3cf42ce-ed27-4e8d-a19f-260af26425f0', 'quantite': '25 cl'}, {'ingredient_id': '37fe67bc-b930-4215-84db-c82573d0f4dd', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (26607, 'Bananes au lait de coco', 'banane, lait de coco, tapioca, sucre, vanille, arachide', '10 min', ['Pelez les bananes. ', 'Les cuire dans une casserole avec le lait de coco, le sucre et le vanille durant environ 15 min à feu doux. ', 'Ajoutez le tapioca et cuire encore 5 min. ', 'Servir tiède saupoudré de cacahuètes et de lait de coco très frais.'], ['Planche à découper', 'Rouleau à pâtisserie', 'Économe', 'Balance de cuisine', 'Moule à tarte'], ['', 'lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'Bananes au lait de coco', 'bon marché', 'plat', 'recette', 'tapioca', 'cuisine', 'arachide', 'recettes', 'boisson', 'vanille', 'dessert', 'plat de résistance', 'sucre', 'cocktail'], 'Dessert', 6954bfec-9549-4b91-9bdf-d54eea584672, '2025-09-26T16:13:13.414628', [{'ingredient_id': 'eb305020-88d1-4b95-9bf5-9f076ed9c1f9', 'quantite': '12'}, {'ingredient_id': 'b8daee52-2d4e-44c4-8593-825ede25c69c', 'quantite': '1 l'}, {'ingredient_id': '3eb80907-637e-4e04-8983-5197c2a8a5f7', 'quantite': '5 cuillères'}, {'ingredient_id': '35dc2a42-fbaa-41db-a4e7-ddcc69a24691', 'quantite': '100 g'}, {'ingredient_id': '1534e6bf-ff5f-4674-a1bb-ef8249b9fb64', 'quantite': '1'}, {'ingredient_id': '25c6a87e-0a5c-463c-bf92-0a9051b47846', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (530889, 'Banoffee express par Laurent Mariotte', 'spéculoos, beurre, banane, crème liquide, sucre glace, confiture de lait, chocolat noir', '15 min', ['Faites fondre le beurre.', 'Mixez les spéculoos, mélangez-les au beurre fondu et répartissez-les dans le fond du saladier. Coupez les bananes en rondelles et déposez-les sur les spéculoos. Nappez généreusement de confiture de lait.', 'À l’aide d’un batteur, montez la crème liquide en chantilly avec le sucre glace.', 'Recouvrez les ingrédients de crème fouettée et râpez le chocolat par-dessus.', 'Réservez au moins 30 minutes au réfrigérateur, servez et partagez !'], ['Râpe', 'Verre doseur', 'Tire-bouchon'], ['entrée', 'banane', 'recettes de cuisine', 'banoffee', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'spéculoos', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'confiture de lait', 'Banoffee express par Laurent Mariotte', 'dessert', 'plat de résistance', 'chocolat noir', 'beurre', 'sucre glace', 'cocktail'], 'Dessert', 8e8b1cbe-79ac-44e1-9f8c-aa8b7b63a6da, '2025-09-26T16:13:16.993856', [{'ingredient_id': '83623820-3c0c-4b26-8d3d-12e2d32387bd', 'quantite': '250 g'}, {'ingredient_id': 'cca8927a-af08-4022-b07f-dbfb37eca8dd', 'quantite': '60 g'}, {'ingredient_id': '5dddb741-1feb-4792-a410-2f5cb4f587f7', 'quantite': '4'}, {'ingredient_id': 'bb2fbffe-d500-4af8-a65b-54b39fd332f2', 'quantite': '60 cl'}, {'ingredient_id': '7607ced1-3f90-4d45-88b0-a288fd20705a', 'quantite': '50 g'}, {'ingredient_id': '34fd1136-9b70-4ff7-b398-97973c8453b0', 'quantite': '350 g'}, {'ingredient_id': 'c1ae3a4b-abbe-4060-ada5-5edb8eb301ca', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (392022, 'Cookies avoine banane', 'banane, flocons d''avoine, noix de coco rapée, extrait de vanille liquide, pépites de chocolat', '10 min', ['Préchauffer le four à 180°C.', 'Écraser les bananes dans un saladier.', 'Ajouter les flocons d''avoine, la noix de coco, l''extrait de vanille et les pépites de chocolat.', 'A l''aide d''une cuillère (à thé par exemple), poser des boules de pâtes sur une plaque recouverte de papier sulfurisé.', 'Cuire à 180°C pendant 15 minutes pour des cookies moelleux («chewy»), ou 20 minutes pour des cookies plus croustillants.'], ['Louche', 'Poêle'], ['entrée', 'banane', 'recettes de cuisine', 'extrait de vanille liquide', 'confiserie', 'testées', 'Cookies avoine banane', 'très facile', 'bon marché', 'cookie', 'plat', 'pépites de chocolat', 'recette', 'cuisine', 'recettes', 'boisson', 'noix de coco rapée', 'dessert', 'plat de résistance', 'flocons d''avoine', 'cocktail'], 'Dessert', d8c789d3-48c3-40ed-a48f-308fa0481e17, '2025-09-26T16:13:20.472159', [{'ingredient_id': '7c4e63ee-f35d-4398-ba4d-fd04b85b77ac', 'quantite': '4'}, {'ingredient_id': '5f50cd4f-3c36-48af-9e9f-ba892590c805', 'quantite': '80 g'}, {'ingredient_id': '3f0362bd-8ff4-4ca9-a531-3b36c8ad559f', 'quantite': '1 cuillères'}, {'ingredient_id': 'a04186c6-9aa8-44c3-b99c-16754531c1d9', 'quantite': ''}, {'ingredient_id': '75ca1d6b-2ba3-4ddd-9793-dff31feadbc8', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (84047, 'Merveilleux roulé nutella banane', 'oeuf, sucre en poudre, sucre vanillé, farine, beurre, rhum, sel, Nutella, banane, vermicelles en chocolat', '15 min', ['Préparation du biscuit :', 'Préchauffer votre four à 180°C(thermostat 6).', 'Battre les 4 jaunes d''oeufs avec le sucre en poudre, le sucre vanillé et la farine. Ajouter le beurre fondu et le rhum. Mélanger jusqu''à l''obtention d''une préparation homogène et lisse.', 'Battre les blancs d''oeufs en neige ferme avec le sel.', 'Incorporer les blancs avec le mélange précédent.', 'Verser la pâte sur du papier sulfurisé beurré.', 'Cuire 10 min au four, pas plus.', 'Laisser le biscuit tiédir et le recouvrir de nutella.', 'Couper 1 banane en fine lamelle et en recouvrir le nutella de moitié.', 'Rouler le biscuit.', 'Napper du reste de nutella et décorer avec des rondelles de bananes plus épaisses et des vermicelles en chocolat.'], ['Passoire', 'Louche', 'Rouleau à pâtisserie', 'Planche à découper'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'sel', 'confiserie', 'testées', 'facile', 'Merveilleux roulé nutella banane', 'bon marché', 'rapide', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'vermicelles en chocolat', 'Nutella', 'dessert', 'plat de résistance', 'sucre vanillé', 'beurre', 'gâteau roulé', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:13:24.097810', [{'ingredient_id': '8061b08a-fa34-4163-a765-d8eabf919751', 'quantite': '4'}, {'ingredient_id': '125f6083-6846-404d-a462-20493016faa0', 'quantite': '80 g'}, {'ingredient_id': '427fd502-bee6-4f9f-ab35-f4eba6a55959', 'quantite': '1'}, {'ingredient_id': 'ad3ed22d-e7e5-48bb-be1f-7f437e8d6958', 'quantite': '80 g'}, {'ingredient_id': '72262150-e8aa-4564-a7a1-e2fba76dd7f5', 'quantite': '20 g'}, {'ingredient_id': 'f2b0a555-c39d-489c-8150-978e8e32cff0', 'quantite': '1 cuillères'}, {'ingredient_id': '6a726d77-2750-493e-9b7a-b0f5174a6f71', 'quantite': '1'}, {'ingredient_id': '17cf869b-3d5b-4c78-aa4a-7791b38d6921', 'quantite': '1'}, {'ingredient_id': 'e8e032d1-255f-473e-9d10-c9d2303b57b2', 'quantite': '2'}, {'ingredient_id': '8ca5a472-bdff-4a12-bab5-077cf2905cfe', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (166490, 'Curry d''agneau aux fruits exotiques', 'épaule d''agneau, banane plantain, mangue, ananas, beurre, oignon, ail, yaourt nature, safran, curry, huile, coriandre, poivre, sel', '30 min', ['1) Pelez et hachez l''ail et les oignons. Faites chauffer l''huile dans une cocotte. Ajoutez les morceaux de viande et faites les dorer de tous les côtés. Quand ils sont bien colorés, retirez-les de la cocotte avec une écumoire.', '2) Mettez le hachis ail/oignons dans la cocotte et faites-le revenir pendant 2 minutes, en remuant. Remettez les morceaux de viande dans la cocotte. Saupoudrez de curry, ajoutez 15cl d''eau chaude, les yaourts et le safran. Mélangez bien, salez, couvrez et faites cuire à feu moyen, pendant 30 minutes, en remuant de temps en temps.', '3) Pendant ce temps, épluchez et coupez les bananes plantains en rondelles. pelez et coupez les mangues en lamelles. Epluchez et coupez l''ananas en morceaux après avoir retiré le coeur. Faites fondre le beurre dans une sauteuse. Ajoutez les rondelles de bananes plantains et les morceaux d''ananas. Faites-les revenir à feu moyen, en les retournant pour qu''ils cuisent de tous les côtés. En fin de cuisson, ajoutez les lamelles de mangues. Salez et poivrez.', '4) Servez le curry d''agneau avec les fruits et décorez de tiges de coriandre fraîche.'], ['Râpe', 'Fouet', 'Poêle', 'Rouleau à pâtisserie', 'Balance de cuisine'], ['entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'assez cher', 'yaourt nature', 'facile', 'ail', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'Curry d''agneau aux fruits exotiques', 'oignon', 'boisson', 'huile', 'dessert', 'plat de résistance', 'banane plantain', 'beurre', 'ananas', 'coriandre', 'épaule d''agneau', 'poivre', 'curry', 'viande à l''indienne', 'cocktail', 'safran'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:13:27.818748', [{'ingredient_id': 'd6c272bf-04d9-4cdb-82a6-20acda15547b', 'quantite': '1 kg'}, {'ingredient_id': 'a7e8abe7-3013-4c99-9b0d-fdad1ec9e7e7', 'quantite': '2'}, {'ingredient_id': '7a8b6ca5-490f-4ec4-b20a-9ec61d9ab9d0', 'quantite': '2'}, {'ingredient_id': '132f1dc9-5ad3-4d8a-a14a-3fd736783fe5', 'quantite': '1'}, {'ingredient_id': 'ceda5930-a06b-4bfd-a1eb-5689885d85c1', 'quantite': '50 g'}, {'ingredient_id': '77812aac-7464-4043-be50-5543eb12eea4', 'quantite': '2'}, {'ingredient_id': 'f353373b-8363-4479-af40-4d16c5c0d71d', 'quantite': '2'}, {'ingredient_id': 'a61891c1-a1c8-4f59-bf71-6ed0f13e882c', 'quantite': '2'}, {'ingredient_id': 'c9b4d046-9989-4a9e-a6cb-d6342586bc9c', 'quantite': '1'}, {'ingredient_id': '77245431-12b7-495f-beff-9eb58b9b5b0b', 'quantite': '3 cuillères'}, {'ingredient_id': '09c43cee-c849-4454-81de-b0d017297d16', 'quantite': '3 cuillères'}, {'ingredient_id': '178ff5fb-4189-4d28-b039-c9156305e0b2', 'quantite': ''}, {'ingredient_id': '1480e23a-b5b2-4726-9c40-44815d11ed12', 'quantite': ''}, {'ingredient_id': '518a0e3c-3e12-45de-bd28-ce111bf4405d', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (346037, 'Banana bread au chocolat', 'banane, chocolat au lait, cacao, farine, sucre roux, beurre, oeuf, levure, sel', '20 min', ['Préchauffer le four à 180°C (thermostat 6). ', 'Réserver une banane et écraser les autres à la fourchette.', 'Mélanger le sucre avec le beurre jusqu''à l''obtention d''une crème lisse. ', 'Ajouter les oeufs et battre bien le tout. ', 'Ajouter le cacao, la farine, la levure, les bananes écrasées et le sel en une fois et mélanger bien. ', 'Faire fondre le chocolat et ajouter à la préparation. ', 'Verser la pâte dans un moule à cake préalablement beurré.', 'Couper la banane réservée dans le sens de la longueur et disposer les deux moitiés sur le gâteau. ', 'Enfourner 45 minutes. ', 'Laisser tiédir avant de démouler.'], ['Fouet', 'Pince de cuisine', 'Tire-bouchon', 'Verre doseur'], ['', 'chocolat au lait', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'cacao', 'oeuf', 'plat', 'recette', 'levure', 'cuisine', 'Banana bread au chocolat', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'beurre', 'cocktail', 'sucre roux'], 'Dessert', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T16:13:33.666082', [{'ingredient_id': '3956ab37-29a2-4b9f-b8df-57b9111f91d6', 'quantite': '3'}, {'ingredient_id': 'd278b88a-9c34-4a66-a93c-9ba7678521f8', 'quantite': '130 g'}, {'ingredient_id': 'a44c4e5e-978a-48bb-a064-35c37bf310c4', 'quantite': '30 g'}, {'ingredient_id': '8e38f337-aac6-4ed9-b992-c5f71d913154', 'quantite': '180 g'}, {'ingredient_id': 'e0d2a578-267a-4f81-9170-fc105941cbd6', 'quantite': '80 g'}, {'ingredient_id': '5478d4df-76c0-46af-ac3f-6d601c6aafc3', 'quantite': '120 g'}, {'ingredient_id': '32749f36-0c63-4198-9ef8-9dccfb3e85e1', 'quantite': '2'}, {'ingredient_id': '3bec1e16-c982-476f-a95f-6c2ca0a74584', 'quantite': '1'}, {'ingredient_id': '9cf1b5e6-25b9-40ba-a75c-cda41356ca0a', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (40862, 'Papillotes exotiques', 'papier sulfurisé, ficelle, banane, pomme, orange, raisins secs, sucre de canne, noix de coco rapée', '5 min', ['Couper la 1/2 banane en rondelles, et la 1/2 pomme en petits dés. ', 'Mettre les fruits dans la papillote, puis arroser avec le jus d''1/2 orange. ', 'Saupoudrer le tout de noix de coco et de sucre de canne, et fermer la papillote avec la ficelle à rôti.', 'Mettre au four, sur une plaque, pendant 20 min à 180°C (thermostat 6).'], ['Balance de cuisine', 'Couteau de chef'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'ficelle', 'bon marché', 'Papillotes exotiques', 'plat', 'recette', 'papier sulfurisé', 'cuisine', 'recettes', 'boisson', 'sucre de canne', 'noix de coco rapée', 'dessert', 'plat de résistance', 'pomme', 'orange', 'raisins secs', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:13:37.463372', [{'ingredient_id': 'b35085bd-4cad-4004-94d2-d3c5db83cfa7', 'quantite': '1'}, {'ingredient_id': '896d40fe-016e-4ece-a4ea-8e9ddc79a61a', 'quantite': ''}, {'ingredient_id': '051a07f1-0e14-4203-a422-8a89e4ca38a6', 'quantite': ''}, {'ingredient_id': 'a26d3174-d124-4123-bf29-b63fcc809e60', 'quantite': ''}, {'ingredient_id': 'a626d6c1-97b5-4aa4-aa03-1be32ca125e3', 'quantite': ''}, {'ingredient_id': 'dac39aec-738c-447e-b452-98e320b425f9', 'quantite': '10'}, {'ingredient_id': 'bd7490c1-52b8-43aa-801c-1030a8784dc1', 'quantite': '1 cuillères'}, {'ingredient_id': 'e9c43ddf-c2a6-4452-840b-020e170b7dda', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (231734, 'Moelleux à la banane', 'banane, sucre, oeuf, yaourt nature, farine, levure chimique, rhum', '10 min', ['Préchauffer le four à 180°C.', 'Écraser les bananes.', 'Ajouter le rhum, le sucre, les 2 œufs entiers, le yaourt.', 'Mélanger la farine et la levure à part, puis les incorporer au mélange.', 'Mettre à cuire 25 min seulement dans des moules individuels en silicone (type moules à muffin), ou dans un moule à gâteau si vous préférez (cuire alors 10 min de plus).', 'Laisser refroidir.'], ['Couteau de chef', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'levure chimique', 'yaourt nature', 'facile', 'bon marché', 'oeuf', 'Moelleux à la banane', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'gâteau à la banane', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:13:41.322729', [{'ingredient_id': 'e01130e4-6f3c-4c1e-8a2e-7f4a3031aeb1', 'quantite': '3'}, {'ingredient_id': 'd5f1c83d-066d-4411-98e5-89516bd99c0e', 'quantite': '100 g'}, {'ingredient_id': '236691d2-1901-47de-9009-2cbd1e779b36', 'quantite': '2'}, {'ingredient_id': '173abe61-6bc8-4d4c-973a-bef1eee27981', 'quantite': '1'}, {'ingredient_id': '25dfaefb-46aa-41a3-bbe4-385c3a6c7b9b', 'quantite': '100 g'}, {'ingredient_id': 'b2f637a5-6cd0-4ef5-af75-63b70f124160', 'quantite': ''}, {'ingredient_id': '48f103af-40f7-4396-946b-03d14ee03a4d', 'quantite': '3 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (14779, 'Tarte pomme et banane', 'banane, pomme, cannelle, pâte brisée, sucre, confiture d''abricot', '20 min', ['Coupez les bananes en rondelles et les pommes en tranches fines.', 'Mettez la pâte brisée dans un moule à tarte.', 'Tapissez le fond avec les rondelles de bananes.', 'Disposez les tranches de pommes en rosace par dessus.', 'Saupoudrez de cannelle et de sucre, faites cuire environ 25 min à thermostat 5-6.', 'Au sortir du four, vous pouvez nappez la tarte avec de la confiture d''abricot délayée dans très peu d''eau.'], ['Moule à tarte', 'Presse-agrumes'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'tarte à la banane', 'recette', 'confiture d''abricot', 'pâte brisée', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Tarte pomme et banane', 'pomme', 'cannelle', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:13:45.311622', [{'ingredient_id': '12a9bce8-346f-4647-bfff-5a5624370c13', 'quantite': '2'}, {'ingredient_id': '61484542-c282-449b-a153-7f5d3b78e0b6', 'quantite': '2'}, {'ingredient_id': '2f9d6a27-06c8-4842-942d-1a5cadba59f4', 'quantite': '1'}, {'ingredient_id': '5ecebb46-588e-450d-a48d-5d3f08cfc680', 'quantite': '1'}, {'ingredient_id': 'dd5eb9d6-6741-48d8-88f3-46712489735d', 'quantite': '1 cuillères'}, {'ingredient_id': 'be3d923c-971a-4496-90fd-5e0da282cad8', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (83125, 'Banane dans le peignoir', 'banane, pâte feuilletée, poudre de noisette, copeaux de chocolat, sucre vanillé, nappage chocolat, crème chantilly', '10 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Démouler la pâte feuilletée, verser par dessus de la poudre de noisettes, du sucre vanille et du chocolat râpé. ', 'Prendre du papier aluminium et appuyer par dessus pour incruster le mélange dans la pâte.', 'Couper la pâte en quatre lignes. ', 'Emballer chaques bananes par une ligne de pâte. ', 'Mettre au four à 180°C (thermostat 6) pendant 20 minutes.', 'Avant de servir, décorer du chocolat liquide et de la crème chantilly.'], ['Ouvre-boîte', 'Poêle', 'Casserole', 'Spatule'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'Banane dans le peignoir', 'testées', 'très facile', 'bon marché', 'plat', 'poudre de noisette', 'recette', 'cuisine', 'recettes', 'boisson', 'crème chantilly', 'dessert', 'plat de résistance', 'pâte feuilletée', 'sucre vanillé', 'copeaux de chocolat', 'nappage chocolat', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:13:48.973566', [{'ingredient_id': '3aa0265e-d5da-49df-a7ad-a47ad1c804fe', 'quantite': '4'}, {'ingredient_id': 'd8ad3da5-0ab0-406c-b03f-dd28b59e1a0f', 'quantite': '1'}, {'ingredient_id': '97e9c7d8-b8ea-4f11-9557-58066a46d0a0', 'quantite': ''}, {'ingredient_id': '1ffbe134-61e5-438a-a9ef-e977250f290a', 'quantite': ''}, {'ingredient_id': '3dd7accd-c97b-4d3f-a05a-9e5fe9a32623', 'quantite': ''}, {'ingredient_id': '418d9d64-8476-475e-8ebb-5f585c887ba8', 'quantite': ''}, {'ingredient_id': 'fc645c15-b184-48a6-b1be-15834946d916', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (20406, 'Tarte choco-banane', 'pâte brisée, banane, chocolat pâtissier, crème fraîche liquide, oeuf, beurre, sucre', '20 min', ['Couper le chocolat en petits carreaux. ', 'Faire fondre dans une casserole à feu doux 3 ou 4 noisettes de beurre ainsi que le chocolat. Attention que le chocolat n''accroche pas à la casserole. ', 'Un fois le chocolat fondu, ajoutez l''oeuf et la crème fraîche. ', 'Si vous voulez vous pouvez ajouter une ou deux cuillères de sucre en poudre. ', 'Etalez la pâte brisée dans un moule à tarte et piquez la pâte avec une fourchette. ', 'Dans le fond de la tarte coupez des rondelles de bananes d''environ 1,5 cm. Il faut que les rondelles soient très serrées. ', 'Préchauffez votre four à 220°C . ', 'Vous pouvez verser la préparation au chocolat sur les bananes. ', 'Mettre au four environ 30 mn, le temps que la pâte soit cuite. ', 'Placer la tarte au frigidaire car elle doit se déguster froide.'], ['Tire-bouchon', 'Presse-agrumes', 'Verre doseur', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'tarte à la banane', 'recette', 'crème fraîche liquide', 'chocolat pâtissier', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'Tarte choco-banane', 'sucre', 'cocktail'], 'Dessert', cbb138cb-4e9e-44f2-8143-4b33920d6f14, '2025-09-26T16:13:53.611092', [{'ingredient_id': '32e0408e-f7d2-4cb4-8b82-b26b0a0c7538', 'quantite': '1'}, {'ingredient_id': 'b69a5820-7d99-4514-974a-034bf2910d03', 'quantite': '6'}, {'ingredient_id': '7b4c9419-982b-4d82-b476-6e26def75867', 'quantite': '1'}, {'ingredient_id': '4c3a5b3a-fe36-4e7c-9329-12898f3ba619', 'quantite': '30 cl'}, {'ingredient_id': 'c5411084-8375-4df0-9a7f-be6511101df3', 'quantite': '1'}, {'ingredient_id': '4b78f122-d99d-4f11-81db-a720f3baeb03', 'quantite': ''}, {'ingredient_id': '9855906e-37f2-4920-ba86-63b6183d1b1e', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (31142, 'Gâteau Nénette (pavé chocolat banane)', 'petit beurre, chocolat amer, beurre, oeuf, banane, Liqueur, sirop de canne, jus de citron, sel', '30 min', ['1) Tapissez entièrement un moule à cake de film étirable ou papier sulfurisé. Râper le chocolat dans une terrine, ajoutez le beurre en petits morceaux, puis placez-le dans un bain-marie sur feu modéré. Lorsque le chocolat est entièrement fondu, retirez du feu et remuez bien jusqu’à ce que le mélange soit parfaitement homogène. ', '2) Ajoutez ensuite les jaunes d’oeuf l’un après l’autre puis une cuillère à soupe de liqueur, laissez refroidir complètement. ', '3) Montez les blancs en neige ferme avec le sel et incorporez-les dans la crème bien froide. Préparez un sirop avec 5 cl d’eau, le sirop de sucre de canne et la liqueur restante. Epluchez les bananes, les coupez dans le sens de la longueur. ', '4) Garnissez le fond du moule d’une couche préparation chocolat. Couvrez le d’une couche de petits beurre rapidement trempés dans le sirop. Déposez dessus 2 demi-bananes, face coupée contre les gâteaux puis masquez-les d’une couche de crème en remplissant les interstices. Tapissez à nouveau de petits beurre puis de 3 demi-bananes ; continuez le montage en terminant par des petits beurre. Couvrez le moule de papier film et entreposez-le au frais jusqu’au lendemain. ', '5) Pour servir, retirez le papier. Renversez le moule sur le plat de service et ôtez le papier restant, décorez le dessus du gâteau de rondelles de bananes citronnées. Coupez le gâteau en tranches avec un couteau trempé dans de l’eau chaude et essuyez entre chaque opération (peut être servi, accompagné d’une crème anglaise).'], ['Batteur électrique', 'Presse-agrumes', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'sirop de canne', 'rapide', 'oeuf', 'plat', 'Gâteau Nénette (pavé chocolat banane)', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat amer', 'jus de citron', 'beurre', 'petit beurre', 'Liqueur', 'gâteau au chocolat', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:13:57.256529', [{'ingredient_id': '710222cf-2964-40fc-9067-66fe7ce13125', 'quantite': '24'}, {'ingredient_id': 'c69b2c62-9a12-4e21-91b4-d5ba653a99f7', 'quantite': '250 g'}, {'ingredient_id': '4e78fdb6-ab7c-48f7-ba6c-a2297654e363', 'quantite': '100 g'}, {'ingredient_id': 'd322dcdc-4841-4b2d-b67f-42b0b5d527c2', 'quantite': '3'}, {'ingredient_id': 'bc73661b-0205-4c6d-8fd8-3869c6f905be', 'quantite': '4'}, {'ingredient_id': 'cbc1ac2b-a117-4594-8189-32ee505cdbd3', 'quantite': '10 cl'}, {'ingredient_id': '472ebb50-858e-442b-825e-16c065d5ccea', 'quantite': '5 cl'}, {'ingredient_id': '510fd7dd-317e-40b3-91f0-d654c82b95a3', 'quantite': ''}, {'ingredient_id': '43c2ee3b-3311-4df5-be43-4eebdfe15d1a', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (24619, 'Verrines de fruits frais à la colombienne', 'banane, citron, mangue, noix de coco, sirop, fraises, cerises', '20 min', ['Râper les noix de coco. Peler et couper en rondelles les deux bananes. Les arroser de jus de citron. Détailler les mangues en cubes.', 'Dans un plat de service ou des coupes individuelles, déposer alternativement les rondelles de bananes, les dés de mangue, les noix de coco râpée. Gardez 4 cuillères à soupe de noix de coco râpée pour la finition. Arrosez de sirop de maïs au fur et à mesure.', 'Placer au réfrigérateur jusqu''au moment de servir.', 'Saupoudrer de noix de coco râpée et garnir de cerises et de fraises.'], ['Spatule', 'Couteau de chef', 'Mixeur', 'Pince de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'Verrines de fruits frais à la colombienne', 'rapide', 'plat', 'mangue', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'citron', 'sirop', 'noix de coco', 'cocktail', 'cerises'], 'Dessert', d9f58115-20e2-406c-b804-d9e2b522aa0f, '2025-09-26T16:14:02.135075', [{'ingredient_id': 'be479dfa-6489-420f-b63a-404c8c5b2cda', 'quantite': '4'}, {'ingredient_id': 'b473190d-50a7-4628-a9a3-f332e8538db6', 'quantite': '2'}, {'ingredient_id': '03bf841b-7d54-46bf-892d-f852f398ec35', 'quantite': '2'}, {'ingredient_id': '87867151-312b-4045-9dbd-df0e38eb779f', 'quantite': '4'}, {'ingredient_id': '5c818667-a6e8-472a-80e0-98bc5d73b53e', 'quantite': '16 cl'}, {'ingredient_id': '12b52aee-9ac0-4820-adc9-d7dae0fa300a', 'quantite': '250 g'}, {'ingredient_id': '139f38a3-6f6e-45f2-9928-7efb762b5eee', 'quantite': '250 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (57016, 'Tarte à la banane très facile', 'pâte feuilletée, oeuf, crème fraîche, banane, sucre', '10 min', ['Préchauffez le four à 180°C (thermostat 7).', 'Epluchez 4 bananes et écrasez-les dans un récipient.', 'Mélangez les oeufs, la crème fraîche et le sucre (quantité selon son goût) avec les bananes.', 'Etalez votre pâte dans un moule beurré et y verser la préparation.', 'Enfournez pour 20 minutes de cuisson.', 'Quand votre préparation a commencé à durcir, coupez les bananes restantes en lamelles, disposez-les sur votre tarte et saupoudres de sucre pour la caramelisation.', 'Remettre votre tarte au four jusqu''à la fin de la cuisson.'], ['Balance de cuisine', 'Tire-bouchon'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'tarte à la banane', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pâte feuilletée', 'Tarte à la banane très facile', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:14:05.788187', [{'ingredient_id': '7a8b94b6-ecd5-457b-8ea9-1cf743e3d60d', 'quantite': '1'}, {'ingredient_id': 'a5e00404-21d2-4e1e-a71f-c6c7a575657b', 'quantite': '2'}, {'ingredient_id': '78af3e0c-169f-42ab-b30a-0bc33ad74ed6', 'quantite': '1'}, {'ingredient_id': '5ae9aadf-8a16-4076-9fb3-be7e607ab254', 'quantite': '6'}, {'ingredient_id': '7995196e-c499-434c-b8d6-c4cb6fa922ac', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (167938, 'Tarte-flan banane-kiwi', 'pâte brisée, oeuf, farine, sucre en poudre, moutarde, cannelle, banane, kiwi', '15 min', ['1)Préchauffer le four à 200 °C (th 7)', '2)Etaler la pâte brisée dans un moule.', '3)Déposer du papier cuisson sur la pâte brisée. Placer du riz, lentilles ou poichiches crus sur le papier cuisson.', '4)Mettre au four jusqu’à ce que la pâte soit un peu dorée.', '5)Pendant ce temps, dans un saladier, mélanger la farine, le sucre, les œufs et le lait. Vous devez obtenir une pâte liquide et mousseuse.', '6)Parfumer généreusement avec la cannelle.', '7)Enlever la peau des bananes et des kiwis.', '8)Couper-les en tranches fines.', '9)Déposer sur la pâte brisée, presque cuite, les tranches de fruits : une rangée de bananes, puis une rangée de kiwis. Vous pouvez faire deux étages en plaçant des kiwis sur des bananes.', '10)Verser le mélange farine-œufs-sucre-lait sur les fruits.', '11)Enfourner la tarte pendant 20 minutes environ. Plonger un couteau dans la tarte : s’il n’y a rien sur le couteau et que la pâte est un peu molle, c’est prêt !', '             Bon appétit !', 'S’accompagne très bien avec du cidre.'], ['Planche à découper', 'Râpe', 'Verre doseur', 'Moule à tarte'], ['entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'tarte à la banane', 'sucre en poudre', 'recette', 'cuisine', 'pâte brisée', 'recettes', 'Tarte-flan banane-kiwi', 'boisson', 'farine', 'dessert', 'plat de résistance', 'moutarde', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:14:09.593514', [{'ingredient_id': 'cd749a67-1d0f-4dfd-9890-06ffd3b60896', 'quantite': '1'}, {'ingredient_id': '7f1dbecd-de10-4650-b503-2f7ab6afbdb8', 'quantite': '2'}, {'ingredient_id': '2756eed4-0d3f-4cb3-b298-d10c9dbbe831', 'quantite': '3 cuillères'}, {'ingredient_id': '82ccf078-ddb6-4dcf-b697-96639e0c0ee6', 'quantite': '40 g'}, {'ingredient_id': 'd4ca9c89-b6a3-4db6-b029-e20b4174f63e', 'quantite': '1'}, {'ingredient_id': '0dd70590-b585-4cd4-8f26-75c70ece7165', 'quantite': ''}, {'ingredient_id': 'b40262bb-8631-463e-9d30-478236bdb669', 'quantite': '1'}, {'ingredient_id': '5ed437f8-ba20-4025-8c7b-4fdce5ac7415', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (315229, 'Cookies choco coco banana', 'banane, maïzena, poudre à lever, amandes en poudre, noix de coco, cassonade, chocolat noir, eau', '15 min', ['Préchauffer votre four à 150°C (thermostat 5).', 'Dans un saladier, écrasez la banane à la fourchette, ajoutez la maïzena, la levure et bien mélanger (cela doit être granuleux, c''est normal).', 'Ajoutez au précédent mélange : cassonade, poudre d''amande, noix de coco et pépites de chocolat. Mélangez à nouveau.', 'Ajoutez l''eau afin de former une belle boule de pâte.', 'Sur une plaque de cuisson, posez une feuille de papier sulfurisé. Formez des tas à la main et placez-les sur le papier cuisson (environ 9 tas).', 'Mettre au four pendant 30 min. ', 'Se dégustent dès la sortie du four pour les gourmands !!!'], ['Verre doseur', 'Balance de cuisine', 'Casserole', 'Tire-bouchon'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'cassonade', 'facile', 'maïzena', 'bon marché', 'amandes en poudre', 'cookie', 'plat', 'recette', 'poudre à lever', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat noir', 'Cookies choco coco banana', 'noix de coco', 'cocktail'], 'Confiserie', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:14:13.350277', [{'ingredient_id': 'fa2f4016-8efa-4e24-816f-04e8dac7813f', 'quantite': '1'}, {'ingredient_id': 'f1edd4cc-9563-4554-a68b-40bcbdcf044f', 'quantite': '100 g'}, {'ingredient_id': 'bf5c1c17-38fb-49e4-b680-5d57a84b5084', 'quantite': ''}, {'ingredient_id': '36f17398-ab57-4ab6-880c-f23d4d872b33', 'quantite': '50 g'}, {'ingredient_id': '8f130a9b-e6c4-47a8-bf71-e0073204a2e6', 'quantite': '50 g'}, {'ingredient_id': 'f5616cde-1fc2-40a6-ba39-31fa796bdb70', 'quantite': '30 g'}, {'ingredient_id': '5806addf-ec3e-4406-8306-934625060704', 'quantite': '100 g'}, {'ingredient_id': '8e3fad0e-cf6a-425e-b2a0-e3f9f0f9a53a', 'quantite': '10 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (11934, 'Ragoût de porc et de poulet à la banane', 'blanc de poulet, épaule, chorizo, banane, petit piment, oignon rouge, ail, maïs, quatre-épices, cannelle, bouillon de volaille, vinaigre, huile d''olive, sel', '30 min', ['Coupez les viandes en gros cubes de 5 cm.', 'Otez la peau de chorizo,avant de le trancher.', 'Epluchez les bananes,détaillez les piments en rondelles,pelez et émincez les oignons et l''ail, rincez le maïs.', 'Dans une sauteuse,faites suer l''ail, l''oignons et le piments dans 2 c à soupe d''huile d''olive.', 'Retirez-les à l''écumoire.', 'Dans la même sauteuse et l''huile de cuisson, saisissez les morceaux de viande.', 'Laissez-les cuire pendant 20 min sur feu moyen, en remuant souvent. Puis ajoutez à la viande le mélange cuisiné plus haut(ail, etc.).', 'Assaisonnez avec les 4 épices et la cannelle, salez.', 'Mouillez avec le bouillon de volaille et le vinaigre. Continuez la cuisson pendant 45 mn sur feu moyen.', 'Cinq minutes avant la fin de la  cuisson, incorporez les rondelles de bananes et le chorizo rissolées ainsi que le maïs.'], ['Balance de cuisine', 'Casserole', 'Presse-agrumes', 'Mixeur', 'Batteur électrique'], ['', 'entrée', 'banane', 'recettes de cuisine', 'Ragoût de porc et de poulet à la banane', 'sel', 'confiserie', 'petit piment', 'testées', 'facile', 'ail', 'plat', 'blanc de poulet', 'bouillon de volaille', 'recette', 'cuisine', 'oignon rouge', 'recettes', 'boisson', 'huile d''olive', 'dessert', 'plat de résistance', 'chorizo', 'moyen', 'maïs', 'quatre-épices', 'épaule', 'cannelle', 'vinaigre', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:14:17.053294', [{'ingredient_id': '86f1ea7f-d587-4142-8d50-20fff1743967', 'quantite': '500 g'}, {'ingredient_id': '9d96328a-9f27-463d-91b2-8cf183eb87c1', 'quantite': '500 g'}, {'ingredient_id': '2330711d-4169-4d1e-a69f-e07b77a26e4c', 'quantite': '1'}, {'ingredient_id': '57c1f9bf-0101-405d-904a-431353a59b76', 'quantite': '2'}, {'ingredient_id': 'c13b6fdf-2714-426f-ba46-06e4b57bb73f', 'quantite': '2'}, {'ingredient_id': '8cddc80b-4d7c-4672-a184-3263305625a3', 'quantite': '2'}, {'ingredient_id': '0ade342b-4948-43f3-9fa9-be5a7e670aa4', 'quantite': '6'}, {'ingredient_id': '252b85c9-4933-4682-93ae-0be46399e647', 'quantite': '150 g'}, {'ingredient_id': '0ba31025-e159-45d2-8e75-40d433711297', 'quantite': '1'}, {'ingredient_id': 'f0826b9a-c66b-4113-8923-8b811a3bd1cd', 'quantite': '1'}, {'ingredient_id': '54463106-ad2a-4585-a702-50c15a2c5e81', 'quantite': '60 cl'}, {'ingredient_id': 'f2e6fc1b-8407-48fe-a2a4-b3ece80904b3', 'quantite': '2 cuillères'}, {'ingredient_id': 'd3e46745-0534-4d9e-836a-6f26128d995c', 'quantite': ''}, {'ingredient_id': 'cd835ce9-9f19-4598-ab23-f4487426f28e', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (325661, 'Gâteau bananes et pâte à tartiner', 'banane, pâte à tartiner, oeuf, sucre, farine, levure', '20 min', ['Préchauffez votre four à 190°C (thermostat 6/7). Beurrez et farinez votre moule.', 'Séparez les jaunes des blancs et montez les blancs en neige bien ferme.', 'Épluchez les bananes et coupez-les en morceaux. Écrasez-les avec une fourchette pour en faire de la purée. ', 'Mélangez les bananes écrasées aux jaunes d''oeufs, à la farine, au sucre et à la levure. Mélangez bien. Incorporez délicatement les blancs en neige à la préparation. Mélangez délicatement.', 'Faites fondre la pâte à tartiner dans une casserole au bain-marie.', 'Versez la pâte dans le moule, puis faites couler le Nutella sur la surface.', 'Enfournez pendant 45 minutes.', 'Petit conseil : Mettre au frigo et le déguster froid c''est meilleur.'], ['Passoire', 'Casserole', 'Poêle', 'Ouvre-boîte', 'Planche à découper'], ['entrée', 'Gâteau bananes et pâte à tartiner', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre', 'cocktail', 'pâte à tartiner'], 'Dessert', 2e94709d-86e2-4203-a524-fcf3e33f693f, '2025-09-26T16:14:24.204913', [{'ingredient_id': '511a558e-cd25-4c9e-88a7-6e0b98d35073', 'quantite': '3'}, {'ingredient_id': 'dd4c386a-96f5-40ab-8d6e-1f23b1327c75', 'quantite': '3 cuillères'}, {'ingredient_id': '7e3f0517-6d7e-4217-81ac-c06b449b34f7', 'quantite': '4'}, {'ingredient_id': 'fa3158ea-64d1-457c-93e6-ed653e25dc75', 'quantite': '150 g'}, {'ingredient_id': 'c9a02f83-3275-4d85-82b6-55d72d3d2c80', 'quantite': '150 g'}, {'ingredient_id': '6cc403d5-3696-4861-a07c-edc7e45364bd', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (15206, 'Curry de crevettes aux fruits', 'crevettes, citron vert, banane, pomme, amandes en poudre, lait de coco, crème fraîche allégée, gingembre, sel, ail, curry, menthe', '20 min', ['Décortiquer et dénerver les crevettes, les faire sauter 2 minutes avec la menthe, l''ail, le curry, le sel et le poivre. ', 'Ajouter les fruits coupés en dés et rondelles, le jus du citron vert, le lait de coco et le gingembre. Faire mijoter le tout 10 minutes.', 'Joindre ensuite la poudre d''amandes et la crème fraîche, poursuivre la cuisson 5 minutes.', 'Servir chaud accompagné de riz blanc ou de riz mélangé à des raisins secs.'], ['Verre doseur', 'Couteau de chef'], ['lait de coco', 'gingembre', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'menthe', 'facile', 'bon marché', 'amandes en poudre', 'ail', 'Curry de crevettes aux fruits', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'crevettes', 'crème fraîche allégée', 'plat de résistance', 'pomme', 'citron vert', 'curry', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:14:29.150082', [{'ingredient_id': '83c64162-63fe-48d4-b34c-8adfe92339fd', 'quantite': '400 g'}, {'ingredient_id': '7f0578d0-7612-401f-b614-a0c986dfa8de', 'quantite': '1'}, {'ingredient_id': '6a66b11e-682e-4f3b-8cb2-2c70edb21b58', 'quantite': '1'}, {'ingredient_id': '20b2b402-4042-4fac-a9e1-9a8e3f763690', 'quantite': '1'}, {'ingredient_id': 'd8396a28-87ed-4618-bd9b-27c7bd6ec0fb', 'quantite': '1 cuillères'}, {'ingredient_id': 'f6804ead-8715-44e0-8c26-04acac19ddc8', 'quantite': '200 ml'}, {'ingredient_id': '600b9883-6cd7-4610-af80-2b8c45ea2097', 'quantite': '100 ml'}, {'ingredient_id': '3475c5c4-d36b-43e0-a810-156a8de4520c', 'quantite': '3'}, {'ingredient_id': '20ce2aa2-1d5f-4ecd-8ace-c5f2abd88a75', 'quantite': ''}, {'ingredient_id': 'ad72be4f-abbe-4a6d-9818-432b78362d96', 'quantite': '1'}, {'ingredient_id': '2a1526f7-d270-419d-adfb-7136f9a40102', 'quantite': '1 cuillères'}, {'ingredient_id': '855d5478-6bb8-43bb-8d86-5c45cf2e5279', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (310861, 'Emincé de poulet aux bananes poingo et ignames', 'poulet, banane, carotte, champignons de Paris, igname, nouilles, persil, chili, sauce aigre douce, lait de coco, sauce soja, ail, épices à couscous, sel, poivre', '45 min', ['Epluchez les bananes et les couper en deux dans la largeur.', 'Epluchez l''igname et faites des rondelles d''environ 1 cm d’épaisseur.', 'Faites cuire le tout à feu doux dans le lait de coco (la boite entière + une demi boite d''eau). Piquez avec le couteau pour vérifier la cuisson, cela ne doit pas faire de la purée.', 'Retirez et réserver.', 'Dans une poêle, faites sauter le poulet, les carottes coupées en bâtonnets, et les champignons avec un peu d''huile, ajoutez du sel et du poivre et les sauces.', 'Dans un saladier, disposer vos rouleaux de nouilles chinoises, versez-y de l''eau bouillante et une cuillère à café d''huile d''olive et laissez gonfler 5 à 6 minutes ( pas plus après elles deviennent trop collantes). ', 'Égouttez les nouilles et ajoutez-les au mélange dans la poêle. Ajoutez-y une ou deux moitiés de banane coupée grossièrement. ', 'Disposez le mélange dans un plat et ajouter sur le dessus le reste des bananes et ignames coupés. ', 'Ajoutez un brin de persil pour la déco.'], ['Poêle', 'Pince de cuisine', 'Mixeur', 'Moule à tarte', 'Fouet'], ['sauce aigre douce', 'lait de coco', 'poulet', 'banane', 'entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'carotte', 'facile', 'igname', 'bon marché', 'nouilles', 'ail', 'plat', 'blanc de poulet', 'recette', 'cuisine', 'recettes', 'boisson', 'Emincé de poulet aux bananes poingo et ignames', 'dessert', 'persil', 'plat de résistance', 'épices à couscous', 'champignons de Paris', 'poivre', 'cocktail', 'sauce soja', 'chili'], 'Plat principal', e0b3057f-6725-4866-8f25-bfca8a532d9e, '2025-09-26T16:14:32.923698', [{'ingredient_id': '02a7dbdf-f3ef-4cc6-ada1-aed20b12683c', 'quantite': '500 g'}, {'ingredient_id': '44e7d31f-6178-4f0f-929b-30820bfe1936', 'quantite': '4'}, {'ingredient_id': 'c7e02dbf-1743-4e47-ac26-e9e1ab56c812', 'quantite': '6'}, {'ingredient_id': 'e2f47354-b91a-4fd3-b43c-4beefee660d3', 'quantite': '1'}, {'ingredient_id': '985f1ff0-19bf-4d53-99c4-50e6c6b2fe10', 'quantite': ''}, {'ingredient_id': '1173a0a1-dafd-4869-be14-7a7e1332daf8', 'quantite': '6'}, {'ingredient_id': 'ea318def-c961-4b03-b758-8afbc657aeb1', 'quantite': '1'}, {'ingredient_id': '5de72ff8-4ac3-43c0-b95c-6d991a14161a', 'quantite': '2 cuillères'}, {'ingredient_id': 'e819c622-bb4e-428d-a1f4-00ab90da6367', 'quantite': '2 cuillères'}, {'ingredient_id': '6ccf5808-836e-4bab-9874-63c99ed19eba', 'quantite': '50 cl'}, {'ingredient_id': 'a4f84b61-5e3c-4480-a3cf-c70f81bb977e', 'quantite': ''}, {'ingredient_id': '519b997d-7f09-4747-b86a-583403d71265', 'quantite': ''}, {'ingredient_id': '3b25077a-033e-49ee-a3ec-02caa2e6b7db', 'quantite': '1'}, {'ingredient_id': 'df34d7c5-bb46-490e-b52c-6749c45b14af', 'quantite': ''}, {'ingredient_id': '26332afc-a5a5-4a67-bc05-dce59504c418', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (32190, 'Pica pollo (République Dominicaine)', 'banane plantain, poulet, oignon, poivron, cube de bouillon, farine, huile', '120 min', ['Couper le poulet en morceaux. Couper en morceaux également le poivron et l''oignon.', 'Dans un saladier, placer le poulet, le poivron, l''oignon et effriter le cube de boullon. Ajouter de l''eau et laisser mariner.', 'Eplucher les banenes plantain, puis les couper en tranches épaisses de 2 cm.', 'Faire bien chauffer l''huile et ensuite y plonger les tranches de bannaes plantain. A mi-cuisson, les retirer et les écraser avec une bouteille, puis terminer la cuisson dans l''huile bien chaude jusqu''à ce qu''elles soient dorées. Les sortir, les placer sur du papier absorbant et les saler.', 'Une fois le poulet mariné (1 heure), recouvrir les morceaux de farine et les tapoter pour enlever le superflu. Les faire frire jusqu''à ce qu''ils soient bien cuits.', 'Sevir bien chaud 2 morceaux de poulet par personne, accompagnés de bananes plantain.'], ['Mixeur', 'Balance de cuisine', 'Pince de cuisine', 'Moule à tarte'], ['', 'poulet', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'recette', 'cube de bouillon', 'cuisine', 'recettes', 'oignon', 'boisson', 'huile', 'farine', 'poivron', 'Pica pollo (République Dominicaine)', 'dessert', 'plat de résistance', 'banane plantain', 'cocktail'], 'Plat principal', 7311d134-b9f8-4a36-b620-90c2d21b773e, '2025-09-26T16:14:37.821510', [{'ingredient_id': 'c225d8bb-0f20-4968-bd0d-a183d77f8af9', 'quantite': '2'}, {'ingredient_id': '6b51aa91-df0a-4c08-8df9-2afc6aae044b', 'quantite': '1'}, {'ingredient_id': 'c545cf39-e062-409e-a177-f7bf6a7568f8', 'quantite': '1'}, {'ingredient_id': 'cd0628ba-623f-4023-92b1-5d165baf087d', 'quantite': '1'}, {'ingredient_id': '1ada94c7-5f7f-45d3-b563-a648272a7128', 'quantite': '1'}, {'ingredient_id': '1b552c94-5b3c-4016-891c-0894db40584c', 'quantite': ''}, {'ingredient_id': '5224582e-1196-4ace-a309-503f74bcd1f2', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (30499, 'Tarte pommes, bananes et chocolat', 'pâte brisée, banane, pomme, cacao, noix de coco, sucre vanillé', '20 min', ['Etaler la pâte brisée et la disposer dans un moule à tarte légèrement beurré. Faire cuire à blanc pendant environ dix minutes (à thermostat 7/210°C).', 'Pendant ce temps, écraser les bananes pour en faire une bouillie. Y ajouter le chocolat en poudre et la noix de coco rapée. Mélanger.', 'Quand la pâte est prête, y étaler le mélange.', 'Eplucher les pommes et les couper en lamelles. Disposer les sur la pâte, au dessus des bananes. Saupoudrer le tout de sucre vanillé.', 'Mettre au four.', 'Enfourner 35 mn à 180°C.'], ['Passoire', 'Planche à découper', 'Batteur électrique', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'bananes et chocolat', 'cacao', 'Tarte pommes', 'plat', 'tarte aux pommes', 'recette', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'noix de coco', 'cocktail'], 'Dessert', 40afcc3e-a9af-413a-b8b6-9ca53062a564, '2025-09-26T16:14:41.500959', [{'ingredient_id': '4e26b3f6-c203-423f-809b-44ba377e06a7', 'quantite': '1'}, {'ingredient_id': '60e33434-b67e-4c41-939d-f3805946de2e', 'quantite': '5'}, {'ingredient_id': '238bc332-8c57-4c5b-96e7-98e84fcb2635', 'quantite': '2'}, {'ingredient_id': '4c251955-a7af-4b2e-894c-31b94ebf7267', 'quantite': '2 cuillères'}, {'ingredient_id': '7c85deab-a73f-422e-ae0b-573cdb9c0f4e', 'quantite': ''}, {'ingredient_id': '96b28a03-e5e9-4364-b091-4652bc5d01ec', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (18890, 'Cake à la banane super facile et super bon', 'beurre doux, farine, sucre en poudre, oeuf, banane, sucre vanillé, levure chimique', '45 min', ['Mettre dans un grand bol le beurre coupé en morceaux ainsi que le sucre et bien battre au fouet électrique jusqu''à ce que le sucre se soit dissout et que le crème obtenue soit devenue blanche et mousseuse (15 mn environ). ', 'Ajouter ensuite les oeufs un à un en prenant soin de bien battre en chaque oeuf. Ajouter en même temps le sucre vanillé et les 3 bananes (15 mn). ', 'Si vous disposez de crochets avec votre fouet électrique, mettez les à la place des fouets. ', 'Ajoutez la farine et le cachet de levure, bien mélanger (10 mn). ', 'Avant de mettre la pâte dans le moule, couper la demi banane qui reste en petits morceaux que vous amalgamerez délicatement avec une spatule à la pâte (5 mn). ', 'Mettre dans un moule dont vous avez recouvert le fond de papier sulfurisé et beurré les bords. Faire cuire 60 à 70 mn dans le four préalablement chauffé à 210°C (Th 7 si c''est un four électrique)'], ['Moule à tarte', 'Fouet', 'Tire-bouchon'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'très facile', 'bon marché', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'autres cakes', 'dessert', 'plat de résistance', 'sucre vanillé', 'Cake à la banane super facile et super bon', 'beurre doux', 'cocktail'], 'Dessert', 33b45207-cc6f-4089-9654-d3d980fb4a67, '2025-09-26T16:14:45.109071', [{'ingredient_id': '0f7e7a3f-222e-40cb-9a0e-39f2ddc80bf6', 'quantite': '250 g'}, {'ingredient_id': 'bab806cf-e605-4bcd-b486-bf886afb851c', 'quantite': '300 g'}, {'ingredient_id': '14c4bf0d-4956-41e4-aa51-261c0917a8fc', 'quantite': '250 g'}, {'ingredient_id': '8e57155f-53a9-4c18-b349-435fa9c89dda', 'quantite': '3'}, {'ingredient_id': 'b26afe73-fd68-4ae8-bbf7-b0d4591bbb19', 'quantite': '3'}, {'ingredient_id': '734e2bf3-fba5-4535-a804-c9a465553254', 'quantite': '1'}, {'ingredient_id': '622bb238-1e18-4801-9d6d-b778dcc94fba', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (166094, 'Crème rapide à la banane', 'banane, gelée, sucre, yaourt nature', '10 min', ['Ecrasez les bananes bien mûres à la fourchette.', 'Ajoutez à la purée ainsi obtenue la gelée de groseille et le sucre en poudre en travaillant toujours à la fourchette.', 'Mélangez avec les yaourts en battant vigoureusement au fouet.', 'Répartissez dans des petites coupes et placez au frais pendant 1 heure minimum.', 'Servir avec des meringues ou des biscuits à la cuiller.'], ['Balance de cuisine', 'Planche à découper', 'Couteau de chef', 'Économe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'yaourt nature', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Crème rapide à la banane', 'dessert', 'plat de résistance', 'gelée', 'sucre', 'cocktail'], 'Dessert', d6f2aca6-9724-4982-a90c-44484176b846, '2025-09-26T16:14:48.655766', [{'ingredient_id': '2b445dd0-52c4-4d04-9c7e-d0774633834f', 'quantite': '3'}, {'ingredient_id': '170ebb91-ef27-43f5-94b0-3641c6064a9a', 'quantite': '4 cuillères'}, {'ingredient_id': '6097bbfe-d6cf-4c87-9490-55c4886a28e2', 'quantite': '4 cuillères'}, {'ingredient_id': '29455640-4d37-4e64-8647-ee15f536bd89', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (62823, 'Salade de papaye', 'banane, papaye, mangue, fruit de la passion, ananas, sirop de grenadine, rhum, sucre', '10 min', ['Couper les fruits en dés. Récupérer la chair des fruits de la passion.', 'Mélanger tous les fruits, rajouter le sirop plus le rhum et mettre au frais.', 'On peut changer les fruits selon les saisons et varier avec de l''alcool de coco.'], ['Passoire', 'Pince de cuisine'], ['', 'entrée', 'banane', 'papaye', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'facile', 'rapide', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'fruit de la passion', 'dessert', 'plat de résistance', 'moyen', 'ananas', 'sirop de grenadine', 'Salade de papaye', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:14:53.240773', [{'ingredient_id': 'f65949ff-4010-4d70-992b-7156981a6e20', 'quantite': '2'}, {'ingredient_id': '7157f742-9b77-49f3-87c8-21f30856d37b', 'quantite': '1'}, {'ingredient_id': '774f06f0-49ab-4847-8d9e-7ffc81ce5088', 'quantite': '1'}, {'ingredient_id': '3b57da5b-15a2-4cb0-9802-02388599eddd', 'quantite': '3'}, {'ingredient_id': 'd928a172-aa02-4089-bfad-49c8cbd567a0', 'quantite': '1'}, {'ingredient_id': 'a27847bb-bab6-445f-8711-8f1874d3848c', 'quantite': '2 cuillères'}, {'ingredient_id': '5cc94fc9-3609-46ea-a34f-35de4e619fe5', 'quantite': '1 cuillères'}, {'ingredient_id': 'dd6dd126-b049-42be-aade-f357d498ce6e', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (171550, 'Tiramisu des Iles (sans oeufs)', 'banane, sucre vanillé, rhum, noix de coco, sucre, mascarpone, petit suisse, crème liquide, biscuit sablé', '15 min', ['Écraser les bananes bien mûres avec 1 sachet de sucre vanillé (vous pouvez ajouter une lichette de rhum si vous aimez).', 'Dans un autre appareil, mélanger le mascarpone, le sucre, le sachet de sucre vanillé, les petits suisses et la noix de coco.', 'Au fouet, ajouter délicatement la crème chantilly jusqu''à obtention d''une crème aérienne et onctueuse.', 'Dans un plat ou 6 verrines, disposer la banane, puis la crème par dessus.', 'Laisser reposer au moins 2 heures sous film et au frais. Puis parsemer de sablés émiettés juste avant la dégustation. ', 'Décorer avec du cacao en poudre, des rondelles de bananes ou de la noix de coco.', 'Régalez vous!'], ['Économe', 'Casserole', 'Louche', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'mascarpone', 'rhum', 'confiserie', 'petit suisse', 'testées', 'biscuit sablé', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'dessert', 'plat de résistance', 'sucre vanillé', 'tiramisu', 'Tiramisu des Iles (sans oeufs)', 'noix de coco', 'sucre', 'cocktail'], 'Dessert', 442c31d4-27d1-4690-8035-01818f9f6cb7, '2025-09-26T16:14:56.839203', [{'ingredient_id': 'eb0cb135-5e6b-40e9-8e14-fa36786b5fc7', 'quantite': '2'}, {'ingredient_id': '9f989efe-f768-44cb-ab6d-cded4c113b1a', 'quantite': '2'}, {'ingredient_id': 'ae210a0c-e7c3-44d7-8bb6-3c009259f9e6', 'quantite': '1 cuillères'}, {'ingredient_id': '1c97d0d1-18d1-488d-b7a8-5869c60f3c27', 'quantite': '3'}, {'ingredient_id': 'b3ef7c5b-358a-414c-b3c5-0eb8c8a63935', 'quantite': '3'}, {'ingredient_id': '1a4883e5-b0a1-4cd0-98fd-926f03d36bcf', 'quantite': '250 g'}, {'ingredient_id': '426ef5b7-4c8a-4876-bf1e-0a0a787e97cb', 'quantite': '2'}, {'ingredient_id': '65690b33-c10f-47a6-abab-12d67516a7a5', 'quantite': '20 cl'}, {'ingredient_id': 'aa5af568-d087-433c-aa17-49be52162f4c', 'quantite': '12'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (18394, 'Tarte Tatin Oranges Bananes', 'banane, orange, sucre, sucre vanillé, beurre, pâte feuilletée', '15 min', ['Beurrez un moule à tarte. Saupoudrez de sucre et de sucre vanillé, puis recouvrez de rondelles de bananes et d''oranges, préalablement pelées.', 'Saupoudrez le tout de sucre et parsemez de morceaux de beurre. Couvrez l''ensemble avec la pâte en faisant bien rentrer les bords.', 'Faites cuire jusqu''à ce que la pâte prenne une belle teinte dorée.', 'Voilà, régalez-vous bien !'], ['Presse-agrumes', 'Tire-bouchon', 'Fouet', 'Passoire'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'Tarte Tatin Oranges Bananes', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'tarte Tatin', 'dessert', 'plat de résistance', 'pâte feuilletée', 'sucre vanillé', 'beurre', 'orange', 'sucre', 'cocktail'], 'Dessert', c751b52b-3bbc-4d9f-9528-a585691bcec0, '2025-09-26T16:15:00.460476', [{'ingredient_id': '04431ac3-8757-44a2-86f2-1d6a7c4da83d', 'quantite': '2'}, {'ingredient_id': '6cdff471-b7ec-454a-9253-0576fa18cb3a', 'quantite': '2'}, {'ingredient_id': '6ba0fc96-5dd4-4beb-8bed-c35fab913576', 'quantite': ''}, {'ingredient_id': '49225aec-122e-4c54-a5d9-cb32dfd814db', 'quantite': ''}, {'ingredient_id': 'ff01d363-dc6a-4488-9017-48b671898992', 'quantite': ''}, {'ingredient_id': '69617926-f7f3-40d7-95a6-562632fe372f', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (41769, 'Poulet curry-banane "à ma façon"', 'escalope de poulet, oignon, tomate, banane, lait de coco, champignons de Paris, curry, poivre, sel', '15 min', ['Couper les escalopes de poulet en dés de taille moyenne. ', 'Emincer les oignons, et faire revenir le tout dans un wok. ', 'Saler, poivrer et mettre du curry (1 pincée, environ), à mi-cuisson. ', 'Une fois que le poulet est cuit, ajouter la tomate pelée et coupée en morceaux, ainsi que les champignons, et le lait de coco. ', 'Attention : il n''est pas toujours nécessaire de mettre tout le lait de coco, sinon la sauce est trop liquide!', 'Couvrir, et laisser mijoter à feu doux, pendant 10 min. ', 'Avant de servir, rajouter du curry et la banane coupée en rondelles pas trop fines. ', 'Mélanger, et ne pas hésiter à goûter.... Afin de modifier l''assaisonnement, si nécessaire.', 'Servir avec du riz thaï ou basmati.'], ['Verre doseur', 'Casserole', 'Couteau de chef', 'Balance de cuisine', 'Rouleau à pâtisserie'], ['lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'bon marché', 'Poulet curry-banane "à ma façon"', 'curry de poulet', 'tomate', 'plat', 'escalope de poulet', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'dessert', 'plat de résistance', 'champignons de Paris', 'poivre', 'curry', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:15:04.227064', [{'ingredient_id': '72b16442-adf6-4d23-a212-9ff794f5b257', 'quantite': ''}, {'ingredient_id': '15538fa0-deb8-4f76-bd58-20967ded9f4b', 'quantite': '1'}, {'ingredient_id': '05cf8537-458b-4819-a45f-13d18f565355', 'quantite': '1'}, {'ingredient_id': 'cbb35576-263b-4436-9568-fdea9f765da8', 'quantite': '1'}, {'ingredient_id': '5ca9cb87-10e0-4a31-9bb1-6d2638a76f6f', 'quantite': '1'}, {'ingredient_id': '6ed7207d-9f11-411d-a521-cbeac4cfa66d', 'quantite': ''}, {'ingredient_id': '6c98067b-e7c1-4c0b-bbfb-7f1a9d777f99', 'quantite': ''}, {'ingredient_id': 'd99f18ce-ea56-448c-bab8-165b2d7020d2', 'quantite': ''}, {'ingredient_id': '815259c4-4ac0-49c3-8052-6ef673f90207', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (13495, 'Cari de lotte', 'queue, tomate, oignon, ail, lait de coco, pomme, banane, pâte, raisins secs, coriandre, curcuma', '40 min', ['Peler et hacher grossierement les tomates, puis les faire revenir avec les oignons.', 'Ajouter le lait de coco, la pomme et la banane râpées, les raisins, laisser mijoter à feu doux.', 'Faire cuire presque completement les queues de lotte au court-bouillon, ajouter le cari et la coriandre hachée à la sauce, incorporer les queues de lotte et laisser finir de cuire en surveillant.', 'Servir avec du riz basmati.'], ['Pince de cuisine', 'Râpe', 'Louche', 'Mixeur'], ['lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'tomate', 'ail', 'plat', 'moyenne', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'curcuma', 'pâte', 'dessert', 'plat de résistance', 'queue', 'pomme', 'moyen', 'Cari de lotte', 'coriandre', 'raisins secs', 'viande à l''indienne', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:15:07.897746', [{'ingredient_id': '1f50c157-8267-48bf-9e4d-b3c2ae139331', 'quantite': '12'}, {'ingredient_id': 'd5046213-b310-4b5c-a875-cbb0bf9df684', 'quantite': '800 g'}, {'ingredient_id': '6fba588a-0fde-4d8a-9fac-3840d10533b6', 'quantite': '4'}, {'ingredient_id': '5dfe1aee-2c82-4437-bc1d-9b3422bcd1e9', 'quantite': '4'}, {'ingredient_id': 'dbe44ed4-c846-4926-86a5-15a40a7952c0', 'quantite': '30 cl'}, {'ingredient_id': '74ed595e-b176-4818-9ff9-404d0ad651fe', 'quantite': '1'}, {'ingredient_id': 'd5bbd077-9d37-4d1c-be66-c2e9ab08201e', 'quantite': '1'}, {'ingredient_id': '8d88c8d9-70ca-4a88-b50d-01a11ebc4065', 'quantite': '1 cuillères'}, {'ingredient_id': '2d8ed88c-62a5-471f-85f2-5395c7f73927', 'quantite': '50 g'}, {'ingredient_id': '6659166c-40bd-4149-b3ef-5cbae0957154', 'quantite': ''}, {'ingredient_id': 'a9246f61-a226-4507-b539-3d172e5bf238', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (56861, 'Gouy gouy ( banane écrasée au nutella )', 'banane, lait, Nutella', '5 min', ['Ecraser les bananes à la fourchette en incorporant petit à petit le lait.', 'Mélanger rigouresement en ajoutant le nutella.'], ['Couteau de chef', 'Casserole', 'Verre doseur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Nutella', 'dessert', 'plat de résistance', 'Gouy gouy ( banane écrasée au nutella )', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:15:11.538182', [{'ingredient_id': '1cb2b1b6-003e-4584-83c0-0dedb2f21fe4', 'quantite': '3'}, {'ingredient_id': 'f8dd2dd3-8002-4de1-b65c-17fb82ed0b70', 'quantite': '10 cl'}, {'ingredient_id': '81525188-e7c5-4943-979f-7e4f6ff30cbc', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (15131, 'Blanc-manger coco-bananes', 'lait, noix de coco rapée, sucre, gélatine, banane, jus de citron', '30 min', ['Faire bouillir 5 mn le lait avec la noix de coco râpée, laisser infuser 30 mn, puis filtrer à l''aide d''un torchon.', 'Réchauffer le liquide obtenu et ajouter le sucre puis les feuilles de gélatine préalablement dissoutes.', 'Incorporer 3 bananes en purée (écrasées à la fourchette) et 1 jus de citron.', 'Laisser au frais une nuit. Décorer avec des bananes (citronnées pour ne pas qu''elles noircissent) et des morceaux de mangues.'], ['Verre doseur', 'Pince de cuisine', 'Râpe', 'Planche à découper'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Blanc-manger coco-bananes', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'noix de coco rapée', 'dessert', 'plat de résistance', 'jus de citron', 'gélatine', 'sucre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:15:15.265756', [{'ingredient_id': '53605cee-393a-4049-92c3-e6f1e0600ef5', 'quantite': ''}, {'ingredient_id': '54705c03-2727-4dc4-8a8c-9266c68f9d82', 'quantite': '400 g'}, {'ingredient_id': '5886ad25-aca6-4fab-8f5c-b7fa69ff74d4', 'quantite': '150 g'}, {'ingredient_id': 'aef6957e-d3d3-4b2f-9276-05086e4c355a', 'quantite': '4'}, {'ingredient_id': 'a6edd933-7356-4e9c-b0c2-82e065ba3616', 'quantite': '3'}, {'ingredient_id': 'ad79db45-5f18-4a8a-a0d8-8613c4b635ea', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (35990, 'rhum arrangé à la banane', 'banane, cannelle, sucre roux, vanille, rhum', '5 min', ['Mettre dans une bouteille en verre d''un litre:', '- les bananes coupées en rondelles', '- 1 cuillère à soupe de cannelle en poudre (ou 3 bâtons de cannelle)', '- le sucre et la vanille ', '- terminer avec 1/4 de rhum brun et 3/4 de rhum blanc', 'Bien refermer puis laisser macérer un mois minimum en remuant de temps en temps...'], ['Batteur électrique', 'Passoire', 'Spatule', 'Balance de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'rapide', 'plat', 'cocktail rhum', 'recette', 'cuisine', 'rhum arrangé à la banane', 'recettes', 'boisson', 'vanille', 'dessert', 'plat de résistance', 'moyen', 'cannelle', 'cocktail', 'sucre roux'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:15:18.805722', [{'ingredient_id': '7e9bdc02-93e3-4c94-9be9-f28526daf806', 'quantite': '4'}, {'ingredient_id': '2ec3f6d3-03ba-4c50-96ed-8df89ac68a86', 'quantite': ''}, {'ingredient_id': 'f7a98d10-e498-42f2-a4d6-b2f13682c247', 'quantite': '10'}, {'ingredient_id': '0afd2230-7876-4ac4-b996-7f993ba10d83', 'quantite': '1'}, {'ingredient_id': 'e84d7b63-6e20-4fac-97dd-154411347ec8', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (29606, 'Banana bread (pain à la banane)', 'farine, sucre, levure chimique, bicarbonate, sel, margarine, oeuf, banane, jus de citron, lait', '20 min', ['Ecrasez les bananes, ajoutez le citron, réservez.', 'Melangez la farine, le sel, la levure et le bicarbonate, puis réservez.', 'Mélangez le sucre et la margarine pour obtenir un mélange onctueux, lisse, ajoutez les oeufs un à un en mélangeant 4 minutes.', 'Ajoutez petit à petit la farine et le lait à tour de rôle et en dernier le mélange banane et citron.', 'Placez le mélange dans un grand moule à cake beurré (ou deux moules de taille moyenne) et mettez au four à thrmomstat 6 (180°C) 1h30 pour le grand plat ou 1h10 pour les deux. Vérifiez la cuisson avec la pointe d''un couteau.', 'Sortez du four et démoulez quand il est refroidi, emballez-le dans un film et laissez reposez une nuit, puis coupez pour déguster ou congelez. Délicieux!'], ['Passoire', 'Balance de cuisine', 'Casserole', 'Ouvre-boîte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'levure chimique', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'Banana bread (pain à la banane)', 'cuisine', 'recettes', 'boisson', 'farine', 'margarine', 'dessert', 'plat de résistance', 'jus de citron', 'sucre', 'lait', 'cocktail', 'bicarbonate'], 'Dessert', 5900b97b-e931-4b63-86fc-2e05e9716beb, '2025-09-26T16:15:22.502056', [{'ingredient_id': '8d905ed5-8e78-4a27-9099-8c8c0d9dfbf2', 'quantite': '350 g'}, {'ingredient_id': '6b0fd0d2-71de-4975-ba20-c4dede072244', 'quantite': '300 g'}, {'ingredient_id': '8691c697-020d-4f95-b378-d60f79916000', 'quantite': '3 cuillères'}, {'ingredient_id': '52d42abc-ae2d-4cb3-a1cf-06026ec4bf3a', 'quantite': '1 cuillères'}, {'ingredient_id': 'b82793fd-84cd-4542-b234-d72e0e2ac3b0', 'quantite': '1 cuillères'}, {'ingredient_id': 'e60509a2-f90e-45d7-b9e8-dad47c21d253', 'quantite': '200 g'}, {'ingredient_id': '6fbb2e82-f692-4b29-be82-fc166ab650ee', 'quantite': '3'}, {'ingredient_id': '2e4441e2-439e-4fe4-b1fb-b2ceca8a8192', 'quantite': '6'}, {'ingredient_id': 'c3be2281-4496-43d5-b8fd-fb02dc8e379a', 'quantite': '3 cuillères'}, {'ingredient_id': '3dc04f87-001f-4a86-8034-fba58f769af0', 'quantite': '20 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (69781, 'Verrines aux fruits et aux 3 chocolats', 'chocolat noir, chocolat blanc, chocolat au lait, oeuf, crème, crème, kiwi, banane, pomme, poire, ananas, crêpe dentelle', '45 min', ['Mettre la crème au congélateur. Couper les fruits choisis en petits morceaux et les disposer dans les verrines.', 'Dans un bol casser le chocolat noir en très petits morceaux ou le râper. ', 'Chauffer au micro-ondes les 10 cl de crème à température ambiante pendant 2 min puissance moyenne (500 Watts). Verser la crème sur le chocolat noir, couvrir d''un film étirable et attendre 5 min.', 'Bien mélanger et verser dans les verrines sur 2 cm de hauteur. Placer au frais.', 'Déposer des miettes de crêpes sur le dessus après léger durcissement.', 'Faire fondre le chocolat blanc au bain marie sans le toucher pendant 5 min puis le mélanger au fouet hors du bain marie.', 'Monter la crème sortie du congélateur en chantilly avec un batteur.', 'Incorporer (au batteur) 1/3 de la crème chantilly au chocolat blanc.', 'Ensuite incorporer délicatement (à la cuillère en bois) le reste de crème au chocolat blanc.', 'Répartir dans les verrines. Placer au réfrigérateur pour 30 min.', 'Déposer des miettes de crêpes sur le dessus après léger durcissement', 'Faire fondre le chocolat au lait au micro-ondes avec 2 cuillères à soupe d''eau pendant 1 min 30 puissance moyenne. Ajouter les jaunes d''oeufs (laisser un peu refroidir le chocolat pour ne pas cuire les jaunes) et mélanger.', 'Battre les blancs en neige ferme et les incorporer délicatement au chocolat au lait à la cuillère en bois. Répartir dans les verrines et mettre au frais.', 'Déposer des miettes de crêpes sur le dessus après léger durcissement et décorer de copeaux de chocolat blanc et de petits morceaux (ou une rondelle) de fruit.', 'Placer au frais au moins 3h avant dégustation, le lendemain ce sera meilleur!!!'], ['Spatule', 'Planche à découper', 'Économe'], ['', 'chocolat au lait', 'entrée', 'banane', 'Verrines aux fruits et aux 3 chocolats', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'rapide', 'oeuf', 'plat', 'moyenne', 'crème', 'recette', 'cuisine', 'recettes', 'boisson', 'crêpe dentelle', 'dessert', 'plat de résistance', 'chocolat noir', 'pomme', 'moyen', 'ananas', 'chocolat blanc', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:15:27.754037', [{'ingredient_id': '7a3ca405-b57c-48d9-9aa5-7241f499a1cf', 'quantite': '100 g'}, {'ingredient_id': 'b1d2667b-1690-4245-b7fb-7b6b72fd4be2', 'quantite': '90 g'}, {'ingredient_id': 'c7eeb41d-2b4a-4abf-aa1b-36b89e857cd4', 'quantite': '90 g'}, {'ingredient_id': 'd54d507b-324b-473a-8fe3-d6378bf76b3a', 'quantite': '3'}, {'ingredient_id': '1a21767e-3101-435f-b48d-08aa7fbb7c6f', 'quantite': '10 cl'}, {'ingredient_id': 'fdf27912-5c5c-49de-94f3-ed7a9082bbbc', 'quantite': '10 cl'}, {'ingredient_id': 'f564e382-9a58-44f4-bf5d-a52334bf4799', 'quantite': ''}, {'ingredient_id': 'c3ac8c5f-09b0-474c-b1d1-2a11cde377c7', 'quantite': ''}, {'ingredient_id': '1268ca96-b1cc-4488-b1eb-84fb3fff64cc', 'quantite': ''}, {'ingredient_id': '25917cc8-b2b8-448e-9334-709aaf81a5de', 'quantite': ''}, {'ingredient_id': 'e00e39c6-7074-450f-b5d1-2ea082527fb2', 'quantite': ''}, {'ingredient_id': 'e34ec0b7-a4a7-40b8-9eaf-6a9bf6ac91c7', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (29699, 'Potée à la créole', 'queue, petit salé, banane, chou blanc, igname, madère, citron, ail, cive, poivre, sel', '10 min', ['Eplucher l''igname et le madère et les couper en rondelles. Couper les extrémités des bananes et les fendre dans le sens de la longueur, puis les ploncher dans l''eau un peu salée pendant 15 à 20 min, avant de porter à ébullition jusqu''à ce que le tout soit cuit.', 'A mi-cuisson, plonger le chou coupé en deux dans le sens de la longueur.', 'En même temps, mettre dans une autre casserole les queues et le petit salé dans de l''eau avec 1 gousse d''ail écrasée et une branche de cive pendant au moins 30 mn pour qu''ils soient bien tendres.', 'Une fois tous vos aliments cuits, garder au chaud et préparer la  vinaigrette. Avec un brin de cive coupé finement, mélanger le jus d''un citron vert, 2 gousses d''ail écrasées, poivre et sel.  ', 'Dresser vos aliments et arroser de vinaigrette.'], ['Balance de cuisine', 'Presse-agrumes', 'Râpe', 'Rouleau à pâtisserie'], ['', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'chou blanc', 'facile', 'igname', 'ail', 'plat', 'petit salé', 'recette', 'cuisine', 'recettes', 'boisson', 'Potée à la créole', 'dessert', 'plat de résistance', 'queue', 'moyen', 'citron', 'cive', 'madère', 'poivre', 'cocktail'], 'Plat principal', 2b9bffc2-c962-468d-992e-23ec01ded0bc, '2025-09-26T16:15:32.894682', [{'ingredient_id': '49017550-96da-4624-860a-5380de998218', 'quantite': '2'}, {'ingredient_id': '6c54df47-e431-418d-82a4-af0fafaae103', 'quantite': '2'}, {'ingredient_id': '12f2e647-a0c1-4dea-8067-65bb336420d0', 'quantite': '2'}, {'ingredient_id': 'f484b29e-9287-4491-87dd-776940822010', 'quantite': ''}, {'ingredient_id': '88d410fd-7aea-4048-bf30-c4a12789e001', 'quantite': '1'}, {'ingredient_id': '4754c3ca-6346-4fb2-a5e0-2e32ddba09d5', 'quantite': '1'}, {'ingredient_id': 'd15c864b-da7e-48b7-bd49-31fa839a02c6', 'quantite': '1'}, {'ingredient_id': 'b3768389-1fda-49a1-9552-2bbcb821ad43', 'quantite': '3'}, {'ingredient_id': '32cf9c2e-d3f1-4972-8cd9-efde7402cc9f', 'quantite': '1'}, {'ingredient_id': 'ce8cf646-59c7-4d55-b624-21d34280df09', 'quantite': ''}, {'ingredient_id': 'b7c62f50-6a37-4cd5-a989-c5a79f93c613', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (169618, 'Punch divin', 'rhum, jus de banane, clémentine, goyave, jus de citron, sucre roux, vanille', '10 min', ['Mélangez l''ensemble des ingrédients. Placez au réfrigérateur.', 'Vous pouvez le préparer 24h à l''avance mais surtout servez-le très frais.'], ['Louche', 'Rouleau à pâtisserie', 'Ouvre-boîte', 'Batteur électrique'], ['entrée', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'goyave', 'très facile', 'Punch divin', 'rapide', 'plat', 'jus de banane', 'recette', 'cuisine', 'recettes', 'boisson', 'vanille', 'punch', 'clémentine', 'dessert', 'plat de résistance', 'jus de citron', 'moyen', 'cocktail', 'sucre roux'], 'Boisson', 7140332d-5c63-4432-8259-50b5e24ef7ae, '2025-09-26T16:15:38.087556', [{'ingredient_id': 'e2e3fbae-01d6-4a30-9b03-49a156c83072', 'quantite': '50 cl'}, {'ingredient_id': '1736754a-7474-42ef-b4f7-316abe6b1cb1', 'quantite': '60 cl'}, {'ingredient_id': '5a1e5dec-b175-4563-aae0-91824ce258ed', 'quantite': '60 cl'}, {'ingredient_id': 'afbf73b3-2aa7-4830-b588-9fa3a98f9875', 'quantite': '60 cl'}, {'ingredient_id': '263f38a7-f6ce-47cd-9c5c-681babe77a72', 'quantite': '10 cl'}, {'ingredient_id': '9b545a14-124b-4bb6-b44d-02342663b4d3', 'quantite': '50 g'}, {'ingredient_id': '3538005d-56af-43c3-8b84-163f6b646c38', 'quantite': '4 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (67924, 'Pudding de bananes au chocolat', 'banane, sucre, vanille, oeuf, farine, levure, rhum, huile, chocolat', '10 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Peler les 8 bananes et les mettre dans le saladier. Ecraser les bananes à la fourchette.', 'Ajouter les 2 cuillères à soupe de sucre, les grains de vanille et mélanger. Casser et ajouter les 2 œufs. Mélanger.', 'Ajouter les 4 cuillères à soupe de farine et la levure et mélanger. ', 'Ajouter le rhum et l''huile et mélanger. Verser la préparation dans un moule sans le beurrer. Enfourner. ', 'Couper le chocolat en petits morceaux et disposer sur le gâteau au bout de 3 minutes de cuisson.  Utiliser le couteau pour ramener délicatement de la pâte sur les morceaux de chocolat.', 'Remettre dans le four pendant 30 minutes, ou jusqu’à ce que le gâteau soit bien doré.'], ['Tire-bouchon', 'Poêle', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'chocolat', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'huile', 'farine', 'vanille', 'pudding', 'dessert', 'plat de résistance', 'sucre', 'Pudding de bananes au chocolat', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:15:41.900615', [{'ingredient_id': '293d960f-b2a5-4c70-a832-313a4d3846b0', 'quantite': '8'}, {'ingredient_id': 'ede15a09-bcdf-4915-9e9c-ec44dec4620a', 'quantite': '2 cuillères'}, {'ingredient_id': '02150b0d-15ff-41f3-b0ff-0e2c9e970ad6', 'quantite': '1'}, {'ingredient_id': '7c8291fe-9bc7-4a28-abd8-8506a7f47bad', 'quantite': '2'}, {'ingredient_id': '14be121d-8e8f-4ed3-888f-2dcd453038e0', 'quantite': '4 cuillères'}, {'ingredient_id': '989d3988-ec49-421b-9c82-b9dfc660b1db', 'quantite': '1'}, {'ingredient_id': '0f6ac141-2304-4502-94f2-ba58f08e2fbb', 'quantite': '2 cuillères'}, {'ingredient_id': 'ea1fd85d-023c-4a5f-8e18-cefa9bd51610', 'quantite': '4 cuillères'}, {'ingredient_id': 'b17f9970-d3c5-43f1-9221-5717537c6792', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (22775, 'bananes meringuées (recette brésilienne)', 'banane, oeuf, sucre, beurre, citron', '10 min', ['Peler et couper les bananes en deux dans le sens de la longueur. ', 'Beurrer avec 25 g de beurre un plat à four pouvant contenir les demi-bananes en une seule couche et rangez-y les fruits. ', 'Allumer le four à 100°C. Casser les oeufs en séparant les blancs des jaunes. Mettre les jaunes dans un saladier, ajouter la moitié du sucre et travailler le tout à à spatule. Incorporer le beurre en pommade. ', 'Verser la préparation sur les bananes. Battre les blancs en neige ferme avec le jus de citron. Incorporer le reste du sucre. Répartissez ces blancs sur le plat et glissez-le au four. ', 'Cuire 1 h. ', 'Lorsque le dessus du plat est doré, retirer du four et servir sans attendre!'], ['Économe', 'Poêle', 'Casserole', 'Râpe', 'Louche'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'bananes meringuées (recette brésilienne)', 'dessert', 'plat de résistance', 'citron', 'beurre', 'sucre', 'cocktail'], 'Dessert', 58938d22-4229-406e-9368-837b66bacdea, '2025-09-26T16:15:45.453126', [{'ingredient_id': '6920d6e3-e8ca-4bd3-8783-96e3dcff275f', 'quantite': '6'}, {'ingredient_id': 'cfaf559c-0096-423f-a59c-ab9c29f8b117', 'quantite': '6'}, {'ingredient_id': 'dbe76690-e3ab-4df3-9095-b108d7c80a55', 'quantite': '400 g'}, {'ingredient_id': '3a354fd0-997d-4f0d-b7e8-0d52f02764f9', 'quantite': '125 g'}, {'ingredient_id': '3f06ba91-1c8f-4bd2-b187-a4565acdbfb2', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (72804, 'Tiramisu Banane Speculoos', 'mascarpone, oeuf, sucre, sucre vanillé, banane, spéculoos, noix de coco', '20 min', ['Mettre les 3 jaunes d''oeuf dans un saladier. Battre les oeufs et y incorporer le mascarpone, puis mettre le sachet de sucre vanillé puis le sucre petit à petit en goûtant pour que le mélange soit assez sucré à votre goût. ', 'Mettre la variante si désirée. ', 'Dans le saladier, mettre les 3 blancs d''oeuf et les monter en neige bien ferme.', 'Incorporer doucement les blancs en neige à la préparation de mascarpone. ', 'Dans un assiette, écraser les bananes et y ajouter du sucre si besoin est.', 'Mettre la préparation à la banane au fond de chaque verrine puis mettre le mascarpone au dessus.', 'Mettre au frais jusqu''au moment de servir.', 'Au moment de servir, écraser dans un bol quelques spéculoos et soupoudrer le dessus de chaque verrine avec.'], ['Ouvre-boîte', 'Poêle', 'Balance de cuisine', 'Tire-bouchon', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'mascarpone', 'confiserie', 'testées', 'très facile', 'bon marché', 'Tiramisu Banane Speculoos', 'rapide', 'oeuf', 'plat', 'recette', 'spéculoos', 'cuisine', 'recettes', 'speculoos', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'noix de coco', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:15:48.955989', [{'ingredient_id': '3f72fab7-8c3b-41c4-bf3a-7e4a4f1c572e', 'quantite': '250 g'}, {'ingredient_id': 'aa140747-eaa8-4a8d-b387-0a99b76a409c', 'quantite': '3'}, {'ingredient_id': 'd78fb33d-0cfe-46f5-ab2b-ae0c054bb727', 'quantite': '200 g'}, {'ingredient_id': 'ad06b241-262b-4620-b45c-fe166b2296f9', 'quantite': '1'}, {'ingredient_id': '0724f393-6f3f-400b-a447-77cc69263152', 'quantite': '3'}, {'ingredient_id': 'c529fae2-e138-463c-bcd8-c9f24ada95ed', 'quantite': ''}, {'ingredient_id': 'f0cd857f-dcec-4b0e-abeb-c58200435ec9', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (165108, 'Queues de lotte curry et fruits', 'queue, pomme, oignon, banane, crème fraîche, curry, poivre, sel', '10 min', ['Emincer la pomme et l''oignon et faites les revenir à feu doux avec une cuillère d''huile d''olive. Puis ajouter la banane et laisser compoter les fruits. Ajouter un peu d''eau au besoin si cela a tendance à attacher.', 'Pendant ce temps, mettre les queues de lottes non décongelées à la cocotte-minute (environ 5 minutes à partir du moment où la vapeur s''échappe)', 'Quand les fruits se sont bien fondus entre eux, ajouter le curry et bien mélanger, puis incorporer la crème fraîche. Si la sauce est trop épaisse, on peut la délayer avec quelques gouttes d''eau.', 'Quand la lotte est cuite, la faire dorer quelques secondes de chaque côté puis la napper de sauce et servir.'], ['Râpe', 'Spatule'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'sel', 'confiserie', 'testées', 'très facile', 'plat', 'recette', 'cuisine', 'recettes', 'oignon', 'boisson', 'dessert', 'plat de résistance', 'queue', 'pomme', 'moyen', 'poivre', 'Queues de lotte curry et fruits', 'curry', 'viande à l''indienne', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:15:52.536693', [{'ingredient_id': 'ccdca3c3-c243-4a61-ac40-f2451efb3233', 'quantite': '4'}, {'ingredient_id': '228e5eea-e16b-476e-b290-e6c96d56f3c9', 'quantite': '1'}, {'ingredient_id': '1eb1f77f-2eab-4353-b6d5-ea25eb5a4151', 'quantite': '1'}, {'ingredient_id': '62e153ef-2eab-4216-acba-8f37f2cbe473', 'quantite': '1'}, {'ingredient_id': 'e6175b7b-8057-45bf-b5e9-1db590ed96f2', 'quantite': '15 ml'}, {'ingredient_id': '7395b3ee-f17f-49e9-9055-970d65fd4c49', 'quantite': '1 cuillères'}, {'ingredient_id': '9a735640-0f84-4644-84d5-cf74b6bf8234', 'quantite': ''}, {'ingredient_id': 'e2fefa8f-7764-4eae-8e5e-c74a7d711f11', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (211493, 'Smoothie café-banane', 'café, sucre de canne, banane, vanille, amandes, sirop d''érable, glaçons, menthe', '20 min', ['Sucrer le café chaud et mélanger jusqu''à dissolution complète du sucre.', 'Couvrir et placer 30 min au frais.', 'Peler et couper les bananes en gros morceaux.', 'Réserver quelques rondelles.', 'Fendre la gousse de vanille et retirer les graines avec la pointe d''un couteau.', 'Verser les morceaux de bananes, la vanille, les amandes, le café et le sirop dans le bol du blender et mixer finement.', 'Ajouter les glaçons et mixer à nouveau pour les réduire en morceaux.', 'Verser le smoothie dans 2 verres hauts.', 'Vous pouvez décorer avec les rondelles de bananes restantes et des feuilles de menthe.', 'Régalez-vous !'], ['Ouvre-boîte', 'Pince de cuisine'], ['amandes', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'sirop d''érable', 'facile', 'menthe', 'bon marché', 'rapide', 'plat', 'recette', 'café', 'cuisine', 'recettes', 'boisson', 'sucre de canne', 'vanille', 'dessert', 'plat de résistance', 'glaçons', 'smoothies', 'Smoothie café-banane', 'cocktail'], 'Boisson', 3e511ec7-bbcf-4ad6-8fc8-0d3829fdfc22, '2025-09-26T16:15:56.098362', [{'ingredient_id': 'bcc7b767-da10-436e-b45a-082fa6bdc1a9', 'quantite': '40 cl'}, {'ingredient_id': '71e8bfff-ada1-4dbd-8c47-f405f4a474c6', 'quantite': '1 cuillères'}, {'ingredient_id': 'aa38e87c-e067-4287-9bb4-e49e64ed9616', 'quantite': '2'}, {'ingredient_id': '2618629f-97cf-4a0a-9b9f-00a213f8e3a0', 'quantite': ''}, {'ingredient_id': '3b3c88e1-00bd-43bf-b7d2-138666d99546', 'quantite': '2 cuillères'}, {'ingredient_id': '1b8ad196-71bf-486c-a337-e15cd1be2c8e', 'quantite': '2 cuillères'}, {'ingredient_id': 'c071ce11-5175-4720-bb14-3902d54e00a2', 'quantite': '4'}, {'ingredient_id': '9d537b10-ef6c-4616-b03d-5861b8325857', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (56675, 'Gratin de tiramisu aux fruits', 'mascarpone, oeuf, sucre, banane, pomme, boudoir, fruits', '20 min', ['Garnir le fond du plat avec les speculoos.', 'Ajouter une couche de boudoirs préalablement écrasés.', 'Verser en fin filet un peu de jus de fruit pour mouiller les biscuits.', 'Mélanger les oeufs, le sucre et le mascarpone;', 'Eplucher les fruits et les couper en lamelles.', 'Recouvrir les biscuits avec les fruits.', 'Verser la préparation de mascarpone/oeufs/sucre dans le plat. Mettre au four à 180° pendant 25 mn.', 'Servir!'], ['Louche', 'Couteau de chef'], ['entrée', 'banane', 'recettes de cuisine', 'mascarpone', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'tiramisu', 'boudoir', 'fruits', 'sucre', 'cocktail', 'Gratin de tiramisu aux fruits'], 'Dessert', 9afc337d-44f3-48a6-8294-54cf2cf883a1, '2025-09-26T16:15:59.949891', [{'ingredient_id': 'cc5cf317-6bf4-4f6f-8a44-7169d4e6d627', 'quantite': '250 g'}, {'ingredient_id': 'f60d6d1a-333a-47f1-95a0-dcce95ea6be3', 'quantite': '4'}, {'ingredient_id': 'cb903d04-b6c3-4802-a5f1-128a8354339f', 'quantite': '4 cuillères'}, {'ingredient_id': 'e373d674-cdeb-4219-8960-f05a6302e828', 'quantite': '1'}, {'ingredient_id': 'f4737496-70d7-4d19-9751-d3b2c99a6c83', 'quantite': '1'}, {'ingredient_id': '93d83f7d-4053-40ac-874f-4edbb5a9b487', 'quantite': ''}, {'ingredient_id': '86fd722d-bd1a-4871-97b6-78cf73cc18c5', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (305465, 'Pizza au chocolat et aux fruits', 'pâte à pizza, pâte à tartiner, compote, clémentine, pomme, banane, crème chantilly', '35 min', ['Préchauffer le four à 220°C (th. 7). ', 'Préparer la pâte à pizza et l''étaler dans un moule. ', 'Couvrir le fond d''une couche de compote. ', 'Le mettre au four pendant 15 à 20 min. Sortir la pizza. Laisser-la refroidir. ', 'Improviser des décors avec la pâte au chocolat, les quartiers de la clémentine, les tranches de pomme et les rondelles de banane. ', 'Terminer la pizza en la bordant de crème chantilly.'], ['Poêle', 'Râpe'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'plat', 'recette', 'compote', 'cuisine', 'recettes', 'pâte à pizza', 'boisson', 'crème chantilly', 'clémentine', 'dessert', 'plat de résistance', 'pomme', 'Pizza au chocolat et aux fruits', 'cocktail', 'pâte à tartiner'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:16:05.998553', [{'ingredient_id': '6dfbc6ce-9354-4457-b226-e41095e6389c', 'quantite': '1'}, {'ingredient_id': '8b44edc6-8db0-4e69-86c6-2411418ce3bc', 'quantite': '2 cuillères'}, {'ingredient_id': '8af313e1-b1f5-4246-87a4-8a9db30eab25', 'quantite': '2 cuillères'}, {'ingredient_id': '30f3517b-b3b2-461e-9f88-3acf2ac6ed80', 'quantite': '1'}, {'ingredient_id': '9a90a869-be7a-4830-a620-03206289a6b5', 'quantite': '1'}, {'ingredient_id': 'ca9de2a5-e8d4-4a09-becb-3935bf32df9c', 'quantite': '1'}, {'ingredient_id': 'e870ec54-262c-4533-a98f-2b00d5327d8b', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (37561, 'Tajine de canard aux abricots et à la banane plantain', 'cuisse de canard, abricot, banane plantain, huile d''olive, cumin en poudre, eau, coriandre, menthe, poivre, sel', '15 min', ['Très important:', 'Cette recette se prépare dans une véritable tajine. Une tajine est un plat de cuisson en terre cuite émaillée, venu des pays du moyen- orient et s''achète dans les magasins spécialisés dans les produits du magrebh,pour un prix modique (environ 20 euros pour une tajine de moyenne contenance).', 'Elle s''utilise sur tous types de feu de cuisson et peut être mise au four.', 'Préparation :', 'Ebouillanter pendant 3 min les bananes plantain dans une eau claire afin de faciliter leur pelage.', 'Peler les bananes plantin et les couper en morceaux de 3 à 4 cm d''épaisseur.', 'Mettre la tajine sur feu doux, verser l''huile d''olive et un demi verre d''eau claire. Ajouter les bananes.', 'Enlever les parties de gras, les plus grosses, sur les cuisses de canard. ', 'Au bout de 20 min de cuisson des bananes ajouter les cuisses de canard dans la tajine .', 'Parsemer le tout avec le cumin en poudre, saler et poivrer à votre convenance.', 'Laisser cuire à feu doux durant 15 min.', 'Dénoyauter et couper les abricots en quartiers, les ajouter dans la tajine avec un peu demi verre d''eau.', 'Laisser mijoter le tout durant 45 min sans remuer et en veillant à ce qu''il y ait toujours un jus de cuisson au fond de la tajine.', 'Ce plat est prêt à être déguster lorsque la viande de canard commence à se détacher de l''os et que lorsque vous plantez une lame de couteau dans les bananes, celle-ci s''enfonce comme dans une pomme de terre cuite.', 'Avant de servir, parsemer votre plat avec la coriandre et la menthe, ciselées en lanières', 'Servir ce plat très chaud.'], ['Louche', 'Tire-bouchon', 'Passoire', 'Fouet', 'Mixeur'], ['entrée', 'tajine', 'cumin en poudre', 'recettes de cuisine', 'cuisse de canard', 'sel', 'confiserie', 'eau', 'testées', 'abricot', 'très facile', 'menthe', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Tajine de canard aux abricots et à la banane plantain', 'huile d''olive', 'dessert', 'plat de résistance', 'banane plantain', 'coriandre', 'poivre', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:16:09.696601', [{'ingredient_id': '4ed8a1c8-0b85-4500-abb3-16c9a57f1ba6', 'quantite': '4'}, {'ingredient_id': '0cbeac4b-f772-4973-b1f7-5f754e90aa43', 'quantite': '8'}, {'ingredient_id': 'ab8f58ff-722a-478d-943f-b3dbcd14ac82', 'quantite': '2'}, {'ingredient_id': '03657785-4b62-41e9-bc30-4bbc72087598', 'quantite': '2 cuillères'}, {'ingredient_id': '177e8fb7-3527-4daa-8f5e-8ba2bfb33530', 'quantite': '1 cuillères'}, {'ingredient_id': 'a2d63543-1993-439b-950d-1053c7fdc847', 'quantite': '1'}, {'ingredient_id': '155a6b5b-f691-4f11-80f2-b8c4390b2a17', 'quantite': '2 cuillères'}, {'ingredient_id': '37d2472a-0d0f-42a1-a14c-5d2ec4a774a0', 'quantite': '2'}, {'ingredient_id': 'd9cf39ad-8cf8-48f5-ba18-7cb4601c8b45', 'quantite': ''}, {'ingredient_id': '6beb58e0-eef4-4def-9a2c-8031dbd9901c', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (225662, 'Muffins bananes coco et chocolat', 'farine, sucre, oeuf, lait, beurre, levure, banane, noix de coco, chocolat', '30 min', ['Préchauffer le four à 220°C (thermostat 7-8).', 'Battre l’oeuf avec le sucre.', 'Mélanger la farine et la levure.', 'Ajouter par petites quantités en alternant, la farine et le lait.', 'Ajouter la noix de coco râpée, les bananes et les pépites de chocolat.', 'Verser dans des moules à muffins et enfourner pour 20 minutes de cuisson.'], ['Économe', 'Batteur électrique'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'chocolat', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'muffin', 'beurre', 'Muffins bananes coco et chocolat', 'noix de coco', 'sucre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:16:13.286183', [{'ingredient_id': '18b53869-7698-4aff-838b-6b6148cba604', 'quantite': '175 g'}, {'ingredient_id': '16fbff1c-0423-453a-81a8-7b3adfe00e3d', 'quantite': '100 g'}, {'ingredient_id': '22cbc58b-7054-481c-bfc8-9c206d4ac6dd', 'quantite': '1'}, {'ingredient_id': '846900e2-c291-4991-8a96-1c5aa82f952f', 'quantite': '10 cl'}, {'ingredient_id': 'b42f7adb-3973-4b3a-82e2-5f67f822da56', 'quantite': '50 g'}, {'ingredient_id': '0706f4ba-b1f1-4803-be16-9af101fd8e8b', 'quantite': ''}, {'ingredient_id': 'a01722f2-7653-469d-81ea-74b7990b88d4', 'quantite': '2'}, {'ingredient_id': '3ac851c9-4450-459c-86a2-fc924afee314', 'quantite': '40 g'}, {'ingredient_id': '14d65e64-ad37-4b13-818d-16f12d80cf4a', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (225711, 'Batida banane, coco, kiwi', 'banane, kiwi, lait de coco, sucre de canne, lait de soja, arachide', '10 min', ['Éplucher et couper en morceaux les bananes et les kiwis.', 'Mixer les fruits avec le lait de coco, le lait, le sucre et les cacahuètes. ', 'Vous pouvez ajouter quelques glaçons si vous préférez vos boissons très fraîches.'], ['Couteau de chef', 'Moule à tarte'], ['', 'lait de coco', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'coco', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'arachide', 'recettes', 'boisson', 'sucre de canne', 'dessert', 'plat de résistance', 'lait de soja', 'Batida banane', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:16:18.052651', [{'ingredient_id': '3bfb588d-732f-470e-a07d-2b2607936909', 'quantite': '2'}, {'ingredient_id': 'd5392f19-aff0-43a3-8297-2acf5f42d0d0', 'quantite': '2'}, {'ingredient_id': '219bffc9-2530-4a09-b076-82891aed4586', 'quantite': '20 cl'}, {'ingredient_id': '2ef86364-2dfe-4f09-a643-e5a190d8d206', 'quantite': '2 cuillères'}, {'ingredient_id': '73d04f6f-814e-425f-8d95-426ba38b6ca0', 'quantite': '7 cl'}, {'ingredient_id': '4d8475be-64cc-4620-8d08-339752b127e1', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (51182, 'Tarte gourmande pommes bananes', 'pâte brisée, pomme, banane, oeuf, sucre, sucre vanillé, crème fraîche liquide, lait, farine, extrait de vanille', '20 min', ['Préchauffer le four à 210°C (thermostat 7).', 'Etaler la pâte dans 1 plat à tarte beurré et fariné.', 'Eplucher et couper les fruits en lamelles.', 'Disposer sur la pâte d''abord les bananes puis les pommes.', 'Mettre au four pendant 15 minutes.', 'Pendant ce temps, bien mélanger dans un saladier les oeufs, le sucre, le sucre vanillé, la crème, le lait, la farine et la vanille.', 'Après les 15 minutes de cuisson, réduire la température à 160°C (thermostat 5-6), sortir le plat du four et verser le mélange sur les fruits.', 'Continuer la cuisson environ 30 minutes selon l''aspect que vous voulez pour votre tarte : un peu ou très dorée.'], ['Moule à tarte', 'Verre doseur', 'Louche', 'Économe', 'Batteur électrique'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'extrait de vanille', 'facile', 'bon marché', 'Tarte gourmande pommes bananes', 'oeuf', 'plat', 'tarte aux pommes', 'recette', 'crème fraîche liquide', 'cuisine', 'pâte brisée', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'sucre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:16:23.027681', [{'ingredient_id': '6525438f-2a60-47d6-961f-3f92f6890396', 'quantite': '1'}, {'ingredient_id': 'c9f4b011-ce53-4ae5-a1a7-0fe305e9a25c', 'quantite': '3'}, {'ingredient_id': 'f1a69b3a-de07-4518-8602-5ad65f25f10e', 'quantite': '2'}, {'ingredient_id': '4f3575bc-52d9-4414-9b58-3ed1ee95a450', 'quantite': '3'}, {'ingredient_id': '925c402a-e9e4-430a-9f02-cd3e6d9225b5', 'quantite': '150 g'}, {'ingredient_id': 'fa5eaba4-7bb8-4496-a57a-8b8b0d469a53', 'quantite': '1'}, {'ingredient_id': '5269b3b7-18a9-484e-90b7-14cecd6deff8', 'quantite': '150 g'}, {'ingredient_id': 'c7f7b6ca-bc93-432e-80d6-f6d388dbf727', 'quantite': '15 cl'}, {'ingredient_id': 'fae6f797-385c-4fef-9945-612d9ce6202e', 'quantite': '1 cuillères'}, {'ingredient_id': 'd33d6fc1-6103-42e3-bda8-ba507750e171', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (232190, 'Confiture Rhubarbe Noisettes', 'rhubarbe, banane, cassonade, poudre de noisette', '10 min', ['Couper la rhubarbe et la banane en petits morceaux, ', 'Ajouter la cassonade et la poudre de noisettes.', 'Faire cuire doucement.', 'Servir très chaud dans les pots, fermer et les retourner (attention aux brûlures!)'], ['Couteau de chef', 'Balance de cuisine', 'Presse-agrumes'], ['entrée', 'banane', 'recettes de cuisine', 'confiture de rhubarbe', 'confiserie', 'testées', 'cassonade', 'rhubarbe', 'facile', 'bon marché', 'plat', 'poudre de noisette', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Confiture Rhubarbe Noisettes', 'cocktail'], 'Confiserie', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:16:28.708105', [{'ingredient_id': '2494bf94-e1e1-4ae4-8661-af4f28efb412', 'quantite': '1 kg'}, {'ingredient_id': 'fb658f13-5b45-4a20-821d-013af8ded9de', 'quantite': '1'}, {'ingredient_id': '5bd37733-387b-4d46-8e37-cdc73acdc83b', 'quantite': '500 g'}, {'ingredient_id': '05aabfc2-4a7c-4b5f-9f2f-42fb925d30dd', 'quantite': '120 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (20276, 'Banana Nut Bread', 'farine, sucre, huile, banane, oeuf, levure, sel, noisettes, lait', '15 min', ['Mélanger la farine, la levure et le sel. Mettre de côté. ', 'Ecraser les bananes et mettre de côté. ', 'Préchauffer le four. ', 'Au batteur électrique, mélanger le sucre et l''huile. Ajoutez les oeufs, un par un et battre le mélange pendant une minute. ', 'Ajouter en alternance la farine et la purée de bananes. (Si le mélange obtenu est trop épais, ajouter un peu de lait). Finalement, ajouter les noisettes hachées. ', 'Verser la pâte obtenue dans un moule à cake beurré et fariné. ', 'Cuire à 180°c pendant 60-65 min.'], ['Planche à découper', 'Poêle', 'Passoire'], ['', 'entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'noisettes', 'cuisine', 'levure', 'recettes', 'boisson', 'huile', 'farine', 'Banana Nut Bread', 'dessert', 'plat de résistance', 'sucre', 'lait', 'cocktail'], 'Dessert', 37285895-3375-409d-8813-384bac9ad848, '2025-09-26T16:16:33.576023', [{'ingredient_id': 'd6dfcd10-1fbe-45ab-a24e-1119ce8cdc9e', 'quantite': '300 g'}, {'ingredient_id': '8348dcbf-0dc6-452a-93b2-ddbab0a23728', 'quantite': '200 g'}, {'ingredient_id': 'a9dc2710-9720-49c2-acd4-826fe53068f8', 'quantite': '10 cl'}, {'ingredient_id': 'a69f73bd-9a10-4e71-b0d4-525f04e6df61', 'quantite': '4'}, {'ingredient_id': 'dc1587ed-1432-4891-bda8-13134e21d45a', 'quantite': '2'}, {'ingredient_id': '40e82690-e179-4a44-9c04-11daf5e6b80a', 'quantite': '1'}, {'ingredient_id': '3d30da4f-81ee-4cff-87b6-ad2b106bf661', 'quantite': '1'}, {'ingredient_id': 'c2fda351-acee-4e52-a2cd-cd99c9d407b5', 'quantite': '50 g'}, {'ingredient_id': 'd5e33803-ce4c-40ca-b82d-7be4fd214107', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (12241, 'Fondue au chocolat parfumée à l''Armagnac', 'chocolat noir, crème fraîche, armagnac, ananas, poire, banane, pomme, brioche', '20 min', ['Pelez tous les fruits et coupez-les en gros cubes (ne faites pas cette opération trop tôt : les fruits noirciraient).', 'Dans le poêlon d''un service à fondue, versez la crème fraîche. Allumez et chauffez dans la position la plus basse.', 'Dès que la crème fond, ajoutez le chocolat cassé en petits morceaux. Remuez jusqu''à l''obtention d''un chocolat fondu homogène. Incorporez alors l''armagnac.', 'Chaque convive trempera 1 morceau de fruit dans le chocolat au gré de sa fantaisie et le dégustera avec un morceau de brioche.'], ['Passoire', 'Moule à tarte'], ['', 'brioche', 'armagnac', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'poire', 'facile', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat noir', 'pomme', 'ananas', 'Fondue au chocolat parfumée à l''Armagnac', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:16:37.300194', [{'ingredient_id': 'e98b8d7e-5fd2-47e6-a82b-5ad97856b0d5', 'quantite': '400 g'}, {'ingredient_id': 'ba447b94-5e74-4a96-ac46-40b9f427e09e', 'quantite': '4 cuillères'}, {'ingredient_id': 'b5ed7b3c-c61b-4aab-a391-5c89142c644d', 'quantite': '2 cuillères'}, {'ingredient_id': '73a1b41c-6bca-4deb-80c2-f81884cd6c8d', 'quantite': '1'}, {'ingredient_id': '62a757fd-394b-4b92-bdc4-b1f8a355c636', 'quantite': '2'}, {'ingredient_id': '7871f8fb-addf-4fbb-ade9-94974e40b203', 'quantite': '2'}, {'ingredient_id': '1fc750d6-49e4-4ccd-874b-1aec61eb24d8', 'quantite': '2'}, {'ingredient_id': '287db7b6-74f6-4aa6-912c-3a0f9c932077', 'quantite': '4'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (326529, 'Tarte tatin tutti frutti', 'pâte feuilletée, sucre, abricot, banane, pêche, ananas, beurre', '20 min', ['Mettre de petits morceaux de beurre dans un moule à manquer puis masquer le fond du moule avec le sucre.', 'Mettre votre four à préchauffer à 180°C en position grill haut et bas et mettre votre moule au four tout de suite.', 'Bien surveiller le sucre régulièrement qui va se transformer en caramel (si le caramel est noir c''est foutu !)', 'Pendant ce temps, laver les fruits. ', 'Couper les abricots en 2 oreillons et enlever le noyau. ', 'Éplucher la banane et coupez de larges rondelles. Éplucher les pêches et découper les en fins quartiers. Couper les rondelles d''ananas en 2.', 'Dès que votre caramel est roux, sortir le plat du four. Disposer dans le moule les fruits. ', 'Si vous êtes fan de caramel, saupoudrer les fruits de sucre et placer le rond de pâte au-dessus. ', 'Bien border la pâte au fond du moule et piquer de la pointe d''un couteau ce bord de pâte et 3 à 4 pic sur la pâte du milieu.', 'Faire cuire au four chaleur tournante pendant 35 min. Dès que la pâte a brunie, la tarte est cuite.', 'Sortir le moule du four et laisser reposer 2 min puis retourner la tarte sur une grande assiette.', 'Déguster tiède ou froid.'], ['Mixeur', 'Moule à tarte', 'Balance de cuisine', 'Presse-agrumes', 'Passoire'], ['entrée', 'banane', 'Tarte tatin tutti frutti', 'recettes de cuisine', 'confiserie', 'testées', 'abricot', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'tarte Tatin', 'dessert', 'plat de résistance', 'pâte feuilletée', 'beurre', 'ananas', 'pêche', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:16:43.539081', [{'ingredient_id': '7f4b4f29-d49c-4647-b4cb-d0df83ece64e', 'quantite': '1'}, {'ingredient_id': '8af5f1a3-b94f-481d-921c-dd757bb3254f', 'quantite': '50 g'}, {'ingredient_id': '4b4e779b-581f-4442-bafd-6b926eb9685a', 'quantite': '4'}, {'ingredient_id': 'd3af33b9-8713-4f2b-855c-63110c5f73eb', 'quantite': '1'}, {'ingredient_id': '7437bd5a-30e6-4bb9-a2f3-3f29f5527b4a', 'quantite': '2'}, {'ingredient_id': 'b8ac83c9-38df-4583-b731-8fbaad342816', 'quantite': '1'}, {'ingredient_id': '0ecd61c5-6c9d-4e1c-b89d-12f90277ff58', 'quantite': '5 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (314700, 'Rakabulle de fruits à l''amaretto', 'pomme, banane, clémentine, amaretto, beurre', '10 min', ['La préparation est très très simple, il suffit de commencer par couper les pommes en dés, les bananes en tranches (assez large pour qu''elles ne fondent pas à la cuisson), et de séparer les clémentines en quartier.', 'Ensuite ma technique : je préchauffe une plaque à feu moyen, j''y pose une noisette de beurre et je fais cuire les fruits séparément.', 'D''abord les pommes, une fois qu''elles sont dorées, j''ajoute un fond de verre d''amaretto (pas trop sinon le gout est vraiment fort) et je laisse cuir jusqu''à évaporation complète.', 'Je recommence avec les bananes, puis les clémentines (toujours séparément), faire bien attention avec les clémentines, trop cuites et elles risquent de s''ouvrir !', 'Une fois le tout cuit, il ne reste plus qu''à servir !', 'J''ai choisi ces trois fruits pour des raisons simples :', '- Les pommes cuites à l''amaretto me rappellent les tartes au pommes frangipanes (j''adore)', '- Les bananes parce que ça se marie très bien et que je ne fais pas souvent de dessert sans', '- Les clémentines pour le contraste acidulé/caramélisé, un délice !'], ['Passoire', 'Planche à découper'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'amaretto', 'boisson', 'clémentine', 'dessert', 'Rakabulle de fruits à l''amaretto', 'plat de résistance', 'pomme', 'moyen', 'beurre', 'cocktail'], 'Dessert', f4c15b61-1000-4bf8-abf3-958a04dd293d, '2025-09-26T16:16:47.333507', [{'ingredient_id': '404d55e6-15a8-454c-bb4e-c30935ecb93b', 'quantite': '2'}, {'ingredient_id': '4d46d78e-1a6a-4a86-9df2-6ec9b374d6f8', 'quantite': '2'}, {'ingredient_id': 'b7e0b341-a212-4c5c-aa18-787fa77d58e2', 'quantite': '2'}, {'ingredient_id': 'e9e82056-faf0-48c6-af2a-31f53594cee5', 'quantite': '20 cl'}, {'ingredient_id': '1c56f5cf-cb42-4ba5-b864-9f4ed2f60737', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (41682, 'Salade de fruits façon crumble', 'mangue, banane, framboises, rhum, palets bretons', '15 min', ['Éplucher et couper la mangue en petits morceaux, couper les bananes en rondelles et faire décongeler les framboises si besoin. ', 'Couvrir et mettre le tout dans un saladier. ', 'Verser le rhum par dessus, et réserver au frigo (24 h c''est encore meilleur, les fruits sont bien imprégnés).', 'Le moment venu, répartir dans des verres, saupoudrer des palets ou sablés préalablement émiettés.', 'Déguster !'], ['Casserole', 'Moule à tarte', 'Pince de cuisine', 'Couteau de chef'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'très facile', 'framboises', 'Salade de fruits façon crumble', 'rapide', 'plat', 'mangue', 'recette', 'cuisine', 'recettes', 'boisson', 'palets bretons', 'dessert', 'plat de résistance', 'autres crumbles', 'moyen', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:16:50.989936', [{'ingredient_id': '56a10517-3d4d-484d-95fe-c80b0b0a21e8', 'quantite': '1'}, {'ingredient_id': '86a76613-8b3d-4032-87eb-c6200ac14207', 'quantite': '2'}, {'ingredient_id': 'd6b326e7-a18a-41ad-9dc4-5b649e3aa793', 'quantite': '1'}, {'ingredient_id': '86ad8210-5f8c-4f03-9f05-41cab321e57f', 'quantite': '3 cuillères'}, {'ingredient_id': '55c72b69-1a93-4ffc-a95e-eb8f1d58e5a7', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (72394, 'Bananes caramélisées aux noix', 'banane, noix de pécan, citron, sucre, beurre, cannelle, menthe, glace vanille', '15 min', ['Pelez les bananes, coupez-les en biais en tranches (enlevez les extrémités et faire environ 5 tranches). ', 'Grillez légèrement les noix dans une poêle antiadhésive sans matière grasse (juste assez pour qu''elles soient croustillantes).', 'Réservez.', 'Faites fondre le beurre dans une poêle à feu vif. Faites-y sauter les bananes 3 à 4 min puis disposez-les sur les assiettes à dessert.', 'Versez le sucre dans la poêle, y ajouter une pincée de cannelle avec une cuillère à soupe d''eau. Cuisez jusqu''a caramélisation et versez sur les bananes.', 'Ajoutez une boule de glace vanille et les noix.', 'Décorez avec un brin de menthe et servez sans attendre.'], ['Tire-bouchon', 'Pince de cuisine', 'Mixeur'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'noix de pécan', 'très facile', 'menthe', 'bon marché', 'plat', 'Bananes caramélisées aux noix', 'recette', 'cuisine', 'recettes', 'boisson', 'glace vanille', 'dessert', 'plat de résistance', 'beurre', 'citron', 'cannelle', 'sucre', 'cocktail'], 'Dessert', ed1af694-e1ea-4ddd-8213-be2b77338946, '2025-09-26T16:16:56.801268', [{'ingredient_id': '826e9cb3-6084-4694-bcfd-803599321c46', 'quantite': '4'}, {'ingredient_id': 'cb7d829e-f00a-4fcd-a54e-c125f023627d', 'quantite': '50 g'}, {'ingredient_id': '6ec48590-76a8-4570-a405-f8c9c2d7a728', 'quantite': '1'}, {'ingredient_id': '3167f2e0-4038-45f2-89a5-080aded4a694', 'quantite': '80 g'}, {'ingredient_id': '99f20fa0-d482-4fd7-b351-238dc6d548eb', 'quantite': '20 g'}, {'ingredient_id': 'e87f8dc7-7874-4ecb-a605-265ba2572cd3', 'quantite': ''}, {'ingredient_id': 'e4014553-1a1c-4beb-9c6e-1068e84fbc94', 'quantite': '2'}, {'ingredient_id': 'f4285fe1-b2a8-4baf-9711-ba46313a57b9', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (12247, 'Fondue au chocolat maison', 'chocolat noir, crème liquide, lait, beurre, vanille, brioche, ananas, banane, citron', '15 min', ['Mettre le chocolat dans un caquelon avec le lait. ', 'Chauffer sur feu très doux pour faire fondre le chocolat.', 'Hors feu, incorporer le beurre, puis la crème liquide. ', 'Parfumer de vanille.', 'Tremper les morceaux de fruits préalablement citronnés, et les bouts de brioche dans la sauce au chocolat.'], ['Passoire', 'Pince de cuisine', 'Balance de cuisine', 'Couteau de chef'], ['', 'brioche', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'vanille', 'dessert', 'plat de résistance', 'chocolat noir', 'moyen', 'citron', 'beurre', 'Fondue au chocolat maison', 'ananas', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:17:01.528416', [{'ingredient_id': 'd9f12dee-9bbd-4d5a-9662-2aac80579969', 'quantite': '300 g'}, {'ingredient_id': '621c90c4-7223-4e0f-9872-fe0204cae27e', 'quantite': '10 cl'}, {'ingredient_id': 'ebd2e365-c8f9-41aa-9a98-0853c2844843', 'quantite': '15 cl'}, {'ingredient_id': '22ce47bf-ea9b-451b-a5d4-007bb51964bf', 'quantite': '50 g'}, {'ingredient_id': '88794649-0f32-4103-bf78-0adfcc9f5296', 'quantite': ''}, {'ingredient_id': 'a8d67eab-c34d-4b77-8d3e-30fba762f035', 'quantite': '250 g'}, {'ingredient_id': '833d3833-2bc0-4226-93a4-116f1e51b409', 'quantite': ''}, {'ingredient_id': '74ebe03a-3ef2-46eb-9061-c3c42d2669b5', 'quantite': '3'}, {'ingredient_id': '621b5263-bc8a-4bf0-a651-b4f6e77d8dcd', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (67950, 'Poulet drynou (curry-cannelle)', 'escalope de poulet, lait de coco, crème fraîche, petit piment, carotte, oignon, banane, sel, arachide, sauce worcestershire, cannelle, curry', '40 min', ['Couper les carottes en rondelles et les cuire à la vapeur ou à l''eau.', 'Découper le poulet en petits morceaux. Y ajouter la sauce worcestershire pour que la cannelle et le curry adhèrent mieux. ', 'Saupoudrer de cannelle, curry et de sel (il ne faut pas hésiter !). Réserver.', 'Faire revenir les oignons dans un wok, y ajouter le poulet. Quand il est doré ajouter la crème et les carottes déjà cuites ainsi que les bananes. Laissez mijoter 15 minutes puis ajouter le lait de coco et laisser épaissir un peu en rajoutant du curry si besoin.', 'Servir avec du riz !'], ['Mixeur', 'Spatule', 'Couteau de chef'], ['lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'sel', 'confiserie', 'petit piment', 'testées', 'carotte', 'facile', 'bon marché', 'curry de poulet', 'Poulet drynou (curry-cannelle)', 'plat', 'escalope de poulet', 'sauce worcestershire', 'recette', 'cuisine', 'arachide', 'recettes', 'oignon', 'boisson', 'dessert', 'plat de résistance', 'cannelle', 'curry', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:17:05.346010', [{'ingredient_id': '70bc5451-edf4-4ef4-8dc8-ea324c5f92cc', 'quantite': '6'}, {'ingredient_id': 'b8b88eac-297e-4dee-a547-4450d27d69c0', 'quantite': '50 cl'}, {'ingredient_id': '8126c11f-dea0-4731-b502-371f7d1753e7', 'quantite': '40 cl'}, {'ingredient_id': '85f3bb17-5509-4e20-9380-8f8335c89408', 'quantite': '1'}, {'ingredient_id': 'cef292a6-fd9c-4638-a12b-c305bf521a10', 'quantite': '6'}, {'ingredient_id': '7b2d6152-4d31-4741-9b4a-95cf2e8ebbfe', 'quantite': '2'}, {'ingredient_id': 'd91a4bf0-53de-47c6-be09-596fe6de0927', 'quantite': '5'}, {'ingredient_id': '9986524b-8b74-4f58-b18c-1fcc19585cc2', 'quantite': ''}, {'ingredient_id': '1a4c4756-dfad-4272-913e-99adb2867a14', 'quantite': ''}, {'ingredient_id': '0c59f703-4933-41e5-807f-0050c0a284ad', 'quantite': ''}, {'ingredient_id': 'e6d9b25c-5c06-4490-8400-9ab29405be33', 'quantite': ''}, {'ingredient_id': '269dd88d-4cb0-4743-a193-0d7e54090706', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (17869, 'Mousse à la banane et à l''orange', 'banane, miel, sucre vanillé, citron, orange, fromage blanc, blanc d''oeuf', '10 min', ['Passer au mixeur les bananes épluchées, avec le jus de citron et d''orange, le miel, le sucre vanillé.', 'Ajouter le fromage blanc pour obtenir un mélange homogène.', 'Battre les blancs en neige très ferme. Incorporer doucement. Mettre dans de petit récipient en soulevant la mousse.'], ['Économe', 'Balance de cuisine', 'Rouleau à pâtisserie'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'assez cher', 'très facile', 'rapide', 'plat', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'fromage blanc', 'Mousse à la banane et à l''orange', 'dessert', 'plat de résistance', 'sucre vanillé', 'citron', 'mousse fruits', 'orange', 'blanc d''oeuf', 'cocktail'], 'Dessert', d044ca15-8d89-4367-8742-26586da00289, '2025-09-26T16:17:09.145104', [{'ingredient_id': '3355a768-b039-4a2c-8b53-25eec0cd8f25', 'quantite': '2'}, {'ingredient_id': '73caba95-a0d5-454e-93e7-bbbf6521a0db', 'quantite': '1 cuillères'}, {'ingredient_id': 'da89a042-1e5e-4717-b279-ebb6f1865ab6', 'quantite': '1'}, {'ingredient_id': 'a003b12d-3649-406a-a455-22013d959da5', 'quantite': '1'}, {'ingredient_id': 'fa5f9e39-f7c8-48a6-9b02-3dd6b8523411', 'quantite': '2'}, {'ingredient_id': 'b1307e49-a1f5-4f0b-b06c-1a5b74a2bc1e', 'quantite': '100 g'}, {'ingredient_id': '0d77930a-60f2-44c5-960a-25ab504478a3', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (15831, 'Potage à la banane', 'beurre, curry, farine, crème fraîche, tomates pelées, eau, cube de bouillon, banane, poivre, sel', '10 min', ['Faites un roux brun avec beurre et farine. Ajoutez l''eau, les cubes de bouillon de boeuf, le curry, les bananes coupées en rondelles, ', 'les tomates pelées, le sel et le poivre.', 'Cuisez 10 mn et passez ensuite au mixer (très fort).', 'Versez la crème et servez bien chaud.'], ['Mixeur', 'Louche', 'Rouleau à pâtisserie', 'Passoire', 'Couteau de chef'], ['Potage à la banane', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'sel', 'confiserie', 'eau', 'testées', 'tomates pelées', 'très facile', 'bon marché', 'rapide', 'plat', 'recette', 'cube de bouillon', 'cuisine', 'recettes', 'boisson', 'farine', 'soupe', 'dessert', 'plat de résistance', 'beurre', 'poivre', 'curry', 'cocktail'], 'Entrée', 75f5407e-5d10-4f76-8645-25e2058eddd6, '2025-09-26T16:17:12.771311', [{'ingredient_id': 'd58bc494-7a6a-47d3-b21b-6c8ef772778d', 'quantite': '100 g'}, {'ingredient_id': 'a029a069-6d10-4e5b-b9a5-e13fa2564891', 'quantite': ''}, {'ingredient_id': '07588f74-fb5d-4234-a7cd-e570f423d576', 'quantite': '60 g'}, {'ingredient_id': '1bdb9aa5-556d-4f8f-9fdb-43f813862028', 'quantite': '12.5 cl'}, {'ingredient_id': 'f3d2ce8e-595e-4803-9310-028e2cdaa47f', 'quantite': '1 kg'}, {'ingredient_id': '860dbbeb-af43-4a62-96bb-fd26e9029656', 'quantite': '2 l'}, {'ingredient_id': '1deb57e0-b48e-4c17-be7d-aba7a24930eb', 'quantite': '6'}, {'ingredient_id': '13878406-87c4-4659-a341-bc3c0c0a44b5', 'quantite': '2'}, {'ingredient_id': '5107e58e-d449-4730-84a1-bafaf43a67f8', 'quantite': ''}, {'ingredient_id': 'b44974db-8bd0-4c66-abf3-de351d976a55', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (335799, 'Milkshake mangue et miel', 'mangue, banane, lait entier, miel, glaçons', '15 min', ['Épluchez la mangue, coupez la en deux, ôtez le noyau, puis quadrillez sa chair avec un couteau pointu. ', 'Retournez les deux moitiés de mangue, puis coupez les en formes de cubes. ', 'Réservez en 4 pour la décoration et mettez le reste dans le mixeur. ', 'Pelez la banane et coupez la en rondelles. Réservez 2 tranches pour la décoration, et versez le reste dans le mixeur. ', 'Ajoutez les 3 cuillères à soupe de miel d''acacia dans celui-ci ainsi que les glaçons.', 'Mixez 1 à 2 minutes pour être sur que le mélange soit homogène, versez et le tour est joué !'], ['Rouleau à pâtisserie', 'Moule à tarte'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'lait entier', 'rapide', 'plat', 'mangue', 'recette', 'cuisine', 'miel', 'recettes', 'boisson', 'Milkshake mangue et miel', 'dessert', 'plat de résistance', 'glaçons', 'cocktail'], 'Boisson', 3c8379af-554c-452e-8876-c3a0f712a68a, '2025-09-26T16:17:18.276706', [{'ingredient_id': 'ae300c02-2341-488b-93ab-eb07e5775a7d', 'quantite': '1'}, {'ingredient_id': '01d78f53-d2d7-49ff-9692-f43c8e072ead', 'quantite': '1'}, {'ingredient_id': '28f28ed5-7201-4763-a18c-4d31bcc184f1', 'quantite': '20 cl'}, {'ingredient_id': '0bd3b1ea-a0d4-4188-b460-a03936bc2909', 'quantite': '3 cuillères'}, {'ingredient_id': 'e5923633-bc2f-4180-9dd7-54fc2da7966d', 'quantite': '10'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (166688, 'Charlotte à la banane rapide', 'boudoir, sirop de grenadine, eau, banane, crème fraîche, sucre en poudre', '5 min', ['Dans un saladier, mélangez l''eau et le sirop de grenadine . Trempez ( très rapidement ) les boudoirs dedans et les répartir dans le fond et sur les côtés du moule à charlotte. ', 'Ensuite ,  fouettez la crème fraîche et le sucre dans un mixeur (pour obtenir de la chantilly).Déposez une couche de chantilly sur les boudoirs ', 'Coupez les bananes en rondelles , et les répartir sur la crème fraîche.', 'Répétez l''opération une deuxième fois , puis recouvrir de plusieurs boudoirs, préalablement trempés dans le mélange effectué au début. ', 'Recouvrir la charlotte de son couvercle , puis la laisser refroidir au réfrigérateur plusieurs heures.'], ['Couteau de chef', 'Poêle', 'Louche'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'Charlotte à la banane rapide', 'confiserie', 'eau', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'charlotte aux fruits', 'sirop de grenadine', 'boudoir', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:17:21.984691', [{'ingredient_id': '9e483f92-45d0-443c-bc83-5c613df7091e', 'quantite': '30'}, {'ingredient_id': '56d3deaf-decd-47cb-afb9-24f06e632f59', 'quantite': '3 cuillères'}, {'ingredient_id': 'f7429e64-c4cb-4c99-ba8f-3be5b98756bc', 'quantite': '3'}, {'ingredient_id': '99a7c531-c2aa-42aa-a36c-c3490e1e6e22', 'quantite': '2'}, {'ingredient_id': '6edcc487-612a-47ed-82f6-e8cf1deb8bae', 'quantite': '40 cl'}, {'ingredient_id': 'f77432c1-676a-4583-a2fe-528cb28e84b9', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (22728, 'Cake à la banane et à la vanille (sans beurre, sans huile)', 'yaourt, sucre semoule, sucre vanillé, jaune d''oeuf, vanille, farine, levure chimique, blanc d''oeuf, banane', '25 min', ['Mélanger dans l''ordre tous les ingrédients (exceptés les blancs d''oeufs et les bananes). ', 'Ecraser les bananes à la fourchette et les ajouter à la pâte de façon homogène. ', 'Puis ajouter délicatement les blancs d''oeufs montés en neige. ', 'Mettre la pâte dans un grand moule à cake anti-adhésif. ', 'Faire chauffer au four 45 mn à 175°C . Pas besoin de couvrir normalement. ', 'Sortir le cake quand la pointe du couteau est humide mais pas sèche.'], ['Louche', 'Casserole', 'Balance de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'yaourt', 'Cake à la banane et à la vanille (sans beurre', 'confiserie', 'testées', 'levure chimique', 'très facile', 'bon marché', 'plat', 'jaune d''oeuf', 'recette', 'cuisine', 'recettes', 'sucre semoule', 'boisson', 'sans huile)', 'farine', 'vanille', 'autres cakes', 'dessert', 'plat de résistance', 'sucre vanillé', 'blanc d''oeuf', 'cocktail'], 'Dessert', 17336ff3-ecdb-4d05-9912-34021b6a207e, '2025-09-26T16:17:26.624465', [{'ingredient_id': 'd5bd6afb-914b-4ecf-9c5c-c46a0733414b', 'quantite': '2'}, {'ingredient_id': 'e100bda4-bda9-4385-9e43-ed79c88b9406', 'quantite': '2'}, {'ingredient_id': '359a329c-56d7-4294-a0d0-5e88cf259a41', 'quantite': '1'}, {'ingredient_id': 'f53c7b4e-2f07-4f44-a8f5-49e8efa707c9', 'quantite': '3'}, {'ingredient_id': '3674ce6c-bab3-4ac3-a089-0c5071dfce1d', 'quantite': '1 cuillères'}, {'ingredient_id': '14b28db9-4d39-4421-a4d7-7bd399a818dc', 'quantite': '2'}, {'ingredient_id': '8c4f9fc7-57ab-482b-9976-319697fe8189', 'quantite': '1'}, {'ingredient_id': 'a685cbef-b8a9-4bd8-8dab-6485f3fda7f3', 'quantite': '3'}, {'ingredient_id': '7918c670-edcc-44c3-a4c3-421f3eb09e3d', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (20217, 'Crumble d''automne aux pépites de chocolat', 'chocolat pâtissier, farine, sucre en poudre, beurre, poire, banane, pomme', '20 min', ['Concasser le chocolat en pépites (dans un robot). ', 'Travailler avec les mains dans un saladier, la farine, le sucre, et le beurre afin d''obtenir une pâte sableuse. Y ajouter les pépites de chocolat. ', 'Peler poires et pommes et les couper en petits morceaux, peler les bananes et les couper en rondelles. Etaler ces fruits au fond d''un plat. Recouvrir le tout avec les "miettes" de pâtes pépites de chocolat. ', 'Enfourner Th 6 (200°C ) pendant 30 mn jusqu''à ce que la croûte soit bien dorée....'], ['Râpe', 'Casserole', 'Balance de cuisine', 'Rouleau à pâtisserie', 'Presse-agrumes'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'très facile', 'bon marché', 'plat', 'sucre en poudre', 'recette', 'chocolat pâtissier', 'cuisine', 'recettes', 'boisson', 'farine', 'Crumble d''automne aux pépites de chocolat', 'dessert', 'plat de résistance', 'pomme', 'autres crumbles', 'beurre', 'cocktail'], 'Dessert', 533ab476-37a3-4e48-b603-9251eb5829dc, '2025-09-26T16:17:33.547490', [{'ingredient_id': '5d9715cd-fe94-459e-bfc9-758575a1add4', 'quantite': '270 g'}, {'ingredient_id': 'd06cb5dc-09d4-4019-87a6-5ba6cacafb4a', 'quantite': '270 g'}, {'ingredient_id': '204aa66b-c8b4-45b1-b861-39c03c9d72e8', 'quantite': '150 g'}, {'ingredient_id': 'c8c37752-82db-476a-b85c-03cc8a34e944', 'quantite': '140 g'}, {'ingredient_id': 'e406820b-3ed9-4f6e-954b-13f5f86e66c3', 'quantite': '3'}, {'ingredient_id': 'df7d7dbd-938d-4601-ba5c-11b50c1da8a6', 'quantite': '3'}, {'ingredient_id': '6dbc42e9-77da-4c84-bdb0-6f719281a4de', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (42158, 'Mousse de banane au rhum', 'banane, oeuf, sucre en poudre, sel, rhum', '10 min', ['Eplucher les bananes, et les écraser en purée.', 'Dans une petite casserole, les mélanger avec le sucre et les 3 jaunes d''oeufs (réserver les blancs).', 'Faire chauffer cette casserole au bain-marie, pendant 2 à 3 min, en mélangeant vivement (sans s''arrêter!), jusqu''à ce que le mélange épaississe légèrement. ', 'Retirer aussitôt la préparation, la laisser refroidir un peu, et ajouter le rhum.', 'Ajouter une pincée de sel aux blancs d''oeufs, les monter en neige ferme. Et les incorporer délicatement aux bananes. ', 'Verser la préparation dans des petites coupes, tasses, ou verres individuels.', 'Mettre au frigo, et servir bien frais.'], ['Passoire', 'Poêle'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'sel', 'confiserie', 'testées', 'très facile', 'rapide', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'mousse fruits', 'Mousse de banane au rhum', 'cocktail'], 'Dessert', be48ffa6-246e-4c45-8f1e-b29fc2641231, '2025-09-26T16:17:37.166329', [{'ingredient_id': 'f0888bb2-6abe-45ee-b2d3-cc1bfa90989a', 'quantite': '2'}, {'ingredient_id': 'faac975b-9fd5-4eb3-b963-a1319f1bf4c8', 'quantite': '3'}, {'ingredient_id': 'b9b405df-8bcd-4d59-b471-9180c04fcd3f', 'quantite': '50 g'}, {'ingredient_id': '2b21d27a-0034-40ad-8482-bf2f50aa3cf4', 'quantite': '1'}, {'ingredient_id': '6e7ab90f-8e90-44fc-ba06-853caa84b19d', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (230521, 'Tarte rhubarbe banane chocolat', 'rhubarbe, banane, chocolat noir, pâte feuilletée, oeuf, sucre en poudre, crème liquide, amandes', '30 min', ['Faire blanchir 1 min la rhubarbe épluchée et coupée en petits morceaux dans de l''eau frémissante.', 'L''égoutter.', 'Préchauffer le four à 180°C (thermostat 6).', 'Etaler la pâte feuilletée dans un moule à tarte.', 'Y disposer des rondelles de bananes et la rhubarbe.', 'Concasser le chocolat noir et le parsemer sur les bananes et la rhubarbe.', 'Préparer le mélange oeufs, crème liquide et sucre en poudre. Verser sur les fruits.', 'Enfourner à mi-hauteur pour environ 1 h de cuisson.'], ['Tire-bouchon', 'Casserole', 'Ouvre-boîte'], ['amandes', 'entrée', 'tarte au chocolat', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'rhubarbe', 'facile', 'oeuf', 'plat', 'Tarte rhubarbe banane chocolat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'crème liquide', 'dessert', 'plat de résistance', 'chocolat noir', 'pâte feuilletée', 'moyen', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:17:40.962675', [{'ingredient_id': 'ed65686e-d41a-48db-8713-3c0c3b1cf412', 'quantite': '300 g'}, {'ingredient_id': 'e5010895-f660-42f2-ae67-f8d8b42e875e', 'quantite': '1'}, {'ingredient_id': '4fac8b79-f08f-43ed-b5ad-0fd7ec0f4b70', 'quantite': '100 g'}, {'ingredient_id': '820ad816-97c5-4088-bb77-90844d029c4e', 'quantite': '1'}, {'ingredient_id': 'da3f2297-1699-4ed2-9db6-b6bc16916954', 'quantite': '3'}, {'ingredient_id': '1cbb94ca-9ff2-47be-8733-a2e6e05e5a08', 'quantite': '200 g'}, {'ingredient_id': '4c4ef837-fd54-43b9-b7bb-714973b24666', 'quantite': '25 cl'}, {'ingredient_id': 'dbc9fff8-9ab2-4f25-a7f1-3f641456c5d1', 'quantite': '50 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (304800, 'Escalope à la banane', 'escalope, banane, crème fraîche', '10 min', ['Faire revenir les escalopes dans une poêle pendant 5 minutes puis ajouter les bananes coupées en tranches dans la poêle à la fin de la cuisson. ', 'Mettre à feu doux et laisser les bananes fondre un peu à côté des escalopes. '], ['Fouet', 'Pince de cuisine', 'Poêle'], ['entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'confiserie', 'testées', 'facile', 'bon marché', 'escalope', 'escalopes', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'Escalope à la banane', 'cocktail'], 'Plat principal', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:17:44.683619', [{'ingredient_id': 'e26c6585-2314-40ae-a41d-f92bd8a5bbc6', 'quantite': '4'}, {'ingredient_id': '4f2719d4-c816-4ba0-b020-4b3da286db53', 'quantite': '2'}, {'ingredient_id': '4363c9ed-297f-4175-9b89-2a3eb77f3716', 'quantite': '20 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (218620, 'Barre de céréales bananes et noix de pécan', 'beurre, sucre roux, sirop d''érable, banane, cerneaux de noix de pécan, muesli', '10 min', ['Préchauffer le four à 180° C (thermostat 6). ', 'Beurrer un moule rectangulaire ou tapisser le fond de papier sulfurisé. ', 'Dans une casserole, faites fondre le beurre avec le sucre roux et le sirop d''érable en remuant constamment, jusqu''à l''obtention d''un mélange homogène, puis laisser tiédir.', 'Écraser la bananes et hacher la moitié des noix de pécan. Les ajouter dans une casserole avec le muesli, puis mélanger le tout. Verser la préparation dans le moule et la tasser avec une cuillère.', 'Parsemer du reste de noix, puis les enfoncer délicatement dans la pâte. ', 'Enfourner pour 25 min et laisser refroidir dans le moule. Démouler en glissant une lame de couteau le long du moule, puis découper en 12 barres.', 'Vous pouvez les conserver dans une boîte hermétique 5 jours.'], ['Poêle', 'Louche', 'Casserole'], ['', 'entrée', 'banane', 'Barre de céréales bananes et noix de pécan', 'cerneaux de noix de pécan', 'recettes de cuisine', 'confiserie', 'testées', 'muesli', 'sirop d''érable', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'beurre', 'cocktail', 'sucre roux'], 'Confiserie', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:17:48.565510', [{'ingredient_id': '3e60479d-d9ca-4101-8bd7-66882b865ced', 'quantite': '100 g'}, {'ingredient_id': '4d20eeb9-3b0f-416d-9a91-d6762cc2f871', 'quantite': '100 g'}, {'ingredient_id': '52821543-56b0-487b-9938-39c8c80a7026', 'quantite': '4 cuillères'}, {'ingredient_id': 'e7d6bf4b-781a-4ae9-8261-f9c76c889a19', 'quantite': '1'}, {'ingredient_id': 'f9186d6d-3035-4dee-be76-57db835b254b', 'quantite': '100 g'}, {'ingredient_id': '855a8af2-aca1-4fb4-bbfa-61e929af2894', 'quantite': '350 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (63860, 'Macédoine de fruits à la crême caramélisée', 'banane, pomme, pomme, ananas, kiwi, poire, citron, sucre vanillé, crème fouettée, sucre, cassonade', '15 min', ['Peler et couper les fruits, les mettre dans un plat allant au four. Arroser du jus des 2 citrons, ajouter le sucre vanillé, un peu de sucre cristallisé.', 'Faire préchauffer le four à 180°C (thermostat 6), sur position grill.', 'Pendant ce temps, battre le litre de crème avec un peu de sucre.', 'Verser la crème ainsi battue sur les fruits, couvrir de cassonade, mettre au four.', 'Dès que le sucre se caramélise, retirer le plat du four.', 'Servir directement afin d''avoir le mélange froid des fruits et chaud du caramel.', 'La macédoine peut être préparée la veille, elle sera meilleure.'], ['Louche', 'Économe', 'Râpe', 'Poêle', 'Mixeur'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'cassonade', 'poire', 'très facile', 'bon marché', 'rapide', 'plat', 'crème fouettée', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'pomme', 'citron', 'Macédoine de fruits à la crême caramélisée', 'ananas', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:17:52.744884', [{'ingredient_id': '3aa1764d-f23e-46d3-b591-0a3b1c88ad28', 'quantite': '2'}, {'ingredient_id': 'd78b1c4b-7d1c-4eec-b76f-59594b87c353', 'quantite': '2'}, {'ingredient_id': '8891534d-6281-4134-854c-750a1abd2340', 'quantite': '2'}, {'ingredient_id': '48c68abf-06db-4813-8163-9b4d8ffb0dea', 'quantite': '1'}, {'ingredient_id': '002172e4-94c3-41e2-97fb-26432592d2dc', 'quantite': '4'}, {'ingredient_id': '8b3d3678-84ea-4c1c-987c-74d344977a11', 'quantite': '2'}, {'ingredient_id': 'a9693976-74e5-4925-b572-cfea21987b91', 'quantite': '2'}, {'ingredient_id': '2bcf7c52-97d6-458c-a812-d32e82f6f454', 'quantite': '2'}, {'ingredient_id': 'fe3cce28-4917-424c-ac84-822be0b3a37a', 'quantite': '1 l'}, {'ingredient_id': '6a6b02a6-bcb8-46a7-af99-58d278b95d41', 'quantite': ''}, {'ingredient_id': 'a131b8c1-bef5-4a10-abc3-962290584e70', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (86998, 'Cocktail crème de coco et banane', 'crème de coco, jus de banane, sirop, citron vert', '15 min', ['Dans le fond d''un verre verser 3 cuillères à café de crème de coco.', 'Diluer avec du jus de banane jusqu''a ce que le liquide ait un aspect uniforme. Ajouter un peu de sirop de cassis et quelques gouttes de jus de citron vert. Servir très frais.'], ['Presse-agrumes', 'Casserole', 'Pince de cuisine'], ['', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'rapide', 'plat', 'jus de banane', 'recette', 'cuisine', 'recettes', 'boisson', 'crème de coco', 'Cocktail crème de coco et banane', 'dessert', 'plat de résistance', 'moyen', 'citron vert', 'sirop', 'cocktail'], 'Boisson', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:17:58.140146', [{'ingredient_id': '78834972-b26f-4720-841f-1acfa7facfe1', 'quantite': ''}, {'ingredient_id': '9ac1c78b-f1f9-4166-840a-269ecd66ab66', 'quantite': ''}, {'ingredient_id': '3ba7c9bb-86a7-4fb0-a21f-09927a83caeb', 'quantite': ''}, {'ingredient_id': '03ad3561-8f90-4033-9184-5de11489299c', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (29943, 'Crumble d''automne au chocolat', 'chocolat, farine, beurre, sucre roux, cerneau de noix, poire, banane, ananas, abricot', '20 min', ['Concasser le chocolat en petits morceaux.', 'Travailler avec les mains la farine, le sucre et le beurre ramolli coupé en petits morceaux afin d''obtenir une pâte de texture sableuse. Ajouter les pépites de chocolat et mélanger encore.', 'Peler les poires et l''ananas, couper les en petits dés ainsi que les abricots secs. ', 'Répartir les fruits dans un plat à gratin avec les bananes coupées en rondelles et les noix concassées. Recouvrir avec les miettes de pâte et égaliser la surface.', 'Faire cuire au four thermostat 6/7 (200°C) 30 min environ, jusqu''à ce que la croûte soit bien dorée.'], ['Poêle', 'Économe', 'Mixeur', 'Tire-bouchon', 'Couteau de chef'], ['entrée', 'banane', 'recettes de cuisine', 'cerneau de noix', 'confiserie', 'testées', 'chocolat', 'abricot', 'poire', 'Crumble d''automne au chocolat', 'très facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'autres crumbles', 'beurre', 'ananas', 'cocktail', 'sucre roux'], 'Dessert', e2a1da34-a930-40b1-9634-79ea1fcc5f51, '2025-09-26T16:18:01.907218', [{'ingredient_id': 'de3e781e-b9f6-4cfc-af02-f73fa9ac8e45', 'quantite': '200 g'}, {'ingredient_id': '049cfc44-76ab-4ddf-9b90-bd4ceb6bb902', 'quantite': '200 g'}, {'ingredient_id': '3eb87769-f62e-4b70-b9de-055b36fe9034', 'quantite': '100 g'}, {'ingredient_id': '53debdf7-4338-4ec1-b106-1e8195cbbd7d', 'quantite': '75 g'}, {'ingredient_id': '29313564-dce9-4efd-9c6d-b96756392881', 'quantite': '50 g'}, {'ingredient_id': '46aaef5a-8eec-489a-be00-10ea04b070ee', 'quantite': '2'}, {'ingredient_id': 'da6e0f75-a18c-4cb4-9249-187d4ffd50b2', 'quantite': '2'}, {'ingredient_id': 'e27742cd-e4e4-41a9-9423-803a0e4721d5', 'quantite': ''}, {'ingredient_id': 'efbe27d8-d245-4ff3-bb27-2b822acb4145', 'quantite': '120 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (81172, 'Soupe sucrée aux fruits', 'eau, orange, banane, pomme, melon, fraises, kiwi, citron, pamplemousse, ananas, abricot, sucre', '10 min', ['Epluchez tous les fruits, enlevez les pépins et les noyaux.', 'Coupez tous les fruits en deux. Faire cuire 15 min à la vapeur.', 'Ajoutez dans la cocotte l''eau + le sucre, mélangez tout jusqu''à ce que la soupe soit limpide.', 'Bon appétit!!'], ['Économe', 'Batteur électrique'], ['', 'melon', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'eau', 'testées', 'abricot', 'facile', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'Soupe sucrée aux fruits', 'dessert', 'plat de résistance', 'pamplemousse', 'pomme', 'moyen', 'citron', 'orange', 'ananas', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:18:07.155908', [{'ingredient_id': '89bda526-aa86-44ea-96d0-656fe5dfeaae', 'quantite': '50 cl'}, {'ingredient_id': '358cbec4-34d4-4dea-96be-2fe68589cb4a', 'quantite': '2'}, {'ingredient_id': '52b2d579-2ebc-4ded-ac2d-c578ec39aa4b', 'quantite': '2'}, {'ingredient_id': '0049a5f7-13ff-4763-b7e2-b27f39a3d281', 'quantite': '2'}, {'ingredient_id': '3de3e270-9675-4460-b86a-653933b0d05e', 'quantite': '1'}, {'ingredient_id': '0d137361-b295-4960-8ad3-a88f5ee22779', 'quantite': '1'}, {'ingredient_id': '5fe46350-8905-4ccf-be10-572fd50ac43b', 'quantite': '3'}, {'ingredient_id': '6df96f99-17fc-477c-9869-28cbd86d435e', 'quantite': '1'}, {'ingredient_id': 'd1a38e5c-eece-4316-8e96-85e111c23313', 'quantite': '1'}, {'ingredient_id': '7f1b7871-563c-404c-add6-05eb325cffb2', 'quantite': '1'}, {'ingredient_id': '2612e9f1-8298-4d12-b2eb-b9483d0fdfa9', 'quantite': '2'}, {'ingredient_id': '694e6b03-1735-4140-83f1-abba50dbf92a', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (26093, 'Bananes au barbecue flambées', 'banane, sucre en poudre, rhum', '10 min', ['Laver et couper les bananes en deux dans le sens de la longueur, avec la peau.', 'Faire griller au barbecue pendant 5 min et sucrer. Poser le tout sur un plat.', 'Chauffer du rhum dans une casserole et verser sur les bananes. Flamber et servir.'], ['Verre doseur', 'Planche à découper', 'Balance de cuisine', 'Ouvre-boîte', 'Batteur électrique'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'facile', 'Bananes au barbecue flambées', 'rapide', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'moyen', 'cocktail'], 'Dessert', 91073c31-788a-41a3-a644-461064f47299, '2025-09-26T16:18:10.827803', [{'ingredient_id': '280302b1-82d8-4e58-b61b-ce5a2e117259', 'quantite': '4'}, {'ingredient_id': 'ee78669d-c286-4146-a576-8969008811fe', 'quantite': '80 g'}, {'ingredient_id': '25de137f-3b7e-475c-9638-c9f6c359ba83', 'quantite': '4 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (531253, 'Les Super Méga Giga Glaces Multicolores de Simon Super Lapin', 'joli yaourt, méga miel, belle fraise, belle banane, pimpante confiture d''abricots', '15 min', ['Pour commencer, lave-toi bien les mains.', 'Tout d''abord, vide les 3 yaourts dans le saladier.', 'Mets le miel dans le yaourt et mélange bien.', 'Verse la préparation dans 3 petits bols.', 'Prends ta planche à découper et écrase les fraises avec ta fourchette. Mets dans le 1er bol et mélange bien.', 'Maintenant écrase ta banane et mets-la dans le 2ème bol. Mélange bien avec la préparation au yaourt. ', 'Et le 3ème bol on va y mettre la confiture d''abricot et on mélange bien.', 'On passe aux pots de yaourts. Enfin, verse un peu de chaque bol dans tes pots. Attention ne mélange pas les couches.', 'Après mets les petites cuillères dans les pots, il faut les mettre bien droites.', 'Mets-les au congélateur durant 4 heures.', 'Maintenant on range la table ! Tu peux aussi faire cette recette avec des framboises, du sirop de menthe ou tous tes parfums préférés.', 'Et voilà c''est prêt. Chauffe bien le moule avec tes mains pour démouler.'], ['Balance de cuisine', 'Poêle'], ['belle banane', 'entrée', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'méga miel', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'pimpante confiture d''abricots', 'boisson', 'glace', 'belle fraise', 'dessert', 'plat de résistance', 'Les Super Méga Giga Glaces Multicolores de Simon Super Lapin', 'cocktail', 'joli yaourt'], 'Dessert', 7bc4a021-faf3-4b20-b21c-2b051af290e5, '2025-09-26T16:18:15.497853', [{'ingredient_id': '46821087-6ade-4d07-b02a-f612881bc5f5', 'quantite': '3'}, {'ingredient_id': '9895aae3-2975-4569-a6cf-9b1f529a01b8', 'quantite': '1 cuillères'}, {'ingredient_id': 'd181e75c-b55e-47a0-8c68-a2abcdfbe6b9', 'quantite': '8'}, {'ingredient_id': '9837e4b3-2b25-4da9-8b06-e7ca058c6590', 'quantite': '1'}, {'ingredient_id': '71e740ae-7884-4b50-af9c-5d45cb2c6173', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (32062, 'Gâteau au potimarron et aux bananes', 'potimarron, lait, oeuf, farine, fructose, édulcorant, tahin, banane, huile, levure, bicarbonate, vanille, rhum, crème fraîche', '15 min', ['Faire cuire le potimarron dans le lait jusqu’à ce qu’il s’écrase en purée (environ 20 minutes). Laisser tiédir.', 'Verser la purée de potimarron dans un saladier. Ajouter les bananes épluchées et écrasées. Remuer.', 'Ajouter le tahin et l’huile. Remuer.', 'Ajouter le fructose et l’édulcorant. Remuer.', 'Ajouter la farine, la levure et le bicarbonate. Remuer.', 'Ajouter les œufs. Bien remuer.', 'Ajouter la vanille et le rhum. Remuer.', 'Verser dans un moule à manqué chemisé de papier cuisson', 'Faire cuire 40 minutes minimum à 160°C (thermostat 5/6).', 'Servir nappé de crème fraîche et de sucre en poudre (ou édulcorant en poudre).'], ['Poêle', 'Presse-agrumes', 'Planche à découper'], ['', 'entrée', 'banane', 'recettes de cuisine', 'crème fraîche', 'rhum', 'confiserie', 'testées', 'très facile', 'bon marché', 'Gâteau au potimarron et aux bananes', 'oeuf', 'plat', 'édulcorant', 'recette', 'levure', 'cuisine', 'recettes', 'boisson', 'huile', 'farine', 'vanille', 'dessert', 'plat de résistance', 'tahin', 'potimarron', 'lait', 'fructose', 'cocktail', 'bicarbonate'], 'Dessert', b70c42b4-ac2d-43f9-97be-9f09de598f36, '2025-09-26T16:18:19.112015', [{'ingredient_id': '9ace8986-6de4-4702-a2de-cebbbc9dc8db', 'quantite': '500 g'}, {'ingredient_id': '3c7893aa-2e80-450a-9275-260dce5d24f6', 'quantite': ''}, {'ingredient_id': 'cc5f4834-491d-4a93-a9d5-79659679b9c4', 'quantite': '2'}, {'ingredient_id': '9170d92b-42d8-4327-b72f-f5c2605300d7', 'quantite': '150 g'}, {'ingredient_id': '0b750cec-c1ea-4caa-a3a8-680b0b779696', 'quantite': '100 g'}, {'ingredient_id': '347edce4-d5b5-4869-8c07-d77a997d4ce2', 'quantite': '1 cuillères'}, {'ingredient_id': '3f70532a-4071-4f00-aa30-5f53ea7fc709', 'quantite': '1 cuillères'}, {'ingredient_id': '62977a26-957d-447d-a0af-d35ea54408cc', 'quantite': '2'}, {'ingredient_id': '349726e7-c081-4bb9-90fc-b91112ca31f2', 'quantite': '1 cuillères'}, {'ingredient_id': 'a40c2104-c3a4-47e8-8620-28261d7fe588', 'quantite': '1'}, {'ingredient_id': 'c2097480-3755-42a8-a96a-44731808fd17', 'quantite': '1 cuillères'}, {'ingredient_id': '00d7e012-add6-4a3d-9b52-1853b7a2bde4', 'quantite': ''}, {'ingredient_id': 'e25993ee-40f7-4a20-b086-7b6344a7e2c3', 'quantite': ''}, {'ingredient_id': 'd762c97a-e42a-4fb7-b082-4d26448f7af6', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (56539, 'Gambas aux bananes', 'gambas, banane, rhum, crème fraîche liquide, citron vert, beurre, poivre, sel, gingembre', '15 min', ['Couper la banane en dés.', 'Les faire dorer dans une poêle à feu doux et les réserver.', 'Râper le zeste de citron puis le presser pour en extraire son jus.', 'Dans la meme poêle, saisir les crevettes jusq''à ce qu''elles changent de couleur (elles deviennent roses !).', 'Remettre les bananes, saler, poivrer et ajouter la crème.', 'Verser le rhum, mélanger délicatement quelques minutes.', 'Servir chaud avec du riz blanc.'], ['Tire-bouchon', 'Fouet'], ['gingembre', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'sel', 'confiserie', 'testées', 'facile', 'Gambas aux bananes', 'gambas', 'rapide', 'plat', 'recette', 'crème fraîche liquide', 'cuisine', 'recettes', 'boisson', 'dessert', 'crevettes', 'plat de résistance', 'moyen', 'beurre', 'citron vert', 'poivre', 'cocktail'], 'Plat principal', 6f00ba44-120c-4ac0-8cad-7cf24ff13174, '2025-09-26T16:18:22.781562', [{'ingredient_id': '1bc910eb-2c81-453e-9cba-56656df62171', 'quantite': '20'}, {'ingredient_id': '00298535-6478-45b8-ba3e-7bc5b05f3de0', 'quantite': '2'}, {'ingredient_id': 'ca908464-b1f0-4050-b8e0-119276f2dffb', 'quantite': '1 cuillères'}, {'ingredient_id': '0b464416-57fa-43c1-aefd-3b1084e7fa51', 'quantite': '10 cl'}, {'ingredient_id': '2a5d4825-8ddb-406c-a8bc-35a188297ce8', 'quantite': '1'}, {'ingredient_id': 'cf0b4a21-31bd-4045-8715-28966f7895b4', 'quantite': ''}, {'ingredient_id': 'e1376ed1-8bdd-4472-9f04-b04a70697115', 'quantite': ''}, {'ingredient_id': '5a45ec6a-1e1f-40bc-a4df-ab87d5452877', 'quantite': ''}, {'ingredient_id': 'b7e1ac70-9aab-4ad3-838e-5c13e9cf11ea', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (314996, 'Verrine de fruits à la chantilly', 'fraises, kiwi, banane, crème chantilly, pain d''épices, salade, sirop, pralin', '30 min', ['Dans un verre bien large (pour faire office de verrine). ', 'Dans le fond, mettre des morceaux de pain d''épice artisanal au sucre. ', 'Recouvrir avec une couche de morceaux de banane, puis une couche de dés de kiwi, puis une couche de fraises coupées. ', 'Renverser dans chaque verrine une partie de salade de fruits de fruits exotique. On laisse au frigo 15 minutes le temps que le pain d''épices ramollisse un peu. ', 'A la dernière minute, on ajoute la chantilly, puis du sirop fondant par dessus, et enfin des éclats de pralin doré haché (noisettes).'], ['Pince de cuisine', 'Économe', 'Spatule', 'Presse-agrumes'], ['', 'entrée', 'banane', 'kiwi', 'pain d''épices', 'salade', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'crème chantilly', 'pralin', 'dessert', 'plat de résistance', 'Verrine de fruits à la chantilly', 'sirop', 'cocktail'], 'Dessert', df2b9385-a29a-41c4-afd9-60551aa33fa9, '2025-09-26T16:18:27.293562', [{'ingredient_id': 'e0ceba2a-fbcf-4cbc-810d-88ca7a485092', 'quantite': '1'}, {'ingredient_id': '2225f66b-1821-4cc0-9e48-4039f42c30d6', 'quantite': '1'}, {'ingredient_id': 'adaa095e-0f0b-46c0-8f67-4637456252ca', 'quantite': '1'}, {'ingredient_id': '19480d97-9dc4-440a-a72a-08c9fdc7d2c5', 'quantite': ''}, {'ingredient_id': '4a7ca859-8ede-44e5-a8f3-2a18e6e8532d', 'quantite': ''}, {'ingredient_id': '69cb0953-7260-4af5-b063-b4b79af2901a', 'quantite': '1'}, {'ingredient_id': 'f0083456-f55e-412a-8f58-45f12d5d472f', 'quantite': '1'}, {'ingredient_id': '9efd4757-e3d3-4118-8e5b-db8d0db91241', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (169148, 'Petits gâteaux individuels à la banane', 'oeuf, sucre, farine, levure, beurre, banane', '10 min', ['Battez les oeufs et le sucre jusqu''a ce que le melange mousse.', 'Puis ajoutez la farine et la levure. Melangez bien pour que l''appareil soit lisse.', 'Ajoutez le beurre fondu et legerement refroidi.', 'Integrez les bananes que vous avez prealablement ecrasees a la fourchette.', 'J''utilise des moules individuels en silicone, mais vous pouvez mettre votre appareil dans un moule a manque beurre par exemple.', 'Mettre au four a 180C pour 15 min environ. Verifiez la cuisson avec un couteau, la lame doit ressortir seche. Attention de ne pas trop faire cuire, au risque que les gateaux soient trop secs.', 'Bon appetit !'], ['Poêle', 'Pince de cuisine', 'Balance de cuisine', 'Moule à tarte', 'Planche à découper'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'autres biscuits et petits gâteaux', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'Petits gâteaux individuels à la banane', 'beurre', 'sucre', 'cocktail'], 'Dessert', ba86e51a-f828-4ed3-984c-0b39b167e5e5, '2025-09-26T16:18:30.742439', [{'ingredient_id': 'ea3b4937-88fb-44ae-8cd4-abdee5e0910b', 'quantite': '3'}, {'ingredient_id': '74028599-d76d-4f18-b448-5944b10959c1', 'quantite': '150 g'}, {'ingredient_id': '37e73a4d-bdeb-4dd0-8fbd-ba05835f7f0b', 'quantite': '150 g'}, {'ingredient_id': '690458c1-8b55-4d5c-ad9b-1d0e73a47535', 'quantite': '1'}, {'ingredient_id': '45ec1c11-e02b-423e-baf7-49c6ac3c05a3', 'quantite': '150 g'}, {'ingredient_id': '56ca6a28-9673-4ef1-9624-34f898f2938a', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (16246, 'Alloco (Côte d''Ivoire)', 'banane plantain, huile, gingembre, sel', '15 min', ['Eplucher les bananes. Trancher les bananes épluchées en petits morceaux. Les parsemer de gingembre tout en remuant.', 'Chauffer l''huile dans une poêle. Y faire frire les tranches de bananes jusqu''à ce qu''elles soient dorées.', 'Les égoutter sur du papier absorbant et les saler au goût.'], ['Fouet', 'Spatule', 'Louche', 'Pince de cuisine', 'Moule à tarte'], ['gingembre', 'entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'Alloco (Côte d''Ivoire)', 'rapide', 'plat', 'frites', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'dessert', 'plat de résistance', 'banane plantain', 'moyen', 'cocktail'], 'Accompagnement', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:18:34.410756', [{'ingredient_id': '6e0e3063-b1ad-492f-81a0-2052f28714b7', 'quantite': '5'}, {'ingredient_id': '27ce9817-ce4d-4f49-90d1-a40b58ed9595', 'quantite': '40 cl'}, {'ingredient_id': 'ff6a1bb1-1317-4b0b-bd24-3cf8aff237fc', 'quantite': ''}, {'ingredient_id': '71038e5f-c0ec-4f81-8b06-80fe55ad1ef5', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (44719, 'Tarte crumble choco - bananes', 'pâte feuilletée, Nutella, oeuf, lait, sucre roux, rhum, farine, sucre, beurre, chocolat, banane', '20 min', ['1) Sur la pâte feulletée, étaler sufisamment de nutella pour recouvrir la pâte.', '2) Préparer le crumble : mélanger la farine, le sucre, le beurre et le chocolat, et mixer.', '3) Fouetter les oeufs, le sucre roux, le lait et le rhum.', '4) Disposer ce mélange sur la pâte feuilletée.', '5) Couper des rondelles de bananes, et les disposer sur la tarte.', '6) Enfourner à 180°C (th 6) pendant 8 min environ.', '7) Sortir le plat du four, et disposer le "crumble" par dessus.', '8) Remettre au four pendant 15 min.', '9) Déguster froid.'], ['Couteau de chef', 'Tire-bouchon', 'Verre doseur'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'chocolat', 'facile', 'rapide', 'oeuf', 'plat', 'tarte à la banane', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'Nutella', 'dessert', 'plat de résistance', 'pâte feuilletée', 'moyen', 'beurre', 'Tarte crumble choco - bananes', 'lait', 'sucre', 'cocktail', 'sucre roux'], 'Dessert', b173ef79-0e43-41d3-b721-a1cf72a492c6, '2025-09-26T16:18:38.067772', [{'ingredient_id': 'be714eb3-daf7-4b24-ad76-5ef257acadd4', 'quantite': '1'}, {'ingredient_id': 'b3b9ba4d-3472-48d3-8e70-d5fe82a0b116', 'quantite': ''}, {'ingredient_id': 'c14e6abc-1cd7-4d19-b63c-f8a4155d165c', 'quantite': '2'}, {'ingredient_id': 'e919bb7e-5e65-4cef-be1f-6becca235585', 'quantite': '1'}, {'ingredient_id': '72d2cf54-11cc-42d2-a9c0-f2e8b702965d', 'quantite': '50 g'}, {'ingredient_id': 'e783662d-da3f-42c1-b1c1-2b798194a519', 'quantite': '1'}, {'ingredient_id': 'f9a3af86-a405-454d-a99b-5abba137bd32', 'quantite': '100 g'}, {'ingredient_id': '9f34094f-ddcd-462b-a98a-d1f76133e70c', 'quantite': '70 g'}, {'ingredient_id': '981cd004-9425-49df-831f-d80b5c798c66', 'quantite': '50 g'}, {'ingredient_id': '0cf283e9-f59a-4891-870c-98dc12bfe02e', 'quantite': '50 g'}, {'ingredient_id': 'ae1b5241-df24-4dd8-92d9-496adfe88f1b', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (335643, 'Cake bananes et speculoos', 'banane, spéculoos, cassonade, beurre tendre, oeuf, farine, orange, extrait de vanille', '20 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Émietter les spéculoos grossièrement et les mélanger avec les bananes écrasées.', 'Ajouter le beurre et le sucre, mélanger.', 'Ajouter l''extrait de vanille et les oeufs battus, mélanger.', 'Incorporer la farine à la maryse.', 'Ajouter le jus d''une orange et mélanger à nouveau à la maryse.', 'Remplir un moule à cake en silicone et enfourner pour +/- 50 minutes(selon le four), vérifier la cuisson avec la lame d''un couteau, elle doit ressortir sèche.', 'Démouler le cake quand il est tiède.', 'Déguster tiède ou à température ambiante.'], ['Ouvre-boîte', 'Planche à découper', 'Louche', 'Casserole', 'Pince de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'beurre tendre', 'cassonade', 'extrait de vanille', 'facile', 'bon marché', 'oeuf', 'plat', 'recette', 'spéculoos', 'cuisine', 'recettes', 'boisson', 'farine', 'autres cakes', 'dessert', 'plat de résistance', 'orange', 'cocktail', 'Cake bananes et speculoos'], 'Dessert', a0d91eac-0e7e-4057-a993-8c6a565f18f1, '2025-09-26T16:18:41.550634', [{'ingredient_id': 'dd37c725-6058-487b-8fb1-e751ccc849b4', 'quantite': '4'}, {'ingredient_id': 'd4bbf955-7de4-4710-a103-149974115bd0', 'quantite': '120 g'}, {'ingredient_id': 'f48083ce-11a0-4e99-8701-877f55669297', 'quantite': '100 g'}, {'ingredient_id': '66b12817-72f3-4120-a1c3-69c750743807', 'quantite': '100 g'}, {'ingredient_id': '70eeabbc-d43a-4151-902c-08fc5f91ce8d', 'quantite': '2'}, {'ingredient_id': 'beebeb49-6818-4e3c-b581-50b581a98ca9', 'quantite': '225 g'}, {'ingredient_id': '34c58970-8075-414e-a31c-ea5767e27d0a', 'quantite': '1'}, {'ingredient_id': '600d3baf-fc33-45a5-ae58-b633ba088c58', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (55579, 'Bananes au chocolat et coco', 'banane, copeaux de chocolat, noix de coco rapée, beurre, sucre vanillé', '5 min', ['Dans une poêle, faites fondre le beurre.', 'Ajouter votre banane pelée et coupée en rondelles.', 'Ajouter votre sachet de sucre vanillé.', 'Mettre dans une assiette à dessert.', 'Saupoudrer aussitôt de chocolat râpé et de coco râpé.', 'Déguster chaud !', 'nb : pour ma fille, je rajoute aussi des pépites de toutes les couleurs! c''est festif!'], ['Râpe', 'Batteur électrique', 'Rouleau à pâtisserie', 'Spatule'], ['', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'rapide', 'plat', 'Bananes au chocolat et coco', 'recette', 'cuisine', 'recettes', 'boisson', 'noix de coco rapée', 'dessert', 'plat de résistance', 'sucre vanillé', 'beurre', 'copeaux de chocolat', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:18:45.304939', [{'ingredient_id': '93a37c27-3e7e-4f4b-9150-af262a316981', 'quantite': '1'}, {'ingredient_id': '49faeae1-cfd3-477b-9784-248829da1deb', 'quantite': ''}, {'ingredient_id': '7bbcb57a-a475-4f58-9134-635414dcbed9', 'quantite': ''}, {'ingredient_id': '841ab1e9-e7f4-4f7a-a0b5-0cded79ff456', 'quantite': '1 cuillères'}, {'ingredient_id': '78303416-2da6-4b62-8b51-95cfcd1a57d3', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (72164, 'Salade de fruits épicée', 'orange, nectarine, kiwi, banane, poire, sucre, cannelle, clou de girofle', '15 min', ['Pressez les trois oranges, puis faites chauffer le jus en ajoutant la cannelle et le clou de girofle. Laissez bouillir une minute puis laissez refroidir.', 'Dans un saladier, coupez les 2 nectarines (ou les pêches), les 2 kiwis, la banane et la poire en cubes.', 'Versez le jus d''orange épicé refroidi sur les fruits puis ajoutez le sucre.', 'Laissez au frais au moins 1 heure.'], ['Rouleau à pâtisserie', 'Mixeur', 'Pince de cuisine', 'Économe', 'Presse-agrumes'], ['', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'confiserie', 'testées', 'poire', 'très facile', 'nectarine', 'bon marché', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'clou de girofle', 'dessert', 'plat de résistance', 'orange', 'cannelle', 'Salade de fruits épicée', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:18:48.976142', [{'ingredient_id': '1bd7b012-966e-4ecb-b884-aaaa7477544b', 'quantite': '3'}, {'ingredient_id': '60ffb667-3851-46eb-8c5a-c452ecf20c2b', 'quantite': '2'}, {'ingredient_id': 'daf5dec6-5c70-4691-a2ea-7df68ae802a7', 'quantite': '2'}, {'ingredient_id': '7540f330-4d1b-4860-86c5-d679f4dbc33c', 'quantite': '1'}, {'ingredient_id': '92891bee-0a0e-4ac5-a5f4-f7fcee181e9d', 'quantite': '1'}, {'ingredient_id': '7c6eb172-5ea4-47d2-9313-de84dedeed3b', 'quantite': '2 cuillères'}, {'ingredient_id': '24e791e1-efb1-463e-9261-cf6aa76c8379', 'quantite': ''}, {'ingredient_id': 'e7573a32-c124-40b2-ae0a-7f1077fa73bf', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (81548, 'Clafoutis pommes bananes framboises', 'farine, sucre, oeuf, sucre vanillé, lait, beurre, pomme, banane, framboises', '10 min', ['Mélangez la farine, le sucre, les oeufs cassés un à un, le sucre vanillé, et délayez avec le lait tiède.', 'Epluchez les pommes et la banane, et coupez-les en lamelles.', 'Disposez tous les fruits dans un plat beurré. Versez la pâte sur les fruits et faites cuire 30 minutes environ dans un four préchauffé à 220°C (thermostat 7).', 'Servez tiède ou froid.'], ['Balance de cuisine', 'Batteur électrique', 'Fouet', 'Râpe', 'Rouleau à pâtisserie'], ['Clafoutis pommes bananes framboises', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'framboises', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'sucre vanillé', 'clafoutis', 'pomme', 'beurre', 'sucre', 'lait', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:18:52.732715', [{'ingredient_id': '4a9db8b0-34b0-421f-a65d-59394ce25ed3', 'quantite': '90 g'}, {'ingredient_id': 'd59c935e-69e3-4d4c-9a8f-4cd328c3d697', 'quantite': '100 g'}, {'ingredient_id': 'fab8ceb3-b83b-4493-88bd-cda1ed599f24', 'quantite': '2'}, {'ingredient_id': '754fc643-edf8-46ec-845e-f45c976148ac', 'quantite': '1'}, {'ingredient_id': 'd9785024-c960-44a6-b91a-521310030287', 'quantite': ''}, {'ingredient_id': 'dd4d9b12-8f9f-40f8-a5a7-ffa37c2f1fd0', 'quantite': '10 g'}, {'ingredient_id': '61c672a3-24d5-42b6-8375-9b00df32fbf3', 'quantite': '2'}, {'ingredient_id': '80dda272-9f8c-4958-9979-801221475399', 'quantite': '1'}, {'ingredient_id': '94aaf2a1-8e71-4d02-9e25-7d8f1aa07c7a', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (224203, 'Green smoothie / smoothie vert vitaminé', 'carotte, concombre, pomme, poire, banane, chou', '5 min', ['Éplucher les fruits et légumes, coupez-les en morceaux pas trop gros, puis passez le tout au blender, à la centrifugeuse ou à l''extracteur (selon le matériel dont vous disposez).', '(Très spectaculaire avec une variété de carotte rouge !)'], ['Batteur électrique', 'Pince de cuisine', 'Balance de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'carotte', 'chou', 'poire', 'très facile', 'bon marché', 'Green smoothie / smoothie vert vitaminé', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'concombre', 'smoothies', 'cocktail'], 'Boisson', 75f5407e-5d10-4f76-8645-25e2058eddd6, '2025-09-26T16:18:58.968499', [{'ingredient_id': 'a1019100-ab95-4c91-bcf9-e5c0ae542ece', 'quantite': '1'}, {'ingredient_id': 'acdc7ac0-f4a7-46e9-ae7e-03400cdf282c', 'quantite': ''}, {'ingredient_id': 'd144e18b-aa9f-4084-8e0c-2f9200c34cd0', 'quantite': '2'}, {'ingredient_id': '0b58769b-f9f5-41df-b00f-7ecd44002f71', 'quantite': '1'}, {'ingredient_id': '3da32f45-21c7-47af-b50e-f082f58a55e7', 'quantite': '1'}, {'ingredient_id': '2b8ef4af-af09-4c7f-b4de-35a884fa3a82', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (61382, 'Gâteau chocolat banane très bio', 'banane, yaourt, huile, farine, sucre, levure, oeuf, vermicelles en chocolat', '15 min', ['Préchauffer le four à 180°C (thermostat 6).', 'Dans un saladier, mélanger les oeufs, le yaourt, la levure, l''huile, le sucre et la farine. Puis y incorporer les pépites de chocolat et 2 bananes coupées en fines rondelles.', 'Huiler un moule avant d''y déposer la préparation.', 'Couper la 3ème banane en rondelles et les déposer sur le dessus du gâteau, avant de mettre au four pendant environ 30 min.'], ['Mixeur', 'Casserole', 'Rouleau à pâtisserie', 'Moule à tarte', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'yaourt', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'Gâteau chocolat banane très bio', 'cuisine', 'levure', 'recettes', 'boisson', 'huile', 'farine', 'vermicelles en chocolat', 'dessert', 'plat de résistance', 'gâteau au chocolat', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:19:02.829071', [{'ingredient_id': '18c6c52d-3a70-4f81-a5b7-7f3e98c4437c', 'quantite': '3'}, {'ingredient_id': 'db7ae192-028b-40c5-80cd-d0c0172334dd', 'quantite': '1'}, {'ingredient_id': 'f5f81bdd-c3eb-47e1-bbab-0c19832d1b6b', 'quantite': '1'}, {'ingredient_id': 'b6a50892-6d52-44fc-a9bf-76e05fc79a33', 'quantite': '3'}, {'ingredient_id': 'da8964a1-db70-4aa7-b57c-96931a3aace9', 'quantite': '2 cuillères'}, {'ingredient_id': '067bf68d-ac75-40f0-a05e-b3700fe0a02c', 'quantite': '1'}, {'ingredient_id': '802027de-48c1-46c1-8ba7-10a7f1739408', 'quantite': '2'}, {'ingredient_id': '358ad001-533b-4b5e-8b56-9a66688402f3', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (530550, 'Bananes glacées au chocolat', 'banane, chocolat noir, noisettes', '5 min', ['Peler la banane et la couper en morceaux.', 'Faire fondre le chocolat au micro-ondes.', 'Piquer les bananes sur un bâtonnet ou un pic en bois et les tremper dans le chocolat fondu. Saupoudrer de noisettes ou cacahuètes concassées.', 'Placer les bananes sur une assiette recouverte de papier sulfurisé et mettre au congélateur pendant 1h.'], ['Batteur électrique', 'Louche', 'Moule à tarte', 'Rouleau à pâtisserie', 'Ouvre-boîte'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'facile', 'bon marché', 'rapide', 'plat', 'Bananes glacées au chocolat', 'recette', 'noisettes', 'cuisine', 'dessert glacé', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'chocolat noir', 'cocktail'], 'Dessert', ca89aa5c-a556-449c-85b9-5edf2311d6a7, '2025-09-26T16:19:07.847726', [{'ingredient_id': '91a04ae2-7f7c-4426-845a-b675e1c0fbfe', 'quantite': '1'}, {'ingredient_id': '7a980c4c-bc6e-4ce2-a045-2edee1e61e89', 'quantite': '30 g'}, {'ingredient_id': '91d5f5ff-1897-4f83-ae39-67e9483a040f', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (336209, 'Salade de fruits peps', 'ananas, raisin, fraises, myrtilles, framboises, mangue, banane, kiwi, pomelo chinois, pomme, citron, cassonade', '30 min', ['Recette à faire en deux temps :', 'Peler l''ananas et découper la chair en dés moyens. Couper les fraises en deux. Rincer les myrtilles (pas les framboises, l''eau les abîme). Peler et découper la mangue en petits dés. Peler et découper les kiwis en demi-rondelles. Peler à vif le pomelos, et découper la chair en demi-quartiers. Egrapper le raisin. Réserver tous les ingrédient au frais, séparément.', 'Juste avant de servir :', 'Peler et découper la pomme-poire en petits dés. Découper les bananes en rondelles. Mettre tous les fruits dans un grand saladier, mouiller avec le jus du citron et saupoudrer de cassonade (pas trop).'], ['Pince de cuisine', 'Planche à découper', 'Mixeur', 'Rouleau à pâtisserie'], ['', 'pomelo chinois', 'raisin', 'entrée', 'banane', 'kiwi', 'recettes de cuisine', 'Salade de fruits peps', 'confiserie', 'testées', 'cassonade', 'facile', 'framboises', 'rapide', 'plat', 'myrtilles', 'mangue', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'moyen', 'citron', 'ananas', 'cocktail'], 'Dessert', 9cedf2ef-0071-4b41-a24e-e1f7a43e550c, '2025-09-26T16:19:13.735916', [{'ingredient_id': '8d9b2b2f-a4a5-4882-9a92-136222c7e452', 'quantite': '1'}, {'ingredient_id': '3744c17f-e9e6-491c-94df-75c62a321e26', 'quantite': '1'}, {'ingredient_id': '5e7d2ce7-e747-48e5-abaf-a42a9cde7941', 'quantite': '250 g'}, {'ingredient_id': '26ccdb51-9f93-452a-88b9-d89fb75c6199', 'quantite': '125 g'}, {'ingredient_id': '0e477a53-399b-4f98-81da-e755c2db0e3c', 'quantite': '125 g'}, {'ingredient_id': 'b002369d-9377-492e-ad48-9ecd6a93f492', 'quantite': '1'}, {'ingredient_id': 'e9b467e3-0f81-418d-a2b8-5db1d6770d6d', 'quantite': '2'}, {'ingredient_id': '83e01618-6b84-4414-8639-db11ac2d2e8a', 'quantite': '2'}, {'ingredient_id': '41c7529b-46b2-4cff-be4c-18e7807ebb2a', 'quantite': '1'}, {'ingredient_id': 'c87d3cf7-2f22-45cb-9854-857b762e3662', 'quantite': '1'}, {'ingredient_id': 'd9137e30-3e9e-4c30-a251-cd5008f9a828', 'quantite': '1'}, {'ingredient_id': '18670ae1-f67e-4d3b-bed0-3fd34b72d09a', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (392165, 'Crumble pommes bananes simple', 'banane, pomme, sucre, farine, poudre de noisette, beurre, cannelle', '15 min', ['Découper les pommes en dés et les bananes en rondelles et les placer dans un plat. Saupoudrer de cannelle.', 'Dans un saladier, mélanger à l''aide de vos doigts la farine, la poudre de noisette, le sucre et le beurre jusqu''à obtenir une pâte à crumble.', 'Saupoudrer les fruits de cette pâte.', 'Enfourner à 200°C pendant environ 25 minutes.', 'Vous pouvez déguster le crumble tiède avec une boule de glace vanille.'], ['Pince de cuisine', 'Casserole', 'Tire-bouchon'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'plat', 'poudre de noisette', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'Crumble pommes bananes simple', 'pomme', 'beurre', 'cannelle', 'sucre', 'crumble', 'cocktail'], 'Dessert', 894ebc40-7960-4398-83e4-ab7aa4c6e317, '2025-09-26T16:19:17.350747', [{'ingredient_id': '20f69b2a-9e88-40de-9c2e-0b6cd704d835', 'quantite': '2'}, {'ingredient_id': '4692a970-c480-41c9-bada-dacc864203d2', 'quantite': '2'}, {'ingredient_id': '0a68beda-803c-43aa-829f-5feb6c1652d0', 'quantite': '65 g'}, {'ingredient_id': '3ae70bda-58df-412b-ad5a-c291d4322e63', 'quantite': '100 g'}, {'ingredient_id': '8ed3b5ce-4398-4736-b6cd-eab2984e20a9', 'quantite': '30 g'}, {'ingredient_id': '3f0a221f-50df-423d-b9e3-b14482555d05', 'quantite': '80 g'}, {'ingredient_id': '538b98f3-3adf-4e6c-8d91-cd0d639a8146', 'quantite': '1 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (340407, 'Tarte poire banane mi-chocolat, mi nutella', 'pâte feuilletée, banane, poire, chocolat noir, Nutella, fromage blanc, oeuf, sucre en poudre, lait', '15 min', ['préchauffer le four à 200°C (thermostat 6-7)', 'Etaler la pâte feuilletée dans un moule adapté.', 'Casser le chocolat en morceaux, puis les verser dans une casserole. Ajouter  une cuillère à soupe de fromage blanc, puis faire fondre ce mélange sur le feu. ', 'Pendant ce temps, peler et découper en morceaux la banane et la poire. Les disposer sur la pâte.', 'Etaler le chocolat fondu sur la pâte, autour des morceaux de fruits. ', 'Dans la casserole, ajouter le Nutella, puis le fromage blanc, et mélanger pour rendre la pâte à tartiner moins épaisse. Etaler ensuite sur la pâte avec le chocolat fondu et les fruits', 'Dans un petit saladier, ajouter les oeufs, puis le sucre, et enfin le lait et mélanger vigoureusement.', 'Ajouter l''appareil sur la pâte avec le chocolat et les fruits. ', 'Enfourner et laisser cuire 35 min environ à 200°C', 'Quand le gateau est prêt, laisser refroidir un peu et savourer.'], ['Verre doseur', 'Presse-agrumes'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'mi nutella', 'poire', 'très facile', 'bon marché', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'Tarte poire banane mi-chocolat', 'cuisine', 'recettes', 'boisson', 'fromage blanc', 'Nutella', 'dessert', 'plat de résistance', 'pâte feuilletée', 'chocolat noir', 'lait', 'tarte poire chocolat', 'cocktail'], 'Dessert', e2d922ba-90a8-41e4-9dd9-9f43dff51fbb, '2025-09-26T16:19:22.105891', [{'ingredient_id': '27958d46-d90a-4e8e-b796-b2429753707a', 'quantite': '1'}, {'ingredient_id': '30061dc7-8de7-4e86-a224-8102f1ea3dda', 'quantite': '1'}, {'ingredient_id': 'ae7edc5c-ff6d-406f-8e3f-56086cce6404', 'quantite': '1'}, {'ingredient_id': 'cd70bbb5-8956-4cbb-b91f-1274d097a201', 'quantite': ''}, {'ingredient_id': 'ac75d16a-045c-4055-b08e-d899cf81bec3', 'quantite': '3 cuillères'}, {'ingredient_id': 'b3eae0c5-a328-47e4-b988-0dafc860da4c', 'quantite': '3 cuillères'}, {'ingredient_id': '91d6456b-6383-4e22-aec1-93afa8786070', 'quantite': '2'}, {'ingredient_id': '9c8fc0ec-bb36-4328-8fba-9fdea47b8767', 'quantite': '25 g'}, {'ingredient_id': '4f3af784-486a-4417-a0dc-51cd206ef910', 'quantite': '5 cl'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (37197, 'Beignets de banane', 'banane, farine, oeuf, huile, sucre glace', '10 min', ['Mélanger la farine, le sucre et les oeufs dans un saladier. ', 'Dans une assiette, écraser grossièrement les bananes avec une fourchette et les incorporer au saladier.', 'Dans une poêle, faire chauffer de l''huile (moins d''1 cm) et y verser une bonne cuillère à soupe de pâte... ( environ 4 cuillères peuvent contenir dans une poêle moyenne)... et ainsi de suite jusqu''à ce qu''il ne reste plus rien dans le saladier. ', 'Saupoudrer le tout de sucre glace avant de servir tiède.'], ['Râpe', 'Rouleau à pâtisserie', 'Batteur électrique', 'Fouet'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'huile', 'beignets sucrés', 'farine', 'dessert', 'plat de résistance', 'Beignets de banane', 'sucre glace', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:19:26.736318', [{'ingredient_id': '38f14c9b-27cc-439c-915e-977262d9b182', 'quantite': '4'}, {'ingredient_id': '89d25b12-21f5-4f8f-b2e3-806fa116357b', 'quantite': '4 cuillères'}, {'ingredient_id': 'e338728a-4750-4cf4-b4a2-cda0d6b197bb', 'quantite': '2'}, {'ingredient_id': 'bf9e62eb-946a-4ea5-a77d-fe3da549bf21', 'quantite': ''}, {'ingredient_id': '8673db90-292d-48aa-bbb8-e6a896e424e0', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (28598, 'Tarte des tropiques (3ème rencontre marmiton)', 'farine, sucre en poudre, oeuf, beurre, sel, litchi, mangue, banane, lait de coco, sucre', '90 min', ['Faire la pâte : ', 'Dans un bol, battez l''oeuf avec le sucre en poudre et une pincée de sel. ', 'Mettez la farine sur le plan de travail, mélangez avec le beurre coupé en petits morceaux. ', 'Ajoutez le contenu du bol. ', 'Malaxez le tout jusqu''à obtenir une pâte homogène. ', 'Laissez-la reposer 1 heure au frigo dans un film alimentaire (sauf si on est très pressé). ', 'Etalez-la au rouleau. ', 'Conseil: si vous mettez du papier sulfurisé, l''étalez directement dessus, sinon c''est l''enfer pour la mettre dans le moule !', 'Faites cuire à four chaud (7, 210°C) 20 mn. ', 'Possibilité de mettre du papier alu dessus, pour être sûr que ça ne brûle pas. ', 'Faire la crème : ', 'Eplucher les bananes et les couper en rondelles dans une casserole. Ajouter le lait de coco (il doit les couvrir à hauteur). ', 'Faire chauffer à feu doux jusqu''à ce que les rondelles de bananes soient ramollies. ', 'Ajouter le sucre, mélanger puis retirer du feu. ', 'Laisser tiédir, puis mixer les bananes jusqu''à l''obtention d''une crème lisse. ', 'Garnir la tarte : ', 'Laisser refroidir la pâte, la démouler sur un plat, étaler la crème, ajouter dessus les fruits très bien égouttés et coupés en petits cubes. ', 'Mettre au frigo une petite heure, et servir frais.'], ['Passoire', 'Mixeur', 'Batteur électrique', 'Tire-bouchon'], ['', 'entrée', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'très facile', 'oeuf', 'plat', 'sucre en poudre', 'recette', 'cuisine', 'recettes', 'Tarte des tropiques (3ème rencontre marmiton)', 'boisson', 'farine', 'dessert', 'plat de résistance', 'moyen', 'beurre', 'cocktail'], 'Dessert', 9ae6ffd7-b5c5-4101-a02e-141d653ea9b9, '2025-09-26T16:19:30.401901', [{'ingredient_id': '0634b17b-ff40-4157-a18c-571e143e341a', 'quantite': '200 g'}, {'ingredient_id': '874c2900-2baf-493b-99c3-a3ad394b2587', 'quantite': '100 g'}, {'ingredient_id': 'b1e070f8-857f-44e5-8882-bbc972392fed', 'quantite': '1'}, {'ingredient_id': 'c9c6c047-5754-4e7f-a224-3617be79bc4c', 'quantite': '100 g'}, {'ingredient_id': '5fbb0132-f5bc-499c-9682-a07868023cfb', 'quantite': '1'}, {'ingredient_id': '4076c6de-283e-4360-8ec4-2fa2e7c5d27a', 'quantite': '1'}, {'ingredient_id': '219f75ba-0171-46eb-81ea-8e585174fbaf', 'quantite': '2'}, {'ingredient_id': '487845b6-9985-46d0-a99c-2d9f32c8d966', 'quantite': '3'}, {'ingredient_id': '492c0dd7-a355-4e2f-868c-3d78a93d4e36', 'quantite': '200 g'}, {'ingredient_id': '3d99c1e2-9f00-4c04-9723-c8d1fdccbc00', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (61421, 'Fruits au lait de coco', 'lait de coco, banane, litchi, fruits rouges, arôme fleur d''oranger, menthe, sucre', '20 min', ['Pelez les bananes, coupez-les en grosses rondelles, mettez-les dans une grande casserole avec le lait de coco et le sucre puis portez à ébullition.', 'Versez le tout dans un grand saladier et ajoutez les litchis, les fruits rouges et l''arôme de fleur d''oranger. Couper la menthe en petits morceaux et ajoutez-la au mélange.', 'Servir frais.'], ['Économe', 'Fouet'], ['', 'lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'Fruits au lait de coco', 'très facile', 'menthe', 'bon marché', 'rapide', 'plat', 'fruits rouges', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'arôme fleur d''oranger', 'sucre', 'litchi', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:19:35.712659', [{'ingredient_id': '198c8365-a198-473f-9e1c-c3f5d6dadd57', 'quantite': '35 cl'}, {'ingredient_id': 'ebd15fa2-bd28-4911-a194-1eaa049a4860', 'quantite': '3'}, {'ingredient_id': 'ad499c33-e06c-4280-99cd-304674d5cd31', 'quantite': '10'}, {'ingredient_id': '9cecf749-0b3f-4b0f-b2f6-c53ab7f4cd37', 'quantite': '75 g'}, {'ingredient_id': '66d0de57-45a8-4971-bdc7-1b7ab13dedfb', 'quantite': ''}, {'ingredient_id': '86ba6064-c5a4-45ba-999c-0a0a7f370122', 'quantite': ''}, {'ingredient_id': '8e6c2d7d-7396-43ba-9580-ce88a06bddfc', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (17631, 'Gateau moelleux bananes chocolat', 'banane, beurre, sucre, farine, oeuf, chocolat, sel, arôme vanille, rhum, levure', '30 min', ['Mélanger les poudres: farine, sel et levure. ', 'Faire chauffer le beurre et le sucre dans une casserole. Quand le sucre est fondu, l''ajouter à la farine. ', 'Puis ajouter les œufs battus, mélangé. ', 'Ensuite, ajouter les bananes écrasées, mélanger. ', 'Faire préchauffer le four à 180°C (thermostat 6). ', 'Quand la pâte est froide, ajouter les pépites de chocolat. ', 'Verser dans un moule à manqué beurré et fariné. ', 'Enfourner la préparation entre 50 min et 1 h.'], ['Couteau de chef', 'Casserole'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'sel', 'confiserie', 'testées', 'chocolat', 'très facile', 'bon marché', 'oeuf', 'plat', 'Gateau moelleux bananes chocolat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'dessert', 'plat de résistance', 'arôme vanille', 'beurre', 'gâteau au chocolat', 'sucre', 'cocktail'], 'Dessert', 404daa2e-bb1a-429b-80b2-f926f55289ae, '2025-09-26T16:19:41.685243', [{'ingredient_id': '2a8f5950-f916-45ce-a4d1-7ec23627c62b', 'quantite': '2'}, {'ingredient_id': '3ff6f0fe-e969-405e-ab43-87cc364153c4', 'quantite': '175 g'}, {'ingredient_id': '437c5e0a-b650-432a-bacc-b5da050219d7', 'quantite': '200 g'}, {'ingredient_id': '45935937-d68e-4a70-a9d4-9b03c91f766a', 'quantite': '275 g'}, {'ingredient_id': '18a78f37-92ac-4733-ad66-e50b140f4b5b', 'quantite': '3'}, {'ingredient_id': '12424bc2-4fc4-4f67-9a89-c8df803aaf81', 'quantite': '30 g'}, {'ingredient_id': 'a0224269-06b8-4e58-82da-aefd1c6c2b43', 'quantite': '1'}, {'ingredient_id': '03b99b31-1c6b-4b67-820f-1e078f874867', 'quantite': ''}, {'ingredient_id': '2a6cc04e-549a-4b6a-894f-3aa3306bb78a', 'quantite': ''}, {'ingredient_id': '7ba61fa7-1765-4be3-82e4-df67f55e73c6', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (54144, 'Fruits chauds de Noël', 'poire, pomme, banane, mandarine, raisins secs, beurre, huile, sucre, cannelle, rhum', '10 min', ['Faire fondre le beurre avec la cuillère à soupe d''huile. ', 'Pendant ce temps, enlever la peau et les trognons des pommes et poires et les couper en gros quartiers. ', 'Mettre les fruits dans le beurre chaud et laisser cuire doucement pendant 20 à 25 min; arroser les fruits avec le beurre fondu. ', 'Au bout de 25 min, ajouter la banane (en rondelles) et les mandarines (en quartiers). Ajouter les 3 cuillères de soupe de sucre et laisser cuire encore un peu. ', 'Ajouter la cannelle et le rhum, bien mélanger et laisser compoter encore quelques temps. ', 'Des fruits bien fondus dans une sauce onctueuse, un avant-goût de Noël!'], ['Spatule', 'Balance de cuisine'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'poire', 'très facile', 'mandarine', 'plat', 'recette', 'Fruits chauds de Noël', 'cuisine', 'recettes', 'boisson', 'huile', 'dessert', 'plat de résistance', 'pomme', 'moyen', 'beurre', 'raisins secs', 'cannelle', 'sucre', 'cocktail'], 'Dessert', 2394d586-46f5-4955-84a0-c7b789d3a80c, '2025-09-26T16:19:45.269592', [{'ingredient_id': '9b8bce66-a79f-4c2a-a5bd-d20df2fddc70', 'quantite': '2'}, {'ingredient_id': 'badbbe61-f2fd-441b-95ec-ba0acca5497c', 'quantite': ''}, {'ingredient_id': 'efd31f35-522e-43c4-b40a-5010e74d4f25', 'quantite': ''}, {'ingredient_id': 'ce0c69e0-5b88-4599-b6bd-9af4ac434674', 'quantite': ''}, {'ingredient_id': '7951a5bd-710f-46b8-a3d2-fa4c41cd4d91', 'quantite': ''}, {'ingredient_id': '73266baa-8b7d-4e09-a39a-c35b82b03725', 'quantite': '80 g'}, {'ingredient_id': 'a047f41d-328a-4abc-9d51-5eebd0b4121e', 'quantite': '1 cuillères'}, {'ingredient_id': 'ccf3a44f-837d-4da4-a84f-b46a5ce561a2', 'quantite': '3 cuillères'}, {'ingredient_id': 'c963158e-80e7-4593-8306-db689a840202', 'quantite': '2 cuillères'}, {'ingredient_id': '8580c7a2-3317-4b6f-b670-ac182115c0e2', 'quantite': '2 cuillères'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (167559, 'Muffins végétaliens', 'farine intégrale, margarine, sucre, banane, levure chimique, fruits, sel', '15 min', ['Préchauffer le four à 180°C. ', 'Mélanger la farine, la levure, une pincée de sel. ', 'Fouettez le sucre et le beurre végétal fondu ensemble, jusqu''à ce que le sucre soit dissout. ', 'Écrasez les bananes, puis mélanger le tout ensemble (farine / sucre-beurre / bananes)', 'Ajoutez le jus de fruit : la pâte doit être consistante mais pas trop épaisse non plus. ', 'Verser dans les moules à muffins et cuire au four 15 mins, parfois un peu plus ...  ( j''ai un four un peu délabré alors chez moi c''est pas une science exacte, désolée !)', 'VARIANTES : ', '(attention, garder la banane dans chaque variante, c''est ce qui remplace l''œuf)', '- muffins pommes-cannelle: ', 'Prévoir 2 petites pommes bien mûres. Les éplucher et couper en dés, les arrosez de jus de citron à volonté, de cannelle et de sucre roux. (réduire dans ce cas le sucre de la recette) Ajouter à la pâte avant de verser dans les moules. ', '- muffins coco-chocolat: ', 'Ajouter à la pâte du lait de coco à la place du jus d''orange (ou juste de la noix de coco râpée, en gardant le jus cette fois), et des copeaux de chocolat noir.  ', '- muffins vanille: ', 'Ajouter simplement deux cuillères à café d''extrait naturel de vanille. ', '- muffins citron/pavot: ', 'Remplacer le jus par du jus de citron (ou moitié si vous voulez un goût moins prononcé)et une cuillère à soupe de graine de pavot. ', '- muffins amande / noix / noisettes: ', 'Remplacer de un quart à la moitié la farine par de la poudre d''amande (noix, noisettes, etc). ', '- muffins sirop d''érable: ', 'Remplacer le sucre par 5 cuillères à soupe de sirop d''érable naturel.'], ['Pince de cuisine', 'Moule à tarte', 'Presse-agrumes', 'Casserole', 'Balance de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'sel', 'confiserie', 'testées', 'levure chimique', 'facile', 'bon marché', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'margarine', 'dessert', 'plat de résistance', 'muffin', 'farine intégrale', 'fruits', 'sucre', 'Muffins végétaliens', 'cocktail'], 'Dessert', fa99f7ea-effb-417d-96a1-fa4a79ae4bac, '2025-09-26T16:19:49.104728', [{'ingredient_id': 'dbe63e47-e08f-4c51-9ebb-7d6cd319b176', 'quantite': '175 g'}, {'ingredient_id': 'dc819a28-05b9-4f1d-9ac9-123385eaf04a', 'quantite': '50 g'}, {'ingredient_id': 'b6179085-0547-47e5-adaa-f2bfb96b843b', 'quantite': '100 g'}, {'ingredient_id': '6e33021a-6905-4e30-87c5-8ac9d75000a6', 'quantite': '3'}, {'ingredient_id': '2ab3be76-bc37-4cb3-ba2b-77318d046dd7', 'quantite': ''}, {'ingredient_id': '6f81f897-f0ed-46bb-9ea7-ee58ca21b026', 'quantite': '4 cuillères'}, {'ingredient_id': '2ae498d1-fc6c-4ec4-a7f0-63c14ccd2a30', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (194185, 'Gâteau moelleux banane Nutella', 'beurre, sucre roux, oeuf, farine, maïzena, levure chimique, banane, Nutella', '30 min', ['Préchauffez le four à 150° (thermostat 5).', 'Faites ramollir le beurre, sans le faire fondre. Ajoutez le sucre et mélangez.', 'Incorporez l''œuf entier.', 'Versez d''un seul coup farine, maïzena et levure chimique. Mélangez jusqu''à l''obtention d''une pâte homogène.', 'Épluchez et écrasez les bananes. Incorporez-les à la préparation.', 'Dans un moule de 20 cm environ, tapissé de papier de cuisson, versez la moitié de la préparation.', 'Ajoutez une couche de Nutella, puis le reste de la préparation.', 'Enfournez 30 min et régalez-vous.'], ['Pince de cuisine', 'Spatule', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'facile', 'maïzena', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'farine', 'Nutella', 'dessert', 'plat de résistance', 'gâteau à la banane', 'beurre', 'cocktail', 'sucre roux', 'Gâteau moelleux banane Nutella'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:19:53.741485', [{'ingredient_id': 'b09af87d-d2c0-433b-8574-89a682a4fb23', 'quantite': '50 g'}, {'ingredient_id': 'c8d13a8e-f4d0-4c55-b0d5-51928ce3a84d', 'quantite': '30 g'}, {'ingredient_id': '83b97b43-8968-47a4-832e-024e77aa3215', 'quantite': '1'}, {'ingredient_id': '8b27bb18-2ab3-42be-985b-a13f68629ac7', 'quantite': '60 g'}, {'ingredient_id': 'e370de26-2c4f-42ff-a5fa-9bb73d32e8a5', 'quantite': '60 g'}, {'ingredient_id': 'd4e070c4-1ddf-48c8-82c1-9899375946ec', 'quantite': ''}, {'ingredient_id': 'aace750b-1bb7-4ad1-bd21-1c0d89e41b8d', 'quantite': '200 g'}, {'ingredient_id': '537512ae-0eb9-4bd8-93f8-db69ec3dff35', 'quantite': '100 g'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (41286, 'confiture mixée de fraises et de bananes', 'fraises, banane, sucre, citron', '30 min', ['Laver et équeuter les fraises, les couper en 2.', 'Recouvrir de sucre et faire macérer une nuit au frigo.', 'Ajouter le jus de citron, et les bananes en rondelles et porter à ébullition 20 à 25 min.', 'Ecumer, vérifier la consistance puis mettre en pots.'], ['Tire-bouchon', 'Spatule', 'Mixeur', 'Fouet'], ['entrée', 'confiture mixée de fraises et de bananes', 'banane', 'recettes de cuisine', 'confiserie', 'confiture de fraise', 'testées', 'très facile', 'bon marché', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'citron', 'sucre', 'cocktail'], 'Confiserie', e150070f-1afc-4e85-baed-39ad068d9a38, '2025-09-26T16:19:57.391771', [{'ingredient_id': '7daa92df-43b1-4b24-b387-236be60224ce', 'quantite': '1 kg'}, {'ingredient_id': '2aa06598-0c7b-401e-998f-c3161ae16e1c', 'quantite': '2'}, {'ingredient_id': 'a6c75d45-04da-454f-864f-bd6054f05f18', 'quantite': '700 g'}, {'ingredient_id': '81b2ff40-96fe-4033-b56f-b480cc9ac517', 'quantite': '1'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (371965, 'Pancakes banane & flocons d''avoine', 'flocons d''avoine, banane, farine, levure chimique, cannelle, extrait de vanille liquide, oeuf, blanc d''oeuf', '15 min', ['Réservé les flocons d''avoine dans un bol, ajouter la cannelle, la farine et la levure, mélanger le tout.', 'Mettez les flocons d''avoine au mixeurs, mixer jusqu''à que les flocons d''avoine soient le plus fin possible.', 'Ajouter ensuite les œufs, un entier et les deux autres sans le jaune.', 'Ajoutez la banane, l''extrait de vanille et mixer le tout jusqu''à obtenir une pâte homogène.', 'Passer votre préparation au chinois pour avoir une pâte bien lisse et éviter les résidus de flocons d''avoine en trop.', 'Faites cuire vos pancakes dans une poêle légèrement huilé à feu doux, une demi louche de pâte suffit, retournez la crêpe lorsque des bulle apparaîtront à la surface, une fois retournée laissez cuire 30 seconde à 1 minutes maximum.', 'Il ne vous reste plus qu''à déguster !'], ['Râpe', 'Batteur électrique', 'Économe', 'Mixeur'], ['entrée', 'banane', 'recettes de cuisine', 'extrait de vanille liquide', 'confiserie', 'testées', 'levure chimique', 'pancake', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'Pancakes banane & flocons d''avoine', 'farine', 'dessert', 'plat de résistance', 'cannelle', 'flocons d''avoine', 'blanc d''oeuf', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:20:01.074932', [{'ingredient_id': '08a6fcc9-4d18-4fea-91b0-6d0b8d6ffdda', 'quantite': '50 g'}, {'ingredient_id': '291f0944-86c8-48d2-af20-c9142cf0ef70', 'quantite': '1'}, {'ingredient_id': '96c76e2f-f93c-4718-aaa6-c12556caa612', 'quantite': '2 cuillères'}, {'ingredient_id': '1ac7dbb4-f0e1-4ecc-a6a2-403fd0436b98', 'quantite': '10 g'}, {'ingredient_id': '4bf792fa-4f1a-4bcc-897e-300526e620f5', 'quantite': '1 cuillères'}, {'ingredient_id': '3fcc7e4d-28fb-4b8f-a5fb-0018d4e8e3b0', 'quantite': '1 cuillères'}, {'ingredient_id': 'de7c4799-8171-457c-802b-d0ddb2d3b700', 'quantite': '1'}, {'ingredient_id': 'd86bd1af-849c-471b-bd58-3a9a15efd07d', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (31190, 'Gâteau Banane de Stéph', 'oeuf, farine, sucre, levure, beurre, banane, rhum, vanille', '15 min', ['Mélanger les oeufs et le sucre. ', 'Ajouter le beurre fondu, puis la farine et la levure. ', 'Couper les bananes en tous petits morceaux (ou les écraser au choix), et les ajouter au mélange. ', 'Aromatiser avec le rhum et la vanille selon les goûts.... ', 'Verser le tout dans un moule à cake beurré et fariné.', 'Laisser cuire environ 30 mn à four thermostat 6.'], ['Batteur électrique', 'Verre doseur', 'Presse-agrumes', 'Mixeur', 'Planche à découper'], ['entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'Gâteau Banane de Stéph', 'très facile', 'bon marché', 'oeuf', 'plat', 'recette', 'cuisine', 'levure', 'recettes', 'boisson', 'farine', 'vanille', 'dessert', 'plat de résistance', 'gâteau à la banane', 'beurre', 'sucre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:20:07.996046', [{'ingredient_id': 'd63ece8a-d4ef-474e-9f1d-2646de2c1ce6', 'quantite': '3'}, {'ingredient_id': '25bdaa90-7271-4682-b7e2-c628c696fe8f', 'quantite': '150 g'}, {'ingredient_id': '717ce8c8-88fc-4cb9-b10f-a72d2080c045', 'quantite': '100 g'}, {'ingredient_id': '7b00d3bf-62cd-45cc-9569-42926191ddc3', 'quantite': ''}, {'ingredient_id': '872cf570-7d53-4d99-a2a3-5214516852f5', 'quantite': '125 g'}, {'ingredient_id': '1c281f96-b6ec-4f51-a72d-3dbe29efdc9a', 'quantite': '4'}, {'ingredient_id': 'd2d9f985-5558-4b90-b0cb-97cbe6b0d6ad', 'quantite': ''}, {'ingredient_id': '2760f76b-331b-4176-805a-0528ef93bd03', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (336806, 'Cookies banane flocons d''avoine et chocolat', 'avoine, banane, chocolat noir', '30 min', ['Préchauffez le four à 180°C (thermostat 6).', 'Épluchez votre banane et coupez-la en petits morceaux. Écrasez-les à la fourchette jusqu''à l''obtention d''une purée homogène.', 'Ajoutez les flocons d''avoines et mélangez.', 'Faites des pépites avec les carrés de chocolat et incorporez-les à la préparation.', 'Sur une plaque de cuisson recouverte de papier sulfurisé, posez des petites boules de la préparation à au moins 1 cm de distance.', 'Enfournez tout cela au four pendant 25 min à 180°C (thermostat 6).'], ['Planche à découper', 'Couteau de chef', 'Balance de cuisine'], ['entrée', 'banane', 'recettes de cuisine', 'Cookies banane flocons d''avoine et chocolat', 'confiserie', 'testées', 'facile', 'bon marché', 'cookie', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'avoine', 'dessert', 'plat de résistance', 'chocolat noir', 'cocktail'], 'Confiserie', 55f670ea-1798-4b85-905c-880644afc80c, '2025-09-26T16:20:12.690642', [{'ingredient_id': '697d2ec0-22ec-4caa-bccd-2c6fd44acbb7', 'quantite': '80 g'}, {'ingredient_id': '64fa875b-1241-4bae-a053-ae53b9cb9cb2', 'quantite': '1'}, {'ingredient_id': '58d85d51-69a7-45be-8df3-13be11d8ba6b', 'quantite': '3'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (168769, 'Muffins banane pépites de chocolat au lait au caramel', 'farine, maïzena, oeuf, levure chimique, cassonade, banane, chocolat au lait, beurre demi-sel, caramel au beurre salé', '15 min', ['- Mettre le pot de caramel au beurre salé au frigo de façon à le faire durcir ce qui permettra de faire des boules plus facilement.', '- Préchauffer le four à 180°C', '- Avec une couteau, faire des pépites avec le chocolat', '- Dans un saladier battre l''oeuf. Ajouter ensuite la cassonade. Bien mélanger.', 'Faire fondre le beurre au micro-ondes, dans un ramequin, environ une dizaine de secondes.', 'Ajouter le beurre fondu et mélanger à nouveau.', 'Ecraser légèrement la banane dans un bol. C''est bien s''il reste de beaux morceaux, faut pas en faire une purée ;)', 'Ajouter la banane dans le saladier, puis les pépites de chocolat et mélanger délicatement.', '- Dans un autre saladier mélanger la farine, la maïzena et la levure.', '- Si vous n''avez pas de moule en silicone, beurrez vos moules ou utilisez des caissettes en papier.', '- Sortir le caramel au beurre salé du frigo et former 6 boulettes de la taille d''une grosse noisette à peu près. Enfin tout dépend de votre degré de gourmandise aussi ...', '- Verser le mélange farine, maïzena et levure d''un coup dans le 1er saladier et donner simplement quelques coups de cuiller. Il faut qu''il reste des grumeaux, la pâte doit rester granuleuse et ne pas être lisse. Très important!', '- Mettre dans chaque empreinte du moule une cuiller à soupe de pâte puis mettre la noisette de caramel au beurre salé au milieu et recouvrir de pâte.', '- Enfourner pour 20 min à 180°C'], ['Râpe', 'Ouvre-boîte', 'Pince de cuisine'], ['chocolat au lait', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'levure chimique', 'cassonade', 'facile', 'maïzena', 'caramel', 'oeuf', 'plat', 'caramel au beurre salé', 'recette', 'cuisine', 'recettes', 'beurre demi-sel', 'boisson', 'farine', 'dessert', 'plat de résistance', 'Muffins banane pépites de chocolat au lait au caramel', 'moyen', 'cocktail'], 'Dessert', a204acb7-358e-480f-9dd5-d042cc39590f, '2025-09-26T16:20:16.401516', [{'ingredient_id': '0771b116-b2ba-4826-8bc5-b049ca7055a7', 'quantite': '60 g'}, {'ingredient_id': '1e6ba6f3-3d56-4ffc-9b5e-91230955e393', 'quantite': '60 g'}, {'ingredient_id': '26b5be7d-3a56-4e62-942b-3dd3b07cf1d3', 'quantite': '1'}, {'ingredient_id': '3926e009-328c-4b44-bdd1-4cf1f7c6d98e', 'quantite': '1 cuillères'}, {'ingredient_id': '70fc78fc-c932-46c4-b8de-e82587ab261a', 'quantite': '50 g'}, {'ingredient_id': 'eecd222c-d752-4fbd-880d-ee70d9ce4682', 'quantite': '1'}, {'ingredient_id': '902d6ebf-e272-47bc-bea4-0ec660eed08e', 'quantite': '125 g'}, {'ingredient_id': '08e2856f-b2a3-4c5c-b978-642ceba47a48', 'quantite': '1 cuillères'}, {'ingredient_id': '235192ea-2a4f-4601-a8c3-185a9c9b0d93', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (72081, 'Bananes flambées simples et très rapides', 'banane, sucre vanillé, rhum, beurre', '5 min', ['Faites chauffer une poêle, faites-y fondre le beurre et ajoutez-y les bananes coupées en long, faites dorer de chaque côté.', 'Saupoudrez de sucre vanillé, versez le rhum et faites flamber : lorsqu''il n''y aura plus de flammes, servez !'], ['Louche', 'Planche à découper', 'Ouvre-boîte', 'Casserole'], ['', 'entrée', 'banane', 'recettes de cuisine', 'rhum', 'confiserie', 'testées', 'facile', 'bon marché', 'Bananes flambées simples et très rapides', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'sucre vanillé', 'beurre', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:20:23.118668', [{'ingredient_id': 'f043f7ac-2f48-4e91-9276-ff5a483ef20d', 'quantite': '2'}, {'ingredient_id': 'e955dfee-5960-4449-92c9-436ed2a4b5c3', 'quantite': '1'}, {'ingredient_id': '5083716b-abf4-4514-945f-852dc213e709', 'quantite': '1'}, {'ingredient_id': '68081d35-1799-412d-beb1-5340cafb9c97', 'quantite': '2'}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (218320, 'Smoothie coco', 'glaçons, banane, lait de coco, fraises, jus d''ananas, sucre fin, cannelle', '5 min', ['Versez tout simplement les ingrédients dans un blender avant de les mixer en une fois. Je vous conseille de prendre de bon jus de fruits aux fraises et ananas  car cela fait toute la différence.', 'Ne pas forcer sur la cannelle car il couvre vite le goût des autres ingrédients.', 'Vous pouvez mettre plus ou moins de jus de fraise/ananas selon les envies et goûts.', 'Pour les soirées ou apéros entre amis, remplacez la banane par un peu de Malibu coco (avec modération !), vous ne serez pas déçus !'], ['Passoire', 'Balance de cuisine', 'Râpe', 'Spatule', 'Planche à découper'], ['Smoothie coco', 'lait de coco', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'sucre fin', 'facile', 'bon marché', 'rapide', 'plat', 'fraises', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'jus d''ananas', 'glaçons', 'cannelle', 'smoothies', 'cocktail'], 'Boisson', a3038b98-335d-4d94-acbb-b8e9989200e8, '2025-09-26T16:20:26.729475', [{'ingredient_id': 'da49e0a2-afe2-43c0-9617-d576790a7fe2', 'quantite': '1'}, {'ingredient_id': '7a4aee3c-bd8e-4415-9f2c-19c4965e972c', 'quantite': '1'}, {'ingredient_id': 'e8675c99-bc80-47f0-bd86-d1d84a68864f', 'quantite': '12 cl'}, {'ingredient_id': '0a7b2f20-1f93-4cd4-aed2-d6602a5814f6', 'quantite': '12 cl'}, {'ingredient_id': '974585c5-6317-46f2-a490-8097e22bb9f4', 'quantite': '12 cl'}, {'ingredient_id': '2b77b7b7-f5f5-43a4-aaf7-42bff8f6aeff', 'quantite': ''}, {'ingredient_id': '949d3a4a-3236-40fa-96b1-6a7df58634bd', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (21996, 'Tarte aux pommes et bananes sans sucre', 'pâte sablée, pomme, banane, cannelle', '15 min', ['Mettre la pâte sablée dans un moule à tarte, disposer sur toute la surface des rondelles de bananes, recouvrir avec les pommes coupées en tranches fines. Saupoudrer avec la cannelle. ', 'Passer au four environ 30 mn à thermostat 7 (210°C).', 'Sortir la tarte du four et poser un papier aluminium quelques instants, puis le retirer délicatement.'], ['Tire-bouchon', 'Ouvre-boîte'], ['Tarte aux pommes et bananes sans sucre', 'entrée', 'banane', 'recettes de cuisine', 'confiserie', 'testées', 'très facile', 'bon marché', 'pâte sablée', 'plat', 'tarte aux pommes', 'recette', 'cuisine', 'recettes', 'boisson', 'dessert', 'plat de résistance', 'pomme', 'cannelle', 'cocktail'], 'Dessert', e252fb3c-4156-4b8c-8549-31dd91daad06, '2025-09-26T16:20:32.550302', [{'ingredient_id': '6addead8-6532-4a49-8563-fd689df41dd6', 'quantite': ''}, {'ingredient_id': '2e9974c0-75bf-4332-8949-2c6d9a2b66c2', 'quantite': '3'}, {'ingredient_id': 'c47dbbc5-9697-4da2-b449-6eed4cc13bff', 'quantite': '2'}, {'ingredient_id': '3a986feb-2821-422f-b46c-0f7ba69cb60a', 'quantite': ''}]);
INSERT INTO Recettes (recette_id, titre, description, temps_preparation, etapes, ustensiles, tags, origine, auteur_id, date_creation, ingredients) VALUES (30714, 'Punch variés', 'sirop de canne, rhum, citron vert, rhum, fruits, sirop de canne, citron vert, rhum, glace pilée, sirop de canne, rhum vieux, citron vert, lait de coco, sucre vanillé, rhum, sirop de canne, banane, ananas, citron vert, orange, vanille, jus d''orange, citron vert, sirop de sucre de canne, rhum, vanille, abricot', '10 min', ['Ti-punch antillais :
Mélanger les ingrédients et laisser reposer au moins 1 h.', 'Planteur :
Mélanger les ingrédients et laisser reposer au moins 1 h.', 'Daïkiri :
Mélanger les ingrédients et laisser reposer au moins 1 h.', 'Punch coco :
Mélanger les ingrédients et laisser reposer au moins 1 h.', 'Planteur de la Réunion :
Peler et couper les bananes et les ananas en morceaux. Presser les citrons et les oranges, ajouter leur jus aux fruits en morceaux. Rajouter le sirop de canne, la gousse de vanille grattée et le rhum.', 'Laisser macérer 2 h au frais.', 'Punch réunionnais :
Mélanger les ingrédients, laisser macérer 15 jours dans une jarre avant de déguster.'], ['Ouvre-boîte', 'Casserole', 'Économe', 'Balance de cuisine'], ['entrée', 'recettes de cuisine', 'rhum', 'Punch variés', 'confiserie', 'testées', 'facile', 'sirop de canne', 'rapide', 'plat', 'recette', 'cuisine', 'recettes', 'boisson', 'punch', 'dessert', 'plat de résistance', 'moyen', 'citron vert', 'cocktail'], 'Boisson', ee74f832-4fe4-4de2-a344-5e3dee006f2e, '2025-09-26T16:20:36.211454', [{'ingredient_id': '3e858ef2-04cd-456a-ad11-df112709bec5', 'quantite': '50 cl'}, {'ingredient_id': 'b8c30442-2b4b-422e-abce-4c3da78948c6', 'quantite': '1.5 l'}, {'ingredient_id': '99225130-4c23-48c4-99e2-3bd69b69c1e0', 'quantite': ''}, {'ingredient_id': 'ad181025-dc7f-4db1-83ff-76dc7c2c13ae', 'quantite': '1 l'}, {'ingredient_id': '895cb805-e734-40af-b538-bd222ad5782e', 'quantite': '4 l'}, {'ingredient_id': '65df645b-83c6-4e56-b176-f6dc714796c7', 'quantite': '1 l'}, {'ingredient_id': 'ae4847fc-4b1b-4544-8678-d18b4ac5daf5', 'quantite': '2 l'}, {'ingredient_id': '7cb7cc75-0301-49fb-98fc-677f4d914158', 'quantite': '3 l'}, {'ingredient_id': 'fad50c2d-a727-4a75-b010-be48d633ab00', 'quantite': '1 l'}, {'ingredient_id': '94ed4421-2ef1-47c5-9f79-dae3e8d5f02a', 'quantite': '50 cl'}, {'ingredient_id': 'c6b48643-ab68-4845-9d39-1e5a9e8ae9ed', 'quantite': '1.5 l'}, {'ingredient_id': '629c3124-866d-466e-b63f-198986c46075', 'quantite': ''}, {'ingredient_id': '5bd1ecb3-4f08-47a9-a2b7-73e76fd47c36', 'quantite': '2 l'}, {'ingredient_id': 'b8f7f51b-2e88-4db4-8164-c21f77681839', 'quantite': '2'}, {'ingredient_id': '81cba8d1-c6ce-4735-b8ec-80ef134d36f0', 'quantite': '1 l'}, {'ingredient_id': 'bb25b546-1720-4f52-a6b0-1733c376eb2a', 'quantite': '50 cl'}, {'ingredient_id': '4dfce300-1f56-48a0-bc47-7ddc684f2798', 'quantite': '3'}, {'ingredient_id': '4c85a916-0112-4ca0-8e6e-0f229364c27c', 'quantite': '2'}, {'ingredient_id': '38c6b6e5-f426-43a7-961c-b9a13cced2fe', 'quantite': '2'}, {'ingredient_id': 'c100f6db-8678-46d1-