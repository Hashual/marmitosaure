INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (14679, 4a994953-feba-42b8-b3ea-c32d902a4b80, 'Super simple mais qu''est ce que c''est bon ! Un peu de sel, un peu d''huile d''olive avant d''enfourner : un régal !', '2015-09-13T18:38:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64856, 6189be6d-29df-4b30-8b96-3fd7b8c4fb46, 'Bonne recette, simple a réaliser et très goûteuse. ', '2022-01-06T11:38:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64856, 4bbc756a-5575-48bc-bda7-dab9b8768ad8, 'Facile et au top ! Attention au sel? Le fond de veau est déja salé... .', '2021-02-28T10:24:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64856, 94b662c4-b0d8-45cd-b9b4-9b979656d259, 'Parfait ! Ne rien changer. Fait avec des "köttbullar". Facile, économique et nourrissante, je fais cette recette depuis plusieurs années déjà ! ', '2020-04-08T21:35:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64856, 67d2dc15-4457-4b41-97b9-e138cd7b51d5, 'Excellent. A refaire, presque rien changer à la recette simplement rajouter un peu de crème à la fin. On s''est vraiment régalé. J''ajoute cette recette à mon carnet !', '2016-05-05T13:18:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64856, ff6e1492-756c-4fec-9296-e962a5e99e39, 'Je n''ai pas été déçue d''avoir testé !  Il nous restait 4 endives au frigo, je les ai coupé en petits morceaux et rajouté, un délice !  ', '2014-08-18T09:56:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64856, 52d1acb7-e536-4048-a9a1-1df03282a5dd, 'On s''est régalé, et en plus facile à faire !', '2012-03-05T18:14:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64856, 7969c901-c2b1-4c98-9b53-60f15e54d7fa, 'Je n''avais pas de fond de veau pour remplacer ce goût j''ai fait fondre 1/4 de tablette  allégée pour bouillon, dans 1 grand verre d''eau, je referai ce plat', '2011-11-26T14:30:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64856, 8f0b714c-9aa2-4a7e-b45c-7b34a24da586, 'Très bon à refaire. ', '2010-09-03T18:13:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64856, 67c6a39a-bf91-4964-a77f-2eb99569c3c7, 'Personnellement j''ai fait mes boulettes moi même c''est bien meilleur ! Par contre je les ai fait cuire à part et au dernier moment pour qu''elles soient moins cuites et plus moelleuses et je les ai ajoutées à la recette juste avant de servir. J''ai aussi remplacé le cheddar par des tranches d''emmental et c''était bien bon aussi et puis dans le mélange eau-fond de veau j''ai ajouté 2 cuillères de miel j''adore ça et cela a bien parfumé les pommes de terre. Bilan : recette facilement personnalisable et très bonne, à refaire sans hésiter !', '2010-08-02T11:04:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64856, d3c777dc-a1c7-41a6-8b9e-da4385c59c96, 'Tout simplement très bon, à refaire', '2010-03-11T18:39:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64856, a7218f83-cc8a-4768-9160-2491cbfe8990, 'Ce plat est super bon, j''ai juste ajouté du persil frais et 2 tranches de cheddar en plus. Merci pour cette recette.', '2009-05-15T21:21:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64856, 51d0ebbc-c053-4359-a54e-2da9e21255e3, 'C''est bon mais sans plus. J''ai trouvé cette recette assez lourde bien que j''ai rajouté des salsifis pour alléger le plat. Le goût est sympa. ', '2009-03-31T23:04:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64856, 9c24d93c-63b0-4441-8c3e-f25d8f568323, 'Très bon accompagné d''une salade verte !!!! Je referai ce plat sans problème.', '2009-03-24T00:23:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (64856, 18808508-22b4-4a69-a245-c289d213217d, 'J''avoue que j''ai hésité à mettre le cheddar mais le résultat est excellent! Tout le monde en a redemandé! Merci, je garde précieusement la recette.', '2008-08-15T21:07:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66444, 7979f076-847b-47ce-b7d5-b10a628fad72, 'J''utilise la base (avec variations de la viande en fonction de ce que j''ai au frigo) pour accomoder les restes, c''est parfait !', '2018-12-24T06:53:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66444, 531738a6-10fc-4d2e-a983-0a9e06738ec6, 'J''ai testé la version provençale : absolument délicieuse, rapide et simple à faire, j''ai juste zappé le bouillon et l''oeuf et ça se tenait de façon impeccable ! Je tente très vite les autres recettes ! Merci.', '2016-04-27T16:37:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66444, f5c70256-190f-490c-8957-cee0467a69d0, 'Excellent ! J''ai essayé l''oriental, sans mettre de citronnelle, mais en respectant les proportions de bouillon. Cuisson 2 min 30, le pain se tenait bien. Je recommande ! ', '2016-04-03T16:37:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66444, bbed3a18-b49c-4e47-aad1-85f8cf02a164, 'J''ai testé la version grecque c''était délicieux ! Pour la quantité d''herbes, j''ai ajouté une bonne cuillère à soupe d''origan sec, idem de thym frais mondé (au lieu d''une demi tasse).', '2016-03-16T12:08:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66444, a996c98f-cf55-45b5-80ea-e3e8fa99a3b9, '1er essai avec le provençal et l''italien -> respect des ingrédients résultat: des pains de viande bon au goût mais aucune tenue, à peine démoulé qu''ils se défaisaient ! Bref pas très présentables et difficile à les terminer. Dommage. Mais! je ne me suis pas arrêté là... 2e essai avec l''italien -> modification des ingrédients avec seulement 1 courgette, 700g de haché p/b et seulement 300ml de bouillon, résultat : un pain de viande délicieux et qui a de la tenue!! Tous mes invités ont apprécié ! Conclusion : après diminution de la quantité de bouillon, j''ai été ravie du résultat, merci pour les idées !', '2015-06-15T11:01:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66444, c337f424-d0d3-4681-bf00-e5358f09c204, 'J''étais une adepte des versions de pains de viande grec et italien. J''ai testé le bavarois, mais les champignons ont rendu tellement d''eau, que la viande nageait dans la flotte, pas très présentable. ', '2014-06-18T13:44:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66444, eb24e019-8db9-4960-97c2-7369aea7f898, 'A faire et à refaire, excellent !!!', '2014-01-23T19:31:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66444, be53b820-8b73-48f2-a3db-98f3948f1eb1, 'Recette sympa et adaptable à partir de la base. J''ai suivi à la lettre pour le pain italien et le pain bavarois. Parfait pour une soirée copains avec une bonne salade.  ', '2010-01-21T14:19:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66444, 4d31790c-cdac-4835-983e-23fb5f735f99, 'J''ai testé le bavarois, il est vraiment délicieux ! Encore meilleur le lendemain, à manger froid en sandwich, entre deux tranches de pain de mie.', '2009-08-24T21:19:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66444, 82c4e77f-7129-47b1-a72c-638a842afe6e, 'J''ai testé avec 2 courgettes, 1 poivron, beaucoup de basilic et d''herbes de Provence.  C''est léger, très agréable au goût. Très bien pour un dîner de soir de semaine. ', '2009-04-09T17:56:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66444, 2e57d941-80fa-45ac-8949-63244682fa6d, 'J''ai testé le pain de viande provençal et le bavarois et ils sont excellents!!! J''ai observé la recette a la lettre (premier pain de viande de ma vie) et le résultat fut un homme et un invité très difficile rassasiés! Merci beaucoup!', '2009-03-19T20:11:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, dbaf6ff0-4314-4c3e-99cf-b1a896b6bd69, 'Je fais cette recette très régulièrement et toute la famille adore, je rajoute du riz cru qui cuit avec la sauce. Un pur délice et repas complet. Superbe recette.', '2023-04-01T17:37:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, e841f473-73c0-4e14-8af6-fbef7a88ef51, 'Tout le monde adore bien égoutter les courgettes surtout et bien épaissir la sauce, je la fais et refais', '2022-06-15T13:37:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, a1dcfec2-9f7d-4b88-871f-e591b8b5878d, 'Recette faite déjà plusieurs fois, j''ajoute de l''ail avec les courgettes et aussi avec la viande pour plus de goût. Riz au fond du plat. La crème liquide rend le plat moelleux.', '2019-09-05T18:33:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, 9ade2f1f-aa29-48a7-b8f7-63247e0012db, 'De petites améliorations : 400 gr de viande hachée (moitié porc et moitié boeuf),j''ai réduit la crème à 25 cl, de ml''''ail haché pour cuire les courgettes, une pointe de Cayenne à la cuisson du haché, des pâtes grecques en accompagnement, un peu de copeaux de mozzarella mélangée au gruyère pour le gratinage = une tuerie', '2019-08-18T18:54:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, fe01df8d-b674-4e13-9cc3-9d6e3511d622, 'Très bonne recette, j''ai mis un peu de riz au fond et j''ai alterné les couches de courgettes et de hachis, on s''est régalé
', '2020-07-06T14:43:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, 6c9004a2-3f6e-4438-9b8d-251031d1b982, 'Super facile à  realiser', '2023-08-10T10:59:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, e4f3d71a-b264-40da-8247-837fa598d420, 'Facile et super bon ', '2022-07-03T11:29:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, ef99d65b-d432-420d-a835-9f5d6626617c, 'simple à réaliser mais tellement bon ça rentre dans mes recettes préférées', '2022-04-06T22:06:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, 98a6d3a6-bdbc-410e-98fc-2dc7944bcb21, 'Bonjour combien de temps au four svp ? Je suis novice...merci bcp☺️', '2020-08-02T20:02:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, 881b3306-410f-453c-b228-2d982d0e846c, 'Très liquide et pourtant respectée a la lettre. Déçue', '2020-03-23T20:12:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, c925a266-39d1-4a3b-9871-74a742c65c5e, 'Une tuerie !!! J’ai juste mis un peu plus de viande hachée ...', '2019-08-07T13:33:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, 9f851734-79e2-490d-bd09-fb1e47ea1207, 'Merci très bonne idée , pour ma part j''ai rajouté de l''ail dans la viande et des herbes de Provence dans la cuisson des courgettes puis au fond de mon plat des feuilles de pâtes à lasagnes.', '2019-07-14T12:54:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, f0fe29da-7147-4bf4-9423-10ba3e723e06, 'C''est vraiment cool cette recette. Merci à vous pour les articles de qualité que vous nous proposez', '2018-12-07T13:35:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, 42eb81a9-9223-43b0-a4fe-51b86a9678fc, 'Je rajoute un demi verre de riz au fond du plat 
L eau rendue par les courgettes cuit le riz et plus de problème d eau en excès au fond du plat 
Et en plus ça en fait un plat complet
Un classique à la maison dont on ne se lasse pas !', '2018-10-18T12:29:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, 14c36108-2a07-4453-9277-c82d48d5bc0b, 'Très bon plat. J''ai suivi les conseils des internautes et j''ai mis du riz au fond du plat. J''ai fait cuire les courgettes en rondelles à la vapeur, assaisonné piments + herbes de Provence + sel et ensuite mis la préparation viande + sauce tomate + ail déjà cuite. Pas de gruyère ni de crème fraîche et c''était très bon et nouveau. Merci pour cette recette à faire avec des variantes pour la renouveler !
', '2017-06-25T21:02:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, b1cf9a3e-661d-4a3a-88b4-366f6ea0a2ba, 'Super recette j''ai juste mis 3 courgettes parce que pour 2 personnes en mettre 6 c''est trop mais vraiment bien et le résultat est là.', '2017-02-03T15:08:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, 48d17e78-1e32-4303-b4f1-5b511bfcc528, 'Très bonne recette, mais j''ai ajouté de l''ail et des herbes de Provence pour épicer un peu plus, sinon un peu fade, et du riz dans le fond du plat. Pour gagner du temps j''ai préalablement fait cuire les courgettes 3 min à la vapeur. ', '2017-01-12T13:16:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, 3841cda9-2918-47e2-8aef-bb7c512775d9, 'Je n''avais pas de crème, j''ai remplacé par de la mozzarella, coupée en dés, et ajouter à la préparation de viande hachée-tomates juste avant de dresser le plat ... très bon ! ', '2017-01-03T23:30:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, ba596625-a694-4132-9d8d-7e2ced9d8a29, 'J''ai mis  500g de viande et je suis d''accord, une seule brique de crème de 20 cl est suffisant. Recette simple et efficace, je la referai !', '2016-10-07T16:19:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, 8ce8acdd-6c80-4c16-9fae-490086cdf318, 'J''ai mis plus de viande pour avoir env. 100 gr/personne. Un peu de curry et quelques herbes de Provence. Super simple et goûteux !', '2016-08-17T14:51:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, 1b700295-33cd-4bc7-83f2-90f65bd33755, 'Excellent !! !', '2023-11-18T13:00:28+01:00');
