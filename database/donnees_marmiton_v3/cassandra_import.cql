INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, 0eacfed8-02d0-41a0-950b-30d70fb55cfc, 'Bonne recette. J''ai rajouté un peu d''ail dans la viande.', '2017-08-17T15:33:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, 69f31661-bfef-40b4-a93c-f0b92daf88e4, 'Rapide et super bon.', '2017-08-01T23:21:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, 4637452d-5947-4546-a3d8-f8c12a5afbde, 'Bonne recette mais bien meilleure avec de vraies tomates...', '2017-07-31T19:59:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, 72d02742-6532-459e-9a20-9ac13afe00fd, 'Super déçue...J''ai mis de la viande de porc... C''était fade.', '2017-04-09T20:02:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, cbcb36f5-45ec-448d-a4d0-80645a7088f1, 'Pour 2 personnes, divisez par 2 la recette, c''est très bien. Mon mari a beaucoup apprécié mon gratin !!!', '2017-04-05T10:49:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, 6886b541-d28f-420c-b47f-7548f9612073, 'Facile à préparer et délicieux!!! Ajouter du fenouil et assaisonner avec du citron, c''est à tomber par terre.', '2017-03-06T20:09:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, e3e43056-e898-4f56-8cf3-057674aad63c, 'Pure gourmandise!', '2016-12-15T22:49:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22983, cf249815-786e-4cd0-a3d5-a093fb7b4016, 'Très simple, rapide à réaliser et c''est toujours un régal. Je le sers avec du riz pour un plat complet.', '2016-11-27T16:15:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224950, ffd5bcfd-ab61-4762-bb6a-4e692ced2212, 'J’ai déjà fait plusieurs fois ces bruschettas, toujours avec grand succès ! Si je n’ai pas de tomate, je mets de la sauce tomate et on peut mettre d’autres fromages, chèvre ou raclette, délicieux ! Merci.', '2020-04-07T16:42:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224950, badcc632-6c15-46f7-a5c2-b8aab74e58a5, 'C''est vraiment original, ca change de la bruschetta classique. De plus, la recette est tres bien expliquée !', '2017-07-06T08:30:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224950, 2a090d53-27ab-4cd4-b713-02088f38b30a, 'Vraiment trop bon. Un peu long à préparer surtout quand on râpe le comté mais un pur délice. les enfants adorent', '2014-06-21T12:10:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224950, 77a5e129-990d-4f3f-bad2-48ba57c13418, 'Facile à faire et délicieux !! ', '2012-06-14T22:25:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (224950, 712c7142-ba62-4997-9651-a937030fd101, 'Facile et rapide, très pratique pour un diner de semaine en famille. Toute ma tribu l''a dévorée ! Merci !', '2012-06-11T13:39:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15696, 199f8401-eaf7-4bc4-b0fc-84c2e7457ba6, 'C''est très bon, un peu long mais très simple. Attention juste à la quantité de nouilles : il m''en est resté pas mal, ça aurait gâché le plat. Et attention aussi à les cuire très peu (juste un petit bouillon pour qu''elles se déplient). Sinon, parfait, bravo !', '2015-05-13T13:37:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15696, 5202b2dd-8df6-4317-af4b-ac81a3026091, 'Super bon. J''ai mis oignons, ail, carotte, poireau, pousses de bambou, germes de soja, crevettes, gingembre frais et champignons noirs. J''ai fait des sauces chinoises à part pour que chacun accommode le plat selon ses goûts.', '2014-02-22T21:01:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15696, 6d9adfdc-eb58-4c3f-9460-233a9bbd5400, 'Vraiment bon. j''ai mis des carottes et des courgettes comme légumes et du poulet et du porc comme viande avec de la sauce soja, c''était très bon. Un peu long a faire mais ça vaut le coup!!', '2009-01-09T13:37:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15696, 2bf5ea82-4b03-466f-bf68-27e265db7887, 'J''ai bien aimé, mais je trouve le plat un peu fade. J''ai assaisonné avec de la sauce soja. ', '2008-08-03T00:03:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15696, 4ea2173d-7ad7-4d66-b32a-8539d41109df, 'Très très bon. Sans mention des quantités nous avons mis 2 escalopes de poulet et 1 morceau (taille d''une escalope) de viande de porc pour 3 ou 4 personnes, une grosse carotte, 100 g de soja et une très bonne poignée de brocolis et c''était suffisant. Par contre nous n''avons mis que 300 g de nouilles sinon ça fait beaucoup trop. Un petit plus sympa pour relever le goût : faire revenir un morceau de gingembre frais haché avec l''oignon et l ail! C''est trop bon ! Bravo pour cette recette !', '2007-10-19T22:02:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15696, f68b4cf1-e630-4b26-849d-60552444f785, 'J''adore ! J''ai rajouté des épis de maïs, pousses de bambous et pousses de soja, succulent. La prochaine fois je rajouterai de la sauce soja pour relever un peu.', '2007-07-25T13:58:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15696, 7eca30f9-222b-4b3a-8153-36c5b21de7d1, 'Très bon bien qu''un peu long à faire.', '2006-06-02T00:51:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15696, 30e4630c-eee9-4431-b606-b1b8a8e6899d, 'Très bonne recette, cependant elle mériterait d''être un peu relevée. A la place des brocolis, j''ai mis du chou chinois.', '2004-10-24T17:35:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15696, 631539d8-36d2-4a2f-9768-ee0ae5c2e224, 'Excellent avec des pousses de bambou et du soja.', '2002-01-21T07:42:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (15696, a8d89a8d-7b8c-4276-b859-3b61756d6f4b, 'Succulent.', '2002-01-15T23:15:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73880, fad5d918-f33b-4ee1-a44f-4c5a165b24a8, 'J''ai légèrement modifié la recette en remplaçant le jambon par de la viande hachée, j''ai trouvé cette recette très bonne et la pâte était parfaite. Il faut bien respecter les temps de repos et surtout l''étaler au maximum jusqu''à voir la main au travers. ', '2010-05-26T23:00:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73880, af099dd4-a97a-4b7f-85d7-2d9e23913f35, 'Très bonne recette. Laisser cuire quelques minutes de plus qu''indiqué pour des raviolis correctement cuits 😁', '2022-11-13T18:35:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73880, 4d4a7898-3aa5-44fb-868f-2b3ca7fee8fb, 'facile a réaliser et super bon ', '2023-11-07T10:22:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73880, 867246e8-d871-426b-a4c4-40a053e10a86, 'Excellent ! 😁', '2021-05-29T19:12:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73880, d9bef5fb-c041-4078-b09d-067b8f161c16, 'Une grande première pour moi je n''avais jamais fait de ravioli et jamais vu faire donc un peu grand pour moi je trouve mais super bon je me suis régalée. J''en referai c''est sur. Un peu plus fin et moins grand mais très facile je trouve.', '2020-05-18T20:56:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73880, cbfe77b2-2716-4276-9222-6e5533617fe4, 'très bonne recette', '2020-04-18T21:01:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73880, ad34371b-56d8-4e8e-85a1-9009ecd5d3ae, 'Très bonne recette.', '2020-04-18T20:59:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73880, 48101f40-b08f-4157-94a2-02efb84e1a22, 'Obliger de doubler les doses car pas assez pour une famille de 4.', '2016-05-13T16:16:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73880, 315cf826-08d5-4237-9710-0c4a4e70c5c8, 'J''ai suivi la recette à la lettre mais j''avais beaucoup trop de pâte par rapport à la farce. D''après la recette nous avons mangé pour 3 personnes et non pour 6 comme il est indiqué (il faut quand même mettre assez de farce pour qu''il y est un peu de goût) j''ai donc doublé les proportions de la farce. Sinon, c''est excellent, à refaire... Merci pour la recette.', '2012-07-20T15:39:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73880, 10931b57-3391-4868-a543-493cbafe5ab3, 'Très bonne recette, je trouve que la farce est très équilibrée niveau goût, et pour que la pâte ne soit pas écoeurante ou fade, il faut vraiment penser au sel et surtout la faire assez fine.', '2011-09-26T22:36:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73880, 2b99ef0d-5a8a-4c0d-96ea-7c83efa32a33, 'La farce est vraiment délicieuse. Dommage que la pâte elle soit trop lourde et très fade. Cela gâche tout.', '2009-11-19T13:09:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (73880, 48bd7c37-9932-4acf-ba1c-2c5ca5e08272, 'La farce est excellente, par contre la pâte beaucoup trop lourde. ', '2008-10-05T14:47:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58316, c59fea15-e004-4d3f-8024-b7e7386b8975, 'Super ', '2022-07-14T13:48:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58316, e91e5126-cc4e-4a25-b198-d0a27cc77415, 'Délicieux ! ', '2021-10-24T10:43:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58316, 0d9aeb4d-6380-4c43-97df-b3392f256cb9, 'Un franc succès tant avec mon petit garçon de 2 ans et demi qu''avec mon mari. Merci !', '2020-02-05T12:17:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58316, 3c695a2c-44fa-4045-b174-7d56622a1dd0, 'Très bonne recette !', '2015-06-16T23:18:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58316, 7dc60247-453b-48ce-84ba-465b3693b42f, 'Excellent, léger et facile à faire. Mérite seulement d''être relevé avec quelques épices ou du piment. J''ai remplacé le parmesan par de l''emmental car je préfère le gratiné du gruyère.', '2014-10-10T00:09:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58316, 8a745b77-2072-4cd2-91f5-c7e439d78892, 'Ça se mange sans plus surtout si on utilise de la viande maigre. C''est sec. ', '2014-03-25T11:13:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58316, ee3eb5d8-a5aa-4b56-aedb-578721048394, 'Délicieux, j''ai laissé mijoter au moins 1 heure, et comme il y avait beaucoup de jus et que je voulais faire un plat un peu plus complet j''ai rajouté quelques cuillères de flocons d''avoine qui ont apporté beaucoup de douceur au palais. A faire et refaire et congeler pour l''hiver.', '2013-07-03T08:28:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58316, 38c477a7-efae-456f-a1ce-83541cf5e9db, 'Super recette, mon ami et moi avons adoré ! Plat rempli de saveurs avec plein de bons légumes. Par contre, la prochaine fois, je mettrai de l''emmental au lieu du parmesan qui durcit à la cuisson. Merci !', '2011-12-11T05:14:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58316, 982dc537-7402-4761-b2de-2f8fc4ab7451, 'Très bon et surtout très simple ! Manque juste un peu d''épices. J''ai longtemps laissé mijoté à feu doux (+/- 15 min) les légumes et la viande en tournant constamment. J''ai laissé cuire plus longtemps et ai ajouté de la chapelure pour faire gratiner. Plat très complet et très bon en hiver !', '2010-12-23T10:47:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58316, b5552070-0458-4930-88a8-41f8b8913982, 'Nous nous sommes régalés ! C''est simple et délicieux.', '2010-06-07T20:01:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58316, 00b0db82-5c55-43d8-8fae-fc30f9e2713f, 'Rien à redire, merci. Et en plus, très rapide.', '2008-08-29T14:34:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58316, 0d194e71-8645-434a-bd30-433c58026789, 'Épatant!! Très facile à faire, très jolie presentation avec les rondelles de courgettes et tomates. A refaire!!! Merci pour cette recette ', '2007-10-02T22:25:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (170864, d704bbe9-f0ca-4e85-b9ae-e45b9be26580, 'Pour ma part je mouille le pain avec du lait et non de l''eau.', '2018-09-08T13:39:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (170864, 093ae33c-4a65-4506-8095-60ad5c3d3735, 'Recette sympa et plutôt facile. On peut la modifier à souhait avec des épices que l’on aime.
Merci pour le partage !!! 
', '2023-04-25T14:07:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (170864, a85d878d-ccc5-421c-a395-8742a4525037, 'Excellent', '2020-02-12T09:53:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (170864, 96969665-3613-4996-b664-bdb1475e00e8, 'Délicieuses boulettes de viande.', '2018-06-04T12:22:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (170864, d8e83913-898c-4623-9d58-4569887fc907, 'J''ajoute un oignon et je les fais cuire au four. Les enfants adorent.', '2017-03-11T18:47:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (170864, ffda7408-ad7c-421d-8952-dcdc27b62d70, 'Très bonne recette adoptée par tout le monde', '2017-03-01T12:09:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (170864, 802f6594-5b1f-4fb4-8eab-6e71ddbb4793, 'Je n''avais pas de pain dur, j''ai remplacé par une demi tranche de pain de mie. Très bon.', '2016-02-20T17:49:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (170864, d3805a13-6646-42b6-b694-74074de05f1c, 'Très bonne recette, facile à faire ! Recette suivie à la lettre pour un super bon résultat. Très contente car c''est la première fois que je fais des boulettes et nous nous sommes vraiment régalés. Recette conservée dans mon carnet de recettes. A refaire sans hésitation !!', '2015-10-21T15:46:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (170864, b0b12ad6-d9c6-405c-ad15-93c5c4ca5dde, 'Facile et très bonne recette ', '2015-01-16T14:23:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (170864, 91636717-04ab-4d6c-a2d2-f4c029b4c6f3, 'Extra ! rien à redire ! ', '2014-12-12T20:09:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (170864, 38769e36-c770-4fa9-8b7b-0b12a1bfb6af, 'Le mélange du pain, parmesan et steak et tout simplement délicieux ! ', '2013-08-31T23:36:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (170864, 3a9ab009-1c40-40bb-a2b2-47904f844a7b, 'très bonne recette, j''ai ajouté un peu d''oignon.', '2012-07-09T23:15:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (170864, 3ede21f5-2c67-4c47-b2b0-306b358f4407, 'Très bonne recette. Je pique trois boulettes et elles sont parfaites pour les soirées barbecues. ', '2012-07-08T19:23:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (170864, 5ea59bdf-8951-4dbc-aa2f-3877f42d8a6c, 'Délicieux.', '2011-03-26T22:26:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (170864, 998f8d10-8d7a-4e79-bbf1-ca6ddf278523, 'Vieille recette italienne ... Je connais bien cette recette avec un mélange de chair à saucisse et d''oignons en plus des autres ingrédients. C''est super bon.  ', '2011-02-14T14:50:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53703, 861b6c25-7cdf-4595-aef6-b769cb53a0ca, 'Super bon', '2015-11-21T10:48:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53703, dadbdaf9-77ef-4f04-ae8a-fb2db730d16b, 'Super bon. J''ai juste doublé les proportions de la sauce pour rajouter quelques pommes de terre et carottes.', '2012-12-30T23:08:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53703, 0fdaea52-0d13-4a9a-9b94-182ca424320e, 'C''est la 2ème fois que je fais cette recette. Encore meilleure que la 1ère. J''ai laissé mijoté durant 3 heures à feux très doux. Mes 8 invités ont adoré. Je n''ai rien changé à la recette. Ne pas lésigner sur les arômates. ', '2012-11-26T18:54:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53703, 9916bca5-7459-41a0-ab5d-a6d773a917de, 'Top. Sauce un peu liquide mais top. ', '2011-12-12T18:19:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53703, 81e065d3-7c91-4012-87e8-4aac7ce49c48, 'Très bon. Nous n''aimons pas trop le ragoût mais là avec les autres viandes, c''est nickel.', '2010-10-25T18:42:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53703, cdfba389-00a3-4506-ab9f-ad104123b400, 'Très bon plat. A refaire.', '2009-04-25T14:01:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53703, c65e6e96-ced5-4e58-b20a-6730d4540c84, 'Nous avons apprécié ce plat principal très facile à réaliser et très bon', '2007-12-10T18:17:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53703, f6950cfe-65f7-47c4-91d6-78aabfda68d8, 'Recette réalisée avec de la macreuse et de l''échine la veille et réchauffée le jour même, très appréciée des convives (20 personnes), j''ai ajouté quelques carottes en deuxième partie de cuisson. Servie avec un gratin dauphinois et une poélée de petits pois arrosés de la sauce du ragoût. Les plus gourmands en ont repris. Merci pour cette recette.', '2007-11-21T19:17:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53703, 0d616879-0a5d-406d-bd92-da27cdc0fbeb, 'Plat riche en saveurs, viande fondante, ce fut un succès. Bravo et merci.', '2007-07-29T11:43:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53703, 4524a523-0471-4bbd-bf03-f0c3406f24d9, 'Facile à préparer et très riche en goût, cette recette à fait le régal de toute ma petite famille. Merci Hélène !', '2007-03-09T08:00:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53703, 0c78a40d-e7ba-4ca2-82c6-094677ced917, 'Très bonne recette qui a du caractère. A la place du jambon fumé on peut aussi prendre de la poitrine de porc fumée coupée en assez gros lardons. D''autre part, en accompagnement, du riz blanc ferait également très bien l''affaire. Bon appétit.', '2007-02-15T19:41:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (53703, 0c6ca330-df47-4201-b4a3-9493ef018504, 'Excellent! Simple, efficace, tout le monde a aimé. A refaire. J''ai pris  du paleron, très moelleux et j''ai ajouté 2 carottes coupées en rondelles pour les 45 dernières minutes de cuisson. (et sans sauge, ça l''a fait aussi)', '2007-02-07T16:57:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (305302, 0c42f5b1-16e9-433c-98ee-93d7465089ff, 'J’ai ajouter une premiere petite couche de gruyère. Et c’était vraiment excellent ! !
Merci ', '2024-01-07T20:37:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (305302, 357aabb2-c83a-48a1-8ea2-afd72a3bf836, 'J''ai mis de la crème épaisse à la place de la crème liquide sinon je n''ai rien changé à la recette. Quiche simplement délicieuse.', '2019-11-11T17:27:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (305302, cda3637c-0d56-4ae6-bc1b-14ab7a03ea4a, 'J''ai ajouté un peu de fromage et je utilise toujours du fromage blanc au lieu de la crème... très bonne la quiche !', '2017-08-25T23:40:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (305302, fd6f8425-0450-42bd-8c96-8cd30bd0bc2c, 'Bon', '2017-05-01T20:17:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (305302, 1c4b5ca3-8dd1-4b0c-8900-61af3cf376ee, 'Cette recette est parfaite, moi je ne rajoute pas de miel et je met de la crème fraîche à la place de la crème liquide je trouve ça meilleur ', '2015-06-29T14:35:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (305302, 4cd37fbf-3b83-4af2-8c69-2bb0f1d7d81c, 'Recette parfaite. J''ai ajouté 100 g de viande hachée, ai mis 3 oeufs au lieu de 4 et j''ai ajouté des dés de fromage de chèvre type bûche. Résultat excellent, toutefois, j''ai précuit la pâte à blanc mais elle est complètement retombée. Du coup, j''ai repris une pâte dont j''ai piqué le fond avec une fourchette, très bonne tenue de la pâte, un régal.', '2014-06-10T06:17:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (305302, 6af92587-3447-4c67-9bce-2501dbe8bf94, 'Recette agréable pour le soir, pas trop de chipotage pour la préparation, ne demande pas beaucoup d''ingrédients... Je n''avais pas exactement les mêmes proportions que la recette de base (seulement 4 oignons, un peu plus de viande, 3 œufs,...) mais ça nous a semblé très bon! Particularité: mon curry est en fait un "curry reconstitué" de plusieurs épices, dont la cannelle, qui ressortait fort niveau goût. Avis aux amateurs, en ajouter une petite pincée dans les oignons c''est pas mal.', '2014-01-25T12:47:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (305302, 722e0770-bec2-46d3-b977-ad91dc052f38, 'Très bonne recette et pratique quand on a des restes. J''avais un reste de viande rouge et de blanquette de veau, j''ai mixé les 2. J''ai ajouté 2 courgettes et mis que 2 oignons, que j''ai fais revenir à la poêle avec un peu de curry. Je n''ai mis que 3 oeufs.  ', '2013-11-21T20:57:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61389, dcbcabbe-87c0-4ec1-b01f-270dc24f763c, 'Super recette et rapide à faire, les enfants adorent. J''ai utilisé un mélange de ratatouille surgelé que j''ai mélangé à la viande hachée, j''ai parsemé de gruyère râpé avant d''enfourner, un délice ', '2023-07-02T19:41:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61389, a82b0204-f256-418c-ae21-7ccd4edd3058, 'Très bonne recette ! J''ai utilisé un mélange surgelé de légumes à ratatouille. Mais ne pas oublier de tapisser légèrement de semoule la pâte après cuisson à blanc afin que celle-ci reste croustillante et sèche.', '2012-09-28T12:55:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61389, 5fc2a993-ff0d-4778-abe9-5b517b1584b0, 'J''ai ajouté de la crème aussi et du paprika : savoureux !', '2011-11-16T06:34:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61389, 91e11e66-9d36-4e72-aea0-59915c9ed0bd, 'Très bonne recette. J''ai mis qu''un poivron rouge au lieu des tricolores et j''ai ajouté du gruyère pour que ça gratine dans le four. C''est extra !!!!', '2011-11-06T19:46:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61389, 8a5da433-2793-4ebb-bd86-8e2aaa4d8e9c, 'J''ai remplacé les légumes par un bocal de ratatouille de 700g net. Plus rapide et délicieux.', '2010-03-27T18:49:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (61389, 356c4d84-c710-4cfd-94af-a17bd412e0e7, 'Très bonne recette ! J''ai ajouté de la crème avant d''enfourner.', '2009-07-19T16:21:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65516, b1a563cd-c376-45cc-aaa8-8bef478a727c, 'Personnellement, je n''ai pas été emballée par le résultat. Un peu fade. Il aurait fallu relever avec quelques épices. Pour un vrai plat complet pourquoi ne pas rajouter quelques plaques de lasagnes qui auraient en plus absorbé le jus rendu par le chou...', '2012-01-19T00:54:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65516, 95c5f0e1-8ca6-43de-a0d9-c204ebc1b964, 'Même ceux qui n''aiment pas le choux en ont repris!', '2023-10-28T14:42:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65516, e596f2cb-b276-4e6f-ad0a-ebcb68c3672f, 'Fait sans chair à saucisse, avec 3 tranches de lards poêlées puis mixées. J''ajoute cumin, muscade, thym, que je laisse mijoter un moment. Excellent. ', '2023-02-27T23:32:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65516, a54e1ec1-6685-4b2c-a6d3-4a9e50e68b72, 'C''était très bon, je mettrais juste moins de carottes la prochaine fois. Je n''ai mis que 20min au four. Très bonne recette ! :) ', '2021-12-14T13:59:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65516, 52f214f3-92a8-49ab-92ff-db5859b7f753, 'Nous avons aimé, même les enfants.', '2021-01-09T19:28:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65516, d9b62589-3c43-4e92-a1b3-ce4e15a70c81, 'Très bonne idée, originale et plus de légumes que dans les lasagnes de base. J''ai laissé mijoter plus longtemps viande et légumes, avec cumin et coriandre moulue, une boite de tomates concassées, du bouillon et un peu d''eau (30-40 min). J''ai remplacé la chair à saucisse par un paquet de lardons. (J''ai utilisé du chou vert frisé et du chou vert normal).', '2020-04-29T15:43:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65516, 13179ba7-6930-44e5-9766-592edc987e4c, 'Du cumin dans la viande, avec des oignons rouges et du persil. Un régal.', '2020-02-23T15:36:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65516, 0bfca354-afaa-4bab-8460-393423994e23, 'Très bon ! On s''est régalé...', '2018-02-09T02:06:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65516, a8afa91d-8589-4c51-a7e8-4da4a52d1e0a, 'Super bon !!!', '2017-02-28T11:25:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65516, d1f34670-7826-4d16-9802-b97ee60f68fe, 'J''ai ajouté un poireau dans la viande et un mélange quatre épices. Quant au fromage, j''ai pris du cantal doux (fromage auvergnat au lait cru) que je râpe au dernier moment. Bien meilleur que le fromage acheté en sachet.... Le tout est très bon, plein de saveurs.', '2016-02-21T20:10:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65516, fe2e70a2-ca57-4027-88a8-22aad9bc46f6, 'Excellent ! Ca change mais j''ajoute des pâtes à lasagne et mets les carottes en rondelles pour plus de tenue et de texture. Et épices à son goût, moi cumin et herbes de Provence.', '2015-11-28T14:21:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65516, d5aec86e-4ace-4f64-ad9f-aa43003b0f92, 'Très bon. Je simplifie en ne mettant pas carottes, ail, oignon et persil. Toute la famille adore cette recette que nous ne trouvons pas fade ainsi. Je recommande', '2015-10-05T21:01:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65516, 9ba06099-a380-46bd-848d-7802faa41eb9, 'Ça manque juste un peu d''épices, assaisonnement. Ces lasagnes est plus à mon goût en ajoutant 1 cuillère à soupe de cumin, 2 cuillères à soupe de billes de coriandre écrasées, 2 cuillères à soupe de persil séché (car je n''avais pas du frais), 1/2 cube de bouillon de viande ou fines herbes émietté ainsi que des feuilles de lasagnes pour un repas complet en viande, légumes et féculents.', '2014-11-29T22:19:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65516, 3fb13d02-b96a-422f-b2c6-62261baba1ff, 'Excellent !', '2013-03-27T11:03:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65516, bae8c4b2-92e5-4a58-afe8-cd42141169ca, 'Bonne recette. Appréciée. Je n''ai pas mis de carottes et j''ai ajouté du cumin dans la viande, comme le conseillait un des commentaires. Je recommande.', '2012-10-17T23:08:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65516, 39f3a434-d64d-4bde-85f3-ca273d37977a, 'Franchement intéressant comme recette, mais peut sûrement être relevée de quelques épices. Personnellement, j''ajoute du cumin dans la viande hachée, cela apporte un plus. Et pourquoi pas avec de plaques de lasagnes ? A tenter la prochaine fois. En tout cas, merci pour cette recette', '2012-02-23T22:13:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65516, f6448b8f-2629-4d2f-979d-997f75a282f6, 'Très bon, original et pratique quand on reçoit car peut ce préparer la veille. A recommander. Tout le monde a beaucoup apprécié.', '2012-01-14T16:10:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65516, 15f8a156-137e-4921-9ca6-e0e15b07caa3, 'Merci pour cette très bonne recette au choux frisé, dont on ne sait pas souvent quoi faire. J''ai remplacé le boeuf par du veau haché et on s''est régalé !', '2011-12-15T17:51:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65516, 8e9dfba0-b2f8-418d-8f24-5531ce18d101, 'Pas très fan de choux au départ, j''ai trouvé cette recette bonne et originale. C''est devenue une "régulière" mais sans chair à saucisse.', '2011-09-17T08:59:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65516, 066d6230-1974-4990-bd54-1202803201eb, 'Bof, oui c''est original mais pas extraordinaire. Dans tous les cas, attention à bien retirer les côtés du chou, fort désagréable s''il en reste. Pour moi j''ai trouvé que c''était trop de travail pour ce résultat.', '2011-06-07T13:38:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65516, 04bacd6a-0f79-4860-acca-8b1548dfec73, 'Original, ça change...', '2011-04-15T18:57:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65516, 699f1577-4cc2-425e-ad45-1631d102f460, 'Cette recette est simple et originale, quand j''ai dit lasagne tout le monde cherchait les pâtes. Elle est très légère et c''est un régal. A conseiller...', '2011-04-12T22:49:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65516, d2003f19-7375-46b7-9e1a-4329acbfc71c, 'Pas mal. Ça permet de faire manger du chou vert aux enfants. Merci pour cette recette.', '2011-04-12T20:10:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65516, feec6886-9147-488b-9929-755c54e1c242, 'Bonne surprise ! J''ai ajouté des tomates, le mélange de viande est vraiment bon. Merci !', '2011-03-21T22:13:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65516, 96f03bfe-4e02-4b35-9d5a-04fc75573325, 'Très bonne façon de manger du chou vert. J''ai suivi les proportions pour la viande hachée et la chair à saucisse et l''équilibre était très bien. J''ai juste ajouté un peu de piment d''Espelette dans la viande et mis du parmesan râpé sur le dessus. A refaire très vite.', '2011-02-02T15:44:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65516, fe809027-ae62-429a-beb6-1f1605100144, 'Je n''ai pas mis de chair à saucisse car avec la viande hachée c''était suffisant mais ai mis un peu de gruyère râpé entre chaque couche. Merci pour cette recette.', '2010-09-30T09:50:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65516, 2f7eecb4-8644-4372-a6a2-fbe7c84739fa, 'Très bon plat je vais passer la recette à des copines, je n''ai pas ajouté de chair à saucisse et ce n''était pas sec', '2009-11-13T20:06:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65516, 88b2cb21-17ee-4111-b0b3-78bb9394fdc6, 'On a tous (enfants compris) bien aimé cette recette, dont la présentation est en plus vraiment chouette. Le fait de ne pas mettre de tomate (concentré ou pelées)évite une trop grande ressemblance avec les lasagnes originales (cette recette ne remplace pas l''autre).', '2009-01-24T14:53:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65516, 7c3da988-93ed-459a-9337-29077f6cdd56, 'Très bonne recette !! Une autre manière de cuisiner le chou ! Tout le monde en a repris ! Perso, j''ai changé une petite chose ou deux ! Par exemple, j''ai diminué un peu la quantité de chair à saucisse en remplaçant par des lardons allumettes fumés et rajouté deux oeufs à cette farce ! A la découpe en tranches, on distingue bien les différentes couches ! Trop bon !!', '2008-10-08T22:27:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65516, 11ca5a08-ae78-41a8-87e0-f1a41ecd41fc, 'Très bon. J''ai blanchi le choux 2 fois pour une digestibilité maximum. Au total, j''ai mis 800 g de viande (1/2 boeuf 1/2 saussisse). Mon plat est resté 1 jour ou 2 au frigo avant d''être dégusté. Les enfants en ont mangé sans se poser de question. Donc c''est bon !', '2008-05-18T19:16:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65516, 71b5224e-23d6-448c-8aad-a52e4964cbba, 'Un délice, même les réfractaires au chou se sont resservis. Personnellement, je n''ai pas mis de chair à saucisses et j''ai ajouté de la tomate.', '2008-04-10T19:20:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (65516, 74f04222-a858-4df2-ba9b-93ab699e6e7e, 'Excellent ! Tout le monde a adoré. Personnellement j''ai rajouté un peu de sauce tomate maison. A refaire, cela change des recettes traditionnelles.', '2008-03-15T10:39:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172793, b8e55167-6d67-43eb-a160-955d2ca64163, 'Recette que je fais régulièrement en vacances quand on n''a pas de four. Très bon on aime beaucoup. A accompagner d''une salade composée ou d''un légume cuit. ', '2020-05-22T11:25:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172793, 705cf2d9-75fa-4722-87d3-85823e7c8ef6, 'Tout simplement excellent ! On a adoré !', '2012-11-27T21:21:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (172793, 07c7a377-8664-4a2e-8afc-33f7ad7b45a8, 'Nous avons tous aimé. 
J''ai mis 800g de viande pour 5, 3 œufs  et ajouté en plus des herbes de provence. J''ai fait cuire 2 fois 9 min à 800 W mais je pense que le temps varie en fonction du micro-ondes. J''ai retourné le pain car trop humide en dessous le jus etant resté dans le fond du plat et refait cuire 5 min à 600 W. 
Merci pour cette recette très bonne et ultra simple', '2023-05-13T16:01:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49923, 66b6f29a-f26b-4f68-bf11-be39b1263701, 'Mélange de couleur aussi beau que bon. Plat complet par excellence. Merci.', '2020-07-24T19:05:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49923, 81cbc4e9-b29b-4e8c-9786-f0e9c1fec882, 'Super bonne, je n''ai rien changé, vraiment parfaite !!! Merci pour cette magnifique recette ! ', '2014-07-22T21:57:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49923, 64ec4f47-3bc1-43c5-bcb7-6aece848a33b, 'Mon fils de 14 ans a adoré, nous les parents un peu moins mais ça permet de changer.... je la referai !!!', '2012-06-24T20:12:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49923, dfd83a5d-1739-4ce7-a6f9-42fda7567c9a, 'Excellente recette. Toutes ces belles couleurs mettent en appétit et l''on n''est pas déçu.', '2011-06-15T09:28:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49923, 93c20320-f32b-4394-93a5-0f7acf06dfb3, 'La salade est très bonne. Les quantités seraient davantage pour 6 personnes. La sauce relève bien le plat. Ne sachant que faire du reste des tacos, j''ai présenté la salade dedans, avec la sauce à côté, j''étais contente du résultat !', '2011-01-31T22:03:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49923, 6be1a577-f871-4234-b42e-439dc183537d, 'Parfaite ! Pleine de saveurs. C''est une salade qui fait voyager. J''ai eu beaucoup de succès. Merci, je la referai c''est sûr.', '2010-08-01T16:37:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (49923, 867f129e-137e-4317-b79e-8f54068ed2ca, 'J''ai l''honneur de faire le premier commentaire sur cette superbe salade!! Je l''ai déjà faite et refaite, même pour une amie d''origine mexicaine, qui me la réclame depuis... Le mélange des ingrédients est frais et très agréable au goût. Mon mari étant allergique aux carottes crues, je n''en mets pas dans la recette, les proposant parfois à part, parfois pas du tout et c''est très bon sans aussi. En revanche, quand je ne fais pas la présentation au verre, je dispose aussi tous les ingrédients en couches distinctes dans un saladier transparent, comme dans une verrine,et c''est très joli aussi. Je fais moi-même les poivrons marinés. Et enfin, je propose également la sauce à part, afin de pouvoir conserver les restes de salade (très rares les restes !). Merci pour cette recette facile, et très bonne !', '2008-08-10T09:05:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, f90040d4-afa4-4c7d-95a3-229dad62c687, 'Excellent ', '2023-10-28T15:25:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, 92e40031-0771-4c4c-a3aa-7b7524d085fd, 'Savoureux et apprécié de tous ', '2020-09-24T12:46:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, 05d5484e-4270-4889-bae5-512d816795e3, 'Je n''ai pas aimé le goût du poivron avec le curry j''aurai due éliminer le poivrin pour que le gout sois meilleur sinon c''était bon j''ai ajouter du fromage rappée a la fin de la cuisson !', '2018-08-20T09:28:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, 4fa61512-6aa2-4c1b-bf2f-8542ea32222f, 'Cette recette a fait l''unanimité même auprès des enfants, un vrai régal !', '2017-02-21T18:21:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, 62c27266-659b-4f02-9842-cc29bb6bbc83, 'Vraiment très bon ! J''ai réalisé la recette avec 1 kg de courgettes, 1 poivron rouge et de la viande hachée (spécial bolognaise) : une vraie réussite !!! Je garde forcément la recette dans mon carnet, merci', '2016-12-01T09:31:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, 3eee37be-1cc3-458a-8c5b-4ac3e62d6c8e, 'Excellent, un vrai régal, j''ai ajouté du paprika et mis pour les tomates 350 g, merci pour cette recette.', '2016-11-14T20:26:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, e7ac6fe8-bc79-4127-acce-abd41ceaad92, 'Très bon. Merci.', '2016-05-09T20:02:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, b862ff67-da21-449c-9f83-991ae4aded9a, 'Un plat vite fait très bon j''ai ajouté quelques champignons ', '2016-01-24T21:59:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, e72a7ccf-22f9-47a4-bb77-3fb9182e3eea, '5/5 très bon, je l''ai dégusté chez ma fille', '2015-12-20T11:04:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, 2c72acf8-518b-4340-84ad-4d55203c9c52, 'Nos 2 enfants et nous n''avons pas aimé...', '2015-11-28T16:24:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, c977f2fb-cda4-4dd2-b059-494a42cf5711, 'Très bonne recette, toute la famille a aimé.  Merci.  ', '2015-07-03T17:36:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, ad759608-bf30-4125-86eb-8a27af43b8f2, 'Bien. Il faut ajouter de la sauce. ', '2014-07-24T15:10:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, 6ef3b297-b2f3-4f1f-841f-25fcd25dd39a, 'Très bon ! Merci', '2014-06-10T21:08:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, cafd6da6-de3f-47e3-9f94-1637229431d9, 'Avec thym laurier basilic, très bonne recette aimé par tout le monde.  ', '2014-05-29T00:40:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, fca679ab-f3de-4d52-a4eb-8612852f609d, 'Délicieux mais moi j''ai ajouté du jus de tomate car la ratatouille était assez sèche.', '2014-03-03T12:40:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, 812f406d-dcfe-4b9c-aff6-63d41d28d593, 'Bof sans plus...', '2014-02-02T18:43:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, 7dc87875-ccb3-4b3c-b9ee-239abf5e76da, 'Recette tres simple et super bonne. A faire et refaire !', '2013-12-09T10:48:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, 7f584b46-d3eb-43ac-bfad-ec76435543c9, 'Très bon j''ai ajouté du gruyère râpé en fin de cuisson. Un régal ', '2013-09-27T21:06:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, 5632fd6d-472e-49ad-9dcd-9a24df12d091, 'Bonne recette mais l''auteur a oublié les épices... J''ai ajouté sel, poivre et paprika, ainsi que des herbes de Provence.', '2013-05-03T19:23:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, a837f535-b2ac-4608-aad9-f804b734726f, 'J''ai beaucoup aimé. Merci.', '2013-04-29T20:52:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, 77863484-51fc-4a25-bade-6ffe4f486e8f, 'Très bon, ce plat me permet de faire manger des légumes à mon mari. J''ajoute juste 2 pommes de terre coupées en gros cubes et un œuf par personne en fin de cuisson.', '2013-04-03T14:24:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, c1048193-42c1-4997-829d-d9729c517dc7, 'Sublime recette, facile et rapide. Grand succès auprès des enfants, avis aux débutants elle est inratable !!! Je l''ai servi avec du riz basmati et la quantité est largement suffisante pour 5 à 6 personnes. Merci pour la recette, bravo !!!', '2013-03-23T16:03:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, d638a17a-e005-4315-8b42-cd4e63a2f3ea, 'Sympa mais n''hésitez pas à ajouter des épices et pour ceux qui aiment les poivrons ajoutez-en aussi...', '2013-03-21T20:54:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, 03e197a8-8d9c-4416-9640-89a311a75945, 'Super. Ce plat a ravi toute ma famille. Mes 2 enfants ont adoré. Étant au régime, c''est un plat idéal pour le soir. J''ai suivi la recette pas à pas sans rien changer. Je la referai. Merci.', '2013-03-20T22:10:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, 065977d4-dcb6-4905-ab3a-39534863c61b, 'Excellente ! Je ne suis pas fan de ce plat mais depuis que c''est mon mari qui l''a cuisiné je me suis réconciliée avec la ratatouille et j''en redemande ! Notre fils de 19 mois en a mangé aussi ! Idéal pour un repas du soir en famille ou entre amis. A refaire sans hésitation.', '2012-12-20T16:18:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, 5b8757be-cbcb-4ccc-ae4d-8ebe92a66e26, 'Très bon et pas très lourd, mais un peu fade effectivement, si je venais à la refaire je n’hésiterais pas à mettre plus d''épices.', '2012-11-08T21:58:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, d640d4dd-e74c-4f37-8b14-d657ae9dacdd, 'Cette recette fait le bonheur de mon fils de 18 mois et nous adorons également ! Je varie les légumes et je n''hésite pas à mettre du curry, un peu de paprika et des épices marocaines...hummm un régal !', '2012-08-29T11:27:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, 1dc95157-d312-411e-9d66-63e4f711578d, 'Nous avons trouve ce plat très fade', '2012-06-24T11:26:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, 3789d254-aaa4-4eda-a858-843a7196ac0b, 'C''était bon mais un peu fade ', '2012-06-05T23:32:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, 0f26aa6d-c123-45e4-8c06-61b7b5121f6c, 'Rapide, simple et bon, très bien pour un repas du soir.', '2012-04-24T21:49:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, 9129b4a6-3fb5-4953-b673-bff0a7b46439, 'Trop bon !', '2011-11-11T16:08:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, b79f78b8-ba93-4b10-bc29-2ea676eb0bd1, 'Simple, efficace...', '2011-08-06T14:01:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, e9202a61-9e3b-40c0-8ef8-90e454bd12fa, 'Un classique depuis plus d''un an à la maison. Mon fils de 5 ans adore. Je la sers avec de la semoule. C''est parfait. J''ai donné cette recette à pleins de copines. Merci !', '2010-02-27T09:50:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, 3ca55295-16f0-4998-9b9c-679f24dd0e27, 'Merci pour cette recette,simple, efficace, elle nous réconcilie avec les légumes!', '2010-02-23T15:06:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, d0a818a9-ada2-4c0e-bd04-2cfb9ed440c6, 'Très bonne recette, simple mais comprenant ce qu''il faut, viande/légumes donc parfait pour petits et grands.', '2010-01-21T18:11:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, bae0fc65-b801-4a04-b542-017169215f06, 'Super ! J''ai ajouté deux pommes de terre : parfait !', '2010-01-03T20:20:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, e68cf8bc-619b-4d62-9ad2-b8ec839fa27b, 'Recette simple et délicieuse que demander de plus !! Merci', '2009-11-18T12:10:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, 5dcaeb36-9586-4a24-9099-6a348ad1ead6, 'Très bien, ca change de la ratatouille traditionnelle.  Au départ j''ai fait fondre un cube oignon-ail dans la sauteuse....  ', '2009-09-07T17:22:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, a90f7e2f-be23-481c-ae14-62c0532d91f0, 'Excellente recette ! Merci.', '2009-09-05T15:51:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, 72afca0d-d9fb-4919-ac47-bc653b0a1a98, 'Très facile à faire. J''ai ajouté des épices pour pizza, c''est un vrai régal. Miam.....bravo', '2009-06-14T15:04:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, a116ab63-4f34-43dd-80bf-a8fb1904813c, 'Les enfants ont adoré. J''ai rajouté 1 aubergine, du fenouil et du maïs. J''ai accommodé de riz. Repas complet tout à fait équilibré.', '2009-05-25T15:45:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, 65c73b7e-1011-47fe-8af0-8188b3ec79d4, 'Très bonne recette. J''ai rajouté un peu de curry dans les légumes et j''ai fait gratiner le tout au four avec du fromage à raclette. Pas très diététique mais tellement bon!  ', '2009-04-19T17:27:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, 6b0b9c06-2cfe-4f6d-9c3f-df33f67f2e59, 'Tout simplement excellent! servi avec des pommes de terre cuites à l''eau, qui se marient assez bien avec la préparation. A refaire et à refaire !!!', '2009-02-07T08:30:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, 4deb1111-80a4-4aa7-a324-4d751acc5dd9, 'Facile et bon. J''ai ajouté un reste de pâtes et j''ai mis tout ça au four avec un peu de gruyère, ça fait un plat complet!', '2008-09-01T14:41:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, 868d1cea-7644-452c-a14c-47d409267486, 'Bonne recette agréable et pas difficile.', '2008-08-16T17:31:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, 0192b0d9-7e52-4221-924c-dcf9b664a514, 'Je commence par tout faire revenir au wok, et ensuite la touche finale au four. Pour encore meilleur je rajoute de la mozzarella dessus pour gratiner.   Très bonne recette pour manger des légumes je vous le recommande!! Mes amis ont apprécié.', '2008-08-02T20:03:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, f8730d13-8272-4719-a2f0-476228f8f62f, 'Très bonne recette, facile, appréciée de tous (grands et petits). A faire et refaire. ', '2008-07-28T20:04:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, fa9a30ef-700c-491a-9cb4-fde8e5b0e6d2, 'Super recette : facile et excellente !', '2008-05-04T15:41:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, ad3b97fc-a5d0-44f1-b59f-2df5a6aacec4, 'Très bonne recette facile à faire et appréciée de tous ! Un plat léger et coloré dont on ne se lasse pas. Meilleure assaisonnée de curry.', '2008-04-14T19:17:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, 4aa576ee-7b93-49ff-ad4a-4b15ecf2db0a, 'J''ai essayé quand j''ai invité une amie américaine qui voulait tester la nourriture, elle a été totalement séduite et moi aussi. Vraiment délicieux.', '2008-03-12T18:32:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, 88c87a42-bcc9-4110-8733-5e0749f9cf64, 'C''est super simple, délicieux, nourrissant et surtout c''est inratable ! Je n''ai pas eu besoin de rajouté de l''eau en cours de cuisson. Le seul hic, c''est qu''en respectant les quantités, il n''y en a eu tout juste pour 2 personnes. Nous ne sommes que 2, heureusement.', '2007-12-13T19:03:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, cb7e6d94-e57f-4409-a4b4-b25167e84848, 'Délicieux avec ou sans viande hachée (j''ai essayé les deux versions.....)', '2007-11-03T10:57:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, 405364db-3664-4f80-89ea-53fd2b210677, 'Toute la famille s''est régalé! Le curry relève la recette et c''est une bonne façon de faire manger des légumes aux enfants. En plus c''est facile à faire et équilibré!', '2007-09-18T13:23:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, ce84fa5d-b466-4b05-bb91-299cb87a7525, 'Avec les légumes épluchés c''est encore meilleur!', '2007-05-26T23:01:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, d924a6d8-54c4-4cc0-a836-4a5abc75ca45, 'Moi, j''ai rajouté du riz, c''est vraiment délicieux!!!', '2006-11-13T11:04:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, 35dc7ee8-11dc-4a70-a00f-06a530852b6f, 'Facile, délicieux! Super pour manger des legumes...', '2006-10-27T19:40:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, 2441d331-541e-4069-9c75-ac0dfcaa78d0, 'Je déteste les légumes mais j''ai beaucoup aimé cette recette! Je rajoute du thym et un peu de piment de Cayenne en poudre pour encore plus de goût.', '2006-10-03T20:41:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, b7eb5d7f-893d-44e4-8942-99af73c4caa7, 'Délicieux, sain, facile! Très bon aussi sans les courgettes (je n''en avais pas sous la main). Ne pas hésiter à assaisonner plusieurs fois.', '2006-09-03T22:33:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, 319328d5-9dd9-4719-aa00-6fc772745246, 'Moi, j''ai ajouté des épices au couscous à la place du curry histoire de relevé un peu... Excellent...', '2006-08-23T14:04:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20300, 60ee604a-ea47-446c-96b5-0140213f24b0, 'Facile à réaliser. J''ai mis un peu de poivron jaune, rouge et vert. Plat plein de couleur et délicieux.', '2006-06-15T19:20:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66174, 19067c31-9342-40ab-998d-378fe4386903, 'Fait avec de la viande hachée de boeuf, deux fenouils et du gruyère râpé, c''était un régal ! À refaire à coup sûr !', '2017-01-21T13:55:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66174, c789bdf0-f940-40fb-9891-eb3cfd8ffaf7, 'Recette excellente !', '2016-08-31T22:08:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66174, a9f356cd-2180-44ac-8ada-e27118421a6a, 'Une super recettes très facile a faire même pour les débutant en cuisine comme moi. C''est la première fois que je cuisine un fenouil et il se mari très bien avec les poireaux. Recette à faire les yeux fermer sans rien changer.', '2016-03-04T00:27:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (66174, c3f93e0d-5f00-4d54-91ec-ce7a22be9702, 'Nous sommes de grands adeptes des plats uniques et celui-ci est délicieux, le cheddar donne un très bon goût particulier à la préparation et c''est pour moi l''occasion de cuisiner du fenouil, sans que les enfants se plaignent du goût. On a adoré !', '2008-02-24T19:39:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16981, 6f823d05-efe1-44bf-8361-fec22c7fb04a, 'Un régal ! J''ai ajouté un pot de concentré de tomate en plus 😋', '2023-01-26T22:28:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16981, d1167115-83cb-40e9-8371-7c3ae79a2926, 'Très bon. Pour atténuer l''acidité des tomates, mettre un peu de sucre en poudre.', '2023-01-05T21:24:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16981, 69af4189-2752-4921-9225-757fd33aee3c, 'Très simple à faire et super bon. Facile à agrémenter en fonction de ses goûts également !', '2022-10-31T09:56:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16981, ca18e417-d992-4819-b0aa-da177a50f67c, 'Excellent!', '2020-11-08T15:02:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16981, 8022a9bb-ec1e-499d-859e-6cdd454a4b3a, 'Excellent et facile !', '2017-09-15T15:31:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16981, 59173109-4935-48da-a14c-8dd049f9dff6, 'Excellente recette simple et facile,juste un petit conseil, faire cuire à part les boulettes et seulement ensuite les rajouter dans la sauce 2 minutes.', '2017-04-01T17:22:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16981, 35cfa614-870d-4ec8-8fbd-9d9f0fca1640, 'Excellent !!! Ça change des tomates farcies. J''ai ajouté un oeuf au mélange viande basilic pour une meilleure tenue des boulettes. Fait avec des tomates et un coulis maison, servi avec du riz basmati ...un régal. ', '2016-11-21T23:30:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16981, 9755f32f-dd98-4778-97e1-2627eca1d358, 'Ajouter pleins d''épices et c''est délicieux !  ', '2013-10-30T17:59:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16981, f62be211-b2cd-4aa0-850d-1796e70c9a0b, 'C''est très bon mais les boulettes sont un peu ramollies par la sauce!', '2007-09-12T15:30:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16981, cf7fb18e-e6af-4191-88db-bc97dc0d1770, 'Les boulettes ne sont pas bonnes cuites dans la sauce tomate... Elles sont molles et n''ont aucune croustillance sur l''exterieur. Mon conseil: les passer dans de la chapelure et les faire frire à côté. Ensuite les napper de sauce.', '2007-07-30T20:44:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16981, 2f721949-fa19-4bf3-8f1f-6879cfcab617, 'Très bien, à une condition: mieux épicer la sauce tomate, et surtout la rendre plus liquide...', '2007-02-08T19:53:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16981, 9ef068fe-aa54-404c-8f46-dfd79b2284c8, 'Très bon, super facile, et ça change de l''éternelle bolognaise. J''ai utilisé de la viande de boeuf, mais la prochaine fois je mélangerais veau et boeuf pour plus de moelleux.', '2005-12-12T19:02:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16981, a7608958-5cf2-4ac9-bb75-9b70e42fcbce, 'Délicieux, toute la famille a aimé. C''est un plat que je referai.', '2005-06-03T11:26:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16981, 12d4e88c-6547-41ac-afad-9d5a5fa0624b, 'Délicieux! Je l''ai mangé avec du riz parfumé, mes invités ne m''en ont pas laissé...', '2005-03-03T21:37:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16981, 63e2d116-930a-42fc-a569-1e36f9b326eb, 'En ajoutant un morceau de sucre, la sauce est encore plus douce.', '2004-03-05T10:11:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16981, 507e78dd-9a6c-4d70-bba5-81f79ec05ab9, 'Les enfants on aimé, les adultes aussi! ', '2003-02-26T14:05:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16981, 61c26aa8-62fc-4a99-8522-f5c2c195d740, 'Recette fraiche et légère.', '2002-11-27T08:49:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81946, e2e3393b-51c4-4205-8206-1ec50107d34f, 'Tres bon. Pour ma part j''ai laissé tombé le côté tarte. On a mangé la viande mélangée au mélange de légumes. Et c''est très bon.', '2020-02-20T03:07:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81946, 877a44f9-194e-4449-bbb8-c0d95b2fae43, 'Bof.
Je n''ai pas mis d''endive parce que je n''aime pas ça. Mais je trouve qu''il y a trop de viande proportionnellement au reste (pourtant je n''ai mis que 500 g !), du coup ça donne une quiche très sèche. Si c''était à refaire, je ne mettrais que 300 g.', '2017-08-27T11:08:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81946, 6f036ee1-a981-494c-8bba-e68fcc98e38d, 'Vraiment excellent ! À faire sans hésiter.', '2013-03-04T10:45:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81946, 676e1f5c-6f0f-459f-8fc2-9dc56bc2a946, 'J''ai adoré ! Je n''ai pas mis d''endives ni de courgettes car je n''aime pas ça mais j''ai trouvé ça vraiment très bon ! Encore une recette dont je vais me resservir pour nourrir mes amis !', '2012-06-05T20:46:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81946, 749ca466-568c-4720-85ec-8e1f45b56c53, 'Je n''ai pas mis l''endive car je n''aime pas et nous nous sommes régalés, les adultes comme les enfants.', '2009-11-17T16:59:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16732, 9aabcace-13bd-40db-813b-5357633ea0be, 'Recette facile et bonne (et bourrative!)   Par contre on sent beaucoup le goût de la viande de porc, la prochaine fois je mettrai moitié de bœuf haché. Je n''ai pas mis de madère et c''était très bon quand même! ', '2010-08-09T15:21:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16732, 0f20d13a-e0ec-4bf3-beb2-c27fd0947773, 'Très bonne recette! Assez bourrative, parfaite pour l’hiver, le madère rajoute vraiment un goût spécial à la tourte c’était succulent.', '2023-03-12T21:08:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16732, 95bb4853-2937-448a-afe2-af0d6c6b8750, 'Je trouve cette recette un peu trop consistante et un peu écoeurante ', '2008-03-20T21:56:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16732, 592ba9c3-88ad-473b-b2ea-58eb63226e32, 'J''ai fait cette recette avec des restes de viande (biche + porc) et de marrons du réveillon. J''ai ajouté quelques épices (quatre-épices et genièvre). C''était vraiment très bon, merci beaucoup!', '2008-01-05T19:05:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16732, 4d564ffc-d21d-43b9-ace7-c365f75189c0, 'Très bon, il faut peut être assaisonner davantage mais pour le soir avec une salade c''est parfait.', '2007-01-24T16:31:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16732, 7fe2273a-d69a-42b9-a599-00710840cda4, 'Quel régal! Excellente recette! J''ai suivi les conseils et rajouté une pomme. C''est sûr, je referai cette tourte très souvent!', '2006-12-11T19:11:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16732, 7735425b-0b4f-4505-9297-4b1ebb042f5a, 'Délicieux, tout à fait de saison pour les fêtes. Mariage réussi de tous les ingrédients, la prochaine fois je rajouterai un peu de 4 épices (mais c''est vraiment très bon même sans). Bravo et merci !', '2006-12-04T20:13:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16732, 06f6d175-16b3-4ffb-a732-b298dc4113ba, 'Très bon, mais je mettrais un peu plus de pomme aussi! Je l''ai accompagné d''airelles pour faire une petite sauce.', '2005-02-27T18:28:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16732, d99669f2-9d84-495a-b4a1-78456e3cdd21, 'Le mélange viande de porc-marrons-pommes est vraiment exquis. Même sans madère, c''est vraiment très parfumé...', '2004-12-10T16:07:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16732, 0b0c986c-5ae6-4c6e-a634-0a7ab8fddb59, 'Très bon!', '2004-12-04T18:43:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (16732, 41a96b7d-1984-4d94-97b8-d893b37631a2, 'Je l''ai faite avec du filet mignon, car je n''avais rien d''autre, le mariage de la pomme avec les marrons délicieux. Pour ma part, je mettrais plus de pommes. Repas très convivial!', '2003-10-28T20:59:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37537, 6d830ae3-8b48-46fe-b4e7-da39a11b2402, 'Recette suivie à la lettre. Excellent !', '2021-08-04T19:21:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37537, 12abdcaa-e551-4bd4-99a7-1e12e116a17f, 'Excellente sauce. Je l''ai déjà faite 2 fois avec un excellent résultat à chaque fois : une fois déglaçage au vinaigre de cidre comme indiqué dans la recette et ce jour au whisky (un fond de bouteille non présentable). Toujours aussi bon.', '2012-08-26T16:24:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37537, 9c7dca94-8a11-4651-8f73-68b5b6ab7a17, 'Parfaite ! En accompagnement de poisson blanc. J''ai juste remplacé la crème fraîche par du lait concentré non sucré. Résultat identique je pense, sauce crémeuse aussi.', '2012-01-27T11:05:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37537, ae24c59b-43ba-46c6-a865-c7457476780c, 'Je referai cette sauce mais en oubliant le sel et en forçant peut-être sur le miel. La prochaine fois ce sera avec du poisson.', '2011-11-27T22:48:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37537, 7ae75645-ba2c-49df-a5db-c942b2f207c1, 'Je n''ai ajouté qu''une cuillère à soupe de moutarde, cette sauce est parfaite pour accompagner du poisson ! ', '2011-11-13T16:13:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37537, f187f0f4-64fb-4c35-a900-c554cbbb7811, 'Cette sauce est délicieuse et très facile à faire avec des produits de base. Je l''ai servie avec du poisson blanc et ça a été un vrai petit succès. Merci pour cette recette! ', '2011-08-13T09:46:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37537, 1d51db52-cd14-4135-8f43-4c87a3d5cbae, 'Excellente surprise ! Je ne m''attendais pas à un résultat si réussi, tout se marie très bien. J''ai servi cette sauce pour accompagner un poulet, au final les invités ont même repris de la sauce pour accompagner leur riz !', '2011-03-11T01:27:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37537, cdba9281-2ab2-4bce-9fb7-092c1e6a2866, 'Quel régal !!! J''ai proposé cette sauce avec un blanc de poulet, une compoté de pommes, et du riz bazmati. Mes invités m''ont réclamé la recette absolument !', '2010-07-14T14:48:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37537, 3aa21dc1-ce6b-47d8-9afc-7f195815800d, 'Un véritable délice ! Ma fille de 5 ans n''aime ni les échalotes, ni le curry; ni la moutarde et elle adore cette sauce. J''ai enfin trouvé la sauce pour le poisson. Merci !', '2010-04-09T23:07:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37537, eaedcefc-5a85-49e4-b62a-c9f4c8f12408, 'Très bon mais j''ai rajouté un peu trop de miel en plus ; c était un peu trop sucré ; la prochaine fois, j''en mettrai moins ; c''est de ma faute ; ou alors j''aurai du mettre plus de vinaigre balsamique.  En fait, le dosage sucré/salé est une question de goût.  C''est une sauce délicieuse et simple à faire avec des ingrédients que nous avons souvent à la maison.  ', '2009-04-01T15:29:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37537, ee5f8ee5-d088-4508-b61b-b161c43d8a0f, 'Génial! C''est la recette de sauce pour poisson préférée de mes enfants.', '2008-05-24T13:10:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37537, 400c8a9c-6e0e-4d8c-9f6a-aa5f9a3d2ceb, 'Merci pour cette sauce. Je l''ai servie avec des gambas grillés. Un vrai régal.', '2007-10-02T18:06:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37537, a7a967dd-f07c-4c55-9237-62a776f1e2b7, 'Quel délice et si facile à faire! Comme je n''avais pas de vinaigre de cidre j''ai déglacé au vinaigre balsamique, une saveur sucrée en plus ! Bravo pour cette recette !', '2007-05-12T21:50:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37537, 5e06de56-8920-4a5d-b4e7-2c3819d22a7f, 'Je cherchais une sauce pour le poisson et je n''ai pas été déçu. Je n''aurais jamais pensé à une association moutarde-miel. Recette facile, rapide et délicieuse !', '2007-03-18T17:25:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37537, f5755382-4c95-4eeb-b5e3-b14466536613, 'C''est original, on cherche à découvrir toutes les saveurs... Succès garanti.', '2007-02-25T21:50:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37537, bcc01e25-0cf7-4df3-b1e1-2bd79f0b37b0, 'Très bon même pour ceux qui n''aiment pas trop le sucré-salé. Je l''ai servi avec un filet de dindonneau. ', '2007-01-01T20:31:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37537, 2426bd63-423a-4c43-b70e-ece27c48d6c0, 'Délicieuse cette sauce, merci beaucoup! (j''ai tout respecté sauf les échalotes manquants à l''appel).Subtile alliance vinaigre/moutarde/miel... Un réel régal! ', '2006-10-29T14:30:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37537, 4f906e7e-00db-41e0-9663-acbd7401da4d, 'Sauce qui marie très bien le goût relevé du vinaigre (j''ai utilisé du vinaigre balsamique) et celle du miel, d''ailleurs ne pas hésiter à mettre un peu plus de miel afin d''équilibrer le goût sucré-salé de cette sauce. J''ai également ajouté du persil pour une meilleure présentation. Une sauce qui a agrémenté un blanc de poulet accompagné de légumes cuits au four (carottes courgettes et pommes de terres) , ce fut un succès.', '2006-05-25T18:06:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37537, be397171-a8ae-47b8-97cc-d0d55c24b49a, 'Je connaissais une autre version mais celle-ci est excellente aussi, que ce soit avec du poisson (truite en particulier) ou avec du lapin. De plus elle n''est pas compliquée à réaliser et se fait au dernier moment donc pas de risque de sauce brûlée ou râtée! Super ! J''ai juste ajouté un peu plus de miel (venant tout droit de chez un apiculteur, c''est tellement bon!) car pour les amateurs de sucré-salé je trouvais que le miel se sentait à peine assez. En tout cas je l''ai ajoutée à mon carnet ! ;-)', '2006-04-02T17:44:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37537, 73539803-c892-461b-b710-0e45bfa99452, 'Pas mal, sans être extraordinaire, recette originale et facile à réaliser, mais je m''attendais à mieux.', '2006-01-11T18:38:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37537, 31340841-356e-4b4b-8dee-f3979d9dc801, 'Merci pour cette recette, c''est délicieux et si simple... On peut déglacer avec du vinaigre de vin, et même du jus de citron.', '2005-12-18T18:42:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37537, abac8710-96c9-40a4-bf50-038ab6499b8e, 'Une sauce originale, qui commence par la force de la moutarde, et se poursuit par la douceur du miel... de surcroît simplissime!', '2005-12-02T14:20:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37537, 515268f3-d687-4db2-9415-fafc2670927f, 'Tout simplement délicieux ! Je n''avais pas de vinaigre de cidre alors j''ai mis du vinaigre de vin et c''était tout de même excellent! On s''est régalé!', '2005-11-03T17:41:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37537, b5c3f781-8ffc-44f9-9fa5-2db592b6f40b, 'Simple et délicieux... Dorénavant, j''adore le poisson!', '2005-09-16T15:36:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37537, cb78e3e3-147d-4820-a140-10fe395e2e87, 'Délicieuse sauce en accompagnement de poisson... Une touche sucrée qui convaincra même ceux qui n''affectionnent pas le poisson!!!', '2005-07-30T16:39:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (349823, 263096e3-d08a-49c5-9676-41b1daefafcd, 'Facile et rapide à réaliser.... Super bon!', '2020-07-09T15:45:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (349823, 4c8ac95b-2079-4aa1-957d-6538cb2dfca8, 'Délicieux ! Pour ma part j’ai pris deux sortes de poivrons ! ', '2019-10-16T09:18:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201296, 620ccded-8474-4282-8991-c6a69eac5269, 'Excellent accompagné d''une salade', '2022-04-13T20:56:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201296, 57c68b8b-5fb8-4ce8-8717-cbc2a2d7402f, 'Je n''attendais pas autant et nous nous sommes régalés', '2022-03-31T20:54:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201296, d8a17a77-04ca-400f-9111-0ce3e84ab51e, 'Pour le goût. J ai fais revenir les oignons poivrons et tomates avec la viande hachée que j ai déglace par de la sauce soja. Par contre je n ai pas salée ', '2021-02-28T21:42:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201296, e710a6ef-b0d2-4c46-b512-1137bdb8303d, 'Petite tarte simple et rapide mais je pense essayer de l’agrémenter avec une sauce pourquoi pas peut-être du burgers', '2021-02-06T14:05:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201296, fd8f98c1-4ec8-4433-bd12-f49c01c5aa64, 'Écœurant ', '2021-01-05T19:56:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201296, b1683091-ea26-46f6-94af-097548155628, 'Très bonne recette mes enfants adorent', '2020-10-02T21:59:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201296, d8a9ccdf-6758-49fb-9369-ec6e232de2d2, 'Parfait ! Rien à dire !', '2020-04-24T15:49:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201296, 4456c967-3c45-4d60-8ade-f23ac0d934fa, 'Très facile et rapide à mettre en oeuvre et franchement délicieux ! Merci.', '2020-01-13T02:56:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201296, f133507b-4c0a-4e35-8a4f-9074a2436135, 'Très bon et facile à réaliser !', '2020-01-12T08:42:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201296, 06154af6-5097-4f3e-b0cf-d1f821d86b6a, 'Trop sèche  la prochaine fois j''ajoute de la crème fraîche.', '2019-10-06T10:25:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201296, 2ceb2721-984c-40c5-b9dd-2dec6457af5b, 'Première fois que j''ai fait une quiche à la viande. Ai respecté la recette en faisant cuire la viande avec deux tomates émincées, un poivron, des oignons et de l''ail hachés. Je n''avais pas de lardons. Tout le monde s''est régalé et a trouvé le plat léger. Une vraie réussite !', '2019-05-30T15:49:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201296, 8a81f63b-cb6b-4348-9e6d-7ed7e1dfd9fb, 'Simple et bon.
J''ai fait revenir la viande avec oignons et ail, ça donne plus de goût.
J''ai fait précuire la pâte et utilisé des tomates cerise. Du coup la pâte est restée bien ferme et pas détrempée par les tomates.', '2019-05-02T14:45:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201296, 026787f6-63fb-45a5-9ab4-6896ce07d3a1, 'Super bon et rapide ! ', '2018-08-27T07:39:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201296, 7148d7cb-dba3-4c66-aa21-bae4f31e5deb, 'Excellent !', '2017-04-10T16:07:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201296, 84dc3290-ded7-4904-bcaa-9ab52c751aa5, 'Très bonne recette, j''ai ajouté de la moutarde sur la pâte feuilleté et j''ai fait revenir la viande hachée avec les lardons, ail et oignons dans la poêle. Pour ne pas avoir trop de liquide dans la quiche il faut enlever l''intérieur des tomates.', '2016-11-24T16:20:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201296, 92f36c0a-124b-4745-9cf5-c6671c61f63d, 'L''odeur est monstrueuse ! Le goût fantastique ! Pour ma part j''ai mis plus de tomates et 1 poivron rouge et 1 vert. Et pour relever le plat, j''ai ajouté un petit peu de sauce tomate épicée. Une tuerie !', '2016-02-01T22:45:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201296, a19761eb-e68b-4350-a48f-4fd5fb2e3daf, 'Très bon j''ai juste ajouté 2 gousses d''ail hachées ', '2015-11-09T21:31:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201296, 3b2d1bd2-e9a1-47cb-8bdd-b50be78fe685, 'Très bon j''ai remplacé les poivrons avec un oignon que j''ai fait revenir avec la viande. La prochaine fois je mettrai un peu plus de tomates. Rapide pour un soir avec une salade verte ', '2015-08-16T12:03:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201296, 6a2e555d-df6f-4612-8cf3-e471830193fa, 'N''ayant pas de tomates je n''en ai pas mis mais c''était tout de même très bon. J''ai ajouté un peu de moutarde pour relever le goût.', '2015-05-26T19:26:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201296, d1ef0ea5-becf-402b-a4f5-a97c34042243, 'Très bon, mon homme adore!', '2015-05-26T14:17:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201296, 10db02be-091e-4359-897e-1de6e7a30258, 'La prochaine fois j''ajouterai de la moutarde', '2015-02-06T16:57:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201296, ff621252-d5b0-4ed3-8363-365a412000e5, 'Parfait, j''ai mis 350g de viande hachée, 100g de lardons, 2 tomates, j''ai fait revenir la viande avec un peu d''oignons et d''ail. Par contre forcément, avec deux tomates il y avait du jus et la pâte était trempée, mais je n''ai eu que des compliments malgré tout.', '2014-06-15T10:22:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201296, 214de950-05a6-4e67-a0d1-138fe4fad805, 'Il faut passer les oignons à la poêle avec un peu de persil. ', '2014-06-10T23:40:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201296, 5fb18ea4-e110-432d-af1d-18e4a8f57b8e, 'Délicieux ! J''ai rajouté avec les oeufs battus un peu de crème liquide , meilleure avec 2 tomates et des champignons :) ', '2014-04-14T16:22:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201296, 65d6bb12-781d-4258-99f8-f97cd5e7a08a, 'Excellent. Je me suis autorisé à ajouter un oignon émincé et cuit avec la viande. Aussi bon chaud que froid le lendemain.  ', '2014-04-07T12:55:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201296, 31e02edb-46ed-4568-b3ec-44f898975e9b, 'Excellent !! J''ai fait précuire les lardons après avoir fait cuire la viande hachée et j''ai mis juste une moitié de poivron rouge et 2 tomates. Un pur régal !!! Ça change de la quiche, que pourtant j''adore ! Merci pour cette recette fantastique !!', '2014-03-25T22:54:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201296, e639d171-704e-43f9-9f9e-322fac7f08e1, 'Très bon, ça a du goût. Ca change des quiches habituelles, il n''y a pas de flan. J''ai utilisé un poivron rouge et pas de tomate. Attention à ne pas trop saler car les lardons donnent déjà du goût. J''ai cuit les lardons à part et la viande hachée à part avec du persil frais et le poivron, puis dégraissé le tout sinon cela aurait été trop gras. A refaire en tout cas', '2014-03-19T20:03:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201296, fd931828-2bc4-46e9-8522-43444c01a07f, 'Super recette très facile, rapide et très bonne. Merci, mon mari a adoré... Proportions parfaites, à faire et à refaire... ', '2013-12-07T00:19:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201296, e8702726-89f0-4c6d-9ac4-8b0e15ccace0, 'Super bon, les enfants aussi ont aimé. J''ai mis 1/2 poivron jaune. Je referai cette recette très facile. Merci.', '2013-06-09T19:56:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (201296, 65a854e1-7d0e-4e45-9417-1ac4234781bc, 'Ici, tout le monde a adoré. Très facile à réaliser. J''ai mis un poivron entier dans la recette.', '2012-11-23T18:30:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (95766, 66986272-82d5-4507-9820-84149bd9914d, 'Très bon mais j''ai presque du doubler le temps de cuisson je ne sais pas pourquoi ...  Mais c''était délicieux ! ', '2015-05-18T23:08:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (95766, 4bc89879-4620-4fbf-af27-fbfaa275c89c, 'Magnifique : faite deux fois et vraiment rien à dire, c''est un régal.  ', '2015-02-05T21:34:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (95766, a92767d4-94f0-4738-a03e-6ffa58628730, 'Très bon, mais attention car cela rend beaucoup de jus dans le fond, mais c''est mieux que d''être sec quand même.', '2014-04-26T20:42:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (95766, bc39b2fb-1323-47fc-94cc-65cf16918405, 'Personnellement je n''aime pas la coriandre alors j''ai mis d''autres épices comme par exemple du piment d’Espelette dans la viande et je rajoute un filet de crème fraîche avant de mettre les légumes et c''est délicieux !!', '2014-03-06T16:05:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (95766, aa152648-11d2-4778-9eff-f9fc44b18081, 'Vraiment pas terrible. Très fade même avec des épices ! A éviter', '2012-11-27T23:03:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (95766, 7aff8848-0d97-4027-af69-24eac93dcb68, 'J''ai précuit le haché et les poivrons + tomates et les pommes de terre avant de les mettre dans le plat au four. J''ai aussi assez bien épicé le plat. Succulent !', '2012-08-26T17:20:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (95766, 0b0c7808-4607-4ce4-b9ab-eb64b480a672, 'Et bien apparemment nous sommes les seuls mon mari et moi à ne pas avoir apprécié cette recette. Pas une seule fois vous indiquez de saler les ingrédients (je l''ai quand même fait et heureusement). A mon avis, il faut augmenter la température du four ou le cuire plus longtemps car les pommes de terre n''étaient pas cuites (malgré la pré-cuisson rapide à la poêle), ni les poivrons. Il y avait beaucoup de "jus" dans le fond du plat. Pour une recette "orientale" je trouve qu''il manque vraiment des épices ou ingrédients permettant de relever le goût, c''était très fade.', '2012-04-24T14:54:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (95766, c85dce5e-d926-450c-8b6c-fd62ce93c055, 'Recette excellente, un goût soutenu et très simple à réaliser.', '2011-11-15T13:56:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (95766, 333aae3f-0755-481f-ab78-cbff3d759dfb, 'J''ai suivi la recette à la lettre, sans le colorant. C''est un vrai délice ! Merci !', '2011-10-17T16:18:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (95766, 6f55844e-9118-47b8-a7c9-e72f8e3a3199, 'Très bonne recette. J''ai aussi fait revenir la viande avec l''oignon, l''ail, la coriandre et le colorant. J''ai mis également mozzarella et parmesan, un vrai délice ! A refaire ! Tout le monde a aimé.', '2011-09-13T18:33:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (95766, 3bc46951-23a5-4520-8b1b-14ffde93e627, 'Un succès ! Je n''avais pas de pulpe de tomates alors j''ai mis du coulis, j''avais par contre des tomates fraîches qui ont apporté leur propre pulpe. J''ai mis seulement 1 oignon et 2 gousses d''ails, j''ai fait légèrement revenir la viande dans la poêle avec sel, coriandre ail et oignon avant. Et j''ai également précuit les pommes de terre à l''eau. Résultat 45 min plus tard à 200°C dans le four : c''était parfait. Merci pour cette excellente recette !', '2011-05-15T13:14:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (95766, 63e96632-b00e-497b-a03b-fd2592e1d252, 'J''ai fait cuire plus longtemps à four doux (190°C) : 1h30 sinon le poivron est trop croquant à mon goût', '2011-02-03T10:02:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56835, b22f2158-2af3-440f-86ad-a1337bffab51, 'Un petit truc pour passer de 4 à 5 : ajouter deux ou trois cuillères à café de maizena dans la marinade, la viande sera encore plus tendre', '2015-11-16T09:50:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56835, 173a4897-05d7-4c88-8033-1d334ac998cd, ' un vrai délice avec des côtelettes de porc. J''ai fait mariné presque 4 heures. La prochaine fois je les mettrai toute la nuit. ', '2014-05-25T21:24:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56835, 76a3600f-c65f-48c9-8eb6-89b1da07676c, 'Vraiment très bon, rien à changer, la viande n''est pas sèche du tout, et ça caramélise un peu à la cuisson, je la referai.', '2012-09-06T22:51:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56835, d64b02a2-d49d-4b5f-83d4-4a1d7382d73a, 'Excellent et la viande n''est pas sèche, déjà faites 2 fois. Et pour les oignons qui restent de la marinad, je les ai égouttés et je les ai faits revenir à la poêle avec des pommes de terre, tout simplement excellent.  ', '2010-07-16T10:16:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56835, 10cde516-deed-4e36-b976-44d2c577c5c9, 'Merci. Je n''ai pas mis de rhum car il y avait des enfants, mais j''ai bien aimé ce petit goût.', '2010-06-22T22:39:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56835, 6c61eda7-96ec-435f-a017-3d5815c30bc2, 'Franchement bravo, je suis ravie du résultat, et cette recette a séduit mes invités. J''ai fait mariner la veille, et les blancs de poulet ont vraiment pris un bon goût. Comme il m''en restait, j''ai coupé la viande froide en petits dés que j''ai mis dans une salade : succulent aussi !  Et puis c''est pratique, rapide, facile, pas cher... et ça reste diététique quand même ! Merci !', '2010-01-17T21:33:32+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56835, a9e6d6d9-e0d1-455b-ac17-c657af6d16ed, 'Nous l''avons trouvée un peu fade, la prochaine fois je mettrais plus d''épices, ceci dit, la viande n''était pas sèche. ', '2009-05-26T20:24:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56835, 68de8c89-142a-4927-befa-6cbfb02728e2, 'Extra, tout le monde a adoré, j''en refais pour la 2ème fois.', '2008-05-03T17:21:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56835, f1ebed39-d0ba-41e6-8163-69e4918ec128, 'Rien à redire. J''ai utilisé cette recette pour des brochettes de dinde, tout le monde s''est régalé ! Merci.', '2007-06-11T10:13:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56835, c725a828-6001-4997-88a2-7f56ce8e4aac, 'J''en fais souvent ,avec tous types d''ingrédients, celle-ci est très rapide à faire et surtout succulente. Laissez libre à votre imagination et inspiration.', '2022-09-24T00:52:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (56835, c5254f21-008b-47b1-b825-99e0aa5620eb, 'Cela attendrit bien la viande d''agneau.', '2018-04-22T21:07:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, e1149670-eb5e-4a05-8f83-9d129f8f5254, 'La quantité d''épices est insuffisante il faut épicer la viande et réduire la quantité de beurre ', '2016-11-05T21:11:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, b5979f03-f998-4ff6-8114-40881cbc90d7, 'Très bon et moi j''ajoute 1 oeuf, du pain de mie trempé dans du lait pour pas que ça soit sec et que les boulettes se tiennent.', '2016-07-28T11:43:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 1997514a-215a-48b9-a74e-bee595875b83, 'Recette bof. Pas assez d''épices pour relever le plat. La sauce est bonne mais la viande est sèche une fois cuite. Plat assez plat. Recette à modifier.', '2018-11-24T09:27:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 9d30daf6-67f6-42e0-8814-4250ab95eb89, 'Délicieux ! J''ai ajouté du raz el hanout et j''ai été très généreuse sur le cumin. Tout le monde a adoré ! A refaire !', '2016-02-13T11:02:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 72fa555e-7e4e-4c48-82f7-fe29e89206bb, 'Je suis marocaine. Ce plat gagne en saveur quand on le cuit dans un tagine. On met un peu de toutes ces épices à la viande hachée avant cuisson. Un vrai régal !', '2014-09-09T22:08:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 032732d2-aa19-45f8-b5fc-44df220bafb5, 'Recette sans grande originalité à mon goût. Cela à surtout le goût d''une sauce tomate agrémentée de cumin. Pour ce qui est des boulettes j''ai rajouté un oeuf et un peu de chapelure afin de les rendre moelleuses.', '2009-02-24T12:49:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 6956756b-c6e6-4ac9-b213-39300269ca69, 'Bonjour. Avec de l''agneau haché c''est plus gouteux ou mélange boeuf agneau.  Et là ce n''est pas sec', '2023-05-27T21:49:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 69a05ef1-ba93-4de1-a7fd-5ab1ade5687b, 'Vraiment excellent ! J''ai mis du paprika a la place du piment et la moitié du beurre indiqué. Avec du riz blanc, recette super bonne et facile a faire ', '2020-11-22T11:01:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 4af00f09-18dc-409f-8a61-ca3005eebecd, 'Ajouter de l''ail haché.', '2019-10-09T11:43:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 5b63c92a-e073-44bd-8abe-e428919ad91a, 'Un des plats préféré de mes enfants. J''ajoute du ras-el-hanout et je sers avec du riz blanc ou du couscous.', '2018-03-10T07:42:10+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, b0f19043-b52e-47b9-a8c6-956589ced1fa, 'Excellentes accompagnées avec du riz (à mélanger avec la sauce). Attention cependant à la cuisson des boulettes qui peuvent être trop cuites et donc un peu sèches, ce qui a été mon cas lors du premier essai de cette recette.', '2016-04-17T19:05:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, f5477f86-20a0-416c-a0a4-82db7482de18, 'Bon mais les boulettes sont un peu sèches ..le mélange des épices reste doux', '2016-01-16T19:41:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 16716cca-129a-40f4-b967-2ff2bc41493e, 'Très facile à réaliser et un plus c''est délicieux à faire et à refaire !!! ', '2015-07-14T12:49:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 9d8fed14-dae8-4d12-9fd5-64359660f8d1, 'Je fais cette recette depuis longtemps et c''est toujours un réel plaisir ! Onctueux, savoureux, délicieux ! Tout le monde se régale, merci ! ', '2015-04-26T16:50:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, e0dd8a23-c80b-4603-be6a-71a6fa53fc9e, 'Saveur agréable mais beaucoup trop sec. Diminuer le temps de cuisson !', '2015-03-11T20:46:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, ec9a1325-5c3e-4ddf-9341-ef991350e19a, 'Tres bien, simple, tres bon !', '2015-02-05T18:47:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, ec2fd2b3-0cee-47b2-9097-4eeb6d11429b, 'Très bonne recette, mais j ai mis aussi les épices dans la viande et de la maïzena pour qu''elles ne se défassent pas à la cuisson.', '2014-12-20T20:48:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 72438e60-a790-4b13-b684-edabc2add9eb, 'Bon et simple, au top !', '2014-12-01T17:27:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, f46a08a8-e77f-4b79-898f-8fea0cf9269e, 'Très bon. J''ai préféré des tomates fraîches et j''ai ajouté un blanc de poireau coupé en fines lamelles. un pur délice', '2014-11-07T12:26:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 76a4c093-163f-4b2e-8866-5c67f53f8c8b, 'Accompagnées de tagliatelles, c''est un régal !', '2014-11-01T22:04:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 95c06585-45c6-4073-94c2-232b740ab15b, 'Délicieux et très vite fait; rien à changer !', '2014-10-05T16:20:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 82db401d-5785-4713-8d11-76d8a7f49506, 'Très bon mais la prochaine fois je mettrais du cumin directement dans les boulettes.', '2014-09-25T17:59:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 11b7482c-6139-4b99-9906-838f2b3834a3, 'Je n''avais pas de cumin, j''ai mis du curry. Mes enfants se sont régalés, à refaire.', '2014-09-17T19:05:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 4d13ea05-d0fc-4780-99ee-387b274d0cec, 'Excellent ! J''en referais !   ', '2014-09-15T22:04:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 154776c5-705c-440e-aa46-3cae09f3efb3, 'J''ai ajouté aussi des merguez, les enfants ont aimé même avec les épices, à refaire ! ', '2014-09-15T20:08:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, c2e7ec26-b719-453b-88c3-faa6ff09e07f, 'Juste excellent... à refaire.', '2014-09-14T17:53:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 27af3bd8-f6d1-4e83-b77a-312a3df7d0ce, 'J''ai mis de l''huile d''olive à la place du beurre, 2cc de paprika et un bon bouquet de coriandre fraiche en plus du persil. Servi avec du couscous aux fleurs. Délicieux!!', '2014-09-13T17:47:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 8858cd13-201e-498f-bf8c-083b6d1ca131, 'Pour certains de mes convives les boulettes étaient trop sèches à leur goût cependant la sauce au cumin et au paprika était excellente ! ', '2014-09-13T00:02:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, c905c65e-e7bc-45d2-b06e-1f746591231c, 'Je vous conseille de remplacer le persil par de la coriandre ;) Cela donne un goût plus authentique.', '2014-09-11T21:24:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, f1cd0c71-d68e-4ea1-a446-1a0ae213b9d4, 'Délicieux ! J''ai mis de l''ail et mélangé du pain/lait à la viande.', '2014-09-11T17:55:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 39bbf3b8-c6ee-44de-aeed-ea939a09ac33, 'Très bon. J''ai ajouté un œuf et de la chapelure dans la viande, ainsi que les mêmes épices que la sauce. ', '2014-09-10T23:04:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 01e14384-1695-48df-bb3e-1ea186da89dc, 'Mon trésor de 2 ans refuse habituellement les viandes, mais là il a adoré en plus c''est un plat complet avec le riz, merci.', '2014-09-10T21:07:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 12fdb42d-8daf-4d5e-93ec-92a4e0269c5f, 'Fantastique, je me suis régalé', '2014-09-10T16:18:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, cf7ef409-e880-49ee-bc99-84a884e0c71f, 'Il n''y a rien de marocain dans cette recette ! ', '2014-09-09T20:38:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, d5792b7d-ea8f-4291-940a-d6c634647d89, 'Super !!!   ', '2014-09-09T19:53:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 31643a64-3805-4f76-b84c-dc645762ad5b, 'J''ai mis moins de beurre et j''ai cassé des oeufs par dessus : très bon ', '2014-09-09T13:06:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 6ba1b9a8-3f97-468b-8dff-0415b757fd57, 'Très bonne recette moi aussi j''ai ajouté des merguez. Facile à faire et savoureux.', '2014-07-13T23:15:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, cc6adb31-a2f3-41c4-a404-31c47faeb598, 'Très bon, ne pas hésiter sur les épices ! Attention, la photo ne correspond pas vraiment, il y a pas mal de sauce tomate qui reste à la fin avec les boulettes de viande !', '2014-07-07T16:02:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 8d2390c0-c63d-4653-a843-78b0db499fa5, 'C''est une très bonne recette, à la fois simple et goûteuse. Le cumin apporte beaucoup de douceur au plat en contrebalançant l''acidité de la tomate. J''ai simplement divisé par deux la quantité de beurre et c''était amplement suffisant au final. La prochaine fois, et pour des boulettes plus moelleuses, j''ajouterai juste un peu de vieux pain trempé dans du lait à la viande. ', '2012-01-08T15:45:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 1b32ded3-3ade-44ae-976a-4f51465029b3, 'C''est vraiment super bon ! Faut pas craindre l''épicé ! Par contre, j''ai mis de l''huile d''olive (un filet) à la place du beurre.', '2011-11-08T18:18:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, ec6bb464-8e19-4e24-b6e2-87451177605b, 'J''ai aussi diminué la quantité de beurre et ajouté un peu d''ail. C''était parfait. Merci pour cette recette.', '2011-04-16T18:17:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, b84535a2-509c-4c21-bbb2-91034e109d7e, 'Boulettes faites avec du hachis bœuf-agneau déjà épicé et revenues à part avant d''être jointes à la sauce. Je conseille de diminuer fortement la quantité de beurre.', '2011-04-03T23:22:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 2d48eadd-e559-4728-a265-a91237db383b, 'On s''est régalé. Je les ai servies avec des pâtes al dente. Les enfants en redemandent.', '2011-03-19T14:59:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 8739aa54-fe56-4104-ad1a-92fbc1bba3c5, 'Je l''ai fait à la lettre sauf que j''ai ajouté du riz cru qui a donc cuit dans la sauce. C''était excellent !', '2011-02-18T19:56:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, fcaf6b3a-9631-44af-aae5-a5eaaddb0562, 'J''ai ajouté des merguez (en ayant pris soin d''enlever la peau) et mélanger avec la viande hachée c''est délicieux car moins sec. A refaire c''est très bon avec la semoule parfumée', '2010-09-09T10:26:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 8bdf482f-fb1b-40d4-8a89-ad398de6b7a0, 'OK c''est simple mais très apprécié des enfants (personnellement je triche en achetant des boulettes de veau déjà prêtes chez mon boucher que je retravaille rapidement pour refaire de plus petites boulettes) et je remplace toutes les épices par des épices spéciales tajines, vraiment très parfumées. La viande est hyper moelleuse et avec la sauce, mêmes les haricots verts passent sans soucis!!', '2009-03-09T19:33:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 45bad1b3-1ff6-44f0-8c6d-e01bea8f2beb, 'L''original est excellent! Avec de la chair à saucisse c''est bon aussi...un poil plus d''épices pour relever (car j''aime bien quand c''est bien relevé). Sinon mes invités ont trouvé délicieux...et moi aussi!', '2008-07-21T23:27:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, e3bfb4e7-15a0-443e-a86b-f0e06ae44b16, 'Délicieux!', '2008-07-03T22:22:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 92a336f8-429f-48d0-9c1c-4fc969a3a548, 'La viande est restée un peu sèche mais servie avec un mélange de céréales (blé, seigle et épautre), c''était bon.', '2008-05-23T13:16:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 25b93133-70a9-4d04-9458-d01e4aefcf74, 'Franchement sympa. Bon j''ai fait des boulettes plus grosses pour plus de moëlleux, et je les ai faites revenir à la poêle pour le goût de grillé. Sauce sympa, surtout accompagnée de semoule de couscous. Temps de cuisson vraiment trop long, pensez à couvrir pour ne pas que la sauce réduise trop ou brûle. Je l''ai fait avec du boeuf mais je pense que se serait mieux avec de l''agneau.', '2008-04-08T18:05:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 5b0849d1-d762-4549-97c4-0238262c6ce7, 'Bien la sauce est très bonne mais la viande est trop cuite à la fin et pas assez moelleuse c''est un peu sec.', '2008-03-22T17:55:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 3549d713-e264-4f19-a987-0fc39a3a4a07, 'Cette recette est simplement délicieuse. J''ai doublé les proportions de paprika et cumin pour un goût relevé. Toute la famille a adoré. Merci pour cette excellente recette !', '2008-02-22T21:48:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 2d59bea7-5abf-4e4b-9e40-f1204f16930a, 'Fais avec trois steacks hachés réduit en "boulettes". C''était super bon! Mon chéri a adoré! Servi avec du riz blanc tout simple. J''aurais la main plus lourde sur les épices quand même la prochaine fois.', '2008-02-05T14:45:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, cc7d7180-924f-4eeb-a0e6-b163f111d07f, 'Je n''avais pas toutes les épices sous la main mais même avec les moyens du bord c''était excellent. A refaire surtout que c''est très raide à faire. Moi qui n''aime pas trop cuisiner !!! ', '2007-10-12T19:07:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, ee2e34a6-c06b-4e5c-a1fa-d74e2cf408d9, 'Très très bon, j''ai juste fait griller à feu fort les boulettes avant de les mélanger.', '2007-09-19T14:42:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, a738b295-44d1-4ddc-b44f-d0091060a7dc, 'Excellent...Je l''ai fait avec du agneau hâché (épaule) que j''ai mélangé avec ail et persil. ', '2007-08-08T11:44:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 51cced25-675f-439f-b1c0-9f6f54d19e91, 'Un peu long à cuire mais très simple à faire. Et en plus, c''est super bon, tout le monde à adoré. N''hésitez pas à sevir les boulettes dans une grande assiette et de manger tous dans le même plat avec du pain (à la marocaine). Je le fais avec des invités non habitués et c''était super sympa.', '2007-07-05T23:16:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 3cd9d494-42a6-4507-9be1-a6d58a41e0aa, 'Un plat vraiment sympa et surtout simple à réaliser pour un débutant comme moi. Pour moi, on peut doubler les préconisations données pour les épices.', '2007-05-19T03:01:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, d6181175-356a-4fcb-8d59-33b7bd718b23, 'Je l''ai fait pour une soirée entre amis... tout le monde a adoré!!! J''adore ce petit coté ''relevé'' !', '2007-03-31T15:54:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (17252, 553fa7e2-ebdf-4f81-8be8-d654016add8c, 'Hyper simple à faire et très bon.', '2007-03-25T22:57:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 25ecbce3-ef72-493c-bb60-c00355dc0659, 'J''ai divisé par deux la portion de crème fraîche. Un peu gras mais simple et chaleureux. Ce plat est un véritable délice! Merci', '2021-10-01T12:57:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 15f8ab0b-b7a2-49dc-a0e7-f7013f73747f, 'Très agréablement surprise, j''ai adoré. Pour mon plat 20 minutes au four ont suffit.', '2017-11-07T16:40:09+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 01ab3233-9132-43f7-9571-b5584bf2725a, 'J''ai fait cette recette après avoir lu les commentaires car elle ne donnait pas trop envie, et c''est un délice ! J''ai mis du cumin, de la crème liquide et du fromage râpé. Par contre au lieu d''accompagner avec de la purée, la prochaine fois j''ajouterai des pommes de terre avec le chou.', '2014-01-27T13:14:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 049509fd-4f78-43d2-9592-9124a6a3f400, 'C''était très bon. Uniquement avec du bœuf, j ai remplacé le cumin par le curry et ajouté citron, citron vert c''était excellent avec une salade verte et ça change.', '2013-01-22T22:52:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 0bd2b551-5051-4e73-ac58-5b0e505fe56e, 'Très facile à faire et résultat parfait. Fait avec du boeuf uniquement, et du cumin. J''ai mis du râpé par habitude, mais on doit pouvoir s''en passer. Tout le monde aime, enfants compris. Va devenir un classique cet hiver. Merci.', '2012-10-06T18:22:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, bd4fe5b1-dc59-46a6-b814-4f26dd6b6921, 'Excellente recette, on est tous fans à la maison! Bonne variante de recette à base de chou', '2023-10-27T10:10:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 78d1e5d5-1cdf-4b8c-8bd4-944a123a68fc, 'Excellent et très bien décrit. Variantes retenues : cuisson 20mn, viande bœuf, cumin, emmental au dessus. Parmesan en deuxième couche. Poivrons. ', '2022-10-19T08:59:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 2a4a8372-d5d8-49c1-a504-7b603b4634be, 'Excellent recette ! Très apprécié par tous mes ados qui d''habitude ne sont pas très fans de chou...', '2020-12-19T12:32:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 6274c619-10e7-400e-98f2-0ea212eb9da5, 'J’ai pas trop aimé perso ... ', '2020-11-30T14:37:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 8f858035-f695-41ba-b727-2d1dd2eee46c, 'TRÈS BONNE RECETTE. ?Je me suis permise toutefois d''ajouter mon "grain de sel" en ajoutant au moment d''intégrer le choux blanc râpé dans le faitout (comme convenu dans la recette initiale) 1/3 d''une bouteille de Pinot blanc ( ou Sylvaner...). Je l''ai aussi servi avec une bonne salade verte. Top !', '2020-10-14T12:10:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, ba2c968e-e82c-4fe3-9b7e-733677d577fe, 'Bonne recette. J''ai ajouté des lardons et moins d''huile.
Lait écrémé et crème semi épaisse. Ça marche aussi. 
40 minutes 180°C en chaleur tournante.', '2020-05-15T21:36:16+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 1f9fa0da-de68-4c2b-b167-84ddac0429ef, 'Très bonne recette. Je l''ai fait avec du hâché de veau et des lardons, cuisson traditionelle à 190 degrés 45 mn. Excellent ! Je garde la recette et la referai. Merci beaucoup.', '2020-04-22T22:30:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 62e12fce-af01-4c05-8ffc-4b3ef56c1f8b, 'Recette qui me rappelle mon enfance en Lorraine.', '2020-03-08T12:23:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 51bdf3c0-bc71-4e69-9edf-b6cb71028fa6, 'J''ai adoré cette recette, que j''ai personnalisée avec 2 poivrons et du paprika en plus du cumin. Comme viande, j''ai mis 4 steaks hachés et une barquette de lardons. Délicieux et très original, merci !', '2020-02-28T09:04:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, d53b3cd9-a869-4891-9e35-c29b6fad4795, 'Très bonne recette, je l''ai faite avec du cumin, et servi avec du riz.', '2019-04-20T18:32:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 028e58ef-065a-4ebc-89e0-dd81c6b019b3, 'Délicieux... ! Moi qui n’aime pas le chou j’ai adoré... J’ai juste modifié les dosages (600 g de viande hachée 100 ml de lait, 100 g de crème fraîche, 2 oeufs, 2 oignons, et la moitié d’un chou) avec une salade et un trait de vinaigre balsamique !', '2018-12-05T22:37:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 3378e3d2-57d1-4f5d-b21a-9eb3a26965b4, 'Recette que je refais régulièrement. Rapide et bon. Les jeunes et les moins jeunes se régalent !
', '2018-03-11T10:10:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 8658278c-0da9-4778-85ff-893f44309014, 'Délicieux.', '2017-01-23T20:07:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 485f73da-e4d8-44cf-ac3e-7f660b743088, 'Assez fade et sec ', '2016-12-12T14:40:37+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 91405892-fa1d-4ce2-863a-84d4d5bd2708, 'Très bon ! ', '2016-11-04T20:11:12+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 28510735-b482-4008-9279-ee04036bcf38, 'Ma famille a adoré. J''ai mis que du boeuf haché et du cumin.', '2016-04-11T20:08:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, e35e1882-d7a8-495a-a28e-df809320f4c3, 'Simple et bon ! J''ai mis du cumin à la place du carvi, et du papier sulfurisé au fond du plat.', '2015-02-04T00:34:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 1e992f9a-b3f1-4ea5-88e4-26121e3dc56a, 'Bon, ça change ! ', '2014-09-30T15:01:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 50a94e43-79f0-460c-9ac7-731673e9bbe1, 'Tout simplement excellent, simple et rapide. Tout le monde a adoré même les plus difficiles ! ', '2014-09-09T18:54:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, e522df0c-437f-43a3-bbde-bfebabd31fa4, 'Très bon ! Même mon fils de 9 ans a adoré... Simple et efficace. Merci pour cette recette.', '2014-02-18T18:17:22+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, cfb297dd-19f4-4414-a17f-ee4bd6a08739, 'Très bon goût et simple à faire.', '2013-10-11T15:27:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 6d390875-9ceb-46a2-a3fb-8c08cc4c7fbb, 'Rien à ajouter tout simplement excellent !', '2013-07-04T12:20:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, f6f6ba0c-74aa-4e35-855c-141ce6cd3d17, 'Simple et excellent, j''ai remplacé le carvi par de la muscade.', '2013-05-24T22:41:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 0dc7e408-6087-4c35-ab4e-9fae445d4597, 'Même mon père qui n''aime pas le choux a aimé ! Très bon !', '2013-05-12T15:00:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, be90f1d5-8bae-4780-a206-bb730e93090a, 'Très bon !', '2013-05-11T18:03:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, b107d6a0-22fb-4396-b8c5-c612411ca3c5, 'Très bonne recette mais avec du gruyère râpé dessus. ', '2013-04-17T01:51:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 87e80d32-8523-49c5-8908-cfdc4a526dea, 'Nous n''avons pas aimé. Le mariage du chou et du carvi n''est vraiment pas fameux. ', '2013-04-01T00:38:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, d8bef4f6-c229-46cb-88ae-d8c53f55cd69, 'J''ai  choisi le cumin et un peu de gruyère pour gratiner à mi-cuisson simple, rapide, gourmand et très économique.', '2013-02-24T21:33:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 840c0268-70e3-4aba-ac43-16531db2ce7f, 'Recette que je referai certainement. Facile et excellente. J''avais oublié le cumin mais il ne m''a pas manqué du tout. ', '2013-02-02T18:20:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 7d0f01bd-264d-4c17-99e9-d46f10cb0c97, 'Magnifique !!! Un petit verre de vin blanc dans le plat qui va au four....', '2013-01-29T16:08:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 68e40f2f-5a75-4429-923e-454375b098f7, 'Une super recette, facile à faire, on a adoré !', '2013-01-26T09:00:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, fbd2bb51-046a-4444-9585-7bab13844414, 'Au vu des ingrédients, je ne m''attendais pas à un tel résultat, c''est vraiment hyper bon ! Petites variantes : j''ai ajouté des carottes en même temps que le chou, j''ai relevé avec un tout petit peu de sauce soja et j''ai mis 40 cl de crème liquide (en remplacement du lait et de la crème épaisse) Merci ! ', '2013-01-25T23:01:18+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 44886218-f382-45a2-91a7-284c68048b36, 'Franchement surprise de cette recette. Une nouvelle façon de manger du chou qui a pas beaucoup plu... ', '2013-01-25T21:58:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, d7bf0afd-1c84-4c88-8018-fbd7d992b457, 'Excellente recette de chou blanc. Ça change du chou bouilli ! J''ai servi quelques pommes de terre à l''eau avec, un délice !!! Mes enfants ont apprécié !', '2013-01-23T14:43:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 97d611a4-eb2b-41dc-86a1-419cd1e05b63, 'Très bien quand on ne sait plus quoi faire de son chou ! Je l''ai fait blanchir 2 minutes pour enlever l''amertume et j''ai ajouté du râpé à la recette. Il manquait un petit quelque chose, du coulis de tomate aurait fait l''affaire.', '2013-01-22T15:01:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, e561fc32-d74c-4524-9062-ae5b79a7b39e, 'Fait avec du curcuma (car pas de cumin...) et c''était excellent ! A refaire !', '2013-01-21T15:12:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 9d350701-e518-42b9-8b21-10750eac6b18, 'Bonne recette. Sympa.', '2013-01-21T11:20:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, e52b2fb0-1bce-4c01-b096-bc8a230c6e9e, 'Excellente recette ! Très gourmande, très bon marché et très facile. A refaire sans hésiter. Merci pour cette recette !', '2013-01-21T10:09:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 43a06599-2aa0-41e9-afa7-85dbc96aea92, 'Excellente recette, un bon plat d''hiver qui change des préparations habituelles.', '2013-01-20T12:51:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 52bcc48e-553d-4789-8654-4979c457f80f, 'Je n''ai mis que du bœuf. En suivant les différents conseils, j''ai rajouté des lardons, du sucre contre l''amertume et du gruyère râpé pour faire "gratin". Je n''avais pas de lait donc j''ai mis une brique de crème liquide, et à la place du carvi (que je n''avais pas non plus) j''ai mis une cuillère à café de coriandre en poudre. Top !!!', '2013-01-18T17:04:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 3fbddcbf-0313-42a8-9bc4-70e8c1d90679, 'Vraiment excellent !!! Mon fils qui d''ordinaire rechigne sur tous mes plats... Il a vidé son assiette en un rien de temps !', '2013-01-18T16:03:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 295beb9d-e7ca-4a1d-b597-dc9f3659910c, 'Une façon différente de cuisiner le chou. Mon fils en a redemandé.', '2013-01-18T09:03:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 19b2a343-3ec2-46b2-86d7-204e1ee7d1c2, 'vraiment très bon ! mes enfants ne sont pas trop adepte du choux alors j''ai aussi mis des pommes de terre (que j''avais fait cuire à la vapeur avant) et ils ont appréciés ! merci', '2013-01-17T23:52:13+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 2fb64328-c045-469c-ac87-c9dc1aa327a5, 'Très bon ! Moi qui ne suis pas fan du chou, ça m''a plu. Le goût est très doux. Je n''avais pas de crème épaisse, alors j''ai mis de la crème normale à la place de l''épaisse et du lait (40 cl de crème normale). Pour la cuisson, j''ai retiré après 25 minutes car le dessus commençait à noircir. C''était déjà assez cuit ! A refaire, je mettrai juste plus de viande.', '2012-11-16T12:41:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, ab2f5fe9-9b80-4192-b248-c8eae9fa6416, 'J''ai mis des lardons natures à la place du steak haché. Plat complet et bon. Attention à ne pas trop faire cuire le chou et ajouter 2 sucres pour éviter l''amertume. Ça change en tout cas des salades crues, des potées ou des soupes ! Merci !', '2012-10-16T13:22:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 455736b3-bdbe-476b-819f-bb5b33e69671, 'Bonne recette pour utiliser le reste de mon chou... Cependant, je trouve (et mon compagnon aussi) qu''il manque un petit quelque chose... Nous n''avons pas trouvé quoi, il va donc falloir refaire cette recette en faisant des essais peut-être en ajoutant des poivrons, Des tomates... A suivre donc mais recette de base adoptée !', '2012-10-14T14:56:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 9e1451fb-5486-4605-b8d9-4ca81d13634c, 'J''ai fait la recette 2 fois. La première, j''ai suivi la recette comme indiquée, la 2ème fois je n''ai pas mis du lait et crème, dans une marmite sans passer au four, j''ai ajouté à la fin une cuillère de menthe séchée et un citron... C''est un délice. A essayer.', '2012-09-10T16:59:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 624dc9c7-9b78-4d70-819c-a53428d95dad, 'Excellent et rapide à cuisiner. Toute la famille a adoré. ', '2012-09-07T23:11:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 7f934127-259f-47be-92a3-965fa926ba40, 'N''ayant pas de viande hachée de porc et que très peu de haché de boeuf, j''ai mis un os de jambon corse... J''ai laissé mijoter un long moment avec le chou. Je n''avais pas de carvi ni de de cumin. Un véritable régal comme cela.', '2012-08-14T20:11:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 3cb5a61f-63d0-46c0-a62e-6fffdf8c429c, 'Très bonne recette. Rien à changer. En plus, c''est vraiment facile à réaliser, et pour l''avoir réchauffer le lendemain : c''est encore meilleur !', '2012-03-14T14:09:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, a6af3417-8802-495b-858a-db209f640a29, 'Une autre façon de manger du chou.', '2012-01-09T14:18:14+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, f918043e-ba1e-4dd2-a9ab-738370254e71, 'Agréablement surprise du résultat ! A refaire', '2011-12-08T16:09:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, 39c05a29-7d63-4663-8057-ec35e0eea1f6, 'C''est une superbe recette pour faire aimer le chou aux enfants.', '2011-12-01T14:10:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, e7a8fcbd-f095-4546-b4a9-6588590e0310, 'Excellente recette de chou qui change de la traditionnelle potée... (Ne pas oublier d''enlever les cotes dures du chou sinon c''est un peu moins sympa).', '2011-10-01T16:18:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (81182, b2f9e03c-1b22-4b68-a31f-90afee85d4d0, 'J''ai suivi la recette à la lettre et c''est un délice, très heureuse d''avoir découvert une recette originale de chou que l''on consomme sous toutes ses formes dans mon pays, la Corée ! Merci !', '2011-05-26T12:38:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40458, eafdf609-147d-47b2-8c30-d1b6d54703b5, 'Très bonne recette ! Pour ma part, je farcis avec la viande crue... c''est plus facile, surtout lorsque l''on a  bien respecté les consignes ! J''ajoute également un peu de gruyère dans la farce (au point où on en est de toutes façons...).', '2009-11-14T19:10:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40458, 39e9e565-c1b1-4242-8009-fd6f1eae18a8, 'Très bon! J''ai ajouté un peu de sucre dans la sauce pour adoucir.', '2006-05-07T12:14:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40458, d2e80920-c113-4100-9d93-64a293065eb2, 'Extra, le vin blanc a été remplacé par du vin rouge.', '2005-12-17T20:59:04+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40458, f586ef99-d7eb-4895-8536-342f52e3a944, 'Au point où j''en étais, j''ai mélangé, j''ai touillé, j''ai arrosé, encore et encore, c''était parfait. A une variante de la recette initiale, j''ai préféré du boeuf comme viande. Merci.', '2010-07-18T12:31:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40458, 94cade6a-6895-4037-880c-706e348e66af, 'Recette qui prend du temps pour être réalisée, alors que le plat est dévoré en un clin d''oeil ;-)  Mon petit truc en +, je rajoute un oeuf dans la farce pour éviter qu''elle ne soit trop sèche, et je remplis les tubes avec la chair crue. ', '2007-02-13T21:55:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40458, 3289ecbc-c737-443b-99ec-92ff4198b356, 'Délicieux! Et recette très sympathique quand suivie à la lettre...petits verres inclus! ;)', '2006-03-05T12:38:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40458, 1098fe2e-2838-4d70-933a-d6118fb37fca, 'Bonne recette. Tout le monde a adoré. Merci', '2012-04-18T15:55:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40458, 075a928f-7b2d-41a7-8645-c4909ba76c60, 'Mes amis se sont régalés, ils en redemandent!', '2008-09-25T13:42:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40458, 4dee50b6-8603-43cf-aa63-0da899106f79, 'Voilà une recette qui suscite la bonne humeur: d''abord en la lisant, ensuite en la préparant (hips), et enfin en la dégustant! Bravo, Cécile, pour ce plat nourrissant mais qui reste néanmoins léger (vu l''absence de béchamel qui accompagne parfois les cannelloni).', '2007-02-13T10:36:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40458, 136eb94d-3d45-40bf-b09d-24aba980b7ca, 'J''ai fait cette recette hier pour mes amis et tout le monde s''est régalé! Par contre, quelle galère de remplir les cannellonis mais ça valait le coup! ', '2006-11-29T11:13:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46954, f8a1f126-2fa9-4e9e-a7ca-dc3edc295520, 'Très bonne recette. J''ai cuit les boulettes au BBQ, tout le monde a adore. Penser peut être a accompagner d''une sauce blanche.', '2011-07-04T00:51:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46954, 3bcfbd91-a81d-4838-b0c0-dea4b548881c, 'Parfaite recette réalisée avec uniquement un reste de gigot passé au robot mixeur. J''ai remplacé la cannelle par une bonne cuillère de cumin, utilisé de la coriandre surgelée, mis un peu de carvi et aussi ce qui me tombait sous la main. J''aime particulièrement le fait qu''on n''utilise pas d''oeuf dans la préparation. Je recommencerai cette recette, mais uniquement avec de l''agneau (j''ai un faible pour cette viande généralement bien parfumée).', '2009-01-22T14:32:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46954, f2a4901d-1305-4406-8eba-fd7b8f984864, 'J''ai fait la recette avec mes trois enfants. Ils ont roulés des mini boulettes, se sont bien amusés...et ont dévoré !! On va en refaire !', '2008-11-09T22:41:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46954, 90c01f25-4fab-4b89-9bd5-61e23a114d04, 'Confectionnées avec boeuf et agneau et servies avec salade verte et oignon cru et oranges en salade assaisonnées au piment et huile d''olive. Délicieux !', '2007-10-07T23:02:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (46954, 3999de43-b96e-4844-ba76-8f032a3f0d37, 'Super! Très simple, avec un petit goût d''ailleurs, c''était parfait! Accompagné de couscous avec de la menthe fraîche cisellée, de l''harissa, une sauce au concombre et des oignon cru: miam!', '2006-06-17T14:47:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, 878043df-57e9-45ee-95a1-06fb48974dfe, 'J''ai mis du potiron cuit en cubes comme garniture et un reste de macédoine (en boîte) avec du fromage pour gratiner. Parfait ', '2022-01-29T16:37:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, e4580144-c0c9-4697-b941-b14eebd7ac99, 'Très sympa, mais j''ai ajouté un oeuf et du curcuma. En ingrédients j''ai mis du chorizo un reste de poulet et du gruyère il ne faut pas hésiter à bien remplir le fond du plat à tarte. Très bon avec une salade. Pour la cuisson une bonne heure dans mon four.', '2016-12-01T22:53:29+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, 9752560b-7cd9-4ba3-add9-bb1ec301baba, 'En fait j’ai pas encore goûté mais ça a l’air trop bon', '2021-03-04T08:19:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, 035d9d20-e457-43a0-a2be-8999c4ec4189, 'Très bonne tout le monde a aimé.', '2019-09-02T00:47:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, 4bbcf18e-651a-4d4e-8c39-f596ea28faac, 'Depuis que j''y ai gouté, j''ai pris l''habitude d''en faire régulièrement, car c''est très bon... Je l''a fait avec dès de jambon pomme de terre pour mes filles et moi, et lardons pomme de terre chèvre pour mon mari.. On se régale et elles sont aussi bonnes chaudes que froides.', '2009-06-14T21:33:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, 57dfe45e-bc0b-4331-b6a8-d5919df466b0, 'Très bonne base de quiche sans pâte(sans la sauce tacos pour nous) Facile, rapide et se prête à tous les petits restes du frigo.', '2007-10-22T20:12:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, 7b0e32bd-a5c5-4a3f-95c7-e944f710ef08, 'Bonne base, pour accomoder ce que l''on veut sous forme de quiche. Pour ma part, j''ai mis pâte feuilletée, chorizo, lardons, coriandre, paprika, un peu d''oignon, un tout petit peu de sel et du poivre. C''était très bon.', '2005-10-27T14:52:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, 832055d2-b04a-4cc4-bac4-933eddd15f6e, 'J''aime bien.', '2017-09-23T19:52:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, 93625fcf-644e-4190-b98e-3390c3fcc85d, 'Moi qui n''ai pas droit au lait, j''ai remplacé par une bonne crème de soja Bio et c''était super garniture : pommes de terre, champignons, oignons, persil et chorizo... merci', '2012-06-21T19:44:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, 448cace6-a282-42ab-91f9-46a0fe246218, 'Moi qui aimais que les oeufs durs, merci pour cette recette que j''ai fait avec pomme de terre, petits oignons, copeaux d''emmental et jambon. J''ai mis 80g de farine et 40cl de lait, muscade, poivre et sel (pas trop le jambon étant déjà salé) Et hop au four 45 min...comme le chef dit...pas de pâte à faire, rapide, économique et mon homme pourra refaire !!! Pour une première, un régal !!!! Merci de m''avoir réconciliée avec les omelettes !!!!', '2010-08-04T15:31:37+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, 1d7d6e11-de7a-424b-97d1-5bbbc69dae1c, 'Ultra rapide, géniale.', '2009-10-10T17:41:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, 8eda0109-fc75-4e59-90de-16d1d819e8a9, 'Franchement, elle est super rapide. Le temps de cuisson est passé de 40 min dans la recette à 1 h chez moi, mais avec une boite de macédoine égouttée et des dés de jambon, elle a fait le régal de mes enfants avec de la salade verte, merci.', '2009-05-24T02:02:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, d3cbb7b8-6269-4330-9cf3-1dc64dd0c1bf, 'Une quiche sans pâte, c''est presque faisable, mais un appareil avec de la farine donne un "truc" super bourratif!!!  ', '2007-01-07T01:11:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, ca37ea3f-b6d1-4858-bafe-ea81654bb600, 'Pas fameux. Préparée en tartelettes, en entrée (avec 1 oeuf pour 2 personnes, les autres ingrédients en proportion). Les quantités de garniture n''étant pas précisées, j''en ai peut-être mis trop peu, ce qui donne un résultat fade et pâteux. Nous n''avons mangé que la moitié, sans aucun plaisir...', '2006-10-21T22:17:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, 534f4e29-67fd-4e36-ada7-84b95eed41be, 'Recette rapide c''est sûr! Elle rend mieux avec une pâte feuilletée. J''ai essayé avec une macédoine de légumes en conserve et une jardinière de légumes surgelée.  Avec la jardinière c''est meilleur. A essayer avec d''autres ingrédients. ', '2006-04-29T19:24:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, e0635ecc-6d4b-46a7-a360-7433b1809521, 'Très bon, facile et rapide à préparer. On a fait la finition avec des poivrons et du lard. Un peu bourratif à la fin. Idéal, sous forme de tartelettes, pour une entrée.', '2006-04-19T13:36:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, f13fc032-613e-4cb4-9e63-748ad27f5d67, 'Très bon! ', '2006-02-28T13:07:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, 3ee062b3-81cc-467f-bee7-3aec49c92e0f, 'Nous avons tous trouvé ça infect: une sorte de pâte farineuse et lourde à vous écoeurer des quiches... Désolée mais vraiment à éviter!!', '2006-02-12T12:53:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, 50577508-427e-4707-97ba-7de0d11f2d56, 'Recette facile et très bonne...facile à agrémenter selon les goûts. Je met du travers de porc frais désossé et des oignons coupés ainsi que de la noix de muscade en poudre, à essayer absolument.', '2005-09-13T15:10:45+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, 67f8f7ec-be81-4c02-8d84-e7beb59dd38c, 'J''utile régulièrement cette recette pour finir les restes ou un plat facile et vite fait. ', '2005-07-03T16:38:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, 527797fa-aab3-4236-ab6a-b12e43c308e8, 'Super bonne! Facile à faire, génial avec une salade verte!', '2005-06-13T18:02:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, f03f986c-e805-49c6-aac6-d9c7fd7ad658, 'Parfait, cela fait trois fois que je la fait : rien à redire, c''est économique et très bon. Merci !!!!', '2005-05-11T23:42:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, 7c3e9a8c-bacf-46db-963f-a3b5861adf18, 'Simple et rapide, je l''ai préparée avec des poireaux. Idéale sans pâte!', '2005-04-29T20:29:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, e5a12454-19ef-4f75-b707-72414d8f7b0e, 'Un peu caoutchouteuse si on ajoute du râpé dès le début, mais les enfants ont aimé.', '2005-03-22T20:04:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, 64686d85-490a-43c9-b495-d949d9318bef, 'Très bien, rapide, bon, rajouter des épices et c''est super! A faire sans hésiter..', '2005-03-17T20:12:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, ae56bf4e-2d7f-49a6-908f-114a81a774ae, 'Excellente recette de base pour une quiche sans pâte! Je l''ai faite aux carottes et aux poireaux avec une touche de curry... C''était top!', '2005-02-12T11:19:05+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, 93e6a4ff-cf93-47c7-bc60-8c12a6e035db, 'Recette ultra-facile, en plus pas besoin de pâte et quand il n''y a plus rien dans le frigo, c''est l''idéal! Et c est bon!!', '2005-02-05T11:52:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, 8eaa09bd-289b-4bff-87e7-30b4d1767ad2, 'Très bonne, mais j''ai laissé cuire 5 à 10 min pour que ça soit un peu plus compact (à mon goût) car le lait rendait de l''eau !?', '2005-01-27T17:53:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, fdbc52eb-ca72-41d1-a46e-b60dd65cf1d5, 'Rapide et fameux pour un dimanche soir avec une bonne salade verte.', '2005-01-25T17:38:42+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, e0a7d511-a73f-4e9d-9a09-b90999961698, 'Déçue du résultat: une sorte de semelle caoutchouteuse alors que beaucoup de préparation et de vaisselle! Ou alors j''ai du rater un détail. J''ai mis du lait, des lardons et du gruyère râpé.', '2004-10-11T14:48:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, d505fa36-74d2-4fec-9579-007a8fce1b96, 'Depuis le temps que je cherchais une BONNE recette de quiche sans pâte!!! C''est merveilleux, délicieux. Je l''ai réalisée avec l''option lait et avec des poireaux émincés comme garniture. Je précise aussi que j''ai recouvert le moule à tarte de papier sulfurisé. C''est maintenant ma recette favorite, qui s''adapte à toutes les garnitures... Quand on n''est pas trop inspirée!!... Toute la famille se régale autour de ce plat très sain. Merci Céline!', '2004-09-08T16:47:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, 21c3fe7b-5594-4e60-9e85-9fb92c4fa663, 'Une quiche rapide et simple! Remplit sa mission à la perfection!!!', '2004-08-09T15:52:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, acf9ce85-6dc6-4d4e-981f-263ea882bd7b, 'J''ai adopté la version de marjorie, avec une nuance: un peu de noix de muscade râpée...', '2004-07-08T20:01:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, 39a68575-2657-4d1d-9ac1-362426a853af, 'C''est une recette facile et simple, j''ai personnalisé avec la pâte brisée à la base et ajouté quelques garnitures... Très appréciée par mes convives!', '2004-05-31T22:34:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, 48aa9f18-2c58-4eb6-b001-261351e4b233, 'Cette recette est encore meilleure avec des lardons et du guyère (ou de l''emmental) râpé. Génial pour faire un repas rapide! Accompagnée d''une salade, cela ressemble à un vrai repas!', '2004-05-20T12:40:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, 5959d80c-6f63-48e3-b874-49e78121f19c, 'Moyen! Mais peut s''améliorer. Je l''ai faite une seconde fois en mettant une pâte feuilletée en fond, j''ai mis tous les restes de mon frigo (ça permet en plus de débarrasser): poireaux revenus, pomme de terre, jambon, tomate, carotte pour la couleur, j''ai ensuite versé dessus la mixture un peu arrangée (moins de farine et plus de lait) et au four 45 min... Le résultat est pas mal, à essayer! Dites-moi ce que vous en avez pensé...', '2004-04-08T10:28:04+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, a5cf0be2-2b35-4287-994c-9826fec52159, 'Très facile et bon, mais pâte ultra fine qui colle au plat!', '2004-01-15T20:01:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, 075d3539-ad3d-44f6-8e3c-d0ba43ea972d, 'C''est super! On dirait une vraie quiche, en plus diététique. Recette simple, rapide à préparer (même si la cuisson est un peu longue). Il ne me restait pas grand chose dans mon frigo: j''ai mis des dés de jambon, des petits pois et du comté et ma fille de 6 ans a adoré!', '2003-12-10T16:13:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, fe3259c5-0c2f-404b-a614-206b82f42738, 'Merci. Recette très pratique et vraiment très bonne.', '2003-12-01T23:16:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (23685, b000438c-819b-442f-b482-3ad1c1f32789, 'Parfait! Depuis le temps que je cherchais cette petite recette toute pratique... :p J''ai pu prouver à mon compagnon qu''on pouvait faire des quiches sans pâte, merci! ;o)', '2003-10-01T14:55:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20261, 2c86f4ad-b92e-4c6b-9035-b2e6997ce3e8, 'Recette adoptée par toute la famille ! Réalisée avec des morceaux de boeuf en marmite et non en cocotte minute donc temps de cuisson plus long. J''ai également mis des trompettes de la mort séchées et réhydratées dans de l''eau en plus des champignons en boîte. Je referai cette recette sans aucune hésitation.', '2013-11-11T17:03:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20261, 0e8dadab-1a63-4711-806b-f96d0a829a5f, 'Très bonne sauce !', '2013-09-18T22:09:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20261, cffc0891-f94e-4cfa-9b95-8444852794cb, 'Très bon et facile à faire. Je l''ai fait avec du roulé de dinde qui d''habitude est un peu fade, cette recette donne vraiment du goût. Je n''ai mis que 25 cl de vin blanc, c''est suffisant.', '2013-03-01T22:41:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20261, 96db7e5a-91aa-4b1a-b7c5-87ac9a643aad, 'Vraiment délicieux, j''ai ajouté 250 g de champignons frais c''est excellent. Je n''ai pas touché aux quantités et je suis satisfaite comme ça. A faire et à refaire.', '2010-04-16T16:08:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20261, de3a0854-f35a-4997-879f-0a7352d645e0, 'Un régal, ma fille et mon mari ont adoré. Une recette à faire et refaire merci.', '2008-10-22T15:43:58+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20261, 37601cdf-7fe5-430e-8ebc-52099543a759, 'MERCI! Recette toute simple et pourtant terriblement efficace. Et ça marche avec n''importe quelle viande! J''ai passé tout l''hiver à cuisiner à cette sauce, avec grand succès. Avec le climat froid du mois d''août, je ne vais pas tarder à ressortir le vin blanc, les pommes de terre et cette bonne recette.', '2007-08-10T00:04:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20261, 786f6bb7-13db-4d33-8713-f0bb2284c5ac, 'Très bon et facile!! Moi j''ai mis des pommes de terre et une boîte de petit pois pour faire des légumes ainsi que quelques champignons congelés et de la dinde. A la fin j''ai fais un roux pour épaissir.', '2007-08-07T18:43:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20261, 04d76887-286d-482c-9572-b53cb073233f, 'Très bon, mon oncle et ma tante ont bien appréciéé, ils sont repartis avec la recette. Mon oncle a demandé à sa femme de faire la recette en arrivant chez eux et de ne pas la louper mais il n''y a pas de risque, puisque avec Marmiton...c''est toujours facile et très bon !', '2007-02-17T23:19:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20261, 92ca029c-da9c-43a7-9645-14ae3448079a, 'Très bon, très simple... Fait avec un rôti de dinde et 25 cl de vin seulement... Et comme je sais pas bien lire ;o) je l''ai fait cuire dans ma cocotte en fonte...! Donc c''est plus long à cuire, mais c''est pas grave, on s''est régalé quand même! ', '2007-01-20T09:24:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20261, 649a19d2-9b03-4431-9575-d3fdab44704c, 'Super Extra Bon!!!!! Toute ma famille a adoré, c''était excellent! J''ai mis de l''eau avec un cube de bouillon à la place du vin trop bon! Merci pour la recette.', '2007-01-11T21:54:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20261, db62ee1d-23fc-4891-94b0-62db7655274f, 'Excellent! Tout le monde en réclame à la maison! Fait avec du lapin, des filets de poulet et de dinde, avec du porc...miammmmmmmmmmmm !', '2006-06-07T20:29:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20261, c7f10651-4541-4ec8-9b4b-45c6d3c34f98, 'Bonne recette, facile!', '2006-04-27T19:21:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20261, 7bce58b0-3a2e-40ea-9e80-431cbc7e0b98, 'Excellente idée de sauce. Pour ma part, je l''ai utilisé avec du veau. Mon chéri m''en parle encore...', '2005-11-25T10:52:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20261, 61ac269e-e8cd-43c0-836b-d227b2bec8e1, 'Super bon et facile à faire. Pour ma part, je n''ai pas mis de vin blanc juste de l''eau et j''ai rajouté du bouillon de volaille et feuille de laurier : cela donne plus de goût. Mes enfants ont adoré et mon mari aussi, à refaire.', '2005-09-24T13:53:32+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20261, 5ae7ebc6-598c-427f-9947-dd596bb1183e, 'Très rapide et très bon. Fait avec un sauté de dinde et pas beaucoup de temps!', '2005-04-25T11:41:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20261, 8b62e7fe-970a-47de-8376-43dc17001dda, 'Avis mitigé. Mon époux a adoré et moi pas du tout. Pour info, je l''ai préparé avec un sauté de porc.', '2004-09-28T17:29:20+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20261, d9bbdae5-ba01-4536-bb67-11481c90fe4b, 'Un délice!!!! A essayer également avec du muscat.', '2004-09-19T16:41:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20261, 61f3c515-3b8a-4523-9aa4-4dfb3eca6015, 'Recette facile et délicieuse! Rien à dire, si ce n''est que ce n''est pas la peine de rajouter d''eau pour les pommes de terre.', '2004-07-15T21:29:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20261, 9df8427e-6a38-47a7-bb1a-d9596698d0f9, 'Bonne recette, mais un peu trop de vin blanc. Vu que les pommes de terre cuisent à la vapeur, il est inutile de les couvrir d''eau ou de vin blanc car la sauce est trop liquide à la fin. 25 cl suffisent largement.', '2004-01-10T12:18:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (20261, e4a5f2f3-313b-4052-a55f-f0129c1c767a, 'Très bonne recette. Accompagnée de polenta, c''est merveilleux...', '2003-11-10T13:43:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80482, 530ae532-5615-447d-b666-b6e783134989, 'Ultra simple et super bon (salsa medium) ! C''est un classique de mes apéros et on me demande régulièrement la recette !  Idéale avec les légumes (carottes, choux fleurs)', '2016-04-16T16:03:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80482, b06ab65d-8d68-49ab-b0d7-d92bf8a1010a, 'C''est bien parti, et pourtant j''avais préparé beaucoup d''amuses gueule différents. A essayer avec une salsa médium pour un goût plus relevé ? En tout cas au jeu des devinettes c''est rigolo !', '2013-11-17T00:23:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (80482, 80e9eec3-ed31-4923-88f6-147c26e47b59, 'Tout simplement excellent ! Fait et refait à différentes occasions, tout le monde est sous le charme. Il est devenu un incontournable et on réclame la recette à chaque fois. Bravo et merci !', '2012-01-18T14:27:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40803, 3aabe04a-4f58-4ad4-a16b-710e859deb21, 'Perso, j''ai jeté les framboises entières dans la casserole. Elles se sont délitées sans problème dans les premières minutes de cuisson. J''ai conservé les grains parce que j''adore l''effet croquant dans la bouche. J''ai remplacé le jus de citron par du jus d''orange et ajouté une pointe de vanille. Extra !!!  Quand à l''écume, bien je l''ai mise en pot et dégustée. C''est un truc qui se conserve mal mais qui est délicieux !', '2014-09-26T17:19:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40803, ca2fd652-b5ab-4f2f-949a-0ab7c8f2445d, 'Moi, la confiture de framboises, c''est sans pépins !!! J''ai un mari qui préfère... je les passe au moulin. Bonne dégustation.', '2014-06-19T00:13:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40803, b56bb3d5-491a-45e9-aab8-35aa912f6701, 'Une astuce pour qu''il n''y ait presque pas d''écume: mettre une noisette de beurre dans la bassine. Essayez, c''est efficace.', '2008-03-05T19:27:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40803, ee1a0393-4738-46e8-ac68-d344ee53b5f5, 'Pour limiter les grains dans la confiture, ce qui rebute un peu les enfants, avant cuisson j''ai passé les framboises à la grille fine du presse-purée sans écraser les grains à l''excès pour éviter l''amertume. C''est super ! ', '2021-07-16T11:41:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40803, 929a5326-d771-48ea-9f22-613d1d918c6b, 'Nickel !', '2020-10-18T11:58:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40803, 598d965c-9da3-4519-90c0-1c12ecd639fe, 'C''est la première fois que je fais des confitures et c''est une réussite ! Je craignais qu''elles ne soient trop liquides mais à l''arrivée, ça va. Par contre pour éviter l''écume, je rajoute un petit morceau de beurre pendant la cuisson.', '2012-07-19T15:46:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40803, 85bfb638-7fcc-4131-849f-a5ec0af64536, 'Pour ma première confiture... Un régal. Rapide et simple ! Je l''ai utilisée pour garnir mes macarons. Seul inconvénient ça se mange trop vite !', '2010-11-21T19:06:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40803, 62fef278-7630-4e95-81af-65b7981c1efe, 'Trop  de sucre', '2023-08-29T10:00:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40803, 31fa1456-8d0e-40d9-b1bb-1410ce41ef76, 'Le goût est bon mais pour ma part je l''ai cuite trop longtemps. Elle est trop compacte. Le test de l''assiette n''est pas fiable ici.', '2023-07-02T09:08:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40803, 0d38c1a3-c15e-4a7c-a696-d3f29c1a8ddc, 'Très bonne, j''ai ajouté le zeste d''un 1/2 citron bio avec du jus. Délicieuse !', '2022-11-06T21:54:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40803, 75e090fc-99f9-4e1e-9784-e878811fae78, 'Bassine en cuivre pas nécessaire, peut-être même légèrement toxique. Les 10 minutes de cuisson sont sans doute très bien adaptées.', '2022-06-29T21:48:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40803, f156e35c-5609-4f83-bfe5-e1872607e686, 'Première confiture pour ma part et ce fût un grand succès. Juste parfait. J''ai mis 400g  de sucre pour 1kg de framboises du jardin.', '2021-10-27T18:56:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40803, b85fa9f6-5bce-4367-ab89-689e0c84299b, 'J''ai  voulu faire une confiture groseilles, framboises et fraises. Je me suis trompé dans l''achat du sucre a confiture j''ai pris pour gelée.', '2019-08-03T11:33:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40803, 68054f98-e890-4507-ad99-7e4a256f5180, 'Super. J’ai mis 72% de sucre blond de canne bio par kilo avec framboises bio que j’ai fait dégeler avant  et je l’ai mise dans un chinois pour les écraser et enlever les pépins. Un vrai régal !', '2019-07-28T22:33:11+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40803, 30bd90ca-d4d3-46f7-90ef-ee09e811d8fc, 'Facile et délicieuse ', '2019-07-09T13:18:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40803, 08ca5744-bee3-4406-acbd-bbbdeb66830a, '1k de framboises, 750 g de sucre, 1 jus de citron. J''ai laissé macérer jusqu''au lendemain. Parfait', '2015-11-09T00:14:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40803, 40cca322-bb58-4c8e-bc68-c7e3610a81f5, 'Possibilité de faire une variante avec seulement 350-400g de sucre. L''astuce est comme pour tout autre confiture, d''utiliser des pots non ébouillantés mais de les mettre directement dans le congélateur. Vous verrez que le gout du fruit ressort d''avantage. Moi je dose le sucre en fonction de l''acidité du fruit. Quand vous avez besoin d''un pot, le sortir la veille.', '2015-02-22T18:41:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40803, 02cb25f5-4db4-4596-91b5-71cfaec9f17f, 'Attention au temps de cuisson ! si vous les faites trop cuire, en fait vous loupez le bon moment où elles ont pris. Il faut les surveiller comme le lait sur le feu et faire plusieurs essais sur une assiette froide. Quelques minutes suffisent (comme conseillé)', '2014-07-25T18:52:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40803, 6dbccb65-9dd4-41d4-af64-911c62634c6a, 'Très bonne recette ! J''adore  ', '2014-07-18T12:36:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40803, 79bb6118-a951-4ef4-aef3-f31ca22d4595, 'C''était la première fois que je faisais cette confiture avec mes récoltes magnifiques de cette année et ce n''est pas fini ! 6 pots 1/2 avec 1500 kg rien que la récolte du jour ! La recette est parfaite : poids, durée, ingrédients. Je recommencerai demain avec la prochaine récolte !', '2014-06-11T21:09:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40803, 16ddcb35-511f-4cd6-8a82-084e2e4e443b, 'Temps de cuisson un peu sous estimé, sinon parfait', '2014-06-08T19:39:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40803, 7534720a-d50e-4d5b-8083-d6da8034c835, 'Pour la conservation je conseille de laisser les pots plein, refroidir sans-dessus-dessous, ainsi le vide se fait au fond.', '2013-09-19T16:28:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40803, ba1d8495-0719-4d09-bea2-5e3246f0ce58, 'Ne rien changer. Confiture parfaite. Merci.', '2013-09-04T13:15:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40803, 1d6a28a0-a1a3-4ec9-b00b-1c709b8b3c49, 'Ce matin je suis dans les confitures de framboises avec celles de mon jardin je les fais moi même tous les ans, je fais ma petite réserve. Un vrai délice ! La semaine prochaine, je ferai aux fraises et aussi abricots hum ! Merci Marmiton !', '2013-07-29T09:31:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40803, faa7c2d4-0cef-4e6a-92a6-38608cc50365, 'Facile à réaliser et délicieuse...A refaire...', '2013-07-07T17:47:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40803, 118829fd-a16d-454c-8bf5-da5dd0be95cd, 'Parfait! Rien à changer à la recette proposée!  J''ai utilisé des framboises congelées que j''ai fait décongeler AVANT la cuisson pendant quelques heures. ', '2012-05-21T21:45:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40803, 38188717-13d0-40e3-888a-7a8d265485b1, 'Très facile d''obtenir une belle confiture avec cette recette. J''ai laissé en attente mes framboises surgelées avec le sucre cristallisé J''ai lancé la cuisson une heure après environ (en oubliant le citron).Je n''ai pas écûmé, ni vraiment compté le temps. Belle odeur, belle couleur, belle saveur. ', '2010-03-17T22:11:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40803, 708214a0-2224-4776-a489-ea90e3285946, 'La confiture est délicieuse et rapide à faire (15 min). Merci pour cette recette !', '2009-06-11T21:09:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40803, a2664105-e22a-40aa-b7a9-6af6ad82b8f6, 'Impossible à rater! Mais compter au minimum 30 à 35 minutes de cuisson. La framboise n''a pas de pectine naturelle, il faut donc en rajouter si vous voulez que vos confitures ou gelées aient une consitance plus soutenue. Essayez d''y rajouter du thym frais, c''est fabuleux !', '2008-07-18T05:49:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40803, 7ed18b2f-d157-4c80-bb0d-b2e8ff8586cf, 'Très bonne la confiture! J''ai par contre mis 40% de sucre brun en cassonade. Meilleur que le sucre raffiné blanc. Et ajouté quelques fraises... Un délice.', '2008-06-14T21:11:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40803, 5d86de4d-8696-4bbf-8ed5-eede53cd43ee, 'Quelle merveille ! Ma fille n''a pas attendu qu''elle soit dans les pots pour la goûter. Juste un petit bémol, pour la cuisson, j''ai mis plus d''un quart d''heure pour la cuire et pourtant, j''avais des framboises fraîches. Mais autrement, pas de problèmes, très bonne confiture.', '2007-07-08T12:32:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40803, 3f6087a2-4e86-4839-83ea-4ef8b5f13697, 'La recette est ultra rapide, je n''avais que 500 g de framboises, j''ai donc mis uniquement 300 g de sucre et 2 cuillères à soupe de citron, excellent. A refaire ! Merci.', '2007-06-11T00:23:00+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40803, 68f146de-ad92-40b2-b66e-fc6962461ef0, 'Simple et savoureuse. En revanche, 15 minutes de cuisson c''est utopique...Chez moi, pour que la confiture prenne, il a fallu au moins 1 heure (Est-ce parce que j''ai utilisé des framboises décongelées ? Je ne sais pas)', '2007-03-02T02:41:03+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (40803, aaa3f1f0-74ed-4df8-92db-63043b94677c, 'Recette archi simple! C''était ma première confiture et elle fut très réussie. J''ai laissé macérer une petite heure les fruits, le sucre et le citron avant la cuisson. Désormais, je compte faire toutes mes confitures "maison". Merci !', '2006-09-21T16:18:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22206, a2815735-90fa-459b-91c1-e4ae0311c89e, 'Super bon, j''ai mis 2 cuillères de sucre en poudre à la place de l''édulcorant et 180 g de fraise.', '2016-05-03T22:38:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22206, ec5c3ab0-ade4-4e9f-9826-7a6168d78105, 'Printanier, rafraîchissant, délicieux et...sans sucre, ou un peu de cassonade pure canne. Mais pas d''ASPARTAME !', '2016-05-02T16:58:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22206, 2f2cc3a7-34d7-445b-8203-2561a5ddf2a8, 'Simple et bon. J''ai sucré avec de l''édulcorant liquide, une cuillère à soupe pour deux personnes.', '2016-06-13T02:50:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22206, ff5a4355-312c-4df1-8341-2692359e282b, 'Ce milkshake à la fraise est excellent au petit déjeuner! À essayer', '2016-05-17T11:15:43+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22206, 88890e3e-bac7-4e24-85f9-f8a68edd9536, 'Extra, rien à signaler, j''ai essayé avec les yaourts congelés. ', '2015-08-30T23:33:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22206, 13bf753c-a754-4d4a-9c87-0a09cc52847f, 'Comme j''avais des framboises surgelées, je n''ai pas mis de glaçons, mais cela à donné une glace allégée plutôt qu''un milkshake... Heureusement, comme je l''avais préparé ce matin pour cet aprèm, cela a eu le temps de dégelé et je me suis régalée...  N''empêche... pas bête l''idée de glace maison allégée pour quand on a des invités...', '2015-08-07T17:36:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22206, 5b2f2b24-56df-4aa4-bcae-b686dee83764, 'Un pur délice !', '2014-06-24T16:59:01+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22206, 990d7584-5f75-4dc6-bcc7-3880b674ef0d, 'Très bon, à refaire humm...', '2014-05-04T22:49:36+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22206, 8e95ac11-40c3-4268-9fed-1eb4aec67ef2, 'J''ai remplacé le fromage blanc (que je n''avais pas) par un yaourt brassé nature, et un yaourt citron vert-framboise, ça passe très bien !', '2013-06-11T11:02:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22206, 85caf0c8-89b3-40bd-af98-4c7a9099db63, 'Très bon, j''ai mis du fromage blanc normal et du sucre glace au lieu de l''édulcorant mais vraiment rien à redire !', '2013-06-05T15:44:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22206, 28e596de-85e0-4e87-93e7-04518672953d, 'Pour éviter les glaçons, j''ai congelé le yaourt ce qui rend l''ensemble plus mousseux. ', '2009-06-21T23:39:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22206, 03f90b90-6c97-403d-96f1-63939ba85328, 'Très bon, je l''ai fait avec 2 yaourts brassés au lieu du fromage blanc. Hum !!!', '2009-05-25T21:00:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22206, 59b2388b-c80c-49ae-a1b3-26970b89b359, 'Super bon et frais.', '2009-05-22T23:11:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22206, 6006ee87-fad1-4bc4-8b2e-6465d22f48bb, 'Super bon, rapide à faire! Frais, rien à redire!', '2007-04-29T15:59:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22206, 87f918c7-61dd-403a-91be-ff153966d80d, 'Vraiment très bon! A essayer avec des pêches: un régal !!!', '2006-08-13T22:11:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (22206, 6d6382fe-85c2-473f-a483-07c644a9e061, 'Ras. Impec''!', '2005-08-14T19:34:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30141, 15b658df-cc46-474e-b279-e68011965749, 'Très bon, comme dans tous mes desserts, je diminue le sucre, entre 80 et 100 g, largement suffisant.', '2022-12-20T10:41:20+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30141, 2df065d2-c4b6-49cc-a2f8-b3760a6b5e22, 'Un crumble très équilibré sucré et acidulé. La canelle est très gourmande et s''accorde parfaitement avec les fruits', '2021-02-12T20:36:27+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30141, 19698b7a-3408-4d9b-9bc3-78b08eb70613, 'Excellente recette merci ', '2020-03-27T20:38:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30141, 99398a4e-ebe3-4b1f-ae42-39cbbef296d7, 'Bon, jai fait poêler les pommes légèrement écrasées avec sucre et cannelle avant de les mettre dans le plat.', '2018-02-24T04:06:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30141, 481dd633-2541-469a-9e38-e5401542700a, 'Très bonne recette. Tout le monde a apprécié.', '2016-03-04T13:51:02+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30141, fdf60581-f889-465b-b6c7-218aaf217018, 'Au top', '2015-05-07T20:45:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30141, 09ab50d1-e1c9-4070-b720-92422d569cd1, 'Très satisfaisant ! Ce dessert évoque tous les fruits de la recette ! Nous l''avons mangé pour le nouvel an 2013 et il est succulent !', '2013-01-02T17:19:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30141, da66a15a-517c-40d8-a064-c7bdf821a696, 'Ce dessert est une valeur sûre. La pâte est sablée comme il faut et simple à faire. La banane apporte la douceur et le fruit rouge l''acidité. On peut mettre plus ou moins de framboises pour contrôler l''acidité. Je mets 100g de framboise et 100g de myrtilles. C''est excellent, naturel et pas trop lourd.', '2007-05-24T16:57:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30141, aa37bd1e-43f8-4cce-bfb9-8258304d6417, 'Excellente recette, goût de la cannelle assez prononcée mais a plu à toutes mes convives. ', '2007-05-09T01:00:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30141, 57b1875e-915f-4066-98e8-dd3f6c3bbf8c, 'Franchement délicieux, le crumble était croustillant. J''ai utilisé du sucre roux et servi le tout avec une boule de glace vanille avec des pépites de caramel. Cela a eu un franc succès!', '2006-04-01T23:04:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30141, 8aa5bfe9-7820-4fd2-aba4-b485370ed88b, 'Une vrai merveille. Beaucoup d''harmonie entre le sucré pomme/banane et l''acidulé des framboises. Mes invités ont beaucoup aimés. ', '2006-03-16T17:58:35+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30141, 19c67d0b-59cb-4763-ac89-0335047c5142, 'Délicieux, des notes sucrées et acidulées qui se marient à merveille ! J''ai utilisé de la cassonnade à la place du sucre pour un côté plus "croquant". A tester sans tarder !!!', '2005-04-07T15:25:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (30141, 42c448ee-56af-44e9-b345-744b950e2b4a, 'Pas mal! On peut remplacer la banane par des poires.', '2004-10-06T14:02:10+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29679, 32aa1e0b-5604-4370-b69c-91d5e6d636f6, 'Parfait et super facile. J''ai mis du sucre à la place de l''édulcorant et 1 feuille de gélatine car le temps de repos au frais est limité. J''ai mis des biscuits roses de Reims à la place des  boudoirs. Toute la famille a aimé. Cette recette rentre dans mon carnet. Merci.', '2011-05-16T09:32:24+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29679, 2e72d232-a1fc-48db-a1f8-ce21e9becb5f, 'Très bonne recette! Moi j''ai remplacée la faiselle par 4 ou 5 GERVITA. ', '2007-08-07T17:46:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29679, 439feace-9038-4978-95e4-1bdcda9dddc1, 'Absolument DELICIEUX, j''étais sceptique pour le jus d''orange, j''ai tenté et pas regretté. Très frais pour l''été et très digeste, je vous la conseille vivement.', '2005-04-10T00:37:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29679, 8c864902-db44-4c0b-8a58-5ec433211af0, 'Très bonne recette', '2022-05-29T18:54:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29679, 590df2f3-2f50-4565-aaf2-2a2bd181abd6, 'Délicieux avec fromage blanc 👍', '2022-05-26T16:19:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29679, d9b85e4d-3dad-4f3c-be1c-aed2c49b6c86, 'Quantité pour 8 personnes avec le moule traditionnel. Sans édulcorant et avec grand marnier c''est parfait, merci.', '2022-04-17T12:23:46+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29679, 6c85fb81-e9de-4359-b309-af1ac5732726, 'Excellente ! Très facile à faire cependant je conseille de rajouter 2 cuillères à soupe de Grand Marnier dans le jus d''orange, ça donne un goût supplémentaire sans être trop alcoolisé. Et, les doses sont (pour moi) plutôt pour 5 personnes. Merci pour cette recette, mes convives se sont régalés !!!', '2013-06-28T17:16:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29679, 678a0ba2-61a0-4fd4-94e9-32c68336b484, 'Un régal. C''est la première charlotte que j''ose démoulér et elle est impec'' par contre concernant le citron, quelques gouttes suffisent. ', '2009-03-05T09:03:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29679, c7bbb6c7-f952-4e16-b58f-272262bd36e0, 'Nous avons été très déçus par cette recette notée unanimement 5 sur 5! La faisselle et le jus d''orange ne donnent pas un goût terrible par rapport aux charlottes aux fraises faites avec du mascarpone ou de la crème montée en chantilly. Les convives n''ont pas apprécié et en ont laissé.', '2008-05-10T11:03:02+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29679, cbf7775f-f020-43aa-9e73-55eedb929367, 'Je l''ai faite avec moitié fraises du jardin et des groseilles pour compléter parce que c''est ce qu''on avait sous la main. J''ai ajouté deux feuilles de gélatine dans le doute.', '2007-06-10T18:43:31+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29679, ab9c7265-c221-4cc8-aca3-3b444f22e387, 'Moi qui aime la faisselle, recette super, un peu fade pour mon mari.', '2007-06-02T09:54:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29679, d919cea7-0a5e-4aa6-8d57-991a6fedacd5, 'Très facile et très bon. En y incluant quelques framboises, c''est encore meilleur!', '2006-07-05T00:51:59+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29679, 3e1ac66d-c0b4-4264-ad61-c6e120fda3b0, 'Très facile a faire, très légère à manger... un vrai régal!', '2006-04-28T15:57:29+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29679, d24ba543-8751-4aaf-a119-09ddb4106633, 'Très facile...Il faut très légèrement imbiber les boudoirs ça fait pas mal d''eau!! Mais c''est très bon...', '2005-09-24T12:42:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29679, f80e9807-7882-4ccd-a711-4b3d95f61249, 'Je suis 1 débutante et je l''ai presque réussie, sauf que lors du démoulage la charlotte ressemblait plus à la tour de Pise... Recette à refaire souvent tellement elle est simple ! Il faut juste éviter de trop tremper les biscuits...', '2005-05-23T14:28:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29679, 6b6472fb-a8a1-4147-af41-87b6d64a6ad5, 'Très délicieux mais je préfère à la glace vanille. Je n''ai pas mis le citron, c''est encore meilleur sans je trouve.', '2005-04-26T20:22:26+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29679, 112e1375-554c-4790-8b23-121e22b1adf9, 'Excellent! Sans alcool et sans gélatine, parfait pour moi. Par contre, le vrai sucre a ma préférence.', '2004-10-08T16:21:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29679, 5cf8bae4-18cd-478a-9b9c-43d7f3de8e74, 'C''est très bon! Je l''ai faite pour mon anniversaire en trempant les biscuits dans de la manzana (alcool de pomme verte) et il n''en est pas resté une miette...', '2004-09-23T13:51:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33834, e77b5699-248e-4a6d-b862-dc6e101b293e, 'Il manque également la Grenaille, toute petite pomme de terre de Bretagne! Divines rissolées avec du beurre salée et avec la peau surtout!', '2005-05-28T14:18:55+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33834, 779c89cb-4327-4cbf-8890-16e3364af95e, 'Merci pour cette liste qui va m''être très utile.', '2005-01-24T18:45:24+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33834, 896878ed-6a19-413f-a3a4-654dc29e5fd3, 'Ne pas oublier la Désirée ferme, tenant à la cuisson, idéale pour le Baeckeoffe alsacien !', '2005-01-03T10:03:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33834, f73cd38f-b4e7-46d2-b264-ab5368a486c5, 'Quelle bonne idée - enfin quelqu''un qui pense à ceux et celles qui ne font pas la différence entre une patate et une autre.', '2004-12-30T12:41:17+01:00');
