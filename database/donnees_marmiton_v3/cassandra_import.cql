INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, 3ba92f62-8547-4336-ac85-a14722a01624, 'Recette très appréciée. Pour ma part, manque un peu de sucre. ', '2021-08-15T09:59:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, f06ca3f7-cd0a-4163-985a-28c130f08d9d, 'Tres bonne recette', '2020-08-11T18:06:00+02:00');
