INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91402, f3325b8b-72d8-4d9b-a7de-3e3ef49e1cf8, 'Inratable', '2020-10-20T16:33:50+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91402, 5493139c-61ca-4926-84f4-603cfccdc0a0, 'Je fais fondre dans un poêlon en cuivre au lieu d''utiliser le micro-ondes et double la quantité. Très bonne sauce.', '2020-03-15T11:07:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91402, f459eecb-936d-45b8-8e22-34286b534de8, 'Top ! Je la monte comme une béchamel à la casserole à la place du micro-onde', '2019-07-05T09:00:47+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91402, 9bc3c4a6-3f73-41b4-80d0-562884ddc9f3, 'Super bonne recette, je l’ai préparée par contre dans une casserole sur la plaque et remplacé la ciboulette par du persil, c’était un régal accompagné de crevettes sautées à l’ail et l’huile d’olive ... Mon époux a adoré !', '2019-05-04T05:30:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91402, cf37abb4-bae7-4fee-9e4f-9aa22aea3ee3, 'Au top mes filles l''adore avec du poisson pané et du riz !', '2018-09-24T12:15:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91402, 25bfb2ba-9536-4afc-9d08-b4c8003b2de8, 'Toute simple et très bonne pour accompagner un poisson blanc ! Merci.', '2018-09-19T10:50:28+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91402, 8bf28acf-41c1-4a1f-bca5-a4baeec5f131, 'Très bonne recette que j''utilise souvent. Tout le monde apprécie, seule chose je remplace la ciboulette par du basilic !', '2018-08-24T23:35:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91402, 502b718a-2464-47be-b60c-5c38c9cb6363, 'Très bonne sauce, rapide à faire ! Mon homme a adorée ', '2018-02-09T05:09:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91402, 4656ae56-3380-4fbf-9dc7-78eafd335dee, 'Sauce ultra rapide que mon compagnon a ADORÉ et moi aussi. ', '2018-02-04T11:51:21+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91402, 81d01904-e6dc-47f0-8d4a-44270d10325a, 'Au top !!!', '2017-02-17T12:30:01+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91402, 16a8ed49-ec7a-46d5-9cd6-4f1567b474b6, 'Je l''ai réalisée à la casserole, la recette est délicieuse. Les enfants de ma conjointe qui, de base, n''aiment pas le citron ont dévoré la sauce', '2016-05-25T19:00:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91402, c781b13d-ad1a-4905-8beb-aab721cae022, 'Simple, rapide, super bon, rien à redire. Merci ! ', '2015-12-17T20:39:28+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91402, 31177239-93d0-4a8c-af66-2f559744ed99, 'Je l''ai faite à la casserole avec de la crème épaisse (sur la plaque de cuisson encore chaude après cuisson du poisson) c''est très rapide et très bon.', '2015-08-16T14:29:21+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91402, 51cba25f-3b62-403b-a8b2-0bb11ed0759a, 'Rapide et bon, pour moi sel variante cuisson au bain marie et un peu plus de jus de citron (le mien avait peu de goût !). ', '2014-02-26T11:59:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91402, a635dfcd-0b58-453f-904c-c2ab7145fd10, 'Super bon. Faute de ciboulette, j''ai ajouté du basilic, de la menthe, de la coriandre et un soupçon de gingembre. Un régal.', '2014-02-12T22:37:26+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91402, 86076df1-97e9-4b61-be8a-92e86afb5822, 'Rapide, facile et bon (tout ce que j''aime !) 2x45 secondes au micro ondes maximum en ce qui me concerne. J''ai rajouté une pincée de sucre. Les enfants ont beaucoup aimé aussi.', '2014-01-02T15:16:46+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91402, ade595af-5889-4af6-84f8-c9cb7fc1c311, 'Rapide et facile ! Promesse tenue !', '2013-10-14T22:36:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91402, 46c964ca-1120-4bcc-bfd5-a3ee5d61dd10, 'J''ai suivi rigoureusement la recette, je trouve que la crème fraiche est trop présente et neutralise l''acidité du citron ... lequel citron semble être évaporé par la cuisson aux micro-ondes. Déçu, je ne referai pas la même erreur la prochaine fois et saupoudrerai simplement de quelques gouttes de citrons sur le poisson.', '2013-06-10T15:37:05+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91402, 03c3ce86-ac76-420c-8b5a-a5f38ff7f18f, 'Un délice !', '2013-06-07T20:46:13+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91402, 937a9edc-896c-447e-89fc-fc5c031e9fef, 'Un vrai délice, une sauce divine ! Aussi bonne avec que sans ciboulette. Pour les adeptes du micro-ondes, une astuce : faire chauffer la sauce "à couvert" 1min30 à 600W, ça la fera légèrement épaissir, vous obtiendrez alors une sauce onctueuse à souhait ! Vous pourrez alors napper vos poissons sans difficultés. Merci pour cette splendide recette, qui ne quitte plus mon carnet !', '2013-03-25T20:57:55+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91402, c5fa2fb5-6a25-4a38-b695-25a61bc39781, 'Je l''ai faite à la casserole en ajoutant les zestes finement râpés de 2 citrons non traités, délicieux, onctueux, goûteux ! Merci.', '2012-11-04T14:40:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91402, 88a352dc-693e-41a7-b01b-4e7b02f9b566, 'Un régal ! Je voudrais préciser que lorsqu''on trouve une recette fade, le plus souvent, c''est à cause d''un manque de sel... C''est mon père qui m''a appris le "truc" et c''est VRAI !', '2012-10-19T12:02:18+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91402, 3f9c173e-7ad7-4400-b689-3ac3ad205750, 'Vaut mieux la faire à la casserole c''est plus onctueux et cela ne prend guère plus de temps, délicieux bravo !!!', '2012-05-05T13:18:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91402, 048f7351-cc75-48e8-b55c-b921e8d54d3d, 'Simple et rapide, les copines ont adoré !', '2011-11-23T20:17:41+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91402, ae35b929-0302-4536-8897-3230b7a99764, 'En effet, elle est fade si vous la faite au micro-ondes mais avec un peu plus de temps en casserole, un plus de beurre et de citron...  c''est magique !!!', '2011-04-23T22:36:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91402, 0a6eeb41-c1ca-414a-a079-b98c90de5862, 'Déçue, moi qui adore cette sauce pour une fois je voulais la réaliser moi même, je l''ai vraiment trouvée fade, dommage...', '2011-02-10T16:01:38+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91402, afbe5ebf-4104-448c-85f2-6005c9ae5a03, 'On a adorée cette sauce, facile et délicieuse. Merci !', '2011-01-04T03:01:44+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91402, 797d3654-ad20-44b6-bc9d-2275985340b9, 'Avec un filet de sabre et du riz, le tout nappé de cette sauce. Ce plat a été apprécié!', '2010-09-20T16:15:38+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91402, ee48ca82-1fff-4207-88f9-8b162710a7be, 'Delicieux avec de l''aneth.', '2009-12-25T15:34:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91402, e64c71f2-334c-439f-9053-ea13d28e1604, 'Je ne mets que 3/5 car pour un beurre citron "vite fait-bien fait" je fais fondre mon beurre au micro ondes puis j''ajoute le jus d''1/2 citron. C''est tout et c''est excellent !', '2009-12-08T14:20:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91402, 2e608676-0271-4483-9a1a-5aef6022903e, 'Extra cette sauce minute ! J''ai mis de l''estragon car je n''avais pas de ciboulette, c''est super bon et pratique  ', '2009-11-26T20:23:51+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (91402, 61590629-b49b-43ba-9bd8-281aae23acdd, 'Super bon rapide.. cela m''a sauvé..un jour où j''étais malade mon fils rentré du collège et lui qui n''aime pas le poisson a adoré...merci beaucoup.', '2009-11-17T18:08:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, 82282213-c3d6-4273-88d9-5fb12b616f1b, 'La sauce au beurre blanc est une émulsion (gras/eau, comme une mayonnaise) chaude. Il faut donc remuer constamment juste en dessous du point ébullition jusqu''à ce que la sauce "nappe" (plus il y a d''eau, plus ce sera long). Conserver ensuite à 50°C ou moins, sinon la sauce tranche. Crème fraiche agréable mais inutile. Pas trop de citron sinon c''est très acide (ou bien équilibrer avec une cuillère de bicarbonate)', '2023-12-30T12:01:31+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, 51c5f293-e06b-4cba-91b9-86b699a39a46, 'Merci pour la recette. Perso je la trouve bien meilleure en divisant le citron par 2 (sinon trop acide), en augmentant le beurre de 20% et en ajoutant juste un peu d''estragon.', '2023-10-28T15:34:49+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, b2ddbaa2-3fc4-466e-8052-bbb088ebf90f, 'Un vrai beurre blanc nantais c''est une émulsion donc sans crème ', '2022-04-16T23:18:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, dc3503fa-1c61-461e-b122-40e1bd3d0b8b, 'Merci beaucoup pour la recette ', '2023-11-02T19:03:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, bf491d0f-e135-4ee4-992c-77cd3b3bbb61, 'Beaucoup d''acidité à cause du citron. J''ai ajouté une cuillère à café bombée de farine quand le beurre fut fondu avant d''ajouter la crème fraîche.', '2022-12-31T19:39:39+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, e3fa01d1-9a26-4907-b3b5-b45dce3f4b3a, 'Excellent , avec du thym et sans citron c''est encore plus fin', '2022-03-20T19:18:23+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, 6f7c1df9-ae88-47e7-bef6-131bea98b44b, 'Excellent et facile à réaliser.
Personnellement je mets peu de citron sinon c''est vite trop acide. ', '2022-08-08T14:48:12+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, 761904fb-a363-4f5d-a05e-4d4f5c5e02a9, 'Excellente !', '2022-06-16T19:46:54+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, 6ce6987a-b3f1-44b8-b549-e5744f91b339, 'Excellent 😊 ', '2022-06-10T13:13:17+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, 0d3e31f2-1f81-4fdc-9f1d-bfbd398b7a22, 'Parfait et simple à faire..avec un peu de sel
', '2022-03-11T11:42:17+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, 7e4c55e7-d03d-4dd2-a5dd-93a9159969ed, 'Très bonne sauce avec le poisson et le riz mais je l''ai salée et poivrée, trop fade et acide pour moi telle quelle', '2021-11-11T19:51:19+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, cf6a3722-2114-4e53-9105-92b15a6dcebb, 'Bien ! Un poil de sel et on peut même mettre un soupçon d’estragon...', '2021-02-06T01:00:40+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, 58077fdf-be29-447e-b17b-c080080c9f6a, 'Très bonne recette ! Nous avons ajouté des câpres. ', '2020-07-18T14:45:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, 767dd44b-6cd0-4615-a793-864289189a68, 'Pas mal pour une première, pour les prochaines j''utiliserai 1/2 citron uniquement.
Ne pas hésiter à saler, poivrer et ajouter un peu d''epaississant (farine ou Sauceline Maizena) ', '2020-04-26T18:49:19+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, fc1c6471-7362-4661-ad50-9ed9340d8d68, 'Les quantités sont approximatives ( 1/2 verre de vin : quel type verre ? ...) aucune indication de temperature, ....NUL??', '2020-04-21T16:53:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, efb2f7cd-86e3-41c4-bb90-71366939e54e, 'Facile à faire et excellente pour accompagner les poissons de la choucroute de la mer.', '2019-11-18T17:07:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, 07d8f848-9db6-4c6d-b4ca-67137e1bc70b, 'Recette facile et excellente autant pour un bon cabillaud que pour la choucroute de poisson.', '2018-03-24T16:55:49+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, 772131d0-c4d4-4ae3-93cc-34bff1ba5ff1, 'Très facile, délicieux mais avant de servir, j''ai garni avec un peu de crevettes grises fraîches, histoire de faire joli. A refaire sans hésiter !!!', '2015-12-19T21:49:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, 67df621f-779c-4e22-b133-10c998354b7b, 'Délicieuse également sur des pâtes fraîches farcies aux asperges!', '2015-02-22T10:38:08+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, faedcc2b-b285-4340-9bf9-f43c94bf0a62, 'Très bonne sauce ! Je n''utilise pas de vin blanc pour cuisiner, je l''ai remplacé par du fumet de poisson ! Et c''était juste excellent ! ', '2014-01-23T23:47:07+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, 48728ce8-34ca-44ec-9f3f-d46c1be80f3e, 'Excellente recette. Suivant les commentaires des autres marmitonautes, je n''ai pas mis de vin blanc, mais j''ai ajouté une cuillère à soupe de farine pour faire épaissir et c''était vraiment très bon avec le cabillaud. En accompagnement, j''ai fait du riz et la sauce s''accompagnait bien avec.', '2011-11-28T12:24:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (70522, 73c8ec5a-2b82-40f8-a21b-2f16f2b8d403, 'Très simple et rapide', '2023-10-07T20:39:30+02:00');
