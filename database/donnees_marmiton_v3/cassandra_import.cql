INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, c346ed96-9326-48ce-afca-94abc2526b6c, 'Superbe recette, j''ajoute des pépites de chocolat, 1 bouchon de rhum et un crumble sur le dessus.', '2022-12-19T12:10:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 6d385cc2-9634-436b-a343-655c05ee5f7c, 'J’ai mis une banane de plus (3) et un peu moins de sucre. ', '2022-11-27T22:28:53+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 9b1e77ac-ef97-4bed-9557-dc7d9ea7b229, 'Pour un goût plus caramélisé je vous conseille de remplacer les 120 grammes de sucre par un mélange 60 grammes de sucre-60 grammes de vergeoise/cassonade. Vraiment délicieux 😋', '2022-11-06T08:55:36+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 503eff2c-ad24-4aba-a7d8-7e053372a4c4, 'Perso j''ai mis 60 g de sucre et 4 bananes et c''était top 👌', '2022-11-01T11:26:59+01:00');
