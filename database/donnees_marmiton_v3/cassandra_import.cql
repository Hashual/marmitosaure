INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, e164d7eb-75f2-4265-8f0e-7c4aafd1d712, 'Délicieuse, mes enfants en redemandent. La recette est parfaite ! Merci.', '2013-09-18T21:19:14+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, 183a9ec1-cec2-46e5-b4bd-060f74cbe2af, 'Faites attention à ne pas trop mettre de cannelle ! Pour moins de calories : Vous pouvez remplacer la crème par de la compote de pommes (enlever le milieu des pommes, et mettre dans de l''eau bouillante pendant 10-15 minutes puis mixer). Si vous mettez de la compote vous pouvez essayer de ne pas sucrer ou juste sur le dessus !', '2006-03-27T20:51:25+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, 6364aa05-60b9-42e1-a65f-e9c413f4b3d1, 'Excellent j’ai ajouté un Œuf de plus ', '2023-04-28T16:45:52+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12925, 570c6b45-30a2-4e69-a161-20a073c0e886, 'Très bonne, elle a du goût mais elle est un peu écoeurante si on en mange trop😜. cette recette est bonne et facile mais elle n’a pas été ma préférée, chacun a ses opinions !😎', '2023-04-23T17:17:21+02:00');
