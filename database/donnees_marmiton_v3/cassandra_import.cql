INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (530732, 00232df2-6a06-42d5-bd57-e3652d5e65f7, 'Très bon ! J''ai laissé cuire plutôt 35-40 min, avant ce n''était pas cuit.', '2023-01-12T13:18:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (530589, 9dbef059-4938-4953-afa7-27bf3b9ae073, 'Super recette pour faire le plein d’énergie. Il ne faut pas avoir peur de se salir les mains mais ça vaut le coup. On a rajouté des pépites de chocolat pour la gourmandise. On a fait 16 boules. Un super en-cas sain a personnaliser à l’infini.', '2021-04-29T22:49:06+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58006, bfe98899-703c-486a-964c-b1e036f92df7, 'Super bon ! Je n''ai pas trouvé la sauce exotique, j''ai donc mis une sauce curry, ça a très bien marché aussi ! J''ai utilisé des lardons fumés mais j''essaierai avec des naturels la prochaine fois car un peu trop salé à mon goût avec les cacahuètes en plus... A refaire en tout cas !', '2014-07-18T20:18:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58006, 7c7c924a-a92f-4cbd-a284-c945b5ad58ad, 'Ne trouvant pas cette fameuse sauce exotique malgré 4 hypers visités, je me suis rabattu sur de la sauce satay, et bien m''en a pris, j''ai rarement vu un plat partir aussi vite ! ', '2013-09-03T19:57:15+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (58006, 1222691d-7f3e-4917-bc3e-e33e1873b2f6, 'Juste parfait servi avec du riz, rien à retoucher !', '2011-12-12T22:56:34+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (28195, f9dfc20b-52fa-4dde-a204-5fcc73eb3f46, 'Super! J''avais 4 pauvres bananes mûres et toutes noires que les enfants ne voulaient plus manger. Voilà une bonne idée toute simple et très rapide. J''ai toute fois réduit considérablement le sucre glace :70 g . La prochaine fois, j''en mettrai encore moins. Merci pour cette recette .', '2008-07-19T23:10:33+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55174, eff61c23-823c-4bd8-8559-e230b210246a, 'On peut les farcis avec de la viande de porc ou de poulet effiloché.', '2022-03-16T15:00:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (55174, 4952ad24-e73c-4a2d-8a20-9c32eda530f5, 'J''ai mis 2/3 de maïzena et 1/3 de farine de riz, cuit à la vapeur, ça c''est avéré très sec. Je retesterais paut-être des tamales à la viande en utilisant carrément de la farine de maïs et cuisson au four.', '2015-08-21T13:25:57+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37252, 6ff65595-8966-4266-809c-a0ef0e916575, 'Ma petite princesse de 9 mois a beaucoup aimé, j''ai juste ajouté un pruneau de peur que cela ne la constipe et une pointe de miel pour le goût !', '2011-10-19T21:28:40+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (37252, bd2eb40b-2bd4-4084-971f-705543d70862, 'Vous avez fait une adepte : elle à 15 mois et se régale ! Et c''est une recette idéale (sans le jus de fruit) pour remédier à la gastro-entérite des petits...', '2010-05-18T17:34:56+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29471, 6027b9e9-898b-4e9d-9dc5-2f93949c490d, 'Je n''ai pas désossé les pilons et supprimé les noix de cajou. Bof, je ne referai pas...', '2018-07-03T10:51:07+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (29471, 22bc161e-d1db-48a0-8f3f-0ba0cd12bdde, 'Très bon mais j''ai rajouté un peu de fond de volaille pour relever le goût.', '2005-08-11T12:55:30+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33686, df6683d1-603e-4edf-8c57-b65272693839, 'Très bonne recette...le mélange sucré/salé est original et délicieux... très appréciée de mon copain...', '2005-01-05T13:17:13+01:00');
