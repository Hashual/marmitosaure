INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (33302, 4d25305a-072e-4a18-9cc4-b4692c42ee46, 'Très bien faite avec un pavé de lieu noir coupé en morceaux.👍👍', '2022-02-26T19:48:55+01:00');
