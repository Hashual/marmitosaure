INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, df9d3e01-f073-45e9-bb55-6527eb6cb26f, 'J''ai rajouté de la farine car pâte trop liquide pour des pancakes. Et effectivement mettre peut être une banane de plus.
Merci quand même pour la recette :)', '2020-04-23T18:47:09+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, edd2f01c-21f7-4c9d-a4c1-cce5f7f7cdcc, 'J''ai ajouté 2 bananes mûres à la place d''une, et je n''ai pas mis de sucre. Super résultat !!!', '2020-03-27T19:00:00+01:00');
