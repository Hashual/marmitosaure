INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 1d11250c-2709-4e83-af74-2833397404a4, 'Très très bonne recette et facile et rapide à faire. ', '2023-06-06T19:55:53+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 706dece4-3591-49ef-9b8b-2314f12faaa8, 'Délicieux. J''ai fait la pâte brisée moi-même et ai ajouté des zestes de citron jaune dans la mousse, un régal !', '2022-06-07T18:50:51+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, c0f129f1-a2d3-4b3a-9069-bf6a95f938ad, 'On a adoré ! Merci beaucoup pour cette super recette : simple, efficace, légère. On a servie la crème mascarpone bien fraîche et les fraises à température. Avec des zestes de citron et de la menthe ciselée pour ceux qui souhaitaient. Encore merci !', '2022-05-29T21:29:48+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 0a8db05e-ae16-4200-9488-7f115632a47c, 'Excellente recette, très facile à faire, hormis pour la cuisson de la pâte (dans mon cas, je l''ai fait cuire au four directement dans le plat à tarte et la pâte était dure et craquait très facilement au toucher). À refaire sans aucune hésitation !', '2022-05-12T16:42:41+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 1e41c23c-d149-4be1-99b1-0e79482a2c69, 'Excellente recette, facile à mettre en œuvre ', '2022-04-17T11:14:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (83823, 749b112e-405d-4c30-80c0-4b5d9c199fab, 'Très bon, mais franchement une pâte faite maison, c''est quand même bien meilleure', '2022-03-03T14:15:25+01:00');
