INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 5b4ccf66-3972-4f35-800a-fdb26af1b12a, 'Superbe recette je l’utilise beaucoup et elle ne m’a jamais déçu. Je recommande 👌😁', '2023-02-25T13:46:06+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, c9e40064-b4c2-424e-b465-4920da49bae1, 'Trop beau !', '2022-12-28T16:40:56+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 96b6b1c3-9783-4073-a552-9864089e837d, 'Très bonne recette.', '2022-12-06T11:02:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 7d4d5856-e11a-4686-a375-377c7389ca98, 'Très bon, je l''ai fait à 2 reprises en une quantité et un moule différent mais le temps de cuisson reste un peu long. Plutôt 15/20min.', '2022-12-05T18:47:48+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 6bc096fc-440d-42be-a975-1ea7bfa3282c, 'Le gâteau ne cuit pas à l''intérieur, c''est sensée être un moelleux, et non un fondant ', '2022-12-04T08:42:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, e39c3478-d3da-4440-9bf4-706c9bcc1ed7, 'Très simple à faire pour les débutants !', '2022-10-24T10:24:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 38bba34d-bd0c-429c-af10-46ea1c49dde7, 'J''adore ', '2022-10-23T19:50:22+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 24147933-0cf5-4938-a8a4-3b69cb3824ea, 'Je l''ai essayée plusieurs fois, et j''ai constaté qu''il faut peut-être réduire le temps de cuisson à 25/30 mn pour un vrai moelleux pas trop sec...', '2022-04-28T10:05:35+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12825, 478bd804-36f1-4d48-8cff-cf7a9c13a2d9, 'Au top', '2022-02-23T16:20:45+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26776, 02dec0cc-6bd5-4d2a-9d5e-ada6fa1033d0, 'Franchement pas bon. Personne n''a aimé même pas les enfants!', '2006-11-29T15:03:52+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26776, d2450215-2029-45e7-9d31-f48918355209, 'Superbe recette! On pourrait croire que la banane avec les pâtes c''est pas terrible mais au contraire ! Si vous aimez le mélange sucré/salé, ce plat est un délice et tous les ingrédients se mélangent hyper bien !  Bon appétit !', '2006-11-05T20:25:50+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (26776, eafad725-1038-4330-9ee2-fbd582ea6dc4, 'Super recette!', '2004-08-26T23:57:03+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528995, 5b79af21-025c-443a-b4ab-0fc0a10eec1f, 'Simple, rapide et tellement bon', '2023-07-09T16:20:44+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528995, ce01554d-df53-4a38-a764-2d93e01f7af6, 'Bonne recette, simple et rapide', '2021-01-17T20:36:15+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (528995, 6fec7982-2d41-4aad-8f44-6b0abff43c94, 'Un petit déjeuner très sain, rapide à faire, un délice', '2020-11-11T17:27:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169123, 4ba4dfd1-f36a-493b-a4a0-b532aa237db9, 'Merci pour cette recette ! Ici, c''est 2 bananes et le blanc d''oeuf en neige incorporé pour alléger le chocolat et pâte blanchie avant. Les enfants ont adoré. ', '2010-11-10T11:20:47+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (169123, efe57332-0f6a-49c0-9be3-21a026d203de, 'Très bon dessert ! Je n''y ai mis que 3 belles bananes et je n''ai eu que des compliments sur mon dessert !', '2010-08-22T19:22:42+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 3e678e9a-4e45-4217-b9a5-d22ae91857dd, 'Je n''ai pas lu tous les commentaires mais suis-je la seule à avoir remarqué que dans la liste d''ingrédients il y a 250 g de farine, alors que dans la préparation de la recette et dans la vidéo il est dit 150 g de farine. Je vais opter pour 150 g en espérant ne pas avoir de problème.', '2018-02-13T10:02:58+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 3400c7ad-f0ca-4dd7-a2e8-15f7d3bb7ec5, 'Tres tres bon...même ma fille qui n aime pas la banane à aprecier jai ajouté des pépites de chocolat et un peu de sucre à la canelle ', '2023-11-11T20:03:57+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 256bcfd4-61d7-4bca-a59f-9d7aff1d2375, 'Une tuerie ! Attention si vous utilisez l''appli marmiton : les 150 g de farine écrits au début de la recette ne varient pas en fonction de la quantité que vous sélectionnez (ça m''a induite en erreur dans les quantités mais le résultat était quand même parfait !). J''ai ajouté des pépites de chocolat au lait pour toujours plus de gourmandise, monsieur approuve 😁', '2022-11-01T12:56:25+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 8a587caf-38fe-4c2c-81ba-88cc2630688c, 'Super recette surtout qu''il reste super moelleux plusieurs jours. Troisième jour que j''en mange au petit déjeuner et toujours très bon.', '2018-11-09T07:51:59+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, c879d0e4-e4aa-4d94-8092-1c3f9767b8ad, 'Super moelleux et déclicieux 😍', '2024-02-17T19:56:11+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 20a1ee17-cecb-42a4-8cf9-7d4617224c57, 'Je n’avais pas de bicarbonate donc je n’en ai pas mis. J''ai réduit le sucre (80 g) parce que j’ai ajouté une banane de plus et des pépites de chocolat. J''ai également réduit le beurre (50 g) et pourtant ce banana bread reste une tuerie ! La recette originale doit être excellente ! Je mets 5 étoiles, car je suis certaine que ma version est un peu moins bien que l’originale ! ;)', '2022-07-22T17:54:23+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, a4dd59e9-84c2-4c55-b187-0a030373e24b, 'Très bon ! Pour ma part je n’ai pas mis de bicarbonate et j’ai ajouté sur le dessus une banane coupé en deux 
', '2022-04-09T15:59:34+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 4b68c5fa-82a0-4c99-9064-d3e8bbcc8e53, 'La recette est rapide à préparer, deux bananes ne suffisent pas. Le cake est mangeable, mais ça n''en a pas le goût. La prochaine fois, j''en mettrais trois.', '2022-02-18T21:37:30+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, f0e4935a-dba6-408f-87bf-d5541e001e92, 'J''ai rajouté quelques pépites de chocolat. C’était plus gourmand. ', '2023-10-01T14:00:39+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (12042, 1a8ff52b-615d-4777-8780-4600713c9319, 'Les proportions sont parfaites et c est delicieux 
