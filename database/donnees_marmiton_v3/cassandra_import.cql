INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (11391, fc85c9ce-9aa4-496b-bcdd-83ce4b115e43, 'Le cake est bon mais le sirop le rend beaucoup trop sucré. Je réduirai la quantité de sucre dans le sirop la prochaine fois.', '2022-12-22T18:22:52+01:00');
