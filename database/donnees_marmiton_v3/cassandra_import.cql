INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, 64c5b90c-ae10-4b14-b5e3-3c8c14f54a83, 'Délicieux il porte bien son nom.. je le recommande cette recette est top..', '2023-07-02T17:14:08+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, bc51ffd7-ebfb-4df7-b787-0f6809529961, 'Je l''ai fait pour Noël, tout le monde a adoré ! Je le refais pour le nouvel an, recette suivie à la lettre, punch au top !!!', '2022-12-30T14:21:16+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (42459, 324a37a1-1c40-44ca-ac03-de6626684f9c, 'Je l''ai fait avec 50% de rhum blanc et 50% de rhum ambré ... une tuerie ! Vraiment EXCELLENT !!!', '2022-07-07T14:39:11+02:00');
