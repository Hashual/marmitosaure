INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, 26441787-4c8b-4de2-9854-8ec59b399279, 'Très déçue car effectivement, la pâte est très liquide...', '2021-04-20T08:49:27+02:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, d1d7596c-54b4-4d32-8c13-6752c44490ec, 'Ça s’appelle des crêpes pas des pancakes ', '2021-03-20T17:06:00+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, 6a3e3b3e-717d-42ea-b3a2-9be6209ea7f5, 'Je trouve cette recette très bonne il fallait rajouter un petit peu plus de farine pour plus de consistance « personnellement un petit peu d’arôme de  vanille rajoute du goût »', '2021-03-14T21:07:43+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, 5b5845be-e24a-400a-a704-2b82ffa192f6, 'Bien laisser une nuit au frais pour que la pâte épaississe. J''ai mis 3 bananes et un peu plus de sucre pour qu''ils soient moins fades. Ils sont bons. ', '2021-02-19T09:15:33+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, 05906f97-f738-41f7-beda-695bd774665c, 'Comme le disent beaucoup de commentaires, ce sont des crêpes. Sans ajouter de bananes ça n’a aucun goût... Recette vraiment à revoir.', '2021-02-07T13:11:54+01:00');
INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (45575, 4d3e9c0a-cd50-4345-8527-5c92721b8e96, 'Très bonne recette j’ai juste rajouter une banane en plus ! ', '2021-02-07T10:26:25+01:00');
