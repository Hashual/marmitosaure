INSERT INTO Avis (recette_id, user_id, commentaire, date_publication) VALUES (92486, fcf2e007-6740-4559-8423-ffef905b88ce, 'Ma premiere realisation sur marmiton, je commence mes debuts dans la cuisine ( mieux vaut tard que jamais ) la video est tres bien pour les debutants comme moi, j''ai rajoute du sucre vanille, c''est encore meilleur, facile a faire avec vos enfants', '2024-02-29T12:27:11+01:00');
